TEXT 520 48 Left 6 !.param fn=50\n.param omegan={2*pi*fn}\n.param ur=0.21\n.param ux=0.24\n.param i0=0.0355\n.param p0=0.0208\n.param SN=720\n.param UN=480\n.param Uvar=10\n.param U1N={UN/2}\n.param U2N={UN/2}\n.param U12N=U1N+U2N\n.param uex=U12N/uvar\n.param U2=U1N/(uex-1+1p)\n.param I1N={SN/UN}\n.param Z1N={UN/I1N}\n.param R1={Z1N*uR}\n.param L1s={Z1N*uX/omegan}\n.param Rfe={UN*UN/(p0*SN)}\n.param Xh={(UN*UN)/(SN*sqrt(i0*i0-p0*p0))}\n.param L1={Xh/omegan}\n.param sigma1={L1s/L1}\n.param sigma={2*sigma1-sigma1*sigma1}\n.param k=sqrt(1-sigma)\n.param ue1={1+U1N/U2}\n.param ue={U1N/U2}\n.param uea={ue/ue1}\n.param ueb={ue*ue/(ue*ue+1)}\n.param L1m={L1*ueb}\n.param L2m={L1*(1-ueb)}\n.param R1m={R1*uea}\n.param R2m={R1*(1-uea)}
