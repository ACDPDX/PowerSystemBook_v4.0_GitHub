Version 4
SHEET 1 880 680
WIRE 144 80 -96 80
WIRE 336 80 240 80
WIRE -96 112 -96 80
WIRE 336 112 336 80
WIRE 144 128 144 112
WIRE 240 128 240 112
WIRE -96 224 -96 192
WIRE 336 224 336 192
FLAG 144 128 0
FLAG 240 128 0
FLAG -96 224 0
FLAG 336 224 0
SYMBOL voltage -96 96 R0
WINDOW 123 0 0 Left 2
WINDOW 39 0 0 Left 2
SYMATTR InstName V1
SYMATTR Value PULSE(0 1 0 1ps 1ps 5n 40n)
SYMBOL tline 192 96 R0
SYMATTR InstName T1
SYMATTR Value Td=10n Z0=50
SYMBOL res 320 96 R0
SYMATTR InstName R1
SYMATTR Value {R}
TEXT -16 40 Left 2 !.tran 5ps 200ns 0ns 5ps
TEXT -8 48 Left 2 !.param R=1e12
TEXT 384 80 Left 2 ;Input: 1V pulse every 40ns \nTD of line*4 = Resonance=Tpulse/4=40/4=10ns\n \n10ms: 1V Pulse at the end of the line -> 2V since reflected\n           pulse with 1V retour to the source\n20ms:  1V pulse now inverted at the source then with -1V again to the end\n30ms: -1V now at the end and inverted -> -2V\n            pulse with -1V  retour to the source \n40ms: -1V now inverted at the source -> 1V \n            now a new +1V pulse added from the source-> 2V pulse now to the end\n50ms:  2V Pulse at the end of the line -> 4V since reflected\n            and so on ......\n \nIf the resistance of the line is considered the pulse becomes a finite value\n \nTpulse/4 =10ns = TD of line = lamda/4
TEXT 304 56 Left 2 ;At the open line\nReflected
TEXT -112 48 Left 2 ;At the voltage\nsource \nInverted
TEXT -16 0 Left 5 ;Resonance with a pulse source
TEXT 384 248 Left 2 ;If R=Z0 no transients at all
