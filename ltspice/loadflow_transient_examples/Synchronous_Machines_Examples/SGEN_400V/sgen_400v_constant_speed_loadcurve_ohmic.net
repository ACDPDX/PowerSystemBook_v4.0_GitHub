* C:\Users\fried\Documents\ltspice\loadflow_transient_examples\Synchronous_Machines_Examples\SGEN_400V\sgen_400v_constant_speed_loadcurve_ohmic.asc
XU1 N001 N004 N007 verr M n 0 Sgen_12kW_constant_speed_type1 tdv=100 tdt=1u Schenkelpolfaktor={spf} Daempferfaktor=1 Streuung=0.05 rcu=0.05 rbg=0.01 a={a1} m={m1} n0=1500 t_anlauf=2m t_auslauf=2 t_betrieb=100 n_Turbine=1500
XU2 N002 N005 N008 N003 N006 N009 Impedance length=1 R1={RN} L1={LN} XL1=0 fn={fn1} R2={RN} L2={LN} XL2=0 R3={RN} L3={LN} XL3=0
XU7 N009 N006 N003 factor Load_d_R_ctrl VN=400 fn=50 PN1={PN} PQ0=1e3 PN2={PN} PN3={PN}
XU4 N001 N004 N007 v1 bus_Veff_1 factor=1 tenable=1u
XU6 N001 N004 N007 N002 N005 N008 i1 ameter_1_uvw
* 400V Generator has fixed magn. field voltage of 48V\nGenerator has fixed speed at 1500U/min\nLoad from 0 to 8kW at time > 3s
.options vntol=10 abstol=100m reltol=0.003
.param tdv=1 tdt=1 fn1=50 omega_n={2*pi*fn1}
.tran 0 10 0 0.6m
.param RN=0.04 LN={0.08/314.159}
verr verr 0 pwl 0s 48 20s 48
.param PN=1e3
vfact factor 0 pwl 0s 0 3s 0 10s 8
*.step param Verr0 200 1000 200
.param Verr0=48
* U/I charactaristic curve \nCurrent from 0A till 0.5*IN\nMagnetic field voltage at 48V
* pure ohmic load
.step param x list 1 2
.param spf table(x,1,0.5,2,1)
.param m1 table(x,1,7,2,7)
.param a1 table(x,1,0.9,2,0.9)
.lib impedance.lib
.lib load.lib
.lib measure.lib
.lib sgen.lib
.backanno
.end
