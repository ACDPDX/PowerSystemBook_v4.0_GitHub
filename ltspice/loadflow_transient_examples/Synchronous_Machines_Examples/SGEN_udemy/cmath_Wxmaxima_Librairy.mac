rad2deg(x):=(x*180/%pi);
deg2rad(x):=(x*%pi/180);
polarformd(mag,deg):=polarform(mag*%e^(deg2rad(deg)*%i));
rectformd(mag,deg):=(b:mag*sin(deg*%pi/180),a:mag.cos(deg*%pi/180),a+b*%i);
sind(deg):=(sin(deg*%pi/180));
cosd(deg):=(cos(deg*%pi/180));
tand(deg):=(tan(deg*%pi/180));
asind(deg):=(asin(deg*%pi/180));
acosd(deg):=(acos(deg*%pi/180));
atand(deg):=(atan(deg*%pi/180));