WINDOW 38 -37 11 Left 2
WINDOW 3 -38 23 Left 2
SYMATTR Value t_sync=3000ms t_sync_off=1e6 Schenkelpolfaktor=1 a=0.9 m=7 F1_kp=0.001 F1_Tn=0.01
