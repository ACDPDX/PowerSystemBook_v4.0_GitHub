TEXT -920 -96 Left 2 !.param pnx=10e6 qnx=1e3
TEXT -696 -104 Left 2 !.param pn=20e6 qn=1e3
TEXT -880 104 Left 2 !Vm m 0 {150e6*2/314.159}
