TEXT -808 -400 Left 2 !.options vntol=1000m abstol=100m reltol=0.003 trtol=1\n.param tdv=1 tdt=1 fn1=50 omega_n={2*pi*fn1}
TEXT -808 -376 Left 2 !.tran 0 1.5 1m 0.1m
TEXT -496 -288 Left 2 !.param RN=0.05 LN={0.1/314.159}
