component slack_1ph
% 1 phase slack
% The block represents an ideal voltage source 

nodes
    p = foundation.electrical.electrical; % L1:top 
    n = foundation.electrical.electrical; % N:bottom 
end

variables(Access=private)
    i = { 0, 'A' };
    v = { 0, 'V' };
end

parameters
    Amp = { 10, '1' }; % Amplitude
    Freq = { 60, '1' }; % Frequency
    Texp = { 100e-3, '1' }; % Exponential swingin
    phase = { 120 '1' }; % phase
    dphase = { 0, '1' }; % dphase
end

branches
    i : p.i -> n.i;
end

equations
    v == p.v - n.v;
    v == Amp*sin(Freq*2*3.14159*time*{ 1, '1/s' }+((phase+dphase)*2*3.14159/360))*(1-exp(-abs((time*{ 1, '1/s' })/(Texp+1e-12))))*{ 1, 'V' };
end

end