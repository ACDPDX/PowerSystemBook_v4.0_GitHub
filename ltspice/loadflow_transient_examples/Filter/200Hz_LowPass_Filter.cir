[Grid Text]
Text="NOTE: In this example you see that the filter needs additional current"
Text="from the source. This is dependent of the load current "
Text="Therefore L1,L2,C1 are changed according to the load"
Text="If RL is small (high load) L1,L2 are lowered and C1 is made higher"
Text="If RL is high (small load) L1,L2 is made higher and C1 lower"
Px=248,392
GridSnap=True
JustifyH=Left
