TEXT 168 -1032 Left 6 ;Three phase 9limb 300MVA Yy0 Transformer
TEXT 336 -352 Left 5 ;Primary windings
TEXT 328 -160 Left 5 ;Secondary windings
TEXT 344 -544 Left 5 ;... Middle legs ...
TEXT -8 -552 Left 5 ;Left outher leg
TEXT 688 -552 Left 5 ;Right outher leg
