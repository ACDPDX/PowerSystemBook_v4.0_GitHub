TEXT 200 24 Left 2 ;Parameters: N={N} Rfe={Rfe} a={a} m={m} fn1={fn1}  BN={BN} HN={HN}  area={area} length={length} calib_area=1 calib_length=1
TEXT 280 248 Left 2 !ELMx LMx 0 VALUE={N*phiN/imyN*1/(a+(1-a)*PWRS(v(phi123x)/phiN,m-1))} tripdv=1 tripdt=1\nERmx    RMx 0 VALUE={N*N/v(Lmx)} tripdv=1 tripdt=1\nEXlx    XLx  0 VALUE={v(Lmx)*314.159} tripdv=1 tripdt=1\nEthetaX thetaX 0 VALUE={v(phi123X)*N*N/v(Lmx)} tripdv=1 tripdt=1\nEBx Bx 0 VALUE={v(phi123X)/area} tripdv=1 tripdt=1\nEHx Hx 0 VALUE={v(thetaX)/length} tripdv=1 tripdt=1\nEmurX  MuerX 0 VALUE={v(BX)/v(HX)/4/pi*1e7} tripdv=1 tripdt=1\n \nEB B 0 VALUE={i(vphi)/area} tripdv=1 tripdt=1\nEH H 0 VALUE={v(m1h,m2)/length} tripdv=1 tripdt=1\nEtheta theta 0 VALUE={v(m1h,m2)} tripdv=1 tripdt=1\nEPhi phi 0 value={i(vphi)} tripdv=1 tripdt=1\n \nEimue imy 0 value={v(m1h,m2)/N} tripdv=1 tripdt=1\nEiRfe ife  0 value={v(m1,mh)/N} tripdv=1 tripdt=1
TEXT 280 120 Left 2 !Vphi123x phi123x 0 pwl 0s 0 {mytime} {fact*phiN}
TEXT 280 80 Left 2 !.param phiN={Bn*area*calib_area} imyN={Hn*length*calib_length/N}
TEXT 288 424 Left 2 ;For Bx,Hx curve set x-axis to v(Xn:Hx) \nwhere n in Xn is the number of the\nactual subcircuit e.g. v(X7:Hx)
TEXT 728 272 Left 2 ;nominal flux (peak value)
TEXT 728 288 Left 2 ;nominal magnetizing current (peak value)
