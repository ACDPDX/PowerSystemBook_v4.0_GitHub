TEXT 632 96 Left 2 ;General Symmetrical components formulae:\n \nI1 = 1/3*(Ir+a*Is+a*a*It)\nI2 = 1/3*(Ir+a*a*Is+a*It)\nI0 = 1/3*(Ir+Is+It)\n \nIr=I1+I2+I0\nIs=a*a*I1+a*I2+I0\nIt=a*I1+a*a*I2+I0\n \na=-0.5+j*0.866 -> 120degrees\na*a=a2=-0.5-J*0.866 -> 240degrees\n1+a=--a*a, 1+a*a=-a\na*a*a=1 a*a*a*a=a a*a+a+1=0\na*a-a=-j*sqrt(3) a-a*a=j*sqrt(3)\n \nNOTE: The same formulae are valid \nfor voltage equations
TEXT -48 -32 Left 2 ;a
TEXT 288 -32 Left 2 ;b
TEXT 632 312 Left 2 ;Earthfault between A and B:\n \nat A: ISA=0 ITA=0 URA=0\n \n3*I1A = IRA + a*ISA + a*a*ITA = IRA \n3*I2A = IRA +a*a*ISA + a*ITA = IRA\n3*I0A = IRA + ISA + ITA = IRA\n \n=> I1A=I2A=I0A=1/3*IRA \n \nURA = U1A + U2A + U0A = 0\n \nat B: IRB=0 ITB=0 USB=0\n \n3*I1B = IRB + a*ISB + a*a*ITB = a*ISB\n3*I2B = IRB + a*a*ISB + a*ITB = a*a*ISB\n3*I0B = IRB + ISB + ITB = ISB\n \n=> a*a*I1B = a*I2B = I0B = 1/3*ISB\n \nUSB= a*a*U1B + a*U2B + U0B
TEXT 160 128 Left 2 ;U1A
TEXT 160 272 Left 2 ;U2A
TEXT 160 416 Left 2 ;U0A
TEXT 376 128 Left 2 ;U1B
TEXT 376 272 Left 2 ;U2B
TEXT 376 416 Left 2 ;U0B
TEXT 224 0 Left 2 ;HINT: \nX lines: real part of voltage and current\nNon X lines: imaginary part of voltage and current\nONLY connect X-lines with X-lines and\nNon X lines with Non X lines
