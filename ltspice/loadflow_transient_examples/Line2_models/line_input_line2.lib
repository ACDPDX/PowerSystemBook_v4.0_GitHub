* NOTE: CL1=C12 CL2=C23 CL3=CL13
* CB1: CE1+3*CL12
* CB2: CE2+3*CL23
* CB3: CE3+3*CL13

* belted cables:

* 3Leiter Gürtelkabel ce = ca. 0.6 Cb (600nf Richtwert)
* statt Cu Alu ralu = r*58/35
* 1kv   l=0.275mh(25mm2_LF) ... 0.23mh(240mm2_LF)  unbewehrt -15% von l
* 10kv  l=0.38mh         ... 0.28mh          -----''-----
* 20kv  l=0.45mh         ... 0.32mh          -----''-----
* cb 20kv ?  0.95*cb 10kv

* GK_U10_o240mm2_LF r=0.0745 xl=0.10 cb=600nf ce=360nf  
* GK_U10_o150mm2_LF r=0.119 xl=0.105 cb=500nf ce=300nf
* GK_U10_o95mm2_LF  r=0.149 xl=0.114 cb=400nf ce=240nf
* GK_U10_o70mm2_LF  r=0.255 xl=0.118 cb=360nf ce=216nf
* GK_U10_o50mm2_LF  r=0.357 xl=0.125 cb=320nf ce=192nf
* GK_U10_o35mm2_LF  r=0.51 xl=0.135 cb=300nf ce=180nf
* GK_U10_o25mm2_LF  r=0.714 xl=0.145 cb=280nf ce=168nf

* GK_U0400_o240mm2_LF  r=0.0745 xl=0.08 cb=1000nf ce=600nf
* GK_U0400_o150mm2_LF  r=0.119 xl=0.08 cb=920nf ce=552nf
* GK_U0400_o95mm2_LF   r=0.149 xl=0.082 cb=850nf ce=510nf
* GK_U0400_o70mm2_LF   r=0.255 xl=0.084 cb=780nf ce=468nf
* GK_U0400_o50mm2_LF   r=0.357 xl=0.085 cb=680nf ce=408nf
* GK_U0400_o35mm2_LF   r=0.51 xl=0.087 cb=600nf ce=360nf
* GK_U0400_o25mm2_LF   r=0.714 xl=0.09 cb=520nf ce=312nf


* jacked cables

* 3Leiter Mantelkabel ce = cb (400nf Richtwert)
* 10Kv l=0.38mh(35mm2_LF) .... 0.30mh(240mm2_LF) ca. 0.825x20kv
* 20kv l=0.47mh(35mm2_LF) .... 0.35mh(240mm2_LF)
* cb 10KV  ?  1.05*cb 20kv
* mit alu statt cu ralu=r*58/35


* MK_U20_o240mm2_LF
* MK_U20_o185mm2_LF
* MK_U20_o150mm2_LF
* MK_U20_o120mm2_LF
* MK_U20_o70mm2_LF
* MK_U20_o50mm2_LF
* MK_U20_o35mm2_LF




* NOTE: CL1=C12 CL2=C23 CL3=CL13
* CB1: CE1+3*CL12
* CB2: CE2+3*CL23
* CB3: CE3+3*CL13
*.model stalu_u1150_o6x680mm2 line device=stalu_u1150_o6x680mm2 on=1 r=0.0078 xl=0.2471 cb=14.42n ce=5.57n g=1e12
.SUBCKT   stalu_u1150_o6x680mm2  L1_1 L2_1 L3_1 L1_2 L2_2 L3_2
+	PARAMS:
+	R1=0.0078	;
+	R2=0.0078	;
+	R3=0.0078	;
+	L1={0.2471/314.159}	;
+	L2={0.2471/314.159}	;
+	L3={0.2471/314.159}	;
+   fn={fn1}
+   XL1=0
+   XL2=0
+   XL3=0
+   Cb1=14.42n	;
+   Cb2=14.42n;
+   Cb3=14.42n;
+   Ce1=5.57n
+   Ce2=5.57n
+   Ce3=5.57n
+	length=1
+ cl=1;
+ g=1e12
* Cb = ce + 3cl -> cl = (cb-ce)/3
.PARAM
+   Cl1={IF((cb1-ce1)>0,(cb1-ce1)/3,cb1/10000)}
+   Cl2={IF((cb2-ce2)>0,(cb2-ce2)/3,cb2/10000)}
+   Cl3={IF((cb3-ce3)>0,(cb3-ce3)/3,cb3/10000)}
.PARAM
+   L11=IF(xl1>0,xl1/fn/2/pi,L1)
+   L22=IF(xl2>0,xl2/fn/2/pi,L2)
+   L33=IF(xl3>0,xl3/fn/2/pi,L3)
*** Phase 1 CE ****************
RL11 L1_1 L1_1m {R1/2*length}
LL11 L1_1m L1_1n {L11/2*length} rser=0
RL12 L1_1n L1_1o {R1/2*length}
LL12 L1_1o L1_2 {L11/2*length} rser=0
Ce1 L1_1n 0 {Ce1*length*cl}
*** Phase 2 CE ******************
RL21 L2_1 L2_1m {R2/2*length}
LL21 L2_1m L2_1n {L22/2*length} rser=0
RL22 L2_1n L2_1o {R2/2*length}
LL22 L2_1o L2_2 {L22/2*length} rser=0
CE2 L2_1n 0 {Ce2*length*cl}
*** Phase 3 CE ****************
RL31 L3_1 L3_1m {R3/2*length}
LL31 L3_1m L3_1n {L33/2*length} rser=0
RL32 L3_1n L3_1o {R3/2*length}
LL32 L3_1o L3_2 {L33/2*length} rser=0
CE3 L3_1n 0 {Ce3*length*cl}
*** Phase 1,2,3 CL ************
CC1 L1_1n L2_1n {Cl1*length*cl}
CC2 L2_1n L3_1n {Cl2*length*cl}
CC3 L3_1n L1_1n {Cl3*length*cl}
*******************************
Rgnd1 L1_1 0 {g}
Rgnd2 L2_1 0 {g}
Rgnd3 L3_1 0 {g}
Rgnd4 L1_2 0 {g}
Rgnd5 L2_2 0 {g}
Rgnd6 L3_2 0 {g}
.ENDS

* NOTE: CL1=C12 CL2=C23 CL3=CL13
* CB1: CE1+3*CL12
* CB2: CE2+3*CL23
* CB3: CE3+3*CL13
.SUBCKT   stalu_u1150_o6x680mm2_Kette  L1_1 L2_1 L3_1 L1_2 L2_2 L3_2
+	PARAMS:
+	R1=0.0078	;
+	R2=0.0078	;
+	R3=0.0078	;
+	L1={0.2471/314.159}	;
+	L2={0.2471/314.159}	;
+	L3={0.2471/314.159}	;
+   fn={fn1}
+   XL1=0
+   XL2=0
+   XL3=0
+   Cb1=14.42n	;
+   Cb2=14.42n;
+   Cb3=14.42n;
+   Ce1=5.57n
+   Ce2=5.57n
+   Ce3=5.57n
+	length=1
+ cl=1;
+ g=1e12
.PARAM
+   L11=IF(xl1>0,xl1/fn/2/pi,L1)
+   L22=IF(xl2>0,xl2/fn/2/pi,L2)
+   L33=IF(xl3>0,xl3/fn/2/pi,L3)
Xa L1_1 L2_1 L3_1 L1_1a L2_1a L3_1a stalu_u1150_o6x680mm2  
+ params:
+ R1={R1} R2={R2} R3={R3} L1={L11} L2={L22} L3={L33}
+ Cb1={Cb1} Ce1={Ce1} Cb2={Cb2} Ce2={Ce2} Cb3={Cb3} Ce3={Ce3}
+ length={length/10} cl={cl} g={g}
Xb L1_1a L2_1a L3_1a L1_1b L2_1b L3_1b stalu_u1150_o6x680mm2  
+ params:
+ R1={R1} R2={R2} R3={R3} L1={L11} L2={L22} L3={L33}
+ Cb1={Cb1} Ce1={Ce1} Cb2={Cb2} Ce2={Ce2} Cb3={Cb3} Ce3={Ce3}
+ length={length/10} cl={cl} g={g}
Xc L1_1b L2_1b L3_1b L1_1c L2_1c L3_1c stalu_u1150_o6x680mm2  
+ params:
+ R1={R1} R2={R2} R3={R3} L1={L11} L2={L22} L3={L33}
+ Cb1={Cb1} Ce1={Ce1} Cb2={Cb2} Ce2={Ce2} Cb3={Cb3} Ce3={Ce3}
+ length={length/10} cl={cl} g={g}
Xd L1_1c L2_1c L3_1c L1_1d L2_1d L3_1d stalu_u1150_o6x680mm2  
+ params:
+ R1={R1} R2={R2} R3={R3} L1={L11} L2={L22} L3={L33}
+ Cb1={Cb1} Ce1={Ce1} Cb2={Cb2} Ce2={Ce2} Cb3={Cb3} Ce3={Ce3}
+ length={length/10} cl={cl} g={g}
Xe L1_1d L2_1d L3_1d L1_1e L2_1e L3_1e stalu_u1150_o6x680mm2  
+ params:
+ R1={R1} R2={R2} R3={R3} L1={L11} L2={L22} L3={L33}
+ Cb1={Cb1} Ce1={Ce1} Cb2={Cb2} Ce2={Ce2} Cb3={Cb3} Ce3={Ce3}
+ length={length/10} cl={cl} g={g}
Xf L1_1e L2_1e L3_1e L1_1f L2_1f L3_1f stalu_u1150_o6x680mm2  
+ params:
+ R1={R1} R2={R2} R3={R3} L1={L11} L2={L22} L3={L33}
+ Cb1={Cb1} Ce1={Ce1} Cb2={Cb2} Ce2={Ce2} Cb3={Cb3} Ce3={Ce3}
+ length={length/10} cl={cl} g={g}
Xg L1_1f L2_1f L3_1f L1_1g L2_1g L3_1g stalu_u1150_o6x680mm2  
+ params:
+ R1={R1} R2={R2} R3={R3} L1={L11} L2={L22} L3={L33}
+ Cb1={Cb1} Ce1={Ce1} Cb2={Cb2} Ce2={Ce2} Cb3={Cb3} Ce3={Ce3}
+ length={length/10} cl={cl} g={g}
Xh L1_1g L2_1g L3_1g L1_1h L2_1h L3_1h stalu_u1150_o6x680mm2  
+ params:
+ R1={R1} R2={R2} R3={R3} L1={L11} L2={L22} L3={L33}
+ Cb1={Cb1} Ce1={Ce1} Cb2={Cb2} Ce2={Ce2} Cb3={Cb3} Ce3={Ce3}
+ length={length/10} cl={cl} g={g}
Xi L1_1h L2_1h L3_1h L1_1i L2_1i L3_1i stalu_u1150_o6x680mm2  
+ params:
+ R1={R1} R2={R2} R3={R3} L1={L11} L2={L22} L3={L33}
+ Cb1={Cb1} Ce1={Ce1} Cb2={Cb2} Ce2={Ce2} Cb3={Cb3} Ce3={Ce3}
+ length={length/10} cl={cl} g={g}
Xj L1_1i L2_1i L3_1i L1_2 L2_2 L3_2 stalu_u1150_o6x680mm2  
+ params:
+ R1={R1} R2={R2} R3={R3} L1={L11} L2={L22} L3={L33}
+ Cb1={Cb1} Ce1={Ce1} Cb2={Cb2} Ce2={Ce2} Cb3={Cb3} Ce3={Ce3}
+ length={length/10} cl={cl} g={g}
.ENDS

* NOTE: CL1=C12 CL2=C23 CL3=CL13
* CB1: CE1+3*CL12
* CB2: CE2+3*CL23
* CB3: CE3+3*CL13
*.model stalu_u1150_o6x680mm2 line device=stalu_u1150_o6x680mm2 on=1 r=0.0078 xl=0.2471 cb=14.42n ce=5.57n g=1e12
.SUBCKT   stalu_u1150_o6x680mm2_lossless  L1_1 L2_1 L3_1 L1_2 L2_2 L3_2
+	PARAMS:
+	R1=0.0078	;
+	R2=0.0078	;
+	R3=0.0078	;
+	L1={0.2471/314.159}	;
+	L2={0.2471/314.159}	;
+	L3={0.2471/314.159}	;
+   fn={fn1}
+   XL1=0
+   XL2=0
+   XL3=0
+   Cb1=14.42n	;
+   Cb2=14.42n;
+   Cb3=14.42n;
+   Ce1=5.57n
+   Ce2=5.57n
+   Ce3=5.57n
+	length=1
+ cl=1;
+ g=1e12
* Cb = ce + 3cl -> cl = (cb-ce)/3
.PARAM
+   Cl1={IF((cb1-ce1)>0,(cb1-ce1)/3,cb1/10000)}
+   Cl2={IF((cb2-ce2)>0,(cb2-ce2)/3,cb2/10000)}
+   Cl3={IF((cb3-ce3)>0,(cb3-ce3)/3,cb3/10000)}
.PARAM
+   L11=IF(xl1>0,xl1/fn/2/pi,L1)
+   L22=IF(xl2>0,xl2/fn/2/pi,L2)
+   L33=IF(xl3>0,xl3/fn/2/pi,L3)
.param v1={1/sqrt(L11*Cb1)}
.param v2={1/sqrt(L22*Cb2)}
.param v3={1/sqrt(L33*Cb3)}
T1 L1_x 0 L1_y 0 Z0={1/v1/Ce1} TD={Length/v1}
T2 L2_x 0 L2_y 0 Z0={1/v2/Ce2} TD={Length/v2}
T3 L3_x 0 L3_y 0 Z0={1/v3/Ce3} TD={Length/v3}
T4 L1_x1 L1_x2 L1_y1 L1_y2 Z0={1/v1/Cl1} TD={Length/v1}
T5 L1_x2 L1_x3 L1_y2 L1_y3 Z0={1/v2/Cl2} TD={Length/v2}
T6 L1_x3 L1_x1 L1_y3 L1_y1 Z0={1/v3/Cl3} TD={Length/v3}
R1 L1_x L1_x1 1u
R2 L2_x L1_x2 1u
R3 L3_x L1_x3 1u
R4 L1_y L1_y1 1u
R5 L2_y L1_y2 1u
R6 L3_y L1_y3 1u
R10 L1_1 0 {g}
R11 L2_1 0 {g}
R12 L3_1 0 {g}
R13 L1_2 0 {g}
R14 L2_2 0 {g}
