*.model pe_u20_o240mm2 XL=0.105 L=0.334mH CB=300nF R=0.0754 (Cu) 0.125 (DC-Alu)
.SUBCKT   pe_u20_o240mm2  L1_1 L2_1 L3_1 L1_2 L2_2 L3_2
+	PARAMS:
+	R1=0.0754	;
+	R2=0.0754	;
+	R3=0.0754    ;
+	L1={0.105/314.159}	;
+	L2={0.105/314.159}	;
+	L3={0.105/314.159}	;
+   fn={fn1}
+   XL1=0
+   XL2=0
+   XL3=0
+	Cb1=300n	;
+	Cb2=300n	;
+	Cb3=300n	;
+	Ce1=300n	;
+	Ce2=300n	;
+	Ce3=300n	;
+	length=1
+ cl=1;
+ g=1e12
* Cb = ce + 3cl -> cl = (cb-ce)/3
.PARAM
+   L11=IF(xl1>0,xl1/fn/2/pi,L1)
+   L22=IF(xl2>0,xl2/fn/2/pi,L2)
+   L33=IF(xl3>0,xl3/fn/2/pi,L3)
.PARAM
+   Cl1={IF((cb1-ce1)>0,(cb1-ce1)/3,cb1/10000)}
+   Cl2={IF((cb2-ce2)>0,(cb2-ce2)/3,cb2/10000)}
+   Cl3={IF((cb3-ce3)>0,(cb3-ce3)/3,cb3/10000)}
*** Phase 1 CE ****************
RL11 L1_1 L1_1m {R1/2*length}
LL11 L1_1m L1_1n {L11/2*length} rser=0
RL12 L1_1n L1_1o {R1/2*length}
LL12 L1_1o L1_2 {L11/2*length} rser=0
CE1 L1_1n 0 {Ce1*length*cl}
*** Phase 2 CE ******************
RL21 L2_1 L2_1m {R2/2*length}
LL21 L2_1m L2_1n {L22/2*length} rser=0
RL22 L2_1n L2_1o {R2/2*length}
LL22 L2_1o L2_2 {L22/2*length} rser=0
CE2 L2_1n 0 {Ce2*length*cl}
*** Phase 3 CE ****************
RL31 L3_1 L3_1m {R3/2*length}
LL31 L3_1m L3_1n {L33/2*length} rser=0
RL32 L3_1n L3_1o {R3/2*length}
LL32 L3_1o L3_2 {L33/2*length} rser=0
CE3 L3_1n 0 {Ce3*length*cl}
*** Phase 1,2,3 CL ************
CC1 L1_1n L2_1n {Cl1*length*cl}
CC2 L2_1n L3_1n {Cl2*length*cl}
CC3 L3_1n L1_1n {Cl3*length*cl}
*******************************
Rgnd1 L1_1 0 {g}
Rgnd2 L2_1 0 {g}
Rgnd3 L3_1 0 {g}
Rgnd4 L1_2 0 {g}
Rgnd5 L2_2 0 {g}
Rgnd6 L3_2 0 {g}
.ENDS


