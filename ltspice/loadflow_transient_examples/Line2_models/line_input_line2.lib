+	R2=0.0363	;
+	R3=0.0363   ;
+	L1={0.132/314.159}	;
+	L2={0.132/314.159}	;
+	L3={0.132/314.159}	;
+   fn={fn1}
+   XL1=0
+   XL2=0
+   XL3=0
+	Ce1=165n	;
+	Ce2=165n	;
+	Ce3=165n	;
+	length=1
+ cl=1;
+ g=1e12
.PARAM
+   L11=IF(xl1>0,xl1/fn/2/pi,L1)
+   L22=IF(xl2>0,xl2/fn/2/pi,L2)
+   L33=IF(xl3>0,xl3/fn/2/pi,L3)
O1  L1_1 0  L1_2  0  MyLossyTlineL1
O2  L2_1 0  L2_2  0  MyLossyTlineL2
O3  L3_1 0  L3_2  0  MyLossyTlineL3
.model MyLossyTlineL1  LTRA(len={length}  R={R1}  L={L11}  C={cl*Ce1})
.model MyLossyTlineL2  LTRA(len={length}  R={R2}  L={L22}  C={cl*Ce2})
.model MyLossyTlineL3  LTRA(len={length}  R={R3}  L={L33}  C={cl*Ce3})
Rgnd1 L1_1 0 {g}
Rgnd2 L2_1 0 {g}
Rgnd3 L3_1 0 {g}
Rgnd4 L1_2 0 {g}
Rgnd5 L2_2 0 {g}
Rgnd6 L3_2 0 {g}
.ENDS

* lossless distributed line model
.SUBCKT   pe_u110_o500mm2_distr_lossless  L1_1 L2_1 L3_1 L1_2 L2_2 L3_2
+	PARAMS:
+   Zw1=0
+   Zw2=0
+   Zw3=0
+   Td1=0
+   Td2=0
+   Td3=0
+	R1=0.0363	;
+	R2=0.0363	;
+	R3=0.0363   ;
+	L1={0.132/314.159}	;
+	L2={0.132/314.159}	;
+	L3={0.132/314.159}	;
+   fn={fn1}
+   XL1=0
+   XL2=0
+   XL3=0
+	Ce1=165n	;
+	Ce2=165n	;
+	Ce3=165n	;
+	length=1
+ cl=1;
+ g=1e12
.PARAM
+   L11=IF(xl1>0,xl1/fn/2/pi,L1)
+   L22=IF(xl2>0,xl2/fn/2/pi,L2)
+   L33=IF(xl3>0,xl3/fn/2/pi,L3)
.PARAM
+ Zw11={IF(Zw1>0,Zw1,sqrt(L11/(cl*Ce1)))}
+ Td11={if(Td1>0,Td1,sqrt(L11*(cl*Ce1)))}
+ Zw22={IF(Zw2>0,Zw2,sqrt(L22/(cl*Ce2)))}
+ Td22={if(Td2>0,Td2,sqrt(L22*(cl*Ce2)))}
+ Zw33={IF(Zw3>0,Zw3,sqrt(L33/(cl*Ce3)))}
+ Td33={if(Td3>0,Td3,sqrt(L33*(cl*Ce3)))}
T1 L1_1x  0  L1_2x  0   Zo={Zw11} Td={Td11*length}
T2 L2_1x  0  L2_2x  0   Zo={Zw22} Td={Td22*length}
T3 L3_1x  0  L3_2x  0   Zo={Zw33} Td={Td33*length}
R1a L1_1 L1_1x {R1/2*length}
R1b L1_2 L1_2x {R1/2*length}
R2a L2_1 L2_1x {R2/2*length}
R2b L2_2 L2_2x {R2/2*length}
R3a L3_1 L3_1x {R3/2*length}
R3b L3_2 L3_2x {R3/2*length}
Rgnd1 L1_1 0 {g}
Rgnd2 L2_1 0 {g}
Rgnd3 L3_1 0 {g}
Rgnd4 L1_2 0 {g}
Rgnd5 L2_2 0 {g}
Rgnd6 L3_2 0 {g}
*******************************
.ENDS

