* CB1: CE1+3*CL12
* CB2: CE2+3*CL23
* CB3: CE3+3*CL13
*.model stalu_u20_o70mm2 
.SUBCKT   stalu_u20_o70mm2_lossless  L1_1 L2_1 L3_1 L1_2 L2_2 L3_2
+	PARAMS:
+	R1=0.404	;
+	R2=0.404	;
+	R3=0.404;
+	L1={0.35/314.159}	;
+	L2={0.35/314.159}	;
+	L3={0.35/314.159}	;
+   fn={fn1}
+   XL1=0
+   XL2=0
+   XL3=0
+   Cb1=9n	;
+   Cb2=9n	;
+   Cb3=9n	;
+   Ce1=4n	;
+   Ce2=4n	;
+   Ce3=4n	;
+	length=1
+ cl=1;
+ g=1e12
* Cb = ce + 3cl -> cl = (cb-ce)/3
.PARAM
+   Cl1={IF((cb1-ce1)>0,(cb1-ce1)/3,cb1/10000)}
+   Cl2={IF((cb2-ce2)>0,(cb2-ce2)/3,cb2/10000)}
+   Cl3={IF((cb3-ce3)>0,(cb3-ce3)/3,cb3/10000)}
.PARAM
+   L11=IF(xl1>0,xl1/fn/2/pi,L1)
+   L22=IF(xl2>0,xl2/fn/2/pi,L2)
+   L33=IF(xl3>0,xl3/fn/2/pi,L3)
.param v1={1/sqrt(L11*Cb1)}
.param v2={1/sqrt(L22*Cb2)}
.param v3={1/sqrt(L33*Cb3)}
T1 L1_x 0 L1_y 0 Z0={1/v1/Ce1} TD={Length/v1}
T2 L2_x 0 L2_y 0 Z0={1/v2/Ce2} TD={Length/v2}
T3 L3_x 0 L3_y 0 Z0={1/v3/Ce3} TD={Length/v3}
T4 L1_x1 L1_x2 L1_y1 L1_y2 Z0={1/v1/Cl1} TD={Length/v1}
T5 L1_x2 L1_x3 L1_y2 L1_y3 Z0={1/v2/Cl2} TD={Length/v2}
T6 L1_x3 L1_x1 L1_y3 L1_y1 Z0={1/v3/Cl3} TD={Length/v3}
R1 L1_x L1_x1 1u
R2 L2_x L1_x2 1u
R3 L3_x L1_x3 1u
R4 L1_y L1_y1 1u
R5 L2_y L1_y2 1u
R6 L3_y L1_y3 1u
R10 L1_1 0 {g}
R11 L2_1 0 {g}
R12 L3_1 0 {g}
R13 L1_2 0 {g}
R14 L2_2 0 {g}
R15 L3_2 0 {g}
R7 L1_1 L1_x {R1*length/2}
R8 L2_1 L2_x {R2*length/2}
R9 L3_1 L3_x {R3*length/2}
R16 L1_y L1_2 {R1*length/2}
R17 L2_y L2_2 {R2*length/2}
R18 L3_y L3_2 {R3*length/2}
.ENDS

