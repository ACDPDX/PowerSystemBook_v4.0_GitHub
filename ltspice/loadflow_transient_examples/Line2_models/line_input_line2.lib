*.model MK_u20_o240mm2_distr line r=0.0745 xl=0.11 cb=530nf ce=530nf
.SUBCKT   MK_u20_o240mm2_distr  L1_1 L2_1 L3_1 L1_2 L2_2 L3_2
+	PARAMS:
+	R1=0.0745;
+	R2=0.0745;
+	R3=0.0745  ;
+	L1={0.11/314.159}	;
+	L2={0.11/314.159}	;
+	L3={0.11/314.159}	;
+   fn={fn1}
+   XL1=0
+   XL2=0
+   XL3=0
+	Ce1=530nf	;
+	Ce2=530nf	;
+	Ce3=530nf	;
+	length=1
+ cl=1;
+ g=1e12
.PARAM
+   L11=IF(xl1>0,xl1/fn/2/pi,L1)
+   L22=IF(xl2>0,xl2/fn/2/pi,L2)
+   L33=IF(xl3>0,xl3/fn/2/pi,L3)
O1  L1_1 0  L1_2  0  MyLossyTlineL1
O2  L2_1 0  L2_2  0  MyLossyTlineL2
O3  L3_1 0  L3_2  0  MyLossyTlineL3
.model MyLossyTlineL1  LTRA(len={length}  R={R1}  L={L11}  C={Ce1})
.model MyLossyTlineL2  LTRA(len={length}  R={R2}  L={L22}  C={Ce2})
.model MyLossyTlineL3  LTRA(len={length}  R={R3}  L={L33}  C={Ce3})
