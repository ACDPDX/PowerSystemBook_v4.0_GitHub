*.model MK_u20_o240mm2_distr_lossless line r=0.0745 xl=0.11 cb=530nf ce=530nf
.SUBCKT   MK_u20_o240mm2_distr_lossless  L1_1 L2_1 L3_1 L1_2 L2_2 L3_2
+	PARAMS:
+   Zw1=0
+   Zw2=0
+   Zw3=0
+   Td1=0
+   Td2=0
+   Td3=0
+	R1=0.0745;
+	R2=0.0745;
+	R3=0.0745  ;
+	L1={0.11/314.159}	;
+	L2={0.11/314.159}	;
+	L3={0.11/314.159}	;
+   fn={fn1}
+   XL1=0
+   XL2=0
+   XL3=0
+	Ce1=530nf	;
+	Ce2=530nf	;
+	Ce3=530nf	;
+ cl=1
+ length=1
+ g=1e12
.PARAM
+   L11=IF(xl1>0,xl1/fn/2/pi,L1)
+   L22=IF(xl2>0,xl2/fn/2/pi,L2)
+   L33=IF(xl3>0,xl3/fn/2/pi,L3)
.PARAM
+ Zw11={IF(Zw1>0,Zw1,sqrt(L11/(cl*Ce1)))}
+ Td11={if(Td1>0,Td1,sqrt(L11*(cl*Ce1)))}
+ Zw22={IF(Zw2>0,Zw2,sqrt(L22/(cl*Ce2)))}
+ Td22={if(Td2>0,Td2,sqrt(L22*(cl*Ce2)))}
+ Zw33={IF(Zw3>0,Zw3,sqrt(L33/(cl*Ce3)))}
