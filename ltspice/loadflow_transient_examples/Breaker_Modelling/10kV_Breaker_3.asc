TEXT 280 304 Left 2 !* mov ciruitry to prevent voltage spike \n.subckt mov 1 2 ; base generic\n+PARAMS: VBO=10 Vr=0.71 Vratio=VBO/{Vr} exp=9\nB1 1 2 I=if(V(1, 2)-0.5, (V(1, 2) / Vratio) ** exp, (1 / Vratio) ** exp) tripdv={tdv} tripdt={tdt}\nB2 2 1 I=if(V(2, 1)-0.5, (V(2, 1) / Vratio) ** exp, (1 / Vratio) ** exp) tripdv={tdv} tripdt={tdt}\n.ends
TEXT 280 200 Left 2 !* ctrl=0V -> go   ctrl=1V -> stop\n.subckt brkp_ctrl ctrl params: C1=0.1n trise=1n tfall=1n Td=1n\nA1 N001 0 0 0 0 N002 0 0 BUF Vhigh=1V Vlow=0V trise={trise} tfall={tfall} Td={td}\nA2 N002 0 0 0 0 N003 0 0 BUF Vhigh=1V Vlow=0V trise={trise} tfall={tfall} Td={td} \nC1 N003 N004 {C1} IC=0\nR1 N002 N004 100k\nR2 N001 N004 10k\n.lib switcher.lib\nX§U2 N003 N004 ctrl SW_1Phase_ctrl ron=0.01 roff=1e9\n.ends
TEXT 280 376 Left 2 !.subckt sw gate1 ctrl in out params:td1=0 ioff0=20 ioff=500m toff=1n\nV1 in in2 0\nxsw1 in2 out gate Sw_1Phase_ctrl params: toff={toff}\nA1 gate1 0 0 0 0 N002 N001 0 BUF\nA2 N002 N002 N002 tst1 tst1 gate 0 0 AND\nA3 gate2 gate2 gate2 N004 N004 ctrl N003 0 AND\nA4 gate 0 0 0 0 0 gate2 0 BUF td={td1}\nA5 gate1 0 0 0 0 N005 0 0 BUF\nA6 tst2 tst2 N005 N005 N005 0 N004 0 AND\nEtst1 tst1 0 value={IF(abs(I(v1))<IOFF,1,0)} tripdv=1 tripdt=1\nEtst2 tst2 0 value={IF(abs(I(v1))<IOFF0,1,0)} tripdv=1 tripdt=1\n.lib switcher.lib\n.ends
