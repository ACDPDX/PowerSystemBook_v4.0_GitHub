TEXT -48 392 Left 2 ;.SUBCKT   stalu_u400_o2x560mm2  L1_1 L2_1 L3_1 L1_2 L2_2 L3_2\n+               PARAMS:\n+               R1=0.026        ;\n+               R2=0.026        ;\n+               R3=0.026        ;\n+               L1={0.31/314.159}               ;\n+               L2={0.31/314.159}               ;\n+               L3={0.31/314.159}               ;\n+   fn={fn1}\n+   XL1=0\n+   XL2=0\n+   XL3=0\n+   Cb1=11.3n   ;\n+   Cb2=11.3n   ;\n+   Cb3=11.3n   ;\n+   Ce1=5.44n   ;\n+   Ce2=5.44n   ;\n+   Ce3=5.44n   ;\n+   length=1\n+   cl=1;\n+   g=1e12\n.PARAM\n+   Cl1={IF((cb1-ce1)>0,(cb1-ce1)/3,cb1/10000)}\n+   Cl2={IF((cb2-ce2)>0,(cb2-ce2)/3,cb2/10000)}\n+   Cl3={IF((cb3-ce3)>0,(cb3-ce3)/3,cb3/10000)}\n.PARAM\n+   L11=IF(xl1>0,xl1/fn/2/pi,L1)\n+   L22=IF(xl2>0,xl2/fn/2/pi,L2)\n+   L33=IF(xl3>0,xl3/fn/2/pi,L3)\n.param v1={1/sqrt(L11*Cb1)}\n.param v2={1/sqrt(L22*Cb2)}\n.param v3={1/sqrt(L33*Cb3)}\n.....\n.ends
