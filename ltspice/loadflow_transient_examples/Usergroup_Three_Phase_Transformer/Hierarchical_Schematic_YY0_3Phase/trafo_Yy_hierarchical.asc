TEXT -576 344 Left 2 !.param\n+               SN1={SN/3} ; nominal apparent power\n+               U1N={U1Nenn/sqrt(3)} ; primary voltage\n+               U20N={U20/sqrt(3)} ; secondary voltage\n+               I1N={SN1/U1N} ; primary current\n+               Z1N={U1N/I1N} ; nominal impedance\n+               omegaN={2*pi*fN} ; circular frequency\n+               R1={Z1N*uR/2} ; primary resistance\n+               L1s={Z1N*uX/2/omegaN} ; primary (leakage) inductance\n+               RFe={U1N*U1N/(p0*SN1)} ; Iron lost resistance\n+               N2={N1*U20N/U1N} ; secondary nr. of windings\n+               R2={R1*N2/N1*N2/N1} ; secondary resistance\n+               Xh={(U1N*U1N)/(SN1*sqrt(i0*i0-p0*p0))} ; main field inductance\n+               iu={U1N/Xh} ; nominal magnetizing current (RMS)\n+               ImyN={sqrt(2)*iu} ;nominal magnetizing current (peak value)\n+               phiN={sqrt(2)*U1N/omegaN/N1} ; nominal magnetic flux inside magnetic core (peak value)\n+               rfeos={U1N*U1N/(p0*SN1)} ; iron lost resistance\n+               ife={U1N/rfeos} ; fictive current due to iron lost\n+               i0p={sqrt(2)*sqrt(iu*iu+ife*ife)} ; noload current (peak value)\n+               a={a} ; magnetizing shape parameter \n+               m={m} ; magnetizing shape parameter\n+               psi_rem={psi_0*phiN} ;remanent flux
TEXT -112 352 Left 2 !vsn1 SN1 0 {SN}\nvu1n U1N 0 {U1N}\nvi1n I1N 0 {I1N}\n \n \nvz1n Z1N 0 {Z1N}\nvr1  R1  0 {R1}\nvl1s L1s 0 {L1s}\n \n \nvn2  N2  0 {N2}\nvr2  R2  0 {R2}\nvxh  Xh  0 {Xh}\n \n \nvimy  imue  0  {Iu}\nvimyN imueN 0  {imyN}\nvphiN  phiN 0  {phiN}\n \nvi0 i0p 0 {i0p}\nvife ife 0 {ife}
