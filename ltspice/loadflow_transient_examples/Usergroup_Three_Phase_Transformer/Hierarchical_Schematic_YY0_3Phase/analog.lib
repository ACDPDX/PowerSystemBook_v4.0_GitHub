

.SUBCKT R  L1_1 L1_2
+	PARAMS:
+	R=0.5	;
+ length=1
+ g=1e12
RL1 L1_1 L1_2 {R*length}
Rgnd1 L1_1 0 {g}
Rgnd2 L1_2 0 {g}
.ENDS

.SUBCKT L  L1_1 L1_2
+	PARAMS:
+	L=1	;
+   fn={fn1}
+   xl=0
+ length=1
+ rser=0
+ IC=0
+ g=1e12
.PARAM
+   L1=IF(xl>0,xl/fn/2/pi,L)
LL1 L1_1 L1_2 {L1*length} rser={rser} IC={IC}
Rgnd1 L1_1 0 {g}
Rgnd2 L1_2 0 {g}
.ENDS

.SUBCKT C  L1_1 L1_2
+	PARAMS:
+	C=0.5	;
+   fn={fn1}
+   XC=0
+ length=1
+ IC=0
+ rser=0
+ g=1e12
.PARAM
+   C1=IF(xc>0,1/(xc+1e-15)/fn/2/pi,C)
CL1 L1_1 L1_2 {C1*length} rser={rser} IC={IC}
Rgnd1 L1_1 0 {g}
Rgnd2 L1_2 0 {g}
.ENDS

.SUBCKT   Impedance  L1_1 L2_1 L3_1 L1_2 L2_2 L3_2
+	PARAMS:
+   R=0.5
+   L=0.001
+   fn={fn1}
+   XL=0
+   length=1
+   IC1=0
+   IC2=0
+   IC3=0
+   g=1e12
.PARAM
+   R1={R} 
+   R2={R} 
+   R3={R}
+	L1={L}	;
+	L2={L}	;
+	L3={L}	;
+   XL1={XL} ;if present L1 is ignored
+   XL2={XL}
+   XL3={XL}
+   L11=IF(XL1>0,xl1/fn/2/pi,L1)
+   L22=IF(XL2>0,xl2/fn/2/pi,L2)
+   L33=IF(XL3>0,xl3/fn/2/pi,L3)
RL1 L1_1 L1_1m {R1*length}
RL2 L2_1 L2_1m {R2*length}
RL3 L3_1 L3_1m {R3*length}
LL1 L1_1m L1_2 {L11*length} rser=0 IC={IC1}
LL2 L2_1m L2_2 {L22*length} rser=0 IC={IC2}
LL3 L3_1m L3_2 {L33*length} rser=0 IC={IC3}
Rgnd1 L1_1 0 {g}
Rgnd2 L2_1 0 {g}
Rgnd3 L3_1 0 {g}
Rgnd4 L1_2 0 {g}
Rgnd5 L2_2 0 {g}
Rgnd6 L3_2 0 {g}
.ENDS