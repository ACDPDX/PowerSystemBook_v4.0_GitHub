Version 4.1
SHEET 1 964 680
WIRE 240 32 80 32
WIRE 400 32 304 32
WIRE 240 48 80 48
WIRE 400 48 304 48
WIRE 240 64 80 64
WIRE 400 64 304 64
WIRE 80 96 80 80
WIRE 400 96 400 80
FLAG 80 96 0
FLAG 400 96 0
SYMBOL v_3phase 48 32 R0
WINDOW 3 -125 -15 Left 2
SYMATTR Value U1Nenn=400V FREQU={fn1} Texp=0m Tpwl=500ms TD=0
SYMATTR InstName U15
SYMBOL impedance 272 32 R0
SYMATTR Value2 R1={R} L1={L}
SYMATTR SpiceLine R2={R} L2={L}
SYMATTR SpiceLine2 R3={R} L3={L}
SYMATTR InstName U16
SYMBOL trafo_Yy 480 48 R0
SYMATTR Value SN=10k U1Nenn=400  U20=280 fn={fn1} N1=1000
SYMATTR Value2 uR=0.04 uX=0.08 i0=0.05 p0=0.005 a=0.75 m=9
SYMATTR InstName U1
TEXT -80 128 Left 2 !.options vntol=1u abstol=1n \n.param tdv=1 tdt=1 fn1=50 omega_n={2*pi*fn1}
TEXT -80 152 Left 2 !.tran 0 1000ms 0 0.1ms
TEXT 224 88 Left 2 !.param R=1e-6 L={3e-6/314.159}
TEXT 112 -80 Left 6 ;Example 1: Noload
TEXT -24 0 Left 2 ;Tpwl= switch voltage source on, linear, starting from zero
TEXT -80 176 Left 2 ;+               SN=10kVA ; nominal apparent power\n+               U1Nenn=400V ; primary voltage\n+               U20=280V ; secondary voltage\n+               fn={fn1} ; frequency\n+               N1=1000 ; Nr. of windings of primary side\n+               uR=0.04 ; relative parameter for resistance of winding\n+               uX=0.08 ; relative parameter for reactance of winding (uk=sqrt(ur*ur+ux*ux)) = rel. short circuit voltage \n+               i0=0.05 ; relative parameter for no load current ( sum of iron lost current and magnetizing current ) \n+               p0=0.005 ; relative iron lost parameter (have to be smaller than i0) \n+   a=0.75 ; nonlinear magnetizing shape parameter (lower a -> higher nonlinearity, a=1 for linear core)\n+   m=9 ; second nonlinear magnetizing shape parameter set as odd e.g. 7,9 (m=1 for linear core)\n+   psi_0=0 ; Remanent flux parameter set 1 for full remanent flux\n+   psir=1 ; Full remanent flux on Phase1\n+   psis=-0.5 ; Halve neg. remanent flux on Phase2\n+   psit=-0.5 ; Halve neg. remanent flux on Phase3\n+   tpsi0=1000s ; Time when full remanent flux is applied (set high if no remanent flux)\n+   tpsid=0.1ms ; Switcher parameter for setting remanent flux (do not change) \n+   ron=0.00001 ; Switcher parameter for setting remanent flux (do not change)\n+   bf=0    ; If 1 Phase 2 (middle) magnetizing current is simulated lower due to smaller magnetizing path\n+   rkessel=5e6 ; magn. resistance of the transformer kettle
TEXT -80 400 Left 2 ;N2:N1*U20/U1Nenn=700 ; Nr of winding of secondary side\ninos:SN/U1Nenn/sqrt(3)=14.4 nominal primary current\ninus:inos*U1Nenn/U20=20.62  nominal secondary current\nz1n:U1Nenn/sqrt(3)/inos=16.0 nominal impedance\nR1:z1n*ur/2=0.32 primary resistance (due to copper lost)\nX1:z1n*ux/2=0.64 primary reactance (due to leakage)\nL1s:X1/omega=0.00204 primary leakage inductance\nR2:R1*N2*N2/N1/N1=0.1568 secondary resistance\nX2:X1*N2*N2/N1/N1=0.3136 secondary reactance\nL2s:X2/omega=0.001 secondary leakage inductance\nuk: sqrt(ur*ur+ux*ux) relative short circuit voltage\nikpeak: inos*sqrt(2)/uk=228A maximal short circuit current\nxhos:U1Nenn*U1Nenn/(SN*sqrt(i0*i0-p0*p0))=321.612 main field impedance\nrfeos:U1Nenn*U1Nenn/(p0*SN)=3200.0 ; resistance due to iron lost\nvfe:p0*SN=50.0 ; iron lost active power\nvcu:ur*SN=400.0 ; copper lost active power\nimue:(U1Nenn/sqrt(3))/xhos=0.718 ; magnetizing current\nife:(U1Nenn/sqrt(3))/rfeos=0.0722 ; fiktive iron lost current\nioabs:sqrt(imue*imue+ife*ife)=0.722 ; no load transformer current\nioabs_peak:sqrt(2)*ioabs=1.020 ; no load transformer current peak value\n \nHINT: See also trafo_YY.lib
TEXT 232 104 Left 2 ;Set R,L small to get\ntransformers nominal\nvalues
TEXT 224 16 Left 2 ;voltage drop near zero
TEXT 408 0 Left 2 ;primary\nside
TEXT -80 112 Left 2 ;.options logparams ; Ltspice 24.1.8
TEXT 64 -32 Left 5 ;Transformer 400/280  Yy0  SN=10kVA
