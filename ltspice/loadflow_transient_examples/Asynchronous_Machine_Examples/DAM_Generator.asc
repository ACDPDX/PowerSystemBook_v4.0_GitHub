TEXT -120 -88 Left 2 !.tran 0 2 1m 0.5m uic
TEXT -120 -112 Left 2 !.param tdv=1 tdt=1 fn1=50 omega_n={2*pi*fn1}\n.options vntol=1m abstol=1u
TEXT -120 -72 Left 2 ;P=Mi*omega/p -> V(u2:mech:mi)*314.159/2\nV(u2:mech:mi) = inner torque\nV(u2:mech:rbg) = relative friction torque = 0.1*MN
TEXT -120 -40 Left 2 ;MN=PN*60/6.2832/nN=700000*60/6.2832/1500=4456\nMRbg=0.1*4456=445.6 -> Mi = approx. 5000
TEXT 312 88 Left 2 ;PN should not be higher than 0.7 UN*IN*1.73
TEXT 32 168 Left 2 !.param pn=1000 qn=-9000
TEXT 48 192 Left 2 ;NOTE:\nThe generator needs capacitive power to start !!!\nAlthough the model must have nonlinear magnetic core\nconditions
TEXT 128 160 Left 2 ;Cap. load !!!
TEXT 400 -64 Left 2 ;NOTE:\nSpeed positiv: \nML pos. is generator\nML neg. is motor\nSpeed negativ:\nML pos. is motor\nML neg. is generator\nAlways: \nPcu+Pfe+Prgb+Pmech+Pnet=0 (Prbg=friction)
