+   U1N={U1Nenn}
+	I1N={SN/U1N}
+	Z1N={U1N/I1N}
+	omegaN={(2*pi)*fN}
+	R1={Z1N*uR/2}
+	L1s={Z1N*uX/2/omegaN}
+	RFe={U1N*U1N/(p0*SN)}
+	N2={N1*U20/U1N}
+	R2={R1*N2/N1*N2/N1}
+   Xh={(U1N*U1N)/(SN*sqrt(i0*i0-p0*p0))} ;FS
+   iu={U1N/Xh} ;FS
+   ImyN={sqrt(2)*iu} ;FS
+	phiN={sqrt(2)*U1N/omegaN/N1}
*	Wicklungsstroeme
Gi1	p2	N	VALUE={v(a)/N1} tripdv={tdv} tripdt={tdt}
Rpi1	p2	N	1000MEG
Gi2	p1	p2	VALUE={v(b,a)/N2} tripdv={tdv} tripdt={tdt}
Rpi2	p1	p2	1000MEG
X_w1	0	a	p2	N	WICKLUNG_1ph
+PARAMS:  Rphis={N1*N1/L1s} R={R1} N={N1} Psi_0={Psi_0*phiN}  tpsi0={tpsi0} tpsid={tpsid} ron={ron}
X_w2	a	b	p1	p2	WICKLUNG_1ph
+PARAMS:  Rphis={N1*N1/L1s} R={R2}   N={N2}  Psi_0={Psi_0*phiN}  tpsi0={tpsi0} tpsid={tpsid} ron={ron}
X_Sch	b 0  SCHENKEL_1ph
+PARAMS: N={N1}  a={a}  m={m}  phiN={phiN}  imyN={imyN}  RFe={RFe}
.ENDS

* Stacked a: Trafo Uin=2640V(U1Nenn+U20) Uout=240V(U20)
* Stacked b: Trafo Uin=240V(U20) Uout=2640V(U1Nenn+U20)
* Stacked c: Trafo Uin=2640V(U1Nenn+U20) Uout=2400V(U1Nenn)
* Stacked d: Trafo Uin=2400V(U1Nenn) Uout=2640V(U1Nenn+U20)
.SUBCKT   Trafo_24kVA_2400V_240V_stacked_d  p1  N  p2  N
+	PARAMS:
+	SN=24kVA
+	U1Nenn=2400
+	U20=240
+	fn={fn1}
+	N1=1000
+	uR=0.04
+	uX=0.08
+	i0=0.05
+	p0=0.005
+   a=0.3  ;
+   m=1 ;
+   psi_0=0 ;
+   tpsi0=1000s ;
+   tpsid=0.1ms  ;
+   ron=0.00001 ;
.PARAM
+   U1N={U1Nenn}
+	I1N={SN/U1N}
+	Z1N={U1N/I1N}
+	omegaN={(2*pi)*fN}
+	R1={Z1N*uR/2}
+	L1s={Z1N*uX/2/omegaN}
+	RFe={U1N*U1N/(p0*SN)}
+	N2={N1*U20/U1N}
+	R2={R1*N2/N1*N2/N1}
+   Xh={(U1N*U1N)/(SN*sqrt(i0*i0-p0*p0))} ;FS
+   iu={U1N/Xh} ;FS
+   ImyN={sqrt(2)*iu} ;FS
+	phiN={sqrt(2)*U1N/omegaN/N1}
*	Wicklungsstroeme
Gi1	p1	N	VALUE={v(a)/N1} tripdv={tdv} tripdt={tdt}
Rpi1	p1	N	1000MEG
Gi2	p2	p1	VALUE={v(b,a)/N2} tripdv={tdv} tripdt={tdt}
Rpi2	p2	p1	1000MEG
X_w1	0	a	p1	N	WICKLUNG_1ph
+PARAMS:  Rphis={N1*N1/L1s} R={R1} N={N1} Psi_0={Psi_0*phiN}  tpsi0={tpsi0} tpsid={tpsid} ron={ron}
X_w2	a	b	p2	p1	WICKLUNG_1ph
+PARAMS:  Rphis={N1*N1/L1s} R={R2}   N={N2}  Psi_0={Psi_0*phiN}  tpsi0={tpsi0} tpsid={tpsid} ron={ron}
X_Sch	b 0  SCHENKEL_1ph
+PARAMS: N={N1}  a={a}  m={m}  phiN={phiN}  imyN={imyN}  RFe={RFe}
.ENDS

* changed: 
*    One phase transformer with lost and nonlinearity and initial residual flux and controlling node 
.SUBCKT   Trafo1_psi_0_ctrl  p1  p2  s3  s4 ctrl
+	PARAMS:
+	SN=1kVA
+	U1Nenn=230V
+	U20=230V
+	fn={fn1}
+	N1=1000
+	uR=0.04
+	uX=0.08
+	i0=0.05
+	p0=0.005
+   a=0.3  ;
+   m=7 ;
+   psi_0=0 ;
+   tpsi0=1000s ;
+   tpsid=0.1ms  ;
+   ron=0.00001 ;
.PARAM
+   U1N={U1Nenn}
+	I1N={SN/U1N}
+	Z1N={U1N/I1N}
+	omegaN={(2*pi)*fN}
+	R1={Z1N*uR/2}
+	L1s={Z1N*uX/2/omegaN}
+	RFe={U1N*U1N/(p0*SN)}
+	N2={N1*U20/U1N}
+	R2={R1*N2/N1*N2/N1}
+   Xh={(U1N*U1N)/(SN*sqrt(i0*i0-p0*p0))} ;FS
+   iu={U1N/Xh} ;FS
+   ImyN={sqrt(2)*iu} ;FS
+	phiN={sqrt(2)*U1N/omegaN/N1}
*	Wicklungsstroeme
Rctrl ctrl 0 1e12
Gi1	p1	p2	VALUE={v(a)/(N1*v(ctrl))} tripdv={tdv} tripdt={tdt}
Rpi1	p1	p2	1000MEG
Gi2	s3	s4	VALUE={v(b,a)/N2} tripdv={tdv} tripdt={tdt}
Rpi2	s3	s4	1000MEG
X_w1	0	a	p1	p2	ctrl WICKLUNG_ctrl_1ph
+PARAMS:  Rphis={N1*N1/L1s} R={R1} N={N1} Psi_0={Psi_0*phiN}  tpsi0={tpsi0} tpsid={tpsid} ron={ron}
X_w2	a	b	s3	s4	WICKLUNG_1ph
+PARAMS:  Rphis={N1*N1/L1s} R={R2}   N={N2}  Psi_0={Psi_0*phiN}  tpsi0={tpsi0} tpsid={tpsid} ron={ron}
X_Sch	b 0 ctrl SCHENKEL_ctrl_1ph
+PARAMS: N={N1}  a={a}  m={m}  phiN={phiN}  imyN={imyN}  RFe={RFe}
.ENDS
***	Ende des SUBCIRCUITS Trafo1
*
.subckt Trafo_N1N2_simple  p1  p2  s3  s4
+	PARAMS:
+	SN=1kVA
+	U1Nenn=230V
+	U20=230V
+	fn={fn1}
+	N1=1000
+	uR=0.04
+	uX=0.08
+	i0=0.05
+	p0=0.005
+   l=0
+   proz=1
.PARAM
+   U1N={U1Nenn}
+	I1N={SN/U1N}
+	Z1N={U1N/I1N}
+	omegaN={(2*pi)*fN}
+	R1={Z1N*uR/2}
+	L1s={Z1N*uX/2/omegaN}
+	RFe={U1N*U1N/(p0*SN)}
+	N2={N1*U20/U1N}
+	R2={R1*N2/N1*N2/N1}
+   Xh={(U1N*U1N)/(SN*sqrt(i0*i0-p0*p0))} ;FS
+   iu={U1N/Xh} ;FS
+   ImyN={sqrt(2)*iu} ;FS
+	phiN={sqrt(2)*U1N/omegaN/N1}
Rcup  p1 x1 {R1}
L1p    x1 p11 {L1s} rser=0
Rfe1   p11 p2 {RFe}
*LXh    p11 p2 {Xh/omegaN} rser=0
LXh p11 p2 flux={Xh/omegaN*x*(1+l*proz/100)**2} rser=0
Rcus   s33  x2 {R2}
L1s   x2 s3 {L1s*N2/N1*N2/N1} rser=0
X_w1	p11 p2  s33  s4 N1N2_1ph
+PARAMS:  N1={N1} N2={N2} proz={proz} k=1 l={l}
.ends

.subckt Trafo_N1N2_simple_ctrl p1  p2  s3  s4  ctrl
+	PARAMS:
+	SN=1kVA
+	U1Nenn=230V
+	U20=230V
+	fn={fn1}
+	N1=1000
+	uR=0.04
+	uX=0.08
+	i0=0.05
+	p0=0.005
.PARAM
+   U1N={U1Nenn}
+	I1N={SN/U1N}
+	Z1N={U1N/I1N}
+	omegaN={(2*pi)*fN}
+	R1={Z1N*uR/2}
+	L1s={Z1N*uX/2/omegaN}
+	RFe={U1N*U1N/(p0*SN)}
+	N2={N1*U20/U1N}
+	R2={R1*N2/N1*N2/N1}
+   Xh={(U1N*U1N)/(SN*sqrt(i0*i0-p0*p0))} ;FS
+   iu={U1N/Xh} ;FS
+   ImyN={sqrt(2)*iu} ;FS
+	phiN={sqrt(2)*U1N/omegaN/N1}
Rctrl ctrl 0 1e12
Rcup  p1 x1 {R1}
L1p    x1 p11 {L1s} rser=0
Rfe1   p11 p2 {RFe}
*LXh    p11 p2 {Xh/omegaN} 
LXh p11 p2 flux={Xh/omegaN*x*v(ctrl)*v(ctrl)} rser=0
Rcus   s33  x2 {R2} 
L1s   x2 s3 {L1s*N2/N1*N2/N1} rser=0
X_w1	p11 p2  s33  s4  ctrl  N1N2_ctrl_1ph
+PARAMS:  N1={N1} N2={N2}
.ends

* ***********************************************************************
* subcircuits used in every transformer model
*************************************************************************
*
.SUBCKT WICKLUNG_1ph  ma  mb  ea  eb
+PARAMS:   R=1   N=1    Rphis=1 psi_0=0 tpsi0=20ms tpsid=0.1ms ron=0.00001 ;passt für 1ms Schaltzeit bei C mit 1Coulomb
Gphi	ma	mb	VALUE={v(phi)} tripdv={tdv} tripdt={tdt}
Rphis	ma	mb	{Rphis}
Gp	0	phi	VALUE={(v(ea,eb)-R*v(mb,ma)/(N))/(N)} tripdv={tdv} tripdt={tdt}
Cp phi 0 1 IC=0
Vctrl ctrl 0 pwl 0s 0v {tpsi0+1p} 0v {tpsi0+tpsid+2p} 1V {tpsi0+2*tpsid+3p} 1v {tpsi0+3*tpsid+4p} 0v
S1 phi phix ctrl 0 MS1
.model MS1 SW(Ron={Ron} Roff=1e9 Vt=0.9 Vh=0.0 Lser=0 Vser=0)
E1 phix 0 value={psi_0} tripdv={tdv} tripdt={tdt} ; das ist die Spannungsquelle mit psi_0 der den Kondensator Cp auflädt !!!
Rp	phi	0	1000MEG
.ENDS ;  Wicklung

.SUBCKT auto_WICKLUNG_1ph  ma  mb  ea  eb n R
+PARAMS:   R=1   N=1    Rphis=1 psi_0=0 tpsi0=20ms tpsid=0.1ms ron=0.00001 ;passt für 1ms Schaltzeit bei C mit 1Coulomb
Gphi	ma	mb	VALUE={v(phi)} tripdv={tdv} tripdt={tdt}
Rphis	ma	mb	{Rphis}
Gp	0	phi	VALUE={(v(ea,eb)-v(R)*v(mb,ma)/(v(N)))/(v(N))} tripdv={tdv} tripdt={tdt}
Cp phi 0 1 IC=0
Vctrl ctrl 0 pwl 0s 0v {tpsi0+1p} 0v {tpsi0+tpsid} 1V {tpsi0+2*tpsid} 1v {tpsi0+3*tpsid} 0v
S1 phi phix ctrl 0 MS1
.model MS1 SW(Ron={Ron} Roff=1e9 Vt=0.9 Vh=0.0 Lser=0 Vser=0)
E1 phix 0 value={psi_0} tripdv={tdv} tripdt={tdt} ; das ist die Spannungsquelle mit psi_0 der den Kondensator Cp auflädt !!!
Rp	phi	0	1000MEG
.ENDS ;  Wicklung

.SUBCKT WICKLUNG_ctrl_1ph  ma  mb  ea  eb ctrl
+PARAMS:   R=1   N=1    Rphis=1 psi_0=0 tpsi0=20ms tpsid=0.1ms ron=0.00001
Gphi	ma	mb	VALUE={v(phi)} tripdv={tdv} tripdt={tdt}
Gphis	ma	mb	VALUE={v(ma,mb)/(Rphis*v(ctrl)*v(ctrl))} tripdv={tdv} tripdt={tdt}
Gp	0	phi	VALUE={(v(ea,eb)-R*v(ctrl)*v(mb,ma)/(N*v(ctrl)))/(N*v(ctrl))} tripdv={tdv} tripdt={tdt}
Cp phi 0 1 IC=0
Vctrl ctrl 0 pwl 0s 0v {tpsi0+1p} 0v {tpsi0+tpsid+2p} 1V {tpsi0+2*tpsid+3p} 1v {tpsi0+3*tpsid+4p} 0v
S1 phi phix sctrl 0 MS1
.model MS1 SW(Ron={Ron} Roff=1e9 Vt=0.9 Vh=0.0 Lser=0 Vser=0)
E1 phix 0 value={psi_0} tripdv={tdv} tripdt={tdt} ;
Rp	phi	0	1000MEG
.ENDS ;  Wicklung


.SUBCKT SCHENKEL_1ph  m1  m2
+PARAMS:   N=1  RFe=1  ImyN=1  a=1  phiN=1 m=9
LRFe	m1	mh	{N*N/RFe} Rser={0.001m*N*N/RFe}  ; Rser=parasitic value for better convergence
* Rfe
vphi	mh	mh1	0
rphi    mh  0 1e12 
Eimy	mh1	m2
+VALUE={N*imyN*(a*i(vphi)/phiN+(1-a)*PWRS(i(vphi)/phiN,m))} tripdv={tdv} tripdt={tdt}
.ENDS;  SCHENKEL


.SUBCKT SCHENKEL_ctrl_1ph  m1  m2 ctrl 
+PARAMS:   N=1  RFe=1  ImyN=1  a=1  phiN=1 m=9
LRFe	m1	mh	flux={x*((N*N*v(ctrl)*v(ctrl))/RFe)} Rser={0.001m*N*N/RFe}   ; Rser=parasitic value for better convergence  
* Rfe
vphi	mh	mh1	0
rphi    mh  0 1e12 
Eimy	mh1	m2
+VALUE={N*imyN*(a*i(vphi)/phiN+(1-a)*PWRS(i(vphi)/phiN,m))} tripdv={tdv} tripdt={tdt}
.ENDS;  SCHENKEL


* ideal 1 phase transformer unit with voltage regulator parameter L
* L is absolut -13,-12, ....0....12,13
* voltage drop is according to L*stproz/100
.subckt N1N2_1ph in1 in2 out1 out2
+params: N1=1 N2=1 k=1 proz=1 l=0
.param ue={N1/N2}
G1 0 M in1 in2 1
G2 0 M VALUE={-k*(v(out1)-v(out2))*(ue+ue*(l*proz/100))} tripdv={tdv} tripdt={tdt}
G3 in1 in2 M 0 1
G4 out1 out2 VALUE={-k*(v(m))*(ue+ue*(l*proz/100))} tripdv={tdv} tripdt={tdt}
R2 M 0 1e10
Rin1 in1 0 1e10
Rin2 in2 0 1e10
Rout1 out1 0 1e10
Rout2 out2 0 1e10
.ends

* ideal 1 phase transformer unit with extern voltage regulator paramaeter pin (l)
* L is now relative UE/UEN=1+stproz/100 (0.9..1.0...1.1)
.subckt N1N2_ctrl_1ph in1 in2 out1 out2 l
+params: k=1 N1=1 N2=1
.param ue={N1/N2}
G1 0 M in1 in2 1
G2 0 M VALUE={-k*((v(out1)-v(out2))*ue*v(l))} tripdv={tdv} tripdt={tdt}
G3 in1 in2 M 0 1
G4 out1 out2 VALUE={-k*((v(m))*ue*v(l))} tripdv={tdv} tripdt={tdt}
Rl l 0 1e12
R2 M 0 1e10
Rin1 in1 0 1e10
Rin2 in2 0 1e10
Rout1 out1 0 1e10
Rout2 out2 0 1e10
.ends

* another ideal one phase transformer
.subckt L1L2k in1 in2 out1 out2
+params: L1=1 L2=1 k=1
L1 in1 in2 {L1}
L2 out1 out2 {L2}
K12 L1 L2 {k}
.ends
