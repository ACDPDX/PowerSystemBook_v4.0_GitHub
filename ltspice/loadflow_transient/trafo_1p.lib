***************************************************
* linear and nonlinear one phase transformer
* *************************************************



*    One phase transformer with lost and nonlinearity and initial residual flux
.SUBCKT   Trafo1_psi_0  p1  p2  s3  s4
+	PARAMS:
+	SN=1kVA
+	U1Nenn=230V
+	U20=230V
+	fn={fn1}
+	N1=1000
+	uR=0.04
+	uX=0.08
+	i0=0.05
+	p0=0.005
+   a=0.3  ;
+   m=7 ;
+   psi_0=0 ;
+   tpsi0=1000s ;
+   tpsid=0.1ms  ;
+   ron=0.00001 ;
.PARAM
+   U1N={U1Nenn}
+	I1N={SN/U1N}
+	Z1N={U1N/I1N}
+	omegaN={(2*pi)*fN}
+	R1={Z1N*uR/2}
+	L1s={Z1N*uX/2/omegaN}
+	RFe={U1N*U1N/(p0*SN)}
+	N2={N1*U20/U1N}
+	R2={R1*N2/N1*N2/N1}
+   Xh={(U1N*U1N)/(SN*sqrt(i0*i0-p0*p0))} ;FS
+   iu={U1N/Xh} ;FS
+   ImyN={sqrt(2)*iu} ;FS
+	phiN={sqrt(2)*U1N/omegaN/N1}
*	Wicklungsstroeme
Gi1	p1	p2	VALUE={v(a)/N1} tripdv={tdv} tripdt={tdt}
Rpi1	p1	p2	1000MEG
Gi2	s3	s4	VALUE={v(b,a)/N2} tripdv={tdv} tripdt={tdt}
Rpi2	s3	s4	1000MEG
X_w1	0	a	p1	p2	WICKLUNG_1ph
+PARAMS:  Rphis={N1*N1/L1s} R={R1} N={N1} Psi_0={Psi_0*phiN}  tpsi0={tpsi0} tpsid={tpsid} ron={ron}
X_w2	a	b	s3	s4	WICKLUNG_1ph
+PARAMS:  Rphis={N1*N1/L1s} R={R2}   N={N2}  Psi_0={Psi_0*phiN}  tpsi0={tpsi0} tpsid={tpsid} ron={ron}
X_Sch	b 0  SCHENKEL_1ph
+PARAMS: N={N1}  a={a}  m={m}  phiN={phiN}  imyN={imyN}  RFe={RFe}
.ENDS


.SUBCKT   Trafo1_psi_0_auto_stacked_a  p1  N  p2  N
+	PARAMS:
+	SN=1kVA
+	U1Nenn=480V
+	U20=240V
+	fn={fn1}
+	N1=1000
+	uR=0.04
+	uX=0.08
+	i0=0.05
+	p0=0.005
+   a=0.3  ;
+   m=7 ;
+   psi_0=0 ;
+   tpsi0=1000s ;
+   tpsid=0.1ms  ;
+   ron=0.00001 ;
.PARAM
+   UN={U1Nenn}
+   Uvar={U20}
+   uex={UN/Uvar}
+   U2={UN/(uex-1+1p)}
+	I1N={SN/UN}
+	Z1N={UN/I1N}
+	omegaN={(2*pi)*fN}
+	R={Z1N*ur}
+	Ls={Z1N*ux/omegan}
+	RFe={UN*UN/(p0*SN)}
;+	N2={N1*U20/UN}
+   Xh={(UN*UN)/(SN*sqrt(i0*i0-p0*p0))} ;FS
+   iu={UN/Xh} ;FS
+   ImyN={sqrt(2)*iu} ;FS
+	phiN={sqrt(2)*UN/omegaN/N1}
+   ue1={1+UN/U2}
+   ue={UN/U2}
+   uea={ue/ue1}
+   ueb={ue*ue/(ue*ue+1)}
+   L1s={Ls*ueb}
+   L2s={Ls*(1-ueb)}
+   R1={R*uea}
+   R2={R*(1-uea)}
+   N1a={2*N1*uea}
+   N2={2*N1-N1a}
*	Wicklungsstroeme
Gi1	p1	p2	VALUE={v(a)/N1a} tripdv={tdv} tripdt={tdt}
Rpi1	p1	p2	1000MEG
Gi2	p2	N	VALUE={v(b,a)/N2} tripdv={tdv} tripdt={tdt}
Rpi2	p2	N	1000MEG
X_w1	0	a	p1	p2	WICKLUNG_1ph
+PARAMS:  Rphis={N1a*N1a/L1s} R={R1} N={N1a} Psi_0={Psi_0*phiN}  tpsi0={tpsi0} tpsid={tpsid} ron={ron}
X_w2	a	b	p2	N	WICKLUNG_1ph
+PARAMS:  Rphis={N2*N2/L2s} R={R2}   N={N2}  Psi_0={Psi_0*phiN}  tpsi0={tpsi0} tpsid={tpsid} ron={ron}
X_Sch	b 0  SCHENKEL_1ph
+PARAMS: N={2*N1}  a={a}  m={m}  phiN={phiN}  imyN={imyN}  RFe={RFe}
.ENDS


* Be aware: For this transformer U1Nenn and U20 are direct 
* the desired input and output voltages !!!! 
.SUBCKT   Trafo_1phase_simple_auto  p1  N  p2  N
+	PARAMS: 
+ SN=720 
+ U1Nenn=480
+ U20=240 
+ fn=50 
+ omegan={2*pi*fn} 
+ ur=0.21 
+ ux=0.24
+ i0=0.0355 
+ p0=0.0208 
.param UN={U1Nenn}
.param Uvar={U20}
.param U1N={UN/2}
.param U2N={UN/2}
.param U12N={U1N+U2N}
.param uex={U12N/uvar}
.param U2={U1N/(uex-1+1p)}
.param I1N={SN/UN}
.param Z1N={UN/I1N}
.param R1={Z1N*uR}
.param L1s={Z1N*uX/omegan}
.param Rfe={UN*UN/(p0*SN)}
.param Xh={(UN*UN)/(SN*sqrt(i0*i0-p0*p0))}
.param L1={Xh/omegan}
.param sigma1={L1s/L1}
.param sigma={2*sigma1-sigma1*sigma1}
.param k={sqrt(1-sigma)}
.param ue1={1+U1N/U2}
.param ue={U1N/U2}
.param uea={ue/ue1}
.param ueb={ue*ue/(ue*ue+1)}
.param L1m={L1*ueb}
.param L2m={L1*(1-ueb)}
.param R1m={R1*uea}
.param R2m={R1*(1-uea)}
Rfe p1 N {Rfe}
R1 p1 p1a {R1m}
L1 p1a p2 {L1m}
R2 p2 p2a {R2m}
L2 p2a N {L2m}
K12 L1 L2 {k}
Re N 0 1e6 
.ENDS

* Stacked a: Trafo Uin=480V(U1Nenn+U20) Uout=120V(U20)
* Stacked b: Trafo Uin=120V(U20) Uout=480V(U1Nenn+U20)
* Stacked c: Trafo Uin=480V(U1Nenn+U20) Uout=360V(U1Nenn)
* Stacked d: Trafo Uin=360V(U1Nenn) Uout=480V(U1Nenn+U20)
.SUBCKT   Trafo_720VA_360V_120V_stacked_a  p1  N  p2  N
+	PARAMS:
+	SN=720
+	U1Nenn=360
+	U20=120
+	fn={fn1}
+	N1=1000
+	uR=0.21
+	uX=0.24
+	i0=0.03355
+	p0=0.0208
+   a=0.3  ;
+   m=1 ;
+   psi_0=0 ;
+   tpsi0=1000s ;
+   tpsid=0.1ms  ;
+   ron=0.00001 ;
.PARAM
+   U1N={U1Nenn}
+	I1N={SN/U1N}
+	Z1N={U1N/I1N}
+	omegaN={(2*pi)*fN}
+	R1={Z1N*uR/2}
+	L1s={Z1N*uX/2/omegaN}
+	RFe={U1N*U1N/(p0*SN)}
+	N2={N1*U20/U1N}
+	R2={R1*N2/N1*N2/N1}
+   Xh={(U1N*U1N)/(SN*sqrt(i0*i0-p0*p0))} ;FS
+   iu={U1N/Xh} ;FS
+   ImyN={sqrt(2)*iu} ;FS
+	phiN={sqrt(2)*U1N/omegaN/N1}
*	Wicklungsstroeme
Gi1	p1	p2	VALUE={v(a)/N1} tripdv={tdv} tripdt={tdt}
Rpi1	p1	p2	1000MEG
Gi2	p2	N	VALUE={v(b,a)/N2} tripdv={tdv} tripdt={tdt}
Rpi2	p2	N	1000MEG
X_w1	0	a	p1	p2	WICKLUNG_1ph
+PARAMS:  Rphis={N1*N1/L1s} R={R1} N={N1} Psi_0={Psi_0*phiN}  tpsi0={tpsi0} tpsid={tpsid} ron={ron}
X_w2	a	b	p2	N	WICKLUNG_1ph
+PARAMS:  Rphis={N1*N1/L1s} R={R2}   N={N2}  Psi_0={Psi_0*phiN}  tpsi0={tpsi0} tpsid={tpsid} ron={ron}
X_Sch	b 0  SCHENKEL_1ph
+PARAMS: N={N1}  a={a}  m={m}  phiN={phiN}  imyN={imyN}  RFe={RFe}
.ENDS

