*************************************************************************


* ***********************************************************************
* Wichtige Subcircuits die für alle Trafomodelle gebraucht werden !!!!
* ***********************************************************************
*
*  Trafoschenkel2_Yy
* SCHENKEL_Yy eines Transformators mit 2 Wicklungen *
****** die AC-Analyse beruecksichtigt nur den linearen Anteil
******* der Magnetisierungskurve i=f(phi)
* Xu	1U	1N	2U	2N	magn1	magn2	Trafoschenkel2_Yy
* Xv	1V	1N	2V	2N	magn1	magn2	Trafoschenkel2_Yy
* Xw	1W	1N	2W	2N	magn1	magn2	Trafoschenkel2_Yy


.SUBCKT   Trafoschenkel2_Yy  1_1 1_2  2_1 2_2  magnP1 magnP2
+	PARAMS:
+	SN=10kVA
+	U1N=400V
+	U20=400V
+	fn={fn1}
+	N1=1000
+	uR=0.04
+	uX=0.08
+	i0=0.05
+	p0=0.005
+   a={0.3} ; FS
+   m={7} ; FS
+   psi_0=0 ; Remanenzparameter zwischen 0,1,-1
+   tpsi0=40ms
+   tpsid=0.1ms
+   ron=0.00001
+   calib_rfe=1 ; Kalibrierungsfactor für Aufteilung auf mehrere SCHENKEL_Yy
+   calib_imy=1 ; Kalibrierungsfactor für Aufteilung auf mehrere SCHENKEL_Yy
+   ctrl=1
.PARAM
+	I1N={SN/U1N}
+	Z1N={U1N/I1N}
+	omegaN={(2*pi)*fN}
+	R1={Z1N*uR/2}
+	L1s={Z1N*uX/2/omegaN}
+	RFe={U1N*U1N/(p0*SN)}
+	N2={N1*U20/U1N}
+	R2={R1*N2/N1*N2/N1}
+   Xh={(U1N*U1N)/(SN*sqrt(i0*i0-p0*p0))} ;FS
+   iu={U1N/Xh} ;FS
+   ImyN={sqrt(2)*iu} ;FS
+	phiN={sqrt(2)*U1N/omegaN/N1}
+   a={a} ; FS
+   m={m} ; FS
*	Wicklungsstroeme
Gi1	1_1	1_2	VALUE={v(a,magnP1)/(N1*ctrl)} tripdv={tdv} tripdt={tdt}
Rpi1	1_1	1_2	1000MEG
Gi2	2_1	2_2	VALUE={v(b,a)/N2} tripdv={tdv} tripdt={tdt}
Rpi2	2_1	2_2	1000MEG
*	Wicklungen
X_W1	magnP1	a	1_1	1_2	WICKLUNG_Yy
+PARAMS:  R={R1}  N={N1}  Rphis={N1*N1/L1s} psi_0={psi_0*phiN} tpsi0={tpsi0} tpsid={tpsid} ron={ron} ctrl={ctrl}
X_W2	a   b    2_1	2_2	WICKLUNG_Yy
+PARAMS:  R={R2}  N={N2}  Rphis={N1*N1/L1s} psi_0={psi_0*phiN} tpsi0={tpsi0} tpsid={tpsid} ron={ron} ctrl=1
*	EisenSchenkel
X_SCH	b	magnP2	SCHENKEL_Yy   PARAMS:
+	N={N1}  RFe={RFe*calib_rfe}  ImyN={ImyN*calib_imy}  ctrl={ctrl}
+	phiN={phiN}	a={a}   m={m}
.ENDS
***	Ende des SUBCIRCUITS Trafoschenkel2_Yy
*$

.SUBCKT   Trafoschenkel2_Yy_1  1_1 1_2  2_1 2_2  magnP1 magnP2
+	PARAMS:
+	SN=10kVA
+	U1N=400V
+	U20=400V
+	fn={fn1}
+	N1=1000
+	uR=0.04
+	uX=0.08
+	i0=0.05
+	p0=0.005
+   a={0.3} ; FS
+   m={7} ; FS
+   psi_0=0 ; Remanenzparameter zwischen 0,1,-1
+   tpsi0=40ms
+   tpsid=0.1ms
+   ron=0.00001
+   calib_rfe=1 ; Kalibrierungsfactor für Aufteilung auf mehrere SCHENKEL_Yy_1
+   calib_imy_a=1 ; Kalibrierungsfactor für Aufteilung auf mehrere SCHENKEL_Yy_1
+   calib_imy_l=1
+   ctrl=1
.PARAM
+	I1N={SN/U1N}
+	Z1N={U1N/I1N}
+	omegaN={(2*pi)*fN}
+	R1={Z1N*uR/2}
+	L1s={Z1N*uX/2/omegaN}
+	RFe={U1N*U1N/(p0*SN)}
+	N2={N1*U20/U1N}
+	R2={R1*N2/N1*N2/N1}
+   Xh={(U1N*U1N)/(SN*sqrt(i0*i0-p0*p0))} ;FS
+   iu={U1N/Xh} ;FS
+   ImyN={sqrt(2)*iu} ;FS
+	phiN={sqrt(2)*U1N/omegaN/N1}
+   a={a} ; FS
+   m={m} ; FS
*	Wicklungsstroeme
Gi1	1_1	1_2	VALUE={v(a,magnP1)/(N1*ctrl)} tripdv={tdv} tripdt={tdt}
Rpi1	1_1	1_2	1000MEG
Gi2	2_1	2_2	VALUE={v(b,a)/N2} tripdv={tdv} tripdt={tdt}
Rpi2	2_1	2_2	1000MEG
*	Wicklungen
X_W1	magnP1	a	1_1	1_2	WICKLUNG_Yy
+PARAMS:  R={R1}  N={N1}  Rphis={N1*N1/L1s} psi_0={psi_0*phiN} tpsi0={tpsi0} tpsid={tpsid} ron={ron} ctrl={ctrl}
X_W2	a   b    2_1	2_2	WICKLUNG_Yy
+PARAMS:  R={R2}  N={N2}  Rphis={N1*N1/L1s} psi_0={psi_0*phiN} tpsi0={tpsi0} tpsid={tpsid} ron={ron} ctrl=1
*	EisenSchenkel
X_SCH	b	magnP2	SCHENKEL_Yy_1   PARAMS:
+	N={N1}  RFe={RFe*calib_rfe} ImyN={ImyN} calib_a={calib_imy_a} calib_l={calib_imy_l} ctrl={ctrl}
+	phiN={phiN}	a={a}   m={m}
.ENDS
***	Ende des SUBCIRCUITS Trafoschenkel2_Yy

