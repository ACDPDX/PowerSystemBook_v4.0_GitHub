.ENDS
*$

* Hosemann_Boeck_Yy0
.SUBCKT Trafo3Yy6_HB  1U  1V  1W  1N  2U  2V  2W  2N
+	PARAMS:
+	SN=10kVA
+	U1Nenn=400V
+	U20=400V
+	fn={fn1}
+	N1=1000
+	uR=0.04
+	uX=0.08
+	i0=0.05
+	p0=0.005
+   a=0.75
+   m=9
+   psi_0=0 ;
+   psir=1
+   psis=-0.5
+   psit=-0.5
+   tpsi0=1000s ;
+   tpsid=0.1ms
+   ron=0.00001 ;
+   bf=0    ;
+   rkessel=6e5 ; magn. resistance of the tank filled with oil / reduce it for an effect (e.g. 1e6)
*
.param i0r={i0*IF(bf==0,1,1.2)}
.param p0r={p0*IF(bf==0,1,1.2)}
.param i0s={i0*IF(bf==0,1,0.6)}
.param p0s={p0*IF(bf==0,1,0.6)}
.param i0t={i0*IF(bf==0,1,1.2)}
.param p0t={p0*IF(bf==0,1,1.2)}
*
.param omega={2*pi*fN}
*
.param S1N={SN/3}
.param U1N={U1Nenn/sqrt(3)}
.param U20N={U20/sqrt(3)}
.param I1N={S1N/U1N}
.param Z1N={U1N/I1N}
.param Rfer={(U1N*U1N)/(p0r*S1N)}
.param Rfes={(U1N*U1N)/(p0s*S1N)}
.param Rfet={(U1N*U1N)/(p0t*S1N)}
.param R1={Z1N*ur/2}
.param L1s={Z1N*ux/2/omega} 
.param N2={N1*U20N/U1N}
.param Xhr={(U1N*U1N)/(S1N*sqrt(i0r*i0r-p0r*p0r))} 
.param Xhs={(U1N*U1N)/(S1N*sqrt(i0s*i0s-p0s*p0s))} 
.param Xht={(U1N*U1N)/(S1N*sqrt(i0t*i0t-p0t*p0t))} 
.param imyr={U1N/Xhr} imyNr={sqrt(2)*imyr}
.param imys={U1N/Xhs} imyNs={sqrt(2)*imys}
.param imyt={U1N/Xht} imyNt={sqrt(2)*imyt}
.param R2={R1*N2/N1*N2/N1}
.param PsiN={U1N/omega}
.param phiN={sqrt(2)*PsiN/N1} 
.param lkessel={1/rkessel} 
*
.param psi_0r={psir*psi_0*phiN}
.param psi_0s={psis*psi_0*phiN}
.param psi_0t={psit*psi_0*phiN}
*
* Template from file: Hosemann_Boeck_Yy0.asc
*
XU5 u11 1n ux vr2 N1N2_Yy N1={N1} N2=1
XU6 uy vr2 2n u2 N1N2_Yy N1=1 N2={N2}
XU7 ux vr L3 length=1 L={L1s/N1/N1} rser={0.001m*L1s/N1/N1} IC=0
XU8 vr uy L3 length=1 L={L1s/N1/N1} rser={0.001m*L1s/N1/N1} IC=0
XU11 v11 1n vx vs2 N1N2_Yy N1={N1} N2=1
XU12 vy vs2 2n v2 N1N2_Yy N1=1 N2={N2}
XU13 vx vs L3 length=1 L={L1s/N1/N1} rser={0.001m*L1s/N1/N1} IC=0
XU14 vs vy L3 length=1 L={L1s/N1/N1} rser={0.001m*L1s/N1/N1} IC=0
XU17 w11 1n wx vt2 N1N2_Yy N1={N1} N2=1
XU18 wy vt2 2n w2 N1N2_Yy N1=1 N2={N2}
XU19 wx vt L3 length=1 L={L1s/N1/N1} rser={0.001m*L1s/N1/N1} IC=0
XU20 vt wy L3 length=1 L={L1s/N1/N1} rser={0.001m*L1s/N1/N1} IC=0
XU23 vt2 rk L3 length=1 L={Lkessel} rser={0.001m*Lkessel} IC=0
G1 0 phir VALUE={v(vr,vr2)} tripdv={tdv} tripdt={tdt}
G2 0 phis VALUE={v(vs,vs2)} tripdv={tdv} tripdt={tdt}
G3 0 phit VALUE={v(vt,vt2)} tripdv={tdv} tripdt={tdt}
XU31 phir 0 C3 length=1 C=1
XU32 phis 0 C3 length=1 C=1
XU33 phit 0 C3 length=1 C=1
XU34 phir 0 r3 length=1 R=1e9
XU35 phis 0 r3 length=1 R=1e9
XU36 phit 0 r3 length=1 R=1e9
G4 vr vr2 VALUE={imyNr*N1*(a*v(phir)/phiN+(1-a)*(v(phir)/phiN)**m)} tripdv={tdv} tripdt={tdt}
G5 vs vs2 VALUE={imyNs*N1*(a*v(phis)/phiN+(1-a)*(v(phis)/phiN)**m)} tripdv={tdv} tripdt={tdt}
G6 vt vt2 VALUE={imyNt*N1*(a*v(phit)/phiN+(1-a)*(v(phit)/phiN)**m)} tripdv={tdv} tripdt={tdt}
V1 vs vr2 0  
V2 vt vs2 0  
V3 vr rk 0  
XU24 1u u11 r3 length=1 R={R1}
XU67 u11 1n r3 length=1 R={Rfer}
XU82 u2 2u r3 length=1 R={R2}
G14 0 phik VALUE={v(vt2,vr)} tripdv={tdv} tripdt={tdt}
XU62 phik 0 C3 length=1 C=1
XU91 phik 0 r3 length=1 R=1e9
XU9 1v v11 r3 length=1 R={R1}
XU25 1w w11 r3 length=1 R={R1}
XU30 v2 2v r3 length=1 R={R2}
XU39 w2 2w r3 length=1 R={R2}
XU40 v11 1n r3 length=1 R={Rfes}
XU42 w11 1n r3 length=1 R={Rfet}
Rvr2  vr2  0 1e6
Rvs2 vs2 0 1e6
Rvt2 vt2 0 1e6
* This is important to have gnd path to ground
*
* Remanent flux model
*
Vctrlr ctrlr 0 pwl 0s 0v {tpsi0} 0v {tpsi0+tpsid} 1V {tpsi0+2*tpsid} 1v {tpsi0+3*tpsid} 0v
S1r phir phixr ctrlr 0 MS1
.model MS1 SW(Ron={Ron} Roff=1e9 Vt=0.9 Vh=0.0 Lser=0 Vser=0)
E1r phixr 0 value={psi_0r} tripdv={tdv} tripdt={tdt} ; das ist die Spannungsquelle mit psi_0 der den Kondensator Cp auflädt !!!
Vctrls ctrls 0 pwl 0s 0v {tpsi0} 0v {tpsi0+tpsid} 1V {tpsi0+2*tpsid} 1v {tpsi0+3*tpsid} 0v
S1s phis phixs ctrls 0 MS1
E1s phixs 0 value={psi_0s} tripdv={tdv} tripdt={tdt} ; das ist die Spannungsquelle mit psi_0 der den Kondensator Cp auflädt !!!
Vctrlt ctrlt 0 pwl 0s 0v {tpsi0} 0v {tpsi0+tpsid} 1V {tpsi0+2*tpsid} 1v {tpsi0+3*tpsid} 0v
S1t phit phixt ctrlt 0 MS1
E1t phixt 0 value={psi_0t} tripdv={tdv} tripdt={tdt} ; das ist die Spannungsquelle mit psi_0 der den Kondensator Cp auflädt !!!
*
RGND1U 1U 0 1e12
RGND1V 1V 0 1e12
RGND1W 1W 0 1e12
RGND2U 2U 0 1e12
RGND2V 2V 0 1e12
RGND2W 2W 0 1e12
RGND1N 1N 0 1e12
RGND2N 2N 0 1e12
.ENDS
