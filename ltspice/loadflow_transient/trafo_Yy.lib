.SUBCKT Trafo3Yy0_7limbs_DAW  1U  1V  1W  1N  2U  2V  2W  2N
+	PARAMS:
+	SN=10kVA ; nominal apparent power
+	U1Nenn=400V ; nominal voltage high voltage side
+	U20=400V ; Nominal voltage low voltage side
+   U30=133V
+	fn={fn1} ; frequency
+	N1=1000 ; nr. of windings high voltage side
+	uR=0.04 ; ohmic part of the relative short circuit voltage
+	uX=0.08 ; inducitve part of the relative short circuit voltage (uK=sqrt(uR*uR+uX*uX))
+	i0=0.05 ; no load relative current of transformer
+	p0=0.005 ; relative power lost of the transformer (has to be smaller than i0 !!!!!!)
+   a=0.75 ; first parameter for the nonlinear magnetizing shape for the iron core
+   m=9    ; second parameter: Formula is:  I=IN*(a*psi/psiN+(1-a)*(psi/PsiN)^m)
+   psi_0=0 ; 0,1,-1 means no remanent flux, pos. remanent flux, neg. remanent flux with default per phase flux multiplicator of (psir,psis,psit)
+   psir=1
+   psis=-0.5
+   psit=-0.5
+   tpsi0=1000s ;  if psi_0<>0 tpsi0 should give the timepoint of adding the remanent flux
+   tpsid=0.1ms ; The time during the voltage source for generating the remanent flux is active
+   ron=0.00001 ; The resistance of the switch for the remanent flux capacitor is set so that the flux is at tpsid
+   bf=0    ; If set 1 the shorter iron ways for the inner limb is considererd (1.2,0.6,1.2) -> See also the  3leg/7limbs model                                   
+   rkessel=2e6 ; magn. resistance of the tank filled with oil (high value=not considered, but should be changed if available !!!!!!)
+   fact=0.8        ; Calibration factor for magnetizing current Imy
+   fact2={1.0/1.0} ; Calibrataion factor for iron lost rfe
+   ibf=0 ; inverse construction factor when set to 1 -> no assymetric magnetizing current (see also bf=1 for 3leg transformer)
Xu	1U	1N	2N	2U	3W  3U magn_a1U magn_b1U	Trafoschenkel3_Yy; SCHENKEL_Yy U
+ PARAMS: SN={SN/3} U1N={U1Nenn/sqrt(3)} U20={U20/sqrt(3)} U30={U30} fN={fN} N1={N1} uR={uR} uX={uX} 
+ i0={i0*IF(ibf==0,1,0.73)}
+ p0={p0*IF(ibf==0,1,0.73)}
+ a={a}
+ m={m}
+ psi_0={psir*psi_0}
+ tpsi0={tpsi0}
+ tpsid={tpsid}
+ ron={ron}
+ calib_rfe={7/3*fact2}
+ calib_imy={3/7*fact}
Xv	1V	1N	2N	2V	3U  3V magn1 magn2	Trafoschenkel3_Yy; SCHENKEL_Yy V
+ PARAMS: SN={SN/3} U1N={U1Nenn/sqrt(3)} U20={U20/sqrt(3)} U30={U30} fN={fN} N1={N1} uR={uR} uX={uX} 
+ i0={i0*IF(ibf==0,1,2.3)}
+ p0={p0*IF(ibf==0,1,2.3)}
+ a={a}
+ m={m}
+ psi_0={psis*psi_0}
+ tpsi0={tpsi0}
+ tpsid={tpsid}
+ ron={ron}
+ calib_rfe={7/3*fact2}
+ calib_imy={3/7*fact}
Xw	1W	1N	2N	2W	3V  3W magn_a1W magn_b1W	Trafoschenkel3_Yy; SCHENKEL_Yy W
+ PARAMS: SN={SN/3} U1N={U1Nenn/sqrt(3)} U20={U20/sqrt(3)} U30={U30} fN={fN} N1={N1} uR={uR} uX={uX} 
+ i0={i0*IF(ibf==0,1,0.73)}
+ p0={p0*IF(ibf==0,1,0.73)}
+ a={a}
+ m={m}
+ psi_0={psit*psi_0}
+ tpsi0={tpsi0}
+ tpsid={tpsid}
+ ron={ron}
+ calib_rfe={7/3*fact2}
+ calib_imy={3/7*fact}
****************************
RU0 3U 0 1e9
RV0 3V 0 1e9 ; to get symettrical zeropoint working
RW0 3W 0 1e9
****************************
XSch_ol magn_b1U magn2 Trafoschenkel_Yy ; ohne WICKLUNG_Yy ! Joch oben links
+ PARAMS: SN={SN/3} U1N={U1Nenn/sqrt(3)} fN={fN} N1={N1} i0={i0} p0={p0}
+ a={a}
+ m={m}
+ calib_rfe={7/3*fact2}
+ calib_imy={3/7*fact}
XSch_or magn2 magn_b1W Trafoschenkel_Yy ; ohne WICKLUNG_Yy ! Joch oben rechts
+ PARAMS: SN={SN/3} U1N={U1Nenn/sqrt(3)} fN={fN} N1={N1} i0={i0} p0={p0}
+ a={a}
+ m={m}
+ calib_rfe={7/3*fact2}
+ calib_imy={3/7*fact}
XSch_ul magn_a1U magn1 Trafoschenkel_Yy ; ohne WICKLUNG_Yy ! Joch unten links
+ PARAMS: SN={SN/3} U1N={U1Nenn/sqrt(3)} fN={fN} N1={N1} i0={i0} p0={p0}
+ a={a}
+ m={m}
+ calib_rfe={7/3*fact2}
+ calib_imy={3/7*fact}
XSch_ur magn1 magn_a1W Trafoschenkel_Yy ; ohne WICKLUNG_Yy ! Joch unten rechts
+ PARAMS: SN={SN/3} U1N={U1Nenn/sqrt(3)} fN={fN} N1={N1} i0={i0} p0={p0}
+ a={a}
+ m={m}
+ calib_rfe={7/3*fact2}
+ calib_imy={3/7*fact}
;
Rm	magn1	0	1MEG
Rkessel magn1 magn2 {rkessel}
;
RGND1U 1U 0 1e12
RGND1V 1V 0 1e12
RGND1W 1W 0 1e12
RGND2U 2U 0 1e12
RGND2V 2V 0 1e12
RGND2W 2W 0 1e12
RGND1N 1N 0 1e12
RGND2N 2N 0 1e12
.ENDS

