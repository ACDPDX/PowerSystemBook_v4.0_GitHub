+ calib_imy={1/3*fact}
XSch_ul magn_c1U magn1 Trafoschenkel_Yy; unten links
+ PARAMS: SN={SN/3} U1N={U1Nenn/sqrt(3)} fN={fN} N1={N1} i0={i0} p0={p0}
+ a={a}
+ m={m}
+ calib_rfe={3*fact2}
+ calib_imy={1/3*fact}
XSch_ur magn1 magn_c1W Trafoschenkel_Yy; unten rechts
+ PARAMS: SN={SN/3} U1N={U1Nenn/sqrt(3)} fN={fN} N1={N1} i0={i0} p0={p0}
+ a={a}
+ m={m}
+ calib_rfe={3*fact2}
+ calib_imy={1/3*fact}
;
