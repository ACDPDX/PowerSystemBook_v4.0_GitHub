********************************************
* Trafoschenkel_Yy mit 3 Wicklungen
* ( z.B zickzack oder Ausgleichswicklung )
********************************************
.SUBCKT   Trafoschenkel3_Yy  1_1 1_2  2_1 2_2  3_1 3_2 magnP1 magnP2
+	PARAMS:
+	SN=100kVA
+	U1N=5773V
+	U20=133.3V
+	U30=133.3V
+	fn={fn1}
+	N1=1000
+	uR=0.02
+	uX=0.04
+	i0=0.025
+	p0=0.003
+   a={0.3} ; FS
+   m={7} ; FS
+   psi_0=0 ; Remanenzparameter zwischen 0,1,-1
+   tpsi0=40ms
+   tpsid=0.1ms
+   ron=0.00001
+   calib_rfe=1 ;Kalibrierungsfactor für Aufteilung auf mehrere SCHENKEL_Yy
+   calib_imy=1 ;Kalibrierungsfactor für Aufteilung auf mehrere SCHENKEL_Yy
.PARAM
+	I1N={SN/U1N}
+	Z1N={U1N/I1N}
+   I3N={SN/U30} ; third winding normaly constructed ~1/3 SN but SN star/delta = 3x therefore SN/3*3
+   Z3N={U30/I3N}
+	omegaN={(2*pi)*fN}
+	R1={Z1N*uR/2}
+	L1s={Z1N*uX/2/omegaN}
+	RFe={U1N*U1N/(p0*SN)}
+	N2={N1*U20/U1N}
+	N3={N1*U30/U1N}
+	R2={R1*N2/N1*N2/N1}
+   R3={Z3N*ur}
+   L3s={Z3N*ux/omegaN}
;+	R3={R1*N3/N1*N3/N1}
+   Xh={(U1N*U1N)/(SN*sqrt(i0*i0-p0*p0))} ;FS
+   iu={U1N/Xh} ;FS
+   ImyN={sqrt(2)*iu} ;FS
+	phiN={sqrt(2)*U1N/omegaN/N1}
*	Wicklungsstroeme
Gi1	1_1	1_2	VALUE={v(a,magnP1)/N1} tripdv={tdv} tripdt={tdt}
Rpi1	1_1	1_2	1000MEG
Gi2	2_1	2_2	VALUE={v(b,a)/N2} tripdv={tdv} tripdt={tdt}
Rpi2	2_1	2_2	1000MEG
Gi3	3_1	3_2	VALUE={v(c,b)/N3} tripdv={tdv} tripdt={tdt}
Rpi3	3_1	3_2	1000MEG
*	Wicklungen
X_W1	magnP1	a	1_1	1_2	WICKLUNG_Yy
+PARAMS:  R={R1}  N={N1}  Rphis={N1*N1/L1s} psi_0={psi_0*phiN} tpsi0={tpsi0} tpsid={tpsid} ron={ron}
X_W2	a   b    2_1	2_2	WICKLUNG_Yy
+PARAMS:  R={R2}  N={N2}  Rphis={N1*N1/L1s} psi_0={psi_0*phiN} tpsi0={tpsi0} tpsid={tpsid} ron={ron}
X_W3	b   c    3_1	3_2	WICKLUNG_Yy
+PARAMS:  R={R3}  N={N3}  Rphis={N3*N3/L3s} psi_0={psi_0*phiN} tpsi0={tpsi0} tpsid={tpsid} ron={ron}
*	EisenSchenkel
X_SCH	c	magnP2	SCHENKEL_Yy   PARAMS:
+	N={N1}  RFe={RFe*calib_rfe}  ImyN={ImyN*calib_imy}
+	phiN={phiN}	a={a}   m={m}
.ENDS
*$
***	Ende des SUBCIRCUITS Trafoschenkel3_Yy

