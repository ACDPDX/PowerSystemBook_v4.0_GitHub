+   calib_imy_a=1
.PARAM
+	I1N={SN/U1N}
+	Z1N={U1N/I1N}
+	omegaN={(2*pi)*fN}
+	RFe={U1N*U1N/(p0*SN)}
+   Xh={(U1N*U1N)/(SN*sqrt(i0*i0-p0*p0))} ;FS
+   iu={U1N/Xh} ;FS
+   ImyN={sqrt(2)*iu} ;FS
+	phiN={sqrt(2)*U1N/omegaN/N1}
+   a={a} ; FS
+   m={m} ; FS
*	EisenSchenkel
X_SCH	magnP1	magnP2	SCHENKEL_Yy_1   PARAMS:
+	N={N1}  RFe={RFe*calib_rfe} imyN={imyN} calib_a={calib_imy_a} calib_l={calib_imy_l} phiN={phiN}	a={a}   m={m}
.ENDS

*$


* 15a  WICKLUNG_Yy ; Rp von 1Meg->1000Meg geändert
*
.SUBCKT WICKLUNG_Yy  ma  mb  ea  eb
+PARAMS:   R=1   N=1    Rphis=1 psi_0=0 tpsi0=1000s tpsid=0.1ms ron=0.00001 ctrl=1
Gphi	ma	mb	VALUE={v(phi)} tripdv={tdv} tripdt={tdt} 
Rphis	ma	mb	{Rphis*ctrl*ctrl}
*****************************************************************************
Gp	0	phi	VALUE={(v(ea,eb)-R*ctrl*v(mb,ma)/(N*ctrl))/(N*ctrl)} tripdv={tdv} tripdt={tdt}
Cp  phi 0 1 IC=0 
Rp	phi 0	1000MEG
Vctrl ctrl 0 pwl 0s 0v {tpsi0+1p} 0v {tpsi0+tpsid+2p} 1V {tpsi0+2*tpsid+3p} 1v {tpsi0+3*tpsid+4p} 0v
S1 phi phix ctrl 0 MS1
.model MS1 SW(Ron={Ron} Roff=1e9 Vt=0.9 Vh=0 Lser=0 Vser=0)
E1 phix 0 value={psi_0} tripdv={tdv} tripdt={tdt} ; das ist die Spannungsquelle mit psi_0 der den Kondensator Cp auflädt !!!
.ENDS ;  WICKLUNG_Yy
*$

* 15b  Eisenschenkel
*
*
.SUBCKT SCHENKEL_Yy_1  m1  m2
+PARAMS:   N=1  RFe=1  ImyN={ImyN} calib_a=1 calib_L=1 a=1  phiN=1 m=9 ctrl=1
LRFe	m1	mh	{N*ctrl*N*ctrl/RFe} Rser={0.001m*N*N/RFe}  ; Rser=parasitic Value zur besseren Konvergenz
vphi	mh	mh1	0
rphi    mh  0 1e12 
Eimy	mh1	m2
+VALUE={N*imyN*calib_l*(a*(i(vphi)*calib_A)/phiN+(1-a)*PWRS((i(vphi)*calib_A)/phiN,m))} tripdv={tdv} tripdt={tdt}
.ENDS;  SCHENKEL_Yy

.SUBCKT SCHENKEL_Yy_1_table  m1  m2
+PARAMS:   N=1  RFe=1  ImyN={ImyN} calib_a=1 calib_L=1 a=1  phiN=1 m=9 ctrl=1
LRFe	m1	mh	{N*ctrl*N*ctrl/RFe} Rser={0.001m*N*N/RFe}  ; Rser=parasitic Value zur besseren Konvergenz
vphi	mh	mh1	0
rphi    mh  0 1e12
Etable imue 0 VALUE={table(i(vphi),-0.858,-891,-0.571,-52.48,-0.429,-7.22,-0.286,-0.580,-0.200,-0.1560,-0.143,-0.090,0,0,0.143,0.09,0.200,0.156,0.286,0.58,0.429,7.22,0.571,52.48,0.858,891)}  tripdv={tdv} tripdt={tdt}
Eimy	mh1	m2 VALUE={N*v(imue)} tripdv={tdv} tripdt={tdt}
.ENDS;  SCHENKEL_Yy

.SUBCKT SCHENKEL_Yy  m1  m2
+PARAMS:   N=1  RFe=1  ImyN=1  a=1  phiN=1 m=9 ctrl=1
LRFe	m1	mh	{N*ctrl*N*ctrl/RFe} Rser={0.001m*N*N/RFe}  ; Rser=parasitic Value zur besseren Konvergenz
vphi	mh	mh1	0
rphi    mh  0 1e12 
Eimy	mh1	m2
+VALUE={N*imyN*(a*i(vphi)/phiN+(1-a)*PWRS(i(vphi)/phiN,m))} tripdv={tdv} tripdt={tdt}
.ENDS;  SCHENKEL_Yy

* ideal transformer 1 phase with coupling factor k
.subckt N1N2_Yy in1 in2 out1 out2
+params: N1=1 N2=1 k=1
.param ue={N1/N2}
G1 0 M in1 in2 1
G2 0 M out1 out2 {-1/k*ue}
G3 in1 in2 M 0 1
G4 out1 out2 M 0 {-1/k*ue}
R2 M 0 1e12
Rin1 in1 0 1e12
Rin2 in2 0 1e12
Rout1 out1 0 1e12
Rout2 out2 0 1e12
.ends
*$

* another ideal transformer 1 phase
* I2=I1*ue V1=V2*ue 
* there is no coupling factor in this element
* coupling factor is implemented in N1N2_Yy with four g-sources
.subckt N1N2_2_Yy in1 in2 out1 out2
+params: N1=1 N2=1
.param ue={N1/N2} ; N={1/ue}
B1 out2 out1 I=I(V1r)*ue   tripdv={tdv} tripdt={tdt}
B2 in1x in2 V=v(out1,out2)*ue  tripdv={tdv} tripdt={tdt}
V1r in1 in1x 0 Rser=1u
Rin1 in1 0 1e12
Rin2 in2 0 1e12
Rout1 out1 0 1e12
Rout2 out2 0 1e12
.ends
*$

* ctrl node in verhältniseinheit
* UE/UEN=1+stproz/100 (0.9 .. 1 .. 1.2)
.subckt N1N2_ctrl_Yy in1 in2 out1 out2 
+params: k=1 N1=1 N2=1 ctrl=1
.param ue={N1/N2}
G1 0 M in1 in2 1
G2 0 M VALUE={-k*((v(out1)-v(out2))*ue*ctrl)} tripdv={tdv} tripdt={tdt}
G3 in1 in2 M 0 1
G4 out1 out2 VALUE={-k*((v(m))*ue*ctrl)} tripdv={tdv} tripdt={tdt}
R2 M 0 1e10
Rin1 in1 0 1e12
Rin2 in2 0 1e12
Rout1 out1 0 1e12
Rout2 out2 0 1e12
.ends
*$

.SUBCKT   R3  L1_1 L1_2
+	PARAMS:
+	R=0.5	;
+ length=1
+ g=1e12
RL1 L1_1 L1_2 {R*length}
Rgnd1 L1_1 0 {g}
Rgnd2 L1_2 0 {g}
.ENDS
*$

.SUBCKT   L3  L1_1 L1_2
+	PARAMS:
+	L=1	;
+   fn={fn1}
+   xl=0
+ length=1
+ rser=0
+ IC=0
+ g=1e12
.PARAM
+   L1=IF(xl>0,xl/fn/2/pi,L)
LL1 L1_1 L1_2 {L1*length} rser={rser} IC={IC}
Rgnd1 L1_1 0 {g}
Rgnd2 L1_2 0 {g}
.ENDS
*$

.SUBCKT   C3  L1_1 L1_2
+	PARAMS:
+	C=0.5	;
+   fn={fn1}
+   XC=0
+ length=1
+ IC=0
+ rser=0
+ g=1e12
.PARAM
+   C1=IF(xc>0,1/(xc+1p)/fn/2/pi,C)
CL1 L1_1 L1_2 {C1*length} rser={rser} IC={IC}
Rgnd1 L1_1 0 {g}
Rgnd2 L1_2 0 {g}
.ENDS