+	fn={fn1}
+	N1=1000
+	uR=0.002
+	uX=0.2
+	i0=0.0006
+	p0=0.0004
+   a=0.75 ; FS
+   m=9 ; FS
+   psi_0=0 ; remanence between 0 und 1 (L1=1 L2=-0.5 L3=-0.5)
+   psir=1
+   psis=-0.5
+   psit=-0.5
+   tpsi0=1000s ; Remanenzzeitpunkt
+   tpsid=0.1ms  ; Dauer des Schalter ein für Remanenz
+   ron=0.00001 ; ron - Parameter des Schalters für Remanenz (siehe sub WICKLUNG_Yy)
+   rkessel=6e5 ;Kesselwiderstand wirksam bei starker Unsymmetrie und hohem Flußwerten
+   fact=0.39 ; calibration factor leg/limb for length of leg/limb
+   fact2=2.8 ; calibration factor for rfe (iron lost)
+   fact3=0.983 ; calibration factor leg/limb for area of leg/limb 
+   daw=1     ; Dreieckausgleichswicklung 3U,3V,3W über R1,R2,R3 im Kreis verbunden
+   daw_r=0  ; Für Kompatibilität mit Hosemann model 
+   daw_rphis=6e6 
Xu	1U	1N	2N	2U	3W  3U magn_c1U magn_b1U	Trafoschenkel3_Yy_1
+ PARAMS: SN={SN/3} U1N={U1Nenn/sqrt(3)} U20={U20/sqrt(3)} U30={U30} fN={fN} N1={N1} uR={uR} uX={uX} i0={i0} p0={p0}
+ a={a}
+ m={m}
+ psi_0={psir*psi_0}
+ tpsi0={tpsi0}
+ tpsid={tpsid}
+ ron={ron}
+ calib_rfe={1*fact2}   ; KFE*fact2
+ calib_imy_a={1*fact3} ; KA*fact3
+ calib_imy_l={1*fact}  ; KL*fact
+ daw={daw}     ; Dreieckausgleichswicklung
+ daw_r={daw_r}  ;
+ daw_rphis={daw_rphis} ;
Xv	1V	1N	2N	2V	3U  3V magn1 magn2	Trafoschenkel3_Yy_1
+ PARAMS: SN={SN/3} U1N={U1Nenn/sqrt(3)} U20={U20/sqrt(3)} U30={U30} fN={fN} N1={N1} uR={uR} uX={uX} i0={i0} p0={p0}
+ a={a}
+ m={m}
+ psi_0={psis*psi_0}
+ tpsi0={tpsi0}
+ tpsid={tpsid}
+ ron={ron}
+ calib_rfe={1*fact2}   ; KFE*fact2
+ calib_imy_a={1*fact3} ; KA*fact3
+ calib_imy_l={1*fact}  ; KL*fact
+ daw={daw}     ; Dreieckausgleichswicklung
+ daw_r={daw_r}  ;
+ daw_rphis={daw_rphis} ;
Xw	1W	1N	2N	2W	3V  3W magn_c1W magn_b1W	Trafoschenkel3_Yy_1
+ PARAMS: SN={SN/3} U1N={U1Nenn/sqrt(3)} U20={U20/sqrt(3)} U30={U30} fN={fN} N1={N1} uR={uR} uX={uX} i0={i0} p0={p0}
+ a={a}
+ m={m}
+ psi_0={psit*psi_0}
+ tpsi0={tpsi0}
+ tpsid={tpsid}
+ ron={ron}
+ calib_rfe={1*fact2}   ; KFE*fact2
+ calib_imy_a={1*fact3} ; KA*fact3
+ calib_imy_l={1*fact}  ; KL*fact
+ daw={daw}     ; Dreieckausgleichswicklung
+ daw_r={daw_r}  ;
+ daw_rphis={daw_rphis} ;
****************************
RU0 3U 0 1e9
RV0 3V 0 1e9 ; to get symettrical zeropoint working
RW0 3W 0 1e9
****************************
XSch_l magn_b1U magn_b1U1 Trafoschenkel_Yy_1; li-aussen
+ PARAMS: SN={SN/3} U1N={U1Nenn/sqrt(3)} fN={fN} N1={N1} i0={i0} p0={p0}
+ a={a}
+ m={m}
+ calib_rfe={0.25*fact2}
+ calib_imy_a={2*fact3}
+ calib_imy_l={2*fact}
XSch_r magn_b1W magn_b1W1 Trafoschenkel_Yy_1; re-aussen
+ PARAMS: SN={SN/3} U1N={U1Nenn/sqrt(3)} fN={fN} N1={N1} i0={i0} p0={p0}
+ a={a}
+ m={m}
+ calib_rfe={0.25*fact2}
+ calib_imy_a={2*fact3}
+ calib_imy_l={2*fact}
XSch_ol magn_b1U magn2 Trafoschenkel_Yy_1; oben links
+ PARAMS: SN={SN/3} U1N={U1Nenn/sqrt(3)} fN={fN} N1={N1} i0={i0} p0={p0}
+ a={a}
+ m={m}
+ calib_rfe={0.5*fact2}
+ calib_imy_a={2*fact3}
+ calib_imy_l={1*fact}
XSch_or magn2 magn_b1W Trafoschenkel_Yy_1; oben rechts
+ PARAMS: SN={SN/3} U1N={U1Nenn/sqrt(3)} fN={fN} N1={N1} i0={i0} p0={p0}
+ a={a}
+ m={m}
+ calib_rfe={0.5*fact2}
+ calib_imy_a={2*fact3}
+ calib_imy_l={1*fact}
XSch_ul magn_c1U magn1 Trafoschenkel_Yy_1; unten links
+ PARAMS: SN={SN/3} U1N={U1Nenn/sqrt(3)} fN={fN} N1={N1} i0={i0} p0={p0}
+ a={a}
+ m={m}
+ calib_rfe={0.5*fact2}
+ calib_imy_a={2*fact3}
+ calib_imy_l={1*fact}
XSch_ur magn1 magn_c1W Trafoschenkel_Yy_1; unten rechts
+ PARAMS: SN={SN/3} U1N={U1Nenn/sqrt(3)} fN={fN} N1={N1} i0={i0} p0={p0}
+ a={a}
+ m={m}
+ calib_rfe={0.5*fact2}
+ calib_imy_a={2*fact3}
+ calib_imy_l={1*fact}
;
Rm	magn1	0	1MEG
Rkessel magn1 magn2 {rkessel}
Rl  magn_b1U1 magn_c1U  1u
Rr  magn_b1W1 magn_c1W  1u
;
RGND1U 1U 0 1e12
RGND1V 1V 0 1e12
RGND1W 1W 0 1e12
RGND2U 2U 0 1e12
RGND2V 2V 0 1e12
RGND2W 2W 0 1e12
RGND1N 1N 0 1e12
RGND2N 2N 0 1e12
.ENDS

