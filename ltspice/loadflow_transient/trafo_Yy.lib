+ a={a}
+ m={m}
+ psi_0={psit*psi_0}
+ tpsi0={tpsi0}
+ tpsid={tpsid}
+ ron={ron}
+ calib_rfe={6*fact2}
+ calib_imy={1/6*fact}
*** DAW - KreisVerbinder ***
R1 3V1 3U2 0.1
R2 3W1 3V2 0.1
R3 3U1 3W2 0.1
Rgnd 3w2 0 1e10
****************************
XSch_l magn_b1U magn_b1U1 Trafoschenkel_Yy; li-aussen
+ PARAMS: SN={SN/3} U1N={U1Nenn/sqrt(3)} fN={fN} N1={N1} i0={i0} p0={p0}
+ a={a}
+ m={m}
