+	phiN={phiN}	a={a}   m={m}
.ENDS

.SUBCKT   Trafoschenkel2_Yy_auto  P1 N P2 N  magnP1 magnP2
+	PARAMS:
+	SN=10kVA
+	UN=400V
+	Uvar=400V
+	fn={fn1}
+	N1=1000
+	uR=0.04
+	uX=0.08
+	i0=0.05
+	p0=0.005
+   a=0.3 ; FS
+   m=7 ; FS
+   psi_0=0 ; Remanenzparameter zwischen 0,1,-1
+   tpsi0=40ms
+   tpsid=0.1ms
+   ron=0.00001
+   calib_rfe=1 ; Kalibrierungsfactor für Aufteilung auf mehrere SCHENKEL_Yy
+   calib_imy=1 ; Kalibrierungsfactor für Aufteilung auf mehrere SCHENKEL_Yy
+   ctrl=1
.PARAM
+   uex={UN/Uvar}
+   U20={UN/(uex-1+1p)}
+	I1N={SN/UN}
+	Z1N={UN/I1N}
+	omegaN={(2*pi)*fN}
+	R={Z1N*ur}
+	Ls={Z1N*ux/omegan}
+	RFe={UN*UN/(p0*SN)}
;+	N2={N1*U20/UN}
+   Xh={(UN*UN)/(SN*sqrt(i0*i0-p0*p0))} ;FS
+   iu={UN/Xh} ;FS
+   ImyN={sqrt(2)*iu} ;FS
+	phiN={sqrt(2)*UN/omegaN/N1}
+   ue1={1+UN/U20}
+   ue={UN/U20}
+   uea={ue/ue1}
+   ueb={ue*ue/(ue*ue+1)}
+   L1s={Ls*ueb}
+   L2s={Ls*(1-ueb)}
+   R1={R*uea}
+   R2={R*(1-uea)}
+   N1a={2*N1*uea}
+   N2={2*N1-N1a}
*	Wicklungsstroeme
Gi1	p1	p2	VALUE={v(a)/N1a} tripdv={tdv} tripdt={tdt}
Rpi1	p1	p2	1000MEG
Gi2	p2	N	VALUE={v(b,a)/N2} tripdv={tdv} tripdt={tdt}
Rpi2	p2	N	1000MEG
*	Wicklungen
X_W1	magnP1	a	p1	p2	WICKLUNG_Yy
+PARAMS:  R={R1}  N={N1a}  Rphis={N1a*N1a/L1s} psi_0={psi_0*phiN} tpsi0={tpsi0} tpsid={tpsid} ron={ron} ctrl={ctrl}
X_W2	a   b    p2	N	WICKLUNG_Yy
+PARAMS:  R={R2}  N={N2}  Rphis={N2*N2/L2s} psi_0={psi_0*phiN} tpsi0={tpsi0} tpsid={tpsid} ron={ron} ctrl=1
*	EisenSchenkel
X_SCH	b	magnP2	SCHENKEL_Yy   PARAMS:
+	N={2*N1}  RFe={RFe*calib_rfe}  ImyN={ImyN*calib_imy}  ctrl={ctrl}
+	phiN={phiN}	a={a}   m={m}
.ENDS

