+   psir=1
+   psis=-0.5
+   psit=-0.5
+   tpsi0=1000s ; Time of adding remanent flux
+   tpsid=0.1ms  ; Duration of switcher on time
+   ron=0.00001 ; ron - Parameter of the switcher for remanent flux (siehe sub WICKLUNG_Yy)
+   rkessel=6e5   ; cettel resistance at asymetric load and high flux values
+   fact=0.8       ; calibration factor for Imy
+   fact2={1.0/1.0} ; calibration factor for Rfe
+   ibf=0 ; inverse construction factor when set to 1 -> no assymetric magnetizing current (see also bf=1 for 3leg transformer)
Xu	1U	1N	2U	2N	magn_a1U magn_b1U	Trafoschenkel2_Yy
+ PARAMS: SN={SN/3} U1N={U1Nenn/sqrt(3)} U20={U20/sqrt(3)} fN={fN} N1={N1} uR={uR} uX={uX} 
+ i0={i0*IF(ibf==0,1,0.73)}
+ p0={p0*IF(ibf==0,1,0.73)}
+ a={a}
+ m={m}
+ psi_0={psir*psi_0}
+ tpsi0={tpsi0}
+ tpsid={tpsid}
+ ron={ron}
+ calib_rfe={7/3*fact2}
+ calib_imy={3/7*fact}
