+	PARAMS:
+	SN=1kVA
+	U1N=230V
+	U20=230V
+	fn={fn1}
+	N1=1000
+	uR=0.04
+	uX=0.08
+	i0=0.05
+	p0=0.005
+   ctrl=1
.PARAM
+	I1N={SN/U1N}
+	Z1N={U1N/I1N}
+	omegaN={(2*pi)*fN}
+	R1={Z1N*uR/2}
+	L1s={Z1N*uX/2/omegaN}
+	RFe={U1N*U1N/(p0*SN)}
+	N2={N1*U20/U1N}
+	R2={R1*N2/N1*N2/N1}
+   Xh={(U1N*U1N)/(SN*sqrt(i0*i0-p0*p0))} ;FS
+   iu={U1N/Xh} ;FS
+   ImyN={sqrt(2)*iu} ;FS
+	phiN={sqrt(2)*U1N/omegaN/N1}
Rcup  p1 x1 {R1}
L1p    x1 p11 {L1s} rser=0
Rfe1   p11 p2 {RFe}
*LXh    p11 p2 {Xh/omegaN} rser=0
LXh p11 p2 flux=Xh/omegaN*x*ctrl*ctrl rser=0
Rcus   s33  x2 {R2}
L1s   x2 s3 {L1s*N2/N1*N2/N1} rser=0
X_w1	p11 p2  s33  s4  N1N2_ctrl_Yy params: N1={N1} N2={N2} ctrl={ctrl}
.ends

