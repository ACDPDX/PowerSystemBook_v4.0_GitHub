* Auto(Spar)transformer
.SUBCKT RUY0aN_400k_120k_300MVA_stacked_a  1U  1V  1W  1N  2U  2V  2W  2N
+	PARAMS:
+	SN=300e6
+	U1Nenn=400e3
+	U20=120e3
+	fn={fn1}
+	N1=1000
+	uR=0.002
+	uX=0.2
+	i0=0.0006
+	p0=0.0004
+   a=0.75 ; FS
+   m=9 ; FS
+   psi_0=0 ; Remanenzparameter 0,1,-1
+   psir=1
+   psis=-0.5
+   psit=-0.5
+   tpsi0=1000s ; Remanenzzeitpunkt
+   tpsid=0.1ms  ; Dauer des Schalter ein für Remanenz
+   ron=0.00001 ; ron - Parameter des Schalters für Remanenz (siehe sub WICKLUNG_Yy)
+   bf=0    ; bf=1 -> Korrektur Mittlerer SCHENKEL_Yy kürzere Eisenwege
+   rkessel=6e5 ;Kesselwiderstand wirksam bei starker Unsymmetrie und hohen Flußwerten
+   l_=0
+   middle=0
+   stproz=1.0
+   ctrl={1+(l_-middle)*stproz/100}
Xu	1U	1N	2U	2N	magn1	magn2	Trafoschenkel2_Yy_stacked_a
+ PARAMS:
+ SN={SN/3}
+ U1N={U1Nenn/sqrt(3)}
+ U20={U20/sqrt(3)}
+ fN={fN}
+ N1={N1}
+ uR={uR}
+ uX={uX}
+ i0={i0*IF(bf==0,1,1.2)}
+ p0={p0*IF(bf==0,1,1.2)}
+ a={a}
+ m={m}
+ psi_0={psir*psi_0}
+ tpsi0={tpsi0}
+ tpsid={tpsid}
+ ron={ron}
+ ctrl={ctrl}
Xv	1V	1N	2V	2N	magn1	magn2	Trafoschenkel2_Yy_stacked_a
