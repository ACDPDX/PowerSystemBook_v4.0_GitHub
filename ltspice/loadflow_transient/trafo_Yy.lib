+ calib_rfe={7/3*fact2}
+ calib_imy={3/7*fact}
Xw	1W	1N	2W	2N	magn_a1W magn_b1W	Trafoschenkel2_Yy
+ PARAMS: SN={SN/3} U1N={U1Nenn/sqrt(3)} U20={U20/sqrt(3)} fN={fN} N1={N1} uR={uR} uX={uX} 
+ i0={i0*IF(ibf==0,1,0.73)}
+ p0={p0*IF(ibf==0,1,0.73)}
+ a={a}
+ m={m}
+ psi_0={psit*psi_0}
+ tpsi0={tpsi0}
+ tpsid={tpsid}
+ ron={ron}
+ calib_rfe={7/3*fact2}
+ calib_imy={3/7*fact}
XSch_ol magn_b1U magn2 Trafoschenkel_Yy ; ohne WICKLUNG_Yy !
+ PARAMS: SN={SN/3} U1N={U1Nenn/sqrt(3)} fN={fN} N1={N1} i0={i0} p0={p0}
+ a={a}
+ m={m}
+ calib_rfe={7/3*fact2}
+ calib_imy={3/7*fact}
XSch_or magn2 magn_b1W Trafoschenkel_Yy ; ohne WICKLUNG_Yy !
+ PARAMS: SN={SN/3} U1N={U1Nenn/sqrt(3)} fN={fN} N1={N1} i0={i0} p0={p0}
+ a={a}
+ m={m}
+ calib_rfe={7/3*fact2}
+ calib_imy={3/7*fact}
XSch_ul magn_a1U magn1 Trafoschenkel_Yy ; ohne WICKLUNG_Yy !
+ PARAMS: SN={SN/3} U1N={U1Nenn/sqrt(3)} fN={fN} N1={N1} i0={i0} p0={p0}
