+   Xh={(U1N*U1N)/(SN*sqrt(i0*i0-p0*p0))} ;FS
+   iu={U1N/Xh} ;FS
+   ImyN={sqrt(2)*iu} ;FS
+	phiN={sqrt(2)*U1N/omegaN/N1}
+   a={a} ; FS
+   m={m} ; FS
*	EisenSchenkel
X_SCH	magnP1	magnP2	SCHENKEL_Yy   PARAMS:
+	N={N1}  RFe={RFe*calib_rfe}  ImyN={ImyN*calib_imy} phiN={phiN}	a={a}   m={m}
