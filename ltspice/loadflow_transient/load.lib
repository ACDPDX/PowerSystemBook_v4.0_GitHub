Elim ua 0 VALUE={Limit(v(ua1),Ulo*VN,Uhi*VN)} tripdv={tdv} tripdt={tdt}
* Measurement  END
*
* CONST R
* IR = U/R   R=R*(ua^2/VN^2)
GRL1 L1 L2 VALUE={v(ctrl)*v(L1,L2)/(R*v(ua)*v(ua)/VN2)} tripdv={tdv} tripdt={tdt} rpar=1e12
GRL2 L2 L3 VALUE={v(ctrl)*v(L2,L3)/(R*v(ua)*v(ua)/VN2)} tripdv={tdv} tripdt={tdt} rpar=1e12
GRL3 L3 L1 VALUE={v(ctrl)*v(L3,L1)/(R*v(ua)*v(ua)/VN2)} tripdv={tdv} tripdt={tdt} rpar=1e12
.ENDS

