.PARAM
+ omega={2*pi*fn}
+ V={VN/sqrt(3)}
+   PN10=IF(P<=0,PQ0,P) 
+   QN10=IF(Q>=0,PQ0,Q) 
+	R={V*V/PN10}                         
+	C={IF(Q>=0,QN10/(V*V*omega),-QN10/(V*V*omega))}
RL1 L1 N {R}
CL1 L1 N {C} Rser={rser} 
RGND N 0 {g}
.ENDS

* 1 phase R impdeance with ctrl node
.SUBCKT   Load_1phase_R_ctrl  L1 N ctrl
+	PARAMS:
+ VN=400;
+   fn={fn1} PQ0=1000
+	P=1e6	;
+   g=1e10
.PARAM
+ omega={2*pi*fn}
+ V={VN/sqrt(3)}
+	R={IF(P>0,V*V/P,V*V/PQ0)}
Rctrl ctrl 0 1e12
GRL1 L1 N VALUE={v(ctrl)*v(L1,N)/R} tripdv={tdv} tripdt={tdt}
RGND N 0 {g}
.ENDS

* 1 phase RL serial impedance with ctrl node
.SUBCKT   Load_1phase_RL_ctrl  L1 N ctrl
+	PARAMS:
+ VN=400;
+   fn={fn1} PQ0=1000
+	P=1e6	;
+	Q=1e6 ;
+   rser=1u
+   g=1e10
.PARAM
+ omega={2*pi*fn}
+ V={VN/sqrt(3)}
+ P0=IF(P<=0,PQ0,P)
+ Q0=IF(Q<=0,PQ0,Q)
+ R={V*V*P0/(P0*P0+Q0*Q0)}
+ L={(V*V*Q0/(P0*P0+Q0*Q0))/omega}
Rctrl ctrl 0 1e12
GRL1 L1 L1a VALUE={v(ctrl)*v(L1,L1a)/R} tripdv={tdv} tripdt={tdt}
RL1 L1a L1b {rser}
GLL1 L1b N VALUE={v(ctrl)*v(idt1)/L} tripdv={tdv} tripdt={tdt}
G1x 0 idt1 VALUE={v(L1b,N)} tripdv=1 tripdt=1
C1x idt1 0 1
R1x idt1 0 1e10
RGND N 0 {g}
.ENDS


* 1 phase RC serial impedance with ctrl node
.SUBCKT   Load_1phase_RC_ctrl  L1 N ctrl
+	PARAMS:
