GLL3 L3b N VALUE={v(ctrl)*v(idt3)/(L*v(ua)*v(ua)/VN2)} tripdv={tdv} tripdt={tdt} rpar=1e12
G3x 0 idt3 VALUE={v(L3b,N)} tripdv=1 tripdt=1
C3x idt3 0 1
