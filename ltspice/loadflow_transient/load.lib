GRL2 L2 N VALUE={v(ctrl)*v(L2,N)/(R*v(ua)*v(ua)/VN2)} tripdv={tdv} tripdt={tdt}
GRL3 L3 N VALUE={v(ctrl)*v(L3,N)/(R*v(ua)*v(ua)/VN2)} tripdv={tdv} tripdt={tdt}
RGND N 0 {g}
.ENDS

