.PARAM
+ omega={2*pi*fn}
+ V={VN/sqrt(3)}
+   PN10=IF(P<=0,PQ0,P)
+   QN10=IF(Q<=0,PQ0,Q)
+	R={V*V/PN10}
+	L={(V*V/QN10)/omega}
RL1 L1 N {R}
LL1 L1 N {L} Rser={rser}
RGND N 0 {g}
.ENDS

* 1 phase RC with parallel impedance
.SUBCKT   Load_1phase_RC_p  L1 N
+	PARAMS:
