* 1 phase RL serial impedance S=const
.SUBCKT   Load_1phase_R_const  L1 N
+	PARAMS:
+ VN=400;
+ fn={fn1} PQ0=1000
+ P=1e6
+   Ulo=0.7
+   Uhi=1.3
+ rser=1u
+   g=1e10
+ fc=3 vfactor=sqrt(3)
.PARAM
+ omega={2*pi*fn}
+   V={VN/sqrt(3)}
+ P0=IF(P<=0,PQ0,P)
+ R={V*V*P0/(P0*P0)}
+ VN2={VN*VN}
Elim ua 0 VALUE={Limit(v(ua1),Ulo*VN,Uhi*VN)} tripdv={tdv} tripdt={tdt}
Xvmeter L1 ua1 vmeter2
+ params: fc={fc} vfactor={vfactor}
* CONST R
* IR = U/R   R=R*(ua/VN)
GRL1 L1 L1a VALUE={v(L1,L1a)/(R*v(ua)*v(ua)/VN2)} tripdv={tdv} tripdt={tdt}
RGND N 0 {g}
.ENDS

* 1 phase RL serial impedance S=const
.SUBCKT   Load_1phase_RL_const  L1 N
+	PARAMS:
+ VN=400;
+ fn={fn1} PQ0=1000
+ P=1e6
+ Q=1e6
+   Ulo=0.7
+   Uhi=1.3
+ rser=1u
+   g=1e10
+ fc=3 vfactor=sqrt(3)
.PARAM
+ omega={2*pi*fn}
+   V={VN/sqrt(3)}
+ P0=IF(P<=0,PQ0,P)
+ Q0=IF(Q<=0,PQ0,Q)
+ R={V*V*P0/(P0*P0+Q0*Q0)}
+ L={(V*V*Q0/(P0*P0+Q0*Q0))/omega}
+ VN2={VN*VN}
Elim ua 0 VALUE={Limit(v(ua1),Ulo*VN,Uhi*VN)} tripdv={tdv} tripdt={tdt}
Xvmeter L1 ua1 vmeter2
+ params: fc={fc} vfactor={vfactor}
* CONST R
* IR = U/R   R=R*(ua/VN)
GRL1 L1 L1a VALUE={v(L1,L1a)/(R*v(ua)*v(ua)/VN2)} tripdv={tdv} tripdt={tdt}
* CONST L
* IL = 1/L * Int(U) dt  L=L*(ua/VN)
RL1 L1a L1b {rser}
GLL1 L1b N VALUE={v(idt1)/(L*v(ua)*v(ua)/VN2)} tripdv={tdv} tripdt={tdt}
G1x 0 idt1 VALUE={v(L1b,N)} tripdv=1 tripdt=1
C1x idt1 0 1
R1x idt1 0 1e10
RGND N 0 {g}
.ENDS

* 1 phase RC serial impedance with S=const
.SUBCKT   Load_1phase_RC_const  L1 N
+	PARAMS:
+ VN=400;
+ fn={fn1} PQ0=1000
+ P=1e6
+ Q=1e6
+   Ulo=0.7
+   Uhi=1.3
+ rser=1u
+   g=1e10
+ fc=3 vfactor=sqrt(3)
.PARAM
+ omega={2*pi*fn}
+   V={VN/sqrt(3)}
+ PN10=IF(P<=0,PQ0,P) 
+ QN10=IF(Q>=0,PQ0,Q)  
+	R={V*V*PN10/(PN10*PN10+QN10*QN10)}
+	C={IF(Q>=0,(PN10*PN10+QN10*QN10)/(V*V*QN10*omega),-(PN10*PN10+QN10*QN10)/(V*V*QN10*omega))}
+ VN2={VN*VN}
Elim ua 0 VALUE={Limit(v(ua1),Ulo*VN,Uhi*VN)} tripdv={tdv} tripdt={tdt}
Xvmeter L1 ua1 vmeter2
+ params: fc={fc} vfactor={vfactor}
* CONST R
* IR = U/R   R=R*(ua/VN)
GRL1 L1 L1a VALUE={v(L1,L1a)/(R*v(ua)*v(ua)/VN2)} tripdv={tdv} tripdt={tdt}
* CONST C
RC1 L1a L1b {rser}
* IC = C*d(U)/dt  C=C*(VN/ua)
GCL1 L1b N VALUE={DDT(v(L1b,N))*C*VN2/(v(ua)*v(ua))} tripdv={tdv} tripdt={tdt}
RGND N 0 {g}
.ENDS

* 1 phase load RL parallel impedance S=const
.SUBCKT   Load_1phase_RL_const_p  L1 N
+	PARAMS:
+ VN=400;
+ fn={fn1} PQ0=1000
+ P=1e6
+ Q=1e6
+   Ulo=0.7
+   Uhi=1.3
+ rser=1u
+   g=1e10
+   fc=3 vfactor=sqrt(3)
.PARAM
+ omega={2*pi*fn}
+   V={VN/sqrt(3)}
+   PN10=IF(P<=0,PQ0,P)
+   QN10=IF(Q<=0,PQ0,Q)
+	R={V*V/PN10}
+	L={(V*V/QN10)/omega}
+   VN2={VN*VN}
Elim ua 0 VALUE={Limit(v(ua1),Ulo*VN,Uhi*VN)} tripdv={tdv} tripdt={tdt}
Xvmeter L1 ua1 vmeter2
+ params: fc={fc} vfactor={vfactor}
* CONST R
* IR = U/R   R=R*(ua^2/VN^2)
GRL1 L1 N VALUE={v(L1,N)/(R*v(ua)*v(ua)/VN2)} tripdv={tdv} tripdt={tdt}
* CONST L
* IL = 1/L * Int(U) dt  L=L*(ua^2/VN^2)
RL1 L1 L1a {rser}
GLL1 L1a N VALUE={v(idt1)/(L*v(ua)*v(ua)/VN2)} tripdv={tdv} tripdt={tdt}
G1x 0 idt1 VALUE={v(L1a,N)} tripdv=1 tripdt=1
C1x idt1 0 1
R1x idt1 0 1e10
RGND N 0 {g}
.ENDS

* 1 phase load RC parallel impedance S=const
.SUBCKT   Load_1phase_RC_const_p  L1 N
+	PARAMS:
+ VN=400;
+ fn={fn1} PQ0=1000
+ P=1e6
+ Q=1e6
+   Ulo=0.7
+   Uhi=1.3
+ rser=1u
+   g=1e10
+   fc=3 vfactor=sqrt(3)
.PARAM
+ omega={2*pi*fn}
+   V={VN/sqrt(3)}
+   PN10=IF(P<=0,PQ0,P) 
+   QN10=IF(Q>=0,PQ0,Q) 
+	R={V*V/PN10}                         
+	C={IF(Q>=0,QN10/(V*V*omega),-QN10/(V*V*omega))}
+   VN2={VN*VN}
Elim ua 0 VALUE={Limit(v(ua1),Ulo*VN,Uhi*VN)} tripdv={tdv} tripdt={tdt}
Xvmeter L1 ua1 vmeter2
+ params: fc={fc} vfactor={vfactor}
* CONST R
* IR = U/R   R=R*(ua^2/VN^2)
GRL1 L1 N VALUE={v(L1,N)/(R*v(ua)*v(ua)/VN2)} tripdv={tdv} tripdt={tdt}
* CONST C
RC1 L1 L1b {rser}
* IC = C*d(U)/dt  C=C*(VN^2/ua^2)
GCL1 L1b N VALUE={DDT(v(L1b,N))*C*VN2/(v(ua)*v(ua))} tripdv={tdv} tripdt={tdt}
RGND N 0 {g}
.ENDS

