+	Q=1e6 ;
+   rser=1u
+   g=1e10
.PARAM
+ omega={2*pi*fn}
+ V={VN/sqrt(3)}
+   PN10=IF(P<=0,PQ0,P)
+   QN10=IF(Q<=0,PQ0,Q)
+	R={V*V/PN10}
+	L={(V*V/QN10)/omega}
Rctrl ctrl 0 1e12
GRL1 L1 N VALUE={v(ctrl)*v(L1,N)/R} tripdv={tdv} tripdt={tdt}
RL1 L1 L1a {rser}
GLL1 L1a N VALUE={v(ctrl)*v(idt1)/L} tripdv={tdv} tripdt={tdt}
G1x 0 idt1 VALUE={v(L1a,N)} tripdv=1 tripdt=1
C1x idt1 0 1
R1x idt1 0 1e10
