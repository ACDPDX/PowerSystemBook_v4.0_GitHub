+	P=1e6	;
+	Q=-1e6 ;should be negativ
+   rser=1u
+   g=1e10
.PARAM
+ omega={2*pi*fn}
+ V={VN/sqrt(3)}
+ PN10=IF(P<=0,PQ0,P) 
+ QN10=IF(Q>=0,PQ0,Q)  
+	R={V*V*PN10/(PN10*PN10+QN10*QN10)}
+	C={IF(Q>=0,(PN10*PN10+QN10*QN10)/(V*V*QN10*omega),-(PN10*PN10+QN10*QN10)/(V*V*QN10*omega))}
Rctrl ctrl 0 1e12
GRL1 L1 L1a VALUE={v(ctrl)*v(L1,L1a)/R} tripdv={tdv} tripdt={tdt}
RC1 L1a L1b {rser}
GCL1 L1b N VALUE={v(ctrl)*DDT(v(L1b,N))*C} tripdv={tdv} tripdt={tdt}
RGND N 0 {g}
