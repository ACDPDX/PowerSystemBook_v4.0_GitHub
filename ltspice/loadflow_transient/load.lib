* IR = U/R   R=R*(ua/VN)
GRL1 L1 N VALUE={v(ctrl)*v(L1,N)/(R*v(ua)/VN)} tripdv={tdv} tripdt={tdt}
* CONST L
* IL = 1/L * Int(U) dt  L=L*(ua/VN)
RL1 L1 L1a {rser}
GLL1 L1a N VALUE={v(ctrl)*v(idt1)/(L*v(ua)/VN)} tripdv={tdv} tripdt={tdt}
G1x 0 idt1 VALUE={v(L1a,N)} tripdv=1 tripdt=1
C1x idt1 0 1
R1x idt1 0 1e10
RGND N 0 {g}
.ENDS

* 1 phase RC parallel impedance with I=const and ctrl node
.SUBCKT   Load_1phase_RC_iconst_ctrl_p  L1 N ctrl
+	PARAMS:
+ VN=400;
+   fn={fn1} PQ0=1000
+	P=1e6	;
+	Q=1e6 ;
+   Ulo=0.7
+   Uhi=1.3
+   rser=1u
+   g=1e10
+   fc=3 vfactor=sqrt(3)
.PARAM
+ omega={2*pi*fn}
+ V={VN/sqrt(3)}
+   PN10=IF(P<=0,PQ0,P) 
+   QN10=IF(Q>=0,PQ0,Q) 
+	R={V*V/PN10}                         
+	C={IF(Q>=0,QN10/(V*V*omega),-QN10/(V*V*omega))}
Rctrl ctrl 0 1e12
Elim ua 0 VALUE={Limit(v(ua1),Ulo*VN,Uhi*VN)} tripdv={tdv} tripdt={tdt}
Xvmeter L1 ua1 vmeter2
+ params: fc={fc} vfactor={vfactor}
* CONST R
* IR = U/R   R=R*(ua/VN)
GRL1 L1 N VALUE={v(ctrl)*v(L1,N)/(R*v(ua)/VN)} tripdv={tdv} tripdt={tdt}
* CONST C
* IC = C*d(U)/dt  C=C*(VN/ua)
RC1 L1 L1b {rser}
GCL1 L1b N VALUE={v(ctrl)*DDT(v(L1b,N))*C*VN/(v(ua))} tripdv={tdv} tripdt={tdt}
RGND N 0 {g}
.ENDS

.subckt vmeter2 in out params: fc=3 b0=3 b1=3 lim=1g vfactor=1.73205
Asq 0 in in 0 0 0 sq 0 ota vhigh={lim} rout=1 linear
Adiv_lf _sq sq 0 0 0 0 div 0 ota vhigh={lim} rout=1g cout={1n/fc} linear
Adiv 0 div out1 0 0 0 _sq 0 ota vhigh={lim} rout=1 linear
Ab0 out1 div 0 0 0 0 1 0 ota vhigh={lim} vlow={-lim} cout={.5/pi/fc} rout=1g g={b0/b1} linear
Ab1 out1 1 0 0 0 0 out1 0 ota vhigh={lim} vlow={-lim} cout={.5/pi/fc} rout=1g g={b1} linear
Eout out 0 VALUE={v(out1)*vfactor} tripdv=1 tripdt=1 
.ends vmeter2

