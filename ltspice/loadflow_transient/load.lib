Elim ua 0 VALUE={Limit(v(ua1),Ulo*VN,Uhi*VN)} tripdv={tdv} tripdt={tdt}
* Measurement  END
*
* CONST R
* IR = U/R   R=R*(ua^2/VN^2)
GRL1 L1 L1a VALUE={v(L1,L1a)/(R*v(ua)/VN)} tripdv={tdv} tripdt={tdt}
GRL2 L2 L2a VALUE={v(L2,L2a)/(R*v(ua)/VN)} tripdv={tdv} tripdt={tdt}
GRL3 L3 L3a VALUE={v(L3,L3a)/(R*v(ua)/VN)} tripdv={tdv} tripdt={tdt}
* CONST C
* IC = C*d(U)/dt  C=C*(VN^2/ua^2)
RC1 L1a L1b {rser}
RC2 L2a L2b {rser}
RC3 L3a L3b {rser}
GCL1 L1b N VALUE={DDT(v(L1b,N))*C*VN/(v(ua))} tripdv={tdv} tripdt={tdt} rpar=1e12
GCL2 L2b N VALUE={DDT(v(L2b,N))*C*VN/(v(ua))} tripdv={tdv} tripdt={tdt} rpar=1e12
GCL3 L3b N VALUE={DDT(v(L3b,N))*C*VN/(v(ua))} tripdv={tdv} tripdt={tdt} rpar=1e12
RGND N 0 {g}
.ENDS

* wye load RL with parallel impedances and I=const
.SUBCKT   Load_y_RL_iconst_p  L1 L2 L3 N
+	PARAMS:
+ VN=400;
+ fn={fn1} PQ0=1000
+ P=1e6
+ Q=1e6
+ Uhi=1.2
+ Ulo=0.8
+ rser=1u
+   g=1e10
.PARAM
+ PN={P/3} QN={Q/3}
+ omega={2*pi*fn}
+ V={VN/sqrt(3)}
+   PN10=IF(P<=0,PQ0,PN)
+   QN10=IF(Q<=0,PQ0,QN)
+	R={V*V/PN10}
+	L={(V*V/QN10)/omega}
* Measurement of V START (see also model B6_minmax)
Ep out_p1 0 VALUE={MAX(V(L1),MAX(V(L2),V(L3)))} tripdv={tdv} tripdt={tdt}
En out_n 0 VALUE={MIN(V(L1),MIN(V(L2),V(L3)))} tripdv={tdv} tripdt={tdt}
R1 out_p1 out_p 10
C1 out_p out_n 4700u
R2 out_p out_n 28.55
Eout ua1 0 VALUE={v(out_p,out_n)} tripdv={tdv} tripdt={tdt}
Elim ua 0 VALUE={Limit(v(ua1),Ulo*VN,Uhi*VN)} tripdv={tdv} tripdt={tdt}
* Measurement  END
*
* CONST R
* IR = U/R   R=R*(ua/VN)
GRL1 L1 N VALUE={v(L1,N)/(R*v(ua)/VN)} tripdv={tdv} tripdt={tdt}
GRL2 L2 N VALUE={v(L2,N)/(R*v(ua)/VN)} tripdv={tdv} tripdt={tdt}
GRL3 L3 N VALUE={v(L3,N)/(R*v(ua)/VN)} tripdv={tdv} tripdt={tdt}
* CONST L
* IL = 1/L * Int(U) dt  L=L*(ua/VN)
RL1 L1 L1a {rser}
RL2 L2 L2a {rser}
RL3 L3 L3a {rser}
GLL1 L1a N VALUE={v(idt1)/(L*v(ua)/VN)} tripdv={tdv} tripdt={tdt}
G1x 0 idt1 VALUE={v(L1a,N)} tripdv=1 tripdt=1
C1x idt1 0 1
R1x idt1 0 1e10
GLL2 L2a N VALUE={v(idt2)/(L*v(ua)/VN)} tripdv={tdv} tripdt={tdt}
G2x 0 idt2 VALUE={v(L2a,N)} tripdv=1 tripdt=1
C2x idt2 0 1
R2x idt2 0 1e10
GLL3 L3a N VALUE={v(idt3)/(L*v(ua)/VN)} tripdv={tdv} tripdt={tdt}
G3x 0 idt3 VALUE={v(L3a,N)} tripdv=1 tripdt=1
C3x idt3 0 1
R3x idt3 0 1e10
RGND N 0 {g}
.ENDS

* wye load RC with parallel impedances and I=const
.SUBCKT   Load_y_RC_iconst_p  L1 L2 L3 N
+	PARAMS:
+ VN=400;
+ fn={fn1} PQ0=1000
+ P=1e6
+ Q=1e6
+ Uhi=1.2
+ Ulo=0.8
+ rser=1u
+   g=1e10
.PARAM
+ PN={P/3} QN={Q/3}
+ omega={2*pi*fn}
+ V={VN/sqrt(3)}
+   PN10=IF(P<=0,PQ0,PN) 
+   QN10=IF(Q>=0,PQ0,QN) 
+	R={V*V/PN10}                         
+	C={IF(Q>=0,QN10/(V*V*omega),-QN10/(V*V*omega))}
* Measurement of V START (see also model B6_minmax)
Ep out_p1 0 VALUE={MAX(V(L1),MAX(V(L2),V(L3)))} tripdv={tdv} tripdt={tdt}
En out_n 0 VALUE={MIN(V(L1),MIN(V(L2),V(L3)))} tripdv={tdv} tripdt={tdt}
R1 out_p1 out_p 10
C1 out_p out_n 4700u
R2 out_p out_n 28.55
Eout ua1 0 VALUE={v(out_p,out_n)} tripdv={tdv} tripdt={tdt}
Elim ua 0 VALUE={Limit(v(ua1),Ulo*VN,Uhi*VN)} tripdv={tdv} tripdt={tdt}
* Measurement  END
*
* CONST R
* IR = U/R   R=R*(ua/VN)
GRL1 L1 N VALUE={v(L1,N)/(R*v(ua)/VN)} tripdv={tdv} tripdt={tdt}
GRL2 L2 N VALUE={v(L2,N)/(R*v(ua)/VN)} tripdv={tdv} tripdt={tdt}
GRL3 L3 N VALUE={v(L3,N)/(R*v(ua)/VN)} tripdv={tdv} tripdt={tdt}
* CONST C
* IC = C*d(U)/dt  C=C*(VN/ua)
RC1 L1 L1b {rser}
RC2 L2 L2b {rser}
RC3 L3 L3b {rser}
GCL1 L1b N VALUE={DDT(v(L1b,N))*C*VN/(v(ua))} tripdv={tdv} tripdt={tdt} rpar=1e12
GCL2 L2b N VALUE={DDT(v(L2b,N))*C*VN/(v(ua))} tripdv={tdv} tripdt={tdt} rpar=1e12
GCL3 L3b N VALUE={DDT(v(L3b,N))*C*VN/(v(ua))} tripdv={tdv} tripdt={tdt} rpar=1e12
RGND N 0 {g}
.ENDS

