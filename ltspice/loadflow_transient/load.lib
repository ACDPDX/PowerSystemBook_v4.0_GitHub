GLL1 L1b N VALUE={v(idt1)/(L*v(ua)/VN)} tripdv={tdv} tripdt={tdt}
G1x 0 idt1 VALUE={v(L1b,N)} tripdv=1 tripdt=1
C1x idt1 0 1
R1x idt1 0 1e10
RGND N 0 {g}
