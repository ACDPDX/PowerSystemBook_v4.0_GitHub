*$


* Reset=disable -> enable=0
* very simple synchronizing unit for the synchronous generator model
.SUBCKT syncgen L1_n L2_n L3_n L1_g L2_g L3_g n fdif vdif Q0 Q1 sync enable
+ PARAMS: p=2 fn={fn1} fdif=50m vdif=1k
Efdif fdif 0 VALUE={fN-(v(n)*p/60)}  tripdv={tdv} tripdt={tdt}
Evdif1 vdif1 0 VALUE={abs(v(L1_n)-v(L1_g))}  tripdv={tdv} tripdt={tdt}
Evdif2 vdif2 0 VALUE={abs(v(L2_n)-v(L2_g))}  tripdv={tdv} tripdt={tdt}
Evdif3 vdif3 0 VALUE={abs(v(L3_n)-v(L3_g))}  tripdv={tdv} tripdt={tdt}
* Measurement with MINMAX
Ep vdif 0 VALUE={MAX(V(vdif1),MAX(V(vdif2),V(vdif3)))} tripdv={tdv} tripdt={tdt}
Esync1 sync1 0 VALUE={IF(abs(v(fdif))<fdif & v(vdif)<vdif & v(enable),1,0)} tripdv={tdv} tripdt={tdt}
* Selbsthalteschaltung
E1 1 0 VALUE={1*v(enable)} tripdv={tdv} tripdt={tdt}
R1 sync 0 1k
S1 1 sync sync1 0 MS1
S2 1 sync sync 0 MS1
.model MS1 SW(Ron=0.01 Roff=1e9 Vt=0.9 Vh=0 Lser=0 Vser=0)
*
EQ0 Q0 0 VALUE={inv(v(sync))}  tripdv={tdv} tripdt={tdt}
EQ1 Q1 0 VALUE={v(sync)}  tripdv={tdv} tripdt={tdt}
RQ0 Q0 0 1e12
RQ1 Q1 0 1e12
Rfdif fdif 0 1e12
Rvdif vdif 0 1e12
Rsync sync 0 1e12
Renable enable 0 1e12
Rn n 0 1e12
RL1_n L1_n 0 1e12
RL2_n L2_n 0 1e12
RL3_n L3_n 0 1e12
RL1_g L1_g 0 1e12
RL2_g L2_g 0 1e12
RL3_g L3_g 0 1e12
.ENDS
*$


* Reset=disable -> enable=0
* very simple synchronizing unit for the synchronous generator model
.SUBCKT syncgen2 L1_n L2_n L3_n L1_g L2_g L3_g n2 n1 fdif vdif Q0 Q1 sync enable
+ PARAMS: p=2 fdif=50m vdif=1k
Efdif fdif 0 VALUE={(v(n1)-v(n2))*p/60}  tripdv={tdv} tripdt={tdt}
Evdif1 vdif1 0 VALUE={abs(v(L1_n)-v(L1_g))}  tripdv={tdv} tripdt={tdt}
Evdif2 vdif2 0 VALUE={abs(v(L2_n)-v(L2_g))}  tripdv={tdv} tripdt={tdt}
Evdif3 vdif3 0 VALUE={abs(v(L3_n)-v(L3_g))}  tripdv={tdv} tripdt={tdt}
* Measurement with MINMAX
Ep vdif 0 VALUE={MAX(V(vdif1),MAX(V(vdif2),V(vdif3)))} tripdv={tdv} tripdt={tdt}
Esync1 sync1 0 VALUE={IF(abs(v(fdif))<fdif & v(vdif)<vdif & v(enable),1,0)} tripdv={tdv} tripdt={tdt}
* Selbsthalteschaltung
E1 1 0 VALUE={1*v(enable)} tripdv={tdv} tripdt={tdt}
R1 sync 0 1k
S1 1 sync sync1 0 MS1
S2 1 sync sync 0 MS1
.model MS1 SW(Ron=0.01 Roff=1e9 Vt=0.9 Vh=0 Lser=0 Vser=0)
*
EQ0 Q0 0 VALUE={inv(v(sync))} tripdv={tdv} tripdt={tdt}
EQ1 Q1 0 VALUE={v(sync)} tripdv={tdv} tripdt={tdt}
RQ0 Q0 0 1e12
RQ1 Q1 0 1e12
Rfdif fdif 0 1e12
Rvdif vdif 0 1e12
Rsync sync 0 1e12
Renable enable 0 1e12
Rn2 n2 0 1e12
Rn1 n1 0 1e12
RL1_n L1_n 0 1e12
RL2_n L2_n 0 1e12
RL3_n L3_n 0 1e12
RL1_g L1_g 0 1e12
RL2_g L2_g 0 1e12
RL3_g L3_g 0 1e12
.ENDS
;$SpiceType=MCAPSPICE
*$
