* File: C:\Users\fried\Documents\LTspiceXVII\plot.defs
*
*****************************************************
* general stuff
*****************************************************
* neg(-1,-2,-3 ... ) = 1   neg(0,1,2,3 ...)=0
.func neg(a) {(sgn(a)*(sgn(a)-1))/2}
* pos(-1,-2,-3 ... ) = 0   pos(0,1,2,3 ...)=1
.func pos(a) {abs(neg(a)-1)}
* invsgn(-1,-2,-3 ... ) = 1  invsgn(0,1,2,3)= -1
.func invsgn(a) -{sgn(a)}
* greater or equal (0 or 1)
.func ge(a,b) {pos(a-b)}
* lower or equal (0 or 1)
.func le(a,b) {pos(b-a)}
* lower than (0 or 1)
.func lt(a,b) {neg(a-b)}
* greater than (0 or 1)
.func gt(a,b) {neg(b-a)}
* equal (0 or 1)
.func eq(a,b) {ge(a,b)*le(a,b)}
* not equal (0 or 1)
.func neq(a,b) {gt(a,b)+lt(a,b)}
* if(1,a,b)  true=1 false=not 1   if true  a sonst b
* e.g. if(gt(a,0),a*a,-(abs(a*a)))
.func _if(a,b,c) {(eq(a,1)*b)+(neq(a,1)*c)}
* limit b=lower c=upper a=variable to limit
.func limit(a,b,c) {_if(lt(a,b),b,_if(gt(a,c),c,a))}
*****************************************************
* special loadflow toolbox stuff
******************************************************
.param vfactor=sqrt(3)
.param sfactor=3.0
* magnitude of real , imag
.func mag2(a,b) {sqrt(a*a+b*b)}
* phase of real, imag with atanfunc ( -120..120 deg )
.func ph2(a,b) {if(eq(mag2((a),(b)),0),0,(180*neg(a)*pos(b)-180*neg(b)*neg(a)+atan((b)/(a))))}
* or with asinfunc .func ph2(a,b) (if(eq(mag2((a),(b)),0),0,(180*neg(a)*pos(b)-180*neg(b)*neg(a)+asin(b/mag2(a,b)))))
* -180...180 > 0..360 conversion if(a<0,360-a,a)
.func to360(a) {if(neg(a),360+(a),(a))}
* phase difference clockwise - arguments are assumed to be always 0..360
* be sure to convert -180..180 arguments with function to360(a) before !!!!!
.func phdiffcw(a,b) {if(((a)-(b)+0.5),(b)-(a),(b)-(a)-360)}
* phase difference conterclockwise
.func phdiffcc(a,b) {-phdiffcw(b,a)}
* p1 ( one phase real power ) a=v1r b=v1i c=i1r d=i1i
.func p1(a,b,c,d) {(a)*(c)+(b)*(d)}
* p3 ( three phase real power )
.func p3(a,b,c,d) {((a)*(c)+(b)*(d))*(sfactor)}
* q1 ( one phase imag power )
.func q1(a,b,c,d) {(b)*(c)-(a)*(d)}
* q3 ( three phase imag power )
.func q3(a,b,c,d) {((b)*(c)-(a)*(d))*(sfactor)}
* s1 ( one phase complex power )
.func s1(a,b,c,d) {mag2(p1(a,b,c,d),q1(a,b,c,d))}
* s3 ( three phase complex power )
.func s3(a,b,c,d) {mag2(p3(a,b,c,d),q3(a,b,c,d))}
* dp3 ( three phase power lost ) e=v2r f=v2i g=i2r h=i2i
.func dp3(a,b,c,d,e,f,g,h) {p3(a,b,c,d)+p3(e,f,g,h)}
**********************************************************
* special transient toolbox stuff:
**********************************************************
* dt=Measure of time in ms measured from current zero to voltage zero (for value see left statusline)
.func dt1(dt) {IF(dt>5m,dt-10m,IF(dt<-5m,dt+10m,dt))}
.func dt1_60(dt) {IF(dt>4.1667m,dt-8.3333m,IF(dt<-4.1667m,dt+8.3333m,dt))}
.func t2phi(dt) {dt1(dt)*90/5m}
.func t2phi60(dt) {dt1_60(dt)*90/4.1667m}
* apparent power measurement per phase (sfactor=1)
.func S(ipeak,vpeak) {0.5*ipeak*vpeak}
* aktive power measurement
.func P50Hz(ipeak,vpeak,ti,tv) {IF((ti-tv)<5m & (ti-tv)>=-5ms,S(ipeak,vpeak)*cos(t2phi(ti-tv)),-S(ipeak,vpeak)*cos(t2phi(ti-tv)))}
* reactive power measurement ti>tv Qpos ti<tv Qneg
.func Q50Hz(ipeak,vpeak,ti,tv) {IF((ti-tv)<5m & (ti-tv)>=-5ms,S(ipeak,vpeak)*sin(t2phi((ti-tv))),-S(ipeak,vpeak)*sin(t2phi((ti-tv))))}
* aktive power measurement
.func P50Hz2(ipeak,vpeak,dt) {IF((dt)<5m & (dt)>=-5ms,S(ipeak,vpeak)*cos(t2phi(dt)),-S(ipeak,vpeak)*cos(t2phi(dt)))}
* reactive power measurement ti>tv Qpos ti<tv Qneg
.func Q50Hz2(ipeak,vpeak,dt) {IF((dt)<5m & (dt)>=-5ms,S(ipeak,vpeak)*sin(t2phi((dt))),-S(ipeak,vpeak)*sin(t2phi((dt))))}
* aktive power measurement
.func P60Hz(ipeak,vpeak,ti,tv) {IF((ti-tv)<4.1667m & (ti-tv)>=-4.1667m,S(ipeak,vpeak)*cos(t2phi60((ti-tv))),-S(ipeak,vpeak)*cos(t2phi60((ti-tv))))}
* reactive power measurement ti>tv Qpos ti<tv Qneg
.func Q60Hz(ipeak,vpeak,ti,tv) {IF((ti-tv)<4.1667m & (ti-tv)>=-4.1667m,S(ipeak,vpeak)*sin(t2phi60((ti-tv))),-S(ipeak,vpeak)*sin(t2phi60((ti-tv))))}
* aktive power measurement
.func P60Hz2(ipeak,vpeak,dt) {IF((dt)<4.1667m & (dt)>=-4.1667m,S(ipeak,vpeak)*cos(t2phi60((dt))),-S(ipeak,vpeak)*cos(t2phi60((dt))))}
* reactive power measurement ti>tv Qpos ti<tv Qneg
.func Q60Hz2(ipeak,vpeak,dt) {IF((dt)<4.1667m & (dt)>=-4.1667m,S(ipeak,vpeak)*sin(t2phi60((dt))),-S(ipeak,vpeak)*sin(t2phi60((dt))))}
* IF phii and phiv is measured by phasemeters
.func dphi(phii,phiv) {phii-phiv}
.func phy(phii,phiv) {IF(dphi(phii,phiv)<-90,dphi(phii,phiv)+180,dphi(phii,phiv))}
.func phi(phii,phiv){IF(dphi(phii,phiv)>90,dphi(phii,phiv)-180,phy(phii,phiv))}
.func P1(phii,phiv,ipeak,vpeak) {IF(dphi(phii,phiv)<90 & dphi(phii,phiv)>-90,S(ipeak,vpeak)*cos(V(phi)*pi/180),-S(ipeak,vpeak)*cos(V(phi)*pi/180))}
.func Q1(phii,phiv,ipeak,vpeak) {IF(dphi(phii,phiv)<90 & dphi(phii,phiv)>-90,-S(ipeak,vpeak)*sin(V(phi)*pi/180),S(ipeak,vpeak)*sin(V(phi)*pi/180))}

