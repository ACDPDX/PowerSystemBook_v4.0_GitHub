* capacitance for voltage regulation with control node
.SUBCKT   CBatt_100MVAR_ctrl  L1 L2 L3 ctrl
+	PARAMS:
+   VN=110e3;
+   fn={fn1}
+   Q=100e6
+   r_x=0.001
.PARAM
+   QN={Q/3}
+   omega={2*3.14156*fn}
+   C={QN/omega/VN/VN}
* Delta
Rctrl ctrl 0 1e12
CL1 L1 L2a q={C}*v(ctrl)*x
RL1 L2a L2 {(1/(C*omega))*r_x}
CL2 L2 L3a q={C}*v(ctrl)*x
RL2 L3a L3 {(1/(C*omega))*r_x}
CL3 L3 L1a q={C}*v(ctrl)*x
RL3 L1a L1 {(1/(C*omega))*r_x}
.ENDS

.SUBCKT   CBatt_100MVAR_GND_ctrl  L1 L2 L3 ctrl
+	PARAMS:
+   VN=110e3;
+   fn={fn1}
+   Q=100e6
+   r_x=0.001
+   RGND=1e-3
+   LGND=1e-6
.PARAM
+   QN={Q/3}
+   omega={2*3.14156*fn}
+   C={3*QN/omega/VN/VN}
* Wye
Rctrl ctrl 0 1e12
CL1 L1 L1a q={C}*v(ctrl)*x
RL1 L1a N {(1/(C*omega))*r_x}
CL2 L2 L2a q={C}*v(ctrl)*x
RL2 L2a N {(1/(C*omega))*r_x}
CL3 L3 L3a q={C}*v(ctrl)*x
RL3 L3a N {(1/(C*omega))*r_x}
RGND N N1 {RGND}
LGND N1 0 {LGND}
.ENDS

* compensation of the capacitance of a line
.SUBCKT   Line_comp_gnd  L1 L2 L3
+	PARAMS:
+   VN=400e3;
+   fn={fn1}
+   Q=50e6
+   r_x=0.001
+   RGND=1e-3
+   LGND=1e-6
.PARAM
+   QN={Q/3}
+   V={VN/sqrt(3)}
+   omega={2*3.14156*fn}
+	L ={(V*V)/(QN*omega)}
* Wye
LL1 L1 0 {L} Rser={L*omega*r_x}
LL2 L2 0 {L} Rser={L*omega*r_x}
LL3 L3 0 {L} Rser={L*omega*r_x}
RGND N N1 {RGND}
LGND N1 0 {LGND}
.ENDS

* compensation of the capacitance of a line
.SUBCKT   Line_comp  L1 L2 L3
+	PARAMS:
+   VN=400e3;
+   fn={fn1}
+   Q=50e6
+   r_x=0.001
.PARAM
+   QN={Q/3}
+   omega={2*3.14156*fn}
+	L ={(VN*VN)/(QN*omega)}
* Wye
LL1 L1 L2 {L} Rser={L*omega*r_x}
LL2 L2 L3 {L} Rser={L*omega*r_x}
LL3 L3 L1 {L} Rser={L*omega*r_x}
.ENDS

