

* shunt reactor for voltage regulation
.SUBCKT   LBatt  L1 L2 L3
+	PARAMS:
+   VN=110e3;
+   fn={fn1}
+   Q=50e6
+   r_x=0.001
.PARAM
+   QN={Q/3}
+   omega={2*3.14156*fn}
+	L ={(VN*VN)/(QN*omega)}
* Delta
LL1 L1 L2 {L} Rser={L*omega*r_x}
LL2 L2 L3 {L} Rser={L*omega*r_x}
LL3 L3 L1 {L} Rser={L*omega*r_x}
.ENDS

.SUBCKT C_exp1  L1_1 L1_2
+	PARAMS:
+	C=0.5	;
+   fn={fn1}
+   XC=0
+ length=1
+ rser=1e-6
+ TD=0
+ texp=25m
+ g=1e12
.PARAM
+   C1=IF(xc>0,1/xc/fn/2/pi,C)
+   rser1=IF(rser>0,rser,1e-6)
Ein in1a in1b VALUE={IF(time>TD,v(L1_1,L1_2x)*(1-exp(-abs(time-TD)/(Texp+1u))),0)} tripdv={tdv} tripdt={tdt}
Gout L1_1 L1_2x VALUE={DDT(v(in1a,in1b))*C1*length} tripdv={tdv} tripdt={tdt}
Rser L1_2x L1_2 {rser1}
Rx  L1_2x 0 1e12
Rgnd1 L1_1 0 {g}
Rgnd2 L1_2 0 {g}
.ENDS

.SUBCKT L_exp1  L1_1 L1_2
+	PARAMS:
+	L=1	
+   fn={fn1}
+   xl=0
+ length=1
+ TD=0
+ rser=1e-6
+ texp=25m
+ g=1e12
.PARAM
+   L1=IF(xl>0,xl/fn/2/pi,L)
+   rser1=IF(rser>0,rser,1e-6)
Ein in1a in1b VALUE={IF(time>TD,v(L1_1,L1_2x)*(1-exp(-abs(time-TD)/(Texp+1u))),0)} tripdv={tdv} tripdt={tdt}
Gout L1_1 L1_2x VALUE={v(idt1)/(L1*length)} tripdv={tdv} tripdt={tdt}
G1x 0 idt1 VALUE={v(in1a,in1b)} tripdv=1 tripdt=1
C1x idt1 0 1
R1x idt1 0 1e10
Rser L1_2x L1_2 {rser1}
Rx L1_2x 0 1e12
Rgnd1 L1_1 0 {g}
Rgnd2 L1_2 0 {g}
.ENDS

*************************************
* capacitance for voltage regulation
* Cexp, Lexp from impedance.lib 
********************************
.SUBCKT   LBatt_exp  L1 L2 L3
+	PARAMS:
+   VN=110e3;
+   fn={fn1}
+   Q=50e6
+   TD=0
+   Texp=5ms
+   r_x=0.001
.PARAM
+   QN={Q/3}
+   omega={2*3.14156*fn}
+	L ={(VN*VN)/(QN*omega)}
* Delta
RL1 L1 L1a {L*omega*r_x}
RL2 L2 L2a {L*omega*r_x}
RL3 L3 L3a {L*omega*r_x}
XLL1 L1a L2 L_exp1 params: L={L} TD={TD} Texp={Texp} fn={fn}
XLL2 L2a L3 L_exp1 params: L={L} TD={TD} Texp={Texp} fn={fn}
XLL3 L3a L1 L_exp1 params: L={L} TD={TD} Texp={Texp} fn={fn}
.ENDS


* shunt reactor for voltage regulation
.SUBCKT   LBatt_50MVAR  L1 L2 L3
+	PARAMS:
+   VN=110e3;
+   fn={fn1}
+   Q=50e6
+   r_x=0.001
.PARAM
+   QN={Q/3}
+   omega={2*3.14156*fn}
+	L ={(VN*VN)/(QN*omega)}
* Delta
LL1 L1 L2 {L} Rser={L*omega*r_x}
LL2 L2 L3 {L} Rser={L*omega*r_x}
LL3 L3 L1 {L} Rser={L*omega*r_x}
.ENDS

* shunt reactor for voltage regulation
.SUBCKT   LBatt_50MVAR_GND  L1 L2 L3
+	PARAMS:
+   VN=110e3;
+   fn={fn1}
+   Q=50e6
+   r_x=0.001
+   RGND=1e-3
+   LGND=1e-6
.PARAM
+   QN={Q/3}
+   omega={2*3.14156*fn}
+	L ={(VN*VN)/(3*QN*omega)}
* Delta
LL1 L1 N {L} Rser={L*omega*r_x}
LL2 L2 N {L} Rser={L*omega*r_x}
LL3 L3 N {L} Rser={L*omega*r_x}
RGND N N1 {RGND}
LGND N1 0 {LGND}
.ENDS


* shunt reactor for voltage regulation
.SUBCKT   LBatt_100MVAR  L1 L2 L3
+	PARAMS:
+   VN=110e3;
+   fn={fn1}
+   Q=100e6
+   r_x=0.001
.PARAM
+   QN={Q/3}
+   omega={2*3.14156*fn}
+	L ={(VN*VN)/(QN*omega)}
* Delta
LL1 L1 L2 {L} Rser={L*omega*r_x}
LL2 L2 L3 {L} Rser={L*omega*r_x}
LL3 L3 L1 {L} Rser={L*omega*r_x}
.ENDS

.SUBCKT   LBatt_100MVAR_GND  L1 L2 L3
+	PARAMS:
+   VN=110e3;
+   fn={fn1}
+   Q=100e6
+   r_x=0.001
+   RGND=1e-3
+   LGND=1e-6
.PARAM
+   QN={Q/3}
+   omega={2*3.14156*fn}
+	L ={(VN*VN)/(3*QN*omega)}
* Delta
LL1 L1 N {L} Rser={L*omega*r_x}
LL2 L2 N {L} Rser={L*omega*r_x}
LL3 L3 N {L} Rser={L*omega*r_x}
RGND N N1 {RGND}
LGND N1 0 {LGND}
.ENDS



* shunt reactor for voltage regulation with controlling nodes
.SUBCKT   LBatt_100MVAR_ctrl  L1 L2 L3 ctrl
+	PARAMS:
+   VN=110e3;
+   fn={fn1}
+   Q=100e6
+   r_x=0.001
.PARAM
+   QN={Q/3}
+   omega={2*3.14156*fn}
+	L ={(VN*VN)/(QN*omega)}
* Delta
Rctrl ctrl 0 1e12
LL1 L1 L2x flux={L}/v(ctrl)*x
GR1 L2x L2 VALUE={v(L2x,L2)/((L/v(ctrl))*omega*r_x)} tripdv={tdv} tripdt={tdt}
LL2 L2 L3x flux={L}/v(ctrl)*x
GR2 L3x L3 VALUE={v(L3x,L3)/((L/v(ctrl))*omega*r_x)} tripdv={tdv} tripdt={tdt}
LL3 L3 L1x flux={L}/v(ctrl)*x
GR3 L1x L1 VALUE={v(L1x,L1)/((L/v(ctrl))*omega*r_x)} tripdv={tdv} tripdt={tdt}
.ENDS

.SUBCKT   LBatt_100MVAR_GND_ctrl  L1 L2 L3 ctrl
+	PARAMS:
+   VN=110e3;
+   fn={fn1}
+   Q=100e6
+   r_x=0.001
.PARAM
+   QN={Q/3}
+   omega={2*3.14156*fn}
+	L ={(VN*VN)/(3*QN*omega)}
* Delta
Rctrl ctrl 0 1e12
LL1 L1 L1x flux={L}/v(ctrl)*x
GR1 L1x N VALUE={v(L2x,L2)/((L/v(ctrl))*omega*r_x)} tripdv={tdv} tripdt={tdt}
LL2 L2 L2x flux={L}/v(ctrl)*x
GR2 L2x N VALUE={v(L3x,L3)/((L/v(ctrl))*omega*r_x)} tripdv={tdv} tripdt={tdt}
LL3 L3 L3x flux={L}/v(ctrl)*x
GR3 L3x N VALUE={v(L1x,L1)/((L/v(ctrl))*omega*r_x)} tripdv={tdv} tripdt={tdt}
RGND N 0 1e-3
.ENDS

* capacitance for voltage regulation
.SUBCKT   CBatt  L1 L2 L3
+	PARAMS:
+   VN=110e3;
+   fn={fn1}
+   Q=50e6
+   r_x=0.001
.PARAM
+   QN={Q/3}
+   omega={2*3.14156*fn}
+   C={QN/omega/VN/VN}
* Delta
CL1 L1 L2 {C} Rser={(1/(C*omega))*r_x}
CL2 L2 L3 {C} Rser={(1/(C*omega))*r_x}
CL3 L3 L1 {C} Rser={(1/(C*omega))*r_x}
.ENDS


.SUBCKT   CBatt_exp  L1 L2 L3
+	PARAMS:
+   VN=110e3;
+   fn={fn1}
+   Q=50e6
+   TD=0
+   Texp=5ms
+   r_x=0.001 
.PARAM
+   QN={Q/3}
+   omega={2*3.14156*fn}
+   C={QN/omega/VN/VN}
* Delta
XCL1 L1 L2 C_exp1 params: C={C1} fn={fn} TD={TD} Texp={Texp} Rser={(1/(C*omega))*r_x}
XCL2 L2 L3 C_exp1 params: C={C1} fn={fn} TD={TD} Texp={Texp} Rser={(1/(C*omega))*r_x}
XCL3 L3 L1 C_exp1 params: C={C1} fn={fn} TD={TD} Texp={Texp} Rser={(1/(C*omega))*r_x}
.ENDS

* capacitance for voltage regulation
.SUBCKT   CBatt_50MVAR  L1 L2 L3
