* Delta
CL1 L1 N {C} Rser={(1/(C*omega))*r_x}
CL2 L2 N {C} Rser={(1/(C*omega))*r_x}
CL3 L3 N {C} Rser={(1/(C*omega))*r_x}
RGND N N1 {RGND}
LGND N1 0 {LGND}
.ENDS

* capacitance for voltage regulation
.SUBCKT   CBatt_100MVAR  L1 L2 L3
+	PARAMS:
+   VN=110e3;
+   fn={fn1}
+   Q=100e6
+   r_x=0.001
.PARAM
+   QN={Q/3}
+   omega={2*3.14156*fn}
+   C={QN/omega/VN/VN}
* Delta
CL1 L1 L2 {C} Rser={(1/(C*omega))*r_x}
CL2 L2 L3 {C} Rser={(1/(C*omega))*r_x}
CL3 L3 L1 {C} Rser={(1/(C*omega))*r_x}
.ENDS

.SUBCKT   CBatt_100MVAR_GND  L1 L2 L3
+	PARAMS:
+   VN=110e3;
+   fn={fn1}
+   Q=100e6
+   r_x=0.001
+   RGND=1e-3
+   LGND=1e-6
.PARAM
+   QN={Q/3}
+   omega={2*3.14156*fn}
+   C={QN*3/omega/VN/VN}
* Delta
CL1 L1 N {C} Rser={(1/(C*omega))*r_x}
CL2 L2 N {C} Rser={(1/(C*omega))*r_x}
CL3 L3 N {C} Rser={(1/(C*omega))*r_x}
RGND N N1 {RGND}
LGND N1 0 {LGND}
