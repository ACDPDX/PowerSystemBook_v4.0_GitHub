# **************************
if($ARGV[0]eq'-h')
{  print "usage: (tiny)perl gen_template.pl -sys:systems > outfile ";
   print "\n\n    example: tinyperl -sys:2 > mytemplate.txt\n"; 
   print "(sys = 1,2,3,4,5,6,...)\n\n";
   exit; 
}
# Definition der Anzahl der Systeme !
if($ARGV[0]=~ m/-sys/)
{
   $systems=$ARGV[0];
   $systems=~s/^-sys://;
   $ln=3*$systems;
}

#.SUBCKT   Line_2_coupled  1a 2a 3a 4a 5a 6a 1b 2b 3b 4b 5b 6b
#+	PARAMS:
#+ R1=0.1 R2=0.1 R3=0.1 R4=0.1 R5=0.1 R6=0.1  
#+ XL11=1 XL22=1 XL33=1 XL44=1 XL55=1 XL66=1
#+ XM12=1u XM13=1u XM14=1u XM15=1u XM16=1u 
#+ XM23=1u XM24=1u XM25=1u XM26=1u 
#+ XM34=1u XM35=1u XM36=1u 
#+ XM45=1u XM46=1u 
#+ XM56=1u
#+ C11=10n C22=10n C33=10n C44=10n C55=10n C66=10n
#+ C12=1p C13=1p C14=1p C15=1p C16=1p 
#+ C23=1p C24=1p C25=1p C26=1p 
#+ C34=1p C35=1p C36=1p 
#+ C45=1p C46=1p 
#+ C56=1p
#+ length=1
#+ cl=1
#+ g=1e12
#+ fn=50 
#.PARAM
#+ omega={fn*2*3.14159}


print ".subckt template ";
for(my $i=1;$i<=$ln;$i++) # spalten
{
    print "$i"."a ";
} 
for(my $i=1;$i<=$ln;$i++) # spalten
{
    print "$i"."b ";
} 
print "\n";
print "+PARAMS:\n";
print "+ ";
for(my $i=1;$i<=$ln;$i++) # spalten
{
    print "R$i=1 ";
} 
print "\n>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>> INPUT ATP MATRIX HERE !! >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>> \n";
#+ length=1
#+ cl=1
#+ g=1e10
#+ fn=50 
#.PARAM
#+ omega={fn*2*3.14159}
print "+ length=1\n";
print "+ cl=1\n";
print "+ g=1e12\n";
print "+ fn=50\n";
print ".PARAM\n";
print "+ omega={fn*2*3.14159}\n";
print "*********************************\n";

#+ L11={XL11/omega} L22={XL22/omega} L33={XL33/omega} L44={XL44/omega} L55={XL55/omega} L66={XL66/omega}
#+ M12={XM12/omega} M13={XM13/omega} M14={XM14/omega} M15={XM15/omega} M16={XM16/omega}
#+ M23={XM23/omega} M24={XM24/omega} M25={XM25/omega} M26={XM26/omega} 
#+ M34={XM34/omega} M35={XM35/omega} M36={XM36/omega}
#+ M45={XM45/omega} M46={XM46/omega}
#+ M56={XM56/omega} 
for(my $i=1;$i<=$ln;$i++) # spalten
{
    for(my $j=$i;$j<=$ln;$j++) # zeilen
	{
		 if ($i==$j) 
		 {
			print"+ L$i$i={XL$i$i/omega} "
		 }
		 else 
		 {
		    print "M$i$j={XM$i$j/omega} "; # Normal case
		 }
	}
	print "\n";
}
print "*******************************************************************\n";
print "* geschaetzte BetriebsInduktivität/Phase bei symm. Betrieb(1,a,a*a)\n";
print "*******************************************************************\n";
#+ L1={L11-0.5*M12-0.5*M13+1*M14-0.5*M15-0.5*M16} ;(not used)
#+ L2={L22-0.5*M12-0.5*M23+1*M24-0.5*M25-0.5*M26} ;(not used)
#+ L3={L33-0.5*M13-0.5*M23+1*M34-0.5*M35-0.5*M36} ;(not used)
#+ L4={L44-0.5*M14-0.5*M24+1*M34-0.5*M45-0.5*M46} ;(not used) 
#+ L5={L55-0.5*M15-0.5*M25+1*M35-0.5*M45-0.5*M56} ;(not used)
#+ L6={L66-0.5*M16-0.5*M26+1*M36-0.5*M46-0.5*M56} ;(not used)
for(my $i=1;$i<=$ln;$i++) # spalten
{
	my $x=1;
	print "+ L$i"."={L$i$i";  
    for(my $j=1;$j<=$ln;$j++) # zeilen
	{
		 if($j<$i) # C21->C12
		 {
			if($x%3==0)  # 3 6 9 12!
			{
				print "+1*M$j$i"; # special case
			}
			else
			{
			    print "-0.5*M$j$i"; # Reverse it
			}
			$x++;
		 }
		 elsif ($i==$j) 
		 {
			next;
		 }
		 else 
		 {
		    if($x%3==0)
			{
				print "+1*M$i$j"; # special case
			}
			else
			{
			    print "-0.5*M$i$j"; # Normal case
			}
			$x++;
		 }
	}
	print "} ;(not used)\n";
}
print "*********************************\n";	
#+ k12={M12/sqrt(L11*L22)}
#+ k13={M13/sqrt(L11*L33)}
#+ k14={M14/sqrt(L11*L44)}
#+ k15={M15/sqrt(L11*L55)}
#+ k16={M16/sqrt(L11*L66)}
#+ k23={M23/sqrt(L22*L33)}
#+ k24={M24/sqrt(L22*L44)}
#+ k25={M25/sqrt(L22*L55)}
#+ k26={M26/sqrt(L22*L66)}
#+ k34={M34/sqrt(L33*L44)}
#+ k35={M35/sqrt(L33*L55)}
#+ k36={M36/sqrt(L33*L66)}
#+ k45={M45/sqrt(L44*L55)}
#+ k46={M46/sqrt(L44*L66)}
#+ k56={M56/sqrt(L55*L66)}
for(my $i=1;$i<=$ln;$i++) # spalten
{
    for(my $j=$i;$j<=$ln;$j++) # zeilen
	{
		 if ($i==$j) 
		 {
			next;
		 }
		 else 
		 {
		    print "+ k$i$j={M$i$j/sqrt(L$i$i*L$j$j)}\n"; # Normal case
		 }
	}
}
print "*******************************\n";
#+ C10={C11-C12-C13-C14-C15-C16} C(Spalte,Zeile) 
#+ C20={C22-C12-C23-C24-C25-C26}
#+ C30={C33-C13-C23-C34-C35-C36}
#+ C40={C44-C14-C24-C34-C45-C46} 
#+ C50={C55-C15-C25-C35-C45-C56} 
#+ C60={C66-C16-C26-C36-C46-C56} 
for(my $i=1;$i<=$ln;$i++) # spalten
{
	print "+ C_$i"."0={C$i$i";  #C10={C11	
    for(my $j=1;$j<=$ln;$j++) # zeilen
	{
		 if($j<$i) # C21->C12
		 {
			 print "-C$j$i"; # Reverse it
		 }
		 elsif ($i==$j) 
		 {
			next;
		 }
		 else 
		 {
		    print "-C$i$j"; # Normal case
		 }
	}
	print "}\n";
}
#+ C12={C12} ;(not used)
#+ C13={C13} ;(not used) 
#+ C23={C23} ;(not used)
#+ C45={C45} ;(not used)
#+ C46={C46} ;(not used)
#+ C56={C56} ;(not used)
print "************************************************\n";	
print "* Leiter Leiter Kap(nur innerhalb einer Leitung)\n";
print "***********************************************\n";
for(my $i=1;$i<=$ln/2;$i++) # spalten
{
    for(my $j=$i;$j<=$ln/2;$j++) # zeilen # *********************************************************
	{
		 if ($i==$j) 
		 {
			next;
		 }
		 else 
		 {
		    print "+ C$i$j={C$i$j} ;(not used)\n"; # Normal case
		 }
	}
}
for(my $i=1+$ln/2;$i<=$ln;$i++) # spalten
{
    for(my $j=$i;$j<=$ln;$j++) # zeilen
	{
		 if ($i==$j) 
		 {
			next;
		 }
		 else 
		 {
		    print "+ C$i$j={C$i$j} ;(not used)\n"; # Normal case
		 }
	}
}
print "**** geschaetzte LL-LE-Kap.je System ****\n"; # ************************************************************
#+ CE1={(C10+C20+C30)/3} ;(not used)
#+ CE2={(C40+C50+C60)/3} ;(not used)
my $n=1;$m=3;
for(my $j=1;$j<=$systems;$j++)
{
   print "+ CE$j={(";
   for(my $i=$n;$i<=$m;$i++) # spalten
   {
       print "C_$i"."0";
	   if($i<$m)
       {		   
	      print "+";
	   }
   }
   print ")/3} ;(not used)\n";
   $n=$n+3;$m=($n-1)+3;
}
#+ CL1={(C12+C13+C23)/3} ;(not used)
#+ CL2={(C45+C46+C56)/3} ;(not used)
my $n=1;$m=3;
for (my $x=1;$x<=$systems;$x++)
{
	my $start=0;
	print "+ CL$x={(";
    for(my $i=$n;$i<=$m;$i++) # spalten
    {
       for(my $j=$i;$j<=$m;$j++) # zeilen # 
	   {
		 if ($i==$j) 
		 {
			next;
		 }
		 else 
		 {
		    if($start)
			{
				print"+";
			}
			print "C$i$j";
			$start=1;
		 }
	   }
	}
	print ")/3} ;(not used)\n";
	$n=$n+3;$m=($n-1)+3;
}	
print "**** Ausgabe von XB1,2 CE1,2 CB1,2 ****\n"; 
#VXB1 XB1 0 {length*omega*(L1+L2+L3)/3} ;(not used)
#VXB2 XB2 0 {length*omega*(L4+L5+L6)/3} ;(not used)
#VCE1 CE1 0 {length*CE1} ;(not used)
#VCE2 CE2 0 {length*CE2} ;(not used)
#VCL1 CL1 0 {length*CL1} ;(not used)
#VCL2 CL2 0 {length*CL2} ;(not used)
#VCB1 CB1 0 {length*(CE1+3*CL1)} ;(not used)
#VCB2 CB2 0 {length*(CE2+3*CL2)} ;(not used)
my $n=1;$m=3;	
for (my $i=1;$i<=$systems;$i++)
{
	print "VXB$i XB$i 0 {length*omega*(";
    for(my $j=$n;$j<=$m;$j++) # spalten
    {
       print "L$j";
	   if($j<$m)
       {		   
	      print "+";
	   }
    }
	$n=$n+3;$m=($n-1)+3;
	print ")/3} ;(not used)\n";	
}	
for (my $i=1;$i<=$systems;$i++)
{
	print "VCE$i CE$i 0 {length*CE$i} ;(not used)\n";	
}	
for (my $i=1;$i<=$systems;$i++)
{
	print "VCL$i CL$i 0 {length*CL$i} ;(not used)\n";	
}	
for (my $i=1;$i<=$systems;$i++)
{
	print "VCB$i CB$i 0 {length*(CE$i+3*CL$i)} ;(not used)\n";	
}

print "*********************************\n";	
#**************************
#R1a 1a 1ax {length*R1/3} ;LTG1
#R1b 1ax 1ay {length*R1/3} 
#R1c 1bx 1b {length*R1/3}
# 
#R2a 2a 2ax {length*R2/3}
#R2b 2ax 2ay {length*R2/3}
#R2c 2bx 2b {length*R2/3}
#
#R3a 3a 3ax {length*R3/3}
#R3b 3ax 3ay {length*R3/3}
#R3c 3bx 3b {length*R3/3}
#**************************
#**************************
#R4a 4a 4ax {length*R4/3} ;LTG2
#R4b 4ax 4ay {length*R4/3} 
#R4c 4bx 4b {length*R4/3}
# 
#R5a 5a 5ax {length*R5/3}
#R5b 5ax 5ay {length*R5/3}
#R5c 5bx 5b {length*R5/3}
#
#R6a 6a 6ax {length*R6/3}
#R6b 6ax 6ay {length*R6/3}
#R6c 6bx 6b {length*R6/3}
#**************************
for(my $i=1;$i<=$ln;$i++) # spalten
{
    print "R$i"."a $i"."a $i"."ax {0.333333*length*R$i}\n";
	print "R$i"."b $i"."ax $i"."ay {0.333333*length*R$i}\n";
	print "R$i"."c $i"."bx $i"."b {0.333333*length*R$i}\n";	
}
print "*******************************\n";

#**************************
#L1 1ay 1bx {length*L11} ;LTG1
#L2 2ay 2bx {length*L22}
#L3 3ay 3bx {length*L33}
#**************************
#L4 4ay 4bx {length*L44} ;LTG2
#L5 5ay 5bx {length*L55}
#L6 6ay 6bx {length*L66}
#**************************
for(my $i=1;$i<=$ln;$i++) # spalten
{
    print "L$i $i"."ay $i"."bx {length*L$i$i}\n";
}
print "*******************************\n";
#k12 L1 L2 {k12} 
#k13 L1 L3 {k13}
#k14 L1 L4 {k14}
#k15 L1 L5 {k15}
#k16 L1 L6 {k16}
#k23 L2 L3 {k23}
#k24 L2 L4 {k24}
for(my $i=1;$i<=$ln;$i++) # spalten
{
    for(my $j=$i;$j<=$ln;$j++) # zeilen
	{
		 if ($i==$j) 
		 {
			next;
		 }
		 else 
		 {
		    print "k$i$j L$i L$j {k$i$j}\n"; # Normal case
		 }
	}
}
print "*******************************\n";
#C10a 1ax 0 {cl*length*C10/2}
#C10b 1bx 0 {cl*length*C10/2}
#C20a 2ax 0 {cl*length*C20/2}
#C20b 2bx 0 {cl*length*C20/2}
#C30a 3ax 0 {cl*length*C30/2}
#C30b 3bx 0 {cl*length*C30/2}
#C40a 4ax 0 {cl*length*C40/2}
#C40b 4bx 0 {cl*length*C40/2}
#C50a 5ax 0 {cl*length*C50/2}
#C50b 5bx 0 {cl*length*C50/2}
#C60a 6ax 0 {cl*length*C60/2}
#C60b 6bx 0 {cl*length*C60/2}
for(my $i=1;$i<=$ln;$i++) # spalten
{
    print "C_$i"."0a $i"."ax 0 {cl*length*C_$i"."0/2}\n";
	print "C_$i"."0b $i"."bx 0 {cl*length*C_$i"."0/2}\n";
}
print "*******************************\n";
#C12a 1ax 2ax {cl*length*C12/2}
#C12b 1bx 2bx {cl*length*C12/2}
#C13a 1ax 3ax {cl*length*C13/2}
#C13b 1bx 3bx {cl*length*C13/2}
#C14a 1ax 4ax {cl*length*C14/2}
#C14b 1bx 4bx {cl*length*C14/2}
#  
#  usw.
#
for(my $i=1;$i<=$ln;$i++) # spalten
{
    for(my $j=$i;$j<=$ln;$j++) # zeilen
	{
		 if ($i==$j) 
		 {
			next;
		 }
		 else 
		 {
		    print "C$i$j"."a $i"."ax $j"."ax {cl*length*C$i$j/2}\n"; # Normal case
			print "C$i$j"."b $i"."bx $j"."bx {cl*length*C$i$j/2}\n"; # Normal case
		 }
	}
}
print "*******************************\n";
#Rgnd1 1a 0 {g} 
#Rgnd2 2a 0 {g} 
#Rgnd3 3a 0 {g} 
#Rgnd4 4a 0 {g} 
#Rgnd5 5a 0 {g} 
#Rgnd6 6a 0 {g} 
#Rgnd7 1b 0 {g} 
#Rgnd8 2b 0 {g} 
#Rgnd9 3b 0 {g}
#Rgnd10 4b 0 {g} 
#Rgnd11 5b 0 {g} 
#Rgnd12 6b 0 {g}
for(my $i=1;$i<=$ln;$i++) # spalten
{
    print "Rgnd$i $i"."a 0 {g}\n";
}
my $m=$ln+1;
for(my $i=1;$i<=$ln;$i++) # spalten
{
    print "Rgnd$m $i"."b 0 {g}\n";
	$m++;
}
print "*******************************\n";
print ".ENDS\n";


