.param
****************************************
+ Lself={(2*L1+L0)/3} 
+ Lm={(L0-L1)/3}
****************************************
+ CE={C0} ; Line2earth capacitance also for uncoupled case
+ CLL={(C1-C0)/3} ; Line2Line capacitance
****************************************
+ g=1e12
.param R1x={R1*length}
.param R0x={R0*length}
.param Z1c=sqrt(L1/(C1*CL))
.param Z0c=sqrt(L0/(C0*CL))
.param Z1=Z1c+R1x/4
.param Z0=Z0c+R0x/4
.param tau1=length*sqrt(L1*C1*CL)
.param tau0=length*sqrt(L0*C0*CL)
.param h1=(Z1c-R1x/4)/Z1
.param h0=(Z0c-R0x/4)/Z0
EB3 L1 0 Value={v(1a)*0.577+v(2a)*0.577+v(3a)*0.577} 
EB4 L2 0 Value={v(1a)*0.707-v(2a)*0.707}
EB5 L3 0 Value={v(1a)*0.408+v(2a)*0.408-v(3a)*0.816} 
GB6 0 1a Value={I(EB3)*0.577+I(EB4)*0.707+I(EB5)*0.408} 
GB7 0 2a Value={I(EB3)*0.577-I(EB4)*0.707+I(EB5)*0.408} 
GB8 0 3a Value={I(EB3)*0.577-I(EB5)*0.816} 
EB9 L4 0 Value={v(1b)*0.577+v(2b)*0.577+v(3b)*0.577} 
EB10 L5 0 Value={v(1b)*0.707-v(2b)*0.707} 
EB11 L6 0 Value={v(1b)*0.408+v(2b)*0.408-v(3b)*0.816} 
GB12 0 1b Value={I(EB9)*0.577+I(EB10)*0.707+I(EB11)*0.408} 
GB13 0 2b Value={I(EB9)*0.577-I(EB10)*0.707+I(EB11)*0.408} 
GB14 0 3b Value={I(EB9)*0.577-I(EB11)*0.816} 
GBs0 0 L1 Value={((1+h0)/2)*((1+h0)/Z0*delay(v(L4),tau0)-h0*delay(i(GBr0),tau0))+((1-h0)/2)*((1+h0)/Z0*delay(v(L1),tau0)-h0*delay(i(GBs0),tau0))}
GBr0 0 L4 Value={((1+h0)/2)*((1+h0)/Z0*delay(v(L1),tau0)-h0*delay(i(GBs0),tau0))+((1-h0)/2)*((1+h0)/Z0*delay(v(L4),tau0)-h0*delay(i(GBr0),tau0))}
GBs1 0 L2 Value={((1+h1)/2)*((1+h1)/Z1*delay(v(L5),tau1)-h1*delay(i(GBr1),tau1))+((1-h1)/2)*((1+h1)/Z1*delay(v(L2),tau1)-h1*delay(i(GBs1),tau1))}
GBr1 0 L5 Value={((1+h1)/2)*((1+h1)/Z1*delay(v(L2),tau1)-h1*delay(i(GBs1),tau1))+((1-h1)/2)*((1+h1)/Z1*delay(v(L5),tau1)-h1*delay(i(GBr1),tau1))}
GBs2 0 L3 Value={((1+h1)/2)*((1+h1)/Z1*delay(v(L6),tau1)-h1*delay(i(GBr2),tau1))+((1-h1)/2)*((1+h1)/Z1*delay(v(L3),tau1)-h1*delay(i(GBs2),tau1))}
GBr2 0 L6 Value={((1+h1)/2)*((1+h1)/Z1*delay(v(L3),tau1)-h1*delay(i(GBs2),tau1))+((1-h1)/2)*((1+h1)/Z1*delay(v(L6),tau1)-h1*delay(i(GBr2),tau1))}
R1 L1 0 {Z0}
R2 L2 0 {Z1}
R3 L3 0 {Z1}
R13 L4 0 {Z0}
R14 L5 0 {Z1}
R15 L6 0 {Z1}
Rgnd1 1a 0 {g}
Rgnd2 2a 0 {g}
Rgnd3 3a 0 {g}
Rgnd4 1b 0 {g}
Rgnd5 2b 0 {g}
Rgnd6 3b 0 {g}
*******************************
.ENDS
*
*