+	N1=1000
+	uR=0.04
+	uX=0.08
+	i0=0.05
+	p0=0.005
Rctrl ctrl 0 1e12
Xu	1U	1N	2WU	2N	2UV	2U	ctrl Trafo_N1N2_simple_ctrl_Yzn2
+ PARAMS:
+ SN={SN/3}
+ U1N={U1Nenn/sqrt(3)}
+ U20={U20/3}
+ U30={U20/3}
+ fN={fN}
+ N1={N1}
+ uR={uR*1.2}
+ uX={uX*1.2}
+ i0={i0}
+ p0={p0}
Xv	1V	1N	2UV	2N	2VW	2V	ctrl Trafo_N1N2_simple_ctrl_Yzn2
+ PARAMS:
+ SN={SN/3}
+ U1N={U1Nenn/sqrt(3)}
+ U20={U20/3}
+ U30={U20/3}
+ fN={fN}
+ N1={N1}
+ uR={uR*1.2}
+ uX={uX*1.2}
+ i0={i0}
+ p0={p0}
Xw	1W	1N	2VW	2N	2WU	2W	ctrl Trafo_N1N2_simple_ctrl_Yzn2
+ PARAMS:
+ SN={SN/3}
+ U1N={U1Nenn/sqrt(3)}
+ U20={U20/3}
+ U30={U20/3}
+ fN={fN}
+ N1={N1}
+ uR={uR*1.2}
+ uX={uX*1.2}
+ i0={i0}
+ p0={p0}
RGND1U 1U 0 1e12
RGND1V 1V 0 1e12
RGND1W 1W 0 1e12
RGND2U 2U 0 1e12
RGND2V 2V 0 1e12
RGND2W 2W 0 1e12
RGND1N 1N 0 1e12
RGND2N 2N 0 1e12
.ENDS

.SUBCKT Trafo3YNzn5_ideal_ctrl  1U  1V  1W  1N  2U  2V  2W  2N ctrl
+	PARAMS:
+	U1Nenn=400V
+	U20=400V
+   k=1
.param N1={N1} N2={N1*U20/U1Nenn}
Rctrl ctrl 0 1e12
* YNzn5
* YNzn5
Xu1 1U	1N	2WU	2N  ctrl N1N2_ctrl_Yzn2 params: N1={N1*sqrt(3)} N2={N2} k={k}
Xu2 1U	1N	2UV	2U	ctrl N1N2_ctrl_Yzn2 params: N1={N1*sqrt(3)} N2={N2} k={k}
Xv1 1V	1N	2UV	2N	ctrl N1N2_ctrl_Yzn2 params: N1={N1*sqrt(3)} N2={N2} k={k}
Xv2 1V	1N	2VW	2V  ctrl N1N2_ctrl_Yzn2  params: N1={N1*sqrt(3)} N2={N2} k={k}
Xw1 1W	1N	2VW	2N	ctrl N1N2_ctrl_Yzn2 params: N1={N1*sqrt(3)} N2={N2} k={k}
Xw2 1W	1N	2WU	2W  ctrl N1N2_ctrl_Yzn2 params: N1={N1*sqrt(3)} N2={N2} k={k}
* YNzn11
*Xu1 1U	1N	2N	2WU	ctrl N1N2_ctrl_Yzn2 params: N1={N1*sqrt(3)} N2={N2} k={k}
*Xu2 1U	1N	2U  2UV ctrl N1N2_ctrl_Yzn2 params: N1={N1*sqrt(3)} N2={N2} k={k}
*Xv1 1V	1N	2N	2UV	ctrl N1N2_ctrl_Yzn2 params: N1={N1*sqrt(3)} N2={N2} k={k}
*Xv2 1V	1N	2V  2VW ctrl N1N2_ctrl_Yzn2 params: N1={N1*sqrt(3)} N2={N2} k={k}
*Xw1 1W	1N	2N	2VW	ctrl N1N2_ctrl_Yzn2 params: N1={N1*sqrt(3)} N2={N2} k={k}
*Xw2 1W	1N	2W  2WU ctrl N1N2_ctrl_Yzn2 params: N1={N1*sqrt(3)} N2={N2} k={k}
RGND1U 1U 0 1e12
RGND1V 1V 0 1e12
RGND1W 1W 0 1e12
RGND2U 2U 0 1e12
RGND2V 2V 0 1e12
RGND2W 2W 0 1e12
RGND1N 1N 0 1e12
RGND2N 2N 0 1e12
.ENDS

