* My special thank to Emer. Prof. Dr. Otto Justus who
* allowed me to use his models of transformer and synchronous generator

.SUBCKT Trafo3YNzn5_ctrl  1U  1V  1W  1N  2U  2V  2W 2N ctrl
+	PARAMS:
+	SN=10kVA
+	U1Nenn=400V
+	U20=400V
+	fn={fn1}
+	N1=1000
+	uR=0.04
+	uX=0.08
+	i0=0.05
+	p0=0.005
+   a=0.75
+   m=9
+   psi_0=0
+   psir=1
+   psis=-0.5
+   psit=-0.5
+   tpsi0=1000s
+   tpsid=0.1ms
+   ron=0.00001
+   rkessel=6e5 ;magn. resistance of the kettle filled with oil / reduce it for an effect (e.g. 1e6)
Rctrl ctrl 0 1e12
Xu	1U	1N	2WU	2N	2UV	2U	magn1	magn2 ctrl Trafoschenkel3_ctrl_Yzn
+ PARAMS:
+ SN={SN/3}
+ U1N={U1Nenn/sqrt(3)}
+ U20={U20/3}
+ U30={U20/3}
+ fN={fN}
+ N1={N1}
+ uR={uR*1.2}
+ uX={uX*1.2}
+ i0={i0}
+ p0={p0}
+ a={a}
+ m={m}
+ psi_0={psir*psi_0}
+ tpsi0={tpsi0}
+ tpsid={tpsid}
+ ron={ron}
Xv	1V	1N	2UV	2N	2VW	2V	magn1	magn2 ctrl Trafoschenkel3_ctrl_Yzn
+ PARAMS:
+ SN={SN/3}
+ U1N={U1Nenn/sqrt(3)}
+ U20={U20/3}
+ U30={U20/3}
+ fN={fN}
+ N1={N1}
+ uR={uR*1.2}
+ uX={uX*1.2}
+ i0={i0}
+ p0={p0}
+ a={a}
+ m={m}
+ psi_0={psis*psi_0}
+ tpsi0={tpsi0}
+ tpsid={tpsid}
+ ron={ron}
Xw	1W	1N	2VW	2N	2WU	2W	magn1	magn2 ctrl Trafoschenkel3_ctrl_Yzn
+ PARAMS:
+ SN={SN/3}
+ U1N={U1Nenn/sqrt(3)}
+ U20={U20/3}
+ U30={U20/3}
+ fN={fN}
+ N1={N1}
+ uR={uR*1.2}
+ uX={uX*1.2}
+ i0={i0}
+ p0={p0}
+ a={a} ; FS
+ m={m} ; FS
+ psi_0={psit*psi_0}
+ tpsi0={tpsi0}
+ tpsid={tpsid}
+ ron={ron}
*Rm	magn1	0	1MEG
Rkessel magn1 magn2 {rkessel}
RGND1U 1U 0 1e12
RGND1V 1V 0 1e12
RGND1W 1W 0 1e12
RGND2U 2U 0 1e12
RGND2V 2V 0 1e12
RGND2W 2W 0 1e12
RGND1N 1N 0 1e12
RGND2N 2N 0 1e12
.ENDS

.SUBCKT Trafo3YNzn5_simple_ctrl  1U  1V  1W  1N  2U  2V  2W 2N ctrl
+	PARAMS:
+	SN=10kVA
+	U1Nenn=400V
+	U20=400V
