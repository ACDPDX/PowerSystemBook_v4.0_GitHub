.SUBCKT   Trafoschenkel3_ctrl_Yzn  1_1 1_2  2_1 2_2  3_1 3_2 magnP1 magnP2 ctrl
+	PARAMS:
+	SN=100kVA
+	U1N=5773V
+	U20=133.3V
+	U30=133.3V
+	fn={fn1}
+	N1=1000
+	uR=0.02
+	uX=0.04
+	i0=0.025
+	p0=0.003
+   a={0.3} ; FS
+   m={7} ; FS
+   psi_0=0 ; Remanenzparameter zwischen 0,1,-1
+   tpsi0=1000s ; Remanenzzeitpunkt
+   tpsid=0.1ms  ; Dauer des Schalter ein für Remanenz
+   ron=0.00001 ; ron - Parameter des Schalters für Remanenz (siehe sub WICKLUNG_Yzn2)
.PARAM
+	I1N={SN/U1N}
+	Z1N={U1N/I1N}
+	omegaN={(2*pi)*fN}
+	R1={Z1N*uR/2}
+	L1s={Z1N*uX/2/omegaN}
+	RFe={U1N*U1N/(p0*SN)}
+	N2={N1*U20/U1N}
+	N3={N1*U30/U1N}
+	R2={R1*N2/N1*N2/N1}
+	R3={R1*N3/N1*N3/N1}
+   Xh={(U1N*U1N)/(SN*sqrt(i0*i0-p0*p0))} ;FS
+   iu={U1N/Xh} ;FS
+   ImyN={sqrt(2)*iu} ;FS
+	phiN={sqrt(2)*U1N/omegaN/N1}
*	Wicklungsstroeme
Gi1	1_1	1_2	VALUE={v(a,magnP1)/(N1*v(ctrl))} tripdv={tdv} tripdt={tdt}
Rpi1	1_1	1_2	1000MEG
Gi2	2_1	2_2	VALUE={v(b,a)/(N2)} tripdv={tdv} tripdt={tdt}
Rpi2	2_1	2_2	1000MEG
Gi3	3_1	3_2	VALUE={v(c,b)/(N3)} tripdv={tdv} tripdt={tdt}
Rpi3	3_1	3_2	1000MEG
*	Wicklungen
X_W1	magnP1	a	1_1	1_2	ctrl WICKLUNG_ctrl_Yzn2
+PARAMS:  R={R1}  N={N1}  Rphis={0.7*N1*N1/L1s} Psi_0={Psi_0*phiN} tpsi0={tpsi0} tpsid={tpsid} ron={ron}
X_W2	a   b    2_1	2_2	WICKLUNG_Yzn2 ; leakage low at z-winding
+PARAMS:  R={R2}  N={N2}  Rphis={3*N1*N1/L1s} Psi_0={Psi_0*phiN} tpsi0={tpsi0} tpsid={tpsid} ron={ron}
X_W3	b   c    3_1	3_2	WICKLUNG_Yzn2 ; leakage low at z-winding
+PARAMS:  R={R3}  N={N3}  Rphis={3*N1*N1/L1s} Psi_0={Psi_0*phiN} tpsi0={tpsi0} tpsid={tpsid} ron={ron}
*	EisenSchenkel
X_SCH	c	magnP2	ctrl SCHENKEL_Yzn2   PARAMS:
+	N={N1}  RFe={RFe}  ImyN={ImyN}
+	phiN={phiN}	a={a}   m={m}
.ENDS
***	Ende des SUBCIRCUITS Trafoschenkel3


.SUBCKT SCHENKEL_Yzn2  m1  m2  ctrl
+PARAMS:   N=1  RFe=1  ImyN=1  a=1  phiN=1 m=9
LRFe	m1	mh	flux={x*((N*N*v(ctrl)*v(ctrl))/RFe)} Rser={0.001m*N*N/RFe}  ; Rser=parasitic value for better convergence  
vphi	mh	mh1	0
rphi    mh  0 1e12 
Eimy	mh1	m2
+VALUE={N*imyN*(a*i(vphi)/phiN+(1-a)*PWRS(i(vphi)/phiN,m))} tripdv={tdv} tripdt={tdt}
.ENDS ;  SCHENKEL_Yzn2

.SUBCKT WICKLUNG_ctrl_Yzn2  ma  mb  ea  eb ctrl
+PARAMS:   R=1   N=1    Rphis=1 psi_0=0 tpsi0=1000ms tpsid=0.1ms ron=0.00001 ;passt für 1ms Schaltzeit bei C mit 1Coulomb
Gphi	ma	mb	VALUE={v(phi)} tripdv={tdv} tripdt={tdt}
Gphis	ma	mb	VALUE={v(ma,mb)/(Rphis*v(ctrl)*v(ctrl))} tripdv={tdv} tripdt={tdt}
Gp	0	phi	VALUE={(v(ea,eb)-R*v(ctrl)*v(mb,ma)/(N*v(ctrl)))/(N*v(ctrl))} tripdv={tdv} tripdt={tdt}
Cp phi 0 1 IC=0
Vctrl sctrl 0 pwl 0s 0v {tpsi0+1p} 0v {tpsi0+tpsid+2p} 1V {tpsi0+2*tpsid+3p} 1v {tpsi0+3*tpsid+4p} 0v
S1 phi phix sctrl 0 MS1
.model MS1 SW(Ron={Ron} Roff=1e9 Vt=0.9 Vh=0.0 Lser=0 Vser=0)
E1 phix 0 value={psi_0} tripdv={tdv} tripdt={tdt} ; das ist die Spannungsquelle mit psi_0 der den Kondensator Cp auflädt !!!
Rp	phi	0	1000MEG
.ENDS ;  WICKLUNG_Yzn2

.SUBCKT WICKLUNG_Yzn2  ma  mb  ea  eb
+PARAMS:   R=1   N=1    Rphis=1 psi_0=0 tpsi0=1000s tpsid=0.1ms ron=0.00001 ;passt für 1ms Schaltzeit bei C mit 1Coulomb
Gphi	ma	mb	VALUE={v(phi)} tripdv={tdv} tripdt={tdt}
Rphis	ma	mb	{Rphis}
Gp	0	phi	VALUE={(v(ea,eb)-R*v(mb,ma)/(N))/(N)} tripdv={tdv} tripdt={tdt}
Cp phi 0 1 IC=0
Vctrl ctrl 0 pwl 0s 0v {tpsi0+1p} 0v {tpsi0+tpsid+2p} 1V {tpsi0+2*tpsid+3p} 1v {tpsi0+3*tpsid+4p} 0v
S1 phi phix ctrl 0 MS1
.model MS1 SW(Ron={Ron} Roff=1e9 Vt=0.9 Vh=0.0 Lser=0 Vser=0)
E1 phix 0 value={psi_0} tripdv={tdv} tripdt={tdt} ; das ist die Spannungsquelle mit psi_0 der den Kondensator Cp auflädt !!!
Rp	phi	0	1000MEG
.ENDS ;  WICKLUNG_Yzn2

.subckt Trafo_N1N2_simple_ctrl_Yzn2 p1  p2  s3  s4  s5  s6 ctrl
+	PARAMS:
+	SN=1kVA
+	U1N=230V
+	U20=230V
+ U30=230V
+	fn={fn1}
+	N1=1000
+	uR=0.04
+	uX=0.08
+	i0=0.05
+	p0=0.005
.PARAM
+	I1N={SN/U1N}
+	Z1N={U1N/I1N}
+	omegaN={(2*pi)*fN}
+	R1={Z1N*uR/2}
+	L1s={Z1N*uX/2/omegaN}
+	RFe={U1N*U1N/(p0*SN)}
+	N2={N1*U20/U1N}
+ N3={N1*U30/U1N}
+	R2={R1*N2/N1*N2/N1}
+ R3={R1*N3/N1*N3/N1}
+ Xh={(U1N*U1N)/(SN*sqrt(i0*i0-p0*p0))} ;FS
+ iu={U1N/Xh} ;FS
+ ImyN={sqrt(2)*iu} ;FS
+	phiN={sqrt(2)*U1N/omegaN/N1}
Rcup  p1 x12 {R1}
L1p    x12 p11 flux={L1s*x} rser=0
Rfe1   p11 p2 {RFe}
LXh p11 p2 flux={Xh/omegaN*x*v(ctrl)*v(ctrl)} rser=0
Rcus1   s33  s32 {R2}
L1s1   s32 s3 flux={L1s*x*N2/(N1)*N2/(N1)} rser=0
Rcus2  s55 s54 {R3}
L1s2   s54 s5 flux={L1s*x*N3/(N1)*N3/(N1)} rser=0
X_w1	p11 p2  s33  s4  ctrl  N1N2_ctrl_Yzn2 params: N1={N1} N2={N2}
X_w2  p11 p2  s55  s6  ctrl  N1N2_ctrl_Yzn2 params: N1={N1} N2={N3}
.ends



* ctrl node in verhältniseinheit
* UE/UEN=1+stproz/100 (0.9 .. 1 .. 1.2)
.subckt N1N2_ctrl_Yzn2 in1 in2 out1 out2 ctrl
+params: proz=1 k=1 N1=1 N2=1
.param ue={N1/N2}
G1 0 M in1 in2 1
G2 0 M VALUE={-k*((v(out1)-v(out2))*ue*v(ctrl))} tripdv={tdv} tripdt={tdt}
G3 in1 in2 M 0 1
G4 out1 out2 VALUE={-k*((v(m))*ue*v(ctrl))} tripdv={tdv} tripdt={tdt}
Rl ctrl 0 1e12
R2 M 0 1e10
Rin1 in1 0 1e12
Rin2 in2 0 1e12
Rout1 out1 0 1e12
Rout2 out2 0 1e12
.ends

