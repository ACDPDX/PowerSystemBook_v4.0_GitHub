**************************************************

Eout1 M1out 0 VALUE={-0.4170*V(Aout1)+0.8076*V(Bout1)-0.4170*V(Cout1)} tripdv=1 tripdt=1
Eout2 M2out 0 VALUE={-0.7071*V(Aout1)+0.0000*V(Bout1)+0.7071*V(Cout1)} tripdv=1 tripdt=1
Eout3 M3out 0 VALUE={+0.5711*V(Aout1)+0.5897*V(Bout1)+0.5711*V(Cout1)} tripdv=1 tripdt=1

**************************************************
