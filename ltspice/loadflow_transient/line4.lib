.subckt TEST AIN BIN CIN AOUT BOUT COUT params: length=1
* ============================================================
* 3PH - 3Phase full transposed FULL MODAL LTspice MODEL (CONSISTENT)
* Includes bidirectional E + G transformation at BOTH ends
* ============================================================

RAIN AIN AIN1 {0.156*l/2}
RBIN BIN BIN1 {0.156*l/2}
RCIN CIN CIN1 {0.156*l/2}


RAOUT AOUT1 AOUT {0.156*l/2}
RBOUT BOUT1 BOUT {0.156*l/2}
RCOUT COUT1 COUT {0.156*l/2}

  
V1 m1in1 m1in 0
V2 m2in1 m2in 0
V3 m3in1 m3in 0

 
V4 m1out1 m1out 0
V5 m2out1 m2out 0
V6 m3out1 m3out 0

* T-Lines, TD's Z's E,G Lines all from Matlab .m file!

******************************************
* Paste following lines from matlab file
******************************************
 
.param l={length}

.param TD1=   9.168us
.param TD2=   8.910us
.param TD3=   8.002us

.param Z1=    27.2Ohm
.param Z2=    26.4Ohm
.param Z3=    23.7Ohm

T1 m1in 0 m1out1 0 Z0=   27.2 TD={9.1682us*l}
T2 m2in 0 m2out1 0 Z0=   26.4 TD={8.9105us*l}
T3 m3in 0 m3out1 0 Z0=   23.7 TD={8.0021us*l}


**************************************************
* INPUT E SOURCES (Phase -> Mode) Vmode=inv(T)*Vphase
**************************************************

Ein1 M1in1 0 VALUE={-0.4170*V(Ain1)+0.8076*V(Bin1)-0.4170*V(Cin1)} tripdv=1 tripdt=1
Ein2 M2in1 0 VALUE={-0.7071*V(Ain1)+0.0000*V(Bin1)+0.7071*V(Cin1)} tripdv=1 tripdt=1
Ein3 M3in1 0 VALUE={+0.5711*V(Ain1)+0.5897*V(Bin1)+0.5711*V(Cin1)} tripdv=1 tripdt=1

**************************************************
