R2b 2b0 2b 1e-10
R3a 3a 3a0 1e-10
R3b 3b0 3b 1e-10
*********************************
E1a 1a0 1ay VALUE={length/2*(Rnn*I(E1a)+Rmn*I(E2a)+Rmn*I(E3a))+length/2/omega*(XL11*DDT(I(E1a))+XM12*DDT(I(E2a))+XM13*DDT(I(E3a)))} tripdv={tdv} tripdt={tdt}
E2a 2a0 2ay VALUE={length/2*(Rmn*I(E1a)+Rnn*I(E2a)+Rmn*I(E3a))+length/2/omega*(XM12*DDT(I(E1a))+XL22*DDT(I(E2a))+XM23*DDT(I(E3a)))} tripdv={tdv} tripdt={tdt}
E3a 3a0 3ay VALUE={length/2*(Rmn*I(E1a)+Rmn*I(E2a)+Rnn*I(E3a))+length/2/omega*(XM13*DDT(I(E1a))+XM23*DDT(I(E2a))+XL33*DDT(I(E3a)))} tripdv={tdv} tripdt={tdt}
*********************************
