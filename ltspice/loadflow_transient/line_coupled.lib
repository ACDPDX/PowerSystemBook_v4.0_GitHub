V3 3a 3ax 0 rser=1e-15
V4 4a 4ax 0 rser=1e-15
*
E1 1ax 1bx VALUE={length/2*(Rnn*I(V1)+Rmn*I(V2)+Rmn*I(V3)+Rmn*I(V4))+length/2/omega*(XL11*DDT(I(V1))+XM12*DDT(I(V2))+XM13*DDT(I(V3))+XM14*DDT(I(V4)))} tripdv={tdv} tripdt={tdt}
E2 2ax 2bx VALUE={length/2*(Rmn*I(V1)+Rnn*I(V2)+Rmn*I(V3)+Rmn*I(V4))+length/2/omega*(XM12*DDT(I(V1))+XL22*DDT(I(V2))+XM23*DDT(I(V3))+XM24*DDT(I(V4)))} tripdv={tdv} tripdt={tdt}
E3 3ax 3bx VALUE={length/2*(Rmn*I(V1)+Rmn*I(V2)+Rnn*I(V3)+Rmn*I(V4))+length/2/omega*(XM13*DDT(I(V1))+XM23*DDT(I(V2))+XL33*DDT(I(V3))+XM34*DDT(I(V4)))} tripdv={tdv} tripdt={tdt}
E4 4ax 4bx VALUE={length/2*(Rmn*I(V1)+Rmn*I(V2)+Rmn*I(V3)+Rnn*I(V4))+length/2/omega*(XM14*DDT(I(V1))+XM24*DDT(I(V2))+XM34*DDT(I(V3))+XL44*DDT(I(V4)))} tripdv={tdv} tripdt={tdt}
*
