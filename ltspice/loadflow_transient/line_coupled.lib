+ XM13=1.157072E-01 XM23=1.597006E-01 XL33=4.925787E-01
+ Rnn=0.0615 ; diagonal resistance
+ Rmn=0.045 ; off diagonal mutual resistance mean value !!!
+ length=1
+ cl=1
+ g=1e12
+ fn_ref=60
.PARAM
+ omega={fn_ref*2*3.14159}
*********************************
+ L11={XL11/omega} M12={XM12/omega} M13={XM13/omega}
