* Line_coupled
* The input data matrices are computed in ATP/EMTP (via construction of overhead line masts)
* HINT: You can now (much simpler) also use the excel file for copy pasting the atp-matrix  to excel file than to line_coupled.lib file:
* ATP_cables_and_lines.xlsx in folder ..\ltspice\loadflow_transient_examples\ATP_EMTP_OverheadLines_Models and ATP_EMTP_cable_models
*
* The matrix values of ATP are always normalized to 1km !!!
* ===================================================================
* two systems:
* 11
* 12 22
* 13 23 33
* 14 24 34 44
* 15 25 35 45 55
* 16 26 36 46 56 66
* one system:
* 11
* 12 22
* 13 23 33
*************************************************************************
* The capacitances are left and right of the line (each divided by two)
* The inductances and resistances are divided by three and incorporated along the line
* so the line does not end with capacitances which can lead to very high currents
* With the length parameter the line can be divided in smaller units (chain ladder,Kettenleiter)
*************************************************************************

*Einebenenmast  .... mast with horizontal conductor placement (1sys,2sys)
*Tonnenmast ........ mast with ton-form conductor placement (2sys)
*Donaumast ......... mast with triangle form conductor placement (2sys)
*Reversed Donaumast  mast with reversed triangle form conductor placement (2sys)
*Doppeltonnenmast .. mast with double tons conductor placement (4sys)
*Vertikalmast ...... mast with vertical conductor placement (2sys left and right)
*Portalmast ........ mast with horizontal conductor placement (no ground,always only one sys, directly at substation )
*Kombimast ......... mast with horizontal conductor placement below
*                     and with triangle conductor placement above (4sys,6sys)


**************************************
*two seperate one phase lines coupled
**************************************

.SUBCKT  Line_coupled_1ph 1a 2a 1b 2b
+ PARAMS:
+ R1=0.1 R2=0.1
+ L1=1m L2=1m k=0.5 ; k=M12/sqrt(L1*L2) oder k=XM12/sqrt(XL1*XL2)
+ C10=10n C20=10n C12=1p
+ length=1
+ cl=1  ;eventueller Multiplikator nur für Kapazitäten
+ g=1e12
**************************
R1a 1a 1ax  {0.333333*length*R1}
R1b 1ax 1ay {0.333333*length*R1}
R1c 1bx 1b  {0.333333*length*R1}
R2a 2a 2ax  {0.333333*length*R2}
R2b 2ax 2ay {0.333333*length*R2}
R2c 2bx 2b  {0.333333*length*R2}
**************************
L1 1ay 1bx {length*L1}
L2 2ay 2bx {length*L2}
k12 L1 L2 {k}
**************************
C10a 1ax 0 {cl*length*C10/2}
C10b 1bx 0 {cl*length*C10/2}
C20a 2ax 0 {cl*length*C20/2}
C20b 2bx 0 {cl*length*C20/2}
**************************
C12a 1ax 2ax {cl*length*C12/2}
C12b 1bx 2bx {cl*length*C12/2}
**************************
Rgnd1 1a 0 {g}
Rgnd2 2a 0 {g}
Rgnd4 1b 0 {g}
Rgnd5 2b 0 {g}
**************************
.ENDS

****************************
*two one phase lines coupled (Kettenleiter)
****************************

.SUBCKT  Line_coupled_1ph_10 1a 2a 1b 2b
+ PARAMS:
+ R1=0.1 R2=0.1
+ L1=1m L2=1m k=0.5
+ C10=10n C20=10n C12=1p
+ length=1
+ cl=1
+ g=1e12
**************************
X1 1a 2a p1 p2 Line_coupled_1ph params: R1={R1} L1={L1} L2={L2} k={k} C10={C10} C20={C20} C12={C12} length={0.1*length} cl={cl}
X2 p1 p2 p3 p4 Line_coupled_1ph params: R1={R1} L1={L1} L2={L2} k={k} C10={C10} C20={C20} C12={C12} length={0.1*length} cl={cl}
X3 p3 p4 p5 p6 Line_coupled_1ph params: R1={R1} L1={L1} L2={L2} k={k} C10={C10} C20={C20} C12={C12} length={0.1*length} cl={cl}
X4 p5  p6  p7 p8 Line_coupled_1ph params: R1={R1} L1={L1} L2={L2} k={k} C10={C10} C20={C20} C12={C12} length={0.1*length} cl={cl}
X5 p7 p8 p9 p10 Line_coupled_1ph params: R1={R1} L1={L1} L2={L2} k={k} C10={C10} C20={C20} C12={C12} length={0.1*length} cl={cl}
X6 p9 p10 p11 p12 Line_coupled_1ph params: R1={R1} L1={L1} L2={L2} k={k} C10={C10} C20={C20} C12={C12} length={0.1*length} cl={cl}
X7 p11 p12 p13 p14 Line_coupled_1ph params: R1={R1} L1={L1} L2={L2} k={k} C10={C10} C20={C20} C12={C12} length={0.1*length} cl={cl}
X8 p13 p14 p15 p16 Line_coupled_1ph params: R1={R1} L1={L1} L2={L2} k={k} C10={C10} C20={C20} C12={C12} length={0.1*length} cl={cl}
X9 p15 p16 p17 p18 Line_coupled_1ph params: R1={R1} L1={L1} L2={L2} k={k} C10={C10} C20={C20} C12={C12} length={0.1*length} cl={cl}
X10 p17 p18 1b  2b  Line_coupled_1ph params: R1={R1} L1={L1} L2={L2} k={k} C10={C10} C20={C20} C12={C12} length={0.1*length} cl={cl}
**************************
Rgnd1 1a 0 {g}
Rgnd2 2a 0 {g}
Rgnd4 1b 0 {g}
Rgnd5 2b 0 {g}
**************************
.ENDS

***************************************************
* coupled line with only inductive coupling.
* capacitive coupling have to be placed externally.
***************************************************

.SUBCKT  Line_coupled_1ph_var 1a 1ax 1bx 1b 2a 2ax 2bx 2b
+ PARAMS:
+ R1=0.1 R2=0.1
+ L1=1m L2=1m k=0.5
+ length=1
+ g=1e12
**************************
R1a 1a 1ax  {0.333333*length*R1}
R1b 1ax 1ay {0.333333*length*R1}
R1c 1bx 1b  {0.333333*length*R1}
R2a 2a 2ax  {0.333333*length*R2}
R2b 2ax 2ay {0.333333*length*R2}
R2c 2bx 2b  {0.333333*length*R2}
**************************
L1 1ay 1bx {length*L1}
L2 2ay 2bx {length*L2}
k12 L1 L2 {k}
**************************
Rgnd1 1a 0 {g}
Rgndx 2ax 0 {g}
Rgnd2 2a 0 {g}
Rgnd4 1b 0 {g}
Rgnd5 2b 0 {g}
**************************
.ENDS

* 2 conductors, d=10m, r=1cm, rho=100ohmmeter, delta=932m
.SUBCKT  2lines_coupledR  1a 2a  1b 2b
+ PARAMS:
****************************************
+ XL11=0.7351705 XL22=0.77351705  ; ATP-Z-Matrix
+ XM12=0.2855012
****************************************
+ C11=8.073967n C22=8.073967n   ; ATP-C-Matrix diagonal
+ C12=0.4050844n  ; ATP-C-Matrix offdiagonal
****************************************
+ length=1
+ cl=1
+ g=1e12
+ fn_ref=50
.PARAM
+ omega={fn_ref*2*3.14159}
+ Rnn=0.149054 Rmn=0.04876445
*********************************
+ C_10={C11-C12}
+ C_20={C22-C12}
*********************************
V1 1a 1ax 0 rser=1e-15
V2 2a 2ax 0 rser=1e-15
*
E1 1ax 1bx VALUE={length/2*(Rnn*I(V1)+Rmn*I(V2))+length/2/omega*(XL11*DDT(I(V1))+XM12*DDT(I(V2)))} tripdv={tdv} tripdt={tdt}
E2 2ax 2bx VALUE={length/2*(Rmn*I(V1)+Rnn*I(V2))+length/2/omega*(XM12*DDT(I(V1))+XL22*DDT(I(V2)))} tripdv={tdv} tripdt={tdt}
*
E11 1bx 1by VALUE={length/2*(Rnn*I(V11)+Rmn*I(V21))+length/2/omega*(XL11*DDT(I(V11))+XM12*DDT(I(V21)))} tripdv={tdv} tripdt={tdt}
E12 2bx 2by VALUE={length/2*(Rmn*I(V11)+Rnn*I(V21))+length/2/omega*(XM12*DDT(I(V11))+XL22*DDT(I(V21)))} tripdv={tdv} tripdt={tdt}
*
V11 1by 1b 0 rser=1e-15
V21 2by 2b 0 rser=1e-15
*
*******************************
C_10a 1bx 0 {cl*length*C_10}
C_20a 2bx 0 {cl*length*C_20}
*******************************
C12a 1bx 2bx {cl*length*C12}
*******************
Rgnd1 1a 0 {g}
Rgnd2 2a 0 {g}
Rgnd4 1b 0 {g}
Rgnd5 2b 0 {g}
*******************************
.ENDS

**************************
* one line, 3 phases coupled
**************************
*Coupled resistors of ATP-matrix not used!
*Resistor value of VERIFY command connected uncoupled
.SUBCKT  Line_coupled  1a 2a 3a 1b 2b 3b
+ PARAMS:
+ R1=0.1 R2=0.1 R3=0.1 ; per unit length 1km !!!
****************************************
+ XL11=1 XL22=1 XL33=1 ; ATP-Z-Matrix
+ XM12=0.5 XM13=0.4 XM23=0.5
****************************************
+ C11=10n C22=10n C33=10n  ; ATP-C-Matrix diagonal
+ C12=5n C13=5n C23=5n     ; ATP-C-Matrix offdiagonal
****************************************
+ length=1
+ cl=1
+ g=1e12
+ fn_ref=50
.PARAM
+ omega={fn_ref*2*3.14159}
*********************************
+ L11={XL11/omega} M12={XM12/omega} M13={XM13/omega}
+ L22={XL22/omega} M23={XM23/omega}
+ L33={XL33/omega}
*******************************************************************
* geschaetzte BetriebsInduktivität/Phase bei symm. Betrieb(1,a,a*a)
*******************************************************************
+ L1={L11-0.5*M12-0.5*M13} ;(not used)
+ L2={L22-0.5*M12-0.5*M23} ;(not used)
+ L3={L33-0.5*M13-0.5*M23} ;(not used)
*********************************
+ k12={M12/sqrt(L11*L22)}
+ k13={M13/sqrt(L11*L33)}
+ k23={M23/sqrt(L22*L33)}
*******************************
+ C_10={C11-C12-C13}
+ C_20={C22-C12-C23}
+ C_30={C33-C13-C23}
**** Ausgabe von XB1,2 ****
VXB1 XB1 0 {length*omega*(L1+L2+L3)/3} ;(not used)
RXB1 XB1 0 1e12
*********************************
R1a 1a 1ax {0.5*length*R1}
R1b 1bx 1b {0.5*length*R1}
R2a 2a 2ax {0.5*length*R2}
R2b 2bx 2b {0.5*length*R2}
R3a 3a 3ax {0.5*length*R3}
R3b 3bx 3b {0.5*length*R3}
*******************************
L1a 1ax 1ay {length*L11/2}
L2a 2ax 2ay {length*L22/2}
L3a 3ax 3ay {length*L33/2}
*******************************
L1b 1ay 1bx {length*L11/2}
L2b 2ay 2bx {length*L22/2}
L3b 3ay 3bx {length*L33/2}
*******************************
k12a L1a L2a {k12}
k13a L1a L3a {k13}
k23a L2a L3a {k23}
*******************************
k12b L1b L2b {k12}
k13b L1b L3b {k13}
k23b L2b L3b {k23}
*******************************
C_10a 1ay 0 {cl*length*C_10}
C_20a 2ay 0 {cl*length*C_20}
C_30a 3ay 0 {cl*length*C_30}
*******************************
C12a 1ay 2ay {cl*length*C12}
C13a 1ay 3ay {cl*length*C13}
C23a 2ay 3ay {cl*length*C23}
*******************************
Rgnd1 1a 0 {g}
Rgnd2 2a 0 {g}
Rgnd3 3a 0 {g}
Rgnd4 1b 0 {g}
Rgnd5 2b 0 {g}
Rgnd6 3b 0 {g}
*******************************
.ENDS


***************************************************************************
* another model of a three phase coupled line with symmetric case default
* mutual resistance added
***************************
.SUBCKT  Line_coupled_2  1a 2a 3a 1b 2b 3b
+ PARAMS:
****************************************
* This parameter are for the symmetric case (fully transposed lines)
+ Lm={0.4307/314.159} L={0.7357/314.159} Rm=0.0482 R=0.149
+ Cb=10nf Ce=6nf
****************************************
+ length=1
+ cl=1
+ g=1e12
+ fn_ref=50
.param omega={fn_ref*2*3.14159}
* Change this paramter if you have a assymetric case
.param Lm12={Lm} Lm13={Lm} Lm23={Lm}
.param R1={R} R2={R} R3={R}
.param L1={L} L2={L} L3={L}
.param Cll={(Cb-Ce)/3}
.param Ce1a={Ce} Ce2a={Ce} Ce3a={Ce} Ce1b={Ce} Ce2b={Ce} Ce3b={Ce}
.param Cl12a={Cll} Cl23a={Cll} Cl13a={Cll} Cl12b={Cll} Cl23b={Cll} Cl13b={Cll}
* Resistors and inductors (also mutual resistance)
Rser1 1a 1ax 1u
Rser2 2a 2ax 1u
Rser3 3a 3ax 1u
EI1 1ax 1b value={R1*length*i(ei1)+Rm*length*i(ei2)+Rm*length*i(ei3)+L1*length*DDT(i(ei1))+Lm12*length*DDT(i(ei2))+Lm13*length*DDT(i(ei3))} tripdv={tdv} tripdt={tdt}
EI2 2ax 2b value={Rm*length*i(ei1)+R2*length*i(ei2)+Rm*length*i(ei3)+Lm12*length*DDT(i(ei1))+L2*length*DDT(i(ei2))+Lm23*length*DDT(i(ei3))} tripdv={tdv} tripdt={tdt}
EI3 3ax 3b value={Rm*length*i(ei1)+Rm*length*i(ei2)+R3*length*i(ei3)+Lm13*length*DDT(i(ei1))+Lm23*length*DDT(i(ei2))+L3*length*DDT(i(ei3))} tripdv={tdv} tripdt={tdt}
* Capacitances
C1 1a 2a {cl*length*CL12a}
C2 2a 3a {cl*length*CL23a}
C3 3a 1a {cl*length*CL13a}
C4 1b 2b {cl*length*CL12b}
C5 2b 3b {cl*length*CL23b}
C6 3b 1b {cl*length*CL13b}
C7 3a 0 {cl*length*CE3a}
C8 2a 0 {cl*length*CE2a}
C9 1a 0 {cl*length*CE1a}
C10 3b 0 {cl*length*CE3b}
C11 2b 0 {cl*length*CE2b}
C12 1b 0 {cl*length*CE1b}
Rgnd1 1a 0 {g}
Rgnd2 2a 0 {g}
Rgnd3 3a 0 {g}
Rgnd4 1b 0 {g}
Rgnd5 2b 0 {g}
Rgnd6 3b 0 {g}
.ENDS


***************************************************************************
* another model of a three phase coupled line system with 2 (transposed) lines
* mutual resistance added
* Due to transposing lower amount of parameters used
* 400kV Donaumast 2sys 3x635/117 Stalu 1x234/47 Grounding
* See atp file: Donaumast__2sys_400kV_3x635.acp
***************************
* L
* lm1 L
* lm1 lm1 L
* lm2 lm2 lm2 L
* lm2 lm2 lm2 lm1 L
* lm2 lm2 lm2 lm1 lm1 L
***************************
* R
* rm R
* rm rm R
* rm rm rm R
* rm rm rm rm R
* rm rm rm rm rm R
***************************
* Ce
* cl1 Ce
* cl1 cl1 Ce
* cl2 cl2 cl2 Ce
* cl2 cl2 cl2 cl1 Ce
* cl2 cl2 cl2 cl1 cl1 Ce
***************************
.SUBCKT  Line_2_coupled_transposed  1a 2a 3a 4a 5a 6a 1b 2b 3b 4b 5b 6b
****************************************
* Only few parameters for the symmetric case (fully transposed lines)
****************************************
+ PARAMS:
****************************************
* Only few parameters for the symmetric case (fully transposed lines)
+ Lm1=7.038e-4 Lm2=5.5023e-4 Lm3=5.779e-4 Ls=1.5338e-3 Rs=0.05 Rm=0.0358
* if only Lm2 used: Lm2=5.595e-04 Lm3=5.595e-04
* if Lm3 used: Lm2=5.5023e-4 Lm3=5.779e-4
+ CL1=2.3356n CL2=0.627n CL3=1.0356n CE=4.577n
* if only CL2 used: CL2=0.763n CL3=0.763n
* if cl3 used: CL2=0.627n and CL3=1.0356n
****************************************
+ length=1
+ cl=1
+ g=1e12
+ fn_ref=50
+ k1={LM1/sqrt(Ls*Ls)}
+ k2={LM2/sqrt(Ls*Ls)}
+ k3={LM3/sqrt(Ls*Ls)}
.param Rs1={Rs/2*length} Rm1={Rm/2*length}
****************************************************************************************************************
* left side
****************************************************************************************************************
G1a i1a 0 value={v(1a,1ax)-Rs1*v(i1a)-Rm1*v(i2a)-Rm1*v(i3a)-Rm1*v(i4a)-Rm1*v(i5a)-Rm1*v(i6a)} tripdv={tdv} tripdt={tdt}
G2a i2a 0 value={v(2a,2ax)-Rm1*v(i1a)-Rs1*v(i2a)-Rm1*v(i3a)-Rm1*v(i4a)-Rm1*v(i5a)-Rm1*v(i6a)} tripdv={tdv} tripdt={tdt}
G3a i3a 0 value={v(3a,3ax)-Rm1*v(i1a)-Rm1*v(i2a)-Rs1*v(i3a)-Rm1*v(i4a)-Rm1*v(i5a)-Rm1*v(i6a)} tripdv={tdv} tripdt={tdt}
G4a i4a 0 value={v(4a,4ax)-Rm1*v(i1a)-Rm1*v(i2a)-Rm1*v(i3a)-Rs1*v(i4a)-Rm1*v(i5a)-Rm1*v(i6a)} tripdv={tdv} tripdt={tdt}
G5a i5a 0 value={v(5a,5ax)-Rm1*v(i1a)-Rm1*v(i2a)-Rm1*v(i3a)-Rm1*v(i4a)-Rs1*v(i5a)-Rm1*v(i6a)} tripdv={tdv} tripdt={tdt}
G6a i6a 0 value={v(6a,6ax)-Rm1*v(i1a)-Rm1*v(i2a)-Rm1*v(i3a)-Rm1*v(i4a)-Rm1*v(i5a)-Rs1*v(i6a)} tripdv={tdv} tripdt={tdt}
RG1a i1a 0 1e9
RG2a i2a 0 1e9
RG3a i3a 0 1e9
RG4a i4a 0 1e9
RG5a i5a 0 1e9
RG6a i6a 0 1e9
Gi1a 1a 1ax value={v(i1a)} tripdv={tdv} tripdt={tdt}
Gi2a 2a 2ax value={v(i2a)} tripdv={tdv} tripdt={tdt}
Gi3a 3a 3ax value={v(i3a)} tripdv={tdv} tripdt={tdt}
Gi4a 4a 4ax value={v(i4a)} tripdv={tdv} tripdt={tdt}
Gi5a 5a 5ax value={v(i5a)} tripdv={tdv} tripdt={tdt}
Gi6a 6a 6ax value={v(i6a)} tripdv={tdv} tripdt={tdt}
****************************************************************************************************************
* right side
****************************************************************************************************************
G1b i1b 0 value={v(1b,1bx)-Rs1*v(i1b)-Rm1*v(i2b)-Rm1*v(i3b)-Rm1*v(i4b)-Rm1*v(i5b)-Rm1*v(i6b)} tripdv={tdv} tripdt={tdt}
G2b i2b 0 value={v(2b,2bx)-Rm1*v(i1b)-Rs1*v(i2b)-Rm1*v(i3b)-Rm1*v(i4b)-Rm1*v(i5b)-Rm1*v(i6b)} tripdv={tdv} tripdt={tdt}
G3b i3b 0 value={v(3b,3bx)-Rm1*v(i1b)-Rm1*v(i2b)-Rs1*v(i3b)-Rm1*v(i4b)-Rm1*v(i5b)-Rm1*v(i6b)} tripdv={tdv} tripdt={tdt}
G4b i4b 0 value={v(4b,4bx)-Rm1*v(i1b)-Rm1*v(i2b)-Rm1*v(i3b)-Rs1*v(i4b)-Rm1*v(i5b)-Rm1*v(i6b)} tripdv={tdv} tripdt={tdt}
G5b i5b 0 value={v(5b,5bx)-Rm1*v(i1b)-Rm1*v(i2b)-Rm1*v(i3b)-Rm1*v(i4b)-Rs1*v(i5b)-Rm1*v(i6b)} tripdv={tdv} tripdt={tdt}
G6b i6b 0 value={v(6b,6bx)-Rm1*v(i1b)-Rm1*v(i2b)-Rm1*v(i3b)-Rm1*v(i4b)-Rm1*v(i5b)-Rs1*v(i6b)} tripdv={tdv} tripdt={tdt}
RG1b i1b 0 1e9
RG2b i2b 0 1e9
RG3b i3b 0 1e9
RG4b i4b 0 1e9
RG5b i5b 0 1e9
RG6b i6b 0 1e9
Gi1b 1b 1bx value={v(i1b)} tripdv={tdv} tripdt={tdt}
Gi2b 2b 2bx value={v(i2b)} tripdv={tdv} tripdt={tdt}
Gi3b 3b 3bx value={v(i3b)} tripdv={tdv} tripdt={tdt}
Gi4b 4b 4bx value={v(i4b)} tripdv={tdv} tripdt={tdt}
Gi5b 5b 5bx value={v(i5b)} tripdv={tdv} tripdt={tdt}
Gi6b 6b 6bx value={v(i6b)} tripdv={tdv} tripdt={tdt}
*******************************
L1a 1ax 1ay {length*Ls/2}
L2a 2ax 2ay {length*Ls/2}
L3a 3ax 3ay {length*Ls/2}
L4a 4ax 4ay {length*Ls/2}
L5a 5ax 5ay {length*Ls/2}
L6a 6ax 6ay {length*Ls/2}
*******************************
L1b 1ay 1bx {length*Ls/2}
L2b 2ay 2bx {length*Ls/2}
L3b 3ay 3bx {length*Ls/2}
L4b 4ay 4bx {length*Ls/2}
L5b 5ay 5bx {length*Ls/2}
L6b 6ay 6bx {length*Ls/2}
*******************************
k12a L1a L2a {k1}
k13a L1a L3a {k1}
k14a L1a L4a {k3}
k15a L1a L5a {k2}
k16a L1a L6a {k2}
k23a L2a L3a {k1}
k24a L2a L4a {k2}
k25a L2a L5a {k3}
k26a L2a L6a {k2}
k34a L3a L4a {k2}
k35a L3a L5a {k2}
k36a L3a L6a {k3}
k45a L4a L5a {k1}
k46a L4a L6a {k1}
k56a L5a L6a {k1}
*******************************
k12b L1b L2b {k1}
k13b L1b L3b {k1}
k14b L1b L4b {k3}
k15b L1b L5b {k2}
k16b L1b L6b {k2}
k23b L2b L3b {k1}
k24b L2b L4b {k2}
k25b L2b L5b {k3}
k26b L2b L6b {k2}
k34b L3b L4b {k2}
k35b L3b L5b {k2}
k36b L3b L6b {k3}
k45b L4b L5b {k1}
k46b L4b L6b {k1}
k56b L5b L6b {k1}
*******************************
C_10a 1ay 0 {cl*length*Ce}
C_20a 2ay 0 {cl*length*Ce}
C_30a 3ay 0 {cl*length*Ce}
C_40a 4ay 0 {cl*length*Ce}
C_50a 5ay 0 {cl*length*Ce}
C_60a 6ay 0 {cl*length*Ce}
*******************************
