* Horizontal 1m 1m 1m
* alternative T-model with coupled R's
* Model cable with very thick shield (only for testing ideal shielded cable)
* see also: ..\ltspice\loadflow_transient_examples_with_some_documentation_directly_in_asc_file\ATP_EMTP_Cables_Models
* see also: ..\ltspice\loadflow_transient_examples_with_some_documentation_directly_in_asc_file\Crossbonding
.subckt line_cable_shield_400kV_1200mm2_10km_2_without_sheath a1 a2 a3 b1 b2 b3
* XL,XM in ohm/m
+params: XL11=6.8802302E-04   XM12=4.2970524E-04   XM13=3.8615359E-04
+        XM21=4.2970524E-04   XL22=6.8802302E-04   XM23=4.2970524E-04
+        XM31=3.8615359E-04   XM32=4.2970524E-04   XL33=6.8802302E-04
+ Ce=0.255nF ; per m
+ R=0.01864 ; conductor resistance per km
+ Rsh=0.01336; shield resistance per km
+ length=10 ; 10km
+ length1={length*1000} ; meter to km translation for XL's,XM's
+ fn_ref=50
+ omega={2*pi*fn_ref}
+ fact=1
+ cl=1
+ g=1e12
.param Ce1={length1*Ce*cl}
.param Rnn={6.76231584E-05}
.param Rmn={4.9232579E-05}
V1 a1 a1a 0 rser=1e-15
V2 a2 a2a 0 rser=1e-15
V3 a3 a3a 0 rser=1e-15
*
* Inductance matrix from ATP
E1 a1a b1a VALUE={length1/2*(Rnn*I(V1)+Rmn*I(V2)+Rmn*I(V3))+length1/2/omega*(XL11*DDT(I(V1))+XM12*DDT(I(V2))+XM13*DDT(I(V3)))} tripdv={tdv} tripdt={tdt}
E2 a2a b2a VALUE={length1/2*(Rmn*I(V1)+Rnn*I(V2)+Rmn*I(V3))+length1/2/omega*(XM21*DDT(I(V1))+XL22*DDT(I(V2))+XM23*DDT(I(V3)))} tripdv={tdv} tripdt={tdt}
E3 a3a b3a VALUE={length1/2*(Rmn*I(V1)+Rmn*I(V2)+Rnn*I(V3))+length1/2/omega*(XM31*DDT(I(V1))+XM32*DDT(I(V2))+XL33*DDT(I(V3)))} tripdv={tdv} tripdt={tdt}

* Inductance matrix from ATP
E12 b1a b1c VALUE={length1/2*(Rnn*I(V11)+Rmn*I(V21)+Rmn*I(V31))+length1/2/omega*(XL11*DDT(I(V11))+XM12*DDT(I(V21))+XM13*DDT(I(V31)))} tripdv={tdv} tripdt={tdt}
E22 b2a b2c VALUE={length1/2*(Rmn*I(V11)+Rnn*I(V21)+Rmn*I(V31))+length1/2/omega*(XM21*DDT(I(V11))+XL22*DDT(I(V21))+XM23*DDT(I(V31)))} tripdv={tdv} tripdt={tdt}
E32 b3a b3c VALUE={length1/2*(Rmn*I(V11)+Rmn*I(V21)+Rnn*I(V31))+length1/2/omega*(XM31*DDT(I(V11))+XM32*DDT(I(V21))+XL33*DDT(I(V31)))} tripdv={tdv} tripdt={tdt}
*
V11 b1c b1 0
V21 b2c b2 0
V31 b3c b3 0

* Capacitance matrix
Gc1 b1a 0  VALUE={ce1*DDT(v(b1a))} tripdv={tdv} tripdt={tdt}
Gc2 b2a 0  VALUE={ce1*DDT(v(b2a))} tripdv={tdv} tripdt={tdt}
Gc3 b3a 0  VALUE={ce1*DDT(v(b3a))} tripdv={tdv} tripdt={tdt}
*
Rgnd1 a1 0 {g}
Rgnd2 a2 0 {g}
Rgnd3 a3 0 {g}
Rgnd13 b1 0 {g}
Rgnd14 b2 0 {g}
Rgnd15 b3 0 {g}
.ends

* Horizontal 1m 1m 1m
* Model cable with very thick shield (only for testing ideal shielded cable)
* Inductance Matrix is from ATP in ohm/m
* Capacitance Matrix is also from ATP in F/m
* For the data see the atp files in the example folder (NOTE: For capacitance use the pi-model - instead of bergeron model)
* This model is with concentrated elements (not distributed)
* Inner reactance(for 10km)=
* Xi=0.6182 (X+Conductor=2.727 X+shield=2.087) approx:(2.727-2.087)*k
* Shield + Conductor resistance:
* R=0.3124 R+Conductor=0.1864 R+Shield=0.1336 approx:(0.1864+0.1336*k)
* The resistances/reactances are at the left and right side of the circuit (T-element)
**********************************************************************************************************************************************
* with the parameter "fact" you can simulate thicker and thinner shields: higher fact = thicker shield (lower resistance, higher capacitance)
**********************************************************************************************************************************************
* see also OILcable_400kV_1200mm2_2sys.acp
* see also: ..\ltspice\loadflow_transient_examples_with_some_documentation_directly_in_asc_file\Crossbonding
.subckt line_cable_shield_400kV_1200mm2_10km a1 a4 a2 a5 a3 a6 b1 b4 b2 b5 b3 b6
+params: XL11=6.8802302E-04   XM12=4.2970524E-04   XM13=3.8615359E-04   XM14=6.2809826E-04   XM15=4.2970524E-04   XM16=3.8615359E-04
+        XM21=4.2970524E-04   XL22=6.8802302E-04   XM23=4.2970524E-04   XM24=4.2970524E-04   XM25=6.2809826E-04   XM26=4.2970524E-04
+        XM31=3.8615359E-04   XM32=4.2970524E-04   XL33=6.8802302E-04   XM34=3.8615359E-04   XM35=4.2970524E-04   XM36=6.2809826E-04
+        XM41=6.2809826E-04   XM42=4.2970524E-04   XM43=3.8615359E-04   XL44=6.2687196E-04   XM45=4.2970524E-04   XM46=3.8615359E-04
+        XM51=4.2970524E-04   XM52=6.2809826E-04   XM53=4.2970524E-04   XM54=4.2970524E-04   XL55=6.2687196E-04   XM56=4.2970524E-04
+        XM61=3.8615359E-04   XM62=4.2970524E-04   XM63=6.2809826E-04   XM64=3.8615359E-04   XM65=4.2970524E-04   XL66=6.2687196E-04
*+ Ce=332.7nF ; per km
*+ Cshield=2521nF ; per km
+ Ce=0.3327nF ; per m
+ Cshield=2.521nF ; per m
+ R=0.01864 ; conductor resistance per km
+ Rsh=0.01336; shield resistance per km
+ length=10 ; 10km
+ length1={length*1000} ; meter to km
+ fact=1
+ cl=1
+ fn_ref=50
+ g=1e12
.param omega={fn_ref*2*3.14159}
.param R1={R*length}
.param Rsh1={Rsh*length/fact}
.param Ce1={length1*Ce*cl}
.param Cshield1={length1*Cshield*fact}
.param k12={XM12/sqrt(XL11*XL22)}
.param k13={XM13/sqrt(XL11*XL33)}
.param k14={XM14/sqrt(XL11*XL44)}
.param k15={XM15/sqrt(XL11*XL55)}
.param k16={XM16/sqrt(XL11*XL66)}
.param k23={XM23/sqrt(XL22*XL33)}
.param k24={XM24/sqrt(XL22*XL44)}
.param k25={XM25/sqrt(XL22*XL55)}
.param k26={XM26/sqrt(XL22*XL66)}
.param k34={XM34/sqrt(XL33*XL44)}
.param k35={XM35/sqrt(XL33*XL55)}
.param k36={XM36/sqrt(XL33*XL66)}
.param k45={XM45/sqrt(XL44*XL55)}
.param k46={XM46/sqrt(XL44*XL66)}
.param k56={XM56/sqrt(XL55*XL66)}
* resistance left side
R1 a1 a1a {R1/2}
R2 a2 a2a {R1/2}
R3 a3 a3a {R1/2}
R4 a4 a4a {Rsh1/2}
R5 a5 a5a {Rsh1/2}
R6 a6 a6a {Rsh1/2}
* self inductance left
L1 a1a b1a {length1/2/omega*(XL11)} rser=0
L2 a2a b2a {length1/2/omega*(XL22)} rser=0
L3 a3a b3a {length1/2/omega*(XL33)} rser=0
L4 a4a b4a {length1/2/omega*(XL44)} rser=0
L5 a5a b5a {length1/2/omega*(XL55)} rser=0
L6 a6a b6a {length1/2/omega*(XL66)} rser=0
*
* Capacitance matrix from ATP
Gc1 b1a 0  VALUE={ce1*DDT(v(b1a))-ce1*DDT(v(b4a))} tripdv={tdv} tripdt={tdt}
Gc2 b2a 0  VALUE={ce1*DDT(v(b2a))-ce1*DDT(v(b5a))} tripdv={tdv} tripdt={tdt}
Gc3 b3a 0  VALUE={ce1*DDT(v(b3a))-ce1*DDT(v(b6a))} tripdv={tdv} tripdt={tdt}
Gc4 b4a 0  VALUE={-ce1*DDT(v(b1a))+Cshield1*DDT(v(b4a))} tripdv={tdv} tripdt={tdt}
Gc5 b5a 0  VALUE={-ce1*DDT(v(b2a))+Cshield1*DDT(v(b5a))} tripdv={tdv} tripdt={tdt}
Gc6 b6a 0  VALUE={-ce1*DDT(v(b3a))+Cshield1*DDT(v(b6a))} tripdv={tdv} tripdt={tdt}
*
* self inductance right
L1a b1a b1b {length1/2/omega*(XL11)} rser=0
L2a b2a b2b {length1/2/omega*(XL22)} rser=0
L3a b3a b3b {length1/2/omega*(XL33)} rser=0
L4a b4a b4b {length1/2/omega*(XL44)} rser=0
L5a b5a b5b {length1/2/omega*(XL55)} rser=0
L6a b6a b6b {length1/2/omega*(XL66)} rser=0
* resistance right side
R1a b1b b1 {R1/2}
R2a b2b b2 {R1/2}
R3a b3b b3 {R1/2}
R4a b4b b4 {Rsh1/2}
R5a b5b b5 {Rsh1/2}
R6a b6b b6 {Rsh1/2}
* coupling left side
