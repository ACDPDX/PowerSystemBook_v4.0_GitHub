* lm1 L
* lm1 lm1 L
* lm3 lm2 lm2 L
* lm2 lm3 lm2 lm1 L
* lm2 lm2 lm3 lm1 lm1 L
***************************
* R
* rm R
* rm rm R
* rm rm rm R
* rm rm rm rm R
* rm rm rm rm rm R
***************************
* Ce
* cl1 Ce
* cl1 cl1 Ce
* cl3 cl2 cl2 Ce
* cl2 cl3 cl2 cl1 Ce
* cl2 cl2 cl3 cl1 cl1 Ce
***************************
