E1 a1a b1a VALUE={length1/2*(Rnn*I(V1)+Rmn*I(V2)+Rmn*I(V3)+Rmn*I(V4)+Rmn*I(V5)+Rmn*I(V6))+length1/2/omega*(XL11*DDT(I(V1))+XM12*DDT(I(V2))+XM13*DDT(I(V3))+XM14*DDT(I(V4))+XM15*DDT(I(V5))+XM16*DDT(I(V6)))} tripdv={tdv} tripdt={tdt}
