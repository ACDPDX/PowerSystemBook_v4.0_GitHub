+ XM12=0.3618436 XM13=0.3617283 XM14=0.39628 XM23=0.3618436 XM24=0.39628 XM34=0.39628
****************************************
+ C11=8.59741n C22=8.431737n C33=8.59741n C44=9.217332n  ; ATP-C-Matrix diagonal
+ C12=1.256410n C13=1.175293n C14=1.980319n C23=1.256410n C24=2.044343n C34=1.980319n ; ATP-C-Matrix offdiagonal
****************************************
