.SUBCKT Donaumast__2sys_110kV_2x185_30_1x95_15_Earth_coupled_indirect_flash_input 1a 2a 3a 4a 5a 6a 1d 2d 3d 4d 5d 6d 7a 7d flash1 params: length=0.1 L=100u k=0.08 C={20p} len=0.1 Rs=1m Rfl=5
X§LineLeft 1a 2a 3a 4a 5a 6a L1a L2a L3a L4a L5a L6a 7a LS1 Donaumast__2sys_110kV_2x185_30_1x95_15_Earth length={length} cl=1 g=1e12 fn={fn1}
X§LineRight L1b L2b L3b L4b L5b L6b 1d 2d 3d 4d 5d 6d LS2 7d Donaumast__2sys_110kV_2x185_30_1x95_15_Earth length={length} cl=1 g=1e12 fn={fn1}
* different coupling factor for different distance per phase to flash
* NOTE: simplified model because induction of flash into line is not concentrated but distributed over line !!
* NOTE: Since the frequencies are very high the number of concentrated elements
* should be also very high !!! In our case only elements with 100m linelength
.param k0={k}
.param k1={1/0.99*k} k2={1/0.98*k} k3={1/0.97*k}
.param k4={1/1.03*k} k5={1/1.02*k} k6={1/1.01*k}
.param len_flash=1
* Flash
lfl flash1 flash2 {L*len_flash}
Rfl flash2 0 {Rfl*len_flash}

LS LS11 LS2 {L*len_flash}
L1 L1a1 L1b {L*len_flash}
L2 L2a1 L2b {L*len_flash}
L3 L3a1 L3b {L*len_flash}
L4 L4a1 L4b {L*len_flash}
L5 L5a1 L5b {L*len_flash}
L6 L6a1 L6b {L*len_flash}

RLS Ls1 Ls11 {Rs*len_flash}
R1  L1a L1a1 {Rs*len_flash}
R2  L2a L2a1 {Rs*len_flash}
R3  L3a L3a1 {Rs*len_flash}
R4  L4a L4a1 {Rs*len_flash}
R5  L5a L5a1 {Rs*len_flash}
R6  L6a L6a1 {Rs*len_flash}

Ks Lfl Ls {k0}

K1 Lfl L1 {k1}
K2 Lfl L2 {k2}
K3 Lfl L3 {k3}

K4 Lfl L4 {k4}
K5 Lfl L5 {k5}
K6 Lfl L6 {k6}

CL1b flash2 l1a1 {k1/k*C*len_flash}
CL2b flash2 l2a1 {k2/k*C*len_flash}
CL3b flash2 l3a1 {k3/k*C*len_flash}
CL4b flash2 l4a1 {k4/k*C*len_flash}
CL5b flash2 l5a1 {k5/k*C*len_flash}
CL6b flash2 l6a1 {k6/k*C*len_flash}
.ENDS

