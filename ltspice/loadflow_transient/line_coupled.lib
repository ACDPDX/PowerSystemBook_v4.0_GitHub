E2b 2ay 2b0 VALUE={length/2*(Rmn*I(E1b)+Rnn*I(E2b)+Rmn*I(E3b))+length/2/omega*(XM12*DDT(I(E1b))+XL22*DDT(I(E2b))+XM23*DDT(I(E3b)))} tripdv={tdv} tripdt={tdt}
E3b 3ay 3b0 VALUE={length/2*(Rmn*I(E1b)+Rmn*I(E2b)+Rnn*I(E3b))+length/2/omega*(XM13*DDT(I(E1b))+XM23*DDT(I(E2b))+XL33*DDT(I(E3b)))} tripdv={tdv} tripdt={tdt}
*********************************
C_10a 1ay 0 {cl*length*C_10}
C_20a 2ay 0 {cl*length*C_20}
C_30a 3ay 0 {cl*length*C_30}
*******************************
C12a 1ay 2ay {cl*length*C12}
C13a 1ay 3ay {cl*length*C13}
C23a 2ay 3ay {cl*length*C23}
*******************************
