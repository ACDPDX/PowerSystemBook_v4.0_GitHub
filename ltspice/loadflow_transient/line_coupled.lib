***************************************************************************
* another model of a three phase coupled line with symmetric case default
* mutual resistance added
***************************
.SUBCKT  Line_coupled_3  1a 2a 3a 1b 2b 3b
+ PARAMS:
****************************************
* This parameter are for the symmetric case (fully transposed lines)
+ Lm={0.4307/314.159} L={0.7357/314.159} Rm=0.0482 R=0.149
+ Cb=10nf Ce=6nf
****************************************
+ length=1
+ cl=1
+ g=1e12
+ fn_ref=50
.param omega={fn_ref*2*3.14159}
* Change this paramter if you have a assymetric case
.param Lm12={Lm} Lm13={Lm} Lm23={Lm}
.param R1={R} R2={R} R3={R}
.param L1={L} L2={L} L3={L}
.param Cll={(Cb-Ce)/3}
.param Ce1a={Ce} Ce2a={Ce} Ce3a={Ce} Ce1b={Ce} Ce2b={Ce} Ce3b={Ce}
.param Cl12a={Cll} Cl23a={Cll} Cl13a={Cll} Cl12b={Cll} Cl23b={Cll} Cl13b={Cll}
* Resistors and inductors (also mutual resistance)
EI1 1a 1b value={R1*length*i(ei1)+Rm*length*i(ei2)+Rm*length*i(ei3)+L1*length*DDT(i(ei1))+Lm12*length*DDT(i(ei2))+Lm13*length*DDT(i(ei3))} tripdv={tdv} tripdt={tdt}
EI2 2a 2b value={Rm*length*i(ei1)+R2*length*i(ei2)+Rm*length*i(ei3)+Lm12*length*DDT(i(ei1))+L2*length*DDT(i(ei2))+Lm23*length*DDT(i(ei3))} tripdv={tdv} tripdt={tdt}
EI3 3a 3b value={Rm*length*i(ei1)+Rm*length*i(ei2)+R3*length*i(ei3)+Lm13*length*DDT(i(ei1))+Lm23*length*DDT(i(ei2))+L3*length*DDT(i(ei3))} tripdv={tdv} tripdt={tdt}
* Capacitances
GI1a 1a 0 value={(CE1a+Cl13a+Cl12a)*length*cl*DDT(v(1a))-Cl12a*length*cl*DDT(V(2a))-Cl13a*length*cl*DDT(V(3a))} tripdv={tdv} tripdt={tdt}
GI2a 2a 0 value={(CE2a+Cl12a+Cl23a)*length*cl*DDT(v(2a))-Cl12a*length*cl*DDT(V(1a))-Cl23a*length*cl*DDT(V(3a))} tripdv={tdv} tripdt={tdt}
GI3a 3a 0 value={(CE3a+Cl23a+Cl13a)*length*cl*DDT(V(3a))-Cl13a*length*cl*DDT(V(1a))-Cl23a*length*cl*DDT(V(2a))} tripdv={tdv} tripdt={tdt}
GI1b 1b 0 value={(CE1b+Cl13b+Cl12b)*length*cl*DDT(v(1b))-Cl12b*length*cl*DDT(V(2b))-Cl13b*length*cl*DDT(V(3b))} tripdv={tdv} tripdt={tdt}
GI2b 2b 0 value={(CE2b+Cl12b+Cl23b)*length*cl*DDT(v(2b))-Cl12b*length*cl*DDT(V(1b))-Cl23b*length*cl*DDT(V(3b))} tripdv={tdv} tripdt={tdt}
GI3b 3b 0 value={(CE3b+Cl23b+Cl13b)*length*cl*DDT(V(3b))-Cl13b*length*cl*DDT(V(1b))-Cl23b*length*cl*DDT(V(2b))} tripdv={tdv} tripdt={tdt}
Rgnd1 1a 0 {g}
Rgnd2 2a 0 {g}
Rgnd3 3a 0 {g}
Rgnd4 1b 0 {g}
Rgnd5 2b 0 {g}
Rgnd6 3b 0 {g}
.ENDS


.SUBCKT  1sys_triangle_symmetric  1a 2a 3a 1b 2b 3b
+ PARAMS:
+ R1=0.10 R2=0.10 R3=0.10 ; per unit length 1km !!!
****************************************
+ XL11=0.7357518 XL22=0.7360523 XL33=0.7357518 ; ATP-Z-Matrix
+ XM12=0.3618436 XM13=0.3617283 XM23=0.3618436
****************************************
+ C11=8.171935n C22=7.978315n C33=8.171935n  ; ATP-C-Matrix diagonal
+ C12=1.695632n C13=1.600760n C23=1.695632n  ; ATP-C-Matrix offdiagonal
****************************************
+ length=1
+ cl=1
+ g=1e12
+ fn_ref=50
.PARAM
+ omega={fn_ref*2*3.14159}
*********************************
+ L11={XL11/omega} M12={XM12/omega} M13={XM13/omega}
+ L22={XL22/omega} M23={XM23/omega}
+ L33={XL33/omega}
*******************************************************************
* geschaetzte BetriebsInduktivität/Phase bei symm. Betrieb(1,a,a*a)
*******************************************************************
+ L1={L11-0.5*M12-0.5*M13} ;(not used)
+ L2={L22-0.5*M12-0.5*M23} ;(not used)
+ L3={L33-0.5*M13-0.5*M23} ;(not used)
*********************************
+ k12={M12/sqrt(L11*L22)}
+ k13={M13/sqrt(L11*L33)}
+ k23={M23/sqrt(L22*L33)}
*******************************
+ C_10={C11-C12-C13}
+ C_20={C22-C12-C23}
+ C_30={C33-C13-C23}
**** Ausgabe von XB1,2 ****
VXB1 XB1 0 {length*omega*(L1+L2+L3)/3} ;(not used)
RXB1 XB1 0 1e12
*********************************
R1a 1a 1ax {0.5*length*R1}
R1b 1bx 1b {0.5*length*R1}
R2a 2a 2ax {0.5*length*R2}
R2b 2bx 2b {0.5*length*R2}
R3a 3a 3ax {0.5*length*R3}
R3b 3bx 3b {0.5*length*R3}
*******************************
L1a 1ax 1ay {length*L11/2}
L2a 2ax 2ay {length*L22/2}
L3a 3ax 3ay {length*L33/2}
*******************************
L1b 1ay 1bx {length*L11/2}
L2b 2ay 2bx {length*L22/2}
L3b 3ay 3bx {length*L33/2}
*******************************
k12a L1a L2a {k12}
k13a L1a L3a {k13}
k23a L2a L3a {k23}
*******************************
k12b L1b L2b {k12}
k13b L1b L3b {k13}
k23b L2b L3b {k23}
*******************************
C_10a 1ay 0 {cl*length*C_10}
C_20a 2ay 0 {cl*length*C_20}
C_30a 3ay 0 {cl*length*C_30}
*******************************
C12a 1ay 2ay {cl*length*C12}
C13a 1ay 3ay {cl*length*C13}
C23a 2ay 3ay {cl*length*C23}
*******************************
Rgnd1 1a 0 {g}
Rgnd2 2a 0 {g}
Rgnd3 3a 0 {g}
Rgnd4 1b 0 {g}
Rgnd5 2b 0 {g}
Rgnd6 3b 0 {g}
*******************************
.ENDS

.SUBCKT  1sys_triangle_symmetric_coupledR  1a 2a 3a 1b 2b 3b
+ PARAMS:
****************************************
+ XL11=0.7357518 XL22=0.7360523 XL33=0.7357518 ; ATP-Z-Matrix
+ XM12=0.3618436 XM13=0.3617283 XM23=0.3618436
****************************************
+ C11=8.171935n C22=7.978315n C33=8.171935n  ; ATP-C-Matrix diagonal
+ C12=1.695632n C13=1.600760n C23=1.695632n  ; ATP-C-Matrix offdiagonal
****************************************
+ length=1
+ cl=1
+ g=1e12
+ fn_ref=50
.PARAM
+ omega={fn_ref*2*3.14159}
+ Rnn=0.149054 Rmn=0.0481
*********************************
+ C_10={C11-C12-C13}
+ C_20={C22-C12-C23}
+ C_30={C33-C13-C23}
*********************************
V1 1a 1ax 0 rser=1e-15
V2 2a 2ax 0 rser=1e-15
V3 3a 3ax 0 rser=1e-15
*
E1 1ax 1bx VALUE={length/2*(Rnn*I(V1)+Rmn*I(V2)+Rmn*I(V3))+length/2/omega*(XL11*DDT(I(V1))+XM12*DDT(I(V2))+XM13*DDT(I(V3)))} tripdv={tdv} tripdt={tdt}
E2 2ax 2bx VALUE={length/2*(Rmn*I(V1)+Rnn*I(V2)+Rmn*I(V3))+length/2/omega*(XM12*DDT(I(V1))+XL22*DDT(I(V2))+XM23*DDT(I(V3)))} tripdv={tdv} tripdt={tdt}
E3 3ax 3bx VALUE={length/2*(Rmn*I(V1)+Rmn*I(V2)+Rnn*I(V3))+length/2/omega*(XM13*DDT(I(V1))+XM23*DDT(I(V2))+XL33*DDT(I(V3)))} tripdv={tdv} tripdt={tdt}
*
E11 1bx 1by VALUE={length/2*(Rnn*I(V11)+Rmn*I(V21)+Rmn*I(V31))+length/2/omega*(XL11*DDT(I(V11))+XM12*DDT(I(V21))+XM13*DDT(I(V31)))} tripdv={tdv} tripdt={tdt}
E12 2bx 2by VALUE={length/2*(Rmn*I(V11)+Rnn*I(V21)+Rmn*I(V31))+length/2/omega*(XM12*DDT(I(V11))+XL22*DDT(I(V21))+XM23*DDT(I(V31)))} tripdv={tdv} tripdt={tdt}
E13 3bx 3by VALUE={length/2*(Rmn*I(V11)+Rmn*I(V21)+Rnn*I(V31))+length/2/omega*(XM13*DDT(I(V11))+XM23*DDT(I(V21))+XL33*DDT(I(V31)))} tripdv={tdv} tripdt={tdt}
*
V11 1by 1b 0 rser=1e-15
V21 2by 2b 0 rser=1e-15
V31 3by 3b 0 rser=1e-15
*
*******************************
C_10a 1bx 0 {cl*length*C_10}
C_20a 2bx 0 {cl*length*C_20}
C_30a 3bx 0 {cl*length*C_30}
*******************************
C12a 1bx 2bx {cl*length*C12}
C13a 1bx 3bx {cl*length*C13}
C23a 2bx 3bx {cl*length*C23}
*******************
Rgnd1 1a 0 {g}
Rgnd2 2a 0 {g}
Rgnd3 3a 0 {g}
Rgnd4 1b 0 {g}
Rgnd5 2b 0 {g}
Rgnd6 3b 0 {g}
*******************************
.ENDS

.SUBCKT  1sys_triangle_symmetric_coupledR_earth  1a 2a 3a 1b 2b 3b 4a 4b
