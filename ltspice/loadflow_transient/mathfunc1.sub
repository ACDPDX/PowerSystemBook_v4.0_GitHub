************************
*
*	sinh(x)
*
************************
.subckt sinh in out
B1 0 out I=sinh(v(in)) Rpar=1 tripdv={tdv} tripdt={tdt}
.ends sinh
************************
*
*	sqrt(x)
*
************************
.subckt sqrt in out
B1 0 out I=sqrt(v(in)) rpar=1 tripdv={tdv} tripdt={tdt}
.ends sqrt
************************
*
*	tan(x)
*
************************
.subckt tan in out
B1 0 out I=tan(v(in)+phi) rpar=1 tripdv={tdv} tripdt={tdt}
.ends tan
************************
*
*	tanh(x)
*
************************
.subckt tanh in out
B1 0 out I=tanh(v(in)) rpar=1 tripdv={tdv} tripdt={tdt}
