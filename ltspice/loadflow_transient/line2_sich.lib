Br1 0 L5 i=((1+h1)/2)*((1+h1)/Z1*delay(v(L2),tau1)-h1*delay(i(Bs1),tau1))+((1-h1)/2)*((1+h1)/Z1*delay(v(L5),tau1)-h1*delay(i(Br1),tau1))
Bs2 0 L3 i=((1+h1)/2)*((1+h1)/Z1*delay(v(L6),tau1)-h1*delay(i(Br2),tau1))+((1-h1)/2)*((1+h1)/Z1*delay(v(L3),tau1)-h1*delay(i(Bs2),tau1))
Br2 0 L6 i=((1+h1)/2)*((1+h1)/Z1*delay(v(L3),tau1)-h1*delay(i(Bs2),tau1))+((1-h1)/2)*((1+h1)/Z1*delay(v(L6),tau1)-h1*delay(i(Br2),tau1))
