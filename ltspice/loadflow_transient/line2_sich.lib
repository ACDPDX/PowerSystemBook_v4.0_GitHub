.param L1={L1s} R1={R1s} C1={C1s} C0={C0s}
.param
****************************************
+ Lself={(2*L1+L0)/3} 
+ Lm={(L0-L1)/3}
****************************************
+ CE={C0} ; Line2earth capacitance also for uncoupled case
+ CLL={(C1-C0)/3} ; Line2Line capacitance
+ CL=1
****************************************
+ length=200
+ g=1e12
.param R1x={R1*length}
.param R0x={R0*length}
