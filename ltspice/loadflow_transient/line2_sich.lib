.param
****************************************
+ Lself={(2*L1+L0)/3} 
+ Lm={(L0-L1)/3}
****************************************
+ CE={C0} ; Line2earth capacitance also for uncoupled case
+ CLL={(C1-C0)/3} ; Line2Line capacitance
+ CL=1
****************************************
+ length=1
+ g=1e12
+ fn={fn1}
+ omega={fn*2*3.14159}
********************************
+ Rnn={(2*R1+R0)/3}
+ Rmn={(R0-R1)/3}
