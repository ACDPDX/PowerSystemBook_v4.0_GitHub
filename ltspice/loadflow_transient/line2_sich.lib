B11 L6 0 V=v(1b)*0.408+v(2b)*0.408-v(3b)*0.816 tripdv=1 tripdt=1
B12 0 1b I=I(B9)*0.577+I(B10)*0.707+I(B11)*0.408 tripdv=1 tripdt=1
B13 0 2b I=I(B9)*0.577-I(B10)*0.707+I(B11)*0.408 tripdv=1 tripdt=1
B14 0 3b I=I(B9)*0.577-I(B11)*0.816 tripdv=1 tripdt=1
Bs0 0 L1 i=((1+h0)/2)*((1+h0)/Z0*delay(v(L4),tau0)-h0*delay(i(Br0),tau0))+((1-h0)/2)*((1+h0)/Z0*delay(v(L1),tau0)-h0*delay(i(Bs0),tau0))
Br0 0 L4 i=((1+h0)/2)*((1+h0)/Z0*delay(v(L1),tau0)-h0*delay(i(Bs0),tau0))+((1-h0)/2)*((1+h0)/Z0*delay(v(L4),tau0)-h0*delay(i(Br0),tau0))
Bs1 0 L2 i=((1+h1)/2)*((1+h1)/Z1*delay(v(L5),tau1)-h1*delay(i(Br1),tau1))+((1-h1)/2)*((1+h1)/Z1*delay(v(L2),tau1)-h1*delay(i(Bs1),tau1))
Br1 0 L5 i=((1+h1)/2)*((1+h1)/Z1*delay(v(L2),tau1)-h1*delay(i(Bs1),tau1))+((1-h1)/2)*((1+h1)/Z1*delay(v(L5),tau1)-h1*delay(i(Br1),tau1))
Bs2 0 L3 i=((1+h1)/2)*((1+h1)/Z1*delay(v(L6),tau1)-h1*delay(i(Br2),tau1))+((1-h1)/2)*((1+h1)/Z1*delay(v(L3),tau1)-h1*delay(i(Bs2),tau1))
Br2 0 L6 i=((1+h1)/2)*((1+h1)/Z1*delay(v(L3),tau1)-h1*delay(i(Bs2),tau1))+((1-h1)/2)*((1+h1)/Z1*delay(v(L6),tau1)-h1*delay(i(Br2),tau1))
