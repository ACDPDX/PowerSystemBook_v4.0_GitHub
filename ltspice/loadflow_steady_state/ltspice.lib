*XRUt1 t1r n1r t1i n1i t2r s2r t2i s2i p1t_m q1t_m v1t_m v2t_m p2t_m q2t_m l1l2k12_LF on={on} ue={ue/sqrt(3)} sfactor={sfactor} vfactor={vfactor}
* + lp={lp} rp={rp} w={w} k={k} rfe={rfe}
