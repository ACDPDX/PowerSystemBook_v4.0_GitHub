+ uout=1
  ev1r     v1r    v10  value =  { on*(vr/vfactor)+(1-on)*v(v1r) } tripdv={TRIPDV} tripdt={TRIPDT} ; real volt output
  ev1i     v1i    v20  value =  { on*(vi/vfactor)+(1-on)*v(v1i) } tripdv={TRIPDV} tripdt={TRIPDT} ; imag volt output
