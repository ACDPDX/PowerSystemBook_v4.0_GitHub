  ri2mag i2_m 0 1e12
  rsmag s1_m 0 1e12
  rp1 p_m  0 1e12
  rp2 p2_m  0 1e12
  rq1 q_m  0 1e12
  rq2 q2_m  0 1e12
  rpv pv_m  0 1e12
  rqv qv_m  0 1e12
  rmax1  v1r  0   1e12
  rmax2  v1i  0   1e12
  rmax3  n1r  0   1e12
  rmax4  n1i  0   1e12
.ends


* Constant current element
* with input of p,q,v instead of ir,ii
.subckt iri_slack_pqv_LF v1r v1i i_m p_m q_m
+ params:
+ on = 1
+ p=1e6
+ q=0
+ vn=120000
+ vfactor = {sqrt(3)}
+ sfactor = 3
.param ir={(vfactor/sfactor)*p/vn}
.param ii={-(vfactor/sfactor)*q/vn}
  i1r   v1r    v10  dc  {on*ir} ; real curr output
  i1i   v1i    v20  dc  {on*ii} ; imag curr output
  vi1r  v10    0    dc  0v
  vi1i  v20    0    dc  0v
  * measurement stuff
  eiabs_m i_m 0 value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))}  tripdv={TRIPDV} tripdt={TRIPDT} ; abs. current
  evabs_m v_m 0 value = {vfactor*sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))}  tripdv={TRIPDV} tripdt={TRIPDT} ; abs. voltage
  ep1 p_m 0 value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}  ; real power
  eq1 q_m 0 value = {(v(v1i)*i(vi1r)-v(v1r)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}  ; imag power
  es1mag_m  s_m 0 value = {v(v_m)*v(i_m) * sfactor/vfactor }  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  rvm v_m 0 1e12
  rpm p_m  0 1e12
  rqm q_m 0 1e12
  rim i_m 0 1e12
  rsm s_m 0 1e12
.ends
