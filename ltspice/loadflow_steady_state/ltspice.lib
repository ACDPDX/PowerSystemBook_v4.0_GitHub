  evabs_m v_m 0 value = {vfactor*sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))}  tripdv={TRIPDV} tripdt={TRIPDT}  ; abs. voltage
  ep1 p_m  0 value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}   ; real power
  eq1 q_m  0 value = {(v(v1i)*i(vi1r)-v(v1r)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}   ; imag power
  es1mag_m  s_m 0 value = {sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))*v(i_m) * sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  rvm v_m 0 1e12
  rpm p_m  0 1e12
  rqm q_m 0 1e12
  rim i_m 0 1e12
  rsm s_m 0 1e12
  rmax1   v1r  0  1e12
  rmax2   v1i  0  1e12
.ends
*$
*
* Current slack with input of
* current magnitude and phase input instead of ir,ii
.subckt iri_slack2_LF2 v1r n1r v1i n1i i_m p_m q_m
+ params:
+ on = 1
+ imag = 400
+ delta = 0
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ uout=0 ; default is no voltage output !!
.param ir = {imag*cos(delta*3.1415926535897935/180)}
.param ii = {imag*sin(delta*3.1415926535897935/180)}
  i1r   v1r    v10  dc  {on*ir} ; real curr output
  i1i   v1i    v20  dc  {on*ii} ; imag curr output
  vi1r  v10    n1r    dc  0v
  vi1i  v20    n1i    dc  0v
  * measurement stuff
  ev1mag_m v1_m 0 value = {vfactor * sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))} tripdv={TRIPDV} tripdt={TRIPDT}
  ev2mag_m v2_m 0 value = {vfactor * sqrt(v(n1r)*v(n1r)+v(n1i)*v(n1i))} tripdv={TRIPDV} tripdt={TRIPDT}
  ei1mag_m i_m 0 value = {(1-uout)*sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))+uout*v(v1_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  ei2mag_m i2_m 0 value = {-v(i_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  es1mag_m s1_m 0 value = {sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))*v(i_m) * sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  ep1 p_m 0  value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  ep2 p2_m 0  value = {(v(n1r)*i(vi1r)+v(n1i)*i(vi1i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  eq1 q_m 0  value = {(v(v1i)*i(vi1r)-v(v1r)*i(vi1i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  eq2 q2_m 0  value = {(v(n1i)*i(vi1r)-v(n1r)*i(vi1i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  epv pv_m 0  value = {v(p_m)+v(p2_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  eqv qv_m 0  value = {v(q_m)+v(q2_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  rv1mag v1_m 0 1e12
  rv2mag v2_m 0 1e12
  ri1mag i_m 0 1e12
  ri2mag i2_m 0 1e12
  rsmag s1_m 0 1e12
  rp1 p_m  0 1e12
  rp2 p2_m  0 1e12
  rq1 q_m  0 1e12
  rq2 q2_m  0 1e12
  rpv pv_m  0 1e12
  rqv qv_m  0 1e12
  rmax1  v1r  0   1e12
  rmax2  v1i  0   1e12
  rmax3  n1r  0   1e12
  rmax4  n1i  0   1e12
.ends
*
* alternate model for Vri_slack-Component based on thevenin-equivalent
* current sources
* on - parameter works in all cases contrary to the vri_slack model
* for good convergence at pv-slacks set gin to a lower value e.g. 1e5
*
.subckt vri_slack_te_LF v1r v1i v_m p_m q_m
+ params:
+ on = 1
+ vr = 110000
+ vi = 0
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ gin = 1e3
+ uout=1
  vss ss 0 1
  gv1r     v10    v1r  value =  { on*v(ss)*(vr/vfactor)*gin } tripdv={TRIPDV} tripdt={TRIPDT}  ; real volt output
  gv1i     v20    v1i  value =  { on*v(ss)*(vi/vfactor)*gin } tripdv={TRIPDV} tripdt={TRIPDT}  ; imag volt output
  gr1r     v1r    v10  value =  { on*v(ss)*v(v1r)*gin } tripdv={TRIPDV} tripdt={TRIPDT}
  gr1i     v1i    v20  value =  { on*v(ss)*v(v1i)*gin } tripdv={TRIPDV} tripdt={TRIPDT}
  vi1r     v10    0    dc   0v
  vi1i     v20    0    dc   0v
  eiabs_m i_m 0 value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))}  tripdv={TRIPDV} tripdt={TRIPDT}  ; abs. current
  evabs_m v_m 0 value = {uout*vfactor*sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))+(1-uout)*v(i_m)}  tripdv={TRIPDV} tripdt={TRIPDT}  ; abs. voltage
  ep1 p_m  0 value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}   ; real power
  eq1 q_m  0 value = {(v(v1i)*i(vi1r)-v(v1r)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}   ; imag power
  es1mag_m  s_m 0 value = {sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))*v(i_m) * sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  rvm v_m 0 1e12
  rpm p_m  0 1e12
  rqm q_m 0 1e12
  rim i_m 0 1e12
  rsm s_m 0 1e12
  rmax1   v1r  0  1e12
  rmax2   v1i  0  1e12
.ends
*$
*
* for good convergence at pv-slacks set gin to a lower value e.g. 1e5
* with additional neutral pins
.subckt vri_slack_te_n_LF v1r nr v1i ni v_m p_m q_m
+ params:
+ on = 1
+ vr = 110000
+ vi = 0
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ gin = 1e3
  vss ss 0 1
  gv1r     v10    v1r  value =  { on*v(ss)*(vr/vfactor)*gin } tripdv={TRIPDV} tripdt={TRIPDT}  ; real volt output
  gv1i     v20    v1i  value =  { on*v(ss)*(vi/vfactor)*gin } tripdv={TRIPDV} tripdt={TRIPDT}  ; imag volt output
  gr1r     v1r    v10  value =  { on*v(ss)*v(v1r,nr)*gin } tripdv={TRIPDV} tripdt={TRIPDT}
  gr1i     v1i    v20  value =  { on*v(ss)*v(v1i,ni)*gin } tripdv={TRIPDV} tripdt={TRIPDT}
  vi1r     v10    nr   dc   0v
  vi1i     v20    ni   dc   0v
  * measurement stuff
  eiabs_m i_m 0 value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))}  tripdv={TRIPDV} tripdt={TRIPDT}  ; abs. current
  evabs_m v_m 0 value = {vfactor*sqrt(v(v1r,nr)*v(v1r,nr)+v(v1i,ni)*v(v1i,ni))}  tripdv={TRIPDV} tripdt={TRIPDT}  ; abs. voltage
  ep1 p_m 0 value = {(v(v1r,nr)*i(vi1r)+v(v1i,ni)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}   ; real power
  eq1 q_m 0 value = {(v(v1i,ni)*i(vi1r)-v(v1r,nr)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}   ; imag power
  es1mag_m  s_m 0 value = {v(v_m)*v(i_m) * sfactor/vfactor }  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  rvm v_m 0 1e12
  rpm p_m  0 1e12
  rqm q_m 0 1e12
  rim i_m 0 1e12
  rsm s_m 0 1e12
  rmax1   v1r  0  1e12
  rmax2   v1i  0  1e12
.ends
*$

*
*
* alternate model for Vri_slack2 - component based on thevenin-equivalent
* current sources
* on - parameter works in all cases contrary to the vri_slack2 element
* for good convergence at pv-slacks set gin to a lower value e.g. 1e5
.subckt vri_slack2_te_LF v1r v1i v_m p_m q_m
+ params:
+ on = 1
+ vmag = 110000
+ delta = 0
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ gin = 1e3
.param vr = {vmag*cos(delta*3.1415926535897935/180)}
.param vi = {vmag*sin(delta*3.1415926535897935/180)}
  vss ss 0 1
  gv1r     v10    v1r  value =  { on*v(ss)*(vr/vfactor)*gin } tripdv={TRIPDV} tripdt={TRIPDT}  ; real volt output
  gv1i     v20    v1i  value =  { on*v(ss)*(vi/vfactor)*gin } tripdv={TRIPDV} tripdt={TRIPDT}  ; imag volt output
  gr1r     v1r    v10  value =  { on*v(ss)*v(v1r)*gin } tripdv={TRIPDV} tripdt={TRIPDT}
  gr1i     v1i    v20  value =  { on*v(ss)*v(v1i)*gin } tripdv={TRIPDV} tripdt={TRIPDT}
  vi1r     v10    0    dc   0v
  vi1i     v20    0    dc   0v
  * measurement stuff
  eiabs_m i_m 0 value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))}  tripdv={TRIPDV} tripdt={TRIPDT}  ; abs. current
  evabs_m v_m 0 value = {vfactor*sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))}  tripdv={TRIPDV} tripdt={TRIPDT}  ; abs. voltage
  ep1 p_m  0 value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}   ; real power
  eq1 q_m  0 value = {(v(v1i)*i(vi1r)-v(v1r)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}   ; imag power
  es1mag_m  s_m 0 value = {v(v_m)*v(i_m) * sfactor/vfactor }  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  rvm v_m 0 1e12
  rpm p_m  0 1e12
  rqm q_m 0 1e12
  rim i_m 0 1e12
  rsm s_m 0 1e12
  rmax1   v1r  0  1e12
  rmax2   v1i  0  1e12
.ends
*$

* for good convergence at pv-slacks set gin to a lower value e.g. 1e5
* with additional neutral pins output
.subckt vri_slack2_te_n_LF v1r nr v1i ni v_m p_m q_m
+ params:
+ on = 1
+ vmag = 110000
+ delta = 0
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ gin = 1e3
.param vr = {vmag*cos(delta*3.1415926535897935/180)}
.param vi = {vmag*sin(delta*3.1415926535897935/180)}
  vss ss 0 1
  gv1r     v10    v1r  value =  { on*v(ss)*(vr/vfactor)*gin } tripdv={TRIPDV} tripdt={TRIPDT}  ; real volt output
  gv1i     v20    v1i  value =  { on*v(ss)*(vi/vfactor)*gin } tripdv={TRIPDV} tripdt={TRIPDT}  ; imag volt output
  gr1r     v1r    v10  value =  { on*v(ss)*v(v1r,nr)*gin } tripdv={TRIPDV} tripdt={TRIPDT}
  gr1i     v1i    v20  value =  { on*v(ss)*v(v1i,ni)*gin } tripdv={TRIPDV} tripdt={TRIPDT}
  vi1r     v10    nr    dc   0v
  vi1i     v20    ni    dc   0v
  * measurement stuff
  eiabs_m i_m 0 value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))}  tripdv={TRIPDV} tripdt={TRIPDT}  ; abs. current
  evabs_m v_m 0 value = {vfactor*sqrt(v(v1r,nr)*v(v1r,nr)+v(v1i,ni)*v(v1i,ni))}  tripdv={TRIPDV} tripdt={TRIPDT}  ; abs. voltage
  ep1 p_m 0 value = {(v(v1r,nr)*i(vi1r)+v(v1i,ni)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}   ; real power
  eq1 q_m 0 value = {(v(v1i,ni)*i(vi1r)-v(v1r,nr)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}   ; imag power
  es1mag_m  s_m 0 value = {v(v_m)*v(i_m) * sfactor/vfactor }  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  rvm v_m 0 1e12
  rpm p_m  0 1e12
  rqm q_m 0 1e12
  rim i_m 0 1e12
  rsm s_m 0 1e12
  rmax1   v1r  0  1e12
  rmax2   v1i  0  1e12
.ends
*$

* Three phase voltage source with neutral ports
.subckt vri_3phase_n_LF v1r v1i v2r v2i v3r v3i nr ni v1_m p1_m q1_m v2_m p2_m q2_m v3_m p3_m q3_m
+ params:
+ on = 1
+ v = 110000
+ delta1 = 0
+ delta2 = -120
+ delta3 = 120
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ gin = 1e3
.param vL1r = {v*cos(delta1*3.1415926535897935/180)}
.param vL1i = {v*sin(delta1*3.1415926535897935/180)}
.param vL2r = {v*cos(delta2*3.1415926535897935/180)}
.param vL2i = {v*sin(delta2*3.1415926535897935/180)}
.param vL3r = {v*cos(delta3*3.1415926535897935/180)}
.param vL3i = {v*sin(delta3*3.1415926535897935/180)}
  gv1r     v10    v1r  value =  { on*(vL1r/vfactor)*gin } tripdv={TRIPDV} tripdt={TRIPDT}  ; real volt output
  gv1i     v1a    v1i  value =  { on*(vL1i/vfactor)*gin } tripdv={TRIPDV} tripdt={TRIPDT}  ; imag volt output
  gr1r     v1r    v10  value =  { on*v(v1r,nr)*gin } tripdv={TRIPDV} tripdt={TRIPDT}
  gr1i     v1i    v1a  value =  { on*v(v1i,ni)*gin } tripdv={TRIPDV} tripdt={TRIPDT}
  vi1r     v10    nr   dc   0v
  vi1i     v1a    ni   dc   0v
  gv2r     v20    v2r  value =  { on*(vL2r/vfactor)*gin } tripdv={TRIPDV} tripdt={TRIPDT}  ; real volt output
  gv2i     v2a    v2i  value =  { on*(vL2i/vfactor)*gin } tripdv={TRIPDV} tripdt={TRIPDT}  ; imag volt output
  gr2r     v2r    v20  value =  { on*v(v2r,nr)*gin } tripdv={TRIPDV} tripdt={TRIPDT}
  gr2i     v2i    v2a  value =  { on*v(v2i,ni)*gin } tripdv={TRIPDV} tripdt={TRIPDT}
  vi2r     v20    nr   dc   0v
  vi2i     v2a    ni   dc   0v
  gv3r     v30    v3r  value =  { on*(vL3r/vfactor)*gin } ; real volt output
  gv3i     v3a    v3i  value =  { on*(vL3i/vfactor)*gin } ; imag volt output
  gr3r     v3r    v30  value =  { on*v(v3r,nr)*gin }
  gr3i     v3i    v3a  value =  { on*v(v3i,ni)*gin }
  vi3r     v30    nr   dc   0v
  vi3i     v3a    ni   dc   0v
  * measurement stuff
  evabs1_m  v1_m 0 value = {vfactor*sqrt(v(v1r,nr)*v(v1r,nr)+v(v1i,ni)*v(v1i,ni))}  tripdv={TRIPDV} tripdt={TRIPDT} ; abs. voltage
  ep1       p1_m 0 value = {(v(v1r,nr)*i(vi1r)+v(v1i,ni)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}   ; real power
  eq1       q1_m 0 value = {(v(v1i,ni)*i(vi1r)-v(v1r,nr)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}   ; imag power
  evabs2_m  v2_m 0 value = {vfactor*sqrt(v(v2r,nr)*v(v2r,nr)+v(v2i,ni)*v(v2i,ni))}  tripdv={TRIPDV} tripdt={TRIPDT} ; abs. voltage
  ep2       p2_m 0 value = {(v(v2r,nr)*i(vi2r)+v(v2i,ni)*i(vi2i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}  ; real power
  eq2       q2_m 0 value = {(v(v2i,ni)*i(vi2r)-v(v2r,nr)*i(vi2i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}  ; imag power
  evabs3_m  v3_m 0 value = {vfactor*sqrt(v(v3r,nr)*v(v3r,nr)+v(v3i,ni)*v(v3i,ni))}  tripdv={TRIPDV} tripdt={TRIPDT} ; abs. voltage
  ep3       p3_m 0 value = {(v(v3r,nr)*i(vi3r)+v(v3i,ni)*i(vi3i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}   ; real power
  eq3       q3_m 0 value = {(v(v3i,ni)*i(vi3r)-v(v3r,nr)*i(vi3i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}   ; imag power
  revabs1_m  v1_m 0 1e12
  rep1       p1_m 0 1e12
  req1       q1_m 0 1e12
  revabs2_m  v2_m 0 1e12
  rep2       p2_m 0 1e12
  req2       q2_m 0 1e12
  revabs3_m  v3_m 0 1e12
  rep3       p3_m 0 1e12
  req3       q3_m 0 1e12
  rmax1   v1r  0  1e12
  rmax1a  v1i  0  1e12
  rmax2   v2r  0  1e12
  rmax2a  v2i  0  1e12
  rmax3   v3r  0  1e12
  rmax3a  v3i  0  1e12
.ends
*$

* Load model with three modes
* k=0 is constant impedance mode
* k=1 is constant current mode
* k=2 is constant power mode
.subckt loads_LF v1r v1i v1_m p1_m q1_m
+ params:
+ on = 1
+ p  = 0
+ q  = 0
+ vn = 120000
+ k = 2 ; std. is constpower
+ ilolim=-10000
+ iuplim=10000
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ v1r={vn/vfactor} ; real part of voltage for constcurrent
+ v1i=0            ; imag part of voltage for constcurrent
+ uout=1
.param k0 = { IF((k<=0),1,0) }
.param k2 = { IF((k>=2),1,0) }
.param k1 = { 1-k0-k2 }
.param v2 = {v1r*v1r+v1i*v1i}
.param p1 = {p/sfactor}
.param q1 = {q/sfactor}
  vss     ss    0    1 ; for source stepping convergence
* constpower k2
  gi1r1   v1r   v10  Value = { LIMIT(v(li1r),ilolim,iuplim) } tripdv={TRIPDV} tripdt={TRIPDT} ; i1r
  gi1i1   v1i   v20  Value = { LIMIT(v(li1i),ilolim,iuplim) } tripdv={TRIPDV} tripdt={TRIPDT} ; i1i
  g1lir   0    li1r  Value = { k2*(((p*v(ss)*v(ss)*on/sfactor)*v(v1r))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)) +
  +                           ((q*v(ss)*v(ss)*on/sfactor)*v(v1i))/(v(v1r)*v(v1r)+v(v1i)*v(v1i))) } rpar=1 tripdv={TRIPDV} tripdt={TRIPDT} ;
  g1lii   0    li1i  Value = { k2*(((-q*v(ss)*v(ss)*on/sfactor)*v(v1r))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)) +
  +                           ((p*v(ss)*v(ss)*on/sfactor)*v(v1i))/(v(v1r)*v(v1r)+v(v1i)*v(v1i))) } rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
* constcurrent k1 (v1r=vn/vfactor v1i=0) assumed !!!
.param ir={(p1*v1r+q1*v1i)/v2}
.param ii={-(q1*v1r-p1*v1i)/v2} ;
  gi1r    v1r    v10  value =  { LIMIT((k1*on*ir),ilolim,iuplim) } tripdv={TRIPDV} tripdt={TRIPDT}; i1r
  gi1i    v1i    v20  value =  { LIMIT((k1*on*ii),ilolim,iuplim) } tripdv={TRIPDV} tripdt={TRIPDT}; i1i
* constimpedance  k0
.param gp = {(p/sfactor)/(vn*vn/vfactor/vfactor)}
.param gq = {(q/sfactor)/(vn*vn/vfactor/vfactor)}
  gi1r2   v1r   v10 value = {LIMIT(v(li2r),ilolim,iuplim)} tripdv={TRIPDV} tripdt={TRIPDT} ; i1r
  gi1i2   v1i   v20 value = {LIMIT(v(li2i),ilolim,iuplim)} tripdv={TRIPDV} tripdt={TRIPDT} ; i1i
  g2ir  0  li2r Value = {(k0*on*(gq*v(v1i)+gp*v(v1r)))} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  g2ii  0  li2i Value = {(-k0*on*(gq*v(v1r)-gp*v(v1i)))} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  vi1r   v10   0    dc 0v;   currentmeter
  vi1i   v20   0    dc 0v;   currentmeter
  * to enable more measurement -> make additional nodes in first line and uncomment following lines
  * for inst. to enable measurement of i1_m(magnitude of i1) uncomment ei1mag_m and gi1mag_m and
  * insert additional node (i1_m) in .subckt line
  eiabs_m   i1_m 0 value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))}  tripdv={TRIPDV} tripdt={TRIPDT}  ; abs. current
  ev1mag_m  v1_m 0 value = {uout*vfactor * sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))+(1-uout)*v(i1_m)}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  es1mag_m  s1_m 0 value = {sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))*v(i1_m) * sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  * real,imag - parts of p,q,pv,qv,v1r,v1i
  ep1 p1_m 0 value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq1 q1_m 0 value = {(v(v1i)*i(vi1r)-v(v1r)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  rvm v1_m 0 1e12
  rpm p1_m  0 1e12
  rqm q1_m 0 1e12
  rim i1_m 0 1e12
  rsm s1_m 0 1e12
  rmax1   v1r  0  1e12
  rmax2   v1i  0  1e12
.ends
*
*$
*
* Model for Constpower - Component
*
*
*
* Load model only with constant power mode
.subckt constpower_LF v1r v1i v1_m p1_m q1_m
+ params:
+ on = 1
+ p  = 0
+ q  = 0
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ ilolim=-100e9
+ iuplim=100e9
+ uout=1
  vss    ss    0    1  ; additional voltage for source stepping convergence
  gi1r   v1r   v10  Value = {LIMIT( ((p*v(ss)*v(ss)*on/sfactor)*v(v1r))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)) +
  +                           ((q*v(ss)*v(ss)*on/sfactor)*v(v1i))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)),ilolim,iuplim) } tripdv={TRIPDV} tripdt={TRIPDT} ; i1r
  gi1i   v1i   v20  Value = {LIMIT( ((-q*v(ss)*v(ss)*on/sfactor)*v(v1r))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)) +
  +                           ((p*v(ss)*v(ss)*on/sfactor)*v(v1i))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)),ilolim,iuplim) } tripdv={TRIPDV} tripdt={TRIPDT} ; i1i
  vi1r   v10   0    dc 0v;   currentmeter
  vi1i   v20   0    dc 0v;   currentmeter
  eiabs_m   i1_m 0 value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))}  tripdv={TRIPDV} tripdt={TRIPDT}  ; abs. current
  ev1mag_m  v1_m 0 value = {uout*vfactor * sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))+(1-uout)*v(i1_m)}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  es1mag_m  s1_m 0 value = {sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))*v(i1_m) * sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  ep1 p1_m 0 value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq1 q1_m 0 value = {(v(v1i)*i(vi1r)-v(v1r)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  rvm v1_m 0 1e12
  rpm p1_m  0 1e12
  rqm q1_m 0 1e12
  rim i1_m 0 1e12
  rsm s1_m 0 1e12
  rmax1   v1r  0  1e12
  rmax2   v1i  0  1e12
.ends


* Same as constpower_LF
.subckt constpower_boot_LF v1r v1i v1_m p1_m q1_m
+ params:
+ on = 1
+ p  = 0
+ q  = 0
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ ilolim=-100e9
+ iuplim=100e9
  vss    ss    0    1  ; additional voltage for source stepping convergence
  gi1r   v1r   v10  Value = {LIMIT( ((p*v(ss)*v(ss)*on/sfactor)*v(v1r))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)) +
  +                           ((q*v(ss)*v(ss)*on/sfactor)*v(v1i))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)),ilolim,iuplim) } tripdv={TRIPDV} tripdt={TRIPDT} ; i1r
  gi1i   v1i   v20  Value = {LIMIT( ((-q*v(ss)*v(ss)*on/sfactor)*v(v1r))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)) +
  +                           ((p*v(ss)*v(ss)*on/sfactor)*v(v1i))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)),ilolim,iuplim) } tripdv={TRIPDV} tripdt={TRIPDT} ; i1i
  vi1r   v10   0    dc 0v;   currentmeter
  vi1i   v20   0    dc 0v;   currentmeter
  eiabs_m   i1_m 0 value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))}  tripdv={TRIPDV} tripdt={TRIPDT}  ; abs. current
  ev1mag_m  v1_m 0 value = {vfactor * sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  es1mag_m  s1_m 0 value = {v(v1_m)*v(i1_m) * sfactor/vfactor }  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  ep1 p1_m 0 value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq1 q1_m 0 value = {(v(v1i)*i(vi1r)-v(v1r)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  rvm v1_m 0 1e12
  rpm p1_m  0 1e12
  rqm q1_m 0 1e12
  rim i1_m 0 1e12
  rsm s1_m 0 1e12
  rmax1   v1r  0  1e12
  rmax2   v1i  0  1e12
.ends
*$


*
* Model for transformer lfl - component
*
* This model has an old compatibility mode where the transformer is defined by ykr,yki,y0r,y0i
* and a new interface with SN,U1Nenn,... parameters same as in the transient toolbox
* If old parameter are given on the parameterline these parameters are used instead of new parameters
* If these parameter are not given the new parameters are used !!!
* NOTE: Since the sign of L_ tap or S_ tap value is not normed and dependent of the transformer manufacturer
* you can change the behaviour with sign1 and sign2 set to -1 or 1 
.subckt transformer_LF v1r v1i v2r v2i p1_m q1_m v1_m v2_m p2_m q2_m
+ params:
+ on = 1
+ SN=300e6
+ U1Nenn=400e3
+ U20=120e3
+	uR=0.002
+	uX=0.2
+	i0=0.0006
+	p0=0.0004
+ stproz  = 1.0 ; percentvalue per voltage or phase tap
+ l_ = 0  ; voltage tap
+ s_ = 0  ; phase tap
+ middle = 0  ; middle postion of voltage and phase taps
+ phir = -0.5 ; additional phase for phase regulation real part (change this according to your transformer setting)
+ phii = -0.866025404 ; additional phase for phase regulation imaginary part (change this according to your transformer setting)
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ zqfactor = 1.0
+ zlfactor = 1.0
+ sign1=1
+ sign2=1
+ uout=1
***************************************************
.param delta=0
.param uerfact={(cos(-delta*3.1415926535897935/180))}
.param ueifact={(sin(-delta*3.1415926535897935/180))}
.param ue={U1Nenn/U20}             ; translation factor at l_=0
.param inos={SN/U1Nenn/sqrt(3)}    ; nominal current on primary side
.param inus={inos*U1Nenn/U20}      ; nominal current on secondary side
.param z1n={U1Nenn/sqrt(3)/inos}           ; nominal impedance
.param rkos={z1n*ur}             ; ohmic part of short circuit impedance -> cooper lost
.param xkos={z1n*ux}            ; inductive part of short circuit impedance
.param rfeos={U1Nenn*U1Nenn/(p0*SN)}  ; lost due to iron modelled as resistance
.param xhos={U1Nenn*U1Nenn/(SN*sqrt(i0*i0-p0*p0))}  ; magnetic field inductance
.param vfe={p0*SN}   ; iron_lost
.param vcu={ur*SN}   ; copper lost
.param imue={(U1Nenn/sqrt(3))/xhos}     ; current to magnetize iron
.param ife={(U1Nenn/sqrt(3))/rfeos}     ; current due to iron lost
.param i0abs={sqrt(imue*imue+ife*ife)}  ; open circuit current = ife + imue
.param ukn={sqrt(ur*ur+ux*ux)}          ; short circuit impedance
.param ykr={rkos/(rkos*rkos+xkos*xkos)}
.param yki={-xkos/(rkos*rkos+xkos*xkos)}
.param y0r={1/rfeos}
.param y0i={-1/xhos}
**************************************************
.param ykr1 = {ykr/zlfactor}
.param yki1 = {yki/zlfactor}
.param y0r1 = {y0r/zqfactor}
.param y0i1 = {y0i/zqfactor}
.param reL = {ue*(sign1*l_-middle)*stproz/100}
.param reS = {ue*(sign2*s_-middle)*stproz/100}
.param ue1r= {ue*(uerfact)+(reL*uerfact)-reS*(ueifact*phii)+reS*(uerfact*phir)}
.param ue1i= {ue*(ueifact)+(reL*ueifact)+reS*(uerfact*phii)+reS*(ueifact*phir)}
.param gar = {(ykr1+0.5*y0r1)*on}
.param gai = {(yki1+0.5*y0i1)*on}
.param gbr = {(-ue1r*ykr1+ue1i*yki1)*on}
.param gbi = {(-ue1i*ykr1-ue1r*yki1)*on}
.param gcr = {(-ue1r*ykr1-ue1i*yki1)*on}
.param gci = { (ue1i*ykr1-ue1r*yki1)*on}
.param gdr = { gar*(ue1r*ue1r+ue1i*ue1i)}
.param gdi = { gai*(ue1r*ue1r+ue1i*ue1i)}
  gi1r   v1r   v10  Value = {v(v1r)*gar - v(v1i)*gai + v(v2r)*gbr - v(v2i)*gbi} tripdv={TRIPDV} tripdt={TRIPDT} ; i1r
  gi1i   v1i   v20  Value = {v(v1r)*gai + v(v1i)*gar + v(v2r)*gbi + v(v2i)*gbr} tripdv={TRIPDV} tripdt={TRIPDT} ; i1i
  gi2r   v2r   v30  Value = {v(v1r)*gcr - v(v1i)*gci + v(v2r)*gdr - v(v2i)*gdi} tripdv={TRIPDV} tripdt={TRIPDT} ; i2r
  gi2i   v2i   v40  Value = {v(v1r)*gci + v(v1i)*gcr + v(v2r)*gdi + v(v2i)*gdr} tripdv={TRIPDV} tripdt={TRIPDT} ; i2i
  vi1r   v10   0    dc 0v;   Current measurment
  vi1i   v20   0    dc 0v;   Current measurment
  vi2r   v30   0    dc 0v;   Current measurment
  vi2i   v40   0    dc 0v;   Current measurment
  ev1mag_m v1_m 0 value = {uout*vfactor * sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))+(1-uout)*v(i1_m)}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  ev2mag_m v2_m 0 value = {uout*vfactor * sqrt(v(v2r)*v(v2r)+v(v2i)*v(v2i))+(1-uout)*v(i2_m)}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  ei1mag_m i1_m 0 value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  ei2mag_m i2_m 0 value = {sqrt(i(vi2r)*i(vi2r)+i(vi2i)*i(vi2i))}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  es1mag_m s1_m 0 value = {v(v1_m)*v(i1_m) * sfactor/vfactor }  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  ep1 p1_m 0  value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  ep2 p2_m 0  value = {(v(v2r)*i(vi2r)+v(v2i)*i(vi2i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq1 q1_m 0  value = {(v(v1i)*i(vi1r)-v(v1r)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq2 q2_m 0  value = {(v(v2i)*i(vi2r)-v(v2r)*i(vi2i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  epv  pv_m 0  value = {v(p1_m)+v(p2_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  eqv  qv_m 0  value = {v(q1_m)+v(q2_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  rvm1 v1_m 0 1e12
  rpm1 p1_m  0 1e12
  rqm1 q1_m 0 1e12
  rim1 i1_m 0 1e12
  rim2 i2_m 0 1e12
  rsm1 s1_m 0 1e12
  rvm2 v2_m 0 1e12
  rpm2 p2_m  0 1e12
  rqm2 q2_m 0 1e12
  rpv pv_m 0 1e12
  rqv qv_m 0 1e12
  rmax1  v1r  0   1e12
  rmax2  v1i  0   1e12
  rmax3  v2r  0   1e12
  rmax4  v2i  0   1e12
.ends
*$
*
*
* like the normal transformer but now with additional neutral port
* NOTE: Since the sign of L_ tap and S_ tap value is not normed and dependent of the transformer manufacturer
* you can change the behaviour with sign1 and sign2 set to -1 or 1
.subckt transformer_extd_LF v1r n1r v1i n1i v2r n2r v2i n2i p1_m q1_m v1_m v2_m p2_m q2_m
+ on = 1
+ SN=300e6
+ U1Nenn=400e3
+ U20=120e3
+	uR=0.002
+	uX=0.2
+	i0=0.0006
+	p0=0.0004
+ stproz  = 1.0
+ l_ = 0
+ s_ = 0
+ middle = 0
+ phir = -0.5
+ phii = -0.866025404
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ zqfactor = 1.0
+ zlfactor = 1.0
+ sign1=1
+ sign2=1
***************************************************
.param delta=0
.param uerfact={(cos(-delta*3.1415926535897935/180))}
.param ueifact={(sin(-delta*3.1415926535897935/180))}
.param ue={U1Nenn/U20}             ; translation factor at l_=0
.param inos={SN/U1Nenn/sqrt(3)}    ; nominal current on primary side
.param inus={inos*U1Nenn/U20}      ; nominal current on secondary side
.param z1n={U1Nenn/sqrt(3)/inos}           ; nominal impedance
.param rkos={z1n*ur}             ; ohmic part of short circuit impedance -> cooper lost
.param xkos={z1n*ux}            ; inductive part of short circuit impedance
.param rfeos={U1Nenn*U1Nenn/(p0*SN)}  ; lost due to iron modelled as resistance
.param xhos={U1Nenn*U1Nenn/(SN*sqrt(i0*i0-p0*p0))}  ; magnetic field inductance
.param vfe={p0*SN}   ; iron_lost
.param vcu={ur*SN}   ; copper lost
.param imue={(U1Nenn/sqrt(3))/xhos}     ; current to magnetize iron
.param ife={(U1Nenn/sqrt(3))/rfeos}     ; current due to iron lost
.param i0abs={sqrt(imue*imue+ife*ife)}  ; open circuit current = ife + imue
.param ukn={sqrt(ur*ur+ux*ux)}          ; short circuit impedance
.param ykr={rkos/(rkos*rkos+xkos*xkos)}
.param yki={-xkos/(rkos*rkos+xkos*xkos)}
.param y0r={1/rfeos}
.param y0i={-1/xhos}
**************************************************
.param ykr1 = {ykr/zlfactor}
.param yki1 = {yki/zlfactor}
.param y0r1 = {y0r/zqfactor}
.param y0i1 = {y0i/zqfactor}
.param reL = {ue*(l_*sign1-middle)*stproz/100}
.param reS = {ue*(s_*sign2-middle)*stproz/100}
.param ue1r= {ue*(uerfact)+(reL*uerfact)-reS*(ueifact*phii)+reS*(uerfact*phir)}
.param ue1i= {ue*(ueifact)+(reL*ueifact)+reS*(uerfact*phii)+reS*(ueifact*phir)}
.param gar = {(ykr1+0.5*y0r1)*on}
.param gai = {(yki1+0.5*y0i1)*on}
.param gbr = {(-ue1r*ykr1+ue1i*yki1)*on}
.param gbi = {(-ue1i*ykr1-ue1r*yki1)*on}
.param gcr = {(-ue1r*ykr1-ue1i*yki1)*on}
.param gci = { (ue1i*ykr1-ue1r*yki1)*on}
.param gdr = { gar*(ue1r*ue1r+ue1i*ue1i)}
.param gdi = { gai*(ue1r*ue1r+ue1i*ue1i)}
ggi1r   v1r   v10  value = {v(v1r,n1r) * gar - v(v1i,n1i) * gai + v(v2r,n2r) * gbr - v(v2i,n2i) * gbi} tripdv={TRIPDV} tripdt={TRIPDT}
ggi1i   v1i   v20  value = {v(v1r,n1r) * gai + v(v1i,n1i) * gar + v(v2r,n2r) * gbi + v(v2i,n2i) * gbr} tripdv={TRIPDV} tripdt={TRIPDT}
ggi2r   v2r   v30  value = {v(v1r,n1r) * gcr - v(v1i,n1i) * gci + v(v2r,n2r) * gdr - v(v2i,n2i) * gdi} tripdv={TRIPDV} tripdt={TRIPDT}
ggi2i   v2i   v40  value = {v(v1r,n1r) * gci + v(v1i,n1i) * gcr + v(v2r,n2r) * gdi + v(v2i,n2i) * gdr} tripdv={TRIPDV} tripdt={TRIPDT}
vi1r   v10   n1r    dc 0v
vi1i   v20   n1i    dc 0v
vi2r   v30   n2r    dc 0v
vi2i   v40   n2i    dc 0v
ev1mag_m v1_m 0 value = {vfactor*sqrt(v(v1r,n1r)*v(v1r,n1r)+v(v1i,n1i)*v(v1i,n1i))}  tripdv={TRIPDV} tripdt={TRIPDT}
ev2mag_m v2_m 0 value = {vfactor*sqrt(v(v2r,n2r)*v(v2r,n2r)+v(v2i,n2i)*v(v2i,n2i))}  tripdv={TRIPDV} tripdt={TRIPDT}
ei1mag_m  i1_m 0 value={sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))} tripdv={TRIPDV} tripdt={TRIPDT}
ei2mag_m  i2_m 0 value={sqrt(i(vi2r)*i(vi2r)+i(vi2i)*i(vi2i))}  tripdv={TRIPDV} tripdt={TRIPDT}
es1mag_m  s1_m 0 value={v(v1_m)*v(i1_m)*sfactor/vfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
ep1 p1_m 0 value={(v(v1r,n1r)*i(vi1r)+v(v1i,n1i)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
ep2 p2_m 0 value={(v(v2r,n2r)*i(vi2r)+v(v2i,n2i)*i(vi2i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
eq1 q1_m 0 value={(v(v1i,n1i)*i(vi1r)-v(v1r,n1r)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
eq2 q2_m 0 value={(v(v2i,n2i)*i(vi2r)-v(v2r,n2r)*i(vi2i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
epv pv_m 0  value={v(p1_m)+v(p2_m)}  tripdv={TRIPDV} tripdt={TRIPDT}
eqv qv_m 0  value={v(q1_m)+v(q2_m)}  tripdv={TRIPDV} tripdt={TRIPDT}
  rvm1 v1_m 0 1e12
  rpm1 p1_m  0 1e12
  rqm1 q1_m 0 1e12
  rim1 i1_m 0 1e12
  rim2 i2_m 0 1e12
  rsm1 s1_m 0 1e12
  rvm2 v2_m 0 1e12
  rpm2 p2_m  0 1e12
  rqm2 q2_m 0 1e12
  rpv pv_m 0 1e12
  rqv qv_m 0 1e12
rmax1  v1r  0   1e12
rmax2  v1i  0   1e12
rmax3  v2r  0   1e12
rmax4  v2i  0   1e12
.ends
*$
*
*
*
*
* Three phase Yy0 transformer with additional neutral ports (e.g. for petersen coil)
* NOTE: Since the sign of L/S_ tap value is not normed and dependent of the transformer manufacturer
* you can change the behaviour with sign1 and sign2 set to -1 or 1
.subckt trafo_Yy0_LF r1r r1i s1r s1i t1r t1i n1r n1i r2r r2i s2r s2i t2r t2i n2r n2i
+ params:
+ on = 1
+ SN=300e6
+ U1Nenn=400e3
+ U20=120e3
+	uR=0.002
+	uX=0.2
+	i0=0.0006
+	p0=0.0004
+ stproz  = 1.0
+ l_ = 0
+ s_ = 0
+ middle = 0
+ phir = -0.5
+ phii = -0.866025404
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ zqfactor = 1.0
+ zlfactor = 1.0
+ sign1=1
+ sign2=1
* ----------------- *
*+ ue={U1Nenn/U20}
+ lp = 1000
+ rp = 0.001
+ w=314.159
+ k=0.9999
+ rfe=1e6
XRUr1 r1r n1r r1i n1i r2r n2r r2i n2i  p1r_m q1r_m v1r_m v2r_m p2r_m q2r_m transformer_extd_LF
+ on={on} SN={SN/3} ur={ur} ux={ux} i0={i0} p0={p0} sign1={sign1} sign2={sign2}
+ U1Nenn={U1Nenn/sqrt(3)}  U20={U20/sqrt(3)} sfactor={sfactor} vfactor={vfactor}
+ delta={delta} stproz={stproz} l_={l_} s_={s_} phir={phir} phii={phii} zqfactor={zqfactor} zlfactor={zlfactor}
XRUs1 s1r n1r s1i n1i s2r n2r s2i n2i p1s_m q1s_m v1s_m v2s_m p2s_m q2s_m transformer_extd_LF
+ on={on} SN={SN/3} ur={ur} ux={ux} i0={i0} p0={p0} sign1={sign1} sign2={sign2}
+ U1Nenn={U1Nenn/sqrt(3)}  U20={U20/sqrt(3)} sfactor={sfactor} vfactor={vfactor}
+ delta={delta} stproz={stproz} l_={l_} s_={s_} phir={phir} phii={phii} zqfactor={zqfactor} zlfactor={zlfactor}
XRUt1 t1r n1r t1i n1i t2r n2r t2i n2i p1t_m q1t_m v1t_m v2t_m p2t_m q2t_m transformer_extd_LF
+ on={on} SN={SN/3} ur={ur} ux={ux} i0={i0} p0={p0} sign1={sign1} sign2={sign2}
+ U1Nenn={U1Nenn/sqrt(3)}  U20={U20/sqrt(3)} sfactor={sfactor} vfactor={vfactor}
+ delta={delta} stproz={stproz} l_={l_} s_={s_} phir={phir} phii={phii} zqfactor={zqfactor} zlfactor={zlfactor}
* alternative model
* XRUr1 r1r n1r r1i n1i r2r n2r r2i n2i  p1r_m q1r_m v1r_m v2r_m p2r_m q2r_m l1l2k12_LF on={on} ue={ue} sfactor={sfactor} vfactor={vfactor}
* + lp={lp} rp={rp} w={w} k={k} rfe={rfe}
* XRUs1 s1r n1r s1i n1i s2r n2r s2i n2i  p1s_m q1s_m v1s_m v2s_m p2s_m q2s_m l1l2k12_LF on={on} ue={ue} sfactor={sfactor} vfactor={vfactor}
* + lp={lp} rp={rp} w={w} k={k} rfe={rfe}
* XRUt1 t1r n1r t1i n1i t2r n2r t2i n2i  p1t_m q1t_m v1t_m v2t_m p2t_m q2t_m l1l2k12_LF on={on} ue={ue} sfactor={sfactor} vfactor={vfactor}
* + lp={lp} rp={rp} w={w} k={k} rfe={rfe}
