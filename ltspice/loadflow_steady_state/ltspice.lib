*$


* Model for line lfl - Component
* cb is the nominal working cappacitance of the line to line cap. and the line to earth cap.
* cb is related to a one phase loadflow simulation
*
.subckt line_LF v1r v1i v2r v2i p1_m q1_m v1_m p2_m q2_m
+ params:
+ on = 1
+ r = 0.15
+ l=0
+ xl = 0.4
+ cb = 8.5n
+ ce = 3.5n
+ g = 1e12
+ length = 1
+ omega = {omega_n}
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ zqfactor = 1.0
+ zlfactor = 1.0
+ uout=1
.param xl1=IF(xl>0,xl,omega*l)
.param cl = {(cb-ce)/3}
.param c = { ce + 3*cl } ; Dies ist eigentlich cb -> man kann nur mit cb rechnen (für einphasige Rechnung !!!)
.param z1r = {zlfactor*length*r}
.param z1i = {zlfactor*length*xl1}
.param z0r = {(g*2)/length }
.param z0i = {-2*zqfactor/(length*omega*c)}
.param g0r = {(1/z0r)*on}
.param g0i = {(-1/z0i)*on}
.param g1r = {(z1r*on)/(z1r*z1r+z1i*z1i)}
.param g1i = {(-z1i*on)/(z1r*z1r+z1i*z1i)}
.param gr = {g1r+g0r}
.param gi = {g1i+g0i}
  gi1r   v1r   v01  Value = {v(v1r)*gr - v(v1i)*gi - v(v2r)*g1r + v(v2i)*g1i} tripdv={TRIPDV} tripdt={TRIPDT} ; i1r
  gi1i   v1i   v02  Value = {v(v1r)*gi + v(v1i)*gr - v(v2r)*g1i - v(v2i)*g1r} tripdv={TRIPDV} tripdt={TRIPDT} ; i1i
  gi2r   v2r   v03  Value = {-v(v1r)*g1r + v(v1i)*g1i + v(v2r)*gr - v(v2i)*gi} tripdv={TRIPDV} tripdt={TRIPDT} ; i2r
  gi2i   v2i   v04  Value = {-v(v1r)*g1i - v(v1i)*g1r + v(v2r)*gi + v(v2i)*gr} tripdv={TRIPDV} tripdt={TRIPDT} ; i2i
  vi1r   v01   0    dc 0v;   Strommessung fuer p1,q1,s1,i1
  vi1i   v02   0    dc 0v;   Strommessung fuer p1,q1,s1,i1
  vi2r   v03   0    dc 0v;   Strommessung fuer p2,q2,s2,i2
  vi2i   v04   0    dc 0v;   Strommessung fuer p2,q2,s2,i2
  ev1mag_m v1_m 0 value = {uout*vfactor * sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))+(1-uout)*0.5*(v(i1_m)+v(i2_m))} tripdv={TRIPDV} tripdt={TRIPDT}
  ev2mag_m v2_m 0 value = {vfactor * sqrt(v(v2r)*v(v2r)+v(v2i)*v(v2i))} tripdv={TRIPDV} tripdt={TRIPDT}
  ei1mag_m i1_m 0 value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))} tripdv={TRIPDV} tripdt={TRIPDT}
  ei2mag_m i2_m 0 value = {sqrt(i(vi2r)*i(vi2r)+i(vi2i)*i(vi2i))} tripdv={TRIPDV} tripdt={TRIPDT}
  es1mag_m s1_m 0 value = {sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))*v(i1_m) * sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  ep1 p1_m 0  value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  ep2 p2_m 0  value = {(v(v2r)*i(vi2r)+v(v2i)*i(vi2i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  eq1 q1_m 0  value = {(v(v1i)*i(vi1r)-v(v1r)*i(vi1i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  eq2 q2_m 0  value = {(v(v2i)*i(vi2r)-v(v2r)*i(vi2i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  epv pv_m 0  value = {v(p1_m)+v(p2_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  eqv qv_m 0  value = {v(q1_m)+v(q2_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  rv1mag v1_m 0 1e12
  rv2mag v2_m 0 1e12
  ri1mag i1_m 0 1e12
  ri2mag i2_m 0 1e12
  rsmag s1_m 0 1e12
  rp1 p1_m  0 1e12
  rp2 p2_m  0 1e12
  rq1 q1_m  0 1e12
  rq2 q2_m  0 1e12
  rpv pv_m  0 1e12
  rqv qv_m  0 1e12
  rmax1  v1r  0   1e12
  rmax2  v1i  0   1e12
  rmax3  v2r  0   1e12
  rmax4  v2i  0   1e12
.ends
*
*
*
*
*
* Model for impedance component
.subckt impedance_LF v1r v1i v2r v2i p1_m q1_m v1_m p2_m q2_m
+ params:
+ on = 1
+ r = 100;
+ xl = 0
+ xc = 0
+ length = 1
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ zfactor = 1.0
+ uout=1
.param z1r = {(zfactor*length*r)}
.param z1i = {(zfactor*length*(xl-xc))}
.param g1r = {(z1r/(z1r*z1r+z1i*z1i))*on}
.param g1i = {(-z1i/(z1r*z1r+z1i*z1i))*on}
gi12r   v1r   v01  Value = {v(v1r)*g1r - v(v1i)*g1i - v(v2r)*g1r + v(v2i)*g1i} tripdv={TRIPDV} tripdt={TRIPDT} ; i1r
gi12i   v1i   v02  Value = {v(v1r)*g1i + v(v1i)*g1r - v(v2r)*g1i - v(v2i)*g1r} tripdv={TRIPDV} tripdt={TRIPDT} ; i1i
*gi2r = -gi1r
*gi2i = -gi1i
*gi2r   v2r   v03  Value = {-v(v1r)*g1r + v(v1i)*g1i + v(v2r)*g1r - v(v2i)*g1i} tripdv={TRIPDV} tripdt={TRIPDT} ; i2r
*gi2i   v2i   v04  Value = {-v(v1r)*g1i - v(v1i)*g1r + v(v2r)*g1i + v(v2i)*g1r} tripdv={TRIPDV} tripdt={TRIPDT} ; i2i
vi12r   v01   v2r    dc 0v;   Currentmeter
vi12i   v02   v2i    dc 0v;   Currentmeter
*vi2r   v03   0    dc 0v;   Currentmeter
*vi2i   v04   0    dc 0v;   Currentmeter
ev1mag_m  v1_m 0 value = {uout*vfactor * sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))+(1-uout)*v(i1_m)} tripdv={TRIPDV} tripdt={TRIPDT}
ev2mag_m  v2_m 0 value = {vfactor * sqrt(v(v2r)*v(v2r)+v(v2i)*v(v2i))} tripdv={TRIPDV} tripdt={TRIPDT}
ei1mag_m  i1_m 0 value = {sqrt(i(vi12r)*i(vi12r)+i(vi12i)*i(vi12i))} tripdv={TRIPDV} tripdt={TRIPDT}
es1mag_m  s1_m 0 value = {sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))*v(i1_m) * sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
ep1 p1_m 0  value = {(v(v1r)*i(vi12r)+v(v1i)*i(vi12i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
ep2 p2_m 0  value = {-(v(v2r)*i(vi12r)+v(v2i)*i(vi12i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
eq1 q1_m 0  value = {(v(v1i)*i(vi12r)-v(v1r)*i(vi12i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
eq2 q2_m 0  value = {-(v(v2i)*i(vi12r)-v(v2r)*i(vi12i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
epv pv_m 0  value = {v(p1_m)+v(p2_m)} tripdv={TRIPDV} tripdt={TRIPDT}
eqv qv_m 0  value = {v(q1_m)+v(q2_m)} tripdv={TRIPDV} tripdt={TRIPDT}
rv1mag v1_m 0 1e12
rv2mag v2_m 0 1e12
ri1mag i1_m 0 1e12
rsmag s1_m 0 1e12
rp1 p1_m  0 1e12
rp2 p2_m  0 1e12
rq1 q1_m  0 1e12
rq2 q2_m  0 1e12
rpv pv_m  0 1e12
rqv qv_m  0 1e12
rmax1  v1r  0   1e12
rmax2  v1i  0   1e12
rmax3  v2r  0   1e12
rmax4  v2i  0   1e12
.ends
*$
*$
*
* Petersen coil element
.subckt petersen_LF v1r v1i v1_m i1_m z1_m
+ params:
+ on = 1
+ r_x = 0.03
+ vn = 10000
+ in = 600
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ zfactor = 1.0
.param zd = {vn/vfactor/in}
.param r = {r_x*zd}
.param xl = {sqrt(zd*zd-r*r)}
.param z1r = {(zfactor*r)}
.param z1i = {(zfactor*(xl))}
.param g1r = {(z1r/(z1r*z1r+z1i*z1i))*on}
.param g1i = {(-z1i/(z1r*z1r+z1i*z1i))*on}
  gi1r   v1r   v01  Value = {(v(v1r)*g1r-v(v1i)*g1i)} tripdv={TRIPDV} tripdt={TRIPDT} ; i1r
  gi1i   v1i   v02  Value = {(v(v1r)*g1i+v(v1i)*g1r)} tripdv={TRIPDV} tripdt={TRIPDT} ; i1i
  vi1r   v01   0    dc 0v;   Currentmeter
  vi1i   v02   0    dc 0v;   Currentmeter
  ev1mag_m  v1_m 0 value = {sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  ei1mag_m  i1_m 0 value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  ep1 p1_m 0 value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq1 q1_m 0 value = {(v(v1i)*i(vi1r)-v(v1r)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  ez1 z1_m 0 value = {v(v1_m)/v(i1_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  rv1mag v1_m 0 1e12
  ri1mag i1_m 0 1e12
  rp1 p1_m  0 1e12
  rq1 q1_m  0 1e12
  rz1 z1_m  0 1e12
  rmax1  v1r  0   1e12
  rmax2  v1i  0   1e12
.ends
*$
*
* short circuit reactance model
* place inline with the cable,overheadline
.subckt scr_LF v1r v1i v2r v2i v1_m p1_m q1_m v1_m p2_m q2_m
+ params:
+ on = 1
+ delta_un = 5
+ r_x = 0.03
+ vn = 10000
+ in = 600
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ zfactor = 1.0
+ uout=1
.param sd = {vfactor*vn*in}
.param zd = {delta_un*vn*vn/(100*sd)}
.param r = {r_x*zd}
.param xl = {sqrt(zd*zd-r*r)}
.param z1r = {(zfactor*r)}
.param z1i = {(zfactor*(xl))}
.param g1r = {(z1r/(z1r*z1r+z1i*z1i))*on}
.param g1i = {(-z1i/(z1r*z1r+z1i*z1i))*on}
  gi12r   v1r   v01  Value = {v(v1r)*g1r - v(v1i)*g1i - v(v2r)*g1r + v(v2i)*g1i} tripdv={TRIPDV} tripdt={TRIPDT} ; i1r
  gi12i   v1i   v02  Value = {v(v1r)*g1i + v(v1i)*g1r - v(v2r)*g1i - v(v2i)*g1r} tripdv={TRIPDV} tripdt={TRIPDT} ; i1i
  *gi2r = -gi1r
  *gi2i = -gi1i
  *gi2r   v2r   v03  Value = {-v(v1r)*g1r + v(v1i)*g1i + v(v2r)*g1r - v(v2i)*g1i} tripdv={TRIPDV} tripdt={TRIPDT} ; i2r
  *gi2i   v2i   v04  Value = {-v(v1r)*g1i - v(v1i)*g1r + v(v2r)*g1i + v(v2i)*g1r} tripdv={TRIPDV} tripdt={TRIPDT} ; i2i
  vi12r   v01   v2r    dc 0v;   Currentmeter
  vi12i   v02   v2i    dc 0v;   Currentmeter
  *vi2r   v03   0    dc 0v;   Currentmeter
  *vi2i   v04   0    dc 0v;   Currentmeter
  ev1mag_m v1_m 0 value = {uout*vfactor * sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))+(1-uout)*v(i1_m)}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  es1mag_m s1_m 0 value = {v(v1_m)*v(i1_m) * sfactor/vfactor } tripdv={TRIPDV} tripdt={TRIPDT}  ;
  ei1mag_m i1_m 0 value = {sqrt(i(vi12r)*i(vi12r)+i(vi12i)*i(vi12i))}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  ep1 p1_m 0  value = {(v(v1r)*i(vi12r)+v(v1i)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  ep2 p2_m 0  value = {-(v(v2r)*i(vi12r)+v(v2i)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq1 q1_m 0  value = {(v(v1i)*i(vi12r)-v(v1r)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq2 q2_m 0  value = {-(v(v2i)*i(vi12r)-v(v2r)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  epv pv_m 0  value = {v(p1_m)+v(p2_m)}  tripdv={TRIPDV} tripdt={TRIPDT}
  eqv qv_m 0  value = {v(q1_m)+v(q2_m)}  tripdv={TRIPDV} tripdt={TRIPDT}
  rv1mag v1_m 0 1e12
  ri1mag i1_m 0 1e12
  rsmag s1_m 0 1e12
  rp1 p1_m  0 1e12
  rp2 p2_m  0 1e12
  rq1 q1_m  0 1e12
  rq2 q2_m  0 1e12
  rpv pv_m  0 1e12
  rqv qv_m  0 1e12
  rmax1  v1r  0   1e12
  rmax2  v1i  0   1e12
  rmax3  v2r  0   1e12
  rmax4  v2i  0   1e12
.ends
*$


* Model for short circuit impedance of net
.SUBCKT Impedance_sk_LF  v1r v1i v2r v2i p1_m q1_m v1_m p2_m q2_m
+	PARAMS:
+ on = 1
+ SN=40e9 ; Short circuit apparent power
+ vn=400e3
+ r_x=0.1 ; resistance = 0.1*X
+ length=1
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ zfactor = 1.0
+ uout=1
.PARAM
+ xl={vn*vn/SN}
+ r={r_x*xl}
.param z1r = {(zfactor*length*r)}
.param z1i = {(zfactor*length*(xl))}
.param g1r = {(z1r/(z1r*z1r+z1i*z1i))*on}
.param g1i = {(-z1i/(z1r*z1r+z1i*z1i))*on}
  gi12r   v1r   v01  Value = {v(v1r)*g1r - v(v1i)*g1i - v(v2r)*g1r + v(v2i)*g1i} tripdv={TRIPDV} tripdt={TRIPDT} ; i1r
  gi12i   v1i   v02  Value = {v(v1r)*g1i + v(v1i)*g1r - v(v2r)*g1i - v(v2i)*g1r} tripdv={TRIPDV} tripdt={TRIPDT} ; i1i
  *gi2r = -gi1r
  *gi2i = -gi1i
  *gi2r   v2r   v03  Value = {-v(v1r)*g1r + v(v1i)*g1i + v(v2r)*g1r - v(v2i)*g1i} tripdv={TRIPDV} tripdt={TRIPDT} ; i2r
  *gi2i   v2i   v04  Value = {-v(v1r)*g1i - v(v1i)*g1r + v(v2r)*g1i + v(v2i)*g1r} tripdv={TRIPDV} tripdt={TRIPDT} ; i2i
  vi12r   v01   v2r    dc 0v;   Currentmeter
  vi12i   v02   v2i    dc 0v;   Currentmeter
  *vi2r   v03   0    dc 0v;   Currentmeter
  *vi2i   v04   0    dc 0v;   Currentmeter
  ev1mag_m  v1_m 0 value = {uout*vfactor * sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))+(1-uout)*v(i1_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  ev2mag_m  v2_m 0 value = {vfactor * sqrt(v(v2r)*v(v2r)+v(v2i)*v(v2i))} tripdv={TRIPDV} tripdt={TRIPDT}
  ei1mag_m  i1_m 0 value = {sqrt(i(vi12r)*i(vi12r)+i(vi12i)*i(vi12i))} tripdv={TRIPDV} tripdt={TRIPDT}
  es1mag_m  s1_m 0 value = {sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))*v(i1_m) * sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  ep1 p1_m 0  value = {(v(v1r)*i(vi12r)+v(v1i)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  ep2 p2_m 0  value = {-(v(v2r)*i(vi12r)+v(v2i)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq1 q1_m 0  value = {(v(v1i)*i(vi12r)-v(v1r)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq2 q2_m 0  value = {-(v(v2i)*i(vi12r)-v(v2r)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  epv pv_m 0  value = {v(p1_m)+v(p2_m)}  tripdv={TRIPDV} tripdt={TRIPDT}
  eqv qv_m 0  value = {v(q1_m)+v(q2_m)}  tripdv={TRIPDV} tripdt={TRIPDT}
  rv1mag v1_m 0 1e12
  rv2mag v2_m 0 1e12
  ri1mag i1_m 0 1e12
  rsmag s1_m 0 1e12
  rp1 p1_m  0 1e12
  rp2 p2_m  0 1e12
  rq1 q1_m  0 1e12
  rq2 q2_m  0 1e12
  rpv pv_m  0 1e12
  rqv qv_m  0 1e12
  rmax1  v1r  0   1e12
  rmax2  v1i  0   1e12
  rmax3  v2r  0   1e12
  rmax4  v2i  0   1e12
.ends
*$

* Model for impedance with input of p,q,v
.subckt impedance_pqv_LF v1r v1i v2r v2i p1_m q1_m v1_m p2_m q2_m
+ params:
+ on=1
+ p=1e6
+ q=0
+ vn=120000
+ length=1
+ vfactor={sqrt(3)}
+ sfactor=3
+ zfactor=1.0
.param ir={(vfactor/sfactor)*p/vn}
.param ii={-(vfactor/sfactor)*q/vn}
.param absi2={(ir)*(ir)+(ii)*(ii)}
.param tmp2={(vn)/((vfactor)*(absi2))}
.param z1r={(zfactor)*(length)*(tmp2)*(ir)}
.param z1i={-(zfactor)*(length)*(tmp2)*(ii)}
.param g1r={((z1r)/((z1r)*(z1r)+(z1i)*(z1i)))*on}
.param g1i={(-(z1i)/((z1r)*(z1r)+(z1i)*(z1i)))*on}
  gi12r   v1r   v01  Value = {v(v1r)*g1r - v(v1i)*g1i - v(v2r)*g1r + v(v2i)*g1i} tripdv={TRIPDV} tripdt={TRIPDT} ; i1r
  gi12i   v1i   v02  Value = {v(v1r)*g1i + v(v1i)*g1r - v(v2r)*g1i - v(v2i)*g1r} tripdv={TRIPDV} tripdt={TRIPDT} ; i1i
  *gi2r = -gi1r
  *gi2i = -gi1i
  *gi2r   v2r   v03  Value = {-v(v1r)*g1r + v(v1i)*g1i + v(v2r)*g1r - v(v2i)*g1i} tripdv={TRIPDV} tripdt={TRIPDT} ; i2r
  *gi2i   v2i   v04  Value = {-v(v1r)*g1i - v(v1i)*g1r + v(v2r)*g1i + v(v2i)*g1r} tripdv={TRIPDV} tripdt={TRIPDT} ; i2i
  vi12r   v01   v2r    dc 0v;   Currentmeter
  vi12i   v02   v2i    dc 0v;   Currentmeter
  *vi2r   v03   0    dc 0v;   Currentmeter
  *vi2i   v04   0    dc 0v;   Currentmeter
  ev1mag_m  v1_m 0 value = {vfactor * sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))} tripdv={TRIPDV} tripdt={TRIPDT}
  ev2mag_m  v2_m 0 value = {vfactor * sqrt(v(v2r)*v(v2r)+v(v2i)*v(v2i))} tripdv={TRIPDV} tripdt={TRIPDT}
  ei1mag_m  i1_m 0 value = {sqrt(i(vi12r)*i(vi12r)+i(vi12i)*i(vi12i))} tripdv={TRIPDV} tripdt={TRIPDT}
  es1mag_m  s1_m 0 value = {v(v1_m)*v(i1_m) * sfactor/vfactor } tripdv={TRIPDV} tripdt={TRIPDT}
  ep1 p1_m 0  value = {(v(v1r)*i(vi12r)+v(v1i)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  ep2 p2_m 0  value = {-(v(v2r)*i(vi12r)+v(v2i)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq1 q1_m 0  value = {(v(v1i)*i(vi12r)-v(v1r)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq2 q2_m 0  value = {-(v(v2i)*i(vi12r)-v(v2r)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  epv pv_m 0  value = {v(p1_m)+v(p2_m)}  tripdv={TRIPDV} tripdt={TRIPDT}
  eqv qv_m 0  value = {v(q1_m)+v(q2_m)}  tripdv={TRIPDV} tripdt={TRIPDT}
  rv1mag v1_m 0 1e12
  rv2mag v2_m 0 1e12
  ri1mag i1_m 0 1e12
  rsmag s1_m 0 1e12
  rp1 p1_m  0 1e12
  rp2 p2_m  0 1e12
  rq1 q1_m  0 1e12
  rq2 q2_m  0 1e12
  rpv pv_m  0 1e12
  rqv qv_m  0 1e12
  rmax1  v1r  0   1e12
  rmax2  v1i  0   1e12
  rmax3  v2r  0   1e12
  rmax4  v2i  0   1e12
.ends
*$
*$
*$
* Model for impedance with input ir,ii,vn
.subckt impedance_iv_LF v1r v1i v2r v2i p1_m q1_m v1_m p2_m q2_m
+ params:
+ on=1
+ ir=100
+ ii=0
+ vn=120000
+ length=1
+ vfactor={sqrt(3)}
+ sfactor=3
+ zfactor=1.0
.param absi2={(ir)*(ir)+(ii)*(ii)}
.param temp2={(vn)/((vfactor)*(absi2))}
.param z1r={(zfactor)*(length)*(temp2)*(ir)}
.param z1i={-(zfactor)*(length)*(temp2)*(ii)}
.param g1r={((z1r)/((z1r)*(z1r)+(z1i)*(z1i)))*on}
.param g1i={(-(z1i)/((z1r)*(z1r)+(z1i)*(z1i)))*on}
  gi12r   v1r   v01  Value = {v(v1r)*g1r - v(v1i)*g1i} tripdv={TRIPDV} tripdt={TRIPDT} ; i1r
  gi12i   v1i   v02  Value = {v(v1r)*g1i + v(v1i)*g1r} tripdv={TRIPDV} tripdt={TRIPDT} ; i1i
  *gi2r = -gi1r
  *gi2i = -gi1i
  *gi2r   v2r   v03  Value = {-v(v1r)*g1r + v(v1i)*g1i + v(v2r)*g1r - v(v2i)*g1i} tripdv={TRIPDV} tripdt={TRIPDT} ; i2r
  *gi2i   v2i   v04  Value = {-v(v1r)*g1i - v(v1i)*g1r + v(v2r)*g1i + v(v2i)*g1r} tripdv={TRIPDV} tripdt={TRIPDT} ; i2i
  vi12r   v01   0    dc 0v;   Currentmeter
  vi12i   v02   0    dc 0v;   Currentmeter
  *vi2r   v03   0    dc 0v;   Currentmeter
  *vi2i   v04   0    dc 0v;   Currentmeter
  ev1mag_m  v1_m 0 value = {vfactor * sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))} tripdv={TRIPDV} tripdt={TRIPDT}
  ev2mag_m  v2_m 0 value = {vfactor * sqrt(v(v2r)*v(v2r)+v(v2i)*v(v2i))} tripdv={TRIPDV} tripdt={TRIPDT}
  ei1mag_m  i1_m 0 value = {sqrt(i(vi12r)*i(vi12r)+i(vi12i)*i(vi12i))} tripdv={TRIPDV} tripdt={TRIPDT}
  es1mag_m  s1_m 0 value = {v(v1_m)*v(i1_m) * sfactor/vfactor } tripdv={TRIPDV} tripdt={TRIPDT}
  ep1 p1_m 0  value = {(v(v1r)*i(vi12r)+v(v1i)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  ep2 p2_m 0  value = {-(v(v2r)*i(vi12r)+v(v2i)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq1 q1_m 0  value = {(v(v1i)*i(vi12r)-v(v1r)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq2 q2_m 0  value = {-(v(v2i)*i(vi12r)-v(v2r)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  epv pv_m 0  value = {v(p1_m)+v(p2_m)}  tripdv={TRIPDV} tripdt={TRIPDT}
  eqv qv_m 0  value = {v(q1_m)+v(q2_m)}  tripdv={TRIPDV} tripdt={TRIPDT}
  rv1mag v1_m 0 1e12
  rv2mag v2_m 0 1e12
  ri1mag i1_m 0 1e12
  rsmag s1_m 0 1e12
  rp1 p1_m  0 1e12
  rp2 p2_m  0 1e12
  rq1 q1_m  0 1e12
  rq2 q2_m  0 1e12
  rpv pv_m  0 1e12
  rqv qv_m  0 1e12
  rmax1  v1r  0   1e12
  rmax2  v1i  0   1e12
  rmax3  v2r  0   1e12
  rmax4  v2i  0   1e12
.ends
*$
*$
* Parallel impedance model
.subckt impedance_III_LF  v1r v1i v2r v2i p1_m q1_m v1_m p2_m q2_m
+ params:
+ on = 1
+ r= 1
+ xl = 0
+ xc = 0
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ zfactor = 1.0
.param rs = {r*zfactor}
.param xls = {xl*zfactor}
.param xcs = {xc*zfactor}
 gi12Rr v1r v10 value = {on*(v(v1r)-v(v2r))/rs} tripdv={TRIPDV} tripdt={TRIPDT}
 gi12Ri v1i v20 value = {on*(v(v1i)-v(v2i))/rs} tripdv={TRIPDV} tripdt={TRIPDT}
 gi12Lr v1r v10 value = {on*(v(v1i)-v(v2i))/xls} tripdv={TRIPDV} tripdt={TRIPDT}
 gi12Li v1i v20 value = {-on*(v(v1r)-v(v2r))/xls} tripdv={TRIPDV} tripdt={TRIPDT}
 gi12Cr v1r v10 value = {-on*(v(v1i)-v(v2i))/xcs} tripdv={TRIPDV} tripdt={TRIPDT}
 gi12Ci v1i v20 value = {on*(v(v1r)-v(v2r))/xcs} tripdv={TRIPDV} tripdt={TRIPDT}
 vi12r v10 v2r dc 0v
 vi12i v20 v2i dc 0v
  ev1mag_m  v1_m 0 value = {vfactor * sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))} tripdv={TRIPDV} tripdt={TRIPDT}
  ev2mag_m  v2_m 0 value = {vfactor * sqrt(v(v2r)*v(v2r)+v(v2i)*v(v2i))} tripdv={TRIPDV} tripdt={TRIPDT}
  ei1mag_m  i1_m 0 value = {sqrt(i(vi12r)*i(vi12r)+i(vi12i)*i(vi12i))} tripdv={TRIPDV} tripdt={TRIPDT}
  es1mag_m  s1_m 0 value = {v(v1_m)*v(i1_m) * sfactor/vfactor } tripdv={TRIPDV} tripdt={TRIPDT}
  ep1 p1_m 0  value = {(v(v1r)*i(vi12r)+v(v1i)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  ep2 p2_m 0  value = {-(v(v2r)*i(vi12r)+v(v2i)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq1 q1_m 0  value = {(v(v1i)*i(vi12r)-v(v1r)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq2 q2_m 0  value = {-(v(v2i)*i(vi12r)-v(v2r)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  epv pv_m 0  value = {v(p1_m)+v(p2_m)}  tripdv={TRIPDV} tripdt={TRIPDT}
  eqv qv_m 0  value = {v(q1_m)+v(q2_m)}  tripdv={TRIPDV} tripdt={TRIPDT}
  rv1mag v1_m 0 1e12
  rv2mag v2_m 0 1e12
  ri1mag i1_m 0 1e12
  rsmag s1_m 0 1e12
  rp1 p1_m  0 1e12
  rp2 p2_m  0 1e12
  rq1 q1_m  0 1e12
  rq2 q2_m  0 1e12
  rpv pv_m  0 1e12
  rqv qv_m  0 1e12
  rmax1  v1r  0   1e12
  rmax2  v1i  0   1e12
  rmax3  v2r  0   1e12
  rmax4  v2i  0   1e12
.ends
*$

* Capacitor bank
.subckt c_batt_LF v1r v1i v1_m q1_m
+ params:
+ on = 1
+ q = 50000000
+ vn = 110000
+ r_x=0.001 ; NEW with loss
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ uout=1
.param gi = {-q/(vn*vn)}
.param gr = {q*r_x/(vn*vn)}
 gi1r v1r v10 value = {on*gi*v(v1i)+on*gr*v(v1r)} tripdv={TRIPDV} tripdt={TRIPDT}
 gi1i v1i v20 value = {-on*gi*v(v1r)+on*gr*v(v1i)} tripdv={TRIPDV} tripdt={TRIPDT}
 vi1r v10 0 dc 0v
 vi1i v20 0 dc 0v
  ev1mag_m  v1_m 0 value = {uout*vfactor * sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))+(1-uout)*v(i1_m)}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  ei1mag_m  i1_m 0 value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  eq1 q1_m 0 value = {(v(v1i)*i(vi1r)-v(v1r)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  ep1 p1_m 0 value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  rv1mag v1_m 0 1e12
  ri1mag i1_m 0 1e12
  rq1 q1_m  0 1e12
  rp1 p1_m 0 1e12
  rmax1  v1r  0   1e12
  rmax2  v1i  0   1e12
.ends
*$
* Inductor bank (inductive reactor)
.subckt l_batt_LF v1r v1i v1_m q1_m
+ params:
+ on = 1
+ q = 50000000
+ vn = 110000
+ r_x=0.001
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ uout=1
.param gi = {q/(vn*vn)}
.param gr = {q*r_x/(vn*vn)}
 gi1r v1r v10 value = {on*gi*v(v1i)+on*gr*v(v1r)} tripdv={TRIPDV} tripdt={TRIPDT}
 gi1i v1i v20 value = {-on*gi*v(v1r)+on*gr*v(v1i)} tripdv={TRIPDV} tripdt={TRIPDT}
 vi1r v10 0 dc 0v
 vi1i v20 0 dc 0v
  ev1mag_m  v1_m 0 value = {uout*vfactor * sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))+(1-uout)*v(i1_m)}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  ei1mag_m  i1_m 0 value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq1 q1_m 0 value = {(v(v1i)*i(vi1r)-v(v1r)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  ep1 p1_m 0 value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  rv1mag v1_m 0 1e12
  ri1mag i1_m 0 1e12
  rq1 q1_m  0 1e12
  rp1 p1_m 0 1e12
  rmax1  v1r  0   1e12
  rmax2  v1i  0   1e12
.ends
*$

* resistance model
.subckt z_r_LF v1r v1i v2r v2i p1_m q1_m v1_m p2_m q2_m
+ params:
+ on = 1
+ r = 1
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ zfactor = 1.0
+ uout=1
.param rs = {r*zfactor}
 gi12r v1r v10 value = {on*(v(v1r)-v(v2r))/rs} tripdv={TRIPDV} tripdt={TRIPDT}
 gi12i v1i v20 value = {on*(v(v1i)-v(v2i))/rs} tripdv={TRIPDV} tripdt={TRIPDT}
 vi12r v10 v2r dc 0v
 vi12i v20 v2i dc 0v
  ev1mag_m  v1_m 0 value = {uout*vfactor * sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))*(1-uout)*v(i1m)} tripdv={TRIPDV} tripdt={TRIPDT}
  ev2mag_m  v2_m 0 value = {uout*vfactor * sqrt(v(v2r)*v(v2r)+v(v2i)*v(v2i))} tripdv={TRIPDV} tripdt={TRIPDT}
  ei1mag_m  i1_m 0 value = {sqrt(i(vi12r)*i(vi12r)+i(vi12i)*i(vi12i))} tripdv={TRIPDV} tripdt={TRIPDT}
  es1mag_m  s1_m 0 value = {sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))*v(i1_m) * sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  ep1 p1_m 0  value = {(v(v1r)*i(vi12r)+v(v1i)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  ep2 p2_m 0  value = {-(v(v2r)*i(vi12r)+v(v2i)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq1 q1_m 0  value = {(v(v1i)*i(vi12r)-v(v1r)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq2 q2_m 0  value = {-(v(v2i)*i(vi12r)-v(v2r)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  epv pv_m 0  value = {v(p1_m)+v(p2_m)}  tripdv={TRIPDV} tripdt={TRIPDT}
  eqv qv_m 0  value = {v(q1_m)+v(q2_m)}  tripdv={TRIPDV} tripdt={TRIPDT}
  rv1mag v1_m 0 1e12
  rv2mag v2_m 0 1e12
  ri1mag i1_m 0 1e12
  rsmag s1_m 0 1e12
  rp1 p1_m  0 1e12
  rp2 p2_m  0 1e12
  rq1 q1_m  0 1e12
  rq2 q2_m  0 1e12
  rpv pv_m  0 1e12
  rqv qv_m  0 1e12
  rmax1  v1r  0   1e12
  rmax2  v1i  0   1e12
  rmax3  v2r  0   1e12
  rmax4  v2i  0   1e12
.ends
*$
*$
* inductance model
.subckt z_xl_LF  v1r v1i v2r v2i p1_m q1_m v1_m p2_m q2_m
+ params:
+ on = 1
+ xl = 1
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ zfactor = 1.0
+ uout=1
.param xls = {xl*zfactor}
 gi12r v1r v10 value = {on*(v(v1i)-v(v2i))/xls} tripdv={TRIPDV} tripdt={TRIPDT}
 gi12i v1i v20 value = {-on*(v(v1r)-v(v2r))/xls} tripdv={TRIPDV} tripdt={TRIPDT}
 vi12r v10 v2r dc 0v
 vi12i v20 v2i dc 0v
  ev1mag_m  v1_m 0 value = {uout*vfactor * sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))+(1-uout)*v(i1_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  ev2mag_m  v2_m 0 value = {vfactor * sqrt(v(v2r)*v(v2r)+v(v2i)*v(v2i))} tripdv={TRIPDV} tripdt={TRIPDT}
  ei1mag_m  i1_m 0 value = {sqrt(i(vi12r)*i(vi12r)+i(vi12i)*i(vi12i))} tripdv={TRIPDV} tripdt={TRIPDT}
  es1mag_m  s1_m 0 value = {sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))*v(i1_m) * sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  ep1 p1_m 0  value = {(v(v1r)*i(vi12r)+v(v1i)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  ep2 p2_m 0  value = {-(v(v2r)*i(vi12r)+v(v2i)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq1 q1_m 0  value = {(v(v1i)*i(vi12r)-v(v1r)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq2 q2_m 0  value = {-(v(v2i)*i(vi12r)-v(v2r)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  epv pv_m 0  value = {v(p1_m)+v(p2_m)}  tripdv={TRIPDV} tripdt={TRIPDT}
  eqv qv_m 0  value = {v(q1_m)+v(q2_m)}  tripdv={TRIPDV} tripdt={TRIPDT}
  rv1mag v1_m 0 1e12
  rv2mag v2_m 0 1e12
  ri1mag i1_m 0 1e12
  rsmag s1_m 0 1e12
  rp1 p1_m  0 1e12
  rp2 p2_m  0 1e12
  rq1 q1_m  0 1e12
  rq2 q2_m  0 1e12
  rpv pv_m  0 1e12
  rqv qv_m  0 1e12
  rmax1  v1r  0   1e12
  rmax2  v1i  0   1e12
  rmax3  v2r  0   1e12
  rmax4  v2i  0   1e12
.ends
*$
*$
* capacitance model
.subckt z_xc_LF  v1r v1i v2r v2i p1_m q1_m v1_m p2_m q2_m
+ params:
+ on = 1
+ xc = 1
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ zfactor = 1.0
+ uout=1
.param xcs = {xc*zfactor}
 gi12r v1r v10 value = {-on*(v(v1i)-v(v2i))/xcs} tripdv={TRIPDV} tripdt={TRIPDT}
 gi12i v1i v20 value = {on*(v(v1r)-v(v2r))/xcs} tripdv={TRIPDV} tripdt={TRIPDT}
 vi12r v10 v2r dc 0v
 vi12i v20 v2i dc 0v
  ev1mag_m  v1_m 0 value = {uout*vfactor * sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))+(1-uout)*v(i1_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  ev2mag_m  v2_m 0 value = {vfactor * sqrt(v(v2r)*v(v2r)+v(v2i)*v(v2i))} tripdv={TRIPDV} tripdt={TRIPDT}
  ei1mag_m  i1_m 0 value = {sqrt(i(vi12r)*i(vi12r)+i(vi12i)*i(vi12i))} tripdv={TRIPDV} tripdt={TRIPDT}
  es1mag_m  s1_m 0 value = {sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))*v(i1_m) * sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  ep1 p1_m 0  value = {(v(v1r)*i(vi12r)+v(v1i)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  ep2 p2_m 0  value = {-(v(v2r)*i(vi12r)+v(v2i)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq1 q1_m 0  value = {(v(v1i)*i(vi12r)-v(v1r)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq2 q2_m 0  value = {-(v(v2i)*i(vi12r)-v(v2r)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  epv pv_m 0  value = {v(p1_m)+v(p2_m)}  tripdv={TRIPDV} tripdt={TRIPDT}
  eqv qv_m 0  value = {v(q1_m)+v(q2_m)}  tripdv={TRIPDV} tripdt={TRIPDT}
  rv1mag v1_m 0 1e12
  rv2mag v2_m 0 1e12
  ri1mag i1_m 0 1e12
  rsmag s1_m 0 1e12
  rp1 p1_m  0 1e12
  rp2 p2_m  0 1e12
  rq1 q1_m  0 1e12
  rq2 q2_m  0 1e12
  rpv pv_m  0 1e12
  rqv qv_m  0 1e12
  rmax1  v1r  0   1e12
  rmax2  v1i  0   1e12
  rmax3  v2r  0   1e12
  rmax4  v2i  0   1e12
.ends
*
*
*
*
* coupled inductances 1 phase , differential inputs, like standard spice3 k and l - Elements
* iron loss modeled with rfe ( related to primary side )
* cooper loss modeled with rp ( primary side: rp  secondary side: rp/(ue*ue) )
* coupling loss with k<1  ( primary side: lp  secondary side: lp/(ue*ue) m=k*sqrt(l1l2) )

.subckt l1l2k12_LF v1r n1r v1i n1i v2r n2r v2i n2i p1_m q1_m v1_m v2_m p2_m q2_m
+ params:
+ on=1
+ ue=3.3333
+ lp=2000
+ rp=0.01
+ fn=50
+ omega={2*3.14159*fn}
+ k=0.99995
+ vfactor={sqrt(3)}
+ sfactor=3
+ rfe=1e6
+ rmax=1e12
+ rmin=1e-3
+ rfe=1e12
.param r1={rp}
.param r2={rp/(ue*ue)}
*
.param l1={lp}
.param l2={l1/(ue*ue)}
.param lm={k*sqrt(l1*l2)}
*
.param xl1i={(omega)*(l1)}
.param xl2i={(omega)*(l2)}
.param xm={omega*lm}
*
ev1r v1r v1ry value={r1*i(vi1r)-xl1i*i(vi1i)-xm*i(vi2i)} tripdv={TRIPDV} tripdt={TRIPDT}
vi1r v1rx n1r dc 0
ev1i v1i v1iy value={xl1i*i(vi1r)+r1*i(vi1i)+xm*i(vi2r)} tripdv={TRIPDV} tripdt={TRIPDT}
vi1i v1ix n1i dc 0
ev2r v2r v2ry value={-xm*i(vi1i)+r2*i(vi2r)-xl2i*i(vi2i)} tripdv={TRIPDV} tripdt={TRIPDT}
vi2r v2rx n2r dc 0
ev2i v2i v2iy value={xm*i(vi1r)+xl2i*i(vi2r)+r2*i(vi2i)} tripdv={TRIPDV} tripdt={TRIPDT}
vi2i v2ix n2i dc 0
rv1  v1rx v1ry {rmin*on+rmax*(1-on)}
rv2  v1ix v1iy {rmin*on+rmax*(1-on)}
rv3  v2rx v2ry {rmin*on+rmax*(1-on)}
rv4  v2ix v2iy {rmin*on+rmax*(1-on)}
ev1 v1_m  0  value={vfactor*sqrt(v(v1r,n1r)*v(v1r,n1r)+v(v1i,n1i)*v(v1i,n1i))} tripdv={TRIPDV} tripdt={TRIPDT}
ev2 v2_m  0  value={vfactor*sqrt(v(v2r,n2r)*v(v2r,n2r)+v(v2i,n2i)*v(v2i,n2i))} tripdv={TRIPDV} tripdt={TRIPDT}
ei1mag_m   i1_m  0  value={sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))} tripdv={TRIPDV} tripdt={TRIPDT}
ei2mag_m   i2_m  0  value={sqrt(i(vi2r)*i(vi2r)+i(vi2i)*i(vi2i))} tripdv={TRIPDV} tripdt={TRIPDT}
es1mag_m   s1_m  0  value={v(v1_m)*v(i1_m) *sfactor/vfactor} tripdv={TRIPDV} tripdt={TRIPDT}
ep1   p1_m   0    value={(v(v1r,n1r)*i(vi1r)+v(v1i,n1i)*i(vi1i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
ep2   p2_m   0    value={(v(v2r,n2r)*i(vi2r)+v(v2i,n2i)*i(vi2i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
eq1   q1_m   0    value={(v(v1i,n1i)*i(vi1r)-v(v1r,n1r)*i(vi1i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
eq2   q2_m   0    value={(v(v2i,n2i)*i(vi2r)-v(v2r,n2r)*i(vi2i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
epv   pv_m   0    value={v(p1_m)+v(p2_m)} tripdv={TRIPDV} tripdt={TRIPDT}
eqv   qv_m   0    value={v(q1_m)+v(q2_m)} tripdv={TRIPDV} tripdt={TRIPDT}
rfe1   v1r  n1r {rfe}
rfe2   v1i  n1i {rfe}
rmax1  v1r  0   1e12
rmax2  v1i  0   1e12
rmax3  v2r  0   1e12
rmax4  v2i  0   1e12
.ends
*$
*
*
*
* one phase simple lossless transformer
* This element is without coupling factor
* Coupling is always 1 !!!
.subckt ue_LF v1r v1i v2r v2i params: ue=1 l_=0 s_=0 stproz=1 phir=-0.5 phii=-0.866025404
.param reL={ue*l_*stproz/100}
.param reS={ue*s_*stproz/100}
.param uer={ue+reL+reS*phir}
.param uei={reS*phii}
v1r v1r v1rx1 0v
v1i v1i v1ix1 0v
rser1 v1rx1 v1rx 1u ; add some ser. resistance to prevent voltage loop warning
rser2 v1ix1 v1ix 1u
bv1r v1rx 0 v=v(v2r)*uer-v(v2i)*uei tripdv={TRIPDV} tripdt={TRIPDT}
bv1i v1ix 0 v=v(v2i)*uer+v(v2r)*uei tripdv={TRIPDV} tripdt={TRIPDT}
bi2r 0 v2r  i=i(v1r)*uer+i(v1i)*uei tripdv={TRIPDV} tripdt={TRIPDT}
bi2i 0 v2i  i=i(v1i)*uer-i(v1r)*uei tripdv={TRIPDV} tripdt={TRIPDT}
rmax1  v1r  0   1e12
rmax2  v1i  0   1e12
rmax3  v2r  0   1e12
rmax4  v2i  0   1e12
.ends

* one phase simple lossless transformer like model above but with neutral port pins
* This element is without coupling factor and with neutral line
* Coupling is always 1 !!!
.subckt ue2_LF v1r v1i n1r n1i v2r v2i n2r n2i params: on=1 ue=1 l_=0 s_=0 stproz=1 phir=-0.5 phii=-0.866025404
.param reL={ue*l_*stproz/100}
.param reS={ue*s_*stproz/100}
.param uer={ue+reL+reS*phir}
.param uei={reS*phii}
v1r v1r v1rx1 0v
v1i v1i v1ix1 0v
rser1 v1rx1 v1rx 1u ; add some ser. resistance to prevent voltage loop warning
rser2 v1ix1 v1ix 1u
bv1r v1rx n1r v=v(v2r,n2r)*uer-v(v2i,n2i)*uei tripdv={TRIPDV} tripdt={TRIPDT}
bv1i v1ix n1i v=v(v2i,n2i)*uer+v(v2r,n2r)*uei tripdv={TRIPDV} tripdt={TRIPDT}
bi2r n2r v2r  i=on*(i(v1r)*uer+i(v1i)*uei) tripdv={TRIPDV} tripdt={TRIPDT}
bi2i n2i v2i  i=on*(i(v1i)*uer-i(v1r)*uei) tripdv={TRIPDV} tripdt={TRIPDT}
rmax1  v1r  0   1e12
rmax2  v1i  0   1e12
rmax3  v2r  0   1e12
rmax4  v2i  0   1e12
rmax5  n1r  0   1e12
rmax6  n1i  0   1e12
rmax7  n2r  0   1e12
rmax8  n2i  0   1e12
.ends

* one phase simple lossless transformer like model above
* This element is without coupling factor and with neutral line
* Coupling is always 1 !!! no transformer taping
.subckt a v1r v1i n1r n1i v2r v2i n2r n2i params: on=1 ue=1 phir=-0.5 phii=0.866025404
.param reS={ue}
.param uer={reS*phir}
.param uei={-reS*phii}
v1r v1r v1rx1 0v
v1i v1i v1ix1 0v
rser1 v1rx1 v1rx 1u ; add some ser. resistance to prevent voltage loop warning
rser2 v1ix1 v1ix 1u
bv1r v1rx n1r v=v(v2r,n2r)*uer-v(v2i,n2i)*uei tripdv={TRIPDV} tripdt={TRIPDT}
bv1i v1ix n1i v=v(v2i,n2i)*uer+v(v2r,n2r)*uei tripdv={TRIPDV} tripdt={TRIPDT}
bi2r n2r v2r  i=on*(i(v1r)*uer+i(v1i)*uei) tripdv={TRIPDV} tripdt={TRIPDT}
bi2i n2i v2i  i=on*(i(v1i)*uer-i(v1r)*uei) tripdv={TRIPDV} tripdt={TRIPDT}
rmax1  v1r  0   1e12
rmax2  v1i  0   1e12
rmax3  v2r  0   1e12
rmax4  v2i  0   1e12
rmax5  n1r  0   1e12
rmax6  n1i  0   1e12
rmax7  n2r  0   1e12
rmax8  n2i  0   1e12
.ends

* one phase simple lossless transformer like model above
* This element is without coupling factor and with neutral line
* Coupling is always 1 !!! no transformer taping
.subckt a2 v1r v1i n1r n1i v2r v2i n2r n2i params: on=1 ue=1 l_=0 s_=0 stproz=1 phir=-0.5 phii=-0.866025404
.param reS={ue}
.param uer={reS*phir}
.param uei={-reS*phii}
v1r v1r v1rx1 0v
v1i v1i v1ix1 0v
rser1 v1rx1 v1rx 1u ; add some ser. resistance to prevent voltage loop warning
rser2 v1ix1 v1ix 1u
bv1r v1rx n1r v=v(v2r,n2r)*uer-v(v2i,n2i)*uei tripdv={TRIPDV} tripdt={TRIPDT}
bv1i v1ix n1i v=v(v2i,n2i)*uer+v(v2r,n2r)*uei tripdv={TRIPDV} tripdt={TRIPDT}
bi2r n2r v2r  i=on*(i(v1r)*uer+i(v1i)*uei) tripdv={TRIPDV} tripdt={TRIPDT}
bi2i n2i v2i  i=on*(i(v1i)*uer-i(v1r)*uei) tripdv={TRIPDV} tripdt={TRIPDT}
rmax1  v1r  0   1e12
rmax2  v1i  0   1e12
rmax3  v2r  0   1e12
rmax4  v2i  0   1e12
rmax5  n1r  0   1e12
rmax6  n1i  0   1e12
rmax7  n2r  0   1e12
rmax8  n2i  0   1e12
.ends

* This element is with coupling factor k
* Therefore there are 8 g-devices present
.subckt ue_k_LF v1r v1i v2r v2i params: ue=1 l_=0 s_=0 stproz=1 phir=-0.5 phii=-0.866025404 k=1
.param reL={ue*l_*stproz/100}
.param reS={ue*s_*stproz/100}
.param uer={ue+reL+reS*phir}
.param uei={reS*phii}
g1r 0 mr v1r 0 1
g1i 0 mi v1i 0 1
g2r 0 mr VALUE={-1/k*(uer*v(v2r)-uei*v(v2i))} tripdv={TRIPDV} tripdt={TRIPDT}
g2i 0 mi VALUE={-1/k*(uer*v(v2i)+uei*v(v2r))} tripdv={TRIPDV} tripdt={TRIPDT}
g3r v1r 0 mr 0 1
g3i v1i 0 mi 0 1
g4r v2r 0 VALUE={-1/k*(uer*v(mr)-uei*v(mi))} tripdv={TRIPDV} tripdt={TRIPDT}
g4i v2i 0 VALUE={-1/k*(uer*v(mi)+uei*v(mr))} tripdv={TRIPDV} tripdt={TRIPDT}
rmr mr 0 1e10
rmi mi 0 1e10
rmax1  v1r  0   1e12
rmax2  v1i  0   1e12
rmax3  v2r  0   1e12
rmax4  v2i  0   1e12
.ends

* This element is with coupling factor k
* Therefore there are 8 g-devices present
.subckt ue2_k_LF v1r v1i n1r n1i v2r v2i n2r n2i params: ue=1 l_=0 s_=0 stproz=1 phir=-0.5 phii=-0.866025404 k=1
.param reL={ue*l_*stproz/100}
.param reS={ue*s_*stproz/100}
.param uer={ue+reL+reS*phir}
.param uei={reS*phii}
g1r 0 mr v1r n1r 1
g1i 0 mi v1i n1r 1
g2r 0 mr VALUE={-1/k*(uer*v(v2r,n2r)-uei*v(v2i,n2i))} tripdv={TRIPDV} tripdt={TRIPDT}
g2i 0 mi VALUE={-1/k*(uer*v(v2i,n2i)+uei*v(v2r,n2r))} tripdv={TRIPDV} tripdt={TRIPDT}
g3r v1r n1r mr 0 1
g3i v1i n1i mi 0 1
g4r v2r n2r VALUE={-1/k*(uer*v(mr)-uei*v(mi))} tripdv={TRIPDV} tripdt={TRIPDT}
g4i v2i n2i VALUE={-1/k*(uer*v(mi)+uei*v(mr))} tripdv={TRIPDV} tripdt={TRIPDT}
rmr mr 0 1e10
rmi mi 0 1e10
rmax1  v1r  0   1e12
rmax2  v1i  0   1e12
rmax3  v2r  0   1e12
rmax4  v2i  0   1e12
rmax5  n1r  0   1e12
rmax6  n1i  0   1e12
rmax7  n2r  0   1e12
rmax8  n2i  0   1e12
.ends


* NOTE: Since the sign of L_ tap value is not normed and dependent of the transformer manufacturer
* you can change the behaviour with sign1 and sign2 set to -1 or 1
.subckt trafo_tap_l_LF v1r v1i v2r v2i params: ue=1 l_=0 stproz=1 middle=0 sign1=1 sign2=1
.param phir=0 phii=0
.param s_=0
.param reL={ue*(l_-middle)*stproz/100*sign1}
.param reS={ue*(s_-middle)*stproz/100*sign2}
.param uer={ue+reL+reS*phir}
.param uei={reS*phii}
v1r v1r v1rx1 0v
v1i v1i v1ix1 0v
rser1 v1rx1 v1rx 1u ; add some ser. resistance to prevent voltage loop warning
rser2 v1ix1 v1ix 1u
bv1r v1rx 0 v=v(v2r)*uer-v(v2i)*uei tripdv={TRIPDV} tripdt={TRIPDT}
bv1i v1ix 0 v=v(v2i)*uer+v(v2r)*uei tripdv={TRIPDV} tripdt={TRIPDT}
bi2r 0 v2r  i=i(v1r)*uer+i(v1i)*uei tripdv={TRIPDV} tripdt={TRIPDT}
bi2i 0 v2i  i=i(v1i)*uer-i(v1r)*uei tripdv={TRIPDV} tripdt={TRIPDT}
rmax1  v1r  0   1e12
rmax2  v1i  0   1e12
rmax3  v2r  0   1e12
rmax4  v2i  0   1e12
.ends

* NOTE: Since the sign of S_ tap value is not normed and dependent of the transformer manufacturer
* you can change the behaviour with sign1 and sign2 set to -1 or 1
.subckt trafo_tap_s_LF v1r v1i v2r v2i params: ue=1 s_=0 stproz=1 phir=-0.5 phii=-0.866025404 middle=0 sign1=1 sign2=1
.param l_=0
.param reL={ue*(l_-middle)*stproz/100*sign1}
.param reS={ue*(s_-middle)*stproz/100*sign2}
.param uer={ue+reL+reS*phir}
.param uei={reS*phii}
v1r v1r v1rx1 0v
v1i v1i v1ix1 0v
rser1 v1rx1 v1rx 1u ; add some ser. resistance to prevent voltage loop warning
rser2 v1ix1 v1ix 1u
bv1r v1rx 0 v=v(v2r)*uer-v(v2i)*uei tripdv={TRIPDV} tripdt={TRIPDT}
bv1i v1ix 0 v=v(v2i)*uer+v(v2r)*uei tripdv={TRIPDV} tripdt={TRIPDT}
bi2r 0 v2r  i=i(v1r)*uer+i(v1i)*uei tripdv={TRIPDV} tripdt={TRIPDT}
bi2i 0 v2i  i=i(v1i)*uer-i(v1r)*uei tripdv={TRIPDV} tripdt={TRIPDT}
rmax1  v1r  0   1e12
rmax2  v1i  0   1e12
rmax3  v2r  0   1e12
rmax4  v2i  0   1e12
.ends

* NOTE: Since the sign of Q_ tap value is not normed and dependent of the transformer manufacturer
* you can change the behaviour with sign1 and sign2 set to -1 or 1
.subckt trafo_tap_q_LF v1r v1i v2r v2i params: ue=1 q_=0 stproz=1 middle=0 sign1=1 sign2=1
.param phir=0
.param phii=-1
.param s_={q_}
.param l_=0
.param reL={ue*(l_-middle)*stproz/100*sign1}
.param reS={ue*(s_-middle)*stproz/100*sign2}
.param uer={ue+reL+reS*phir}
.param uei={reS*phii}
v1r v1r v1rx1 0v
v1i v1i v1ix1 0v
rser1 v1rx1 v1rx 1u ; add some ser. resistance to prevent voltage loop warning
rser2 v1ix1 v1ix 1u
bv1r v1rx 0 v=v(v2r)*uer-v(v2i)*uei tripdv={TRIPDV} tripdt={TRIPDT}
bv1i v1ix 0 v=v(v2i)*uer+v(v2r)*uei tripdv={TRIPDV} tripdt={TRIPDT}
bi2r 0 v2r  i=i(v1r)*uer+i(v1i)*uei tripdv={TRIPDV} tripdt={TRIPDT}
bi2i 0 v2i  i=i(v1i)*uer-i(v1r)*uei tripdv={TRIPDV} tripdt={TRIPDT}
rmax1  v1r  0   1e12
rmax2  v1i  0   1e12
rmax3  v2r  0   1e12
rmax4  v2i  0   1e12
.ends

.subckt trafo_tap_l_ctrl_LF v1r v1i v2r v2i l_ params: ue=1 stproz=1 middle=0 sign=1
.param reL={ue*(l_-middle)*stproz/100*sign}
.param uer={ue+reL}
v1r v1r v1rx1 0v
v1i v1i v1ix1 0v
rser1 v1rx1 v1rx 1u ; add some ser. resistance to prevent voltage loop warning
rser2 v1ix1 v1ix 1u
bv1r v1rx 0 v=v(v2r)*v(uer) tripdv={TRIPDV} tripdt={TRIPDT}
bv1i v1ix 0 v=v(v2i)*v(uer) tripdv={TRIPDV} tripdt={TRIPDT}
bi2r 0 v2r  i=i(v1r)*v(uer) tripdv={TRIPDV} tripdt={TRIPDT}
bi2i 0 v2i  i=i(v1i)*v(uer) tripdv={TRIPDV} tripdt={TRIPDT}
rmax1  v1r  0   {rmax}
rmax2  v1i  0   {rmax}
rmax3  v2r  0   {rmax}
rmax4  v2i  0   {rmax}
.ends

.subckt trafo_tap_s__ctrl_LF v1r v1i v2r v2i s_ params: ue=1 stproz=1 phir=-0.5 phii=-0.866025404 middle=0 sign=1
ereS reS 0 value={ue*(v(s_)*sign1-middle)*stproz/100}
euer uer 0 value={ue+v(reS)*phir}
euei uei 0 value={v(reS)*phii}
v1r v1r v1rx1 0v
v1i v1i v1ix1 0v
rser1 v1rx1 v1rx 1u ; add some ser. resistance to prevent voltage loop warning
rser2 v1ix1 v1ix 1u
bv1r v1rx 0 v=v(v2r)*v(uer)-v(v2i)*v(uei) tripdv={TRIPDV} tripdt={TRIPDT} 
bv1i v1ix 0 v=v(v2i)*v(uer)+v(v2r)*v(uei) tripdv={TRIPDV} tripdt={TRIPDT}
bi2r 0 v2r  i=i(v1r)*v(uer)+i(v1i)*v(uei) tripdv={TRIPDV} tripdt={TRIPDT}
bi2i 0 v2i  i=i(v1i)*v(uer)-i(v1r)*v(uei) tripdv={TRIPDV} tripdt={TRIPDT} 
rmax1  v1r  0   {rmax}
rmax2  v1i  0   {rmax}
rmax3  v2r  0   {rmax}
rmax4  v2i  0   {rmax}
.ends

.subckt trafo_tap_q_ctrl_LF v1r v1i v2r v2i q_ params: ue=1 stproz=1 middle=0 sign=1
.param phii=-1
ereQ reQ 0 value={ue*(v(q_-middle)*sign)*stproz/100}
euer uer 0 value={ue}
euei uei 0 value={v(reQ)*phii}
v1r v1r v1rx1 0v
v1i v1i v1ix1 0v
rser1 v1rx1 v1rx 1u ; add some ser. resistance to prevent voltage loop warning
rser2 v1ix1 v1ix 1u
bv1r v1rx 0 v=v(v2r)*v(uer)-v(v2i)*v(uei) tripdv={TRIPDV} tripdt={TRIPDT}  
bv1i v1ix 0 v=v(v2i)*v(uer)+v(v2r)*v(uei) tripdv={TRIPDV} tripdt={TRIPDT}
bi2r 0 v2r  i=i(v1r)*v(uer)+i(v1i)*v(uei) tripdv={TRIPDV} tripdt={TRIPDT} 
bi2i 0 v2i  i=i(v1i)*v(uer)-i(v1r)*v(uei) tripdv={TRIPDV} tripdt={TRIPDT} 
rmax1  v1r  0   {rmax}
rmax2  v1i  0   {rmax}
rmax3  v2r  0   {rmax}
rmax4  v2i  0   {rmax}
.ends
