* Library of LTSPICE macromodels for load flow computation

*  Copyright F.S., 2003, 2004, 2005 All Rights Reserved.
*  But not responible for any
*  damage caused by applying results from this computation
* --------------------------------------------------
*
* --------------------------------------------------
*  Version:   V 2.0
*  Author:   Friedrich Schmidt
*  20.02.2003 first version
*  01.01.2004 second version
*  08.02.2004 trafo_Yd5 ...
*  23.02.2004 vri_3phase
*  01.03.2004 scr,peterson,load, (test:pv_slack)
*  30.03.2004 trafo_Yy0,Yd5,Yz5 ideal
*  30.10.2004 add tripdt tripdv parameter for behavioral sources
*  20.12.2004 small changes at the loads model ( multiple lines for LIMIT() -> more readily )
*  02.01.2005 nominal voltage as parameter now vn ( loads, peterson, scr, c_batt, l_batt, impedance_pqv , scr , iri_slack_pqv )
*  07.01.2005 corrected some lost v param values in .param expressions -> change to vn
*  10.01.2005 corrected a formula with vfactor in the peterson-model
*  xx.xx.2023 adding additional pv-elements
*-----------------------------------------------------------------------------------------------------------------------------------------
*
* generic line_LF            ; line
* generic constpower_LF      ; constant power
* generic constpower_boot_LF ; constant power with additional multiplier nodes
* generic impedance_LF       ; serial impedance r,xl,xc
* generic impedance_pqv_LF   ; serial impedance r,x from p,q and vn
* generic impedance_iv_LF    ; serial impedance r,x from ir,ii and vn
* generic impedance_sk_LF    ; serial impedance is computed via v and sk
* generic impedance_III_LF   ; parallel impedance r,xl,xc
* generic pv_slack           ; pv-slack with p-controller qmin and qmax per hand (good convergence but no automatic limit q calculation)
* generic pv_slack_LF        ; pv-slack with P,Vmag as input, experimental with convergence issues
* generic pv_slack_LF2       ; pv-slack with P,Vmag as input, experimental with convergence issues
* generic pv_slack_LF3       ; pv-slack with P,Vmag as input, use this by default for better convergence
* generic iri_slack_LF       ; current source with constant real and imag parts (ir,ii)
* generic iri_slack_pqv_LF   ; current source with p,q,vn input instead of ir,ii input
* generic vri_slack_LF       ; voltage source with constant real and imag parts
* generic vri_slack_n_LF     ; voltage source with neutral-line pins
* generic vri_slack_te_LF    ; voltage source based on thevinen equivalent current source
* generic vri_slack_te_n_LF  ; like vri_slack_te but with additional neutral-line pins
* generic iri_slack2_LF      ; current source with constant imag and phase parts
* generic vri_slack2_LF      ; voltage source with constant vmag and phase parts
* generic vri_slack2_n_LF    ; voltage source with constant vmag and phase parts and neutral line
* generic vri_slack2_te_LF   ; voltage source based on thevenin equivalent current source
* generic vri_slack2_te_n_LF ; like vri_slack2_te but with additional neutral-line pins
* generic vri_3phase_n_LF    ; 3 phase vri_slack with neutral pin
* generic loads_LF	         ; load  k=0 impedance, k=1 constcurrent, k=2 constpower
* generic petersen_LF        ; to limit earth-fault current on lines
* generic pv_slack_LF_2_3    ; input p and magnitude of v, output Q and vr,vi
* generic scr_LF             ; short circuit reactance -> to limit short circuit current on lines
* generic transformer_LF     ; transformer with additional voltage setter on primary side
* generic transformer_extd_LF; transformer with differential input and complex translation
*					factor
* generic trafo_Yd5_LF	     ; three phase transformer primary side star, secondary side
*				      trinagle
* generic trafo_Yy0_LF		 ;three phase transformer primary side star, secondary side
*				      star
* generic trafo_Yz5_LF       ;three phase transformer primary side star, secondary side
*				      z
* generic trafo_Yd5_ideal_LF ; three phase transformer primary side star, secondary side
*				      trinagle
* generic trafo_Yy0_ideal_LF ;three phase transformer primary side star, secondary side
*				      star
* generic trafo_Yz5_ideal_LF ;three phase transformer primary side star, secondary side
*				      z
* generic l1l2k12_LF         ; one phase inductive coupling ( standard spice3 K-device like )
* generic ue_LF       ; alternative ideal one phase inductive coupling
* generic c_batt_LF          ; Condensator batterie for voltage regulation
* generic l_batt_LF          ; Inductance batterie for voltage regulation
* generic z_r_LF             ; simple R
* generic z_xl_LF            ; simple Xl
* generic z_xc_LF            ; simple Xc
* regulating transformer voltage and phase (for compatibility with same models in the transient toolbox):
* generic trafo_tap_l_LF     ; voltage regulated transformer taping (connect it to the high voltage side)
* generic trafo_tap_s_LF     ; phase regulated transformer 60degrees (connect it to the high voltage side)
* generic trafo_tap_q_LF     ; phase regulated transformer 90degrees (connect it to the high voltage side)
*
* start of lib
*
* Global parameters
*
* the ratio rmax/ should not be to high ( numerical problems may occur )
* since absolute values in the high energy domain ( voltage ) is about 1e6 the rmax parameter also is high
* ( about 1e12 ) the corresponding rmin parameter can be about 1e-3


.PARAM tripdv=1 tripdt=1

* With P-Controller and with manual limit useful for .op simulations !!!
* if lower q-limit reached: set by hand lim_min=1 (now the model works like the nonlinear load model with q=qmin)
* if upper q-limit reached: set by hand lim_max=1 (now the model works like the nonlinear load model with q=qmax)
* if lim_min=0 and lim_max=0 the model acts as a pv-element with automatic computing q
.subckt pv_slack v1r v1i v1_m p1_m q1_m
+ params:
+ vmag=400k p=-100e6 qinit=10e6 qflo=-10 qfup=10 lim_max=0 lim_min=0 kp=100 vfactor=1.73205 sfactor=3.0 uout=1
+ ilolimit=-100e9 iuplimit=100e9
.param on0={IF(lim_max>0 | lim_min>0,0,1)}
.param on1=lim_max
.param on2=lim_min
gq     0    qf  value={(v(v1_m)-vmag)*Kp} tripdv={TRIPDV} tripdt={TRIPDT}
*gq     0    qf  value={UpLim(DnLim((v(v1_m)-vmag)*Kp,-14, 1e-2), 10,1e-2)} tripdv={TRIPDV} tripdt={TRIPDT}
rq     qf   0  1
*******************************************************************************
vss    ss    0    1 ; aditional voltage for source stepping convergence
gi1r   v1r   v10  Value = {LIMIT( (((p*v(ss)*v(ss))*on0/sfactor)*v(v1r))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)) +
+                           (((qinit*v(ss)*v(ss))*v(qf)*on0/sfactor)*v(v1i))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)),ilolimit,iuplimit) } tripdv={TRIPDV} tripdt={TRIPDT}
gi1i   v1i   v20  Value = {LIMIT( ((-(qinit*v(ss)*v(ss))*v(qf)*on0/sfactor)*v(v1r))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)) +
+                           (((p*v(ss)*v(ss))*on0/sfactor)*v(v1i))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)),ilolimit,iuplimit) } tripdv={TRIPDV} tripdt={TRIPDT}

gi1r1   v1r   v10  Value = {LIMIT( (((p*v(ss)*v(ss))*on1/sfactor)*v(v1r))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)) +
+                           (((qinit*v(ss)*v(ss))*qfup*on1/sfactor)*v(v1i))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)),ilolimit,iuplimit) }  tripdv={TRIPDV} tripdt={TRIPDT}
gi1i1   v1i   v20  Value = {LIMIT( ((-(qinit*v(ss)*v(ss))*qfup*on1/sfactor)*v(v1r))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)) +
+                           (((p*v(ss)*v(ss))*on1/sfactor)*v(v1i))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)),ilolimit,iuplimit) } tripdv={TRIPDV} tripdt={TRIPDT}

gi1r2   v1r   v10  Value = {LIMIT( (((p*v(ss)*v(ss))*on2/sfactor)*v(v1r))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)) +
+                           (((qinit*v(ss)*v(ss))*qflo*on2/sfactor)*v(v1i))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)),ilolimit,iuplimit) } tripdv={TRIPDV} tripdt={TRIPDT}
gi1i2   v1i   v20  Value = {LIMIT( ((-(qinit*v(ss)*v(ss))*qflo*on2/sfactor)*v(v1r))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)) +
+                           (((p*v(ss)*v(ss))*on2/sfactor)*v(v1i))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)),ilolimit,iuplimit) } tripdv={TRIPDV} tripdt={TRIPDT}
vi1r   v10   0    dc 0v;   currentmeter
vi1i   v20   0    dc 0v;   currentmeter
ev1mag_m   v1_m  0  value = {uout*vfactor * sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))+(1-uout)*v(i_m)} tripdv={TRIPDV} tripdt={TRIPDT}
ep1   p1_m   0    value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
eq1   q1_m   0    value = {(v(v1i)*i(vi1r)-v(v1r)*i(vi1i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
eiabs_m i_m 0 value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))} tripdv={TRIPDV} tripdt={TRIPDT} ; abs. current
es1mag_m  s_m 0 value = {sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))*v(i_m) * sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
rvm v1_m 0  1e12
rpm p1_m 0  1e12
rqm q1_m 0 1e12
rim i_m 0 1e12
rsm s_m 0 1e12
rmax1   v1r  0  1e12
rmax2   v1i  0  1e12
.ends




* pv_slack without sgn() function
* P=vr*ir+vi*ii
* V=sqrt(vr*vr+vi*vi)
* vr=(P*ir +/- ii*sqrt((V*V*(ir*ir+ii*ii))-P*P))/(ir*ir+ii*ii) + for delivering Q - for consuming Q
* vi=(P*ii -/+ ir*sqrt((V*V*(ir*ir+ii*ii))-P*P))/(ir*ir+ii*ii) - for delivering Q + for consuming Q
* This model has q-limits and has good convergence
* In this model only the negative q output is used (Solution 1)
* To let the model only output negative q values
* The q-limit is changed internally from qlo,qup to
* qmin,qmax which are now negative to zero. To let the pv element only output negative
* q values a l_batt element is switched to the pv-element
* and so the pv-element is forced to output only negative values
* This all make the convergence much better as in the q-signed valued
* case
* NOTE: If Qmin/Qmax is reached the Q ouput is a bit voltage dependent
* If you don't want this go to pv_slack_LF3 model

.subckt pv_slack_LF v1r v1i v_m p_m q_mx
+ params:
+ on=1 ; not used
+ vmag = 1
+ p = 0
+ qlo=-100e6
+ qup=50e6
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ ilolim=-100e9
+ iuplim=100e9
+ uout=1
.param p1 = {p/sfactor}
.param v1 = {vmag/vfactor}
.param fact=0
.param fact2={fact+1}
.param qmin={(qlo-qup)*fact2}
.param qmax={(qlo-qup)*fact}
.param qlbatt={-qmin+qlo}
  v1 ss 0 1 ; for source stepping
* l_batt to ensure only negative q output of the PV slack
  xLoad  v1r v1i v2_m q2_m l_batt_LF params: on={on} q={qlbatt} vn={vmag} vfactor={vfactor} sfactor={sfactor}
* PQ output of the slack
  gi1r   v1r   v10  Value = {LIMIT( ((p*v(ss)*v(ss)*on/sfactor)*v(v1r))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)) +
  +                           ((v(q_m)*v(ss)*v(ss)*on/sfactor)*v(v1i))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)),ilolim,iuplim) } tripdv={TRIPDV} tripdt={TRIPDT} ; i1r
  gi1i   v1i   v20  Value = {LIMIT( ((-v(q_m)*v(ss)*v(ss)*on/sfactor)*v(v1r))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)) +
  +                           ((p*v(ss)*v(ss)*on/sfactor)*v(v1i))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)),ilolim,iuplim) } tripdv={TRIPDV} tripdt={TRIPDT} ; i1i
  vi1r   v10   0    dc 0v;   currentmeter
  vi1i   v20   0    dc 0v;   currentmeter
* now the equations : with v1r1 and with v1i1 -> q_m1(q_m) is computed, and this is the input for the constpower element above
  gv1r  0   v1r1  value =  {on*((p1*v(ss)*v(ss)*i(vi1r)+i(vi1i)*sqrt((v1*v(ss))**2*(i(vi1r)**2+i(vi1i)**2)-(p1*v(ss)*v(ss))**2))/(i(vi1r)**2+i(vi1i)**2)+1e-10)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT} ; real volt output
  gv1i  0   v1i1  value =  {on*((p1*v(ss)*v(ss)*i(vi1i)-i(vi1r)*sqrt((v1*v(ss))**2*(i(vi1r)**2+i(vi1i)**2)-(p1*v(ss)*v(ss))**2))/(i(vi1r)**2+i(vi1i)**2)+1e-10)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT} ; imag volt output
  gqlim 0 q_m value={on*limit(v(q_m1),qmin,qmax)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  gq    0 q_m1 value = {(v(v1i1)*i(vi1r)-v(v1r1)*i(vi1i))*sfactor} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}  ; imag power
  * measurement stuff
  ev v_m  0 value = {uout*vfactor*sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))+(1-uout)*v(i_m)} tripdv={TRIPDV} tripdt={TRIPDT} ; abs. voltage
  ep p_m  0 value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}  ; real power
  eqmx  q_mx 0 value={v(q_m)+v(q2_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  eiabs_m i_m 0 value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))} tripdv={TRIPDV} tripdt={TRIPDT} ; abs. current
  es1mag_m  s_m 0 value = {sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))*v(i_m) * sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  rvm v_m 0  1e12
  rpm p_m 0  1e12
  rqmx q_mx 0 1e12
  rim i_m 0 1e12
  rsm s_m 0 1e12
  rmax1   v1r  0  1e12
  rmax2   v1i  0  1e12
.ends

* pv_slack with sgn() function for q
* This model converges often not for positive Q output
* Therefore use instead PV_slack_LF and LF3 model !!!!!!
* which convert qlo,qup to only negative Q values qmin...0
* P=vr*ir+vi*ii
* V=sqrt(vr*vr+vi*vi)
* vr=(P*ir +/- ii*sqrt((V*V*(ir*ir+ii*ii))-P*P))/(ir*ir+ii*ii) + for delivering Q - for consuming Q
* vi=(P*ii -/+ ir*sqrt((V*V*(ir*ir+ii*ii))-P*P))/(ir*ir+ii*ii) - for delivering Q + for consuming Q
* experimental! better use pv_slack_LF3 for better convergence

.subckt pv_slack_LF2 v1r v1i v_m p_m q_m
+ params:
+ on=1
+ vmag = 1
+ p = 0
+ qlo=-100e6
+ qup=50e6
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ ilolim=-100e9
+ iuplim=100e9
+ uout=1
.param p1 = {p/sfactor}
.param v1 = {vmag/vfactor}
  v1 ss 0 1 ; for source stepping; const p,q output
  gi1r   v1r   v10  Value = {LIMIT( ((p*v(ss)*v(ss)*on/sfactor)*v(v1r))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)) +
  +                           ((v(q_m)*v(ss)*v(ss)*on/sfactor)*v(v1i))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)),ilolim,iuplim) } tripdv={TRIPDV} tripdt={TRIPDT} ; i1r
  gi1i   v1i   v20  Value = {LIMIT( ((-v(q_m)*v(ss)*v(ss)*on/sfactor)*v(v1r))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)) +
  +                           ((p*v(ss)*v(ss)*on/sfactor)*v(v1i))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)),ilolim,iuplim) } tripdv={TRIPDV} tripdt={TRIPDT} ; i1i
  vi1r   v10   0    dc 0v;   currentmeter
  vi1i   v20   0    dc 0v;   currentmeter
* now the equations : with v1r1 and with v1i1 q_m1(q_m) is computed
  gv1r  0   v1r1  value =  {on*((p1*v(ss)*v(ss)*i(vi1r)-i(vi1i)*sgn(v(q_m))*sqrt((v1*v(ss))**2*(i(vi1r)**2+i(vi1i)**2)-(p1*v(ss)*v(ss))**2))/(i(vi1r)**2+i(vi1i)**2)+1e-10)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT} ; real volt output
  gv1i  0   v1i1  value =  {on*((p1*v(ss)*v(ss)*i(vi1i)+i(vi1r)*sgn(v(q_m))*sqrt((v1*v(ss))**2*(i(vi1r)**2+i(vi1i)**2)-(p1*v(ss)*v(ss))**2))/(i(vi1r)**2+i(vi1i)**2)+1e-10)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT} ; imag volt output
  gq 0  q_m1 value = {(v(v1i1)*i(vi1r)-v(v1r1)*i(vi1i))*sfactor} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}  ; imag power
  * measurement stuff
  evm  v_m 0 value = {uout*vfactor*sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))*(1-uout)*v(i_m)} tripdv={TRIPDV} tripdt={TRIPDT} ; abs. voltage
  epm  p_m 0 value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}  ; real power
  eqlim q_m 0 value={on*limit(v(q_m1),qlo,qup)} tripdv={TRIPDV} tripdt={TRIPDT}
  eiabs_m i_m 0 value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))} tripdv={TRIPDV} tripdt={TRIPDT} ; abs. current
  es1mag_m  s_m 0 value = {sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))*v(i_m) * sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  rvm  v_m 0 1e12
  rpm  p_m 0 1e12
  rqm  q_m 0 1e12
  rim i_m 0 1e12
  rsm s_m 0 1e12
  rmax1   v1r  0  1e12
  rmax2   v1i  0  1e12
.ends

*********************************************************************
* pv_slack without sgn() function -> THIS SHOULD BE THE DEFAULT SLACK
*********************************************************************
* P=vr*ir+vi*ii
* V=sqrt(vr*vr+vi*vi) -> follows: the signed version
****************************************************************************************************
* vr=(P*ir +/- ii*sqrt((V*V*(ir*ir+ii*ii))-P*P))/(ir*ir+ii*ii) + for delivering Q - for consuming Q
* vi=(P*ii -/+ ir*sqrt((V*V*(ir*ir+ii*ii))-P*P))/(ir*ir+ii*ii) - for delivering Q + for consuming Q
****************************************************************************************************
* This model has q-limits and has good convergence
* In this model only the first part of the equns are used:
* negative q output is used (The part for delivering q !!)
* To let the model only output negative q values
* The q-limit is shifted internally from qlo ,qup to
* qmin=qlo-qup and qmax=0 which are now negative to zero. To let the pv element only output negative
* q values a constant power element (P0=0 Q=-qmin+qlo) is switched parallel to the pv-element
* and so the pv-element is forced to output only negative q values
* This all make the convergence much better as in the q-signed valued
* case. Therefore this model is the default for pv-slacks !
* In this model also a new parameter dp is defined which is default zero
* If <>0 this parameter can help convergence especially in the special P=0 case
* This parameter shifts the p-output of the PV-slack which is now
* feeding a constant power element (P=dp Q=qconst)


.subckt pv_slack_LF3 v1r v1i v_m p_m q_mx
+ params:
+ on=1 ; not used
+ vmag = 1
+ p = 0
+ qlo=-100e6
+ qup=50e6
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ dp=0 ; try to change this parameter if convergence fails with a specific p-value  (especially with zero p)
+ ilolim=-100e9
+ iuplim=100e9
+ rp=1e10
+ uout=1
.param p1 = {(p+dp)/sfactor}
.param v1 = {vmag/vfactor}
.param fact=0
.param fact2={fact+1}
.param qmin={(qlo-qup)*fact2}
.param qmax={(qlo-qup)*fact}
.param qconst={-qmin+qlo}
  v1 ss 0 1 ; for source stepping
* PQ-element to ensure only negative q output of the PV slack
  xLoad  v1r v1i v2_m p2_m q2_m constpower_LF params: on={on} q={qconst} p={-dp} vfactor={vfactor} sfactor={sfactor} ilolim={ilolim} iuplim={iuplim}
* PQ-output of the slack
  gi1r   v1r   v10  Value = {LIMIT( (((p+dp)*v(ss)*v(ss)*on/sfactor)*v(v1r))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)) +
  +                           ((v(q_m)*v(ss)*v(ss)*on/sfactor)*v(v1i))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)),ilolim,iuplim) } tripdv={TRIPDV} tripdt={TRIPDT} ; i1r
  gi1i   v1i   v20  Value = {LIMIT( ((-v(q_m)*v(ss)*v(ss)*on/sfactor)*v(v1r))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)) +
  +                           (((p+dp)*v(ss)*v(ss)*on/sfactor)*v(v1i))/(v(v1r)*v(v1r)+v(v1i)*v(v1i)),ilolim,iuplim) } tripdv={TRIPDV} tripdt={TRIPDT} ; i1i
  vi1r   v10   0    dc 0v;   currentmeter
  vi1i   v20   0    dc 0v;   currentmeter
* now the equations : with v1r1 and with v1i1 -> q_m1(q_m) is computed, and this is the input for the PQ element above
  gv1r  0   v1r1  value =  {on*((p1*v(ss)*v(ss)*i(vi1r)+i(vi1i)*sqrt((v1*v(ss))**2*(i(vi1r)**2+i(vi1i)**2)-(p1*v(ss)*v(ss))**2))/(i(vi1r)**2+i(vi1i)**2)+1e-10)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT} ; real volt output
  gv1i  0   v1i1  value =  {on*((p1*v(ss)*v(ss)*i(vi1i)-i(vi1r)*sqrt((v1*v(ss))**2*(i(vi1r)**2+i(vi1i)**2)-(p1*v(ss)*v(ss))**2))/(i(vi1r)**2+i(vi1i)**2)+1e-10)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT} ; imag volt output
  gqlim 0  q_m  value={on*limit(v(q_m1),qmin,qmax)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  gq 0  q_m1  value = {(v(v1i1)*i(vi1r)-v(v1r1)*i(vi1i))*sfactor} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}  ; imag power
  * measurement stuff
  evm  v_m 0 value = {uout*vfactor*sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))+(1-uout)*v(i_m)}  tripdv={TRIPDV} tripdt={TRIPDT} ; abs. voltage
  epm  p_m  0 value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*sfactor-dp*on} tripdv={TRIPDV} tripdt={TRIPDT}  ; real power
  eqmx  q_mx 0 value={v(q_m)+v(q2_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  eiabs_m i_m 0 value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))} tripdv={TRIPDV} tripdt={TRIPDT} ; abs. current
  es1mag_m  s_m 0 value = {sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))*v(i_m) * sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  rvm v_m 0 1e12
  rpm p_m  0 1e12
  rqmx q_mx 0 1e12
  rim i_m 0 1e12
  rsm s_m 0 1e12
  rmax1   v1r  0  {rp}
  rmax2   v1i  0  {rp}
.ends


* Model for Vri_slack-Component
* Voltage slack with vr and vi (nominal value of real,imag part of voltage)
*
*
.subckt vri_slack_LF v1r v1i v_m p_m q_m
+ params:
+ on = 1
