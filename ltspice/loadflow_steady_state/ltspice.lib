  vi1i     v20    0    dc   0v
  * measurement stuff
  evabs_m v_m 0 value = {uout*vfactor*sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))+(1-uout)*v(i_m)}  tripdv={TRIPDV} tripdt={TRIPDT} ; abs. voltage
  ep1 p_m 0 value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}  ; real power
  eq1 q_m 0 value = {(v(v1i)*i(vi1r)-v(v1r)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}  ; imag power
  eiabs_m i_m 0 value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))} tripdv={TRIPDV} tripdt={TRIPDT} ; abs. current
  es1mag_m  s_m 0 value = {sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))*v(i_m) * sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  rvm v_m 0 1e12
  rpm p_m  0 1e12
  rqm q_m 0 1e12
  rsm s_m 0 1e12
  rim i_m 0 1e12
  rmax1   v1r  0  1e12
  rmax2   v1i  0  1e12
.ends
*$

* Model for Vri_slack-Component
* Voltage slack with vr and vi (nominal value of real,imag part of voltage)
* and with additional neutral port output pin
.subckt vri_slack_n_LF v1r v1i nr ni v_m p_m q_m
+ params:
+ on = 1
+ vr = 110000
+ vi = 0
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ uout=1
  ev1r     v1r    v10  value =  { on*(vr/vfactor)+(1-on)*v(v1r,nr) } tripdv={TRIPDV} tripdt={TRIPDT} ; real volt output
  ev1i     v1i    v20  value =  { on*(vi/vfactor)+(1-on)*v(v1i,ni) } tripdv={TRIPDV} tripdt={TRIPDT} ; imag volt output
  vi1r     v10    nr    dc   0v
  vi1i     v20    ni   dc   0v
  * measurement stuff
  evabs_m  v_m 0 value = {uout*vfactor*sqrt(v(v1r,nr)*v(v1r,nr)+v(v1i,ni)*v(v1i,ni))+(1-uout)*v(i_m)}  tripdv={TRIPDV} tripdt={TRIPDT} ; abs. voltage
  ep1  p_m 0  value = {(v(v1r,nr)*i(vi1r)+v(v1i,ni)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}  ; real power
  eq1  q_m 0  value = {(v(v1i,ni)*i(vi1r)-v(v1r,nr)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}  ; imag power
  eiabs_m i_m 0 value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))} tripdv={TRIPDV} tripdt={TRIPDT} ; abs. current
  es1mag_m  s_m 0 value = {sqrt(v(v1r,nr)*v(v1r,nr)+v(v1i,ni)*v(v1i,ni))*v(i_m) * sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  rvm v_m 0 1e12
  rpm p_m  0 1e12
  rqm q_m 0 1e12
  rim i_m 0 1e12
  rsm s_m 0 1e12
  rmax1   v1r  0  1e12
  rmax2   v1i  0  1e12
.ends
*$
* Model for Vri_slack-Component
* delta Voltage slack with vr and vi (nominal value of real,imag part of voltage)
* and with additional output pins
.subckt vri_slack_LF2 v1r n1r v1i n1i v_m p_m q_m
+ params:
+ on = 1
+ vr = 110000
+ vi = 0
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ uout=1
  ev1r     v1r    v10  value =  { on*(vr/vfactor)+(1-on)*v(v1r,n1r) } tripdv={TRIPDV} tripdt={TRIPDT} ; real volt output
  ev1i     v1i    v20  value =  { on*(vi/vfactor)+(1-on)*v(v1i,n1i) } tripdv={TRIPDV} tripdt={TRIPDT} ; imag volt output
  vi1r     v10    n1r    dc   0v
  vi1i     v20    n1i    dc   0v
  * measurement stuff
  ev1mag_m v_m 0 value = {uout*vfactor * sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))+(1-uout)*v(i1_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  ev2mag_m v2_m 0 value = {vfactor * sqrt(v(n1r)*v(n1r)+v(n1i)*v(n1i))} tripdv={TRIPDV} tripdt={TRIPDT}
  ei1mag_m i1_m 0 value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))} tripdv={TRIPDV} tripdt={TRIPDT}
  ei2mag_m i2_m 0 value = {-v(i1_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  es1mag_m s1_m 0 value = {v(v_m)*v(i1_m) * sfactor/vfactor } tripdv={TRIPDV} tripdt={TRIPDT}
  ep1 p_m 0  value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  ep2 p2_m 0  value = {(v(n1r)*i(vi1r)+v(n1i)*i(vi1i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  eq1 q_m 0  value = {(v(v1i)*i(vi1r)-v(v1r)*i(vi1i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  eq2 q2_m 0  value = {(v(n1i)*i(vi1r)-v(n1r)*i(vi1i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  epv pv_m 0  value = {v(p_m)+v(p2_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  eqv qv_m 0  value = {v(q_m)+v(q2_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  rv1mag v_m 0 1e12
  rv2mag v2_m 0 1e12
  ri1mag i1_m 0 1e12
  ri2mag i2_m 0 1e12
  rsmag s1_m 0 1e12
  rp1 p_m  0 1e12
  rp2 p2_m  0 1e12
  rq1 q_m  0 1e12
  rq2 q2_m  0 1e12
  rpv pv_m  0 1e12
  rqv qv_m  0 1e12
  rmax1  v1r  0   1e12
  rmax2  v1i  0   1e12
  rmax3  n1r  0   1e12
  rmax4  n1i  0   1e12
.ends
*
* Iri_Slack
* Constant current element
* ir,ii real and imag current input
.subckt iri_slack_LF v1r v1i i_m p_m q_m
+ params:
+ on = 1
+ ir = 400
+ ii = 0
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ uout=0
  i1r   v1r    v10  dc  {on*ir} ; real curr output
  i1i   v1i    v20  dc  {on*ii} ; imag curr output
  vi1r  v10    0    dc  0v
  vi1i  v20    0    dc  0v
  * measurement stuff
  eiabs_m i_m 0 value = {(1-uout)*sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))+uout*v(v_m)}  tripdv={TRIPDV} tripdt={TRIPDT} ; abs. current
  evabs_m v_m 0 value = {vfactor*sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))}  tripdv={TRIPDV} tripdt={TRIPDT} ; abs. voltage
  es1mag_m  s_m 0 value = {sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))*v(i_m) * sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  ep1 p_m 0 value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}  ; real power
  eq1 q_m 0 value = {(v(v1i)*i(vi1r)-v(v1r)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}  ; imag power
  rvm v_m 0 1e12
  rpm p_m  0 1e12
  rqm q_m 0 1e12
  rim i_m 0 1e12
  rsm s_m 0 1e12
.ends
