.subckt peterson_ctrl_LF v1r v1i v1_m i1_m z1_m i1
+ params:
+ on = 1
+ r_x = 0.03
+ vn = 10000
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ zfactor = 1.0
  rin i1 0 1e12
  gzd 0 zd  value = {vn/vfactor/v(i1)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  gr  0 r   value = {r_x*v(zd)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  gxl 0 xl  value = {sqrt(v(zd)*v(zd)-v(r)*v(r))} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  gz1r 0 z1r value = {(zfactor*v(r))} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  gz1i 0 z1i value = {(zfactor*v(xl))} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  gg1r 0 g1r value = {(v(z1r)/(v(z1r)*v(z1r)+v(z1i)*v(z1i)))*on} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  gg1i 0 g1i value = {(-v(z1i)/(v(z1r)*v(z1r)+v(z1i)*v(z1i)))*on} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  gi1r   v1r   v01  Value = {(v(v1r)*v(g1r)-v(v1i)*v(g1i))} tripdv={TRIPDV} tripdt={TRIPDT}; i1r
  gi1i   v1i   v02  Value = {(v(v1r)*v(g1i)+v(v1i)*v(g1r))} tripdv={TRIPDV} tripdt={TRIPDT}; i1i
  vi1r   v01   0    dc 0v;   Currentmeter
  vi1i   v02   0    dc 0v;   Currentmeter
  ev1mag_m  v1_m 0 value = {sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  ei1mag_m  i1_m 0 value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  ep1 p1_m 0 value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq1 q1_m 0 value = {(v(v1i)*i(vi1r)-v(v1r)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  ez1 z1_m 0 value = {v(v1_m)/v(i1_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  rv1mag v1_m 0 1e12
  ri1mag i1_m 0 1e12
  rp1 p1_m  0 1e12
  rq1 q1_m  0 1e12
  rz1 z1_m  0 1e12
  rmax1  v1r  0   1e12
  rmax2  v1i  0   1e12
.ends


.subckt c_batt_ctrl_LF v1r v1i v1_m q1_m on qf
+ params:
+ q=50e6
+ vn = 110000
+ r_x=0.001 ; new with loss
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ uout=1
 ron on 0 1e12
 rqf qf 0 1e12
 ggi  0  gi  value={-(q)*v(qf)/((vn)*(vn))} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
 ggr  0  gr value = {(q)*r_x*v(qf)/((vn)*(vn))} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
 gi1r v1r v10  value = {v(on)*v(v1i)*v(gi)+v(on)*v(v1r)*v(gr)} tripdv={TRIPDV} tripdt={TRIPDT}
 gi1i v1i v20  value = {-v(on)*v(v1r)*v(gi)+v(on)*v(v1i)*v(gr)} tripdv={TRIPDV} tripdt={TRIPDT}
 vi1r v10 0 dc 0v
 vi1i v20 0 dc 0v
  ev1mag_m  v1_m 0 value = {uout*vfactor * sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))+(1-uout)*v(i1_m)}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  ei1mag_m  i1_m 0 value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))}  tripdv={TRIPDV} tripdt={TRIPDT}  ;
  eq1 q1_m 0 value = {(v(v1i)*i(vi1r)-v(v1r)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  ep1 p1_m 0 value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  rv1mag v1_m 0 1e12
  ri1mag i1_m 0 1e12
  rq1 q1_m  0 1e12
  rp1 p1_m 0 1e12
  rmax1  v1r  0   1e12
  rmax2  v1i  0   1e12
.ends
*$

