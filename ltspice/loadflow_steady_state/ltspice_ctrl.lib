  eqv qv_m 0  value = {v(q1_m)+v(q2_m)}  tripdv={TRIPDV} tripdt={TRIPDT}
  rv1mag v1_m 0 1e12
  rv2mag v2_m 0 1e12
  ri1mag i1_m 0 1e12
  rsmag s1_m 0 1e12
  rp1 p1_m  0 1e12
  rp2 p2_m  0 1e12
  rq1 q1_m  0 1e12
  rq2 q2_m  0 1e12
  rpv pv_m  0 1e12
  rqv qv_m  0 1e12
  rmax1  v1r  0   1e12
  rmax2  v1i  0   1e12
  rmax3  v2r  0   1e12
  rmax4  v2i  0   1e12
.ends

.subckt z_xc_ctrl_LF  v1r v1i v2r v2i p1_m q1_m v1_m p2_m q2_m on xc
+ params:
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ zfactor = 1.0
+ uout=1
 ron on 0 1e12
 rxc xc 0 1e12
 gxcs 0  xcs value = {v(xc)*(zfactor)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
 gi12r v1r v10 value = {-v(on)*(v(v1i)-v(v2i))/v(xcs)} tripdv={TRIPDV} tripdt={TRIPDT}
 gi12i v1i v20 value = {v(on)*(v(v1r)-v(v2r))/v(xcs)} tripdv={TRIPDV} tripdt={TRIPDT}
 vi12r v10 v2r dc 0v
 vi12i v20 v2i dc 0v
  ev1mag_m  v1_m 0 value = {uout*vfactor * sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))+(1-uout)*v(i1_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  ev2mag_m  v2_m 0 value = {vfactor * sqrt(v(v2r)*v(v2r)+v(v2i)*v(v2i))} tripdv={TRIPDV} tripdt={TRIPDT}
  ei1mag_m  i1_m 0 value = {sqrt(i(vi12r)*i(vi12r)+i(vi12i)*i(vi12i))} tripdv={TRIPDV} tripdt={TRIPDT}
  es1mag_m  s1_m 0 value = {sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))*v(i1_m) * sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  ep1 p1_m 0  value = {(v(v1r)*i(vi12r)+v(v1i)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  ep2 p2_m 0  value = {-(v(v2r)*i(vi12r)+v(v2i)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq1 q1_m 0  value = {(v(v1i)*i(vi12r)-v(v1r)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq2 q2_m 0  value = {-(v(v2i)*i(vi12r)-v(v2r)*i(vi12i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  epv pv_m 0  value = {v(p1_m)+v(p2_m)}  tripdv={TRIPDV} tripdt={TRIPDT}
  eqv qv_m 0  value = {v(q1_m)+v(q2_m)}  tripdv={TRIPDV} tripdt={TRIPDT}
  rv1mag v1_m 0 1e12
  rv2mag v2_m 0 1e12
  ri1mag i1_m 0 1e12
  rsmag s1_m 0 1e12
  rp1 p1_m  0 1e12
  rp2 p2_m  0 1e12
  rq1 q1_m  0 1e12
  rq2 q2_m  0 1e12
  rpv pv_m  0 1e12
  rqv qv_m  0 1e12
  rmax1  v1r  0   1e12
  rmax2  v1i  0   1e12
  rmax3  v2r  0   1e12
  rmax4  v2i  0   1e12
.ends
*
*
*
* Help - Routine to compute transformer model from physical transformer data
*
.subckt Trafo2Model_ctrl_LF ykros ykios y0ros y0ios inos inus xkos rkos rfeos xhos i0 ife imue
+ unos uen sn vfe vcu ukn i02in
runos unos 0 1e12
ruen  uen  0 1e12
rsn   sn   0 1e12
rvfe  vfe  0 1e12
rvcu  vcu  0 1e12
rukn  ukn  0 1e12
ri02in i02in 0 1e12
geur	 0 ur		value={v(vcu)/v(sn)} tripdv={TRIPDV} tripdt={TRIPDT} rpar=1
geusigma 0 usigma   value={sqrt(v(ukn)*v(ukn)-v(ur)*v(ur))} tripdv={TRIPDV} tripdt={TRIPDT} rpar=1
gezkros  0 zkros    value={(v(unos)*v(unos)/v(sn))*v(ur)} tripdv={TRIPDV} tripdt={TRIPDT} rpar=1
gezkios  0 zkios    value={(v(unos)*v(unos)/v(sn))*v(usigma)} tripdv={TRIPDV} tripdt={TRIPDT} rpar=1
geykros  0 ykros    value={v(zkros)/(v(zkros)*v(zkros)+v(zkios)*v(zkios))} tripdv={TRIPDV} tripdt={TRIPDT} rpar=1
geykios  0 ykios    value={-v(zkios)/(v(zkros)*v(zkros)+v(zkios)*v(zkios))} tripdv={TRIPDV} tripdt={TRIPDT} rpar=1
gey0ros  0 y0ros    value={v(vfe)/(v(unos)*v(unos))} tripdv={TRIPDV} tripdt={TRIPDT} rpar=1
gey0ios  0 y0ios    value={(-v(sn)/(v(unos)*v(unos)))*sqrt(v(i02in)*v(io2in)-(v(vfe)*v(vfe)/v(sn)/v(sn)))} tripdv={TRIPDV} tripdt={TRIPDT} rpar=1
******************************
* Data for transformer model *
******************************
gekros  0 ykros  value = {v(ykros)} tripdv={TRIPDV} tripdt={TRIPDT} rpar=1
gekios  0 ykios  value = {v(ykios)} tripdv={TRIPDV} tripdt={TRIPDT} rpar=1
ge0ros  0 y0ros  value = {v(y0ros)} tripdv={TRIPDV} tripdt={TRIPDT} rpar=1
ge0ios  0 y0ios  value = {v(y0ios)} tripdv={TRIPDV} tripdt={TRIPDT} rpar=1
*
**************************************
* other interesting transformer-data *
**************************************
geinos  0 inos    value = {v(sn)/v(unos)/sqrt(3)} tripdv={TRIPDV} tripdt={TRIPDT} rpar=1   ; nominal current on primary side
geinus  0 inus    value = {v(uen)*v(sn)/v(unos)/sqrt(3)} tripdv={TRIPDV} tripdt={TRIPDT} rpar=1 ; nominal current on secondary side
gexkos  0 xkos    value = {v(usigma)*v(unos)*v(unos)/v(sn)} tripdv={TRIPDV} tripdt={TRIPDT} rpar=1 ; inductive part of short circuit impedance
gerkos  0 rkos    value = {v(ur)*v(unos)*v(unos)/v(sn)} tripdv={TRIPDV} tripdt={TRIPDT} rpar=1     ; ohmic part of short circuit impedance -> cooper lost
gerfeos 0 rfeos   value = {v(unos)*v(unos)/v(vfe)} tripdv={TRIPDV} tripdt={TRIPDT} rpar=1       ; lost due to iron modelled as resistance
gexhos  0 xhos    value = {v(unos)*v(unos)/(sqrt(v(i02in)*v(i02in)-(v(vfe)*v(vfe)/v(sn)/v(sn)))*v(sn))} tripdv={TRIPDV} tripdt={TRIPDT} rpar=1 ; magnetic field inductance
gei0    0 i0      value = {v(i02in)*v(inos)} tripdv={TRIPDV} tripdt={TRIPDT} rpar=1  ; open circuit current = ife + imue
geife   0 ife     value = {v(inos)*v(vfe)/v(sn)} tripdv={TRIPDV} tripdt={TRIPDT} rpar=1 ; current due to iron lost
geimue  0 imue    value = {sqrt(v(i0)*v(i0)-v(ife)*v(ife))} tripdv={TRIPDV} tripdt={TRIPDT} rpar=1 ; current to magnetize iron
*
.ends

*$
*
* Help - routine for computing cl from cb und ce
*
.subckt cbce2cl_ctrl_LF cl
+ cb ce
  rcb cb 0 1e12
  rce ce 0 1e12
  ge1 0  cl  value={(v(cb)-v(ce))/3} tripdv={TRIPDV} tripdt={TRIPDT} rpar=1
.ends

* end of lfl library
*$
;$SpiceType=MCAPSPICE
