  gi1i   v1i   v02  value = {v(v1r)*v(gi) + v(v1i)*v(gr) - v(v2r)*v(g1i) - v(v2i)*v(g1r)} tripdv={TRIPDV} tripdt={TRIPDT}; i1i
  gi2r   v2r   v03  value = {-v(v1r)*v(g1r) + v(v1i)*v(g1i) + v(v2r)*v(gr) - v(v2i)*v(gi)} tripdv={TRIPDV} tripdt={TRIPDT}; i2r
  gi2i   v2i   v04  value = {-v(v1r)*v(g1i) - v(v1i)*v(g1r) + v(v2r)*v(gi) + v(v2i)*v(gr)} tripdv={TRIPDV} tripdt={TRIPDT}; i2i
