  rv1mag v1_m 0 1e12
  rv2mag v2_m 0 1e12
  ri1mag i1_m 0 1e12
  ri2mag i2_m 0 1e12
  rsmag s1_m 0 1e12
  rp1 p1_m  0 1e12
  rp2 p2_m  0 1e12
  rq1 q1_m  0 1e12
  rq2 q2_m  0 1e12
  rpv pv_m  0 1e12
  rqv qv_m  0 1e12
  rmax1  v1r  0   1e12
