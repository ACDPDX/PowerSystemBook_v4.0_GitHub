* StAlu_U400_o2x560mm2_LF
*
.subckt StAlu_U400_o2x560mm2_LF v1r v1i v2r v2i p1_m q1_m v1_m p2_m q2_m
+ params:
+ on = 1
+ r = 0.026
+ xl = 0.31
+ l={xl/314.159}
+ cb = 11.3n
+ ce = 5.44n
+ g = 1e12
+ length = 1
+ omega = {omega_n}
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ zqfactor = 1.0
+ zlfactor = 1.0
+ uout=1 ; output at measurement pins are voltages - uout=0: output are currents
.param cl = {(cb-ce)/3}
.param c = { ce + 3*cl }
.param xl1=IF(l>0,l*omega,xl)
.param z1r = {zlfactor*length*r}
.param z1i = {zlfactor*length*xl1}
.param z0r = {(g*2)/length }
.param z0i = {-2*zqfactor/(length*omega*c)}
.param g0r = {(1/z0r)*on}
.param g0i = {(-1/z0i)*on}
.param g1r = {(z1r*on)/(z1r*z1r+z1i*z1i)}
.param g1i = {(-z1i*on)/(z1r*z1r+z1i*z1i)}
.param gr = {g1r+g0r}
.param gi = {g1i+g0i}
  gi1r   v1r   v01  Value = {v(v1r)*gr - v(v1i)*gi - v(v2r)*g1r + v(v2i)*g1i} tripdv={TRIPDV} tripdt={TRIPDT}
  gi1i   v1i   v02  Value = {v(v1r)*gi + v(v1i)*gr - v(v2r)*g1i - v(v2i)*g1r} tripdv={TRIPDV} tripdt={TRIPDT}
  gi2r   v2r   v03  Value = {-v(v1r)*g1r + v(v1i)*g1i + v(v2r)*gr - v(v2i)*gi} tripdv={TRIPDV} tripdt={TRIPDT}
  gi2i   v2i   v04  Value = {-v(v1r)*g1i - v(v1i)*g1r + v(v2r)*gi + v(v2i)*gr} tripdv={TRIPDV} tripdt={TRIPDT}
  vi1r   v01   0    dc 0v;   currentmeterment fuer p1,q1,s1,i1
  vi1i   v02   0    dc 0v;   currentmeterment fuer p1,q1,s1,i1
  vi2r   v03   0    dc 0v;   currentmeterment fuer p2,q2,s2,i2
  vi2i   v04   0    dc 0v;   currentmeterment fuer p2,q2,s2,i2
  ev1mag_m  v1_m 0  value = {uout*vfactor * sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))+(1-uout)*v(i1_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  ev2mag_m  v2_m 0  value = {vfactor * sqrt(v(v2r)*v(v2r)+v(v2i)*v(v2i))} tripdv={TRIPDV} tripdt={TRIPDT}
  ei1mag_m  i1_m 0  value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))} tripdv={TRIPDV} tripdt={TRIPDT}
  ei2mag_m  i2_m 0  value = {sqrt(i(vi2r)*i(vi2r)+i(vi2i)*i(vi2i))} tripdv={TRIPDV} tripdt={TRIPDT}
  es1mag_m  s1_m 0  value = {sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))*v(i1_m) * sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  ep1 p1_m 0   value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  ep2 p2_m 0   value = {(v(v2r)*i(vi2r)+v(v2i)*i(vi2i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  eq1 q1_m 0   value = {(v(v1i)*i(vi1r)-v(v1r)*i(vi1i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  eq2 q2_m 0   value = {(v(v2i)*i(vi2r)-v(v2r)*i(vi2i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  epv pv_m 0   value = {v(p1_m)+v(p2_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  eqv qv_m 0   value = {v(q1_m)+v(q2_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  rv1mag v1_m 0 1e12
  rv2mag v2_m 0 1e12
  ri1mag i1_m 0 1e12
  ri2mag i2_m 0 1e12
  rsmag s1_m 0 1e12
  rp1 p1_m  0 1e12
  rp2 p2_m  0 1e12
  rq1 q1_m  0 1e12
  rq2 q2_m  0 1e12
  rpv pv_m  0 1e12
  rqv qv_m  0 1e12
  rmax1  v1r  0   1e12
  rmax2  v1i  0   1e12
  rmax3  v2r  0   1e12
  rmax4  v2i  0   1e12
.ends


.subckt StAlu_U400_o2x560mm2_ctrl_LF v1r v1i v2r v2i p1_m q1_m v1_m p2_m q2_m on length
