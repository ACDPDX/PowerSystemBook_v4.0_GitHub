.subckt RU_U400_U120_300MVA_LF v1r v1i v2r v2i p1_m q1_m v1_m v2_m p2_m q2_m
+ params:
+ on = 1
+	SN=300e6
+	U1Nenn=400e3
+	U20=120e3
+	uR=0.002
+	uX=0.2
+	i0=0.0006
+	p0=0.0004
+ stproz  = 1.0
+ l_ = 0
+ s_ = 0
+ middle = 0
+ phir = -0.5
+ phii = -0.866025404
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ zqfactor = 1.0
+ zlfactor = 1.0
+ sign1=1
+ sign2=1
