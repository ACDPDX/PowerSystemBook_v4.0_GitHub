.param gai = {(yki1+0.5*y0i1)*on}
.param gbr = {(-ue1r*ykr1+ue1i*yki1)*on}
.param gbi = {(-ue1i*ykr1-ue1r*yki1)*on}
.param gcr = {(-ue1r*ykr1-ue1i*yki1)*on}
.param gci = { (ue1i*ykr1-ue1r*yki1)*on}
.param gdr = { gar*(ue1r*ue1r+ue1i*ue1i)}
.param gdi = { gai*(ue1r*ue1r+ue1i*ue1i)}
  gi1r   v1r   v10  Value = {v(v1r)*gar - v(v1i)*gai + v(v2r)*gbr - v(v2i)*gbi} tripdv={TRIPDV} tripdt={TRIPDT}; i1r
