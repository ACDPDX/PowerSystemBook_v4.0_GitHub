  ep1 p1_m 0   value = {(v(v1r)*i(GBr)+v(v1i)*i(GBi))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  ep2 p2_m 0   value = {(v(v2r)*i(EBrr)+v(v2i)*i(EBri))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  eq1 q1_m 0   value = {(v(v1i)*i(GBr)-v(v1r)*i(GBi))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  eq2 q2_m 0   value = {(v(v2i)*i(EBrr)-v(v2r)*i(EBri))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  epv pv_m 0   value = {v(p1_m)+v(p2_m)} 
