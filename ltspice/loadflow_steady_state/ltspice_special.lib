  greL  0  rel  value = {(ue)*sign1*(v(l_)-(middle))*(stproz)/100} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  greS  0  res  value = {(ue)*sign2*(v(s_)-(middle))*(stproz)/100} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  gue1r 0  ue1r value = {ue*(uerfact)+(v(reL)*uerfact)-v(reS)*(ueifact*phii)+v(reS)*(uerfact*phir)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  gue1i 0  ue1i value = {ue*(ueifact)+(v(reL)*ueifact)+v(reS)*(uerfact*phii)+v(reS)*(ueifact*phir)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  ggar  0  gar  value = {((ykr1)+0.5*(y0r1))*v(on)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  ggai  0  gai  value = {((yki1)+0.5*(y0i1))*v(on)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  ggbr  0  gbr  value = {(-v(ue1r)*(ykr1)+v(ue1i)*(yki1))*v(on)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  ggbi  0  gbi  value = {(-v(ue1i)*(ykr1)-v(ue1r)*(yki1))*v(on)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  ggcr  0  gcr  value = {(-v(ue1r)*(ykr1)-v(ue1i)*(yki1))*v(on)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  ggci  0  gci  value = {(v(ue1i)*(ykr1)-v(ue1r)*(yki1))*v(on)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  ggdr  0  gdr  value = {v(gar)*(v(ue1r)*v(ue1r)+v(ue1i)*v(ue1i))} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  ggdi  0  gdi  value = {v(gai)*(v(ue1r)*v(ue1r)+v(ue1i)*v(ue1i))} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  gi1r   v1r   v10  value = {v(v1r)*v(gar) - v(v1i)*v(gai) + v(v2r)*v(gbr) - v(v2i)*v(gbi)} tripdv={TRIPDV} tripdt={TRIPDT}; i1r
  gi1i   v1i   v20  value = {v(v1r)*v(gai) + v(v1i)*v(gar) + v(v2r)*v(gbi) + v(v2i)*v(gbr)} tripdv={TRIPDV} tripdt={TRIPDT}; i1i
  gi2r   v2r   v30  value = {v(v1r)*v(gcr) - v(v1i)*v(gci) + v(v2r)*v(gdr) - v(v2i)*v(gdi)} tripdv={TRIPDV} tripdt={TRIPDT}; i2r
  gi2i   v2i   v40  value = {v(v1r)*v(gci) + v(v1i)*v(gcr) + v(v2r)*v(gdi) + v(v2i)*v(gdr)} tripdv={TRIPDV} tripdt={TRIPDT}; i2i
  vi1r   v10   0    dc 0v;   Strommessung
  vi1i   v20   0    dc 0v;   Strommessung
  vi2r   v30   0    dc 0v;   Strommessung
  vi2i   v40   0    dc 0v;   Strommessung
  ev1mag_m  v1_m 0  value = {uout*vfactor * sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))+(1-uout)*v(i1_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  ev2mag_m  v2_m 0  value = {uout*vfactor * sqrt(v(v2r)*v(v2r)+v(v2i)*v(v2i))+(1-uout)*v(i2_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  ei1mag_m  i1_m 0  value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))} tripdv={TRIPDV} tripdt={TRIPDT}
  ei2mag_m  i2_m 0  value = {sqrt(i(vi2r)*i(vi2r)+i(vi2i)*i(vi2i))} tripdv={TRIPDV} tripdt={TRIPDT}
  es1mag_m  s1_m 0  value = {sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))*v(i1_m) * sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  ep1  p1_m  0 value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  ep2  p2_m  0 value = {(v(v2r)*i(vi2r)+v(v2i)*i(vi2i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq1  q1_m  0 value = {(v(v1i)*i(vi1r)-v(v1r)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq2  q2_m  0 value = {(v(v2i)*i(vi2r)-v(v2r)*i(vi2i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  epv  pv_m  0  value = {v(p1_m)+v(p2_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  eqv  qv_m  0  value = {v(q1_m)+v(q2_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  rv1mag v1_m 0 1e12
  rv2mag v2_m 0 1e12
  ri1mag i1_m 0 1e12
  ri2mag i2_m 0 1e12
  rsmag s1_m 0 1e12
  rp1 p1_m  0 1e12
  rp2 p2_m  0 1e12
  rq1 q1_m  0 1e12
  rq2 q2_m  0 1e12
  rpv pv_m  0 1e12
  rqv qv_m  0 1e12
  rmax1  v1r  0   1e12
  rmax2  v1i  0   1e12
  rmax3  v2r  0   1e12
  rmax4  v2i  0   1e12
.ends


* RU_U400_U116_300MVA_LF

.subckt RU_U400_U116_300MVA_LF v1r v1i v2r v2i p1_m q1_m v1_m v2_m p2_m q2_m
+ params:
+ on = 1
+	SN=300e6
+	U1Nenn=400e3
+	U20=116e3
+	uR=0.002
+	uX=0.2
+	i0=0.0006
+	p0=0.0004
+ stproz  = 1.0
+ l_ = 0
+ s_ = 0
+ middle = 0
+ phir = -0.5
+ phii = -0.866025404
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ zqfactor = 1.0
+ zlfactor = 1.0
+ sign1=1
+ sign2=1
+ uout=1 ; output at measurement pins are voltages - uout=0: output are currents
***************************************************
.param delta=0
.param uerfact={(cos(-delta*3.1415926535897935/180))}
.param ueifact={(sin(-delta*3.1415926535897935/180))}
.param ue={U1Nenn/U20}             ; translation factor at l_=0
.param inos={SN/U1Nenn/sqrt(3)}    ; nominal current on primary side
.param inus={inos*U1Nenn/U20}      ; nominal current on secondary side
.param z1n={U1Nenn/sqrt(3)/inos}           ; nominal impedance
.param rkos={z1n*ur}             ; ohmic part of short circuit impedance -> cooper lost
.param xkos={z1n*ux}            ; inductive part of short circuit impedance
.param rfeos={U1Nenn*U1Nenn/(p0*SN)}  ; lost due to iron modelled as resistance
.param xhos={U1Nenn*U1Nenn/(SN*sqrt(i0*i0-p0*p0))}  ; magnetic field inductance
.param vfe={p0*SN}   ; iron_lost
.param vcu={ur*SN}   ; copper lost
.param imue={(U1Nenn/sqrt(3))/xhos}     ; current to magnetize iron
.param ife={(U1Nenn/sqrt(3))/rfeos}     ; current due to iron lost
.param i0abs={sqrt(imue*imue+ife*ife)}  ; open circuit current = ife + imue
.param ukn={sqrt(ur*ur+ux*ux)}          ; short circuit impedance
.param ykr={rkos/(rkos*rkos+xkos*xkos)}
.param yki={-xkos/(rkos*rkos+xkos*xkos)}
.param y0r={1/rfeos}
.param y0i={-1/xhos}
**************************************************
.param ykr1 = {ykr/zlfactor}
.param yki1 = {yki/zlfactor}
.param y0r1 = {y0r/zqfactor}
.param y0i1 = {y0i/zqfactor}
.param reL = {ue*(l_-middle)*stproz/100*sign1}
.param reS = {ue*(s_-middle)*stproz/100*sign2}
.param ue1r= {ue*(uerfact)+(reL*uerfact)-reS*(ueifact*phii)+reS*(uerfact*phir)}
.param ue1i= {ue*(ueifact)+(reL*ueifact)+reS*(uerfact*phii)+reS*(ueifact*phir)}
.param gar = {(ykr1+0.5*y0r1)*on}
.param gai = {(yki1+0.5*y0i1)*on}
.param gbr = {(-ue1r*ykr1+ue1i*yki1)*on}
.param gbi = {(-ue1i*ykr1-ue1r*yki1)*on}
.param gcr = {(-ue1r*ykr1-ue1i*yki1)*on}
.param gci = { (ue1i*ykr1-ue1r*yki1)*on}
.param gdr = { gar*(ue1r*ue1r+ue1i*ue1i)}
.param gdi = { gai*(ue1r*ue1r+ue1i*ue1i)}
  gi1r   v1r   v10  Value = {v(v1r)*gar - v(v1i)*gai + v(v2r)*gbr - v(v2i)*gbi} tripdv={TRIPDV} tripdt={TRIPDT}; i1r
  gi1i   v1i   v20  Value = {v(v1r)*gai + v(v1i)*gar + v(v2r)*gbi + v(v2i)*gbr} tripdv={TRIPDV} tripdt={TRIPDT}; i1i
  gi2r   v2r   v30  Value = {v(v1r)*gcr - v(v1i)*gci + v(v2r)*gdr - v(v2i)*gdi} tripdv={TRIPDV} tripdt={TRIPDT}; i2r
  gi2i   v2i   v40  Value = {v(v1r)*gci + v(v1i)*gcr + v(v2r)*gdi + v(v2i)*gdr} tripdv={TRIPDV} tripdt={TRIPDT}; i2i
  vi1r   v10   0    dc 0v;   currentmeterment
  vi1i   v20   0    dc 0v;   currentmeterment
  vi2r   v30   0    dc 0v;   currentmeterment
  vi2i   v40   0    dc 0v;   currentmeterment
  ev1mag_m  v1_m 0  value = {uout*vfactor * sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))+(1-uout)*v(i1_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  ev2mag_m  v2_m 0  value = {uout*vfactor * sqrt(v(v2r)*v(v2r)+v(v2i)*v(v2i))+(1-uout)*v(i2_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  ei1mag_m  i1_m 0  value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))} tripdv={TRIPDV} tripdt={TRIPDT}
  ei2mag_m  i2_m 0  value = {sqrt(i(vi2r)*i(vi2r)+i(vi2i)*i(vi2i))} tripdv={TRIPDV} tripdt={TRIPDT}
  es1mag_m  s1_m 0  value = {sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))*v(i1_m) * sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  ep1  p1_m  0 value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  ep2  p2_m  0 value = {(v(v2r)*i(vi2r)+v(v2i)*i(vi2i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq1  q1_m  0 value = {(v(v1i)*i(vi1r)-v(v1r)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq2  q2_m  0 value = {(v(v2i)*i(vi2r)-v(v2r)*i(vi2i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  epv  pv_m  0  value = {v(p1_m)+v(p2_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  eqv  qv_m  0  value = {v(q1_m)+v(q2_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  rv1mag v1_m 0 1e12
  rv2mag v2_m 0 1e12
  ri1mag i1_m 0 1e12
  ri2mag i2_m 0 1e12
  rsmag s1_m 0 1e12
  rp1 p1_m  0 1e12
  rp2 p2_m  0 1e12
  rq1 q1_m  0 1e12
  rq2 q2_m  0 1e12
  rpv pv_m  0 1e12
  rqv qv_m  0 1e12
  rmax1  v1r  0   1e12
  rmax2  v1i  0   1e12
  rmax3  v2r  0   1e12
  rmax4  v2i  0   1e12
.ends

* RU_U400_U116_300MVA_LF

.subckt RU_U400_U116_300MVA_ctrl_LF v1r v1i v2r v2i p1_m q1_m v1_m v2_m p2_m q2_m on l_ s_
+ params:
+	SN=300e6
+	U1Nenn=400e3
+	U20=116e3
+	uR=0.002
+	uX=0.2
+	i0=0.0006
+	p0=0.0004
+ stproz  = 1.0
+ middle = 0
+ phir = -0.5
+ phii = -0.866025404
+ vfactor = {sqrt(3)}
+ sfactor = 3
+ zqfactor = 1.0
+ zlfactor = 1.0
+ sign1=1
+ sign2=1
+ uout=1 ; output at measurement pins are voltages - uout=0: output are currents
***************************************************
.param delta=0
.param uerfact={(cos(-delta*3.1415926535897935/180))}
.param ueifact={(sin(-delta*3.1415926535897935/180))}
.param ue={U1Nenn/U20}
.param inos={SN/U1Nenn/sqrt(3)}    ; nominal current on primary side
.param inus={inos*U1Nenn/U20}      ; nominal current on secondary side
.param z1n={U1Nenn/sqrt(3)/inos}           ; nominal impedance
.param rkos={z1n*ur}             ; ohmic part of short circuit impedance -> cooper lost
.param xkos={z1n*ux}            ; inductive part of short circuit impedance
.param rfeos={U1Nenn*U1Nenn/(p0*SN)}  ; lost due to iron modelled as resistance
.param xhos={U1Nenn*U1Nenn/(SN*sqrt(i0*i0-p0*p0))}  ; magnetic field inductance
.param vfe={p0*SN}   ; iron_lost
.param vcu={ur*SN}   ; copper lost
.param imue={(U1Nenn/sqrt(3))/xhos}     ; current to magnetize iron
.param ife={(U1Nenn/sqrt(3))/rfeos}     ; current due to iron lost
.param i0abs={sqrt(imue*imue+ife*ife)}  ; open circuit current = ife + imue
.param ukn={sqrt(ur*ur+ux*ux)}
.param ykr={rkos/(rkos*rkos+xkos*xkos)}
.param yki={-xkos/(rkos*rkos+xkos*xkos)}
.param y0r={1/rfeos}
.param y0i={-1/xhos}
**************************************************
.param ykr1 = {ykr/zlfactor}
.param yki1 = {yki/zlfactor}
.param y0r1 = {y0r/zqfactor}
.param y0i1 = {y0i/zqfactor}
  ron on 0 1e12
  rl l_ 0 1e12
  rs s_ 0 1e12
  greL  0  rel  value = {(ue)*sign1*(v(l_)-(middle))*(stproz)/100} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  greS  0  res  value = {(ue)*sign2*(v(s_)-(middle))*(stproz)/100} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  gue1r 0  ue1r value = {ue*(uerfact)+(v(reL)*uerfact)-v(reS)*(ueifact*phii)+v(reS)*(uerfact*phir)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  gue1i 0  ue1i value = {ue*(ueifact)+(v(reL)*ueifact)+v(reS)*(uerfact*phii)+v(reS)*(ueifact*phir)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  ggar  0  gar  value = {((ykr1)+0.5*(y0r1))*v(on)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  ggai  0  gai  value = {((yki1)+0.5*(y0i1))*v(on)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  ggbr  0  gbr  value = {(-v(ue1r)*(ykr1)+v(ue1i)*(yki1))*v(on)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  ggbi  0  gbi  value = {(-v(ue1i)*(ykr1)-v(ue1r)*(yki1))*v(on)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  ggcr  0  gcr  value = {(-v(ue1r)*(ykr1)-v(ue1i)*(yki1))*v(on)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  ggci  0  gci  value = {(v(ue1i)*(ykr1)-v(ue1r)*(yki1))*v(on)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  ggdr  0  gdr  value = {v(gar)*(v(ue1r)*v(ue1r)+v(ue1i)*v(ue1i))} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  ggdi  0  gdi  value = {v(gai)*(v(ue1r)*v(ue1r)+v(ue1i)*v(ue1i))} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  gi1r   v1r   v10  value = {v(v1r)*v(gar) - v(v1i)*v(gai) + v(v2r)*v(gbr) - v(v2i)*v(gbi)} tripdv={TRIPDV} tripdt={TRIPDT}; i1r
  gi1i   v1i   v20  value = {v(v1r)*v(gai) + v(v1i)*v(gar) + v(v2r)*v(gbi) + v(v2i)*v(gbr)} tripdv={TRIPDV} tripdt={TRIPDT}; i1i
  gi2r   v2r   v30  value = {v(v1r)*v(gcr) - v(v1i)*v(gci) + v(v2r)*v(gdr) - v(v2i)*v(gdi)} tripdv={TRIPDV} tripdt={TRIPDT}; i2r
  gi2i   v2i   v40  value = {v(v1r)*v(gci) + v(v1i)*v(gcr) + v(v2r)*v(gdi) + v(v2i)*v(gdr)} tripdv={TRIPDV} tripdt={TRIPDT}; i2i
  vi1r   v10   0    dc 0v;   Strommessung
  vi1i   v20   0    dc 0v;   Strommessung
  vi2r   v30   0    dc 0v;   Strommessung
  vi2i   v40   0    dc 0v;   Strommessung
  ev1mag_m  v1_m 0  value = {uout*vfactor * sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))+(1-uout)*v(i1_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  ev2mag_m  v2_m 0  value = {uout*vfactor * sqrt(v(v2r)*v(v2r)+v(v2i)*v(v2i))+(1-uout)*v(i2_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  ei1mag_m  i1_m 0  value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))} tripdv={TRIPDV} tripdt={TRIPDT}
  ei2mag_m  i2_m 0  value = {sqrt(i(vi2r)*i(vi2r)+i(vi2i)*i(vi2i))} tripdv={TRIPDV} tripdt={TRIPDT}
  es1mag_m  s1_m 0  value = {sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))*v(i1_m) * sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  ep1  p1_m  0 value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  ep2  p2_m  0 value = {(v(v2r)*i(vi2r)+v(v2i)*i(vi2i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq1  q1_m  0 value = {(v(v1i)*i(vi1r)-v(v1r)*i(vi1i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  eq2  q2_m  0 value = {(v(v2i)*i(vi2r)-v(v2r)*i(vi2i))*sfactor}  tripdv={TRIPDV} tripdt={TRIPDT}
  epv  pv_m  0  value = {v(p1_m)+v(p2_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  eqv  qv_m  0  value = {v(q1_m)+v(q2_m)} tripdv={TRIPDV} tripdt={TRIPDT}
  rv1mag v1_m 0 1e12
  rv2mag v2_m 0 1e12
  ri1mag i1_m 0 1e12
  ri2mag i2_m 0 1e12
  rsmag s1_m 0 1e12
  rp1 p1_m  0 1e12
  rp2 p2_m  0 1e12
  rq1 q1_m  0 1e12
  rq2 q2_m  0 1e12
  rpv pv_m  0 1e12
  rqv qv_m  0 1e12
  rmax1  v1r  0   1e12
  rmax2  v1i  0   1e12
  rmax3  v2r  0   1e12
  rmax4  v2i  0   1e12
.ends


