**************************************************
.param ykr1 = {ykr/zlfactor}
.param yki1 = {yki/zlfactor}
.param y0r1 = {y0r/zqfactor}
.param y0i1 = {y0i/zqfactor}
****
ron on 0 1e12
****
* PI-controller ******************************************************************
R_R2        0 l_  1e12
*Ey   l_    0  VALUE={LIMIT((V(v2_m)-vref)*Kp+V(a),lmin,lmax)} tripdv={TRIPDV} tripdt={TRIPDT}
*Eq   a     0  VALUE={idt(V(x1)*((V(x1)>0&V(l_)<lmax)|((V(x1)<0)&V(l_)>lmin)),lstart)} tripdv={TRIPDV} tripdt={TRIPDT}
*Ex   x1    0  VALUE={(V(v2_m)-vref)*Kp * 1/Tn} tripdv={TRIPDV} tripdt={TRIPDT}
* I-Controller with better convergence
Ea   l_    0  VALUE={v(a)}
Eq   a     0  VALUE={idt(V(x1)*((V(x1)>0&V(l_)<lmax)|((V(x1)<0)&V(l_)>lmin)),lstart)} tripdv={TRIPDV} tripdt={TRIPDT}
Ex   x1    0  VALUE={(V(v2_m)-vref)*Ki} tripdv={TRIPDV} tripdt={TRIPDT}
*******************************************************************************
gereL  0  rel   value = {(ue)*(v(l_)-(middle))*(stproz)/100} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
gereS  0  res   value = {(ue)*(s_-(middle))*(stproz)/100} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
geue1r 0  ue1r  value = {(ue)+v(reL)+v(reS)*(phir)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
geue1i 0  ue1i  value = {v(reS)*(phii)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
gegar  0  gar   value = {((ykr1)+0.5*(y0r1))*v(on)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
gegai  0  gai   value = {((yki1)+0.5*(y0i1))*v(on)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
gegbr  0  gbr   value = {(-v(ue1r)*(ykr1)+v(ue1i)*(yki1))*v(on)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
gegbi  0  gbi   value = {(-v(ue1i)*(ykr1)-v(ue1r)*(yki1))*v(on)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
gegcr  0  gcr   value = {(-v(ue1r)*(ykr1)-v(ue1i)*(yki1))*v(on)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
gegci  0  gci   value = {(v(ue1i)*(ykr1)-v(ue1r)*(yki1))*v(on)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
gegdr  0  gdr   value = {v(gar)*(v(ue1r)*v(ue1r)+v(ue1i)*v(ue1i))} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
gegdi  0  gdi   value = {v(gai)*(v(ue1r)*v(ue1r)+v(ue1i)*v(ue1i))} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
gi1r   v1r   v10  value = {v(v1r)*v(gar) - v(v1i)*v(gai) + v(v2r)*v(gbr) - v(v2i)*v(gbi)} tripdv={TRIPDV} tripdt={TRIPDT}; i1r
gi1i   v1i   v20  value = {v(v1r)*v(gai) + v(v1i)*v(gar) + v(v2r)*v(gbi) + v(v2i)*v(gbr)} tripdv={TRIPDV} tripdt={TRIPDT}; i1i
gi2r   v2r   v30  value = {v(v1r)*v(gcr) - v(v1i)*v(gci) + v(v2r)*v(gdr) - v(v2i)*v(gdi)} tripdv={TRIPDV} tripdt={TRIPDT}; i2r
gi2i   v2i   v40  value = {v(v1r)*v(gci) + v(v1i)*v(gcr) + v(v2r)*v(gdi) + v(v2i)*v(gdr)} tripdv={TRIPDV} tripdt={TRIPDT}; i2i
vi1r   v10   0    dc 0v;   Currentmeter
vi1i   v20   0    dc 0v;   currentmeter
vi2r   v30   0    dc 0v;   currentmeter
vi2i   v40   0    dc 0v;   currentmeter
gi1mag_m 0 i1_m value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}  ;
gi2mag_m 0 i2_m value = {sqrt(i(vi2r)*i(vi2r)+i(vi2i)*i(vi2i))} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}  ;
gev1mag_m 0  v1_m  value = {uout*(vfactor) * sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))+(1-uout)*v(i1_m)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT} 
gev2mag_m 0  v2_m  value = {uout*(vfactor) * sqrt(v(v2r)*v(v2r)+v(v2i)*v(v2i))+(1-uout)*v(i2_m)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT} 
gep1 0  p1_m   value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*(sfactor)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
gep2 0  p2_m   value = {(v(v2r)*i(vi2r)+v(v2i)*i(vi2i))*(sfactor)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
geq1 0  q1_m   value = {(v(v1i)*i(vi1r)-v(v1r)*i(vi1i))*(sfactor)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
geq2 0  q2_m   value = {(v(v2i)*i(vi2r)-v(v2r)*i(vi2i))*(sfactor)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
gpv  0 pv_m  value = {v(p1_m)+v(p2_m)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
gqv  0 qv_m  value = {v(q1_m)+v(q2_m)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
rmax1  v1r  0   1e12
rmax2  v1i  0   1e12
rmax3  v2r  0   1e12
rmax4  v2i  0   1e12
.ends

.subckt loads_LF_constimpedance v1r v1i v1_m p1_m q1_m
+ params:
+ on = 1
+ p  = 0
+ q  = 0
+ vn = 120000
+ ilolim=-10000
+ iuplim=10000
+ vfactor = {vfactor}
+ sfactor = {sfactor}
+ uout=1
* constimpedance  k0
.param gp = {(p/sfactor)/(vn*vn/vfactor/vfactor)}
.param gq = {(q/sfactor)/(vn*vn/vfactor/vfactor)}
  gi1r2   v1r   v10 value = {LIMIT(v(li2r),ilolim,iuplim)} tripdv={TRIPDV} tripdt={TRIPDT} ; i1r
  gi1i2   v1i   v20 value = {LIMIT(v(li2i),ilolim,iuplim)} tripdv={TRIPDV} tripdt={TRIPDT} ; i1i
  g2ir  0  li2r Value = {(on*(gq*v(v1i)+gp*v(v1r)))} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  g2ii  0  li2i Value = {(-on*(gq*v(v1r)-gp*v(v1i)))} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  vi1r   v10   0    dc 0v;   currentmeter
  vi1i   v20   0    dc 0v;   currentmeter
  * to enable more measurement -> make additional nodes in first line and uncomment following lines
  * for inst. to enable measurement of i1_m(magnitude of i1) uncomment ei1mag_m and gi1mag_m and
  * insert additional node (i1_m) in .subckt line
  gv1mag_m  0 v1_m  value = {uout*vfactor * sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))+(1-uout)*v(i1_m)} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}  ;
  gi1mag_m 0  i1_m  value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}  ;
  gs1mag_m 0  s1_m  value = {sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))*v(i1_m1) * sfactor } rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}  ;
  * real,imag - parts of p,q,pv,qv,v1r,v1i
  egp1 p1_m 0 value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  egq1 q1_m 0 value = {(v(v1i)*i(vi1r)-v(v1r)*i(vi1i))*sfactor} tripdv={TRIPDV} tripdt={TRIPDT}
  rp1_m p1_m 0 1e12
  rq1_m q1_m 0 1e12
  rmax1   v1r  0  1e12
  rmax2   v1i  0  1e12
.ends


* with controlling nodes for on,pf,qf
.subckt loads_ctrl_LF_constimpedance v1r v1i v1_m p1_m q1_m on pf qf
+ params:
+ p  = 0
+ q  = 0
+ vn = 120000
+ ilolim=-10000
+ iuplim=10000
+ vfactor = {vfactor}
+ sfactor = {sfactor}
+ uout=1
ron on 0 1e12
rpf  pf 0 1e12
rqf  qf 0 1e12
* constimpedance  k0
.param gp = {(p/sfactor)/(vn*vn/vfactor/vfactor)}
.param gq = {(q/sfactor)/(vn*vn/vfactor/vfactor)}
  gi1r2   v1r   v10 value = {LIMIT(v(li2r),ilolim,iuplim)} tripdv={TRIPDV} tripdt={TRIPDT} ; i1r
  gi1i2   v1i   v20 value = {LIMIT(v(li2i),ilolim,iuplim)} tripdv={TRIPDV} tripdt={TRIPDT} ; i1i
  g2ir  0  li2r Value = {(v(on)*(gq*v(qf)*v(v1i)+gp*v(pf)*v(v1r)))} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  g2ii  0  li2i Value = {(-v(on)*(gq*v(qf)*v(v1r)-gp*v(pf)*v(v1i)))} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  vi1r   v10   0    dc 0v;   currentmeter
  vi1i   v20   0    dc 0v;   currentmeter
  * to enable more measurement -> make additional nodes in first line and uncomment following lines
  * for inst. to enable measurement of i1_m(magnitude of i1) uncomment ei1mag_m and gi1mag_m and
  * insert additional node (i1_m) in .subckt line
  gv1mag_m  0 v1_m  value = {uout*vfactor * sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))+(1-uout)*v(i1_m))} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}  ;
  gi1mag_m 0  i1_m  value = {sqrt(i(vi1r)*i(vi1r)+i(vi1i)*i(vi1i))} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}  ;
  gs1mag_m 0  s1_m  value = {sqrt(v(v1r)*v(v1r)+v(v1i)*v(v1i))*v(i1_m1) * sfactor } rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}  ;
  * real,imag - parts of p,q,pv,qv,v1r,v1i
  gp1 0  p1_m  value = {(v(v1r)*i(vi1r)+v(v1i)*i(vi1i))*sfactor} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  gq1 0  q1_m  value = {(v(v1i)*i(vi1r)-v(v1r)*i(vi1i))*sfactor} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  * gv1r 0 v1r_m  value = {v(v1r)*vfactor} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  * gv1i 0 v1i_m  value = {v(v1i)*vfactor} rpar=1 tripdv={TRIPDV} tripdt={TRIPDT}
  rmax1   v1r  0  1e12
  rmax2   v1i  0  1e12
.ends

