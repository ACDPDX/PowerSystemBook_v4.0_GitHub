Version 4
SHEET 1 880 680
WIRE 0 224 -16 224
FLAG -16 224 ResFreq
TEXT -24 64 Left 2 !.param fn=50\n.param omega={2*pi*fn}\n.param C={5012n*3}\n.param IN=300\n.param VN=110e3\n.param LTrafo={0.096/3}\n.param LLine={0.0035/3}\n.param Xc={1/omega/C}\n.param Lpet={VN/1.73205/IN/omega}\n.param XL={omega*Lpet}\n.param Ladd={LTrafo*7/9}\n.param Ipet={VN/1.73205/XL}\n.param ResFreq={1/2/pi*sqrt(1/(C*(Lpet+LLine+LTrafo+Ladd)))}
TEXT 40 224 Left 2 !Eres ResFreq 0 value={ResFreq}
