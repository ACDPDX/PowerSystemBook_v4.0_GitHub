TEXT -96 784 Left 5 !; Reactive powers\n.meas TRAN Qsr_1 PP 3*Ix(ShuntReactor1:L1)*v(Bus4)/sqrt(2)/sqrt(3)/2 FROM 3.9 TO 4\n.meas TRAN Qsr_2 PP 3*Ix(ShuntReactor2:L1)*v(Bus5)/sqrt(2)/sqrt(3)/2 FROM 3.9 TO 4\n.meas TRAN Qsr_3 PP 3*Ix(ShuntReactor3:L1)*v(Bus7)/sqrt(2)/sqrt(3)/2 FROM 3.9 TO 4\n; Voltages: \n.meas TRAN Vsr_1  MAX v(Bus4)\n.meas TRAN Vsr_2  MAX v(Bus5)\n.meas TRAN Vsr_3  MAX v(Bus7)\n; Currents\n.meas TRAN Isr_1 MAX  Ix(ShuntReactor1:L1)/sqrt(2)\n.meas TRAN Isr_2 MAX  Ix(ShuntReactor2:L1)/sqrt(2)\n.meas TRAN Isr_3 MAX  Ix(ShuntReactor3:L1)/sqrt(2)
