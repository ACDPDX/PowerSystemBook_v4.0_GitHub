* Current and powerlost and reactive power balance of all lines:

.func mag2(a,b) {sqrt(a*a+b*b)}

.meas TRAN Current_Line_1_3 FIND mag2(Ix(ln13:v1r),Ix(ln13:v1i)) AT 10us
.meas TRAN Current_Line_3_1 FIND mag2(Ix(ln13:v2r),Ix(ln13:v2i)) AT 10us

.meas TRAN Current_Line_2_4 FIND mag2(Ix(ln24:v1r),Ix(ln24:v1i)) AT 10us
.meas TRAN Current_Line_4_2 FIND mag2(Ix(ln24:v2r),Ix(ln24:v2i)) AT 10us

.meas TRAN Current_Transformer_1_2 FIND mag2(Ix(tr12:v1r),Ix(tr12:v1i)) AT 10us
.meas TRAN Current_Transformer_2_1 FIND mag2(Ix(tr12:v2r),Ix(tr12:v2i)) AT 10us

.meas TRAN Current_Transformer_3_4 FIND mag2(Ix(tr34:v1r),Ix(tr34:v1i)) AT 10us
.meas TRAN Current_Transformer_4_3 FIND mag2(Ix(tr34:v2r),Ix(tr34:v2i)) AT 10us

.meas TRAN Powerlost_Lines FIND V(p1)+v(p2)+V(p3)+v(p4) AT 10us
.meas TRAN Powerlost_Transformers FIND V(p5)+v(p6)+V(p7)+v(p8) AT 10us

.meas TRAN Reactive_power_balance_Lines FIND V(q1)+v(q2)+v(q3)+v(q4) AT 10us
.meas TRAN Reactive_power_balance_Tranformers FIND V(q5)+v(q6)+v(q7)+v(q8) AT 10us

* Current of loads, pv_element, slack

.meas TRAN Current_of_load3 FIND mag2(Ix(ld3:v1r),Ix(ld3:v1i)) AT 10us
.meas TRAN Current_of_load4 FIND mag2(Ix(ld4:v1r),Ix(ld4:v1i)) AT 10us
.meas TRAN Current_of_pv_element  FIND mag2(Ix(pvslack2:v1r),Ix(pvslack2:v1i)) AT 10us

.meas TRAN Current_of_slack FIND mag2(Ix(slack1:v1r),Ix(slack1:v1i)) AT 10us