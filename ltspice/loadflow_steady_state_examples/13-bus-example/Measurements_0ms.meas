* Current and powerlost and reactive power balance of all lines, transformers:
.func mag2(a,b) {sqrt(a*a+b*b)}
.meas TRAN Current_OverHeadLine_220kV_5_4 FIND mag2(Ix(U5:v1r),Ix(U5:v1i)) AT 10us
.meas TRAN Current_OverHeadLine_220kV_4_5 FIND mag2(Ix(U5:v2r),Ix(U5:v2i)) AT 10us

.meas TRAN Current_OverHeadLine_220kV_4_3 FIND mag2(Ix(U6:v1r),Ix(U6:v1i)) AT 10us
.meas TRAN Current_OverHeadLine_220kV_3_4 FIND mag2(Ix(U6:v2r),Ix(U6:v2i)) AT 10us

.meas TRAN Current_OverHeadLine_220kV_3_2 FIND mag2(Ix(U25:v1r),Ix(U25:v1i)) AT 10us
.meas TRAN Current_OverHeadLine_220kV_2_3 FIND mag2(Ix(U25:v2r),Ix(U25:v2i)) AT 10us

.meas TRAN Current_OverHeadLine_220kV_3_1 FIND mag2(Ix(U26:v1r),Ix(U26:v1i)) AT 10us
.meas TRAN Current_OverHeadLine_220kV_1_3 FIND mag2(Ix(U26:v2r),Ix(U26:v2i)) AT 10us

.meas TRAN Current_OverHeadLine_220kV_2_1 FIND mag2(Ix(U27:v1r),Ix(U27:v1i)) AT 10us
.meas TRAN Current_OverHeadLine_220kV_1_2 FIND mag2(Ix(U27:v2r),Ix(U27:v2i)) AT 10us

.meas TRAN Current_OverHeadLine_220kV_1_6 FIND mag2(Ix(U49:v1r),Ix(U49:v1i)) AT 10us
.meas TRAN Current_OverHeadLine_220kV_6_1 FIND mag2(Ix(U49:v2r),Ix(U49:v2i)) AT 10us

.meas TRAN Current_OverHeadLine_110kV_10_9 FIND mag2(Ix(U35:v1r),Ix(U35:v1i)) AT 10us
.meas TRAN Current_OverHeadLine_110kV_9_10 FIND mag2(Ix(U35:v2r),Ix(U35:v2i)) AT 10us

.meas TRAN Current_OverHeadLine_110kV_10_12 FIND mag2(Ix(U33:v1r),Ix(U33:v1i)) AT 10us
.meas TRAN Current_OverHeadLine_110kV_12_10 FIND mag2(Ix(U33:v2r),Ix(U33:v2i)) AT 10us

.meas TRAN Current_OverHeadLine_110kV_10_11 FIND mag2(Ix(U34:v1r),Ix(U34:v1i)) AT 10us
.meas TRAN Current_OverHeadLine_110kV_11_10 FIND mag2(Ix(U34:v2r),Ix(U34:v2i)) AT 10us

.meas TRAN Current_OverHeadLine_110kV_12_11 FIND mag2(Ix(U39:v1r),Ix(U39:v1i)) AT 10us
.meas TRAN Current_OverHeadLine_110kV_11_12 FIND mag2(Ix(U39:v2r),Ix(U39:v2i)) AT 10us

.meas TRAN Current_OverHeadLine_110kV_11_7 FIND mag2(Ix(U40:v1r),Ix(U40:v1i)) AT 10us
.meas TRAN Current_OverHeadLine_110kV_7_11 FIND mag2(Ix(U40:v2r),Ix(U40:v2i)) AT 10us

.meas TRAN Current_OverHeadLine_110kV_11_8 FIND mag2(Ix(U38:v1r),Ix(U38:v1i)) AT 10us
.meas TRAN Current_OverHeadLine_110kV_8_11 FIND mag2(Ix(U38:v2r),Ix(U38:v2i)) AT 10us

.meas TRAN Current_OverHeadLine_110kV_9_8 FIND mag2(Ix(U28:v1r),Ix(U28:v1i)) AT 10us
.meas TRAN Current_OverHeadLine_110kV_8_9 FIND mag2(Ix(U28:v2r),Ix(U28:v2i)) AT 10us

* Currents of transformers 

.meas TRAN Current_Transformer_5_10 FIND mag2(Ix(U41:v1r),Ix(U41:v1i)) AT 10us
.meas TRAN Current_Transformer_10_5 FIND mag2(Ix(U41:v2r),Ix(U41:v2i)) AT 10us

.meas TRAN Current_Transformer_12_13 FIND mag2(Ix(U45:v1r),Ix(U45:v1i)) AT 10us
.meas TRAN Current_Transformer_13_12 FIND mag2(Ix(U45:v2r),Ix(U45:v2i)) AT 10us

.meas TRAN Current_Transformer_6_7 FIND mag2(Ix(U46:v1r),Ix(U46:v1i)) AT 10us
.meas TRAN Current_Transformer_7_6 FIND mag2(Ix(U46:v2r),Ix(U46:v2i)) AT 10us

.meas TRAN Current_Transformer_2_8 FIND mag2(Ix(U11:v1r),Ix(U11:v1i)) AT 10us
.meas TRAN Current_Transformer_8_2 FIND mag2(Ix(U11:v2r),Ix(U11:v2i)) AT 10us

.meas TRAN Current_Transformer_3_9 FIND mag2(Ix(U10:v1r),Ix(U10:v1i)) AT 10us
.meas TRAN Current_Transformer_9_3 FIND mag2(Ix(U10:v2r),Ix(U10:v2i)) AT 10us

* Currents of loads 

.meas TRAN Current_Load7 FIND mag2(Ix(ld7:v1r),Ix(ld7:v1i)) AT 10us
.meas TRAN Current_Load8 FIND mag2(Ix(ld8:v1r),Ix(ld8:v1i)) AT 10us
.meas TRAN Current_Load9 FIND mag2(Ix(ld9:v1r),Ix(ld9:v1i)) AT 10us
.meas TRAN Current_Load10 FIND mag2(Ix(ld10:v1r),Ix(ld10:v1i)) AT 10us
.meas TRAN Current_Load11 FIND mag2(Ix(ld11:v1r),Ix(ld11:v1i)) AT 10us
.meas TRAN Current_Load12 FIND mag2(Ix(ld12:v1r),Ix(ld12:v1i)) AT 10us


* Active powerlost of lines, transformers 

.meas TRAN Powerlost_OverHeadLines_220kV FIND V(p1)+V(p2)+V(p3)+V(p4)+V(p5)+V(p6)+V(p7)+V(p8)+V(p9)+V(p10)+V(p11)+V(p12) AT 10us
.meas TRAN Powerlost_OverHeadLines_110kV FIND V(p20)+V(p21)+V(p22)+V(p23)+V(p24)+V(p25)+V(p26)+V(p27)+V(p28)+V(p29)+V(p30)+V(p31)+V(p32)+V(p33) AT 10us
.meas TRAN Powerlost_Transformers FIND V(p50)+V(p51)+V(p52)+V(p53)+V(p54)+V(p55)+V(p56)+V(p57)+V(p58)+V(p59) AT 10us

* Reactive power balance of lines, tranformers

.meas TRAN Reactive_power_balance_OverHeadLines_220kV FIND V(q1)+V(q2)+V(q3)+V(q4)+V(q5)+V(q6)+V(q7)+V(q8)+V(q9)+V(q10)+V(q11)+V(q12) AT 10us
.meas TRAN Reactive_power_balance_OverHeadLines_1100kV FIND V(q20)+V(q21)+V(q22)+V(q23)+V(q24)+V(q25)+V(q26)+V(q27)+V(q28)+V(q29)+V(q30)+V(q31)+V(q32)+V(q33) AT 10us
.meas TRAN Reactive_power_balance_Tranformers FIND V(q50)+V(q51)+V(q52)+V(q53)+V(q54)+V(q55)+V(q56)+V(q57)+V(q58)+V(q59) AT 10us

