* Current and powerlost and reactive power balance of all lines:
.func mag2(a,b) {sqrt(a*a+b*b)}

.meas TRAN Current_Line_1_2 FIND mag2(Ix(U60:v1r),Ix(U60:v1i)) AT 10us
.meas TRAN Current_Line_2_1 FIND mag2(Ix(U60:v2r),Ix(U60:v2i)) AT 10us

.meas TRAN Current_Line_1_3 FIND mag2(Ix(U61:v1r),Ix(U61:v1i)) AT 10us
.meas TRAN Current_Line_3_1 FIND mag2(Ix(U61:v2r),Ix(U61:v2i)) AT 10us

.meas TRAN Current_Line_3_2 FIND mag2(Ix(U62:v1r),Ix(U62:v1i)) AT 10us
.meas TRAN Current_Line_2_3 FIND mag2(Ix(U62:v2r),Ix(U62:v2i)) AT 10us


.meas TRAN Powerlost_Lines FIND V(p1)+v(p2)+V(p3)+v(p4)+V(p5)+v(p6) AT 10us

.meas TRAN Reactive_power_balance_Lines FIND V(q1)+v(q2)+v(q3)+v(q4)+V(q5)+v(q6) AT 10us


* Current of loads, pv_element, slack

.meas TRAN Current_of_load FIND mag2(Ix(U63:v1r),Ix(U63:v1i)) AT 10us

.meas TRAN Current_of_pv_element  FIND mag2(Ix(U65:v1r),Ix(U65:v1i)) AT 10us

.meas TRAN Current_of_slack FIND mag2(Ix(U64:v1r),Ix(U64:v1i)) AT 10us