* Current and powerlost and reactive power balance of all lines:
.func mag2(a,b) {sqrt(a*a+b*b)}
.meas TRAN Current_OverHeadLine_1_4 FIND mag2(Ix(U61:v1r),Ix(U61:v1i)) AT 10us
.meas TRAN Current_OverHeadLine_4_1 FIND mag2(Ix(U61:v2r),Ix(U61:v2i)) AT 10us

.meas TRAN Current_OverHeadLine_5_1 FIND mag2(Ix(U17:v1r),Ix(U17:v1i)) AT 10us
.meas TRAN Current_OverHeadLine_1_5 FIND mag2(Ix(U17:v2r),Ix(U17:v2i)) AT 10us

.meas TRAN Current_OverHeadLine_2_1 FIND mag2(Ix(U18:v1r),Ix(U18:v1i)) AT 10us
.meas TRAN Current_OverHeadLine_1_2 FIND mag2(Ix(U18:v2r),Ix(U18:v2i)) AT 10us

.meas TRAN Current_OverHeadLine_2_5 FIND mag2(Ix(U28:v1r),Ix(U28:v1i)) AT 10us
.meas TRAN Current_OverHeadLine_5_2 FIND mag2(Ix(U28:v2r),Ix(U28:v2i)) AT 10us

.meas TRAN Current_OverHeadLine_4_7 FIND mag2(Ix(U27:v1r),Ix(U27:v1i)) AT 10us
.meas TRAN Current_OverHeadLine_7_4 FIND mag2(Ix(U27:v2r),Ix(U27:v2i)) AT 10us

.meas TRAN Current_OverHeadLine_8_7 FIND mag2(Ix(U9:v1r),Ix(U9:v1i)) AT 10us
.meas TRAN Current_OverHeadLine_7_8 FIND mag2(Ix(U9:v2r),Ix(U9:v2i)) AT 10us

.meas TRAN Current_OverHeadLine_5_8 FIND mag2(Ix(U30:v1r),Ix(U30:v1i)) AT 10us
.meas TRAN Current_OverHeadLine_8_5 FIND mag2(Ix(U30:v2r),Ix(U30:v2i)) AT 10us


.meas TRAN Current_Cable_6_9 FIND mag2(Ix(U14:v1r),Ix(U14:v1i)) AT 10us
.meas TRAN Current_Cable_9_6 FIND mag2(Ix(U14:v2r),Ix(U14:v2i)) AT 10us

.meas TRAN Current_Cable_3_6 FIND mag2(Ix(U10:v1r),Ix(U10:v1i)) AT 10us
.meas TRAN Current_Cable_6_3 FIND mag2(Ix(U10:v2r),Ix(U10:v2i)) AT 10us

.meas TRAN Current_Transformer_2_3 FIND mag2(Ix(U13:v1r),Ix(U13:v1i)) AT 10us
.meas TRAN Current_Transformer_3_2 FIND mag2(Ix(U13:v2r),Ix(U13:v2i)) AT 10us

.meas TRAN Current_Transformer_8_9 FIND mag2(Ix(U7:v1r),Ix(U7:v1i)) AT 10us
.meas TRAN Current_Transformer_9_8 FIND mag2(Ix(U7:v2r),Ix(U7:v2i)) AT 10us

.meas TRAN Current_Transformer_5_3 FIND mag2(Ix(U19:v1r),Ix(U19:v1i)) AT 10us
.meas TRAN Current_Transformer_3_5 FIND mag2(Ix(U19:v2r),Ix(U19:v2i)) AT 10us

.meas TRAN Powerlost_OverHeadLines FIND V(p1)+v(p2)+V(p3)+v(p4)+v(p7)+v(p8)+v(p9)+v(p10)+V(p15)+v(p16)+V(p17)+v(p18)+v(p19)+v(p20) AT 10us
.meas TRAN Powerlost_Cables FIND V(p11)+v(p12)+V(p13)+v(p14) AT 10us
.meas TRAN Powerlost_Transformers FIND V(p5)+V(p6)+V(p21)+v(p22)+V(p23)+v(p24) AT 10us

.meas TRAN Reactive_power_balance_OverHeadLines FIND V(q1)+v(q2)+v(q3)+v(q4)+v(q9)+v(q10)+V(q15)+v(q16)+V(q17)+v(q18)+v(q19)+v(q20) AT 10us
.meas TRAN Reactive_power_balance_Cables FIND V(q11)+v(q12)+v(q13)+v(q14) AT 10us
.meas TRAN Reactive_power_balance_Tranformers FIND V(q5)+V(q6)+V(q21)+v(q22)+V(q23)+v(q24) AT 10us

