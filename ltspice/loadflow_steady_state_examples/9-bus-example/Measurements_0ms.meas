* Current and powerlost and reactive power balance of all lines:
.func mag2(a,b) {sqrt(a*a+b*b)}
.meas TRAN Current_OverHeadLine_1_4 FIND mag2(Ix(ln14:v1r),Ix(ln14:v1i)) AT 10us
.meas TRAN Current_OverHeadLine_4_1 FIND mag2(Ix(ln14:v2r),Ix(ln14:v2i)) AT 10us

.meas TRAN Current_OverHeadLine_5_1 FIND mag2(Ix(ln15:v1r),Ix(ln15:v1i)) AT 10us
.meas TRAN Current_OverHeadLine_1_5 FIND mag2(Ix(ln15:v2r),Ix(ln15:v2i)) AT 10us

.meas TRAN Current_OverHeadLine_2_1 FIND mag2(Ix(ln12:v1r),Ix(ln12:v1i)) AT 10us
.meas TRAN Current_OverHeadLine_1_2 FIND mag2(Ix(ln12:v2r),Ix(ln12:v2i)) AT 10us

.meas TRAN Current_OverHeadLine_2_5 FIND mag2(Ix(ln25:v1r),Ix(ln25:v1i)) AT 10us
.meas TRAN Current_OverHeadLine_5_2 FIND mag2(Ix(ln25:v2r),Ix(ln25:v2i)) AT 10us

.meas TRAN Current_OverHeadLine_4_7 FIND mag2(Ix(ln47:v1r),Ix(ln47:v1i)) AT 10us
.meas TRAN Current_OverHeadLine_7_4 FIND mag2(Ix(ln47:v2r),Ix(ln47:v2i)) AT 10us

.meas TRAN Current_OverHeadLine_8_7 FIND mag2(Ix(ln78:v1r),Ix(ln78:v1i)) AT 10us
.meas TRAN Current_OverHeadLine_7_8 FIND mag2(Ix(ln78:v2r),Ix(ln78:v2i)) AT 10us

.meas TRAN Current_OverHeadLine_5_8 FIND mag2(Ix(ln58:v1r),Ix(ln58:v1i)) AT 10us
.meas TRAN Current_OverHeadLine_8_5 FIND mag2(Ix(ln58:v2r),Ix(ln58:v2i)) AT 10us


.meas TRAN Current_Cable_6_9 FIND mag2(Ix(ln69:v1r),Ix(ln69:v1i)) AT 10us
.meas TRAN Current_Cable_9_6 FIND mag2(Ix(ln69:v2r),Ix(ln69:v2i)) AT 10us

.meas TRAN Current_Cable_3_6 FIND mag2(Ix(ln36:v1r),Ix(ln36:v1i)) AT 10us
.meas TRAN Current_Cable_6_3 FIND mag2(Ix(ln36:v2r),Ix(ln36:v2i)) AT 10us

.meas TRAN Current_Transformer_2_3 FIND mag2(Ix(tr23:v1r),Ix(tr23:v1i)) AT 10us
.meas TRAN Current_Transformer_3_2 FIND mag2(Ix(tr23:v2r),Ix(tr23:v2i)) AT 10us

.meas TRAN Current_Transformer_8_9 FIND mag2(Ix(tr89:v1r),Ix(tr89:v1i)) AT 10us
.meas TRAN Current_Transformer_9_8 FIND mag2(Ix(tr89:v2r),Ix(tr89:v2i)) AT 10us

.meas TRAN Current_Transformer_5_3 FIND mag2(Ix(tr35:v1r),Ix(tr35:v1i)) AT 10us
.meas TRAN Current_Transformer_3_5 FIND mag2(Ix(tr35:v2r),Ix(tr35:v2i)) AT 10us

.meas TRAN Powerlost_OverHeadLines FIND V(p1)+v(p2)+V(p3)+v(p4)+v(p7)+v(p8)+v(p9)+v(p10)+V(p15)+v(p16)+V(p17)+v(p18)+v(p19)+v(p20) AT 10us
.meas TRAN Powerlost_Cables FIND V(p11)+v(p12)+V(p13)+v(p14) AT 10us
.meas TRAN Powerlost_Transformers FIND V(p5)+V(p6)+V(p21)+v(p22)+V(p23)+v(p24) AT 10us

.meas TRAN Reactive_power_balance_OverHeadLines FIND V(q1)+v(q2)+v(q3)+v(q4)+v(q9)+v(q10)+V(q15)+v(q16)+V(q17)+v(q18)+v(q19)+v(q20) AT 10us
.meas TRAN Reactive_power_balance_Cables FIND V(q11)+v(q12)+v(q13)+v(q14) AT 10us
.meas TRAN Reactive_power_balance_Tranformers FIND V(q5)+V(q6)+V(q21)+v(q22)+V(q23)+v(q24) AT 10us

