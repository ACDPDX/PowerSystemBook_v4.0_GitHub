TEXT 64 32 Left 2 !* ============================================================\n* 3PH + EARTH WIRE - FULL MODAL LTspice MODEL (CONSISTENT)\n* Includes bidirectional E + G transformation at BOTH ends\n* ============================================================\n \n.param l=1\n \n* ------------------------------------------------------------\n* MODES (from eigenanalysis)\n* ------------------------------------------------------------\n \n.param Z1=1090  TD1=5.00u\n.param Z2=400   TD2=3.40u\n.param Z3=387   TD3=3.41u\n.param Z4=421   TD4=3.43u\n \n* ============================================================\n* MODE TRANSMISSION LINES\n* ============================================================ \nT1 m1in 0 m1out1 0 Z0=1090 TD=5u\nT2 m2in 0 m2out1 0 Z0=400 TD=3.4u\nT3 m3in 0 m3out1 0 Z0=397 TD=3.4u\nT4 m4in 0 m4out1 0 Z0=421 TD=3.4u\n \nR1 m1in 0 1e6\nR2 m2in 0 1e6\nR3 m3in 0 1e6\nR4 m4in 0 1e6\n \nR5 m1out1 0 1e6\nR6 m2out1 0 1e6\nR7 m3out1 0 1e6\nR8 m4out1 0 1e6\n \n \nV1 m1in1 m1in 0\nV2 m2in1 m2in 0\nV3 m3in1 m3in 0\nV4 m4in1 m4in 0\n \nV5 m1out1 m1out 0\nV6 m2out1 m2out 0\nV7 m3out1 m3out 0\nV8 m4out1 m4out 0\n \n \n* ============================================================\n* INPUT SIDE\n* PHASE -> MODE\n* V_m = T^-1 * V_p\n* ============================================================\n \n \nE1 m1in1 0 VALUE={0.495*V(Ain)+0.518*V(Bin)+0.518*V(Cin)+0.467*V(Ein)} tripdv=1 tripdt=1\nE2 m2in1 0 VALUE={0.183*V(Ain)-0.751*V(Bin)+0.080*V(Cin)+0.629*V(Ein)} tripdv=1 tripdt=1\nE3 m3in1 0 VALUE={-0.373*V(Ain)-0.192*V(Bin)+0.823*V(Cin)-0.382*V(Ein)} tripdv=1 tripdt=1\nE4 m4in1 0 VALUE={0.771*V(Ain)-0.192*V(Bin)+0.073*V(Cin)-0.602*V(Ein)} tripdv=1 tripdt=1\n \n \n* ============================================================\n* INPUT SIDE CURRENT FEEDBACK\n* I_p = S * I_m\n* ============================================================\n \nG_Ain 0 Ain  VALUE={0.444*I(V1)+0.199*I(V2)-0.369*I(V3)+0.786*I(V4)} tripdv=1 tripdt=1\nG_Bin 0 Bin  VALUE={0.550*I(V1)-0.819*I(V2)-0.242*I(V3)-0.275*I(V4)} tripdv=1 tripdt=1\nG_Cin 0 Cin  VALUE={0.542*I(V1)+0.147*I(V2)+0.856*I(V3)+0.031*I(V4)} tripdv=1 tripdt=1\nG_Ein 0 Ein  VALUE={0.459*I(V1)+0.534*I(V2)-0.291*I(V3)-0.562*I(V4)} tripdv=1 tripdt=1\n \n \n* ============================================================\n* OUTPUT SIDE\n* MODE -> PHASE\n* V_p = T * V_m\n* ============================================================\n \nE_Aout Aout 0 VALUE={+0.495*V(m1out)+0.183*V(m2out)-0.373*V(m3out)+0.771*V(m4out)} tripdv=1 tripdt=1\nE_Bout Bout 0 VALUE={+0.518*V(m1out)-0.751*V(m2out)-0.192*V(m3out)-0.192*V(m4out)} tripdv=1 tripdt=1\nE_Cout Cout 0 VALUE={+0.518*V(m1out)+0.080*V(m2out)+0.823*V(m3out)+0.073*V(m4out)} tripdv=1 tripdt=1\nE_Eout Eout 0 VALUE={+0.467*V(m1out)+0.629*V(m2out)-0.382*V(m3out)-0.602*V(m4out)} tripdv=1 tripdt=1\n \n \n* ============================================================\n* OUTPUT SIDE CURRENT FEEDBACK (IMPORTANT!)\n* I_m = T^-1 * I_p\n* ============================================================\n \nG_m1out 0 m1out  VALUE={+0.495*I(RloadA)+0.518*I(RloadB)+0.518*I(RloadC)+0.467*I(RloadE)} tripdv=1 tripdt=1\nG_m2out 0 m2out  VALUE={+0.183*I(RloadA)-0.751*I(RloadB)+0.080*I(RloadC)+0.629*I(RloadE)} tripdv=1 tripdt=1\nG_m3out 0 m3out  VALUE={-0.373*I(RloadA)-0.192*I(RloadB)+0.823*I(RloadC)-0.382*I(RloadE)} tripdv=1 tripdt=1\nG_m4out 0 m4out  VALUE={+0.771*I(RloadA)-0.192*I(RloadB)+0.073*I(RloadC)-0.602*I(RloadE)} tripdv=1 tripdt=1\n \n \n* ============================================================\n* EXAMPLE SOURCE + LOAD\n* ============================================================\n \nVsrc Ain 0 PULSE(0 1 0 1n 1n 1u 10u)\n \n \n \n*Vsrc1 Ain 0 SINE(0 10k 50000 0 0 0)\n*Vsrc2 Bin 0 SINE(0 10k 50000 0 0 -120)\n*Vsrc3 Cin 0 SINE(0 10k 50000 0 0 120)\n \nRloadA Aout 0 500\nRloadB Bout 0 500\nRloadC Cout 0 500\nRloadE Eout 0 20\nRin1   Ein  0 20\n \n.tran 0 100u 0 10n
