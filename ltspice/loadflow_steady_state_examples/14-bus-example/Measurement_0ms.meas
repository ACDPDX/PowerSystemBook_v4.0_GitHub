* Current of overhead lines
.func mag2(a,b) {sqrt(a*a+b*b)}
.meas TRAN OverheadLine_1_2 FIND mag2(Ix(U34:v1r),Ix(U34:v1i)) AT 10us
.meas TRAN OverheadLine_2_1 FIND mag2(Ix(U34:v2r),Ix(U34:v2i)) AT 10us

.meas TRAN OverheadLine_1_5 FIND mag2(Ix(U31:v1r),Ix(U31:v1i)) AT 10us
.meas TRAN OverheadLine_5_1 FIND mag2(Ix(U31:v2r),Ix(U31:v2i)) AT 10us

.meas TRAN OverheadLine_2_5 FIND mag2(Ix(U24:v1r),Ix(U24:v1i)) AT 10us
.meas TRAN OverheadLine_5_2 FIND mag2(Ix(U24:v2r),Ix(U24:v2i)) AT 10us

.meas TRAN OverheadLine_2_4 FIND mag2(Ix(U38:v1r),Ix(U38:v1i)) AT 10us
.meas TRAN OverheadLine_4_2 FIND mag2(Ix(U38:v2r),Ix(U38:v2i)) AT 10us

.meas TRAN OverheadLine_2_3 FIND mag2(Ix(U36:v1r),Ix(U36:v1i)) AT 10us
.meas TRAN OverheadLine_3_2 FIND mag2(Ix(U36:v2r),Ix(U36:v2i)) AT 10us

.meas TRAN OverheadLine_4_3 FIND mag2(Ix(U37:v1r),Ix(U37:v1i)) AT 10us
.meas TRAN OverheadLine_3_4 FIND mag2(Ix(U37:v2r),Ix(U37:v2i)) AT 10us

.meas TRAN OverheadLine_5_4 FIND mag2(Ix(U35:v1r),Ix(U35:v1i)) AT 10us
.meas TRAN OverheadLine_4_5 FIND mag2(Ix(U35:v2r),Ix(U35:v2i)) AT 10us

* Current at Cables

.meas TRAN Cable_12_6 FIND mag2(Ix(U5:v1r),Ix(U5:v1i)) AT 10us
.meas TRAN Cable_6_12 FIND mag2(Ix(U5:v2r),Ix(U5:v2i)) AT 10us

.meas TRAN Cable_13_12 FIND mag2(Ix(U6:v1r),Ix(U6:v1i)) AT 10us
.meas TRAN Cable_12_13 FIND mag2(Ix(U6:v2r),Ix(U6:v2i)) AT 10us

.meas TRAN Cable_13_6 FIND mag2(Ix(U7:v1r),Ix(U7:v1i)) AT 10us
.meas TRAN Cable_6_13 FIND mag2(Ix(U7:v2r),Ix(U7:v2i)) AT 10us

.meas TRAN Cable_6_11 FIND mag2(Ix(U14:v1r),Ix(U14:v1i)) AT 10us
.meas TRAN Cable_11_6 FIND mag2(Ix(U14:v2r),Ix(U14:v2i)) AT 10us

.meas TRAN Cable_11_10 FIND mag2(Ix(U62:v1r),Ix(U62:v1i)) AT 10us
.meas TRAN Cable_10_11 FIND mag2(Ix(U62:v2r),Ix(U62:v2i)) AT 10us

.meas TRAN Cable_10_9 FIND mag2(Ix(U63:v1r),Ix(U63:v1i)) AT 10us
.meas TRAN Cable_9_10 FIND mag2(Ix(U63:v2r),Ix(U63:v2i)) AT 10us

.meas TRAN Cable_14_13 FIND mag2(Ix(U1:v1r),Ix(U1:v1i)) AT 10us
.meas TRAN Cable_13_14 FIND mag2(Ix(U1:v2r),Ix(U1:v2i)) AT 10us

.meas TRAN Cable_14_9 FIND mag2(Ix(U10:v1r),Ix(U10:v1i)) AT 10us
.meas TRAN Cable_9_14 FIND mag2(Ix(U10:v2r),Ix(U10:v2i)) AT 10us

.meas TRAN Cable_9_7 FIND mag2(Ix(U51:v1r),Ix(U51:v1i)) AT 10us
.meas TRAN Cable_7_9 FIND mag2(Ix(U51:v2r),Ix(U51:v2i)) AT 10us

.meas TRAN Cable_8_7 FIND mag2(Ix(U48:v1r),Ix(U48:v1i)) AT 10us
.meas TRAN Cable_7_8 FIND mag2(Ix(U48:v2r),Ix(U48:v2i)) AT 10us



* Power dissipation of overhead lines:

.meas TRAN Powerlost_overheadlines FIND V(p1)+V(p2)+V(p3)+V(p4)+V(p5)+V(p6)+V(p7)+V(p8)+V(p9)+V(p10)+V(p11)+V(p12)+V(p13)+V(p14) AT 10us

* Power dissipation of cables:

.meas TRAN Powerlost_cables FIND V(p21)+V(p22)+V(p23)+V(p24)+V(p25)+V(p26)+V(p27)+V(p28)+V(p29)+V(p30)+V(p31)+V(p32)+V(p33)+V(p34)+V(p35)+V(p36)+V(p37)+V(p38)+V(p39)+V(p40) AT 10us

* Power dissipation of transformers:

.meas TRAN Powerlost_transformers FIND V(p50)+V(p51)+V(p52)+V(p53)+V(p54)+V(p55) AT 10us



* Reactive power balance of overhead lines:

.meas TRAN Reactive_power_balance_overheadlines FIND V(q1)+V(q2)+V(q3)+V(q4)+V(q5)+V(q6)+V(q7)+V(q8)+V(q9)+V(q10)+V(q11)+V(q12)+V(q13)+V(q14) AT 10us

* Reactive balance of cables:

.meas TRAN Reactive_power_balance_cables FIND V(q21)+V(q22)+V(q23)+V(q24)+V(q25)+V(q26)+V(q27)+V(q28)+V(q29)+V(q30)+V(q31)+V(q32)+V(q33)+V(q34)+V(q35)+V(q36)+V(q37)+V(q38)+V(q39)+V(q40) AT 10us

* Reactive balance of tranformers:

.meas TRAN Reactive_power_balance_tranformers FIND V(q50)+V(q51)+V(q52)+V(q53)+V(q54)+V(q55) AT 10us
