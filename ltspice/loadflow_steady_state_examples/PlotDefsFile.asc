TEXT -96 16 Left 2 ;* File: C:\\Users\\fried\\Documents\\LTspiceXVII\\plot.defs\n*\n* Define parameters and functions that you which to be able to use in\n* data plots in this file with .param and .func statements.\n* File: D:\\Program Files\\LTspice\\plot.defs\n*\n* Define parameters and functions that you be able to use in\n* data plots in this file with .param and .func statements.\n* Copy the content of this file:\n* Open a simulation file and run it\n* Activate (click on) the waveform viewer window\n* Choose Plot Settings / Edit Plot Defs file\n* Copy the content below to this file\n* Restart Ltspice to enable this\n*****************************************************\n* general stuff\n*****************************************************\n* neg(-1,-2,-3 ... ) = 1   neg(0,1,2,3 ...)=0\n.func neg(a) {(sgn(a)*(sgn(a)-1))/2}\n* pos(-1,-2,-3 ... ) = 0   pos(0,1,2,3 ...)=1\n.func pos(a) {abs(neg(a)-1)}\n* invsgn(-1,-2,-3 ... ) = 1  invsgn(0,1,2,3)= -1\n.func invsgn(a) -{sgn(a)}\n* greater or equal (0 or 1)\n.func ge(a,b) {pos(a-b)}\n* lower or equal (0 or 1)\n.func le(a,b) {pos(b-a)}\n* lower than (0 or 1)\n.func lt(a,b) {neg(a-b)}\n* greater than (0 or 1)\n.func gt(a,b) {neg(b-a)}\n* equal (0 or 1)\n.func eq(a,b) {ge(a,b)*le(a,b)}\n* not equal (0 or 1)\n.func neq(a,b) {gt(a,b)+lt(a,b)}\n* if(1,a,b)  true=1 false=not 1   if true  a sonst b\n* e.g. if(gt(a,0),a*a,-(abs(a*a)))\n.func _if(a,b,c) {(eq(a,1)*b)+(neq(a,1)*c)}\n* limit b=lower c=upper a=variable to limit\n.func limit(a,b,c) {_if(lt(a,b),b,_if(gt(a,c),c,a))}\n*****************************************************\n* special loadflow toolbox stuff\n******************************************************\n.param vfactor=sqrt(3)\n.param sfactor=3.0\n* magnitude of real , imag\n.func mag2(a,b) {sqrt(a*a+b*b)}\n* phase of real, imag with atanfunc ( -120..120 deg )\n.func ph2(a,b) {if(eq(mag2((a),(b)),0),0,(180*neg(a)*pos(b)-180*neg(b)*neg(a)+atan((b)/(a))))}\n* or with asinfunc .func ph2(a,b) (if(eq(mag2((a),(b)),0),0,(180*neg(a)*pos(b)-180*neg(b)*neg(a)+asin(b/mag2(a,b)))))\n* -180...180 > 0..360 conversion if(a<0,360-a,a)\n.func to360(a) {if(neg(a),360+(a),(a))}\n* phase difference clockwise - arguments are assumed to be always 0..360\n* be sure to convert -180..180 arguments with function to360(a) before !!!!!\n.func phdiffcw(a,b) {if(((a)-(b)+0.5),(b)-(a),(b)-(a)-360)}\n* phase difference conterclockwise\n.func phdiffcc(a,b) {-phdiffcw(b,a)}\n* p1 ( one phase real power ) a=v1r b=v1i c=i1r d=i1i\n.func p1(a,b,c,d) {(a)*(c)+(b)*(d)}\n* p3 ( three phase real power )\n.func p3(a,b,c,d) {((a)*(c)+(b)*(d))*(sfactor)}\n* q1 ( one phase imag power )\n.func q1(a,b,c,d) {(b)*(c)-(a)*(d)}\n* q3 ( three phase imag power )\n.func q3(a,b,c,d) {((b)*(c)-(a)*(d))*(sfactor)}\n* s1 ( one phase complex power )\n.func s1(a,b,c,d) {mag2(p1(a,b,c,d),q1(a,b,c,d))}\n* s3 ( three phase complex power )\n.func s3(a,b,c,d) {mag2(p3(a,b,c,d),q3(a,b,c,d))}\n* dp3 ( three phase power lost ) e=v2r f=v2i g=i2r h=i2i\n.func dp3(a,b,c,d,e,f,g,h) {p3(a,b,c,d)+p3(e,f,g,h)}\n**********************************************************\n* special transient toolbox stuff:\n**********************************************************\n* dt=Measure of time in ms measured from current zero to voltage zero (for value see left statusline)\n.func dt1(dt) {IF(dt>5m,dt-10m,IF(dt<-5m,dt+10m,dt))}\n.func dt1_60(dt) {IF(dt>4.1667m,dt-8.3333m,IF(dt<-4.1667m,dt+8.3333m,dt))}\n.func t2phi(dt) {dt1(dt)*90/5m}\n.func t2phi60(dt) {dt1_60(dt)*90/4.1667m}\n* apparent power measurement per phase (sfactor=1)\n.func S(ipeak,vpeak) {1.5*ipeak*vpeak/3}\n* active power measurement 50Hz\n.func P50Hz(ipeak,vpeak,ti,tv) {IF((ti-tv)<5m & (ti-tv)>=-5ms,S(ipeak,vpeak)*cos(t2phi(ti-tv)),-S(ipeak,vpeak)*cos(t2phi(ti-tv)))}\n* reactive power measurement ti>tv Qpos ti<tv Qneg\n.func Q50Hz(ipeak,vpeak,ti,tv) {IF((ti-tv)<5m & (ti-tv)>=-5ms,S(ipeak,vpeak)*sin(t2phi((ti-tv))),-S(ipeak,vpeak)*sin(t2phi((ti-tv))))}\n* active power measurement 60Hz\n.func P60Hz(ipeak,vpeak,ti,tv) {IF((ti-tv)<4.1667m & (ti-tv)>=-4.1667m,S(ipeak,vpeak)*cos(t2phi60((ti-tv))),-S(ipeak,vpeak)*cos(t2phi60((ti-tv))))}\n* reactive power measurement ti>tv Qpos ti<tv Qneg\n.func Q60Hz(ipeak,vpeak,ti,tv) {IF((ti-tv)<4.1667m & (ti-tv)>=-4.1667m,S(ipeak,vpeak)*sin(t2phi60((ti-tv))),-S(ipeak,vpeak)*sin(t2phi60((ti-tv))))}\n* IF phii and phiv is measured by phasemeters\n.func dphi(phii,phiv) {phii-phiv}\n.func phy(phii,phiv) {IF(dphi(phii,phiv)<-90,dphi(phii,phiv)+180,dphi(phii,phiv))}\n.func phi(phii,phiv){IF(dphi(phii,phiv)>90,dphi(phii,phiv)-180,phy(phii,phiv))}\n.func P1(phii,phiv,ipeak,vpeak) {IF(dphi(phii,phiv)<90 & dphi(phii,phiv)>-90,S(ipeak,vpeak)*cos(V(phi)*pi/180),-S(ipeak,vpeak)*cos(V(phi)*pi/180))}\n.func Q1(phii,phiv,ipeak,vpeak) {IF(dphi(phii,phiv)<90 & dphi(phii,phiv)>-90,-S(ipeak,vpeak)*sin(V(phi)*pi/180),S(ipeak,vpeak)*sin(V(phi)*pi/180))}
