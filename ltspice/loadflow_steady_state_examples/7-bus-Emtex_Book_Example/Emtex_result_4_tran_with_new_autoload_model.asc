TEXT -248 232 Left 2 ;QLimit = 1 till -1.4
TEXT 776 480 Left 2 !von on 0 1\nvp p 0 4\nvq q 0 pwl 0s -0.3 10u 2
TEXT -8 -552 Left 5 ;( Compairison of constant load and auto_load model \nwith voltage regulating transformer inside )
TEXT 808 536 Left 2 ;q-Level is too high for constpower model (nonconvergence)\nq-Level is ok for auto load model who switch to constimpedance\nif transformer tap limit is reached
TEXT 800 568 Left 4 ;NOTE: With the autotransformer load model \nno voltage breackdown occur at high q-load
TEXT -304 -216 Left 2 !.options gminsteps=0 srcsteps=2
TEXT -304 -200 Left 2 !.param  kp=1e-7 tn=1e-17
