TEXT -1880 -1744 Left 6 !.param t0=0          ;0=switching phase1 at voltage zero, 1=switching phase1 at voltagemax\n.param psi_0=0 ;    0=without residual flux 1=with maximum residual flux\n.param lf=0      ;0=without load 1=with load ( 2=double load  0.5=halve load )\n.param skin=0       ;0=without skin effect, 1=with skin effect of networkimpedance \n.param kd=1         ;0=without kd, 1=with kd\n.param weak=1    ;1=strong net, 40=weak net (1GVA=second serial transformer)\n*------------------------------------------------------------------------------------------------------------------------\n.param cf=1           ;Multiplier of the capacitance of the network (whole network= 15 MVar)\n.param uf=1           ;voltage factor of the source 1=230kV 1.01=232kV\n.param L=0        ;L=Voltage regulation of main transformer (1.2% per tap)\n.param ue={(220e3+L*220e3*(1.2/100))/110e3}\n*-------------------------------------------------------------------------------------------------------------------------\n.param cuf=1.002   ; unsymmetric capacitance at line2 phase 1\n.param ST={40ms*(1-t0)+45ms*(t0)} ; 40ms=voltage zero rising 45ms=voltage maximum\n.param pq={1/5}   ; q ist 1/5 von p\n.param p_last1=10e6 q_last1={p_last1*pq} \n.param p_last2=10e6 q_last2={p_last2*pq}\n.param p_last3=10e6 q_last3={p_last3*pq} \n.param a=0.75 m=9 ; \n.param tsw=100us    ; switching time\n.param dt=0ms tpsid=0.1ms ron=1e-5\n.param psir=1 psis=-0.5 psit=-0.5 ; Don't forget to change if t0=1 and psi_0=1\n*.param psir=0 psis=0.866 psit=-0.866\n.param freqskin=400\n.param QKd=40e6 INPet={250*cf}
TEXT -3552 -1144 Left 6 ;For measuring differential voltages\nClick on a line than hold left mouse \nbotton and drag to other line
