TEXT 48 104 Left 2 !.param fN=50 ; frequency\n.param omega={2*pi*fN} ; angle speed\n.param SN=200e6 ; apparent nominal power\n.param U1Nenn=220e3 ; nominal high voltage \n.param U20=110e3 ; nominal low voltage\n.param ur=0.002 ; relative copper impedance  \n.param ux=0.2 ; relative leakage impedance \n.param p0=0.0004 ; relative iron lost power\n.param i0=0.0006 ; relative no load current\n.param N=1000 ; windings\n.param U1N=U1Nenn/1.73205 ; nominal phase voltage\n.param uk=sqrt(ur*ur+ux*ux) ; nominal short circuit voltage \n.param psi={U1N/omega} ; sum of flux RMS value \n.param psiN={U1N/omega*sqrt(2)} ; sum of flux peak value\n.param phi={psi/N} ; flux per winding RMS value\n.param phiN={phi*sqrt(2)} ; flux per winding peak value\n \n* for often faster simulation ad tripdv=1 tripdt=1 for G,E behavioural sources\n \nEinos  inos   0 value={SN/3/U1N} tripdv=1 tripdt=1 ; nominal high voltage current\nEinus  inus   0 value={v(inos)*U1Nenn/U20} tripdv=1 tripdt=1 ; nominal low voltage current\nEikos  ikos   0 value={v(inos)/uk}  tripdv=1 tripdt=1 ; max. short circuit current\nEz1n   z1n    0 value={U1N/v(inos)} tripdv=1 tripdt=1; nominal impedance\nErkos  rkos   0 value={v(z1n)*ur}   tripdv=1 tripdt=1; copper resistance\nExkos  xkos   0 value={v(z1n)*ux}   tripdv=1 tripdt=1; leakage impedance \nExhos  xhos   0 value={U1Nenn**2/(SN*sqrt(i0*i0-p0*p0))} tripdv=1 tripdt=1; main inductance\nErfeos rfeos  0 value={U1Nenn**2/(p0*SN)} tripdv=1 tripdt=1; iron lost resistance equivalent\nEvfe   vfe    0 value={p0*SN} tripdv=1 tripdt=1 ; iron lost power\nEcu    vcu    0 value={ur*SN} tripdv=1 tripdt=1 ; copper lost power\nEimue  imue   0 value={U1N/v(xhos)} tripdv=1 tripdt=1 ; magnetizing RMS current\nEimueN imueN  0 value={U1N/v(xhos)*sqrt(2)} tripdv=1 tripdt=1 ; magnetizing peak current\nEpsi   psi    0 value={psi} tripdv=1 tripdt=1 ; sum of flux RMS value\nEpsiN  psiN   0 value={psiN} tripdv=1 tripdt=1 ; sum of nominal flux peak value\nEphi   phi    0 value={phi} tripdv=1 tripdt=1 ; nominal flux per winding RMS value\nEphiN  phiN   0 value={phiN} tripdv=1 tripdt=1 ; nominal flux per winding peak value\nEife   ife    0 value={U1N/v(rfeos)} tripdv=1 tripdt=1 ; iron lost equivalent current\nEi0    i0abs  0 value={sqrt(v(imue)*v(imue)+v(ife)*v(ife))} tripdv=1 tripdt=1 ; noload current\n \n* parameter for nonlinear core imue vs Phi \n \n.param a=0.75\n.param b={1-a}\n.param m=9\n \n.param psi1={psiN}\n.param psi2={2*psiN}\n.param psi3={3*psiN}\n \nEimueNx1 imueNx1 0 value={v(imueN)*(a*Psi1/PsiN+b*(Psi1/PsiN)**m)} tripdv=1 tripdt=1 ; nominal flux\nEimueNx2 imueNx2 0 value={v(imueN)*(a*Psi2/PsiN+b*(Psi2/PsiN)**m)} tripdv=1 tripdt=1 ; double nominal flux\nEimueNx3 imueNx3 0 value={v(imueN)*(a*Psi3/PsiN+b*(Psi3/PsiN)**m)} tripdv=1 tripdt=1 ; triple nominal flux
