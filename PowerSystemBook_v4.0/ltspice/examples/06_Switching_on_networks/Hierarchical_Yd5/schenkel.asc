TEXT 240 80 Left 2 ;.param N={N} Rfe={Rfe} imyN={imyN}  phiN={phiN} a={a} m={m}
TEXT 280 168 Left 2 !EphiN phiN 0 value={phiN} tripdv=1 tripdt=1\nEthetaN thetan 0 VALUE={N*imyN} tripdv=1 tripdt=1\nEimyN imyN 0 VALUE={imyN} tripdv=1 tripdt=1
TEXT 280 208 Left 2 !EPhi phi 0 value={i(vphi)} tripdv=1 tripdt=1
TEXT 280 232 Left 2 !ELx Lx 0 VALUE={N*phiN/imyN*1/(a+(1-a)*PWRS(v(phi123x)/phiN,m-1))} tripdv=1 tripdt=1
TEXT 280 248 Left 2 !ERmx RMx 0 VALUE={N*N/v(Lx)} tripdv=1 tripdt=1\nEXlx  XLx  0 VALUE={v(Lx)*314.159} tripdv=1 tripdt=1\n \nEthetaX thetaX 0 VALUE={v(phi123X)*N*N/v(Lx)} tripdv=1 tripdt=1\nEtheta theta 0 VALUE={v(m1h,m2)} tripdv=1 tripdt=1\nEUN UN 0 VALUE={phiN*N*314.159} tripdv=1 tripdt=1\nEUL ULN 0 VALUE={v(UN)*sqrt(3)/1.414}\nEBn Bn 0 VALUE={Phin/Area/1.414} tripdv=1 tripdt=1\nEHn Hn 0 VALUE={N*imyN/length/1.414} tripdv=1 tripdt=1\nEBx Bx 0 VALUE={v(phi123X)/area} tripdv=1 tripdt=1\nEHx Hx 0 VALUE={v(thetaX)/length} tripdv=1 tripdt=1\nEmurX MuerX 0 VALUE={v(BX)/v(HX)/4/pi*1e7} tripdv=1 tripdt=1\nEB B 0 VALUE={I(Vphi)/area} tripdv=1 tripdt=1\nEH H 0 VALUE={v(theta)/length} tripdv=1 tripdt=1
