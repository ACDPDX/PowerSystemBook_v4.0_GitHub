* Compute 
* self inductance by wxmaxima file:
* coupled impedances.wxmx in the example folder
* input: k's and symmetric inductances
* output: self inductances and mutual inductances
 
.subckt impedance_coupled L1_1 L2_1 L3_1 L1_2 L2_2 L3_2
+	PARAMS:
+	R1=0.5	;
+	R2=0.5	;
+	R3=0.5	;
+	L1=0.001 L2=0.001 L3=0.001	; self inductances
+   k12=0.5 k13=0.4 k23=0.5 ; coupling 
+   fn={fn1}
+   XL1=0 ;if present L1 is ignored
+   XL2=0
+   XL3=0
+   length=1
+   g=1e12
.PARAM
+   L11=length*IF(xl1>0,xl1/fn/2/pi,L1)
+   L22=length*IF(xl2>0,xl2/fn/2/pi,L2)
+   L33=length*IF(xl3>0,xl3/fn/2/pi,L3)
+   R11=length*R1
+   R22=length*R2
+   R33=length*R3
L1 L1_1 L1_1x {L11}
R1 L1_1x L1_2 {R11}
L2 L2_1 L2_1x {L22}
R2 L2_1x L2_2 {R22}
L3 L3_1 L3_1x {L33}
R3 L3_1x L3_2 {R33}
K12 L1 L2 {k12}
K13 L1 L3 {k13}
K23 L2 L3 {k23}
Rgnd1 L1_1 0 {g}
Rgnd2 L2_1 0 {g}
Rgnd3 L3_1 0 {g}
Rgnd4 L1_2 0 {g}
Rgnd5 L2_2 0 {g}
Rgnd6 L3_2 0 {g}
.ends









