***********************************************************
****	Library for DSG(Drehstromsynchrongenerator)    ****
****	Synchronous generator librairy                 ****
***********************************************************

* Special thanks to Otto Justus for the models
* (synchronous generator and transformer)

* from Version 1.78 on the following parameter defaults are new to synchronous machines models
* a=0.9 (0.6-0.9) and m=7
* from Version 2 on saturation effect can be set for d and for q-axis different if you want
* default is a1=a a2=a m1=m m2=m
* The parameters a,m are for the nonlinear noload line of the generator
* This parameters are for the saturation of the generator
* For the salient pole machine the schenkelpolfaktor parameter
* can be set to 0.5 for salient pole machine (with kc=0.8-1)
* and to 1 for the cylindrical pole machine (with kc=0.4-0.65)
*
* from Version 2.52 on the parameters LE, LDx, LDy L0, RDx, RDy, R0 can be set directly as parameters (x=d-axis,y=q-axis)
* This is in accordance to the new parameter extraction routine in WxMaxima which
* allows to compute LE, LDd, LDq RDx, RDy paramters from Datasheet values of (Xd,Xq,Xd',Xq',Xd'',.. Td0,Td', ...
* If L0 and R0 not exists simply let these parameters free (automatically set to R0=Rs, L0=Ls)
*
* at Ue0 the nominal stator voltage occurs (g is computed to meat this)
* Ue0 and Ie0 are for computing the Magn.field resistance RE internally 
* New 2024: the g parameter is now computed as
* g={UE0/(UN*sqrt(2)*RE/(XD-omega_el*Ls))} ; updated formula for g parameter for D-axis
* and g1={UE0/(UN*sqrt(2)*RE/(XQ-omega_el*Ls))} ; updated formula for salient pole machine for Q-axis
* NOTE: The g-parameter is set to get the nominal 3 phase voltage at the stator with UE0 at the rotor
* Was before: g={IE0/((1+Streuung)*Kc*IN*sqrt(2))}
* HINT: All machines has a cosphi of 0.8
* SN=UN*IN*sqrt(3) but
* PN=SN*cosphi
*********************************************************************************************************************************************
* If J is entered directly as parameter taumech is not used
* omegamech=2*pi*n/60
* J=0.5*m*r^2 steel: 7900kg/m^3
* Erot=0.5*J*omegamech^2
* matlab: Erot/Pmech

*********************************************************************************************************************************************
* NOTE: For the older models Block1.. or DSG.. or GEN.. the parameter RE_factor is default 1 to be compatible with older examples
* RE_factor has influence at the time constant of the exciter circuit 
* The newer models use default parameter RE_factor=2/3=0.6666 which is the correct value
* If you use Block1 for new examples set RE_factor also to 0.6666
* Newer models type 0,1,2,3 have more measurement values and should per default be used
*********************************************************************************************************************************************

*NOTE:(sign of torque changed by mvz=0,1 - default 1)
*Speed positiv: 
*Torque pos. is generator
*Torque neg. is motor
*Speed negativ:
*Torque is motor
*Torque is generator


.SUBCKT Block1 U1 V1 W1 F1 M n GND1
+	PARAMS:
+	UN_verkettet=20000
+	IN=14.434k
+	Pel=400e6  ;UN_verkettet*IN*sqrt(3)*cosphi of 0.8
+	fn={fn1}
+	Kc=0.5
+	UE0=600V ; Power of exciter = 0.25-5% * SN machine (smaller values for higher SN)
+	IE0=2000A
+	p=2
+	Streuung=0.05 ;
+	rcu=0.001
+	rbg=0.001
+	Schenkelpolfaktor=1 ;(1=cylindrical pole 0.5=Salient pole)
+	Daempferfaktor=1
+	err0=0 RE_factor=1 ;Matlab compatible with RE_factor=2/3=0.6666
+   n0=1500 ;starts with 1500U/min
+   taumech=6.23
+   alpha_0=0
+   a=0.9 ; Parameter for nonlinear noload line (should be about 0.6-0.9)
+   m=7
+   Mvz=1
.PARAM
+   a1={a};  Saturation parameter d-axis
+   m1={m};  Saturation parameter d-axis
+   a2={a1}; Saturation parameter q-axis
+   m2={m1}; Saturation parameter q-axis
+	UN={UN_verkettet/sqrt(3)}
+	ZN={UN/IN}
+	Rs={ZN*rcu}
+	omega_el={(2*pi)*fN}
+	Ls={Streuung*ZN/Kc/omega_el}
+	PsiN={sqrt(2)*UN/omega_el}
+	RE={UE0/IE0}
+	RD={Rs/Daempferfaktor}
+   RDx={RD} ; can be overwritten by setting this parameters on modelline
+   RDy={RD} ; can be overwritten by setting this parameters on modelline
+   LDx={Ls} ; can be overwritten by setting this parameters on modelline
+   LDy={Ls} ; can be overwritten by setting this parameters on modelline
+   LE={Ls} ; can be overwritten by setting this parameters on modelline
+   R0={Rs} ; can be overwritten by setting this parameters on modelline
+   L0={Ls} ; can be overwritten by setting this parameters on modelline (X0 is 0.03-0.1 p.u)
+   Lsd={Ls} 
+   Lsq={Ls}
+   XD={UN/IN/Kc}
+   XQ={XD*Schenkelpolfaktor}
+   g={UE0/(UN*sqrt(2)*RE/(XD-omega_el*Lsd))} ; updated formula for g parameter
+   g1={UE0/(UN*sqrt(2)*RE/(XQ-omega_el*Lsq))} ; updated formula for salient pole machine
+	ImNx={IE0/g} ; d-axis magnetizing current
+	ImNy={IE0/g1} ;q-axis magnetizing current
+	MN={Pel*(1-rbg-rcu)*p/omega_el}
+   J= {p*taumech*MN/omega_el}
Rf1 f1 0 1e12
Rm  m  0 1e12
Rn1  n  0 1e12
Ri  i  0 1e12
Rf  f  0 1e12
Rus us 0 1e12
Rxd xd 0 1e12
*	currents of windings
G1	U1	U2	VALUE={v(isxS)+v(i_Null)} tripdv={tdv} tripdt={tdt}
G2	V1	V2	VALUE={(-v(isxS)+v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
G3	W1	W2	VALUE={(-v(isxS)-v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
GiE	F1	0	VALUE={v(ie)*g} tripdv={tdv} tripdt={tdt}
*	voltage components
EuxS	usxS	0	VALUE={(2*v(u1,u2)-v(v1,v2)-v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
EuyS	usyS	0	VALUE={(v(v1,v2)-v(w1,w2))/sqrt(3)} tripdv={tdv} tripdt={tdt}
Eux	usx	0	VALUE={ v(usxS)*cos(v(alpha))+v(usyS)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
Euy	usy	0	VALUE={-v(usxS)*sin(v(alpha))+v(usyS)*cos(v(alpha))} tripdv={tdv} tripdt={tdt}
*    Starpoint
R2     v2    GND1   1u
R12    u2    GND1   1u
R23    w2    GND1   1u
RGND1  GND1  0  1e6
ErefL1 Uref_L1 0 VALUE={-sqrt(2)*UN*sin(2*pi*(fN*(TIME)))} tripdv={tdv} tripdt={tdt}
*	Nullsystem
Eu0	u_Null 0	VALUE={(v(u1,u2)+v(v1,v2)+v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
Ei0	i_Null 0	VALUE={v(idt1)/L0} tripdv={tdv} tripdt={tdt}
Gi0 0 idt1  VALUE={v(u_Null)-R0*v(i_null)} tripdv={tdv} tripdt={tdt}
Ci0 idt1 0 1 IC=0
Ri0 idt1 0 1e10
*
*	current components
EisxS		isxS	0 VALUE={v(isx)*cos(v(alpha))-v(isy)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
EisyS		isyS	0 VALUE={v(isy)*cos(v(alpha))+v(isx)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of direct axis with saturation
Gpsix		0	isx	VALUE={v(psisx)} tripdv={tdv} tripdt={tdt}
Rsx		isx	0	{1/Lsd}
Gpsidx	isx	iDx1	VALUE={v(psiDx)} tripdv={tdv} tripdt={tdt} ; *********
Rsdx		iDx1	isx	{1/LDx}
GpsiEx	iDx1	imx1	VALUE={v(psiE)} tripdv={tdv} tripdt={tdt} ; ie oder if ist iDx,imx !!!!
RsEx		imx1	iDx1	{1/LE}
vphx		imx1	imxa1	0
Eimx		imxa1	0	VALUE={ImNx*(a1*i(vphx)/PsiN+(1-a1)*PWRS(i(vphx)/PsiN,m1))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of quadrature axis with saturation
Gpsiy		0	isy	VALUE={v(psisy)} tripdv={tdv} tripdt={tdt}
Rsy		isy	0	{1/Lsq}
Gpsidy	isy	imy1	VALUE={v(psiDy)} tripdv={tdv} tripdt={tdt}
Rsdy		imy1	isy	{1/LDy}
vphy		imy1	imya1	0
Eimy		imya1	0	VALUE={ImNy*(a2*i(vphy)/PsiN+(1-a2)*PWRS(i(vphy)/PsiN,m2))} tripdv={tdv} tripdt={tdt}
*
Eidx  idx 0 VALUE={v(idx1)-v(isx)} tripdv={tdv} tripdt={tdt}
Eidy  idy 0 VALUE={v(imy1)-v(isy)} tripdv={tdv} tripdt={tdt}
Eie ie 0 VALUE={v(imx1)-v(idx1)} tripdv={tdv} tripdt={tdt}


*	Flux components
Epsi_sx	psisx	0 VALUE={err0*PsiN+v(idt2)} tripdv={tdv} tripdt={tdt}
Gpsi_sx 0 idt2  VALUE={v(usx)-Rs*v(isx)+p*(2*pi)/60*v(n)*v(psisy)} tripdv={tdv} tripdt={tdt}
Cpsi_sx idt2 0 1 IC=0
Rpsi_sx idt2 0 1e10
*
Epsi_sy	psisy	0 VALUE={v(idt3)} tripdv={tdv} tripdt={tdt}
Gpsi_sy 0 idt3  VALUE={v(usy)-Rs*v(isy)-p*(2*pi)/60*v(n)*v(psisx)} tripdv={tdv} tripdt={tdt}
Cpsi_sy idt3 0 1 IC=0
Rpsi_sy idt3 0 1e10
*
Epsi_Dx	psiDx	0 VALUE={err0*psiN+v(idt4)} tripdv={tdv} tripdt={tdt}
Gpsi_Dx 0 idt4  VALUE={-RDx*v(idx)} tripdv={tdv} tripdt={tdt}
Cpsi_Dx idt4 0 1 IC=0
Rpsi_Dx idt4 0 1e10
*

Epsi_Dy	psiDy	0 VALUE={v(idt5)} tripdv={tdv} tripdt={tdt}
Gpsi_Dy 0 idt5  VALUE={-RDy*v(idy)} tripdv={tdv} tripdt={tdt}
Cpsi_Dy idt5 0 1 IC=0
Rpsi_Dy idt5 0 1e10
*
Epsi_E	psiE	0 VALUE={err0*psiN*(1+Streuung)+v(idt6)} tripdv={tdv} tripdt={tdt}
Gpsi_E 0 idt6  VALUE={v(F1,0)*g*RE_factor-RE*RE_factor*g*g*v(ie)} tripdv={tdv} tripdt={tdt} ;<--------- MATLAB compatible 
Cpsi_E idt6 0 1 IC=0
Rpsi_E idt6 0 1e10
*
Gtheta 0 theta VALUE={180/pi*atan2(v(usx),v(usy))} tripdv={tdv} tripdt={tdt}   ;Lastwinkel!!!!
Rtheta theta 0 1
Ctheta theta 0 10u
*
* current RMS of generator
Ei i 0 VALUE={0.7071*sqrt(v(isx)*v(isx)+v(isy)*v(isy))}  tripdv={tdv} tripdt={tdt}
* voltage RMS of generator
Ev Us 0 VALUE={sqrt(v(usx)*v(usx)+v(usy)*v(usy))}  tripdv={tdv} tripdt={tdt}
EU  u 0 VALUE={v(us)*sqrt(3)/sqrt(2)} tripdv={tdv} tripdt={tdt}
* Active power output of generator commented because sometimes slows down the simulation extremly
* Eap p 0 VALUE={3*(v(usx)*v(isx)/2+v(usy)*v(isy)/2)}  tripdv={tdv} tripdt={tdt}
* Reactive power output of generator commented because sometimes slows down the simulation extremly
* Eaq q 0 VALUE={3*(v(usy)*v(isx)/2-v(usx)*v(isy)/2)}  tripdv={tdv} tripdt={tdt}
* Xd of generator for cylindrical pole machine
Exd xd 0 VALUE={Xd} tripdv={tdv} tripdt={tdt}
Emi		Mi	0	VALUE={1.5*p*(i(vphx)*v(isy)-i(vphy)*v(isx))} tripdv={tdv} tripdt={tdt}
* friction
GRbg		0	Rbg	TABLE {v(n)} (-1,-1) (1,1)
RRbg		Rbg	0	{MN*rbg}
* Compute alpha
Ealpha	alpha	0	VALUE={alpha_0*pi/180+v(idt7)*p/60*(2*pi)} tripdv={tdv} tripdt={tdt}
Galpha 0 idt7  VALUE={v(n)} tripdv={tdv} tripdt={tdt}
Calpha idt7 0 1 IC=0
Ralpha idt7 0 1e10
* Compute n
En		n	0  VALUE={n0+60/(2*pi)/J*v(idt8)} tripdv={tdv} tripdt={tdt}
Gn 0 idt8  VALUE={v(M)*Mvz+v(Mi)-v(Rbg)} tripdv={tdv} tripdt={tdt}
Cn idt8 0 1 IC=0
Rn idt8 0 1e10
* Compute f
Ef      f   0  VALUE={v(n)*p/60} tripdv={tdv} tripdt={tdt}
.ENDS

.SUBCKT Block1_fixe_Drehzahl U1 V1 W1 F1 M n GND1
+	PARAMS:
+	UN_verkettet=20000
+	IN=14.434k
+	Pel=400e6  ;UN_verkettet*IN*sqrt(3)*cosphi of 0.8
+	fn={fn1}
+	Kc=0.5
+	UE0=600V ; Power of exciter = 0.25-5% * SN machine (smaller values for higher SN)
+	IE0=2000A
+	p=2
+	Streuung=0.05 ;
+	rcu=0.001
+	rbg=0.001
+	Schenkelpolfaktor=1 ;(1=cylindrical pole 0.5=Salient pole)
+	Daempferfaktor=1
+	err0=0 RE_factor=1 ;Matlab compatible with RE_factor=2/3=0.6666
+   n0=1500
+   n1={n0} ;starts with 1500U/min
+   taumech=6.23
+   alpha_0=0
+   a=0.9 ; Parameter for nonlinear noload line (should be about 0.6-0.9)
+   m=7
.PARAM
+   a1={a};  Saturation parameter d-axis
+   m1={m};  Saturation parameter d-axis
+   a2={a1}; Saturation parameter q-axis
+   m2={m1}; Saturation parameter q-axis
+	UN={UN_verkettet/sqrt(3)}
+	ZN={UN/IN}
+	Rs={ZN*rcu}
+	omega_el={(2*pi)*fN}
+	Ls={Streuung*ZN/Kc/omega_el}
+	PsiN={sqrt(2)*UN/omega_el}
+	RE={UE0/IE0}
+	RD={Rs/Daempferfaktor}
+   RDx={RD} ; can be overwritten by setting this parameters on modelline
+   RDy={RD} ; can be overwritten by setting this parameters on modelline
+   LDx={Ls} ; can be overwritten by setting this parameters on modelline
+   LDy={Ls} ; can be overwritten by setting this parameters on modelline
+   LE={Ls} ; can be overwritten by setting this parameters on modelline
+   R0={Rs} ; can be overwritten by setting this parameters on modelline
+   L0={Ls} ; can be overwritten by setting this parameters on modelline (X0 is 0.03-0.1 p.u)
+   Lsd={Ls} 
+   Lsq={Ls}
+   XD={UN/IN/Kc}
+   XQ={XD*Schenkelpolfaktor}
+   g={UE0/(UN*sqrt(2)*RE/(XD-omega_el*Lsd))} ; updated formula for g parameter
+   g1={UE0/(UN*sqrt(2)*RE/(XQ-omega_el*Lsq))} ; updated formula for salient pole machine
+	ImNx={IE0/g} ; d-axis magnetizing current
+	ImNy={IE0/g1} ;q-axis magnetizing current
+	MN={Pel*(1-rbg-rcu)*p/omega_el}
Rf1 f1 0 1e12
Rm  m  0 1e12
Rn2  n  0 1e12
Ri  i  0 1e12
Rf  f  0 1e12
Rus us 0 1e12
Rxd xd 0 1e12
*	currents of windings
G1	U1	U2	VALUE={v(isxS)+v(i_Null)} tripdv={tdv} tripdt={tdt}
G2	V1	V2	VALUE={(-v(isxS)+v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
G3	W1	W2	VALUE={(-v(isxS)-v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
GiE	F1	0	VALUE={v(ie)*g} tripdv={tdv} tripdt={tdt}
*	voltage components
EuxS	usxS	0	VALUE={(2*v(u1,u2)-v(v1,v2)-v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
EuyS	usyS	0	VALUE={(v(v1,v2)-v(w1,w2))/sqrt(3)} tripdv={tdv} tripdt={tdt}
Eux	usx	0	VALUE={ v(usxS)*cos(v(alpha))+v(usyS)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
Euy	usy	0	VALUE={-v(usxS)*sin(v(alpha))+v(usyS)*cos(v(alpha))} tripdv={tdv} tripdt={tdt}
*    Starpoint
R2     v2    GND1   1u
R12    u2    GND1   1u
R23    w2    GND1   1u
RGND1  GND1  0  1e6
ErefL1 Uref_L1 0 VALUE={-sqrt(2)*UN*sin(2*pi*(fN*(TIME)))} tripdv={tdv} tripdt={tdt}
*	Nullsystem
Eu0	u_Null 0	VALUE={(v(u1,u2)+v(v1,v2)+v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
Ei0	i_Null 0	VALUE={v(idt1)/L0} tripdv={tdv} tripdt={tdt}
Gi0 0 idt1  VALUE={v(u_Null)-R0*v(i_null)} tripdv={tdv} tripdt={tdt}
Ci0 idt1 0 1 IC=0
Ri0 idt1 0 1e10
*
*	current components
EisxS		isxS	0 VALUE={v(isx)*cos(v(alpha))-v(isy)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
EisyS		isyS	0 VALUE={v(isy)*cos(v(alpha))+v(isx)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of direct axis with saturation
Gpsix		0	isx	VALUE={v(psisx)} tripdv={tdv} tripdt={tdt}
Rsx		isx	0	{1/Lsd}
Gpsidx	isx	iDx1	VALUE={v(psiDx)} tripdv={tdv} tripdt={tdt} ; *********
Rsdx		iDx1	isx	{1/LDx}
GpsiEx	iDx1	imx1	VALUE={v(psiE)} tripdv={tdv} tripdt={tdt} ; ie oder if ist iDx,imx !!!!
RsEx		imx1	iDx1	{1/LE}
vphx		imx1	imxa1	0
Eimx		imxa1	0	VALUE={ImNx*(a1*i(vphx)/PsiN+(1-a1)*PWRS(i(vphx)/PsiN,m1))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of quadrature axis with saturation
Gpsiy		0	isy	VALUE={v(psisy)} tripdv={tdv} tripdt={tdt}
Rsy		isy	0	{1/Lsq}
Gpsidy	isy	imy1	VALUE={v(psiDy)} tripdv={tdv} tripdt={tdt}
Rsdy		imy1	isy	{1/LDy}
vphy		imy1	imya1	0
Eimy		imya1	0	VALUE={ImNy*(a2*i(vphy)/PsiN+(1-a2)*PWRS(i(vphy)/PsiN,m2))} tripdv={tdv} tripdt={tdt}
*
Eidx  idx 0 VALUE={v(idx1)-v(isx)} tripdv={tdv} tripdt={tdt}
Eidy  idy 0 VALUE={v(imy1)-v(isy)} tripdv={tdv} tripdt={tdt}
Eie ie 0 VALUE={v(imx1)-v(idx1)} tripdv={tdv} tripdt={tdt}


*	Flux components
Epsi_sx	psisx	0 VALUE={err0*PsiN+v(idt2)} tripdv={tdv} tripdt={tdt}
Gpsi_sx 0 idt2  VALUE={v(usx)-Rs*v(isx)+p*(2*pi)/60*v(n)*v(psisy)} tripdv={tdv} tripdt={tdt}
Cpsi_sx idt2 0 1 IC=0
Rpsi_sx idt2 0 1e10
*
Epsi_sy	psisy	0 VALUE={v(idt3)} tripdv={tdv} tripdt={tdt}
Gpsi_sy 0 idt3  VALUE={v(usy)-Rs*v(isy)-p*(2*pi)/60*v(n)*v(psisx)} tripdv={tdv} tripdt={tdt}
Cpsi_sy idt3 0 1 IC=0
Rpsi_sy idt3 0 1e10
*
Epsi_Dx	psiDx	0 VALUE={err0*psiN+v(idt4)} tripdv={tdv} tripdt={tdt}
Gpsi_Dx 0 idt4  VALUE={-RDx*v(idx)} tripdv={tdv} tripdt={tdt}
Cpsi_Dx idt4 0 1 IC=0
Rpsi_Dx idt4 0 1e10
*

Epsi_Dy	psiDy	0 VALUE={v(idt5)} tripdv={tdv} tripdt={tdt}
Gpsi_Dy 0 idt5  VALUE={-RDy*v(idy)} tripdv={tdv} tripdt={tdt}
Cpsi_Dy idt5 0 1 IC=0
Rpsi_Dy idt5 0 1e10
*
Epsi_E	psiE	0 VALUE={err0*psiN*(1+Streuung)+v(idt6)} tripdv={tdv} tripdt={tdt}
Gpsi_E 0 idt6  VALUE={v(F1,0)*g*RE_factor-RE*RE_factor*g*g*v(ie)} tripdv={tdv} tripdt={tdt} ;<--------- MATLAB compatible 
Cpsi_E idt6 0 1 IC=0
Rpsi_E idt6 0 1e10
*
Gtheta 0 theta VALUE={180/pi*atan2(v(usx),v(usy))} tripdv={tdv} tripdt={tdt}   ;Lastwinkel!!!!
Rtheta theta 0 1
Ctheta theta 0 10u
*
* current RMS of generator
Ei i 0 VALUE={0.7071*sqrt(v(isx)*v(isx)+v(isy)*v(isy))}  tripdv={tdv} tripdt={tdt}
* voltage RMS of generator
Ev Us 0 VALUE={sqrt(v(usx)*v(usx)+v(usy)*v(usy))}  tripdv={tdv} tripdt={tdt}
EU  u 0 VALUE={v(us)*sqrt(3)/sqrt(2)} tripdv={tdv} tripdt={tdt}
* Active power output of generator commented because sometimes slows down the simulation extremly
* Eap p 0 VALUE={3*(v(usx)*v(isx)/2+v(usy)*v(isy)/2)}  tripdv={tdv} tripdt={tdt}
* Reactive power output of generator commented because sometimes slows down the simulation extremly
* Eaq q 0 VALUE={3*(v(usy)*v(isx)/2-v(usx)*v(isy)/2)}  tripdv={tdv} tripdt={tdt}
* Xd of generator for cylindrical pole machine
Exd xd 0 VALUE={Xd} tripdv={tdv} tripdt={tdt}
Emi		Mi	0	VALUE={1.5*p*(i(vphx)*v(isy)-i(vphy)*v(isx))} tripdv={tdv} tripdt={tdt}
EMoment	M 0	VALUE={-v(Mi)+v(Rbg)} tripdv={tdv} tripdt={tdt}
Rn1 n 0 1k
Vn n 0 {n1}
* friction
GRbg		0	Rbg	TABLE {v(n)} (-1,-1) (1,1)
RRbg		Rbg	0	{MN*rbg}
* Compute alpha
Ealpha	alpha	0	VALUE={alpha_0*pi/180+v(idt7)*p/60*(2*pi)} tripdv={tdv} tripdt={tdt}
Galpha 0 idt7  VALUE={v(n)} tripdv={tdv} tripdt={tdt}
Calpha idt7 0 1 IC=0
Ralpha idt7 0 1e10
* Compute n
*En		n	0  VALUE={n0+60/(2*pi)/J*v(idt8)} tripdv={tdv} tripdt={tdt}
*Gn 0 idt8  VALUE={v(M)*Mvz+v(Mi)-v(Rbg)} tripdv={tdv} tripdt={tdt}
*Cn idt8 0 1 IC=0
*Rn idt8 0 1e10
* Compute f
Ef      f   0  VALUE={v(n)*p/60} tripdv={tdv} tripdt={tdt}
.ENDS 

.SUBCKT Block1_fixe_Drehzahl_TEST U1 V1 W1 F1 M n GND1
+	PARAMS:
+	UN_verkettet=20000
+	IN=14.434k
+	Pel=400e6  ;UN_verkettet*IN*sqrt(3)*cosphi of 0.8
+	fn={fn1}
+	Kc=0.5
+	UE0=600V ; Power of exciter = 0.25-5% * SN machine (smaller values for higher SN)
+	IE0=2000A
+	p=2
+	Streuung=0.05 ;
+	rcu=0.001
+	rbg=0.001
+	Schenkelpolfaktor=1 ;(1=cylindrical pole 0.5=Salient pole)
+	Daempferfaktor=1
+	err0=0 RE_factor=1 ;Matlab compatible with RE_factor=2/3=0.6666
+   n0=1500
+   n1={n0} ;starts with 1500U/min
+   taumech=6.23
+   alpha_0=0
+   a=0.9 ; Parameter for nonlinear noload line (should be about 0.6-0.9)
+   m=7
.PARAM
+   a1={a};  Saturation parameter d-axis
+   m1={m};  Saturation parameter d-axis
+   a2={a1}; Saturation parameter q-axis
+   m2={m1}; Saturation parameter q-axis
+	UN={UN_verkettet/sqrt(3)}
+	ZN={UN/IN}
+	Rs={ZN*rcu}
+	omega_el={(2*pi)*fN}
+	Ls={Streuung*ZN/Kc/omega_el}
+	PsiN={sqrt(2)*UN/omega_el}
+	RE={UE0/IE0}
+	RD={Rs/Daempferfaktor}
+   RDx={RD} ; can be overwritten by setting this parameters on modelline
+   RDy={RD} ; can be overwritten by setting this parameters on modelline
+   LDx={Ls} ; can be overwritten by setting this parameters on modelline
+   LDy={Ls} ; can be overwritten by setting this parameters on modelline
+   LE={Ls} ; can be overwritten by setting this parameters on modelline
+   R0={Rs} ; can be overwritten by setting this parameters on modelline
+   L0={Ls} ; can be overwritten by setting this parameters on modelline (X0 is 0.03-0.1 p.u)
+   Lsd={Ls} 
+   Lsq={Ls}
+   XD={UN/IN/Kc}
+   XQ={XD*Schenkelpolfaktor}
+   g={UE0/(UN*sqrt(2)*RE/(XD-omega_el*Lsd))} ; updated formula for g parameter
+   g1={UE0/(UN*sqrt(2)*RE/(XQ-omega_el*Lsq))} ; updated formula for salient pole machine
+	ImNx={IE0/g} ; d-axis magnetizing current
+	ImNy={IE0/g1} ;q-axis magnetizing current
+	MN={Pel*(1-rbg-rcu)*p/omega_el}
Rf1 f1 0 1e12
Rm  m  0 1e12
Rn2  n  0 1e12
Ri  i  0 1e12
Rf  f  0 1e12
Rus us 0 1e12
Rxd xd 0 1e12
*	currents of windings
G1	U1	U2	VALUE={v(isxS)+v(i_Null)} tripdv={tdv} tripdt={tdt}
G2	V1	V2	VALUE={(-v(isxS)+v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
G3	W1	W2	VALUE={(-v(isxS)-v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
GiE	F1	0	VALUE={v(ie)*g} tripdv={tdv} tripdt={tdt}
*	voltage components
EuxS	usxS	0	VALUE={(2*v(u1,u2)-v(v1,v2)-v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
EuyS	usyS	0	VALUE={(v(v1,v2)-v(w1,w2))/sqrt(3)} tripdv={tdv} tripdt={tdt}
Eux	usx	0	VALUE={ v(usxS)*cos(v(alpha))+v(usyS)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
Euy	usy	0	VALUE={-v(usxS)*sin(v(alpha))+v(usyS)*cos(v(alpha))} tripdv={tdv} tripdt={tdt}
*    Starpoint
R2     v2    GND1   1u
R12    u2    GND1   1u
R23    w2    GND1   1u
RGND1  GND1  0  1e6
ErefL1 Uref_L1 0 VALUE={-sqrt(2)*UN*sin(2*pi*(fN*(TIME)))} tripdv={tdv} tripdt={tdt}
*	Nullsystem
Eu0	u_Null 0	VALUE={(v(u1,u2)+v(v1,v2)+v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
Ei0	i_Null 0	VALUE={v(idt1)/L0} tripdv={tdv} tripdt={tdt}
Gi0 0 idt1  VALUE={v(u_Null)-R0*v(i_null)} tripdv={tdv} tripdt={tdt}
Ci0 idt1 0 1 IC=0
Ri0 idt1 0 1e10
*
*	current components
EisxS		isxS	0 VALUE={v(isx)*cos(v(alpha))-v(isy)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
EisyS		isyS	0 VALUE={v(isy)*cos(v(alpha))+v(isx)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of direct axis with saturation
Gpsix		0	isx	VALUE={v(psisx)} tripdv={tdv} tripdt={tdt}
Rsx		isx	0	{1/Lsd}
Gpsidx	isx	iDx1	VALUE={v(psiDx)} tripdv={tdv} tripdt={tdt} ; *********
Rsdx		iDx1	isx	{1/LDx}
GpsiEx	iDx1	imx1	VALUE={v(psiE)} tripdv={tdv} tripdt={tdt} ; ie oder if ist iDx,imx !!!!
RsEx		imx1	iDx1	{1/LE}
vphx		imx1	imxa1	0
Eimx		imxa1	0	VALUE={ImNx*(a1*i(vphx)/PsiN+(1-a1)*PWRS(i(vphx)/PsiN,m1))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of quadrature axis with saturation
Gpsiy		0	isy	VALUE={v(psisy)} tripdv={tdv} tripdt={tdt}
Rsy		isy	0	{1/Lsq}
Gpsidy	isy	imy1	VALUE={v(psiDy)} tripdv={tdv} tripdt={tdt}
Rsdy		imy1	isy	{1/LDy}
vphy		imy1	imya1	0
Eimy		imya1	0	VALUE={ImNy*(a2*i(vphy)/PsiN+(1-a2)*PWRS(i(vphy)/PsiN,m2))} tripdv={tdv} tripdt={tdt}
*
Eidx  idx 0 VALUE={v(idx1)-v(isx)} tripdv={tdv} tripdt={tdt}
Eidy  idy 0 VALUE={v(imy1)-v(isy)} tripdv={tdv} tripdt={tdt}
Eie ie 0 VALUE={v(imx1)-v(idx1)} tripdv={tdv} tripdt={tdt}


*	Flux components
Epsi_sx	psisx	0 VALUE={err0*PsiN+v(idt2)} tripdv={tdv} tripdt={tdt}
Gpsi_sx 0 idt2  VALUE={v(usx)-Rs*v(isx)+p*(2*pi)/60*v(n)*v(psisy)} tripdv={tdv} tripdt={tdt}
Cpsi_sx idt2 0 1 IC=0
Rpsi_sx idt2 0 1e10
*
Epsi_sy	psisy	0 VALUE={v(idt3)} tripdv={tdv} tripdt={tdt}
Gpsi_sy 0 idt3  VALUE={v(usy)-Rs*v(isy)-p*(2*pi)/60*v(n)*v(psisx)} tripdv={tdv} tripdt={tdt}
Cpsi_sy idt3 0 1 IC=0
Rpsi_sy idt3 0 1e10
*
Epsi_Dx	psiDx	0 VALUE={err0*psiN+v(idt4)} tripdv={tdv} tripdt={tdt}
Gpsi_Dx 0 idt4  VALUE={-RDx*v(idx)} tripdv={tdv} tripdt={tdt}
Cpsi_Dx idt4 0 1 IC=0
Rpsi_Dx idt4 0 1e10
*

Epsi_Dy	psiDy	0 VALUE={v(idt5)} tripdv={tdv} tripdt={tdt}
Gpsi_Dy 0 idt5  VALUE={-RDy*v(idy)} tripdv={tdv} tripdt={tdt}
Cpsi_Dy idt5 0 1 IC=0
Rpsi_Dy idt5 0 1e10
*
Epsi_E	psiE	0 VALUE={err0*psiN*(1+Streuung)+v(idt6)} tripdv={tdv} tripdt={tdt}
Gpsi_E 0 idt6  VALUE={v(F1,0)*g*RE_factor-RE*RE_factor*g*g*v(ie)} tripdv={tdv} tripdt={tdt} ;<--------- MATLAB compatible 
Cpsi_E idt6 0 1 IC=0
Rpsi_E idt6 0 1e10
*
Gtheta 0 theta VALUE={180/pi*atan2(v(usx),v(usy))} tripdv={tdv} tripdt={tdt}   ;Lastwinkel!!!!
Rtheta theta 0 1
Ctheta theta 0 10u
*
* current RMS of generator
Ei i 0 VALUE={0.7071*sqrt(v(isx)*v(isx)+v(isy)*v(isy))}  tripdv={tdv} tripdt={tdt}
* voltage RMS of generator
Ev Us 0 VALUE={sqrt(v(usx)*v(usx)+v(usy)*v(usy))}  tripdv={tdv} tripdt={tdt}
EU  u 0 VALUE={v(us)*sqrt(3)/sqrt(2)} tripdv={tdv} tripdt={tdt}
* Active power output of generator commented because sometimes slows down the simulation extremly
* Eap p 0 VALUE={3*(v(usx)*v(isx)/2+v(usy)*v(isy)/2)}  tripdv={tdv} tripdt={tdt}
* Reactive power output of generator commented because sometimes slows down the simulation extremly
* Eaq q 0 VALUE={3*(v(usy)*v(isx)/2-v(usx)*v(isy)/2)}  tripdv={tdv} tripdt={tdt}
* Xd of generator for cylindrical pole machine
Exd xd 0 VALUE={Xd} tripdv={tdv} tripdt={tdt}
Emi		Mi	0	VALUE={1.5*p*(i(vphx)*v(isy)-i(vphy)*v(isx))} tripdv={tdv} tripdt={tdt}
EMoment	M 0	VALUE={-v(Mi)+v(Rbg)} tripdv={tdv} tripdt={tdt}
Rn1 n 0 1k
Vn n 0 {n1}
* friction
GRbg		0	Rbg	TABLE {v(n)} (-1,-1) (1,1)
RRbg		Rbg	0	{MN*rbg}
* Compute alpha
Ealpha	alpha	0	VALUE={alpha_0*pi/180+v(idt7)*p/60*(2*pi)} tripdv={tdv} tripdt={tdt}
Galpha 0 idt7  VALUE={v(n)} tripdv={tdv} tripdt={tdt}
Calpha idt7 0 1 IC=0
Ralpha idt7 0 1e10
* Compute n
*En		n	0  VALUE={n0+60/(2*pi)/J*v(idt8)} tripdv={tdv} tripdt={tdt}
*Gn 0 idt8  VALUE={v(M)*Mvz+v(Mi)-v(Rbg)} tripdv={tdv} tripdt={tdt}
*Cn idt8 0 1 IC=0
*Rn idt8 0 1e10
* Compute f
Ef      f   0  VALUE={v(n)*p/60} tripdv={tdv} tripdt={tdt}
.ENDS
* omegamech=2*pi*n/60
* J=0.5*m*r^2 steel: 7900kg/m^3
* Erot=0.5*J*omegamech^2
* matlab: Erot/Pmech
* 400MW unit without damping windings

.SUBCKT Block1_oD U1 V1 W1 F1 M n GND1
+	PARAMS:
+	UN_verkettet=20000
+	IN=14.434k
+	Pel=400e6 ;UN_verkettet*IN*sqrt(3)*cosphi of 0.8
+	fn={fn1}
+	Kc=0.5
+	UE0=600V ; Power of exciter = 0.25-5% * SN machine (smaller values for higher SN)
+	IE0=2000A
+	p=2
+	Streuung=0.05 ;
+	rcu=0.01
+	rbg=0.001
+	Schenkelpolfaktor=1 ;(1=cylindrical pole 0.5=Salient pole)
+	Daempferfaktor=1
+	err0=0 RE_factor=1 ;Matlab compatible with RE_factor=2/3=0.6666
+   n0=1500 ;starts with 1500U/min
+   taumech=6.23
+   alpha_0=0
+   a=0.9 ; Parameter for nonlinear noload line (should be about 0.6-0.9)
+   m=7
+   Mvz=1
.PARAM
+   a1={a};  Saturation parameter d-axis
+   m1={m};  Saturation parameter d-axis
+   a2={a1}; Saturation parameter q-axis
+   m2={m1}; Saturation parameter q-axis
+	UN={UN_verkettet/sqrt(3)}
+	ZN={UN/IN}
+	Rs={ZN*rcu}
+	omega_el={(2*pi)*fN}
+	Ls={Streuung*ZN/Kc/omega_el}
+	PsiN={sqrt(2)*UN/omega_el}
+	RE={UE0/IE0}
+   LE={Ls}
+   R0={Rs}
+   L0={Ls} ; X0 is 0.03-0.1 p.u
+   Lsd={Ls} 
+   Lsq={Ls}
+   XD={UN/IN/Kc}
+   XQ={XD*Schenkelpolfaktor}
+   g={UE0/(UN*sqrt(2)*RE/(XD-omega_el*Lsd))} ; updated formula for g parameter
+   g1={UE0/(UN*sqrt(2)*RE/(XQ-omega_el*Lsq))} ; updated formula for salient pole machine
+	ImNx={IE0/g} ; d-axis magnetizing current
+	ImNy={IE0/g1} ;q-axis magnetizing current
+	MN={Pel*(1-rbg-rcu)*p/omega_el}
+   J= {p*taumech*MN/omega_el}
*	currents of windings
Rf1 f1 0 1e12
Rm  m  0 1e12
Rn  n  0 1e12
Ri  i  0 1e12
Rf  f  0 1e12
Rus us 0 1e12
Rxd xd 0 1e12
G1	U1	U2	VALUE={v(isxS)+v(i_Null)} tripdv={tdv} tripdt={tdt}
G2	V1	V2	VALUE={(-v(isxS)+v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
G3	W1	W2	VALUE={(-v(isxS)-v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
GiE	F1	0	VALUE={v(imx,isx)*g} tripdv={tdv} tripdt={tdt}
*	voltage components
EuxS	usxS	0	VALUE={(2*v(u1,u2)-v(v1,v2)-v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
EuyS	usyS	0	VALUE={(v(v1,v2)-v(w1,w2))/sqrt(3)} tripdv={tdv} tripdt={tdt}
Eux	usx	0	VALUE={ v(usxS)*cos(v(alpha))+v(usyS)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
Euy	usy	0	VALUE={-v(usxS)*sin(v(alpha))+v(usyS)*cos(v(alpha))} tripdv={tdv} tripdt={tdt}
*    Starpoint
R2     v2    GND1   1u
R12    u2    GND1   1u
R23    w2    GND1   1u
RGND1  GND1  0  1e6
*	Nullsystem
Eu0	u_Null 0	VALUE={(v(u1,u2)+v(v1,v2)+v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
Ei0	i_Null 0	VALUE={v(idt1)/L0} tripdv={tdv} tripdt={tdt}
Gi0 0 idt1  VALUE={v(u_Null)-R0*v(i_null)} tripdv={tdv} tripdt={tdt}
Ci0 idt1 0 1 IC=0
Ri0 idt1 0 1e10
*	current components
EisxS		isxS	0 VALUE={v(isx)*cos(v(alpha))-v(isy)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
EisyS		isyS	0 VALUE={v(isy)*cos(v(alpha))+v(isx)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of direct axis with saturation
Gpsix	0	isx	VALUE={v(psisx)} tripdv={tdv} tripdt={tdt}
Rsx		isx	0	{1/Lsd}
GpsiEx	isx	imx	VALUE={v(psiE)} tripdv={tdv} tripdt={tdt} ; ie oder if ist iDx,imx !!!!
RsEx		imx	isx	{1/LE}
vphx		imx	imxa	0
Eimx		imxa	0	VALUE={ImNx*(a1*i(vphx)/PsiN+(1-a1)*PWRS(i(vphx)/PsiN,m1))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of quadrature axis with saturation
Gpsiy		0	isy	VALUE={v(psisy)} tripdv={tdv} tripdt={tdt}
Rsy		isy	0	{1/Lsq} ; ********************************************************************* hier ist kein
vphy		isy	imya	0
Eimy		imya	0	VALUE={ImNy*(a2*i(vphy)/PsiN+(1-a2)*PWRS(i(vphy)/PsiN,m2))} tripdv={tdv} tripdt={tdt}
*	Flux components
Epsi_sx	psisx	0 VALUE={err0*PsiN+v(idt2)} tripdv={tdv} tripdt={tdt}
Gpsi_sx 0 idt2  VALUE={v(usx)-Rs*v(isx)+p*(2*pi)/60*v(n)*v(psisy)} tripdv={tdv} tripdt={tdt}
Cpsi_sx idt2 0 1 IC=0
Rpsi_sx idt2 0 1e10
Epsi_sy	psisy	0 VALUE={v(idt3)} tripdv={tdv} tripdt={tdt}
Gpsi_sy 0 idt3  VALUE={v(usy)-Rs*v(isy)-p*(2*pi)/60*v(n)*v(psisx)} tripdv={tdv} tripdt={tdt}
Cpsi_sy idt3 0 1 IC=0
Rpsi_sy idt3 0 1e10
Epsi_E	psiE	0 VALUE={err0*psiN*(1+Streuung)+v(idt6)} tripdv={tdv} tripdt={tdt}
Gpsi_E 0 idt6  VALUE={v(F1,0)*g*RE_factor-RE*RE_factor*g*g*v(ie)} tripdv={tdv} tripdt={tdt} ;<--------- MATLAB compatible 
Cpsi_E idt6 0 1 IC=0
Rpsi_E idt6 0 1e10
*
Gtheta 0 theta VALUE={180/pi*atan2(v(usx),v(usy))} tripdv={tdv} tripdt={tdt}  ;Lastwinkel!!!!
Rtheta theta 0 1
Ctheta theta 0 10u
* current RMS of generator
Ei i 0 VALUE={0.7071*sqrt(v(isx)*v(isx)+v(isy)*v(isy))}  tripdv={tdv} tripdt={tdt}
* voltage RMS of generator
Ev Us 0 VALUE={sqrt(v(usx)*v(usx)+v(usy)*v(usy))}  tripdv={tdv} tripdt={tdt}
EU  u 0 VALUE={v(us)*sqrt(3)/sqrt(2)} tripdv={tdv} tripdt={tdt}
* Active power output of generator commented because sometimes slows down the simulation extremly
* Eap p 0 VALUE={3*(v(usx)*v(isx)/2+v(usy)*v(isy)/2)}  tripdv={tdv} tripdt={tdt}
* Reactive power output of generator commented because sometimes slows down the simulation extremly
* Eaq q 0 VALUE={3*(v(usy)*v(isx)/2-v(usx)*v(isy)/2)}  tripdv={tdv} tripdt={tdt}
*
* Xd of generator for cylindrical pole machine
Exd xd 0 VALUE={Xd} tripdv={tdv} tripdt={tdt}
*
Emi		Mi	0	VALUE={1.5*p*(i(vphx)*v(isy)-i(vphy)*v(isx))} tripdv={tdv} tripdt={tdt}
* friction
GRbg		0	Rbg	TABLE {v(n)} (-1,-1) (1,1)
RRbg		Rbg	0	{MN*rbg}
* Compute alpha
Ealpha	alpha	0	VALUE={alpha_0*pi/180+v(idt7)*p/60*(2*pi)} tripdv={tdv} tripdt={tdt}
Galpha 0 idt7  VALUE={v(n)} tripdv={tdv} tripdt={tdt}
Calpha idt7 0 1 IC=0
Ralpha idt7 0 1e10
* Compute n
En		n	0  VALUE={n0+60/(2*pi)/J*v(idt8)} tripdv={tdv} tripdt={tdt}
Gn 0 idt8  VALUE={v(M)*Mvz+v(Mi)-v(Rbg)} tripdv={tdv} tripdt={tdt}
Cn idt8 0 1 IC=0
Rn1 idt8 0 1e10
* Compute f
Ef      f   0  VALUE={v(n)*p/60} tripdv={tdv} tripdt={tdt}
.ENDS ;

*$
* omegamech=2*pi*n/60
* J=0.5*m*r^2 steel: 7900kg/m^3
* Erot=0.5*J*omegamech^2
* matlab: Erot/Pmech
* 400MW unit for isolated operation
* G,C,R combination instead of IDT()/SDT() function ..
* .. because of better convergence
.SUBCKT Block1a U1 V1 W1 F1 M n GND1
+	PARAMS:
+	UN_verkettet=20000
+	IN=14.434k
+	Pel=400e6  ;UN_verkettet*IN*sqrt(3)*cosphi of 0.8
+	fn={fn1}
+	Kc=0.5
+	UE0=600V ; Power of exciter = 0.25-5% * SN machine (smaller values for higher SN)
+	IE0=2000A
+	p=2
+	Streuung=0.05 ;
+	rcu=0.001
+	rbg=0.001
+	Schenkelpolfaktor=1 ;(1=cylindrical pole 0.5=Salient pole)
+	Daempferfaktor=1
+	err0=0 RE_factor=1 ;Matlab compatible with RE_factor=2/3=0.6666
+   n0=1500 ;starts with 1500U/min
+   taumech=6.23
+   alpha_0=0
+   a=0.9 ; Parameter for nonlinear noload line (should be about 0.6-0.9)
+   m=7
+   Mvz=1
.PARAM
+   a1={a};  Saturation parameter d-axis
+   m1={m};  Saturation parameter d-axis
+   a2={a1}; Saturation parameter q-axis
+   m2={m1}; Saturation parameter q-axis
+	UN={UN_verkettet/sqrt(3)}
+	ZN={UN/IN}
+	Rs={ZN*rcu}
+	omega_el={(2*pi)*fN}
+	Ls={Streuung*ZN/Kc/omega_el}
+	PsiN={sqrt(2)*UN/omega_el}
+	RE={UE0/IE0}
+	RD={Rs/Daempferfaktor}
+   RDx={RD} ; can be overwritten by setting this parameters on modelline
+   RDy={RD} ; can be overwritten by setting this parameters on modelline
+   LDx={Ls} ; can be overwritten by setting this parameters on modelline
+   LDy={Ls} ; can be overwritten by setting this parameters on modelline
+   LE={Ls} ; can be overwritten by setting this parameters on modelline
+   R0={Rs} ; can be overwritten by setting this parameters on modelline
+   L0={Ls} ; can be overwritten by setting this parameters on modelline (X0 is 0.03-0.1 p.u)
+   Lsd={Ls} 
+   Lsq={Ls}
+   XD={UN/IN/Kc}
+   XQ={XD*Schenkelpolfaktor}
+   g={UE0/(UN*sqrt(2)*RE/(XD-omega_el*Lsd))} ; updated formula for g parameter
+   g1={UE0/(UN*sqrt(2)*RE/(XQ-omega_el*Lsq))} ; updated formula for salient pole machine
+	ImNx={IE0/g} ; d-axis magnetizing current
+	ImNy={IE0/g1} ;q-axis magnetizing current
+	MN={Pel*(1-rbg-rcu)*p/omega_el}
+   J= {p*taumech*MN/omega_el}
Rf1 f1 0 1e12
Rm  m  0 1e12
Rn1  n  0 1e12
Ri  i  0 1e12
Rf  f  0 1e12
Rus us 0 1e12
Rxd xd 0 1e12
*	currents of windings
G1	U1	U2	VALUE={v(isxS)+v(i_Null)} tripdv={tdv} tripdt={tdt}
G2	V1	V2	VALUE={(-v(isxS)+v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
G3	W1	W2	VALUE={(-v(isxS)-v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
GiE	F1	0	VALUE={v(ie)*g} tripdv={tdv} tripdt={tdt}
*	voltage components
EuxS	usxS	0	VALUE={(2*v(u1,u2)-v(v1,v2)-v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
EuyS	usyS	0	VALUE={(v(v1,v2)-v(w1,w2))/sqrt(3)} tripdv={tdv} tripdt={tdt}
Eux	usx	0	VALUE={ v(usxS)*cos(v(alpha))+v(usyS)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
Euy	usy	0	VALUE={-v(usxS)*sin(v(alpha))+v(usyS)*cos(v(alpha))} tripdv={tdv} tripdt={tdt}
*    Starpoint
R2     v2    GND1   1u
R12    u2    GND1   1u
R23    w2    GND1   1u
RGND1  GND1  0  1e6
ErefL1 Uref_L1 0 VALUE={-sqrt(2)*UN*sin(2*pi*(fN*(TIME)))} tripdv={tdv} tripdt={tdt}
*	Nullsystem
Eu0	u_Null 0	VALUE={(v(u1,u2)+v(v1,v2)+v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
Ei0	i_Null 0	VALUE={v(idt1)/L0} tripdv={tdv} tripdt={tdt}
Gi0 0 idt1  VALUE={v(u_Null)-R0*v(i_null)} tripdv={tdv} tripdt={tdt}
Ci0 idt1 0 1 IC=0
Ri0 idt1 0 1e10
*
*	current components
EisxS		isxS	0 VALUE={v(isx)*cos(v(alpha))-v(isy)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
EisyS		isyS	0 VALUE={v(isy)*cos(v(alpha))+v(isx)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of direct axis with saturation
Gpsix		0	isx	VALUE={v(psisx)} tripdv={tdv} tripdt={tdt}
Rsx		isx	0	{1/Lsd}
Gpsidx	isx	iDx1	VALUE={v(psiDx)} tripdv={tdv} tripdt={tdt} ; *********
Rsdx		iDx1	isx	{1/LDx}
GpsiEx	iDx1	imx1	VALUE={v(psiE)} tripdv={tdv} tripdt={tdt} ; ie oder if ist iDx,imx !!!!
RsEx		imx1	iDx1	{1/LE}
vphx		imx1	imxa1	0
Eimx		imxa1	0	VALUE={ImNx*(a1*i(vphx)/PsiN+(1-a1)*PWRS(i(vphx)/PsiN,m1))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of quadrature axis with saturation
Gpsiy		0	isy	VALUE={v(psisy)} tripdv={tdv} tripdt={tdt}
Rsy		isy	0	{1/Lsq}
Gpsidy	isy	imy1	VALUE={v(psiDy)} tripdv={tdv} tripdt={tdt}
Rsdy		imy1	isy	{1/LDy}
vphy		imy1	imya1	0
Eimy		imya1	0	VALUE={ImNy*(a2*i(vphy)/PsiN+(1-a2)*PWRS(i(vphy)/PsiN,m2))} tripdv={tdv} tripdt={tdt}
*
Eidx  idx 0 VALUE={v(idx1)-v(isx)} tripdv={tdv} tripdt={tdt}
Eidy  idy 0 VALUE={v(imy1)-v(isy)} tripdv={tdv} tripdt={tdt}
Eie ie 0 VALUE={v(imx1)-v(idx1)} tripdv={tdv} tripdt={tdt}


*	Flux components
Epsi_sx	psisx	0 VALUE={err0*PsiN+v(idt2)} tripdv={tdv} tripdt={tdt}
Gpsi_sx 0 idt2  VALUE={v(usx)-Rs*v(isx)+p*(2*pi)/60*v(n)*v(psisy)} tripdv={tdv} tripdt={tdt}
Cpsi_sx idt2 0 1 IC=0
Rpsi_sx idt2 0 1e10
*
Epsi_sy	psisy	0 VALUE={v(idt3)} tripdv={tdv} tripdt={tdt}
Gpsi_sy 0 idt3  VALUE={v(usy)-Rs*v(isy)-p*(2*pi)/60*v(n)*v(psisx)} tripdv={tdv} tripdt={tdt}
Cpsi_sy idt3 0 1 IC=0
Rpsi_sy idt3 0 1e10
*
Epsi_Dx	psiDx	0 VALUE={err0*psiN+v(idt4)} tripdv={tdv} tripdt={tdt}
Gpsi_Dx 0 idt4  VALUE={-RDx*v(idx)} tripdv={tdv} tripdt={tdt}
Cpsi_Dx idt4 0 1 IC=0
Rpsi_Dx idt4 0 1e10
*

Epsi_Dy	psiDy	0 VALUE={v(idt5)} tripdv={tdv} tripdt={tdt}
Gpsi_Dy 0 idt5  VALUE={-RDy*v(idy)} tripdv={tdv} tripdt={tdt}
Cpsi_Dy idt5 0 1 IC=0
Rpsi_Dy idt5 0 1e10
*
Epsi_E	psiE	0 VALUE={err0*psiN*(1+Streuung)+v(idt6)} tripdv={tdv} tripdt={tdt}
Gpsi_E 0 idt6  VALUE={v(F1,0)*g*RE_factor-RE*RE_factor*g*g*v(ie)} tripdv={tdv} tripdt={tdt} ;<--------- MATLAB compatible 
Cpsi_E idt6 0 1 IC=0
Rpsi_E idt6 0 1e10
*
Gtheta 0 theta VALUE={180/pi*atan2(v(usx),v(usy))} tripdv={tdv} tripdt={tdt}   ;Lastwinkel!!!!
Rtheta theta 0 1
Ctheta theta 0 10u
*
* current RMS of generator
Ei i 0 VALUE={0.7071*sqrt(v(isx)*v(isx)+v(isy)*v(isy))}  tripdv={tdv} tripdt={tdt}
* voltage RMS of generator
Ev Us 0 VALUE={sqrt(v(usx)*v(usx)+v(usy)*v(usy))}  tripdv={tdv} tripdt={tdt}
EU  u 0 VALUE={v(us)*sqrt(3)/sqrt(2)} tripdv={tdv} tripdt={tdt}
* Active power output of generator commented because sometimes slows down the simulation extremly
* Eap p 0 VALUE={3*(v(usx)*v(isx)/2+v(usy)*v(isy)/2)}  tripdv={tdv} tripdt={tdt}
* Reactive power output of generator commented because sometimes slows down the simulation extremly
* Eaq q 0 VALUE={3*(v(usy)*v(isx)/2-v(usx)*v(isy)/2)}  tripdv={tdv} tripdt={tdt}
* Xd of generator for cylindrical pole machine
Exd xd 0 VALUE={Xd} tripdv={tdv} tripdt={tdt}
Emi		Mi	0	VALUE={1.5*p*(i(vphx)*v(isy)-i(vphy)*v(isx))} tripdv={tdv} tripdt={tdt}
* friction
GRbg		0	Rbg	TABLE {v(n)} (-1,-1) (1,1)
RRbg		Rbg	0	{MN*rbg}
* Compute alpha
Ealpha	alpha	0	VALUE={alpha_0*pi/180+v(idt7)*p/60*(2*pi)} tripdv={tdv} tripdt={tdt}
Galpha 0 idt7  VALUE={v(n)} tripdv={tdv} tripdt={tdt}
Calpha idt7 0 1 IC=0
Ralpha idt7 0 1e10
* Compute n
En		n	0  VALUE={n0+60/(2*pi)/J*v(idt8)} tripdv={tdv} tripdt={tdt}
Gn 0 idt8  VALUE={v(M)*Mvz+v(Mi)-v(Rbg)} tripdv={tdv} tripdt={tdt}
Cn idt8 0 1 IC=0
Rn idt8 0 1e10
* Compute f
Ef      f   0  VALUE={v(n)*p/60} tripdv={tdv} tripdt={tdt}
.ENDS ;


* generic generator for isolated operation
.SUBCKT DSG_Insel U1 V1 W1 F1 M n GND1
+	PARAMS:
+	UN_verkettet=400V
+	IN=21A
+	Pel=12kW  ;UN_verkettet*IN*sqrt(3)*cosphi of 0.8
+	fn={fn1}
+	Kc=0.5
+	UE0=48V ; Power of exciter = 0.25-5% * SN machine (smaller values for higher SN)
+	IE0=5A
+	p=2
+	Streuung=0.05
+	rcu=0.05
+	rbg=0.05
+	Schenkelpolfaktor=1 ;(1=cylindrical pole 0.5=Salient pole)
+	Daempferfaktor=1
+	err0=0 RE_factor=1 ;Matlab compatible with RE_factor=2/3=0.6666
+   n0=1500
+   taumech=2.3
+   alpha_0=0
+  a=0.9
+  m=7
+   Mvz=1
.PARAM
+   a1={a};  Saturation parameter d-axis
+   m1={m};  Saturation parameter d-axis
+   a2={a1}; Saturation parameter q-axis
+   m2={m1}; Saturation parameter q-axis
+	UN={UN_verkettet/sqrt(3)}
+	ZN={UN/IN}
+	Rs={ZN*rcu}
+	omega_el={(2*pi)*fN}
;+	g={IE0/((1+Streuung)*Kc*IN*sqrt(2))}
+	Ls={Streuung*ZN/Kc/omega_el}
+	PsiN={sqrt(2)*UN/omega_el}
+	RE={UE0/IE0}
+	RD={Rs/Daempferfaktor}
+   RDx={RD} ; can be overwritten by setting this parameters on modelline
+   RDy={RD} ; can be overwritten by setting this parameters on modelline
+   LDx={Ls} ; can be overwritten by setting this parameters on modelline
+   LDy={Ls} ; can be overwritten by setting this parameters on modelline
+   LE={Ls} ; can be overwritten by setting this parameters on modelline
+   R0={Rs} ; can be overwritten by setting this parameters on modelline
+   L0={Ls} ; can be overwritten by setting this parameters on modelline (X0 is 0.03-0.1 p.u)
+   Lsd={Ls} 
+   Lsq={Ls}
+   XD={UN/IN/Kc}
+   XQ={XD*Schenkelpolfaktor}
+   g={UE0/(UN*sqrt(2)*RE/(XD-omega_el*Lsd))} ; updated formula for g parameter
+   g1={UE0/(UN*sqrt(2)*RE/(XQ-omega_el*Lsq))} ; updated formula for salient pole machine
+	ImNx={IE0/g} ; d-axis magnetizing current
+	ImNy={IE0/g1} ;q-axis magnetizing current
+	MN={Pel*(1-rbg-rcu)*p/omega_el}
+   J= {p*taumech*MN/omega_el}
Rf1 f1 0 1e12
Rm  m  0 1e12
Rn1  n  0 1e12
Ri  i  0 1e12
Rf  f  0 1e12
Rus us 0 1e12
Rxd xd 0 1e12
*	currents of windings
G1	U1	U2	VALUE={v(isxS)+v(i_Null)} tripdv={tdv} tripdt={tdt}
G2	V1	V2	VALUE={(-v(isxS)+v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
G3	W1	W2	VALUE={(-v(isxS)-v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
GiE	F1	0	VALUE={v(imx,iDx)*g} tripdv={tdv} tripdt={tdt}
*	voltage components
EuxS	usxS	0	VALUE={(2*v(u1,u2)-v(v1,v2)-v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
EuyS	usyS	0	VALUE={(v(v1,v2)-v(w1,w2))/sqrt(3)} tripdv={tdv} tripdt={tdt}
Eux	usx	0	VALUE={ v(usxS)*cos(v(alpha))+v(usyS)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
Euy	usy	0	VALUE={-v(usxS)*sin(v(alpha))+v(usyS)*cos(v(alpha))} tripdv={tdv} tripdt={tdt}
*    Starpoint
R2     v2    GND1   1u
R12    u2    GND1   1u
R23    w2    GND1   1u
RGND1  GND1  0  1e6
ErefL1 Uref_L1 0 VALUE={-sqrt(2)*UN*sin(2*pi*(fN*(TIME)))} tripdv={tdv} tripdt={tdt}
*	Nullsystem
Eu0	u_Null 0	VALUE={(v(u1,u2)+v(v1,v2)+v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
Ei0	i_Null 0	VALUE={v(idt1)/L0} tripdv={tdv} tripdt={tdt}
Gi0 0 idt1  VALUE={v(u_Null)-R0*v(i_null)} tripdv={tdv} tripdt={tdt}
Ci0 idt1 0 1 IC=0
Ri0 idt1 0 1e10
*
*	current components
EisxS		isxS	0 VALUE={v(isx)*cos(v(alpha))-v(isy)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
EisyS		isyS	0 VALUE={v(isy)*cos(v(alpha))+v(isx)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of direct axis with saturation
Gpsix		0	isx	VALUE={v(psisx)} tripdv={tdv} tripdt={tdt}
Rsx		isx	0	{1/Lsd}
Gpsidx	isx	iDx	VALUE={v(psiDx)} tripdv={tdv} tripdt={tdt} ; *********
Rsdx		iDx	isx	{1/LDx}
GpsiEx	iDx	imx	VALUE={v(psiE)} tripdv={tdv} tripdt={tdt} ; ie oder if ist iDx,imx !!!!
RsEx		imx	iDx	{1/LE}
vphx		imx	imxa	0
Eimx		imxa	0	VALUE={ImNx*(a1*i(vphx)/PsiN+(1-a1)*PWRS(i(vphx)/PsiN,m1))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of quadrature axis with saturation
Gpsiy		0	isy	VALUE={v(psisy)} tripdv={tdv} tripdt={tdt}
Rsy		isy	0	{1/Lsq}
Gpsidy	isy	imy	VALUE={v(psiDy)} tripdv={tdv} tripdt={tdt}
Rsdy		imy	isy	{1/LDy}
vphy		imy	imya	0
Eimy		imya	0	VALUE={ImNy*(a2*i(vphy)/PsiN+(1-a2)*PWRS(i(vphy)/PsiN,m2))} tripdv={tdv} tripdt={tdt}
*	Flux components
Epsi_sx	psisx	0 VALUE={err0*PsiN+v(idt2)} tripdv={tdv} tripdt={tdt}
Gpsi_sx 0 idt2  VALUE={v(usx)-Rs*v(isx)+p*(2*pi)/60*v(n)*v(psisy)} tripdv={tdv} tripdt={tdt}
Cpsi_sx idt2 0 1 IC=0
Rpsi_sx idt2 0 1e10
*
Epsi_sy	psisy	0 VALUE={v(idt3)} tripdv={tdv} tripdt={tdt}
Gpsi_sy 0 idt3  VALUE={v(usy)-Rs*v(isy)-p*(2*pi)/60*v(n)*v(psisx)} tripdv={tdv} tripdt={tdt}
Cpsi_sy idt3 0 1 IC=0
Rpsi_sy idt3 0 1e10
*
Epsi_Dx	psiDx	0 VALUE={err0*psiN+v(idt4)} tripdv={tdv} tripdt={tdt}
Gpsi_Dx 0 idt4  VALUE={-RDx*v(iDx,iSx)} tripdv={tdv} tripdt={tdt}
Cpsi_Dx idt4 0 1 IC=0
Rpsi_Dx idt4 0 1e10
*

Epsi_Dy	psiDy	0 VALUE={v(idt5)} tripdv={tdv} tripdt={tdt}
Gpsi_Dy 0 idt5  VALUE={-RDy*v(imy,isy)} tripdv={tdv} tripdt={tdt}
Cpsi_Dy idt5 0 1 IC=0
Rpsi_Dy idt5 0 1e10
*
Epsi_E	psiE	0 VALUE={err0*psiN*(1+Streuung)+v(idt6)} tripdv={tdv} tripdt={tdt}
Gpsi_E 0 idt6  VALUE={v(F1,0)*g*RE_factor-RE*RE_factor*g*g*v(ie)} tripdv={tdv} tripdt={tdt} ;<--------- MATLAB compatible 
Cpsi_E idt6 0 1 IC=0
Rpsi_E idt6 0 1e10
*
Gtheta 0 theta VALUE={180/pi*atan2(v(usx),v(usy))} tripdv={tdv} tripdt={tdt}   ;Lastwinkel!!!!
Rtheta theta 0 1
Ctheta theta 0 10u
*
* current RMS of generator
Ei i 0 VALUE={0.7071*sqrt(v(isx)*v(isx)+v(isy)*v(isy))}  tripdv={tdv} tripdt={tdt}
* voltage RMS of generator
Ev Us 0 VALUE={sqrt(v(usx)*v(usx)+v(usy)*v(usy))}  tripdv={tdv} tripdt={tdt}
EU  u 0 VALUE={v(us)*sqrt(3)/sqrt(2)} tripdv={tdv} tripdt={tdt}
* Active power output of generator commented because sometimes slows down the simulation extremly
* Eap p 0 VALUE={3*(v(usx)*v(isx)/2+v(usy)*v(isy)/2)}  tripdv={tdv} tripdt={tdt}
* Reactive power output of generator commented because sometimes slows down the simulation extremly
* Eaq q 0 VALUE={3*(v(usy)*v(isx)/2-v(usx)*v(isy)/2)}  tripdv={tdv} tripdt={tdt}
* Xd of generator for cylindrical pole machine
Exd xd 0 VALUE={Xd} tripdv={tdv} tripdt={tdt}
Emi		Mi	0	VALUE={1.5*p*(i(vphx)*v(isy)-i(vphy)*v(isx))} tripdv={tdv} tripdt={tdt}
* friction
GRbg		0	Rbg	TABLE {v(n)} (-1,-1) (1,1)
RRbg		Rbg	0	{MN*rbg}
* Compute alpha
Ealpha	alpha	0	VALUE={alpha_0*pi/180+v(idt7)*p/60*(2*pi)} tripdv={tdv} tripdt={tdt}
Galpha 0 idt7  VALUE={v(n)} tripdv={tdv} tripdt={tdt}
Calpha idt7 0 1 IC=0
Ralpha idt7 0 1e10
* Compute n
En		n	0  VALUE={n0+60/(2*pi)/J*v(idt8)} tripdv={tdv} tripdt={tdt}
Gn 0 idt8  VALUE={v(M)*Mvz+v(Mi)-v(Rbg)} tripdv={tdv} tripdt={tdt}
Cn idt8 0 1 IC=0
Rn idt8 0 1e10
* Compute f
Ef      f   0  VALUE={v(n)*p/60} tripdv={tdv} tripdt={tdt}
Eomega omega 0 VALUE={DDT(v(alpha))} tripdv={tdv} tripdt={tdt}
.ENDS ;
*$

* generic generator at fixed speed
.SUBCKT DSG_fixe_Drehzahl U1 V1 W1 F1 M n GND1
+	PARAMS:
+	UN_verkettet=400V
+	IN=21A
+	Pel=12kW  ;UN_verkettet*IN*sqrt(3)*cosphi of 0.8
+	fn={fn1}
+	Kc=0.5
+	UE0=48V ; Power of exciter = 0.25-5% * SN machine (smaller values for higher SN)
+	IE0=5A
+	p=2
+	Streuung=0.05
+	rcu=0.05
+	rbg=0.05
+	Schenkelpolfaktor=1 ;(1=cylindrical pole 0.5=Salient pole)
+	Daempferfaktor=1
+	err0=0 RE_factor=1 ;Matlab compatible with RE_factor=2/3=0.6666
+   n0=1500
+	n1={n0}
+	t_anlauf=2m
+	t_auslauf=2
+	t_betrieb=100
+	n_Turbine={n1}
+   alpha_0=0
+   a=0.9 ; Parameter for nonlinear noload line (should be about 0.6-0.9)
+   m=7
.PARAM
+   a1={a};  Saturation parameter d-axis
+   m1={m};  Saturation parameter d-axis
+   a2={a1}; Saturation parameter q-axis
+   m2={m1}; Saturation parameter q-axis
+	UN={UN_verkettet/sqrt(3)}
+	ZN={UN/IN}
+	Rs={ZN*rcu}
+	omega_el={(2*pi)*fN}
;+	 g={IE0/((1+Streuung)*Kc*IN*sqrt(2))}
+	Ls={Streuung*ZN/Kc/omega_el}
+	PsiN={sqrt(2)*UN/omega_el}
+	RD={Rs/Daempferfaktor}
+	RE={UE0/IE0}
+   RDx={RD} ; can be overwritten by setting this parameters on modelline
+   RDy={RD} ; can be overwritten by setting this parameters on modelline
+   LDx={Ls} ; can be overwritten by setting this parameters on modelline
+   LDy={Ls} ; can be overwritten by setting this parameters on modelline
+   LE={Ls} ; can be overwritten by setting this parameters on modelline
+   R0={Rs} ; can be overwritten by setting this parameters on modelline
+   L0={Ls} ; can be overwritten by setting this parameters on modelline (X0 is 0.03-0.1 p.u)
+   Lsd={Ls} 
+   Lsq={Ls}
+   XD={UN/IN/Kc}
+   XQ={XD*Schenkelpolfaktor}
+   g={UE0/(UN*sqrt(2)*RE/(XD-omega_el*Lsd))} ; updated formula for g parameter
+   g1={UE0/(UN*sqrt(2)*RE/(XQ-omega_el*Lsq))} ; updated formula for salient pole machine
+	ImNx={IE0/g} ; d-axis magnetizing current
+	ImNy={IE0/g1} ;q-axis magnetizing current
+	MN={Pel*(1-rbg-rcu)*p/omega_el}
+  Lhd3={XD/(2*pi*fn)-Lsd}
+  Lhq3={XQ/(2*pi*fn)-Lsq}
Rf1 f1 0 1e12
Rm  m  0 1e12
Rn2  n  0 1e12
Eun un 0 VALUE={Un} tripdv={tdv} tripdt={tdt}
Ein in 0 VALUE={In} tripdv={tdv} tripdt={tdt}
Esn sn 0 VALUE={3*Un*In} tripdv={tdv} tripdt={tdt}
Epn pn 0 VALUE={pel} tripdv={tdv} tripdt={tdt}
Ecosphin cosphi 0 VALUE={pel/(3*Un*In)} tripdv={tdv} tripdt={tdt}
Ezn zn 0 VALUE={Zn} tripdv={tdv} tripdt={tdt}
Ers rs 0 VALUE={Rs} tripdv={tdv} tripdt={tdt}
* New
Epcu pcu 0 VALUE={3*v(i)*v(i)*Rs} tripdv={tdv} tripdt={tdt}
* Pcu1 same as Pcu
*Epcu1 pcu1 0 VALUE={1.5*Rs*(v(isx)*v(isx)+v(isy)*v(isy))} tripdv={tdv} tripdt={tdt}
Epcu2 pcu2 0 VALUE={v(idx)*v(idx)*RDx+v(idy)*v(idy)*RDy} tripdv={tdv} tripdt={tdt}
* This loss is fed by the external exciter !!!! Pcu_exciter=UE*IE
Epcu3 pcu3 0 VALUE={v(ie)*v(ie)*g*g*Re*RE_factor} tripdv={tdv} tripdt={tdt}
Epcusum pcusum 0 VALUE={v(pcu)+v(pcu2)+v(pcu3)} tripdv={tdv} tripdt={tdt}
*	currents of windings
G1	U1	U2	VALUE={v(isxS)+v(i_Null)} tripdv={tdv} tripdt={tdt}
G2	V1	V2	VALUE={(-v(isxS)+v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
G3	W1	W2	VALUE={(-v(isxS)-v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
GiE	F1	0	VALUE={v(ie)*g} tripdv={tdv} tripdt={tdt}
*	voltage components
EuxS	usxS	0	VALUE={(2*v(u1,u2)-v(v1,v2)-v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
EuyS	usyS	0	VALUE={(v(v1,v2)-v(w1,w2))/sqrt(3)} tripdv={tdv} tripdt={tdt}
Eux	usx	0	VALUE={ v(usxS)*cos(v(alpha))+v(usyS)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
Euy	usy	0	VALUE={-v(usxS)*sin(v(alpha))+v(usyS)*cos(v(alpha))} tripdv={tdv} tripdt={tdt}
*    Starpoint
R2     v2    GND1   1u
R12    u2    GND1   1u
R23    w2    GND1   1u
RGND1  GND1  0  1e6
ErefL1 Uref_L1 0 VALUE={-sqrt(2)*UN*sin(2*pi*(fN*(TIME)))} tripdv={tdv} tripdt={tdt}
*	Nullsystem
Eu0	u_Null 0	VALUE={(v(u1,u2)+v(v1,v2)+v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
Ei0	i_Null 0	VALUE={v(idt1)/L0} tripdv={tdv} tripdt={tdt}
Gi0 0 idt1  VALUE={v(u_Null)-R0*v(i_null)} tripdv={tdv} tripdt={tdt}
Ci0 idt1 0 1 IC=0
Ri0 idt1 0 1e10
*
*	current components
EisxS		isxS	0 VALUE={v(isx)*cos(v(alpha))-v(isy)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
EisyS		isyS	0 VALUE={v(isy)*cos(v(alpha))+v(isx)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of direct axis with saturation
Gpsix		0	isx	VALUE={v(psisx)} tripdv={tdv} tripdt={tdt}
Rsx		isx	0	{1/Lsd}
Gpsidx	isx	iDx1	VALUE={v(psiDx)} tripdv={tdv} tripdt={tdt} ; *********
Rsdx		iDx1	isx	{1/LDx}
GpsiEx	iDx1	imx1	VALUE={v(psiE)} tripdv={tdv} tripdt={tdt} ; ie oder if ist iDx,imx !!!!
RsEx		imx1	iDx1	{1/LE}
vphx		imx1	imxa1	0
Eimx1		imxa1	0	VALUE={ImNx*(a1*i(vphx)/PsiN+(1-a1)*PWRS(i(vphx)/PsiN,m1))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of quadrature axis with saturation
Gpsiy		0	isy	VALUE={v(psisy)} tripdv={tdv} tripdt={tdt}
Rsy		isy	0	{1/Lsq}
Gpsidy	isy	imy1	VALUE={v(psiDy)} tripdv={tdv} tripdt={tdt}
Rsdy		imy1	isy	{1/LDy}
vphy		imy1	imya1	0
Eimy1		imya1	0	VALUE={ImNy*(a2*i(vphy)/PsiN+(1-a2)*PWRS(i(vphy)/PsiN,m2))} tripdv={tdv} tripdt={tdt}
*
Eidx  idx 0 VALUE={v(idx1)-v(isx)} tripdv={tdv} tripdt={tdt}
Eidy  idy 0 VALUE={v(imy1)-v(isy)} tripdv={tdv} tripdt={tdt}
Eie ie 0 VALUE={v(imx1)-v(idx1)} tripdv={tdv} tripdt={tdt}
Eimx imx 0 VALUE={v(isx)+v(idx)+v(ie)} tripdv={tdv} tripdt={tdt};magnetizing current d-axes
Eimy imy 0 VALUE={v(isy)+v(idy)}       tripdv={tdv} tripdt={tdt};magnetizing current q-axes

* nonlinear magnetics
Elhd3 Lhd3 0 VALUE={Lhd3*(1/(a1+(1-a1)*PWRS(LIMIT(abs(v(psihx)+1p)/PsiN,-10,10),m1-1)))} tripdv={tdv} tripdt={tdt}
Elhq3 Lhq3 0 VALUE={Lhq3*(1/(a2+(1-a2)*PWRS(LIMIT(abs(v(psihy)+1p)/PsiN,-10,10),m2-1)))} tripdv={tdv} tripdt={tdt}

*	Flux components
Epsi_sx	psisx	0 VALUE={err0*PsiN+v(idt2)} tripdv={tdv} tripdt={tdt}
Gpsi_sx 0 idt2  VALUE={v(usx)-Rs*v(isx)+p*(2*pi)/60*v(n)*v(psisy)} tripdv={tdv} tripdt={tdt}
Cpsi_sx idt2 0 1 IC=0
Rpsi_sx idt2 0 1e10
*
Epsi_sy	psisy	0 VALUE={v(idt3)} tripdv={tdv} tripdt={tdt}
Gpsi_sy 0 idt3  VALUE={v(usy)-Rs*v(isy)-p*(2*pi)/60*v(n)*v(psisx)} tripdv={tdv} tripdt={tdt}
Cpsi_sy idt3 0 1 IC=0
Rpsi_sy idt3 0 1e10
*
Epsi_Dx	psiDx	0 VALUE={err0*psiN+v(idt4)} tripdv={tdv} tripdt={tdt}
Gpsi_Dx 0 idt4  VALUE={-RDx*v(idx)} tripdv={tdv} tripdt={tdt}
Cpsi_Dx idt4 0 1 IC=0
Rpsi_Dx idt4 0 1e10
*

Epsi_Dy	psiDy	0 VALUE={v(idt5)} tripdv={tdv} tripdt={tdt}
Gpsi_Dy 0 idt5  VALUE={-RDy*v(idy)} tripdv={tdv} tripdt={tdt}
Cpsi_Dy idt5 0 1 IC=0
Rpsi_Dy idt5 0 1e10
*
Epsi_E	psiE	0 VALUE={err0*psiN*(1+Streuung)+v(idt6)} tripdv={tdv} tripdt={tdt}
Gpsi_E 0 idt6  VALUE={v(F1,0)*g*RE_factor-RE*RE_factor*g*g*v(ie)} tripdv={tdv} tripdt={tdt} ;<--------- MATLAB compatible 
Cpsi_E idt6 0 1 IC=0
Rpsi_E idt6 0 1e10
*
Gtheta 0 theta VALUE={180/pi*atan2(v(usx),v(usy))} tripdv={tdv} tripdt={tdt}   ;Lastwinkel!!!!
Rtheta theta 0 1
Ctheta theta 0 10u
*
Emi		Mi	0	VALUE={1.5*p*(i(vphx)*v(isy)-i(vphy)*v(isx))} tripdv={tdv} tripdt={tdt}
EMoment	M 0	VALUE={-v(Mi)+v(Rbg)} tripdv={tdv} tripdt={tdt}
Rn1 n 0 1k
Vn n 0 {n1}
* friction
GRbg		0	Rbg	TABLE {v(n)} (-1,-1) (1,1)
RRbg		Rbg	0	{MN*rbg}
* Compute alpha
Gal   0       alpha  VALUE={alpha_0*pi/180+p/60*(2*pi)*n1*TIME} tripdv={tdv} tripdt={tdt}
Ral   alpha   0      1
* Compute n
*En		n	0  VALUE={n0+60/(2*pi)/J*v(idt8)} tripdv={tdv} tripdt={tdt}
*Gn 0 idt8  VALUE={v(M)*Mvz+v(Mi)-v(Rbg)} tripdv={tdv} tripdt={tdt}
*Cn idt8 0 1 IC=0
*Rn idt8 0 1e10
* Compute f
Ef      f   0  VALUE={v(n)*p/60} tripdv={tdv} tripdt={tdt}
* voltage RMS of generator
Ev Us 0 VALUE={sqrt(v(usx)*v(usx)+v(usy)*v(usy))} tripdv={tdv} tripdt={tdt}
* Xd=Xq for cylindrical pole machine Xd,Xq different for salient pole
Exd xd 0 VALUE={(v(Lhd3)+Lsd)*2*pi*fn} tripdv={tdv} tripdt={tdt} ;better measured from sliptest
Exq xq 0 VALUE={(v(Lhq3)+Lsq)*2*pi*fn} tripdv={tdv} tripdt={tdt} ;better measured from sliptest
* New added
Epsihx psihx 0 VALUE={v(psisx)-Lsd*v(isx)} tripdv={tdv} tripdt={tdt}
Epsihy psihy 0 VALUE={v(psisy)-Lsq*v(isy)} tripdv={tdv} tripdt={tdt}
Epsihx1 psihx1 0 VALUE={v(psidx)-Ldx*v(iDx)} tripdv={tdv} tripdt={tdt} ;same as pshihx
Epsihy1 psihy1 0 VALUE={v(psidy)-Ldy*v(iDy)} tripdv={tdv} tripdt={tdt} ;same as pshihy
Epsihx2 psihx2 0 VALUE={v(psie)-Le*v(ie)}  tripdv={tdv} tripdt={tdt}  ;same as pshihx
Eg  g 0 VALUE={g} tripdv={tdv} tripdt={tdt}
EU  u 0 VALUE={v(us)*sqrt(3)/sqrt(2)} tripdv={tdv} tripdt={tdt}
Ei  i 0 VALUE={0.7071*sqrt(v(isx)*v(isx)+v(isy)*v(isy))} tripdv={tdv} tripdt={tdt} 
Eap p 0 VALUE={3*(v(usx)*v(isx)/2+v(usy)*v(isy)/2)}  tripdv={tdv} tripdt={tdt}
Eaq q 0 VALUE={3*(v(usy)*v(isx)/2-v(usx)*v(isy)/2)} tripdv={tdv} tripdt={tdt}
Es  s 0 VALUE={sqrt(v(p)*v(p)+v(q)*v(q))} tripdv={tdv} tripdt={tdt}
* Other formulas for active and reactive power
Ephiu phius 0 VALUE={180/pi*atan2(v(usy),v(usx))}  tripdv={tdv} tripdt={tdt} 
Ephii phiis 0 VALUE={180/pi*atan2(v(isy),v(isx))}  tripdv={tdv} tripdt={tdt}
Ephi phi 0 VALUE={(v(phius)-v(phiis))}   tripdv={tdv} tripdt={tdt}
* Other formula for up
*Eup2 up2 0 VALUE={sqrt((v(u)-v(i)*v(xd)*sin(pi/180*v(phi)))*(v(u)-v(i)*v(xd)*sin(pi/180*v(phi)))+(v(i)*v(xd)*cos(pi/180*v(phi)))*(v(i)*v(xd)*cos(pi/180*v(phi))))}  
Eup up 0 VALUE={(v(usy)-v(isx)*v(xd))/sqrt(2)} tripdv={tdv} tripdt={tdt}
*
Ews wmagnstator 0 VALUE={1.5*0.5*(v(psisx)*v(isx)+v(psisy)*v(isy))} tripdv={tdv} tripdt={tdt}
Ewe wmagnexciter 0 VALUE={1.5*0.5*v(psie)*v(ie)} tripdv={tdv} tripdt={tdt}
Ewd wmagndamper 0 VALUE={1.5*0.5*(v(psidx)*v(idx)+v(psidy)*v(idy))}  tripdv={tdv} tripdt={tdt}
Ewsumm wmagnsum 0 VALUE={v(wmagnstator)+v(wmagndamper)+v(wmagnexciter)} tripdv={tdv} tripdt={tdt}
*
* Psum2=Psum3 P from Wmagn ( P=dWmagn/dt )
Etest Psum2 0 VALUE={v(Pstator)+v(Pexciter)+v(Pdamper)} tripdv={tdv} tripdt={tdt} 
Etest2 Psum3 0 VALUE={DDT(v(wmagnstator))+DDT(v(wmagnexciter))+DDT(v(wmagndamper))} tripdv={tdv} tripdt={tdt} 
*
EPstator Pstator  0 VALUE={1.5*(v(isx)*DDT(v(psisx)))+1.5*(v(isy)*DDT(v(psisy)))} tripdv={tdv} tripdt={tdt} 
* Exciter is fed by external unit
EPexiter Pexciter 0 VALUE={1.5*(v(ie)*DDT(v(psie)))} tripdv={tdv} tripdt={tdt}
EPdamper Pdamper 0 VALUE={1.5*(v(idx)*DDT(v(psidx))+v(idy)*DDT(v(psidy)))} tripdv={tdv} tripdt={tdt}
EPsum1 Psum1 0 VALUE={v(Pstator)+v(Pdamper)+v(Pexciter)} tripdv={tdv} tripdt={tdt}
EPsum Psum 0 VALUE={v(Psum1)+V(Pcusum)-v(Pcu3)-v(Pexciter)-V(P)+V(rbg)*omega_el/p} tripdv={tdv} tripdt={tdt}
EPM   Pmech 0 VALUE={-v(M)*omega_el/p} tripdv={tdv} tripdt={tdt}
* other formulas for theta theta2 for non salient machine and theta3 for salient machine
*Etheta2 theta2 0 VALUE={-180/pi*atan2(v(i)*v(xd)*cos(pi/180*v(phi)),(v(u)-v(i)*v(xd)*sin(pi/180*v(phi))))}  ;for round pole
*Etheta3 theta3 0 VALUE={-180/pi*atan2(v(i)*v(xq)*cos(pi/180*v(phi)),(v(u)-v(i)*v(xq)*sin(pi/180*v(phi))))}  ;for salient pole
*
* Qtsum = Qtstator + Qtdamper = -Qtexciter
EQtransf1 Qtstator 0 VALUE={1.5*(v(isx)*DDT(v(psisy))-v(isy)*DDT(v(psisx)))} tripdv={tdv} tripdt={tdt}
EQtransf2 Qtexciter 0 VALUE={1.5*(v(isx)*DDT(v(psihx)))} tripdv={tdv} tripdt={tdt}
EQtransf3 Qtdamper 0 VALUE={1.5*(v(isx)*DDT(v(psihx))+v(isy)*DDT(v(psihy)))} tripdv={tdv} tripdt={tdt}
EQtranssum Qtsum 0 VALUE={v(Qtstator)+v(Qtdamper)} tripdv={tdv} tripdt={tdt}
EQmagn1 Qrotstator 0 VALUE={1.5*omega_el*(v(isx)*v(isx)*(v(Lhd3)+Lsd)+v(isy)*v(isy)*(v(Lhq3)+Lsq))} tripdv={tdv} tripdt={tdt}
EQmagn2 Qrotexciter 0 VALUE={1.5*omega_el*(v(ie)*v(isx)*v(Lhd3))} tripdv={tdv} tripdt={tdt}
EQmagn3 Qrotdamper 0 VALUE={1.5*omega_el*(v(isx)*v(idx)*v(Lhd3)+v(idy)*v(isy)*v(Lhq3))} tripdv={tdv} tripdt={tdt}
EQexciter Qexciter 0 VALUE={v(Qrotexciter)+v(Qtexciter)}  tripdv={tdv} tripdt={tdt}
EQstator Qstator 0 VALUE={v(Qrotstator)+v(Qtstator)}  tripdv={tdv} tripdt={tdt}
EQdamper Qdamper 0 VALUE={v(Qrotdamper)+v(Qtdamper)} tripdv={tdv} tripdt={tdt}
* Qsum = Qstator + Qdamper - Qext = -Qexciter 
EQsum Qsum 0 VALUE={v(Qstator)+v(Qdamper)-V(Q)} tripdv={tdv} tripdt={tdt}
.ENDS

* fixerregung ein / avr aus
* drehzahlregler ein / fixm aus
*
.SUBCKT DSG_12KW_400V_400V_mit_Trafo 1U2 1V2 1W2 Verr1 M1 n GND1
+ PARAMS: Schenkelpolfaktor=1 Daempferfaktor=1 Streuung=0.05 rcu=0.05 rbg=0.05 n0=1500 p=2
+ nsoll=1500 vsoll=400 n_kp=1 n_Tn=0.1 f1_kp=1 f1_Tn=0.05 a=0.9 m=11 kc=0.5 err0=0 RE_factor=1
+ t_start_avr=1s t_stop_avr=1e6 t_start_fixerr=1e6 t_stop_fixerr=1.1s t_stop_nreg=1e5 t_start_nreg=1e6 t_start_fixm=1e5 t_stop_fixm=1e6
+ t_sync=0ms t_sync_off=1e6 t_enable_avr=1.5s  t_enablev_avr=0.51s t_start_gnd2=10e6 t_stop_gnd2=1e6
.param J=1 UN_verkettet=400V IN=21 UE0=48V IE0=5A Pel=12e3
*************
* Generator *
*************
RM1  M1  0  1e10
XU1 u2 v2 w2 verr M n GND1 Block1 J={J} UN_verkettet={UN_verkettet} IN={IN} Kc={Kc} UE0={UE0} IE0={IE0} Pel={Pel} Schenkelpolfaktor={Schenkelpolfaktor} Daempferfaktor={Daempferfaktor} Streuung={Streuung} rcu={rcu} rbg={rbg} n0={n0} a={a} m={m} err0={err0} RE_factor={RE_factor}; <--------- MATLAB compatible 
XU3 GND1 0 SW_1Phase_off_1a t_Stop={t_stop_gnd2} t_Start={t_start_gnd2} tsw=100u ron=0.01 roff=1e9
***************
* Transformer nearly without lost
***************
XU8 1u1 1v1 1w1 NC_01 u2 v2 w2 NC_02 Trafo3Yy6_1a SN=15k U1Nenn=400V U20=400V ur=0.0001 ux=0.001 i0=0.0005 p0=0.00001 l_=0 stproz=1 middle=0 psi_0=0 tpsi0=1000 tpsid=0.1m ron=0.00001
***************
* Sync-Schalter
***************
XU10 1u1 1v1 1w1 1u2 1v2 1w2 SW_3Phase_1a t_Start={t_sync} t_Stop={t_sync_off} tsw=100u ron=0.01 roff=1e9
********************
* Drehzahlregler PI
********************
XU2 n nsoll M2 en2 PI_1a Kp={n_Kp} Tn={n_Tn} Min=0 Max=90 init=0
ven2 en2 0 pwl 0s 1 {t_stop_nreg} 1 {t_stop_nreg+100m} 0 {t_Start_nreg} 0 {t_Start_nreg+100m} 1
vpwl  nsoll 0 pwl 0s {nsoll} 3s {nsoll}
* Zu Drehzahlregler
XU12 M M2 SW_1Phase_off_1a t_Stop={t_stop_nreg} t_Start={t_start_nreg} tsw=100u ron=0.01 roff=1e9
* Fixes Drehmoment von aussen (Schalter und pwl-Source)
XU6 M M1 SW_1Phase_1a t_Start={t_start_fixm} t_Stop={t_stop_fixm} tsw=100u ron=0.01 roff=1e9
*******
* AVR
*******
XU19 u2 v2 w2 vsoll verr2 en1 enV avr_1a Kp={f1_Kp} Tn={f1_Tn} Min=24 Max=120 U1Nenn={UN_verkettet} tripdt2=100n verr0=48V vfactor=sqrt(3)
ven1 en1 0 pwl 0s 0v {t_enable_avr} 0v {t_enable_avr+100m} 1
venV enV 0 pwl 0s 0v {t_enablev_avr} 0v {t_enablev_avr+100m} 1
vsoll vsoll 0 pwl 0s {vsoll}
XU20 verr verr2 SW_1Phase_1a t_Start={t_start_avr} t_Stop={t_stop_avr} tsw=100u ron=0.01m roff=1e9
* fixe Erregung von aussen (Schalter und pwl-source)
XU21 verr verr1 SW_1Phase_off_1a t_Stop={t_stop_fixerr} t_Start={t_start_fixerr} tsw=100u ron=0.01m roff=1e9
.ENDS

* fixerregung ein / avr aus
* drehzahlregler ein / fixm aus
*
.SUBCKT DSG_12kW_400V_400V_ohne_Trafo 1U2 1V2 1W2 Verr1 M1 n GND1
+ PARAMS: Schenkelpolfaktor=1 Daempferfaktor=1 Streuung=0.05 rcu=0.05 rbg=0.05 n0=1500 p=2
+ nsoll=1500 vsoll=400 n_kp=1 n_Tn=0.1 f1_kp=1 f1_Tn=0.05 a=0.9 m=11 kc=0.5 err0=0 RE_factor=1
+ t_start_avr=1s t_stop_avr=1e6 t_start_fixerr=1e6 t_stop_fixerr=1.1s t_stop_nreg=1e5 t_start_nreg=1e6 t_start_fixm=1e5 t_stop_fixm=1e6
+ t_enable_avr=1.5s  t_enablev_avr=0.51s t_start_gnd2=10e6 t_stop_gnd2=1e6
.param J=1 UN_verkettet=400V IN=21 Kc=0.5 UE0=48V IE0=5A Pel=12e3
*************
* Generator *
*************
RM1  M1  0  1e10
XU1 u2 v2 w2 verr M n GND1 Block1 J={J} UN_verkettet={UN_verkettet} IN={IN} Kc={Kc} UE0={UE0} IE0={IE0} Pel={Pel} Schenkelpolfaktor={Schenkelpolfaktor} Daempferfaktor={Daempferfaktor} Streuung={Streuung} rcu={rcu} rbg={rbg} n0={n0} a={a} m={m} err0={err0} RE_factor={RE_factor}; <--------- MATLAB compatible 
XU3 GND1 0 SW_1Phase_off_1a t_Stop={t_stop_gnd2} t_Start={t_start_gnd2} tsw=100u ron=0.01 roff=1e9
********************
* Drehzahlregler PI
********************
XU2 n nsoll M2 en2 PI_1a Kp={n_Kp} Tn={n_Tn} Min=0 Max=90 init=0
ven2 en2 0 pwl 0s 1 {t_stop_nreg} 1 {t_stop_nreg+100m} 0 {t_Start_nreg} 0 {t_Start_nreg+100m} 1
vpwl  nsoll 0 pwl 0s {nsoll} 3s {nsoll}
* Zu Drehzahlregler
XU12 M M2 SW_1Phase_off_1a t_Stop={t_stop_nreg} t_Start={t_start_nreg} tsw=100u ron=0.01 roff=1e9
* Fixes Drehmoment von aussen (Schalter und pwl-Source)
XU6 M M1 SW_1Phase_1a t_Start={t_start_fixm} t_Stop={t_stop_fixm} tsw=100u ron=0.01 roff=1e9
*******
* AVR
*******
XU19 u2 v2 w2 vsoll verr2 en1 enV avr_1a Kp={f1_Kp} Tn={f1_Tn} Min=24 Max=120 U1Nenn={UN_verkettet} tripdt2=100n verr0=48V vfactor=sqrt(3)
ven1 en1 0 pwl 0s 0v {t_enable_avr} 0v {t_enable_avr+100m} 1
venV enV 0 pwl 0s 0v {t_enablev_avr} 0v {t_enablev_avr+100m} 1
vsoll vsoll 0 pwl 0s {vsoll}
XU20 verr verr2 SW_1Phase_1a t_Start={t_start_avr} t_Stop={t_stop_avr} tsw=100u ron=0.01m roff=1e9
* fixe Erregung von aussen (Schalter und pwl-source)
XU21 verr verr1 SW_1Phase_off_1a t_Stop={t_stop_fixerr} t_Start={t_start_fixerr} tsw=100u ron=0.01m roff=1e9
.ENDS

* without measurement nodes
.SUBCKT sgen_12kW U1 V1 W1  F1  M  n GND1
+	PARAMS:
+	UN_verkettet=400V
+	IN=21A
+	Pel=12kW  ;UN_verkettet*IN*sqrt(3)*cosphi of 0.8
+	fn={fn1}
+	Kc=0.5
+	UE0=48V ; Power of exciter = 0.25-5% * SN machine (smaller values for higher SN)
+	IE0=5A
+	p=2
+	Streuung=0.05
+	rcu=0.05
+	rbg=0.05
+	Schenkelpolfaktor=1 ;(1=cylindrical pole 0.5=Salient pole)
+	Daempferfaktor=1
+	err0=0 RE_factor=0.6666 ;Matlab compatible with RE_factor=2/3=0.6666
+   n0=1500
+   alpha_0=0
+   taumech=2.3  ; parameter for inertia J={p*taumech*MN/omega_el} =2*2.3*76/(2*pi*fn)=1.12  MN=Pel*p/omega=12000*2/(2*pi*fn)=76
+  a=0.9
+  m=7
+   Mvz=1
.PARAM
+   a1={a};  Saturation parameter d-axis
+   m1={m};  Saturation parameter d-axis
+   a2={a1}; Saturation parameter q-axis ( default: same as d-axis -> may be overwritten if different from d-axis )
+   m2={m1}; Saturation parameter q-axis ( default: same as d-axis -> may be overwritten if different from d-axis )
+	UN={UN_verkettet/sqrt(3)}
+	ZN={UN/IN}
+	Rs={ZN*rcu}
+	omega_el={(2*pi)*fN}
+	Ls={Streuung*ZN/Kc/omega_el}
+	PsiN={sqrt(2)*UN/omega_el}
+	RE={UE0/IE0}
+	RD={Rs/Daempferfaktor}
+   RDx={RD} ; can be overwritten by setting this parameters directly here to a numerical value
+   RDy={RD} ; can be overwritten by setting this parameters directly here to a numerical value
+   LDx={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+   LDy={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+   LE={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+   R0={Rs} ; can be overwritten by setting this parameters directly here to a numerical value
+   L0={Ls} ; can be overwritten by setting this parameters directly here to a numerical value(X0 is 0.03-0.1 p.u)
+   Lsd={Ls} 
+   Lsq={Ls}
+   XD={UN/IN/Kc}
+   XQ={XD*Schenkelpolfaktor}
+   g={UE0/(UN*sqrt(2)*RE/(XD-omega_el*Lsd))} ; updated formula for g parameter
+   g1={UE0/(UN*sqrt(2)*RE/(XQ-omega_el*Lsq))} ; updated formula for salient pole machine
+	ImNx={IE0/g} ; d-axis magnetizing current
+	ImNy={IE0/g1} ;q-axis magnetizing current
+	MN={Pel*(1-rbg-rcu)*p/omega_el}
+   J= {p*taumech*MN/omega_el}
+  Lhd3={XD/(2*pi*fn)-Lsd}
+  Lhq3={XQ/(2*pi*fn)-Lsq}
*	Wicklungsstroeme
*	Wicklungsstroeme
Rf1 f1 0 1e12
Rm  m  0 1e12
Rn2  n  0 1e12
*	currents of windings
G1	U1	U2	VALUE={v(isxS)+v(i_Null)} tripdv={tdv} tripdt={tdt}
G2	V1	V2	VALUE={(-v(isxS)+v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
G3	W1	W2	VALUE={(-v(isxS)-v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
GiE	F1	0	VALUE={v(ie)*g} tripdv={tdv} tripdt={tdt}
*	voltage components
EuxS	usxS	0	VALUE={(2*v(u1,u2)-v(v1,v2)-v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
EuyS	usyS	0	VALUE={(v(v1,v2)-v(w1,w2))/sqrt(3)} tripdv={tdv} tripdt={tdt}
Eux	usx	0	VALUE={ v(usxS)*cos(v(alpha))+v(usyS)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
Euy	usy	0	VALUE={-v(usxS)*sin(v(alpha))+v(usyS)*cos(v(alpha))} tripdv={tdv} tripdt={tdt}
*    Starpoint
R2     v2    GND1   1u
R12    u2    GND1   1u
R23    w2    GND1   1u
RGND1  GND1  0  1e6
ErefL1 Uref_L1 0 VALUE={-sqrt(2)*UN*sin(2*pi*(fN*(TIME)))} tripdv={tdv} tripdt={tdt}
*	Nullsystem
Eu0	u_Null 0	VALUE={(v(u1,u2)+v(v1,v2)+v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
Ei0	i_Null 0	VALUE={v(idt1)/L0} tripdv={tdv} tripdt={tdt}
Gi0 0 idt1  VALUE={v(u_Null)-R0*v(i_null)} tripdv={tdv} tripdt={tdt}
Ci0 idt1 0 1 IC=0
Ri0 idt1 0 1e10
*	current components
EisxS		isxS	0 VALUE={v(isx)*cos(v(alpha))-v(isy)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
EisyS		isyS	0 VALUE={v(isy)*cos(v(alpha))+v(isx)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of direct axis with saturation
Gpsix		0	isx	VALUE={v(psisx)} tripdv={tdv} tripdt={tdt}
Rsx		isx	0	{1/Lsd}
Gpsidx	isx	iDx1	VALUE={v(psiDx)} tripdv={tdv} tripdt={tdt} ; *********
Rsdx		iDx1	isx	{1/LDx}
GpsiEx	iDx1	imx1	VALUE={v(psiE)} tripdv={tdv} tripdt={tdt} ; ie oder if ist iDx,imx !!!!
RsEx		imx1	iDx1	{1/LE}
vphx		imx1	imxa1	0
Eimx1		imxa1	0	VALUE={ImNx*(a1*i(vphx)/PsiN+(1-a1)*PWRS(i(vphx)/PsiN,m1))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of quadrature axis with saturation
Gpsiy		0	isy	VALUE={v(psisy)} tripdv={tdv} tripdt={tdt}
Rsy		isy	0	{1/Lsq}
Gpsidy	isy	imy1	VALUE={v(psiDy)} tripdv={tdv} tripdt={tdt}
Rsdy		imy1	isy	{1/LDy}
vphy		imy1	imya1	0
Eimy1		imya1	0	VALUE={ImNy*(a2*i(vphy)/PsiN+(1-a2)*PWRS(i(vphy)/PsiN,m2))} tripdv={tdv} tripdt={tdt}
*
Eidx  idx 0 VALUE={v(idx1)-v(isx)} tripdv={tdv} tripdt={tdt}
Eidy  idy 0 VALUE={v(imy1)-v(isy)} tripdv={tdv} tripdt={tdt}
Eie ie 0 VALUE={v(imx1)-v(idx1)} tripdv={tdv} tripdt={tdt}
Eimx imx 0 VALUE={v(isx)+v(idx)+v(ie)} tripdv={tdv} tripdt={tdt};magnetizing current d-axes
Eimy imy 0 VALUE={v(isy)+v(idy)}       tripdv={tdv} tripdt={tdt};magnetizing current q-axes
*	Flux components
Epsi_sx	psisx	0 VALUE={err0*PsiN+v(idt2)} tripdv={tdv} tripdt={tdt}
Gpsi_sx 0 idt2  VALUE={v(usx)-Rs*v(isx)+p*(2*pi)/60*v(n)*v(psisy)} tripdv={tdv} tripdt={tdt}
Cpsi_sx idt2 0 1 IC=0
Rpsi_sx idt2 0 1e10
*
Epsi_sy	psisy	0 VALUE={v(idt3)} tripdv={tdv} tripdt={tdt}
Gpsi_sy 0 idt3  VALUE={v(usy)-Rs*v(isy)-p*(2*pi)/60*v(n)*v(psisx)} tripdv={tdv} tripdt={tdt}
Cpsi_sy idt3 0 1 IC=0
Rpsi_sy idt3 0 1e10
*
Epsi_Dx	psiDx	0 VALUE={err0*psiN+v(idt4)} tripdv={tdv} tripdt={tdt}
Gpsi_Dx 0 idt4  VALUE={-RDx*v(idx)} tripdv={tdv} tripdt={tdt}
Cpsi_Dx idt4 0 1 IC=0
Rpsi_Dx idt4 0 1e10
*

Epsi_Dy	psiDy	0 VALUE={v(idt5)} tripdv={tdv} tripdt={tdt}
Gpsi_Dy 0 idt5  VALUE={-RDy*v(idy)} tripdv={tdv} tripdt={tdt}
Cpsi_Dy idt5 0 1 IC=0
Rpsi_Dy idt5 0 1e10
*
Epsi_E	psiE	0 VALUE={err0*psiN*(1+Streuung)+v(idt6)} tripdv={tdv} tripdt={tdt}
Gpsi_E 0 idt6  VALUE={v(F1,0)*g*RE_factor-RE*RE_factor*g*g*v(ie)} tripdv={tdv} tripdt={tdt} ;<--------- MATLAB compatible 
Cpsi_E idt6 0 1 IC=0
Rpsi_E idt6 0 1e10
*
*
Emi		Mi	0	VALUE={1.5*p*(i(Vphx)*v(isy)-i(Vphy)*v(isx))} tripdv={tdv} tripdt={tdt}
*Emi		Mi	0	VALUE={1.5*p*(v(psihx)*v(isy)-v(psihy)*v(isx))} tripdv={tdv} tripdt={tdt}
*Emi		Mi	0	VALUE={1.5*p*(v(psihx)*v(isy)-v(psihy)*v(isx))} tripdv={tdv} tripdt={tdt}
*EMoment	M 0	VALUE={-v(Mi)+v(Rbg)} tripdv={tdv} tripdt={tdt}
*En    n  0  Value={N1} tripdv={tdv} tripdt={tdt}
* Berechner n
* Compute n
En		n	0  VALUE={n0+60/(2*pi)/J*v(idt8)} tripdv={tdv} tripdt={tdt}
Gn 0 idt8  VALUE={v(M)*Mvz+v(Mi)-v(Rbg)} tripdv={tdv} tripdt={tdt}
Cn idt8 0 1 IC=0
Rn idt8 0 1e10
* friction
GRbg		0	Rbg	TABLE {v(n)} (-1,-1) (1,1)
RRbg		Rbg	0	{MN*rbg}
* Compute alpha
Ealpha	alpha	0	VALUE={alpha_0*pi/180+v(idt7)*p/60*(2*pi)} tripdv={tdv} tripdt={tdt}
Galpha 0 idt7  VALUE={v(n)} tripdv={tdv} tripdt={tdt}
Calpha idt7 0 1 IC=0
Ralpha idt7 0 1e10
*
Gtheta 0 theta VALUE={180/pi*atan2(v(usx),v(usy))} tripdv={tdv} tripdt={tdt}   ;Lastwinkel!!!!
Rtheta theta 0 1
Ctheta theta 0 10u
.ENDS 

* without measurement nodes
.SUBCKT Sgen_12kW_constant_speed U1 V1 W1  F1  M  n GND1
+	PARAMS:
+	UN_verkettet=400V
+	IN=21A
+	Pel=12kW  ;UN_verkettet*IN*sqrt(3)*cosphi of 0.8
+	fn={fn1}
+	Kc=0.5
+	UE0=48V ; Power of exciter = 0.25-5% * SN machine (smaller values for higher SN)
+	IE0=5A
+	p=2
+	Streuung=0.05
+	rcu=0.05
+	rbg=0.05
+	Schenkelpolfaktor=1 ;(1=cylindrical pole 0.5=Salient pole)
+	Daempferfaktor=1
+	err0=0 RE_factor=0.6666 ;Matlab compatible with RE_factor=2/3=0.6666
+   n0=1500
+	n1={n0}
+	t_anlauf=2m
+	t_auslauf=2
+	t_betrieb=2000
+	n_Turbine={n1}
+   alpha_0=0
+   a=0.9 ; Parameter for nonlinear noload line (should be about 0.6-0.9)
+   m=7
.PARAM
+   a1={a};  Saturation parameter d-axis
+   m1={m};  Saturation parameter d-axis
+   a2={a1}; Saturation parameter q-axis
+   m2={m1}; Saturation parameter q-axis
+	UN={UN_verkettet/sqrt(3)}
+	ZN={UN/IN}
+	Rs={ZN*rcu}
+	omega_el={(2*pi)*fN}
+	Ls={Streuung*ZN/Kc/omega_el}
+	PsiN={sqrt(2)*UN/omega_el}
+	RE={UE0/IE0}
+	RD={Rs/Daempferfaktor}
+   RDx={RD} ; can be overwritten by setting this parameters on modelline
+   RDy={RD} ; can be overwritten by setting this parameters on modelline
+   LDx={Ls} ; can be overwritten by setting this parameters on modelline
+   LDy={Ls} ; can be overwritten by setting this parameters on modelline
+   LE={Ls} ; can be overwritten by setting this parameters on modelline
+   R0={Rs} ; can be overwritten by setting this parameters on modelline
+   L0={Ls} ; can be overwritten by setting this parameters on modelline (X0 is 0.03-0.1 p.u)
+   Lsd={Ls}
+   Lsq={Ls}
+   XD={UN/IN/Kc}
+   XQ={XD*Schenkelpolfaktor}
+   g={UE0/(UN*sqrt(2)*RE/(XD-omega_el*Lsd))} ; updated formula for g parameter
+   g1={UE0/(UN*sqrt(2)*RE/(XQ-omega_el*Lsq))} ; updated formula salient pole machines
+	ImNx={IE0/g} ; d-axis magnetizing current
+	ImNy={IE0/g1} ;q-axis magnetizing current
+	MN={Pel*(1-rbg-rcu)*p/omega_el}
+  Lhd3={XD/(2*pi*fn)-Lsd}
+  Lhq3={XQ/(2*pi*fn)-Lsq}
Rf1 f1 0 1e12
Rm  m  0 1e12
Rn2  n  0 1e12
*	currents of windings
G1	U1	U2	VALUE={v(isxS)+v(i_Null)} tripdv={tdv} tripdt={tdt}
G2	V1	V2	VALUE={(-v(isxS)+v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
G3	W1	W2	VALUE={(-v(isxS)-v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
GiE	F1	0	VALUE={v(ie)*g} tripdv={tdv} tripdt={tdt}
*	voltage components
EuxS	usxS	0	VALUE={(2*v(u1,u2)-v(v1,v2)-v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
EuyS	usyS	0	VALUE={(v(v1,v2)-v(w1,w2))/sqrt(3)} tripdv={tdv} tripdt={tdt}
Eux	usx	0	VALUE={ v(usxS)*cos(v(alpha))+v(usyS)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
Euy	usy	0	VALUE={-v(usxS)*sin(v(alpha))+v(usyS)*cos(v(alpha))} tripdv={tdv} tripdt={tdt}
*    Starpoint
R2     v2    GND1   1u
R12    u2    GND1   1u
R23    w2    GND1   1u
RGND1  GND1  0  1e6
ErefL1 Uref_L1 0 VALUE={-sqrt(2)*UN*sin(2*pi*(fN*(TIME)))} tripdv={tdv} tripdt={tdt}
*	Nullsystem
Eu0	u_Null 0	VALUE={(v(u1,u2)+v(v1,v2)+v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
Ei0	i_Null 0	VALUE={v(idt1)/L0} tripdv={tdv} tripdt={tdt}
Gi0 0 idt1  VALUE={v(u_Null)-R0*v(i_null)} tripdv={tdv} tripdt={tdt}
Ci0 idt1 0 1 IC=0
Ri0 idt1 0 1e10
*	current components
EisxS		isxS	0 VALUE={v(isx)*cos(v(alpha))-v(isy)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
EisyS		isyS	0 VALUE={v(isy)*cos(v(alpha))+v(isx)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of direct axis with saturation
Gpsix		0	isx	VALUE={v(psisx)} tripdv={tdv} tripdt={tdt}
Rsx		isx	0	{1/Lsd}
Gpsidx	isx	iDx1	VALUE={v(psiDx)} tripdv={tdv} tripdt={tdt} ; *********
Rsdx		iDx1	isx	{1/LDx}
GpsiEx	iDx1	imx1	VALUE={v(psiE)} tripdv={tdv} tripdt={tdt} ; ie oder if ist iDx,imx !!!!
RsEx		imx1	iDx1	{1/LE}
vphx		imx1	imxa1	0
Eimx1		imxa1	0	VALUE={ImNx*(a1*i(vphx)/PsiN+(1-a1)*PWRS(i(vphx)/PsiN,m1))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of quadrature axis with saturation
Gpsiy		0	isy	VALUE={v(psisy)} tripdv={tdv} tripdt={tdt}
Rsy		isy	0	{1/Lsq}
Gpsidy	isy	imy1	VALUE={v(psiDy)} tripdv={tdv} tripdt={tdt}
Rsdy		imy1	isy	{1/LDy}
vphy		imy1	imya1	0
Eimy1		imya1	0	VALUE={ImNy*(a2*i(vphy)/PsiN+(1-a2)*PWRS(i(vphy)/PsiN,m2))} tripdv={tdv} tripdt={tdt}
*
Eidx  idx 0 VALUE={v(idx1)-v(isx)} tripdv={tdv} tripdt={tdt}
Eidy  idy 0 VALUE={v(imy1)-v(isy)} tripdv={tdv} tripdt={tdt}
Eie ie 0 VALUE={v(imx1)-v(idx1)} tripdv={tdv} tripdt={tdt}
Eimx imx 0 VALUE={v(isx)+v(idx)+v(ie)} tripdv={tdv} tripdt={tdt};magnetizing current d-axes
Eimy imy 0 VALUE={v(isy)+v(idy)}       tripdv={tdv} tripdt={tdt};magnetizing current q-axes
*	Flux components
Epsi_sx	psisx	0 VALUE={err0*PsiN+v(idt2)} tripdv={tdv} tripdt={tdt}
Gpsi_sx 0 idt2  VALUE={v(usx)-Rs*v(isx)+p*(2*pi)/60*v(n)*v(psisy)} tripdv={tdv} tripdt={tdt}
Cpsi_sx idt2 0 1 IC=0
Rpsi_sx idt2 0 1e10
*
Epsi_sy	psisy	0 VALUE={v(idt3)} tripdv={tdv} tripdt={tdt}
Gpsi_sy 0 idt3  VALUE={v(usy)-Rs*v(isy)-p*(2*pi)/60*v(n)*v(psisx)} tripdv={tdv} tripdt={tdt}
Cpsi_sy idt3 0 1 IC=0
Rpsi_sy idt3 0 1e10
*
Epsi_Dx	psiDx	0 VALUE={err0*psiN+v(idt4)} tripdv={tdv} tripdt={tdt}
Gpsi_Dx 0 idt4  VALUE={-RDx*v(idx)} tripdv={tdv} tripdt={tdt}
Cpsi_Dx idt4 0 1 IC=0
Rpsi_Dx idt4 0 1e10
*

Epsi_Dy	psiDy	0 VALUE={v(idt5)} tripdv={tdv} tripdt={tdt}
Gpsi_Dy 0 idt5  VALUE={-RDy*v(idy)} tripdv={tdv} tripdt={tdt}
Cpsi_Dy idt5 0 1 IC=0
Rpsi_Dy idt5 0 1e10
*
Epsi_E	psiE	0 VALUE={err0*psiN*(1+Streuung)+v(idt6)} tripdv={tdv} tripdt={tdt}
Gpsi_E 0 idt6  VALUE={v(F1,0)*g*RE_factor-RE*RE_factor*g*g*v(ie)} tripdv={tdv} tripdt={tdt} ;<--------- MATLAB compatible 
Cpsi_E idt6 0 1 IC=0
Rpsi_E idt6 0 1e10
*
Gtheta 0 theta VALUE={180/pi*atan2(v(usx),v(usy))} tripdv={tdv} tripdt={tdt}   ;Lastwinkel!!!!
Rtheta theta 0 1
Ctheta theta 0 10u
*
Emi		Mi	0	VALUE={1.5*p*(i(vphx)*v(isy)-i(vphy)*v(isx))} tripdv={tdv} tripdt={tdt}
EMoment	M 0	VALUE={-v(Mi)+v(Rbg)} tripdv={tdv} tripdt={tdt}
Rn1 n 0 1k
Vn n 0 {n1}
* friction
GRbg		0	Rbg	TABLE {v(n)} (-1,-1) (1,1)
RRbg		Rbg	0	{MN*rbg}
* Compute alpha
Gal   0       alpha  VALUE={alpha_0*pi/180+p/60*(2*pi)*n1*TIME} tripdv={tdv} tripdt={tdt}
Ral   alpha   0      1
.ENDS

.SUBCKT Sgen_12kW_constant_speed_type1 U1 V1 W1  F1  M  n GND1
+	PARAMS:
+	UN_verkettet=400V
+	IN=21A
+	Pel=12kW  ;UN_verkettet*IN*sqrt(3)*cosphi of 0.8
+	fn={fn1}
+	Kc=0.5
+	UE0=48V ; Power of exciter = 0.25-5% * SN machine (smaller values for higher SN)
+	IE0=5A
+	p=2
+	Streuung=0.05
+	rcu=0.05
+	rbg=0.05
+	Schenkelpolfaktor=1 ;(1=cylindrical pole 0.5=Salient pole)
+	Daempferfaktor=1
+	err0=0 RE_factor=0.6666 ;Matlab compatible with RE_factor=2/3=0.6666
+   n0=1500
+	n1={n0}
+	t_anlauf=2m
+	t_auslauf=2
+	t_betrieb=2000
+	n_Turbine={n1}
+   alpha_0=0
+   a=0.9 ; Parameter for nonlinear noload line (should be about 0.6-0.9)
+   m=7
.PARAM
+   a1={a};  Saturation parameter d-axis
+   m1={m};  Saturation parameter d-axis
+   a2={a1}; Saturation parameter q-axis
+   m2={m1}; Saturation parameter q-axis
+	UN={UN_verkettet/sqrt(3)}
+	ZN={UN/IN}
+	Rs={ZN*rcu}
+	omega_el={(2*pi)*fN}
+	Ls={Streuung*ZN/Kc/omega_el}
+	PsiN={sqrt(2)*UN/omega_el}
+	RE={UE0/IE0}
+	RD={Rs/Daempferfaktor}
+   RDx={RD} ; can be overwritten by setting this parameters on modelline
+   RDy={RD} ; can be overwritten by setting this parameters on modelline
+   LDx={Ls} ; can be overwritten by setting this parameters on modelline
+   LDy={Ls} ; can be overwritten by setting this parameters on modelline
+   LE={Ls} ; can be overwritten by setting this parameters on modelline
+   R0={Rs} ; can be overwritten by setting this parameters on modelline
+   L0={Ls} ; can be overwritten by setting this parameters on modelline (X0 is 0.03-0.1 p.u)
+   Lsd={Ls}
+   Lsq={Ls}
+   XD={UN/IN/Kc}
+   XQ={XD*Schenkelpolfaktor}
+   g={UE0/(UN*sqrt(2)*RE/(XD-omega_el*Lsd))} ; updated formula for g parameter
+   g1={UE0/(UN*sqrt(2)*RE/(XQ-omega_el*Lsq))} ; updated formula salient pole machines
+	ImNx={IE0/g} ; d-axis magnetizing current
+	ImNy={IE0/g1} ;q-axis magnetizing current
+	MN={Pel*(1-rbg-rcu)*p/omega_el}
+  Lhd3={XD/(2*pi*fn)-Lsd}
+  Lhq3={XQ/(2*pi*fn)-Lsq}
Rf1 f1 0 1e12
Rm  m  0 1e12
Rn2  n  0 1e12
Eun un 0 VALUE={Un} tripdv={tdv} tripdt={tdt}
Ein in 0 VALUE={In} tripdv={tdv} tripdt={tdt}
Esn sn 0 VALUE={3*Un*In} tripdv={tdv} tripdt={tdt}
Epn pn 0 VALUE={pel} tripdv={tdv} tripdt={tdt}
Ecosphin cosphi 0 VALUE={pel/(3*Un*In)} tripdv={tdv} tripdt={tdt}
Ezn zn 0 VALUE={Zn} tripdv={tdv} tripdt={tdt}
Ers rs 0 VALUE={Rs} tripdv={tdv} tripdt={tdt}
* New
Epcu pcu 0 VALUE={3*v(i)*v(i)*Rs} tripdv={tdv} tripdt={tdt}
* Pcu1 same as Pcu
*Epcu1 pcu1 0 VALUE={1.5*Rs*(v(isx)*v(isx)+v(isy)*v(isy))} tripdv={tdv} tripdt={tdt}
Epcu2 pcu2 0 VALUE={v(idx)*v(idx)*RDx+v(idy)*v(idy)*RDy} tripdv={tdv} tripdt={tdt}
* This loss is fed by the external exciter !!!! Pcu_exciter=UE*IE
Epcu3 pcu3 0 VALUE={v(ie)*v(ie)*g*g*Re*RE_factor} tripdv={tdv} tripdt={tdt}
Epcusum pcusum 0 VALUE={v(pcu)+v(pcu2)+v(pcu3)} tripdv={tdv} tripdt={tdt}
*	currents of windings
G1	U1	U2	VALUE={v(isxS)+v(i_Null)} tripdv={tdv} tripdt={tdt}
G2	V1	V2	VALUE={(-v(isxS)+v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
G3	W1	W2	VALUE={(-v(isxS)-v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
GiE	F1	0	VALUE={v(ie)*g} tripdv={tdv} tripdt={tdt}
*	voltage components
EuxS	usxS	0	VALUE={(2*v(u1,u2)-v(v1,v2)-v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
EuyS	usyS	0	VALUE={(v(v1,v2)-v(w1,w2))/sqrt(3)} tripdv={tdv} tripdt={tdt}
Eux	usx	0	VALUE={ v(usxS)*cos(v(alpha))+v(usyS)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
Euy	usy	0	VALUE={-v(usxS)*sin(v(alpha))+v(usyS)*cos(v(alpha))} tripdv={tdv} tripdt={tdt}
*    Starpoint
R2     v2    GND1   1u
R12    u2    GND1   1u
R23    w2    GND1   1u
RGND1  GND1  0  1e6
ErefL1 Uref_L1 0 VALUE={-sqrt(2)*UN*sin(2*pi*(fN*(TIME)))} tripdv={tdv} tripdt={tdt}
*	Nullsystem
Eu0	u_Null 0	VALUE={(v(u1,u2)+v(v1,v2)+v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
Ei0	i_Null 0	VALUE={v(idt1)/L0} tripdv={tdv} tripdt={tdt}
Gi0 0 idt1  VALUE={v(u_Null)-R0*v(i_null)} tripdv={tdv} tripdt={tdt}
Ci0 idt1 0 1 IC=0
Ri0 idt1 0 1e10
*
*	current components
EisxS		isxS	0 VALUE={v(isx)*cos(v(alpha))-v(isy)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
EisyS		isyS	0 VALUE={v(isy)*cos(v(alpha))+v(isx)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of direct axis with saturation
Gpsix		0	isx	VALUE={v(psisx)} tripdv={tdv} tripdt={tdt}
Rsx		isx	0	{1/Lsd}
Gpsidx	isx	iDx1	VALUE={v(psiDx)} tripdv={tdv} tripdt={tdt} ; *********
Rsdx		iDx1	isx	{1/LDx}
GpsiEx	iDx1	imx1	VALUE={v(psiE)} tripdv={tdv} tripdt={tdt} ; ie oder if ist iDx,imx !!!!
RsEx		imx1	iDx1	{1/LE}
vphx		imx1	imxa1	0
Eimx1		imxa1	0	VALUE={ImNx*(a1*i(vphx)/PsiN+(1-a1)*PWRS(i(vphx)/PsiN,m1))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of quadrature axis with saturation
Gpsiy		0	isy	VALUE={v(psisy)} tripdv={tdv} tripdt={tdt}
Rsy		isy	0	{1/Lsq}
Gpsidy	isy	imy1	VALUE={v(psiDy)} tripdv={tdv} tripdt={tdt}
Rsdy		imy1	isy	{1/LDy}
vphy		imy1	imya1	0
Eimy1		imya1	0	VALUE={ImNy*(a2*i(vphy)/PsiN+(1-a2)*PWRS(i(vphy)/PsiN,m2))} tripdv={tdv} tripdt={tdt}
*
Eidx  idx 0 VALUE={v(idx1)-v(isx)} tripdv={tdv} tripdt={tdt}
Eidy  idy 0 VALUE={v(imy1)-v(isy)} tripdv={tdv} tripdt={tdt}
Eie ie 0 VALUE={v(imx1)-v(idx1)} tripdv={tdv} tripdt={tdt}
Eimx imx 0 VALUE={v(isx)+v(idx)+v(ie)} tripdv={tdv} tripdt={tdt};magnetizing current d-axes
Eimy imy 0 VALUE={v(isy)+v(idy)}       tripdv={tdv} tripdt={tdt};magnetizing current q-axes

* nonlinear magnetics
Elhd3 Lhd3 0 VALUE={Lhd3*(1/(a1+(1-a1)*PWRS(LIMIT(abs(v(psihx)+1p)/PsiN,-10,10),m1-1)))} tripdv={tdv} tripdt={tdt}
Elhq3 Lhq3 0 VALUE={Lhq3*(1/(a2+(1-a2)*PWRS(LIMIT(abs(v(psihy)+1p)/PsiN,-10,10),m2-1)))} tripdv={tdv} tripdt={tdt}

*	Flux components
Epsi_sx	psisx	0 VALUE={err0*PsiN+v(idt2)} tripdv={tdv} tripdt={tdt}
Gpsi_sx 0 idt2  VALUE={v(usx)-Rs*v(isx)+p*(2*pi)/60*v(n)*v(psisy)} tripdv={tdv} tripdt={tdt}
Cpsi_sx idt2 0 1 IC=0
Rpsi_sx idt2 0 1e10
*
Epsi_sy	psisy	0 VALUE={v(idt3)} tripdv={tdv} tripdt={tdt}
Gpsi_sy 0 idt3  VALUE={v(usy)-Rs*v(isy)-p*(2*pi)/60*v(n)*v(psisx)} tripdv={tdv} tripdt={tdt}
Cpsi_sy idt3 0 1 IC=0
Rpsi_sy idt3 0 1e10
*
Epsi_Dx	psiDx	0 VALUE={err0*psiN+v(idt4)} tripdv={tdv} tripdt={tdt}
Gpsi_Dx 0 idt4  VALUE={-RDx*v(idx)} tripdv={tdv} tripdt={tdt}
Cpsi_Dx idt4 0 1 IC=0
Rpsi_Dx idt4 0 1e10
*

Epsi_Dy	psiDy	0 VALUE={v(idt5)} tripdv={tdv} tripdt={tdt}
Gpsi_Dy 0 idt5  VALUE={-RDy*v(idy)} tripdv={tdv} tripdt={tdt}
Cpsi_Dy idt5 0 1 IC=0
Rpsi_Dy idt5 0 1e10
*
Epsi_E	psiE	0 VALUE={err0*psiN*(1+Streuung)+v(idt6)} tripdv={tdv} tripdt={tdt}
Gpsi_E 0 idt6  VALUE={v(F1,0)*g*RE_factor-RE*RE_factor*g*g*v(ie)} tripdv={tdv} tripdt={tdt} ;<--------- MATLAB compatible 
Cpsi_E idt6 0 1 IC=0
Rpsi_E idt6 0 1e10
*
Gtheta 0 theta VALUE={180/pi*atan2(v(usx),v(usy))} tripdv={tdv} tripdt={tdt}   ;Lastwinkel!!!!
Rtheta theta 0 1
Ctheta theta 0 10u
*
Emi		Mi	0	VALUE={1.5*p*(i(vphx)*v(isy)-i(vphy)*v(isx))} tripdv={tdv} tripdt={tdt}
EMoment	M 0	VALUE={-v(Mi)+v(Rbg)} tripdv={tdv} tripdt={tdt}
Rn1 n 0 1k
Vn n 0 {n1}
* friction
GRbg		0	Rbg	TABLE {v(n)} (-1,-1) (1,1)
RRbg		Rbg	0	{MN*rbg}
* Compute alpha
Gal   0       alpha  VALUE={alpha_0*pi/180+p/60*(2*pi)*n1*TIME} tripdv={tdv} tripdt={tdt}
Ral   alpha   0      1
* Compute n
*En		n	0  VALUE={n0+60/(2*pi)/J*v(idt8)} tripdv={tdv} tripdt={tdt}
*Gn 0 idt8  VALUE={v(M)*Mvz+v(Mi)-v(Rbg)} tripdv={tdv} tripdt={tdt}
*Cn idt8 0 1 IC=0
*Rn idt8 0 1e10
* Compute f
Ef      f   0  VALUE={v(n)*p/60} tripdv={tdv} tripdt={tdt}
* voltage RMS of generator
Ev Us 0 VALUE={sqrt(v(usx)*v(usx)+v(usy)*v(usy))} tripdv={tdv} tripdt={tdt}
* Xd=Xq for cylindrical pole machine Xd,Xq different for salient pole
Exd xd 0 VALUE={(v(Lhd3)+Lsd)*2*pi*fn} tripdv={tdv} tripdt={tdt} ;better measured from sliptest
Exq xq 0 VALUE={(v(Lhq3)+Lsq)*2*pi*fn} tripdv={tdv} tripdt={tdt} ;better measured from sliptest
* New added
Epsihx psihx 0 VALUE={v(psisx)-Lsd*v(isx)} tripdv={tdv} tripdt={tdt}
Epsihy psihy 0 VALUE={v(psisy)-Lsq*v(isy)} tripdv={tdv} tripdt={tdt}
Epsihx1 psihx1 0 VALUE={v(psidx)-Ldx*v(iDx)} tripdv={tdv} tripdt={tdt} ;same as pshihx
Epsihy1 psihy1 0 VALUE={v(psidy)-Ldy*v(iDy)} tripdv={tdv} tripdt={tdt} ;same as pshihy
Epsihx2 psihx2 0 VALUE={v(psie)-Le*v(ie)}  tripdv={tdv} tripdt={tdt}  ;same as pshihx
Eg  g 0 VALUE={g} tripdv={tdv} tripdt={tdt}
EU  u 0 VALUE={v(us)*sqrt(3)/sqrt(2)} tripdv={tdv} tripdt={tdt}
Ei  i 0 VALUE={0.7071*sqrt(v(isx)*v(isx)+v(isy)*v(isy))} tripdv={tdv} tripdt={tdt} 
Eap p 0 VALUE={3*(v(usx)*v(isx)/2+v(usy)*v(isy)/2)}  tripdv={tdv} tripdt={tdt}
Eaq q 0 VALUE={3*(v(usy)*v(isx)/2-v(usx)*v(isy)/2)} tripdv={tdv} tripdt={tdt}
Es  s 0 VALUE={sqrt(v(p)*v(p)+v(q)*v(q))} tripdv={tdv} tripdt={tdt}
* Other formulas for active and reactive power
Ephiu phius 0 VALUE={180/pi*atan2(v(usy),v(usx))}  tripdv={tdv} tripdt={tdt} 
Ephii phiis 0 VALUE={180/pi*atan2(v(isy),v(isx))}  tripdv={tdv} tripdt={tdt}
Ephi phi 0 VALUE={(v(phius)-v(phiis))}   tripdv={tdv} tripdt={tdt}
* Other formula for up
*Eup2 up2 0 VALUE={sqrt((v(u)-v(i)*v(xd)*sin(pi/180*v(phi)))*(v(u)-v(i)*v(xd)*sin(pi/180*v(phi)))+(v(i)*v(xd)*cos(pi/180*v(phi)))*(v(i)*v(xd)*cos(pi/180*v(phi))))}  
Eup up 0 VALUE={(v(usy)-v(isx)*v(xd))/sqrt(2)} tripdv={tdv} tripdt={tdt}
*
Ews wmagnstator 0 VALUE={1.5*0.5*(v(psisx)*v(isx)+v(psisy)*v(isy))} tripdv={tdv} tripdt={tdt}
Ewe wmagnexciter 0 VALUE={1.5*0.5*v(psie)*v(ie)} tripdv={tdv} tripdt={tdt}
Ewd wmagndamper 0 VALUE={1.5*0.5*(v(psidx)*v(idx)+v(psidy)*v(idy))}  tripdv={tdv} tripdt={tdt}
Ewsumm wmagnsum 0 VALUE={v(wmagnstator)+v(wmagndamper)+v(wmagnexciter)} tripdv={tdv} tripdt={tdt}
*
* Psum2=Psum3 P from Wmagn ( P=dWmagn/dt )
Etest Psum2 0 VALUE={v(Pstator)+v(Pexciter)+v(Pdamper)} tripdv={tdv} tripdt={tdt} 
Etest2 Psum3 0 VALUE={DDT(v(wmagnstator))+DDT(v(wmagnexciter))+DDT(v(wmagndamper))} tripdv={tdv} tripdt={tdt} 
*
EPstator Pstator  0 VALUE={1.5*(v(isx)*DDT(v(psisx)))+1.5*(v(isy)*DDT(v(psisy)))} tripdv={tdv} tripdt={tdt} 
* Exciter is fed by external unit
EPexiter Pexciter 0 VALUE={1.5*(v(ie)*DDT(v(psie)))} tripdv={tdv} tripdt={tdt}
EPdamper Pdamper 0 VALUE={1.5*(v(idx)*DDT(v(psidx))+v(idy)*DDT(v(psidy)))} tripdv={tdv} tripdt={tdt}
EPsum1 Psum1 0 VALUE={v(Pstator)+v(Pdamper)+v(Pexciter)} tripdv={tdv} tripdt={tdt}
EPsum Psum 0 VALUE={v(Psum1)+V(Pcusum)-v(Pcu3)-v(Pexciter)-V(P)+V(rbg)*omega_el/p} tripdv={tdv} tripdt={tdt}
EPM   Pmech 0 VALUE={-v(M)*omega_el/p} tripdv={tdv} tripdt={tdt}
* other formulas for theta theta2 for non salient machine and theta3 for salient machine
*Etheta2 theta2 0 VALUE={-180/pi*atan2(v(i)*v(xd)*cos(pi/180*v(phi)),(v(u)-v(i)*v(xd)*sin(pi/180*v(phi))))}  ;for round pole
*Etheta3 theta3 0 VALUE={-180/pi*atan2(v(i)*v(xq)*cos(pi/180*v(phi)),(v(u)-v(i)*v(xq)*sin(pi/180*v(phi))))}  ;for salient pole
*
* Qtsum = Qtstator + Qtdamper = -Qtexciter
EQtransf1 Qtstator 0 VALUE={1.5*(v(isx)*DDT(v(psisy))-v(isy)*DDT(v(psisx)))} tripdv={tdv} tripdt={tdt}
EQtransf2 Qtexciter 0 VALUE={1.5*(v(isx)*DDT(v(psihx)))} tripdv={tdv} tripdt={tdt}
EQtransf3 Qtdamper 0 VALUE={1.5*(v(isx)*DDT(v(psihx))+v(isy)*DDT(v(psihy)))} tripdv={tdv} tripdt={tdt}
EQtranssum Qtsum 0 VALUE={v(Qtstator)+v(Qtdamper)} tripdv={tdv} tripdt={tdt}
EQmagn1 Qrotstator 0 VALUE={1.5*omega_el*(v(isx)*v(isx)*(v(Lhd3)+Lsd)+v(isy)*v(isy)*(v(Lhq3)+Lsq))} tripdv={tdv} tripdt={tdt}
EQmagn2 Qrotexciter 0 VALUE={1.5*omega_el*(v(ie)*v(isx)*v(Lhd3))} tripdv={tdv} tripdt={tdt}
EQmagn3 Qrotdamper 0 VALUE={1.5*omega_el*(v(isx)*v(idx)*v(Lhd3)+v(idy)*v(isy)*v(Lhq3))} tripdv={tdv} tripdt={tdt}
EQexciter Qexciter 0 VALUE={v(Qrotexciter)+v(Qtexciter)}  tripdv={tdv} tripdt={tdt}
EQstator Qstator 0 VALUE={v(Qrotstator)+v(Qtstator)}  tripdv={tdv} tripdt={tdt}
EQdamper Qdamper 0 VALUE={v(Qrotdamper)+v(Qtdamper)} tripdv={tdv} tripdt={tdt}
* Qsum = Qstator + Qdamper - Qext = -Qexciter 
EQsum Qsum 0 VALUE={v(Qstator)+v(Qdamper)-V(Q)} tripdv={tdv} tripdt={tdt}
.ENDS

.subckt Sgen_12kW_constant_speed_type2 U1 V1 W1 F1 M n GND1 params:
+	UN_verkettet=400V
+	IN=21A
+	Pel=12kW  ;UN_verkettet*IN*sqrt(3)*cosphi of 0.8
+	fn={fn1}
+	Kc=0.5
+	UE0=48V ; Power of exciter = 0.25-5% * SN machine (smaller values for higher SN)
+	IE0=5A
+	p=2
+	Streuung=0.05
+	rcu=0.05
+	rbg=0.05
+	Schenkelpolfaktor=1 ;(1=cylindrical pole 0.5=Salient pole)
+	Daempferfaktor=1
+   n0=1500
+	n1={n0}
+  alpha_0=0
*+  U_E={UN*sqrt(2)*RE/(omega_el*Lhd3)}
+  err0=0 RE_factor=0.6666 ;Matlab compatible with RE_factor=2/3=0.6666
.PARAM
+	UN={UN_verkettet/sqrt(3)}
+	ZN={UN/IN}
+  XD={UN/IN/Kc}
+   XQ={XD*Schenkelpolfaktor}
+	Rs={ZN*rcu}
+	omega_el={(2*pi)*fN}
+	Ls={Streuung*ZN/Kc/omega_el}
+	PsiN={sqrt(2)*UN/omega_el}
+	RE={UE0/IE0}
+	RD={Rs/Daempferfaktor}
+  RDx={RD} ; can be overwritten by setting this parameters directly here to a numerical value
+  RDy={RD} ; can be overwritten by setting this parameters directly here to a numerical value
+  LDx={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+  LDy={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+  LE={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+  R0={Rs} ; can be overwritten by setting this parameters directly here to a numerical value
+  L0={Ls} ; can be overwritten by setting this parameters directly here to a numerical value(X0 is 0.03-0.1 p.u)
+  Lsd={Ls}
+  Lsq={Ls}
+  Lhd3={XD/(2*pi*fn)-Lsd}
+  Lhq3={XQ/(2*pi*fn)-Lsq}
+   g={UE0/(UN*sqrt(2)*RE/(XD-omega_el*Lsd))}
+	MN={Pel*(1-rbg-rcu)*p/omega_el}
* magnetic voltage  UE0, IE0
* NOTE: Measurement of g: set g=1 see the voltage output of generator
* make now g smaller until the nominal voltage of the generator is present
Rf1 f1 0 1e12
Rm1  m  0 1e12
Rn1  n  0 1e12
Eun un 0 VALUE={Un} tripdv={tdv} tripdt={tdt}
Ein in 0 VALUE={In} tripdv={tdv} tripdt={tdt}
Esn sn 0 VALUE={3*Un*In} tripdv={tdv} tripdt={tdt}
Epn pn 0 VALUE={pel} tripdv={tdv} tripdt={tdt}
Ecosphin cosphi 0 VALUE={pel/(3*Un*In)} tripdv={tdv} tripdt={tdt}
Ezn zn 0 VALUE={Zn} tripdv={tdv} tripdt={tdt}
Ers rs 0 VALUE={Rs} tripdv={tdv} tripdt={tdt}
* New
Epcu pcu 0 VALUE={3*v(i)*v(i)*Rs} tripdv={tdv} tripdt={tdt}
* Pcu1 same as Pcu
*Epcu1 pcu1 0 VALUE={1.5*Rs*(v(isx)*v(isx)+v(isy)*v(isy))} tripdv={tdv} tripdt={tdt}
Epcu2 pcu2 0 VALUE={v(idx)*v(idx)*RDx+v(idy)*v(idy)*RDy} tripdv={tdv} tripdt={tdt}
* This loss is fed by the external exciter !!!! Pcu_exciter=UE*IE
Epcu3 pcu3 0 VALUE={v(ie)*v(ie)*g*g*Re*RE_factor} tripdv={tdv} tripdt={tdt}
Epcusum pcusum 0 VALUE={v(pcu)+v(pcu2)+v(pcu3)} tripdv={tdv} tripdt={tdt}
*
*    Null-System
Gi0    0    i0    VALUE=
+ {((v(U1,U2)+v(V1,V2)+v(W1,W2))/3-R0*v(i0))/L0} tripdv={tdv} tripdt={tdt}
Ci0    i0    0    1    IC=0
Ri0    i0    0    1E6
*    stator voltages rotor/stator system
Guxs    0    usxs    VALUE={2/3*v(U1,U2)-v(V1,V2)/3-v(W1,W2)/3} tripdv={tdv} tripdt={tdt}
Guys    0    usys    VALUE={(v(V1,V2)-v(W1,W2))/sqrt(3)} tripdv={tdv} tripdt={tdt}
Ruxs    usxs    0    1
Ruys    usys    0    1
Guxr    0    usx    VALUE={v(usxs)*v(cosa)+v(usys)*v(sina)} tripdv={tdv} tripdt={tdt}
Guyr    0    usy    VALUE={v(usys)*v(cosa)-v(usxs)*v(sina)} tripdv={tdv} tripdt={tdt}
Ruxr    usx    0    1
Ruyr    usy    0    1
*    fluxes
Gpsx    0    psisx    VALUE={v(usx)-Rs*v(isx)+p*(pi/30)*n1*v(psisy)} tripdv={tdv} tripdt={tdt}
Gpe     0    psie    VALUE={v(F1)*g*RE_factor   -RE*RE_factor*g*g*v(iE) } tripdv={tdv} tripdt={tdt} ;<--------- MATLAB compatible 
Gpdx    0    psidx    VALUE={0     -RDx*v(idx)              } tripdv={tdv} tripdt={tdt}
Rpsx    psisx        0        1MEG
Rpe     psie         0        1MEG
Rpdx    psidx        0        1MEG
Cpsx    psisx        0        1    IC={err0*psiN}
Cpe     psie         0        1    IC={err0*psiN*(1+Streuung)}
Cpdx    psidx        0        1    IC={err0*psiN}
Gpsy    0    psisy    VALUE={v(usy)-Rs*v(isy)-p*(pi/30)*n1*v(psisx)} tripdv={tdv} tripdt={tdt}
Gpdy    0    psidy    VALUE={0     -RDy*v(idy)}   tripdv={tdv} tripdt={tdt}         
Rpsy    psisy        0        1MEG
Rpdy    psidy        0        1MEG
Cpsy    psisy        0        1    IC=0
Cpdy    psidy        0        1    IC=0
*    Currents
Gisx    0    isx        VALUE={Lsd*v(isx)+Lhd3*(v(isx)+v(ie)+v(idx))-v(psisx)} tripdv={tdv} tripdt={tdt}
Gie        0    ie        VALUE={LE *v(ie)+Lhd3*(v(isx)+v(ie)+v(idx))-v(psie)} tripdv={tdv} tripdt={tdt}
Gidx    0    idx       VALUE={LDx*v(idx)+Lhd3*(v(isx)+v(ie)+v(idx))-v(psidx)} tripdv={tdv} tripdt={tdt}
Risx    isx        0        1MEG
Rie     ie         0        1MEG
Ridx    idx       0        1MEG
Gisy    0    isy       VALUE={Lsq*v(isy)+Lhq3*(v(isy)+v(idy))-v(psisy)} tripdv={tdv} tripdt={tdt}
Gidy    0    idy       VALUE={LDy*v(idy)+Lhq3*(v(isy)+v(idy))-v(psidy)} tripdv={tdv} tripdt={tdt}
Risy    isy    0    1MEG
Ridy    idy    0    1MEG
*    inner torque and friction
Gm1     0    mi      VALUE={ Lhd3*(v(isx)+v(ie)+v(idx))*v(isy)} tripdv={tdv} tripdt={tdt}
Gm2     0    mi      VALUE={-Lhq3*(v(isy)+v(idy))*v(isx)} tripdv={tdv} tripdt={tdt}
Rm      mi    0      {1.5*p}
EMoment	M 0	VALUE={-v(Mi)+v(Rbg)} tripdv={tdv} tripdt={tdt}
*    Friction
GRbg  0	   Rbg1	   TABLE {v(n)} (-1,-1) (1,1)
RRbg  Rbg1	0	   1
ERbg  Rbg   0      VALUE={v(Rbg1)*MN*rbg} tripdv={tdv} tripdt={tdt}
En    n  0  Value={N1} tripdv={tdv} tripdt={tdt}
*    angle alpha
Gal   0       alpha  VALUE={alpha_0*pi/180+p/60*(2*pi)*n1*TIME} tripdv={tdv} tripdt={tdt}
Ral   alpha   0      1
Gcos  0       cosa   VALUE={cos(v(alpha))} tripdv={tdv} tripdt={tdt}
Gsin  0       sina   VALUE={sin(v(alpha))} tripdv={tdv} tripdt={tdt}
Rcos  cosa    0      1
Rsin  sina    0      1
*   Stator currents
*    stator currents u,v,w system double translation
* isxs=isx*cosa-isy*sina  isys=isy*cosa+isx*sina
*G1 U1 U2 VALUE={v(isxS)+v(i_Null)}
*G2 V1 V2 VALUE={(-v(isxS)+v(isyS)*sqrt(3))/2+v(i_Null)}
*G3 W1 W2 VALUE={(-v(isxS)-v(isyS)*sqrt(3))/2+v(i_Null)}
Gi1    U1    U2    VALUE={v(isx)*v(cosa)-v(isy)*v(sina)+v(i0)} tripdv={tdv} tripdt={tdt}
Gi2a   V1    V2    VALUE={ ((sqrt(3)/2)*v(isy)-v(isx)/2)*v(cosa)} tripdv={tdv} tripdt={tdt}
Gi2b   V1    V2    VALUE={ (v(isy)/2+(sqrt(3)/2)*v(isx))*v(sina) +v(i0)} tripdv={tdv} tripdt={tdt}
Gi3a   W1    W2    VALUE={-((sqrt(3)/2)*v(isy)+v(isx)/2)*v(cosa)} tripdv={tdv} tripdt={tdt}
Gi3b   W1    W2    VALUE={ (v(isy)/2-(sqrt(3)/2)*v(isx))*v(sina) +v(i0)} tripdv={tdv} tripdt={tdt}
GiEa	F1	0	VALUE={v(ie)*g} tripdv={tdv} tripdt={tdt}
*    Starpoint
R2     v2    GND1   1u
R12    u2    GND1   1u
R23    w2    GND1   1u
RGND1  GND1  0  1e6
*    Some measurements (active power, reactive power, load angle)
Etheta theta 0 VALUE={180/pi*atan2(v(usx),v(usy))} tripdv={tdv} tripdt={tdt}
Eimx imx 0 VALUE={v(isx)+v(idx)+v(ie)} tripdv={tdv} tripdt={tdt};magnetizing current d-axes
Eimy imy 0 VALUE={v(isy)+v(idy)}       tripdv={tdv} tripdt={tdt};magnetizing current q-axes
*
Ef      f   0  VALUE={v(n)*p/60} tripdv={tdv} tripdt={tdt}
*
Ev Us 0 VALUE={sqrt(v(usx)*v(usx)+v(usy)*v(usy))} tripdv={tdv} tripdt={tdt}
Elhd3 Lhd3 0 VALUE={Lhd3} tripdv={tdv} tripdt={tdt}
Elhq3 Lhq3 0 VALUE={Lhq3} tripdv={tdv} tripdt={tdt}
* Xd=Xq for cylindrical pole machine Xd,Xq different for salient pole
Exd xd 0 VALUE={Xd} tripdv={tdv} tripdt={tdt} ;better measured from sliptest
Exq xq 0 VALUE={Xq}   tripdv={tdv} tripdt={tdt} ;better measured from sliptest
* New added
* New added
Epsihx psihx 0 VALUE={v(psisx)-Lsd*v(isx)} tripdv={tdv} tripdt={tdt}
Epsihy psihy 0 VALUE={v(psisy)-Lsq*v(isy)} tripdv={tdv} tripdt={tdt}
Epsihx1 psihx1 0 VALUE={v(psidx)-Ldx*v(iDx)} tripdv={tdv} tripdt={tdt} ;same as pshihx
Epsihy1 psihy1 0 VALUE={v(psidy)-Ldy*v(iDy)} tripdv={tdv} tripdt={tdt} ;same as pshihy
Epsihx2 psihx2 0 VALUE={v(psie)-Le*v(ie)}  tripdv={tdv} tripdt={tdt}  ;same as pshihx
Eg  g 0 VALUE={g} tripdv={tdv} tripdt={tdt}
EU  u 0 VALUE={v(us)*sqrt(3)/sqrt(2)} tripdv={tdv} tripdt={tdt}
Ei  i 0 VALUE={0.7071*sqrt(v(isx)*v(isx)+v(isy)*v(isy))} tripdv={tdv} tripdt={tdt} 
Eap p 0 VALUE={3*(v(usx)*v(isx)/2+v(usy)*v(isy)/2)}  tripdv={tdv} tripdt={tdt}
Eaq q 0 VALUE={3*(v(usy)*v(isx)/2-v(usx)*v(isy)/2)} tripdv={tdv} tripdt={tdt}
Es  s 0 VALUE={sqrt(v(p)*v(p)+v(q)*v(q))} tripdv={tdv} tripdt={tdt}
* Other formulas for active and reactive power
Ephiu phius 0 VALUE={180/pi*atan2(v(usy),v(usx))}  tripdv={tdv} tripdt={tdt} 
Ephii phiis 0 VALUE={180/pi*atan2(v(isy),v(isx))}  tripdv={tdv} tripdt={tdt}
Ephi phi 0 VALUE={(v(phius)-v(phiis))}   tripdv={tdv} tripdt={tdt}
* Other formula for up
*Eup2 up2 0 VALUE={sqrt((v(u)-v(i)*v(xd)*sin(pi/180*v(phi)))*(v(u)-v(i)*v(xd)*sin(pi/180*v(phi)))+(v(i)*v(xd)*cos(pi/180*v(phi)))*(v(i)*v(xd)*cos(pi/180*v(phi))))}  
Eup up 0 VALUE={(v(usy)-v(isx)*v(xd))/sqrt(2)} tripdv={tdv} tripdt={tdt}
*
Ews wmagnstator 0 VALUE={1.5*0.5*(v(psisx)*v(isx)+v(psisy)*v(isy))} tripdv={tdv} tripdt={tdt}
Ewe wmagnexciter 0 VALUE={1.5*0.5*v(psie)*v(ie)} tripdv={tdv} tripdt={tdt}
Ewd wmagndamper 0 VALUE={1.5*0.5*(v(psidx)*v(idx)+v(psidy)*v(idy))}  tripdv={tdv} tripdt={tdt}
Ewsumm wmagnsum 0 VALUE={v(wmagnstator)+v(wmagndamper)+v(wmagnexciter)} tripdv={tdv} tripdt={tdt}
*
* Psum2=Psum3 P from Wmagn ( P=dWmagn/dt )
Etest Psum2 0 VALUE={v(Pstator)+v(Pexciter)+v(Pdamper)} tripdv={tdv} tripdt={tdt} 
Etest2 Psum3 0 VALUE={DDT(v(wmagnstator))+DDT(v(wmagnexciter))+DDT(v(wmagndamper))} tripdv={tdv} tripdt={tdt} 
*
EPstator Pstator  0 VALUE={1.5*(v(isx)*DDT(v(psisx)))+1.5*(v(isy)*DDT(v(psisy)))} tripdv={tdv} tripdt={tdt} 
* Exciter is fed by external unit
EPexiter Pexciter 0 VALUE={1.5*(v(ie)*DDT(v(psie)))} tripdv={tdv} tripdt={tdt}
EPdamper Pdamper 0 VALUE={1.5*(v(idx)*DDT(v(psidx))+v(idy)*DDT(v(psidy)))} tripdv={tdv} tripdt={tdt}
EPsum1 Psum1 0 VALUE={v(Pstator)+v(Pdamper)+v(Pexciter)} tripdv={tdv} tripdt={tdt}
EPsum Psum 0 VALUE={v(Psum1)+V(Pcusum)-v(Pcu3)-v(Pexciter)-V(P)+V(rbg)*omega_el/p} tripdv={tdv} tripdt={tdt}
EPM   Pmech 0 VALUE={-v(M)*omega_el/p} tripdv={tdv} tripdt={tdt}
* other formulas for theta theta2 for non salient machine and theta3 for salient machine
*Etheta2 theta2 0 VALUE={-180/pi*atan2(v(i)*v(xd)*cos(pi/180*v(phi)),(v(u)-v(i)*v(xd)*sin(pi/180*v(phi))))}  ;for round pole
*Etheta3 theta3 0 VALUE={-180/pi*atan2(v(i)*v(xq)*cos(pi/180*v(phi)),(v(u)-v(i)*v(xq)*sin(pi/180*v(phi))))}  ;for salient pole
*
* Qtsum = Qtstator + Qtdamper = -Qtexciter
EQtransf1 Qtstator 0 VALUE={1.5*(v(isx)*DDT(v(psisy))-v(isy)*DDT(v(psisx)))} tripdv={tdv} tripdt={tdt}
EQtransf2 Qtexciter 0 VALUE={1.5*(v(isx)*DDT(v(psihx)))} tripdv={tdv} tripdt={tdt}
EQtransf3 Qtdamper 0 VALUE={1.5*(v(isx)*DDT(v(psihx))+v(isy)*DDT(v(psihy)))} tripdv={tdv} tripdt={tdt}
EQtranssum Qtsum 0 VALUE={v(Qtstator)+v(Qtdamper)} tripdv={tdv} tripdt={tdt}
EQmagn1 Qrotstator 0 VALUE={1.5*omega_el*(v(isx)*v(isx)*(v(Lhd3)+Lsd)+v(isy)*v(isy)*(v(Lhq3)+Lsq))} tripdv={tdv} tripdt={tdt}
EQmagn2 Qrotexciter 0 VALUE={1.5*omega_el*(v(ie)*v(isx)*v(Lhd3))} tripdv={tdv} tripdt={tdt}
EQmagn3 Qrotdamper 0 VALUE={1.5*omega_el*(v(isx)*v(idx)*v(Lhd3)+v(idy)*v(isy)*v(Lhq3))} tripdv={tdv} tripdt={tdt}
EQexciter Qexciter 0 VALUE={v(Qrotexciter)+v(Qtexciter)}  tripdv={tdv} tripdt={tdt}
EQstator Qstator 0 VALUE={v(Qrotstator)+v(Qtstator)}  tripdv={tdv} tripdt={tdt}
EQdamper Qdamper 0 VALUE={v(Qrotdamper)+v(Qtdamper)} tripdv={tdv} tripdt={tdt}
* Qsum = Qstator + Qdamper - Qext = -Qexciter 
EQsum Qsum 0 VALUE={v(Qstator)+v(Qdamper)-V(Q)} tripdv={tdv} tripdt={tdt}
.ends


.subckt Sgen_12kW_constant_speed_type2_Test U1 V1 W1 F1 M n GND1 params:
+	UN_verkettet=400V
+	IN=21A
+	Pel=12kW  ;UN_verkettet*IN*sqrt(3)*cosphi of 0.8
+	fn={fn1}
+	Kc=0.5
+	UE0=48V ; Power of exciter = 0.25-5% * SN machine (smaller values for higher SN)
+	IE0=5A
+	p=2
+	Streuung=0.05
+	rcu=0.05
+	rbg=0.05
+	Schenkelpolfaktor=1 ;(1=cylindrical pole 0.5=Salient pole)
+	Daempferfaktor=1
+   n0=1500
+	n1={n0}
+  alpha_0=0
*+  U_E={UN*sqrt(2)*RE/(omega_el*Lhd3)}
+  err0=0 RE_factor=0.6666 ;Matlab compatible with RE_factor=2/3=0.6666
.PARAM
+	UN={UN_verkettet/sqrt(3)}
+	ZN={UN/IN}
+  XD={UN/IN/Kc}
+   XQ={XD*Schenkelpolfaktor}
+	Rs={ZN*rcu}
+	omega_el={(2*pi)*fN}
+	Ls={Streuung*ZN/Kc/omega_el}
+	PsiN={sqrt(2)*UN/omega_el}
+	RE={UE0/IE0}
+	RD={Rs/Daempferfaktor}
+  RDx={RD} ; can be overwritten by setting this parameters directly here to a numerical value
+  RDy={RD} ; can be overwritten by setting this parameters directly here to a numerical value
+  LDx={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+  LDy={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+  LE={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+  R0={Rs} ; can be overwritten by setting this parameters directly here to a numerical value
+  L0={Ls} ; can be overwritten by setting this parameters directly here to a numerical value(X0 is 0.03-0.1 p.u)
+  Lsd={Ls}
+  Lsq={Ls}
+  Lhd3={XD/(2*pi*fn)-Lsd}
+  Lhq3={XQ/(2*pi*fn)-Lsq}
+   g={UE0/(UN*sqrt(2)*RE/(XD-omega_el*Lsd))}
+	MN={Pel*(1-rbg-rcu)*p/omega_el}
* magnetic voltage  UE0, IE0
* NOTE: Measurement of g: set g=1 see the voltage output of generator
* make now g smaller until the nominal voltage of the generator is present
Rf1 f1 0 1e12
Rm1  m  0 1e12
Rn1  n  0 1e12
Eun un 0 VALUE={Un} tripdv={tdv} tripdt={tdt}
Ein in 0 VALUE={In} tripdv={tdv} tripdt={tdt}
Esn sn 0 VALUE={3*Un*In} tripdv={tdv} tripdt={tdt}
Epn pn 0 VALUE={pel} tripdv={tdv} tripdt={tdt}
Ecosphin cosphi 0 VALUE={pel/(3*Un*In)} tripdv={tdv} tripdt={tdt}
Ezn zn 0 VALUE={Zn} tripdv={tdv} tripdt={tdt}
Ers rs 0 VALUE={Rs} tripdv={tdv} tripdt={tdt}
* New
Epcu pcu 0 VALUE={3*v(i)*v(i)*Rs} tripdv={tdv} tripdt={tdt}
* Pcu1 same as Pcu
*Epcu1 pcu1 0 VALUE={1.5*Rs*(v(isx)*v(isx)+v(isy)*v(isy))} tripdv={tdv} tripdt={tdt}
Epcu2 pcu2 0 VALUE={v(idx)*v(idx)*RDx+v(idy)*v(idy)*RDy} tripdv={tdv} tripdt={tdt}
* This loss is fed by the external exciter !!!! Pcu_exciter=UE*IE
Epcu3 pcu3 0 VALUE={v(ie)*v(ie)*g*g*Re*RE_factor} tripdv={tdv} tripdt={tdt}
Epcusum pcusum 0 VALUE={v(pcu)+v(pcu2)+v(pcu3)} tripdv={tdv} tripdt={tdt}
*
*    Null-System
Gi0    0    i0    VALUE=
+ {((v(U1,U2)+v(V1,V2)+v(W1,W2))/3-R0*v(i0))/L0} tripdv={tdv} tripdt={tdt}
Ci0    i0    0    1    IC=0
Ri0    i0    0    1E6
*    stator voltages rotor/stator system
Guxs    0    usxs    VALUE={2/3*v(U1,U2)-v(V1,V2)/3-v(W1,W2)/3} tripdv={tdv} tripdt={tdt}
Guys    0    usys    VALUE={(v(V1,V2)-v(W1,W2))/sqrt(3)} tripdv={tdv} tripdt={tdt}
Ruxs    usxs    0    1
Ruys    usys    0    1
Guxr    0    usx    VALUE={v(usxs)*v(cosa)+v(usys)*v(sina)} tripdv={tdv} tripdt={tdt}
Guyr    0    usy    VALUE={v(usys)*v(cosa)-v(usxs)*v(sina)} tripdv={tdv} tripdt={tdt}
Ruxr    usx    0    1
Ruyr    usy    0    1
*    fluxes
Gpsx    0    psisx    VALUE={v(usx)-Rs*v(isx)+p*(pi/30)*n1*v(psisy)} tripdv={tdv} tripdt={tdt}
Gpe     0    psie    VALUE={v(F1)*g*RE_factor   -RE*RE_factor*g*g*v(iE) } tripdv={tdv} tripdt={tdt} ;<--------- MATLAB compatible 
Gpdx    0    psidx    VALUE={0     -RDx*v(idx)              } tripdv={tdv} tripdt={tdt}
Rpsx    psisx        0        1MEG
Rpe     psie         0        1MEG
Rpdx    psidx        0        1MEG
Cpsx    psisx        0        1    IC={err0*psiN}
Cpe     psie         0        1    IC={err0*psiN*(1+Streuung)}
Cpdx    psidx        0        1    IC={err0*psiN}
Gpsy    0    psisy    VALUE={v(usy)-Rs*v(isy)-p*(pi/30)*n1*v(psisx)} tripdv={tdv} tripdt={tdt}
Gpdy    0    psidy    VALUE={0     -RDy*v(idy)}   tripdv={tdv} tripdt={tdt}         
Rpsy    psisy        0        1MEG
Rpdy    psidy        0        1MEG
Cpsy    psisy        0        1    IC=0
Cpdy    psidy        0        1    IC=0
*    Currents
Gisx    0    isx        VALUE={Lsd*v(isx)+Lhd3*(v(isx)+v(ie)+v(idx))-v(psisx)} tripdv={tdv} tripdt={tdt}
Gie        0    ie        VALUE={LE *v(ie)+Lhd3*(v(isx)+v(ie)+v(idx))-v(psie)} tripdv={tdv} tripdt={tdt}
Gidx    0    idx       VALUE={LDx*v(idx)+Lhd3*(v(isx)+v(ie)+v(idx))-v(psidx)} tripdv={tdv} tripdt={tdt}
Risx    isx        0        1MEG
Rie     ie         0        1MEG
Ridx    idx       0        1MEG
Gisy    0    isy       VALUE={Lsq*v(isy)+Lhq3*(v(isy)+v(idy))-v(psisy)} tripdv={tdv} tripdt={tdt}
Gidy    0    idy       VALUE={LDy*v(idy)+Lhq3*(v(isy)+v(idy))-v(psidy)} tripdv={tdv} tripdt={tdt}
Risy    isy    0    1MEG
Ridy    idy    0    1MEG
*    inner torque and friction
Gm1     0    mi      VALUE={ Lhd3*(v(isx)+v(ie)+v(idx))*v(isy)} tripdv={tdv} tripdt={tdt}
Gm2     0    mi      VALUE={-Lhq3*(v(isy)+v(idy))*v(isx)} tripdv={tdv} tripdt={tdt}
Rm      mi    0      {1.5*p}
EMoment	M 0	VALUE={-v(Mi)+v(Rbg)} tripdv={tdv} tripdt={tdt}
*    Friction
GRbg  0	   Rbg1	   TABLE {v(n)} (-1,-1) (1,1)
RRbg  Rbg1	0	   1
ERbg  Rbg   0      VALUE={v(Rbg1)*MN*rbg} tripdv={tdv} tripdt={tdt}
Vn    n  0  AC {N1} tripdv={tdv} tripdt={tdt}
*    angle alpha
Gal   0       alpha  VALUE={alpha_0*pi/180+p/60*(2*pi)*n1*TIME} tripdv={tdv} tripdt={tdt}
Ral   alpha   0      1
Gcos  0       cosa   VALUE={cos(v(alpha))} tripdv={tdv} tripdt={tdt}
Gsin  0       sina   VALUE={sin(v(alpha))} tripdv={tdv} tripdt={tdt}
Rcos  cosa    0      1
Rsin  sina    0      1
*   Stator currents
*    stator currents u,v,w system double translation
* isxs=isx*cosa-isy*sina  isys=isy*cosa+isx*sina
*G1 U1 U2 VALUE={v(isxS)+v(i_Null)}
*G2 V1 V2 VALUE={(-v(isxS)+v(isyS)*sqrt(3))/2+v(i_Null)}
*G3 W1 W2 VALUE={(-v(isxS)-v(isyS)*sqrt(3))/2+v(i_Null)}
Gi1    U1    U2    VALUE={v(isx)*v(cosa)-v(isy)*v(sina)+v(i0)} tripdv={tdv} tripdt={tdt}
Gi2a   V1    V2    VALUE={ ((sqrt(3)/2)*v(isy)-v(isx)/2)*v(cosa)} tripdv={tdv} tripdt={tdt}
Gi2b   V1    V2    VALUE={ (v(isy)/2+(sqrt(3)/2)*v(isx))*v(sina) +v(i0)} tripdv={tdv} tripdt={tdt}
Gi3a   W1    W2    VALUE={-((sqrt(3)/2)*v(isy)+v(isx)/2)*v(cosa)} tripdv={tdv} tripdt={tdt}
Gi3b   W1    W2    VALUE={ (v(isy)/2-(sqrt(3)/2)*v(isx))*v(sina) +v(i0)} tripdv={tdv} tripdt={tdt}
GiEa	F1	0	VALUE={v(ie)*g} tripdv={tdv} tripdt={tdt}
*    Starpoint
R2     v2    GND1   1u
R12    u2    GND1   1u
R23    w2    GND1   1u
RGND1  GND1  0  1e6
*    Some measurements (active power, reactive power, load angle)
Etheta theta 0 VALUE={180/pi*atan2(v(usx),v(usy))} tripdv={tdv} tripdt={tdt}
Eimx imx 0 VALUE={v(isx)+v(idx)+v(ie)} tripdv={tdv} tripdt={tdt};magnetizing current d-axes
Eimy imy 0 VALUE={v(isy)+v(idy)}       tripdv={tdv} tripdt={tdt};magnetizing current q-axes
*
Ef      f   0  VALUE={v(n)*p/60} tripdv={tdv} tripdt={tdt}
*
Ev Us 0 VALUE={sqrt(v(usx)*v(usx)+v(usy)*v(usy))} tripdv={tdv} tripdt={tdt}
Elhd3 Lhd3 0 VALUE={Lhd3} tripdv={tdv} tripdt={tdt}
Elhq3 Lhq3 0 VALUE={Lhq3} tripdv={tdv} tripdt={tdt}
* Xd=Xq for cylindrical pole machine Xd,Xq different for salient pole
Exd xd 0 VALUE={Xd} tripdv={tdv} tripdt={tdt} ;better measured from sliptest
Exq xq 0 VALUE={Xq}   tripdv={tdv} tripdt={tdt} ;better measured from sliptest
* New added
* New added
Epsihx psihx 0 VALUE={v(psisx)-Lsd*v(isx)} tripdv={tdv} tripdt={tdt}
Epsihy psihy 0 VALUE={v(psisy)-Lsq*v(isy)} tripdv={tdv} tripdt={tdt}
Epsihx1 psihx1 0 VALUE={v(psidx)-Ldx*v(iDx)} tripdv={tdv} tripdt={tdt} ;same as pshihx
Epsihy1 psihy1 0 VALUE={v(psidy)-Ldy*v(iDy)} tripdv={tdv} tripdt={tdt} ;same as pshihy
Epsihx2 psihx2 0 VALUE={v(psie)-Le*v(ie)}  tripdv={tdv} tripdt={tdt}  ;same as pshihx
Eg  g 0 VALUE={g} tripdv={tdv} tripdt={tdt}
EU  u 0 VALUE={v(us)*sqrt(3)/sqrt(2)} tripdv={tdv} tripdt={tdt}
Ei  i 0 VALUE={0.7071*sqrt(v(isx)*v(isx)+v(isy)*v(isy))} tripdv={tdv} tripdt={tdt} 
Eap p 0 VALUE={3*(v(usx)*v(isx)/2+v(usy)*v(isy)/2)}  tripdv={tdv} tripdt={tdt}
Eaq q 0 VALUE={3*(v(usy)*v(isx)/2-v(usx)*v(isy)/2)} tripdv={tdv} tripdt={tdt}
Es  s 0 VALUE={sqrt(v(p)*v(p)+v(q)*v(q))} tripdv={tdv} tripdt={tdt}
* Other formulas for active and reactive power
Ephiu phius 0 VALUE={180/pi*atan2(v(usy),v(usx))}  tripdv={tdv} tripdt={tdt} 
Ephii phiis 0 VALUE={180/pi*atan2(v(isy),v(isx))}  tripdv={tdv} tripdt={tdt}
Ephi phi 0 VALUE={(v(phius)-v(phiis))}   tripdv={tdv} tripdt={tdt}
* Other formula for up
*Eup2 up2 0 VALUE={sqrt((v(u)-v(i)*v(xd)*sin(pi/180*v(phi)))*(v(u)-v(i)*v(xd)*sin(pi/180*v(phi)))+(v(i)*v(xd)*cos(pi/180*v(phi)))*(v(i)*v(xd)*cos(pi/180*v(phi))))}  
Eup up 0 VALUE={(v(usy)-v(isx)*v(xd))/sqrt(2)} tripdv={tdv} tripdt={tdt}
*
Ews wmagnstator 0 VALUE={1.5*0.5*(v(psisx)*v(isx)+v(psisy)*v(isy))} tripdv={tdv} tripdt={tdt}
Ewe wmagnexciter 0 VALUE={1.5*0.5*v(psie)*v(ie)} tripdv={tdv} tripdt={tdt}
Ewd wmagndamper 0 VALUE={1.5*0.5*(v(psidx)*v(idx)+v(psidy)*v(idy))}  tripdv={tdv} tripdt={tdt}
Ewsumm wmagnsum 0 VALUE={v(wmagnstator)+v(wmagndamper)+v(wmagnexciter)} tripdv={tdv} tripdt={tdt}
*
* Psum2=Psum3 P from Wmagn ( P=dWmagn/dt )
Etest Psum2 0 VALUE={v(Pstator)+v(Pexciter)+v(Pdamper)} tripdv={tdv} tripdt={tdt} 
Etest2 Psum3 0 VALUE={DDT(v(wmagnstator))+DDT(v(wmagnexciter))+DDT(v(wmagndamper))} tripdv={tdv} tripdt={tdt} 
*
EPstator Pstator  0 VALUE={1.5*(v(isx)*DDT(v(psisx)))+1.5*(v(isy)*DDT(v(psisy)))} tripdv={tdv} tripdt={tdt} 
* Exciter is fed by external unit
EPexiter Pexciter 0 VALUE={1.5*(v(ie)*DDT(v(psie)))} tripdv={tdv} tripdt={tdt}
EPdamper Pdamper 0 VALUE={1.5*(v(idx)*DDT(v(psidx))+v(idy)*DDT(v(psidy)))} tripdv={tdv} tripdt={tdt}
EPsum1 Psum1 0 VALUE={v(Pstator)+v(Pdamper)+v(Pexciter)} tripdv={tdv} tripdt={tdt}
EPsum Psum 0 VALUE={v(Psum1)+V(Pcusum)-v(Pcu3)-v(Pexciter)-V(P)+V(rbg)*omega_el/p} tripdv={tdv} tripdt={tdt}
EPM   Pmech 0 VALUE={-v(M)*omega_el/p} tripdv={tdv} tripdt={tdt}
* other formulas for theta theta2 for non salient machine and theta3 for salient machine
*Etheta2 theta2 0 VALUE={-180/pi*atan2(v(i)*v(xd)*cos(pi/180*v(phi)),(v(u)-v(i)*v(xd)*sin(pi/180*v(phi))))}  ;for round pole
*Etheta3 theta3 0 VALUE={-180/pi*atan2(v(i)*v(xq)*cos(pi/180*v(phi)),(v(u)-v(i)*v(xq)*sin(pi/180*v(phi))))}  ;for salient pole
*
* Qtsum = Qtstator + Qtdamper = -Qtexciter
EQtransf1 Qtstator 0 VALUE={1.5*(v(isx)*DDT(v(psisy))-v(isy)*DDT(v(psisx)))} tripdv={tdv} tripdt={tdt}
EQtransf2 Qtexciter 0 VALUE={1.5*(v(isx)*DDT(v(psihx)))} tripdv={tdv} tripdt={tdt}
EQtransf3 Qtdamper 0 VALUE={1.5*(v(isx)*DDT(v(psihx))+v(isy)*DDT(v(psihy)))} tripdv={tdv} tripdt={tdt}
EQtranssum Qtsum 0 VALUE={v(Qtstator)+v(Qtdamper)} tripdv={tdv} tripdt={tdt}
EQmagn1 Qrotstator 0 VALUE={1.5*omega_el*(v(isx)*v(isx)*(v(Lhd3)+Lsd)+v(isy)*v(isy)*(v(Lhq3)+Lsq))} tripdv={tdv} tripdt={tdt}
EQmagn2 Qrotexciter 0 VALUE={1.5*omega_el*(v(ie)*v(isx)*v(Lhd3))} tripdv={tdv} tripdt={tdt}
EQmagn3 Qrotdamper 0 VALUE={1.5*omega_el*(v(isx)*v(idx)*v(Lhd3)+v(idy)*v(isy)*v(Lhq3))} tripdv={tdv} tripdt={tdt}
EQexciter Qexciter 0 VALUE={v(Qrotexciter)+v(Qtexciter)}  tripdv={tdv} tripdt={tdt}
EQstator Qstator 0 VALUE={v(Qrotstator)+v(Qtstator)}  tripdv={tdv} tripdt={tdt}
EQdamper Qdamper 0 VALUE={v(Qrotdamper)+v(Qtdamper)} tripdv={tdv} tripdt={tdt}
* Qsum = Qstator + Qdamper - Qext = -Qexciter 
EQsum Qsum 0 VALUE={v(Qstator)+v(Qdamper)-V(Q)} tripdv={tdv} tripdt={tdt}
.ends

* like type2 but now with saturated XD
.subckt Sgen_12kW_constant_speed_type3 U1 V1 W1 F1 M n GND1 params:
+	UN_verkettet=400V
+	IN=21A
+	Pel=12kW  ;UN_verkettet*IN*sqrt(3)*cosphi of 0.8
+	fn={fn1}
+	Kc=0.5
+	UE0=48V ; Power of exciter = 0.25-5% * SN machine (smaller values for higher SN)
+	IE0=5A
+	p=2
+	Streuung=0.05
+	rcu=0.05
+	rbg=0.05
+	Schenkelpolfaktor=1 ;(1=cylindrical pole 0.5=Salient pole)
+	Daempferfaktor=1
+   n0=1500
+	n1={n0}
+  a=0.9
+  m=7
+  alpha_0=0
*+  U_E={UN*sqrt(2)*RE/(omega_el*Lhd3)}
+  err0=0 RE_factor=0.6666 ;Matlab compatible with RE_factor=2/3=0.6666
.PARAM
+  a1={a}
+  m1={m}
+  a2={a}
+  m2={m}
+	UN={UN_verkettet/sqrt(3)}
+	ZN={UN/IN}
+  XD={UN/IN/Kc}
+   XQ={XD*Schenkelpolfaktor}
+	Rs={ZN*rcu}
+	omega_el={(2*pi)*fN}
+	Ls={Streuung*ZN/Kc/omega_el}
+	PsiN={sqrt(2)*UN/omega_el}
+	RE={UE0/IE0}
+	RD={Rs/Daempferfaktor}
+  RDx={RD} ; can be overwritten by setting this parameters directly here to a numerical value
+  RDy={RD} ; can be overwritten by setting this parameters directly here to a numerical value
+  LDx={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+  LDy={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+  LE={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+  R0={Rs} ; can be overwritten by setting this parameters directly here to a numerical value
+  L0={Ls} ; can be overwritten by setting this parameters directly here to a numerical value(X0 is 0.03-0.1 p.u)
+  Lsd={Ls}
+  Lsq={Ls}
+  Lhd3={XD/(2*pi*fn)-Lsd}
+  Lhq3={XQ/(2*pi*fn)-Lsq}
+   g={UE0/(UN*sqrt(2)*RE/(XD-omega_el*Lsd))}
+	MN={Pel*(1-rbg-rcu)*p/omega_el}
* magnetic voltage  UE0, IE0
* NOTE: Measurement of g: set g=1 see the voltage output of generator
* make now g smaller until the nominal voltage of the generator is present
Rf1 f1 0 1e12
Rm1  m  0 1e12
Rn1  n  0 1e12
Eun un 0 VALUE={Un} tripdv={tdv} tripdt={tdt}
Ein in 0 VALUE={In} tripdv={tdv} tripdt={tdt}
Esn sn 0 VALUE={3*Un*In} tripdv={tdv} tripdt={tdt}
Epn pn 0 VALUE={pel} tripdv={tdv} tripdt={tdt}
Ecosphin cosphi 0 VALUE={pel/(3*Un*In)} tripdv={tdv} tripdt={tdt}
Ezn zn 0 VALUE={Zn} tripdv={tdv} tripdt={tdt}
Ers rs 0 VALUE={Rs} tripdv={tdv} tripdt={tdt}
* New
Epcu pcu 0 VALUE={3*v(i)*v(i)*Rs} tripdv={tdv} tripdt={tdt}
* Pcu1 same as Pcu
*Epcu1 pcu1 0 VALUE={1.5*Rs*(v(isx)*v(isx)+v(isy)*v(isy))} tripdv={tdv} tripdt={tdt}
Epcu2 pcu2 0 VALUE={v(idx)*v(idx)*RDx+v(idy)*v(idy)*RDy} tripdv={tdv} tripdt={tdt}
* This loss is fed by the external exciter !!!! Pcu_exciter=UE*IE
Epcu3 pcu3 0 VALUE={v(ie)*v(ie)*g*g*Re*RE_factor} tripdv={tdv} tripdt={tdt}
Epcusum pcusum 0 VALUE={v(pcu)+v(pcu2)+v(pcu3)} tripdv={tdv} tripdt={tdt}
*    Null-System
Gi0    0    i0    VALUE=
+ {((v(U1,U2)+v(V1,V2)+v(W1,W2))/3-R0*v(i0))/L0} tripdv={tdv} tripdt={tdt}
Ci0    i0    0    1    IC=0
Ri0    i0    0    1E6
*    stator voltages rotor/stator system
Guxs    0    usxs    VALUE={2/3*v(U1,U2)-v(V1,V2)/3-v(W1,W2)/3} tripdv={tdv} tripdt={tdt}
Guys    0    usys    VALUE={(v(V1,V2)-v(W1,W2))/sqrt(3)} tripdv={tdv} tripdt={tdt}
Ruxs    usxs    0    1
Ruys    usys    0    1
Guxr    0    usx    VALUE={v(usxs)*v(cosa)+v(usys)*v(sina)} tripdv={tdv} tripdt={tdt}
Guyr    0    usy    VALUE={v(usys)*v(cosa)-v(usxs)*v(sina)} tripdv={tdv} tripdt={tdt}
Ruxr    usx    0    1
Ruyr    usy    0    1
*    fluxes
Gpsx    0    psisx    VALUE={v(usx)-Rs*v(isx)+p*(pi/30)*n1*v(psisy)} tripdv={tdv} tripdt={tdt}
Gpe     0    psie    VALUE={v(F1)*g*RE_factor   -RE*RE_factor*g*g*v(iE) } tripdv={tdv} tripdt={tdt} ;<--------- MATLAB compatible 
Gpdx    0    psidx    VALUE={0     -RDx*v(idx)              } tripdv={tdv} tripdt={tdt}
Rpsx    psisx        0        1MEG
Rpe     psie         0        1MEG
Rpdx    psidx        0        1MEG
Cpsx    psisx        0        1    IC={err0*psiN}
Cpe     psie         0        1    IC={err0*psiN*(1+Streuung)}
Cpdx    psidx        0        1    IC={err0*psiN}
Gpsy    0    psisy    VALUE={v(usy)-Rs*v(isy)-p*(pi/30)*n1*v(psisx)} tripdv={tdv} tripdt={tdt}
Gpdy    0    psidy    VALUE={0     -RDy*v(idy)}   tripdv={tdv} tripdt={tdt}         
Rpsy    psisy        0        1MEG
Rpdy    psidy        0        1MEG
Cpsy    psisy        0        1    IC=0
Cpdy    psidy        0        1    IC=0
*    Currents
Gisx    0    isx        VALUE={Lsd*v(isx)+v(Lhd3)*(v(isx)+v(ie)+v(idx))-v(psisx)} tripdv={tdv} tripdt={tdt}
Gie        0    ie        VALUE={LE *v(ie)+v(Lhd3)*(v(isx)+v(ie)+v(idx))-v(psie)} tripdv={tdv} tripdt={tdt}
Gidx    0    idx       VALUE={LDx*v(idx)+v(Lhd3)*(v(isx)+v(ie)+v(idx))-v(psidx)} tripdv={tdv} tripdt={tdt}
Risx    isx        0        1MEG
Rie     ie         0        1MEG
Ridx    idx       0        1MEG
Gisy    0    isy       VALUE={Lsq*v(isy)+v(Lhq3)*(v(isy)+v(idy))-v(psisy)} tripdv={tdv} tripdt={tdt}
Gidy    0    idy       VALUE={LDy*v(idy)+v(Lhq3)*(v(isy)+v(idy))-v(psidy)} tripdv={tdv} tripdt={tdt}
Risy    isy    0    1MEG
Ridy    idy    0    1MEG
* nonlinear magnetics
Elhd3 Lhd3 0 VALUE={Lhd3*(1/(a1+(1-a1)*PWRS(LIMIT(abs(v(psihx)+1p)/PsiN,-10,10),m1-1)))} tripdv={tdv} tripdt={tdt}
Elhq3 Lhq3 0 VALUE={Lhq3*(1/(a2+(1-a2)*PWRS(LIMIT(abs(v(psihy)+1p)/PsiN,-10,10),m2-1)))} tripdv={tdv} tripdt={tdt}
*    inner torque and friction
*Gm1     0    mi      VALUE={ v(Lhd3)*(v(isx)+v(ie)+v(idx))*v(isy)} tripdv={tdv} tripdt={tdt}
*Gm2     0    mi      VALUE={-v(Lhq3)*(v(isy)+v(idy))*v(isx)} tripdv={tdv} tripdt={tdt}
*Rm      mi    0      {1.5*p}
Emi		Mi	0	VALUE={1.5*p*(v(psihx)*v(isy)-v(psihy)*v(isx))} tripdv={tdv} tripdt={tdt}
EMoment	M 0	VALUE={-v(Mi)+v(Rbg)} tripdv={tdv} tripdt={tdt}
*    Friction
GRbg  0	   Rbg1	   TABLE {v(n)} (-1,-1) (1,1)
RRbg  Rbg1	0	   1
ERbg  Rbg   0      VALUE={v(Rbg1)*MN*rbg} tripdv={tdv} tripdt={tdt}
En    n  0  Value={N1} tripdv={tdv} tripdt={tdt}
*    angle alpha
Gal   0       alpha  VALUE={alpha_0*pi/180+p/60*(2*pi)*n1*TIME} tripdv={tdv} tripdt={tdt}
Ral   alpha   0      1
Gcos  0       cosa   VALUE={cos(v(alpha))} tripdv={tdv} tripdt={tdt}
Gsin  0       sina   VALUE={sin(v(alpha))} tripdv={tdv} tripdt={tdt}
Rcos  cosa    0      1
Rsin  sina    0      1
*   Stator currents
*    stator currents u,v,w system double translation
* isxs=isx*cosa-isy*sina  isys=isy*cosa+isx*sina
*G1 U1 U2 VALUE={v(isxS)+v(i_Null)}
*G2 V1 V2 VALUE={(-v(isxS)+v(isyS)*sqrt(3))/2+v(i_Null)}
*G3 W1 W2 VALUE={(-v(isxS)-v(isyS)*sqrt(3))/2+v(i_Null)}
Gi1    U1    U2    VALUE={v(isx)*v(cosa)-v(isy)*v(sina)+v(i0)} tripdv={tdv} tripdt={tdt}
Gi2a   V1    V2    VALUE={ ((sqrt(3)/2)*v(isy)-v(isx)/2)*v(cosa)} tripdv={tdv} tripdt={tdt}
Gi2b   V1    V2    VALUE={ (v(isy)/2+(sqrt(3)/2)*v(isx))*v(sina) +v(i0)} tripdv={tdv} tripdt={tdt}
Gi3a   W1    W2    VALUE={-((sqrt(3)/2)*v(isy)+v(isx)/2)*v(cosa)} tripdv={tdv} tripdt={tdt}
Gi3b   W1    W2    VALUE={ (v(isy)/2-(sqrt(3)/2)*v(isx))*v(sina) +v(i0)} tripdv={tdv} tripdt={tdt}
GiEa	F1	0	VALUE={v(ie)*g} tripdv={tdv} tripdt={tdt}
*    Starpoint
R2     v2    GND1   1u
R12    u2    GND1   1u
R23    w2    GND1   1u
RGND1  GND1  0  1e6
*    Some measurements (active power, reactive power, load angle)
Etheta theta 0 VALUE={180/pi*atan2(v(usx),v(usy))} tripdv={tdv} tripdt={tdt}
Eimx imx 0 VALUE={v(isx)+v(idx)+v(ie)} tripdv={tdv} tripdt={tdt};magnetizing current d-axes
Eimy imy 0 VALUE={v(isy)+v(idy)}       tripdv={tdv} tripdt={tdt};magnetizing current q-axes
* Compute f
Ef      f   0  VALUE={v(n)*p/60} tripdv={tdv} tripdt={tdt}
*
Ev Us 0 VALUE={sqrt(v(usx)*v(usx)+v(usy)*v(usy))} tripdv={tdv} tripdt={tdt}
* Xd=Xq for cylindrical pole machine Xd,Xq different for salient pole
Exd xd 0 VALUE={(v(Lhd3)+Lsd)*2*pi*fn} tripdv={tdv} tripdt={tdt} ;better measured from sliptest
Exq xq 0 VALUE={(v(Lhq3)+Lsq)*2*pi*fn} tripdv={tdv} tripdt={tdt} ;better measured from sliptest
* New added
Epsihx psihx 0 VALUE={v(psisx)-Lsd*v(isx)} tripdv={tdv} tripdt={tdt}
Epsihy psihy 0 VALUE={v(psisy)-Lsq*v(isy)} tripdv={tdv} tripdt={tdt}
Epsihx1 psihx1 0 VALUE={v(psidx)-Ldx*v(iDx)} tripdv={tdv} tripdt={tdt};same as pshihx
Epsihy1 psihy1 0 VALUE={v(psidy)-Ldy*v(iDy)} tripdv={tdv} tripdt={tdt};same as pshihy
Epsihx2 psihx2 0 VALUE={v(psie)-Le*v(ie)}    tripdv={tdv} tripdt={tdt};same as pshihx
Eg  g 0 VALUE={g} tripdv={tdv} tripdt={tdt}
EU  u 0 VALUE={v(us)*sqrt(3)/sqrt(2)} tripdv={tdv} tripdt={tdt}
Ei  i 0 VALUE={0.7071*sqrt(v(isx)*v(isx)+v(isy)*v(isy))} tripdv={tdv} tripdt={tdt}
Eap p 0 VALUE={3*(v(usx)*v(isx)/2+v(usy)*v(isy)/2)}  tripdv={tdv} tripdt={tdt}
Eaq q 0 VALUE={3*(v(usy)*v(isx)/2-v(usx)*v(isy)/2)} tripdv={tdv} tripdt={tdt}
Es  s 0 VALUE={sqrt(v(p)*v(p)+v(q)*v(q))} tripdv={tdv} tripdt={tdt}
* Other formulas for active and reactive power
* Other formulas for active and reactive power
Ephiu phius 0 VALUE={180/pi*atan2(v(usy),v(usx))}  tripdv={tdv} tripdt={tdt} 
Ephii phiis 0 VALUE={180/pi*atan2(v(isy),v(isx))}  tripdv={tdv} tripdt={tdt}
Ephi phi 0 VALUE={(v(phius)-v(phiis))}   tripdv={tdv} tripdt={tdt}
* Other formula for up
*Eup2 up2 0 VALUE={sqrt((v(u)-v(i)*v(xd)*sin(pi/180*v(phi)))*(v(u)-v(i)*v(xd)*sin(pi/180*v(phi)))+(v(i)*v(xd)*cos(pi/180*v(phi)))*(v(i)*v(xd)*cos(pi/180*v(phi))))}  
Eup up 0 VALUE={(v(usy)-v(isx)*v(xd))/sqrt(2)} tripdv={tdv} tripdt={tdt}
*
Ews wmagnstator 0 VALUE={1.5*0.5*(v(psisx)*v(isx)+v(psisy)*v(isy))} tripdv={tdv} tripdt={tdt}
Ewe wmagnexciter 0 VALUE={1.5*0.5*v(psie)*v(ie)} tripdv={tdv} tripdt={tdt}
Ewd wmagndamper 0 VALUE={1.5*0.5*(v(psidx)*v(idx)+v(psidy)*v(idy))}  tripdv={tdv} tripdt={tdt}
Ewsumm wmagnsum 0 VALUE={v(wmagnstator)+v(wmagndamper)+v(wmagnexciter)} tripdv={tdv} tripdt={tdt}
*
* Psum2=Psum3 P from Wmagn ( P=dWmagn/dt )
Etest Psum2 0 VALUE={v(Pstator)+v(Pexciter)+v(Pdamper)} tripdv={tdv} tripdt={tdt} 
Etest2 Psum3 0 VALUE={DDT(v(wmagnstator))+DDT(v(wmagnexciter))+DDT(v(wmagndamper))} tripdv={tdv} tripdt={tdt} 
*
EPstator Pstator  0 VALUE={1.5*(v(isx)*DDT(v(psisx)))+1.5*(v(isy)*DDT(v(psisy)))} tripdv={tdv} tripdt={tdt} 
* Exciter is fed by external unit
EPexiter Pexciter 0 VALUE={1.5*(v(ie)*DDT(v(psie)))} tripdv={tdv} tripdt={tdt}
EPdamper Pdamper 0 VALUE={1.5*(v(idx)*DDT(v(psidx))+v(idy)*DDT(v(psidy)))} tripdv={tdv} tripdt={tdt}
EPsum1 Psum1 0 VALUE={v(Pstator)+v(Pdamper)+v(Pexciter)} tripdv={tdv} tripdt={tdt}
EPsum Psum 0 VALUE={v(Psum1)+V(Pcusum)-v(Pcu3)-v(Pexciter)-V(P)+V(rbg)*omega_el/p} tripdv={tdv} tripdt={tdt}
EPM   Pmech 0 VALUE={-v(M)*omega_el/p} tripdv={tdv} tripdt={tdt}
* other formulas for theta theta2 for non salient machine and theta3 for salient machine
*Etheta2 theta2 0 VALUE={-180/pi*atan2(v(i)*v(xd)*cos(pi/180*v(phi)),(v(u)-v(i)*v(xd)*sin(pi/180*v(phi))))}  ;for round pole
*Etheta3 theta3 0 VALUE={-180/pi*atan2(v(i)*v(xq)*cos(pi/180*v(phi)),(v(u)-v(i)*v(xq)*sin(pi/180*v(phi))))}  ;for salient pole
*
* Qtsum = Qtstator + Qtdamper = -Qtexciter
EQtransf1 Qtstator 0 VALUE={1.5*(v(isx)*DDT(v(psisy))-v(isy)*DDT(v(psisx)))} tripdv={tdv} tripdt={tdt}
EQtransf2 Qtexciter 0 VALUE={1.5*(v(isx)*DDT(v(psihx)))} tripdv={tdv} tripdt={tdt}
EQtransf3 Qtdamper 0 VALUE={1.5*(v(isx)*DDT(v(psihx))+v(isy)*DDT(v(psihy)))} tripdv={tdv} tripdt={tdt}
EQtranssum Qtsum 0 VALUE={v(Qtstator)+v(Qtdamper)} tripdv={tdv} tripdt={tdt}
EQmagn1 Qrotstator 0 VALUE={1.5*omega_el*(v(isx)*v(isx)*(v(Lhd3)+Lsd)+v(isy)*v(isy)*(v(Lhq3)+Lsq))} tripdv={tdv} tripdt={tdt}
EQmagn2 Qrotexciter 0 VALUE={1.5*omega_el*(v(ie)*v(isx)*v(Lhd3))} tripdv={tdv} tripdt={tdt}
EQmagn3 Qrotdamper 0 VALUE={1.5*omega_el*(v(isx)*v(idx)*v(Lhd3)+v(idy)*v(isy)*v(Lhq3))} tripdv={tdv} tripdt={tdt}
EQexciter Qexciter 0 VALUE={v(Qrotexciter)+v(Qtexciter)}  tripdv={tdv} tripdt={tdt}
EQstator Qstator 0 VALUE={v(Qrotstator)+v(Qtstator)}  tripdv={tdv} tripdt={tdt}
EQdamper Qdamper 0 VALUE={v(Qrotdamper)+v(Qtdamper)} tripdv={tdv} tripdt={tdt}
* Qsum = Qstator + Qdamper - Qext = -Qexciter 
EQsum Qsum 0 VALUE={v(Qstator)+v(Qdamper)-V(Q)} tripdv={tdv} tripdt={tdt}
.ends

* 3*12 generator
.SUBCKT sgen_12kW_type1 U1 V1 W1  F1  M  n GND1
+	PARAMS:
+	UN_verkettet=400V
+	IN=21A
+	Pel=12kW  ;UN_verkettet*IN*sqrt(3)*cosphi of 0.8
+	fn={fn1}
+	Kc=0.5
+	UE0=48V ; Power of exciter = 0.25-5% * SN machine (smaller values for higher SN)
+	IE0=5A
+	p=2
+	Streuung=0.05
+	rcu=0.05
+	rbg=0.05
+	Schenkelpolfaktor=1 ;(1=cylindrical pole 0.5=Salient pole)
+	Daempferfaktor=1
+	err0=0 RE_factor=0.6666 ;Matlab compatible with RE_factor=2/3=0.6666
+   n0=1500
+   alpha_0=0
+   taumech=2.3  ; parameter for inertia J={p*taumech*MN/omega_el} =2*2.3*76/(2*pi*fn)=1.12  MN=Pel*p/omega=12000*2/(2*pi*fn)=76
+  a=0.9
+  m=7
+   Mvz=1
.PARAM
+   a1={a};  Saturation parameter d-axis
+   m1={m};  Saturation parameter d-axis
+   a2={a1}; Saturation parameter q-axis ( default: same as d-axis -> may be overwritten if different from d-axis )
+   m2={m1}; Saturation parameter q-axis ( default: same as d-axis -> may be overwritten if different from d-axis )
+	UN={UN_verkettet/sqrt(3)}
+	ZN={UN/IN}
+	Rs={ZN*rcu}
+	omega_el={(2*pi)*fN}
+	Ls={Streuung*ZN/Kc/omega_el}
+	PsiN={sqrt(2)*UN/omega_el}
+	RE={UE0/IE0}
+	RD={Rs/Daempferfaktor}
+   RDx={RD} ; can be overwritten by setting this parameters directly here to a numerical value
+   RDy={RD} ; can be overwritten by setting this parameters directly here to a numerical value
+   LDx={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+   LDy={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+   LE={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+   R0={Rs} ; can be overwritten by setting this parameters directly here to a numerical value
+   L0={Ls} ; can be overwritten by setting this parameters directly here to a numerical value(X0 is 0.03-0.1 p.u)
+   Lsd={Ls} 
+   Lsq={Ls}
+   XD={UN/IN/Kc}
+   XQ={XD*Schenkelpolfaktor}
+   g={UE0/(UN*sqrt(2)*RE/(XD-omega_el*Lsd))} ; updated formula for g parameter
+   g1={UE0/(UN*sqrt(2)*RE/(XQ-omega_el*Lsq))} ; updated formula for salient pole machine
+	ImNx={IE0/g} ; d-axis magnetizing current
+	ImNy={IE0/g1} ;q-axis magnetizing current
+	MN={Pel*(1-rbg-rcu)*p/omega_el}
+   J= {p*taumech*MN/omega_el}
+  Lhd3={XD/(2*pi*fn)-Lsd}
+  Lhq3={XQ/(2*pi*fn)-Lsq}
*	Wicklungsstroeme
*	Wicklungsstroeme
Rf1 f1 0 1e12
Rm  m  0 1e12
Rn2  n  0 1e12
EJ J 0 VALUE={J} tripdv={tdv} tripdt={tdt}
Eun un 0 VALUE={Un} tripdv={tdv} tripdt={tdt}
Ein in 0 VALUE={In} tripdv={tdv} tripdt={tdt}
Esn sn 0 VALUE={3*Un*In} tripdv={tdv} tripdt={tdt}
Epn pn 0 VALUE={pel} tripdv={tdv} tripdt={tdt}
Ecosphin cosphi 0 VALUE={pel/(3*Un*In)} tripdv={tdv} tripdt={tdt}
Ezn zn 0 VALUE={Zn} tripdv={tdv} tripdt={tdt}
Ers rs 0 VALUE={Rs} tripdv={tdv} tripdt={tdt}
* New
Epcu pcu 0 VALUE={3*v(i)*v(i)*Rs} tripdv={tdv} tripdt={tdt}
* Pcu1 same as Pcu
*Epcu1 pcu1 0 VALUE={1.5*Rs*(v(isx)*v(isx)+v(isy)*v(isy))} tripdv={tdv} tripdt={tdt}
Epcu2 pcu2 0 VALUE={v(idx)*v(idx)*RDx+v(idy)*v(idy)*RDy} tripdv={tdv} tripdt={tdt}
* This loss is fed by the external exciter !!!! Pcu_exciter=UE*IE
Epcu3 pcu3 0 VALUE={v(ie)*v(ie)*g*g*Re*RE_factor} tripdv={tdv} tripdt={tdt}
Epcusum pcusum 0 VALUE={v(pcu)+v(pcu2)+v(pcu3)} tripdv={tdv} tripdt={tdt}
*	currents of windings
G1	U1	U2	VALUE={v(isxS)+v(i_Null)} tripdv={tdv} tripdt={tdt}
G2	V1	V2	VALUE={(-v(isxS)+v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
G3	W1	W2	VALUE={(-v(isxS)-v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
GiE	F1	0	VALUE={v(ie)*g} tripdv={tdv} tripdt={tdt}
*	voltage components
EuxS	usxS	0	VALUE={(2*v(u1,u2)-v(v1,v2)-v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
EuyS	usyS	0	VALUE={(v(v1,v2)-v(w1,w2))/sqrt(3)} tripdv={tdv} tripdt={tdt}
Eux	usx	0	VALUE={ v(usxS)*cos(v(alpha))+v(usyS)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
Euy	usy	0	VALUE={-v(usxS)*sin(v(alpha))+v(usyS)*cos(v(alpha))} tripdv={tdv} tripdt={tdt}
*    Starpoint
R2     v2    GND1   1u
R12    u2    GND1   1u
R23    w2    GND1   1u
RGND1  GND1  0  1e6
ErefL1 Uref_L1 0 VALUE={-sqrt(2)*UN*sin(2*pi*(fN*(TIME)))} tripdv={tdv} tripdt={tdt}
*	Nullsystem
Eu0	u_Null 0	VALUE={(v(u1,u2)+v(v1,v2)+v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
Ei0	i_Null 0	VALUE={v(idt1)/L0} tripdv={tdv} tripdt={tdt}
Gi0 0 idt1  VALUE={v(u_Null)-R0*v(i_null)} tripdv={tdv} tripdt={tdt}
Ci0 idt1 0 1 IC=0
Ri0 idt1 0 1e10
*
*	current components
EisxS		isxS	0 VALUE={v(isx)*cos(v(alpha))-v(isy)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
EisyS		isyS	0 VALUE={v(isy)*cos(v(alpha))+v(isx)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of direct axis with saturation
Gpsix		0	isx	VALUE={v(psisx)} tripdv={tdv} tripdt={tdt}
Rsx		isx	0	{1/Lsd}
Gpsidx	isx	iDx1	VALUE={v(psiDx)} tripdv={tdv} tripdt={tdt} ; *********
Rsdx		iDx1	isx	{1/LDx}
GpsiEx	iDx1	imx1	VALUE={v(psiE)} tripdv={tdv} tripdt={tdt} ; ie oder if ist iDx,imx !!!!
RsEx		imx1	iDx1	{1/LE}
vphx		imx1	imxa1	0
Eimx1		imxa1	0	VALUE={ImNx*(a1*i(vphx)/PsiN+(1-a1)*PWRS(i(vphx)/PsiN,m1))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of quadrature axis with saturation
Gpsiy		0	isy	VALUE={v(psisy)} tripdv={tdv} tripdt={tdt}
Rsy		isy	0	{1/Lsq}
Gpsidy	isy	imy1	VALUE={v(psiDy)} tripdv={tdv} tripdt={tdt}
Rsdy		imy1	isy	{1/LDy}
vphy		imy1	imya1	0
Eimy1		imya1	0	VALUE={ImNy*(a2*i(vphy)/PsiN+(1-a2)*PWRS(i(vphy)/PsiN,m2))} tripdv={tdv} tripdt={tdt}
*
Eidx  idx 0 VALUE={v(idx1)-v(isx)} tripdv={tdv} tripdt={tdt}
Eidy  idy 0 VALUE={v(imy1)-v(isy)} tripdv={tdv} tripdt={tdt}
Eie ie 0 VALUE={v(imx1)-v(idx1)} tripdv={tdv} tripdt={tdt}
Eimx imx 0 VALUE={v(isx)+v(idx)+v(ie)} tripdv={tdv} tripdt={tdt};magnetizing current d-axes
Eimy imy 0 VALUE={v(isy)+v(idy)}       tripdv={tdv} tripdt={tdt};magnetizing current q-axes
* nonlinear magnetics
Elhd3 Lhd3 0 VALUE={Lhd3*(1/(a1+(1-a1)*PWRS(LIMIT(abs(v(psihx)+1p)/PsiN,-10,10),m1-1)))} tripdv={tdv} tripdt={tdt}
Elhq3 Lhq3 0 VALUE={Lhq3*(1/(a2+(1-a2)*PWRS(LIMIT(abs(v(psihy)+1p)/PsiN,-10,10),m2-1)))} tripdv={tdv} tripdt={tdt}

*	Flux components
Epsi_sx	psisx	0 VALUE={err0*PsiN+v(idt2)} tripdv={tdv} tripdt={tdt}
Gpsi_sx 0 idt2  VALUE={v(usx)-Rs*v(isx)+p*(2*pi)/60*v(n)*v(psisy)} tripdv={tdv} tripdt={tdt}
Cpsi_sx idt2 0 1 IC=0
Rpsi_sx idt2 0 1e10
*
Epsi_sy	psisy	0 VALUE={v(idt3)} tripdv={tdv} tripdt={tdt}
Gpsi_sy 0 idt3  VALUE={v(usy)-Rs*v(isy)-p*(2*pi)/60*v(n)*v(psisx)} tripdv={tdv} tripdt={tdt}
Cpsi_sy idt3 0 1 IC=0
Rpsi_sy idt3 0 1e10
*
Epsi_Dx	psiDx	0 VALUE={err0*psiN+v(idt4)} tripdv={tdv} tripdt={tdt}
Gpsi_Dx 0 idt4  VALUE={-RDx*v(idx)} tripdv={tdv} tripdt={tdt}
Cpsi_Dx idt4 0 1 IC=0
Rpsi_Dx idt4 0 1e10
*

Epsi_Dy	psiDy	0 VALUE={v(idt5)} tripdv={tdv} tripdt={tdt}
Gpsi_Dy 0 idt5  VALUE={-RDy*v(idy)} tripdv={tdv} tripdt={tdt}
Cpsi_Dy idt5 0 1 IC=0
Rpsi_Dy idt5 0 1e10
*
Epsi_E	psiE	0 VALUE={err0*psiN*(1+Streuung)+v(idt6)} tripdv={tdv} tripdt={tdt}
Gpsi_E 0 idt6  VALUE={v(F1,0)*g*RE_factor-RE*RE_factor*g*g*v(ie)} tripdv={tdv} tripdt={tdt} ;<--------- MATLAB compatible 
Cpsi_E idt6 0 1 IC=0
Rpsi_E idt6 0 1e10
*
*
*Emi		Mi	0	VALUE={1.5*p*(i(Vphx)*v(isy)-i(Vphy)*v(isx))} tripdv={tdv} tripdt={tdt}
Emi		Mi	0	VALUE={1.5*p*(v(psihx)*v(isy)-v(psihy)*v(isx))} tripdv={tdv} tripdt={tdt}
*Emi		Mi	0	VALUE={1.5*p*(v(psihx)*v(isy)-v(psihy)*v(isx))} tripdv={tdv} tripdt={tdt}
*EMoment	M 0	VALUE={-v(Mi)+v(Rbg)} tripdv={tdv} tripdt={tdt}
*En    n  0  Value={N1} tripdv={tdv} tripdt={tdt}
* Berechner n
* Compute n
En		n	0  VALUE={n0+60/(2*pi)/J*v(idt8)} tripdv={tdv} tripdt={tdt}
Gn 0 idt8  VALUE={v(M)*Mvz+v(Mi)-v(Rbg)} tripdv={tdv} tripdt={tdt}
Cn idt8 0 1 IC=0
Rn idt8 0 1e10
* friction
GRbg		0	Rbg	TABLE {v(n)} (-1,-1) (1,1)
RRbg		Rbg	0	{MN*rbg}
* Compute alpha
Ealpha	alpha	0	VALUE={alpha_0*pi/180+v(idt7)*p/60*(2*pi)} tripdv={tdv} tripdt={tdt}
Galpha 0 idt7  VALUE={v(n)} tripdv={tdv} tripdt={tdt}
Calpha idt7 0 1 IC=0
Ralpha idt7 0 1e10
*
Gtheta 0 theta VALUE={180/pi*atan2(v(usx),v(usy))} tripdv={tdv} tripdt={tdt}   ;Lastwinkel!!!!
Rtheta theta 0 1
Ctheta theta 0 10u
* Compute n
*En		n	0  VALUE={n0+60/(2*pi)/J*v(idt8)} tripdv={tdv} tripdt={tdt}
*Gn 0 idt8  VALUE={v(M)*Mvz+v(Mi)-v(Rbg)} tripdv={tdv} tripdt={tdt}
*Cn idt8 0 1 IC=0
*Rn idt8 0 1e10
* Compute f
Ef      f   0  VALUE={v(n)*p/60} tripdv={tdv} tripdt={tdt}
* voltage RMS of generator
Ev Us 0 VALUE={sqrt(v(usx)*v(usx)+v(usy)*v(usy))} tripdv={tdv} tripdt={tdt}
* Xd=Xq for cylindrical pole machine Xd,Xq different for salient pole
Exd xd 0 VALUE={(v(Lhd3)+Lsd)*2*pi*fn} tripdv={tdv} tripdt={tdt} ;better measured from sliptest
Exq xq 0 VALUE={(v(Lhq3)+Lsq)*2*pi*fn} tripdv={tdv} tripdt={tdt} ;better measured from sliptest
* New added
Epsihx psihx 0 VALUE={v(psisx)-Lsd*v(isx)} tripdv={tdv} tripdt={tdt}
Epsihy psihy 0 VALUE={v(psisy)-Lsq*v(isy)} tripdv={tdv} tripdt={tdt}
Epsihx1 psihx1 0 VALUE={v(psidx)-Ldx*v(iDx)} tripdv={tdv} tripdt={tdt} ;same as pshihx
Epsihy1 psihy1 0 VALUE={v(psidy)-Ldy*v(iDy)} tripdv={tdv} tripdt={tdt} ;same as pshihy
Epsihx2 psihx2 0 VALUE={v(psie)-Le*v(ie)}  tripdv={tdv} tripdt={tdt}  ;same as pshihx
Eg  g 0 VALUE={g} tripdv={tdv} tripdt={tdt}
EU  u 0 VALUE={v(us)*sqrt(3)/sqrt(2)} tripdv={tdv} tripdt={tdt}
Ei  i 0 VALUE={0.7071*sqrt(v(isx)*v(isx)+v(isy)*v(isy))} tripdv={tdv} tripdt={tdt} 
Eap p 0 VALUE={3*(v(usx)*v(isx)/2+v(usy)*v(isy)/2)}  tripdv={tdv} tripdt={tdt}
Eaq q 0 VALUE={3*(v(usy)*v(isx)/2-v(usx)*v(isy)/2)} tripdv={tdv} tripdt={tdt}
Es  s 0 VALUE={sqrt(v(p)*v(p)+v(q)*v(q))} tripdv={tdv} tripdt={tdt}
* Other formulas for active and reactive power
Ephiu phius 0 VALUE={180/pi*atan2(v(usy),v(usx))}  tripdv={tdv} tripdt={tdt} 
Ephii phiis 0 VALUE={180/pi*atan2(v(isy),v(isx))}  tripdv={tdv} tripdt={tdt}
Ephi phi 0 VALUE={(v(phius)-v(phiis))}   tripdv={tdv} tripdt={tdt}
* Other formula for up
*Eup2 up2 0 VALUE={sqrt((v(u)-v(i)*v(xd)*sin(pi/180*v(phi)))*(v(u)-v(i)*v(xd)*sin(pi/180*v(phi)))+(v(i)*v(xd)*cos(pi/180*v(phi)))*(v(i)*v(xd)*cos(pi/180*v(phi))))}  
Eup up 0 VALUE={(v(usy)-v(isx)*v(xd))/sqrt(2)} tripdv={tdv} tripdt={tdt}
*
Ews wmagnstator 0 VALUE={1.5*0.5*(v(psisx)*v(isx)+v(psisy)*v(isy))} tripdv={tdv} tripdt={tdt}
Ewe wmagnexciter 0 VALUE={1.5*0.5*v(psie)*v(ie)} tripdv={tdv} tripdt={tdt}
Ewd wmagndamper 0 VALUE={1.5*0.5*(v(psidx)*v(idx)+v(psidy)*v(idy))}  tripdv={tdv} tripdt={tdt}
Ewsumm wmagnsum 0 VALUE={v(wmagnstator)+v(wmagndamper)+v(wmagnexciter)} tripdv={tdv} tripdt={tdt}
*
* Psum2=Psum3 P from Wmagn ( P=dWmagn/dt )
Etest Psum2 0 VALUE={v(Pstator)+v(Pexciter)+v(Pdamper)} tripdv={tdv} tripdt={tdt} 
Etest2 Psum3 0 VALUE={DDT(v(wmagnstator))+DDT(v(wmagnexciter))+DDT(v(wmagndamper))} tripdv={tdv} tripdt={tdt} 
*
EPstator Pstator  0 VALUE={1.5*(v(isx)*DDT(v(psisx)))+1.5*(v(isy)*DDT(v(psisy)))} tripdv={tdv} tripdt={tdt} 
* Exciter is fed by external unit
EPexiter Pexciter 0 VALUE={1.5*(v(ie)*DDT(v(psie)))} tripdv={tdv} tripdt={tdt}
EPdamper Pdamper 0 VALUE={1.5*(v(idx)*DDT(v(psidx))+v(idy)*DDT(v(psidy)))} tripdv={tdv} tripdt={tdt}
EPsum1 Psum1 0 VALUE={v(Pstator)+v(Pdamper)+v(Pexciter)} tripdv={tdv} tripdt={tdt}
EPsum Psum 0 VALUE={v(Psum1)+V(Pcusum)-v(Pcu3)-v(Pexciter)-V(P)+V(rbg)*omega_el/p} tripdv={tdv} tripdt={tdt}
EPM   Pmech 0 VALUE={-v(M)*omega_el/p} tripdv={tdv} tripdt={tdt}
* other formulas for theta theta2 for non salient machine and theta3 for salient machine
*Etheta2 theta2 0 VALUE={-180/pi*atan2(v(i)*v(xd)*cos(pi/180*v(phi)),(v(u)-v(i)*v(xd)*sin(pi/180*v(phi))))}  ;for round pole
*Etheta3 theta3 0 VALUE={-180/pi*atan2(v(i)*v(xq)*cos(pi/180*v(phi)),(v(u)-v(i)*v(xq)*sin(pi/180*v(phi))))}  ;for salient pole
*
* Qtsum = Qtstator + Qtdamper = -Qtexciter
EQtransf1 Qtstator 0 VALUE={1.5*(v(isx)*DDT(v(psisy))-v(isy)*DDT(v(psisx)))} tripdv={tdv} tripdt={tdt}
EQtransf2 Qtexciter 0 VALUE={1.5*(v(isx)*DDT(v(psihx)))} tripdv={tdv} tripdt={tdt}
EQtransf3 Qtdamper 0 VALUE={1.5*(v(isx)*DDT(v(psihx))+v(isy)*DDT(v(psihy)))} tripdv={tdv} tripdt={tdt}
EQtranssum Qtsum 0 VALUE={v(Qtstator)+v(Qtdamper)} tripdv={tdv} tripdt={tdt}
EQmagn1 Qrotstator 0 VALUE={1.5*omega_el*(v(isx)*v(isx)*(v(Lhd3)+Lsd)+v(isy)*v(isy)*(v(Lhq3)+Lsq))} tripdv={tdv} tripdt={tdt}
EQmagn2 Qrotexciter 0 VALUE={1.5*omega_el*(v(ie)*v(isx)*v(Lhd3))} tripdv={tdv} tripdt={tdt}
EQmagn3 Qrotdamper 0 VALUE={1.5*omega_el*(v(isx)*v(idx)*v(Lhd3)+v(idy)*v(isy)*v(Lhq3))} tripdv={tdv} tripdt={tdt}
EQexciter Qexciter 0 VALUE={v(Qrotexciter)+v(Qtexciter)}  tripdv={tdv} tripdt={tdt}
EQstator Qstator 0 VALUE={v(Qrotstator)+v(Qtstator)}  tripdv={tdv} tripdt={tdt}
EQdamper Qdamper 0 VALUE={v(Qrotdamper)+v(Qtdamper)} tripdv={tdv} tripdt={tdt}
* Qsum = Qstator + Qdamper - Qext = -Qexciter 
EQsum Qsum 0 VALUE={v(Qstator)+v(Qdamper)-V(Q)} tripdv={tdv} tripdt={tdt}
.ENDS 

.subckt sgen_12kW_type2 U1 V1 W1 F1 M n GND1 params:
+	UN_verkettet=400V
+	IN=21A
+	Pel=12kW  ;UN_verkettet*IN*sqrt(3)*cosphi of 0.8
+	fn={fn1}
+	Kc=0.5
+	UE0=48V ; Power of exciter = 0.25-5% * SN machine (smaller values for higher SN)
+	IE0=5A
+	p=2
+	Streuung=0.05
+	rcu=0.05
+	rbg=0.05
+	Schenkelpolfaktor=1 ;(1=cylindrical pole 0.5=Salient pole)
+	Daempferfaktor=1
+   taumech=2.3 ; parameter for inertia J={p*taumech*MN/omega_el}
+  n0=1500 ; initial speed
+  alpha_0=0
+  err0=0 RE_factor=0.6666 ;Matlab compatible with RE_factor=2/3=0.6666
+   Mvz=1
.PARAM
+	UN={UN_verkettet/sqrt(3)}
+	ZN={UN/IN}
+   XD={UN/IN/Kc}
+   XQ={XD*Schenkelpolfaktor}
+	Rs={ZN*rcu}
+	omega_el={(2*pi)*fN}
;+	 g={IE0/((1+Streuung)*Kc*IN*sqrt(2))}
+	Ls={Streuung*ZN/Kc/omega_el}
+	PsiN={sqrt(2)*UN/omega_el}
+	RE={UE0/IE0}
+	RD={Rs/Daempferfaktor}
+  RDx={RD} ; can be overwritten by setting this parameters directly here to a numerical value
+  RDy={RD} ; can be overwritten by setting this parameters directly here to a numerical value
+  LDx={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+  LDy={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+  LE={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+  R0={Rs} ; can be overwritten by setting this parameters directly here to a numerical value
+  L0={Ls} ; can be overwritten by setting this parameters directly here to a numerical value(X0 is 0.03-0.1 p.u)
+  Lsd={Ls}
+  Lsq={Ls}
+  Lhd3={XD/(2*pi*fn)-Lsd}
+  Lhq3={XQ/(2*pi*fn)-Lsq}
+   g={UE0/(UN*sqrt(2)*RE/(XD-omega_el*Lsd))}
+	MN={Pel*(1-rbg-rcu)*p/omega_el}
+   J= {p*taumech*MN/omega_el}
* magnetic voltage  UE0, IE0
* NOTE: Measurement of g: set g=1 see the voltage output of generator
* make now g smaller until the nominal voltage of the generator is present
Rf1 f1 0 1e12
Rm1  m  0 1e12
Rn1  n  0 1e12
Eun un 0 VALUE={Un} tripdv={tdv} tripdt={tdt}
Ein in 0 VALUE={In} tripdv={tdv} tripdt={tdt}
Esn sn 0 VALUE={3*Un*In} tripdv={tdv} tripdt={tdt}
Epn pn 0 VALUE={pel} tripdv={tdv} tripdt={tdt}
Ecosphin cosphi 0 VALUE={pel/(3*Un*In)} tripdv={tdv} tripdt={tdt}
Ezn zn 0 VALUE={Zn} tripdv={tdv} tripdt={tdt}
Ers rs 0 VALUE={Rs} tripdv={tdv} tripdt={tdt}
* New
Epcu pcu 0 VALUE={3*v(i)*v(i)*Rs} tripdv={tdv} tripdt={tdt}
* Pcu1 same as Pcu
*Epcu1 pcu1 0 VALUE={1.5*Rs*(v(isx)*v(isx)+v(isy)*v(isy))} tripdv={tdv} tripdt={tdt}
Epcu2 pcu2 0 VALUE={v(idx)*v(idx)*RDx+v(idy)*v(idy)*RDy} tripdv={tdv} tripdt={tdt}
* This loss is fed by the external exciter !!!! Pcu_exciter=UE*IE
Epcu3 pcu3 0 VALUE={v(ie)*v(ie)*g*g*Re*RE_factor} tripdv={tdv} tripdt={tdt}
Epcusum pcusum 0 VALUE={v(pcu)+v(pcu2)+v(pcu3)} tripdv={tdv} tripdt={tdt}
* Null-System
Gi0    0    i0    VALUE=
+ {((v(U1,U2)+v(V1,V2)+v(W1,W2))/3-R0*v(i0))/L0} tripdv={tdv} tripdt={tdt}
Ci0    i0    0    1    IC=0
Ri0    i0    0    1E6
*    Stator voltages in the d-q system
Guxs    0    usxs    VALUE={2/3*v(U1,U2)-v(V1,V2)/3-v(W1,W2)/3} tripdv={tdv} tripdt={tdt}; statorfix
Guys    0    usys    VALUE={(v(V1,V2)-v(W1,W2))/sqrt(3)} tripdv={tdv} tripdt={tdt}; statorfix
Ruxs    usxs    0    1
Ruys    usys    0    1
Guxr    0    usx    VALUE={v(usxs)*v(cosa)+v(usys)*v(sina)} tripdv={tdv} tripdt={tdt}; rotorfix
Guyr    0    usy    VALUE={v(usys)*v(cosa)-v(usxs)*v(sina)} tripdv={tdv} tripdt={tdt}; rotorfix
Ruxr    usx    0    1
Ruyr    usy    0    1
*    Magnetic fluxes in the d-q system
Gpsx    0    psisx    VALUE={v(usx)-Rs*v(isx)+p*(2*pi)/60*v(n)*v(psisy)} tripdv={tdv} tripdt={tdt}
Gpe     0    psie    VALUE={v(F1)*g*RE_factor   -RE*RE_factor*g*g*v(iE) } tripdv={tdv} tripdt={tdt} ;<--------- MATLAB compatible 
Gpdx    0    psidx    VALUE={0     -RDx*v(idx)              } tripdv={tdv} tripdt={tdt}
Rpsx    psisx        0        1MEG
Rpe     psie         0        1MEG
Rpdx    psidx        0        1MEG
Cpsx    psisx        0        1    IC={err0*psiN}
Cpe     psie         0        1    IC={err0*psiN*(1+Streuung)}
Cpdx    psidx        0        1    IC={err0*psiN}
Gpsy    0    psisy    VALUE={v(usy)-Rs*v(isy)-p*(2*pi)/60*v(n)*v(psisx)} tripdv={tdv} tripdt={tdt}
Gpdy    0    psidy    VALUE={0     -RDy*v(idy)              } tripdv={tdv} tripdt={tdt}
Rpsy    psisy        0        1MEG
Rpdy    psidy        0        1MEG
Cpsy    psisy        0        1    IC=0
Cpdy    psidy        0        1    IC=0
*    Currents in the d-q system
Gisx    0    isx    VALUE={Lsd*v(isx)+Lhd3*(v(isx)+v(ie)+v(idx))-v(psisx)} tripdv={tdv} tripdt={tdt}
Gie     0    ie     VALUE={LE *v(ie)+Lhd3*(v(isx)+v(ie)+v(idx))-v(psie)} tripdv={tdv} tripdt={tdt}
Gidx    0    idx    VALUE={LDx*v(idx)+Lhd3*(v(isx)+v(ie)+v(idx))-v(psidx)} tripdv={tdv} tripdt={tdt}
Risx    isx        0        1MEG
Rie     ie         0        1MEG
Ridx    idx        0        1MEG
Gisy    0    isy     VALUE={Lsq*v(isy)+Lhq3*(v(isy)+v(idy))-v(psisy)} tripdv={tdv} tripdt={tdt}
Gidy    0    idy     VALUE={LDy*v(idy)+Lhq3*(v(isy)+v(idy))-v(psidy)} tripdv={tdv} tripdt={tdt}
Risy    isy        0        1MEG
Ridy    idy        0        1MEG
*    inner torque
Gm1     0    mi      VALUE={ Lhd3*(v(isx)+v(ie)+v(idx))*v(isy)} tripdv={tdv} tripdt={tdt}
Gm2     0    mi      VALUE={-Lhq3*(v(isy)+v(idy))      *v(isx)} tripdv={tdv} tripdt={tdt}
Rm      mi         0 {1.5*p}
*Emi		Mi	0	VALUE={1.5*p*(v(psihx)*v(isy)-v(psihy)*v(isx))} tripdv={tdv} tripdt={tdt}
*    Speed n
En    n        0     VALUE={n0+60/(2*pi)/J*V(n1)} tripdv={tdv} tripdt={tdt}
Gn    0       n1     VALUE={v(mi)+v(M)*Mvz-v(rbg)} tripdv={tdv} tripdt={tdt}
Cn    n1       0      1    IC=0                    
Rn    n1       0      1MEG
*    Friction
GRbg  0	   Rbg1	   TABLE {v(n)} (-1,-1) (1,1)
RRbg  Rbg1	0	   1
ERbg  Rbg   0      VALUE={v(Rbg1)*MN*rbg} tripdv={tdv} tripdt={tdt}
*    angle alpha
Gal   0       alpha  VALUE={p/60*(2*pi)*v(n)} tripdv={tdv} tripdt={tdt}
Cal   alpha   0      1    IC={alpha_0*pi/180}
Ral   alpha   0      1E10
Gcos  0       cosa   VALUE={cos(v(alpha))} tripdv={tdv} tripdt={tdt}
Gsin  0       sina   VALUE={sin(v(alpha))} tripdv={tdv} tripdt={tdt}
Rcos  cosa    0      1
Rsin  sina    0      1
*    stator currents u,v,w system double translation
* isxs=isx*cosa-isy*sina  isys=isy*cosa+isx*sina
*G1 U1 U2 VALUE={v(isxS)+v(i_Null)}
*G2 V1 V2 VALUE={(-v(isxS)+v(isyS)*sqrt(3))/2+v(i_Null)}
*G3 W1 W2 VALUE={(-v(isxS)-v(isyS)*sqrt(3))/2+v(i_Null)}
Gi1    U1    U2     VALUE={v(isx)*v(cosa)-v(isy)*v(sina)+v(i0)} tripdv={tdv} tripdt={tdt}
Gi2a   V1    V2     VALUE={ ((sqrt(3)/2)*v(isy)-v(isx)/2)*v(cosa)} tripdv={tdv} tripdt={tdt}
Gi2b   V1    V2     VALUE={ (v(isy)/2+(sqrt(3)/2)*v(isx))*v(sina) +v(i0)} tripdv={tdv} tripdt={tdt}
Gi3a   W1    W2     VALUE={-((sqrt(3)/2)*v(isy)+v(isx)/2)*v(cosa)} tripdv={tdv} tripdt={tdt}
Gi3b   W1    W2     VALUE={ (v(isy)/2-(sqrt(3)/2)*v(isx))*v(sina) +v(i0)} tripdv={tdv} tripdt={tdt}
GiE2	F1	0	VALUE={v(ie)*g} tripdv={tdv} tripdt={tdt}
*    Starpoint
R2     v2    GND1   1u
R12    u2    GND1   1u
R23    w2    GND1   1u
RGND1  GND1  0  1e6
*    Some measurements (active power, reactive power, load angle)
Etheta theta 0 VALUE={180/pi*atan2(v(usx),v(usy))} tripdv={tdv} tripdt={tdt}
Eimx imx 0 VALUE={v(isx)+v(idx)+v(ie)} tripdv={tdv} tripdt={tdt};magnetizing current
Eimy imy 0 VALUE={v(isy)+v(idy)}       tripdv={tdv} tripdt={tdt};magnetizing current
*
Ev Us 0 VALUE={sqrt(v(usx)*v(usx)+v(usy)*v(usy))} tripdv={tdv} tripdt={tdt}
* Xd=Xq for cylindrical pole machine Xd,Xq different for salient pole
Elhd3 Lhd3 0 VALUE={Lhd3} tripdv={tdv} tripdt={tdt}
Elhq3 Lhq3 0 VALUE={Lhq3} tripdv={tdv} tripdt={tdt}
Exd xd 0 VALUE={Xd} tripdv={tdv} tripdt={tdt} ;better measured from sliptest
Exq xq 0 VALUE={Xq}   tripdv={tdv} tripdt={tdt} ;better measured from sliptest
* New added
Epsihx psihx 0 VALUE={v(psisx)-Lsd*v(isx)} tripdv={tdv} tripdt={tdt}
Epsihy psihy 0 VALUE={v(psisy)-Lsq*v(isy)} tripdv={tdv} tripdt={tdt}
Epsihx1 psihx1 0 VALUE={v(psidx)-Ldx*v(iDx)} tripdv={tdv} tripdt={tdt};same as pshihx
Epsihy1 psihy1 0 VALUE={v(psidy)-Ldy*v(iDy)} tripdv={tdv} tripdt={tdt};same as pshihy
Epsihx2 psihx2 0 VALUE={v(psie)-Le*v(ie)}    tripdv={tdv} tripdt={tdt};same as pshihx
Eg  g 0 VALUE={g} tripdv={tdv} tripdt={tdt}
EU  u 0 VALUE={v(us)*sqrt(3)/sqrt(2)} tripdv={tdv} tripdt={tdt}
Ei  i 0 VALUE={0.7071*sqrt(v(isx)*v(isx)+v(isy)*v(isy))} tripdv={tdv} tripdt={tdt}
Eap p 0 VALUE={3*(v(usx)*v(isx)/2+v(usy)*v(isy)/2)}  tripdv={tdv} tripdt={tdt}
Eaq q 0 VALUE={3*(v(usy)*v(isx)/2-v(usx)*v(isy)/2)} tripdv={tdv} tripdt={tdt}
Es  s 0 VALUE={sqrt(v(p)*v(p)+v(q)*v(q))} tripdv={tdv} tripdt={tdt}
* Compute f
Ef      f   0  VALUE={v(n)*p/60} tripdv={tdv} tripdt={tdt}
* Other formulas for active and reactive power
* Some qz work for salient qy for nonsalient machines
*Eaq2 qx 0 VALUE={3*v(u)*v(i)*sin(pi/180*v(phi))} tripdv={tdv} tripdt={tdt}
*Eaq3 qy 0 VALUE={-3*v(up)*v(u)/v(xd)*cos(v(theta2)*pi/180)+3*v(u)*v(u)/v(xd)} tripdv={tdv} tripdt={tdt}; for round pole
*Eaq4 qz 0 VALUE={-3*v(up)*v(u)/v(xd)*cos(v(theta3)*pi/180)+3*v(u)*v(u)/2*(1/v(xq)+1/v(xd))-3*v(u)*v(u)/2*(1/v(xq)-1/v(xd))*cos(2*v(theta3)*pi/180)} tripdv={tdv} tripdt={tdt}; for salient pole
*Eap2 px 0 VALUE={3*v(u)*v(i)*cos(pi/180*v(phi))} tripdv={tdv} tripdt={tdt}
*Eap3 py 0 VALUE={-3*v(up)*v(u)/v(xd)*sin(v(theta2)*pi/180)} tripdv={tdv} tripdt={tdt}; for round pole
*Eap4 pz 0 VALUE={-3*v(up)*v(u)/v(xd)*sin(v(theta3)*pi/180)-3*v(u)*v(u)/2*(1/v(xq)-1/v(xd))*sin(2*v(theta3)*pi/180)} tripdv={tdv} tripdt={tdt}; for salient pole
Ephiu phius 0 VALUE={180/pi*atan2(v(usy),v(usx))}  tripdv={tdv} tripdt={tdt}
Ephii phiis 0 VALUE={180/pi*atan2(v(isy),v(isx))}  tripdv={tdv} tripdt={tdt}
Ephi phi 0 VALUE={(v(phius)-v(phiis))}   tripdv={tdv} tripdt={tdt}
* Other formula for up
*Eup2 up2 0 VALUE={sqrt((v(u)-v(i)*v(xd)*sin(pi/180*v(phi)))*(v(u)-v(i)*v(xd)*sin(pi/180*v(phi)))+(v(i)*v(xd)*cos(pi/180*v(phi)))*(v(i)*v(xd)*cos(pi/180*v(phi))))}  tripdv={tdv} tripdt={tdt}
Eup up 0 VALUE={(v(usy)-v(isx)*v(xd))/sqrt(2)} tripdv={tdv} tripdt={tdt}
*
Ews wmagnstator 0 VALUE={1.5*0.5*(v(psisx)*v(isx)+v(psisy)*v(isy))} tripdv={tdv} tripdt={tdt}
Ewe wmagnexciter 0 VALUE={1.5*0.5*v(psie)*v(ie)} tripdv={tdv} tripdt={tdt}
Ewd wmagndamper 0 VALUE={1.5*0.5*(v(psidx)*v(idx)+v(psidy)*v(idy))}  tripdv={tdv} tripdt={tdt}
Ewsumm wmagnsum 0 VALUE={v(wmagnstator)+v(wmagndamper)+v(wmagnexciter)} tripdv={tdv} tripdt={tdt}
*
* Psum2=Psum3 P from Wmagn ( P=dWmagn/dt )
Etest Psum2 0 VALUE={v(Pstator)+v(Pexciter)+v(Pdamper)} tripdv={tdv} tripdt={tdt} 
Etest2 Psum3 0 VALUE={DDT(v(wmagnstator))+DDT(v(wmagnexciter))+DDT(v(wmagndamper))} tripdv={tdv} tripdt={tdt} 
*
EPstator Pstator  0 VALUE={1.5*(v(isx)*DDT(v(psisx)))+1.5*(v(isy)*DDT(v(psisy)))} tripdv={tdv} tripdt={tdt} 
* Exciter is fed by external unit
EPexiter Pexciter 0 VALUE={1.5*(v(ie)*DDT(v(psie)))} tripdv={tdv} tripdt={tdt}
EPdamper Pdamper 0 VALUE={1.5*(v(idx)*DDT(v(psidx))+v(idy)*DDT(v(psidy)))} tripdv={tdv} tripdt={tdt}
EPsum1 Psum1 0 VALUE={v(Pstator)+v(Pdamper)+v(Pexciter)} tripdv={tdv} tripdt={tdt}
EPsum Psum 0 VALUE={v(Psum1)+V(Pcusum)-v(Pcu3)-v(Pexciter)-V(P)+V(rbg)*omega_el/p} tripdv={tdv} tripdt={tdt}
EPM   Pmech 0 VALUE={-v(M)*omega_el/p} tripdv={tdv} tripdt={tdt}
* other formulas for theta theta2 for non salient machine and theta3 for salient machine
*Etheta2 theta2 0 VALUE={-180/pi*atan2(v(i)*v(xd)*cos(pi/180*v(phi)),(v(u)-v(i)*v(xd)*sin(pi/180*v(phi))))}  ;for round pole
*Etheta3 theta3 0 VALUE={-180/pi*atan2(v(i)*v(xq)*cos(pi/180*v(phi)),(v(u)-v(i)*v(xq)*sin(pi/180*v(phi))))}  ;for salient pole
*
* Qtsum = Qtstator + Qtdamper = -Qtexciter
EQtransf1 Qtstator 0 VALUE={1.5*(v(isx)*DDT(v(psisy))-v(isy)*DDT(v(psisx)))} tripdv={tdv} tripdt={tdt}
EQtransf2 Qtexciter 0 VALUE={1.5*(v(isx)*DDT(v(psihx)))} tripdv={tdv} tripdt={tdt}
EQtransf3 Qtdamper 0 VALUE={1.5*(v(isx)*DDT(v(psihx))+v(isy)*DDT(v(psihy)))} tripdv={tdv} tripdt={tdt}
EQtranssum Qtsum 0 VALUE={v(Qtstator)+v(Qtdamper)} tripdv={tdv} tripdt={tdt}
EQmagn1 Qrotstator 0 VALUE={1.5*omega_el*(v(isx)*v(isx)*(v(Lhd3)+Lsd)+v(isy)*v(isy)*(v(Lhq3)+Lsq))} tripdv={tdv} tripdt={tdt}
EQmagn2 Qrotexciter 0 VALUE={1.5*omega_el*(v(ie)*v(isx)*v(Lhd3))} tripdv={tdv} tripdt={tdt}
EQmagn3 Qrotdamper 0 VALUE={1.5*omega_el*(v(isx)*v(idx)*v(Lhd3)+v(idy)*v(isy)*v(Lhq3))} tripdv={tdv} tripdt={tdt}
EQexciter Qexciter 0 VALUE={v(Qrotexciter)+v(Qtexciter)}  tripdv={tdv} tripdt={tdt}
EQstator Qstator 0 VALUE={v(Qrotstator)+v(Qtstator)}  tripdv={tdv} tripdt={tdt}
EQdamper Qdamper 0 VALUE={v(Qrotdamper)+v(Qtdamper)} tripdv={tdv} tripdt={tdt}
* Qsum = Qstator + Qdamper - Qext = -Qexciter 
EQsum Qsum 0 VALUE={v(Qstator)+v(Qdamper)-V(Q)} tripdv={tdv} tripdt={tdt}
.ends

.subckt sgen_12kW_type3 U1 V1 W1 F1 M n GND1 params:
+	UN_verkettet=400V
+	IN=21A
+	Pel=12kW  ;UN_verkettet*IN*sqrt(3)*cosphi of 0.8
+	fn={fn1}
+	Kc=0.5
+	UE0=48V ; Power of exciter = 0.25-5% * SN machine (smaller values for higher SN)
+	IE0=5A
+	p=2
+	Streuung=0.05
+	rcu=0.05
+	rbg=0.05
+	Schenkelpolfaktor=1 ;(1=cylindrical pole 0.5=Salient pole)
+	Daempferfaktor=1
+   taumech=2.3 ; parameter for inertia J={p*taumech*MN/omega_el}
+  n0=1500 ; initial speed
+  a=0.9
+  m=7
+  alpha_0=0
+  err0=0 RE_factor=0.6666 ;Matlab compatible with RE_factor=2/3=0.6666
+   Mvz=1
.PARAM
+  a1={a}
+  m1={m}
+  a2={a}
+  m2={m}
+	UN={UN_verkettet/sqrt(3)}
+	ZN={UN/IN}
+   XD={UN/IN/Kc}
+   XQ={XD*Schenkelpolfaktor}
+	Rs={ZN*rcu}
+	omega_el={(2*pi)*fN}
;+	 g={IE0/((1+Streuung)*Kc*IN*sqrt(2))}
+	Ls={Streuung*ZN/Kc/omega_el}
+	PsiN={sqrt(2)*UN/omega_el}
+	RE={UE0/IE0}
+	RD={Rs/Daempferfaktor}
+  RDx={RD} ; can be overwritten by setting this parameters directly here to a numerical value
+  RDy={RD} ; can be overwritten by setting this parameters directly here to a numerical value
+  LDx={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+  LDy={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+  LE={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+  R0={Rs} ; can be overwritten by setting this parameters directly here to a numerical value
+  L0={Ls} ; can be overwritten by setting this parameters directly here to a numerical value(X0 is 0.03-0.1 p.u)
+  Lsd={Ls}
+  Lsq={Ls}
+  Lhd3={XD/(2*pi*fn)-Lsd}
+  Lhq3={XQ/(2*pi*fn)-Lsq}
+   g={UE0/(UN*sqrt(2)*RE/(XD-omega_el*Lsd))}
+	MN={Pel*(1-rbg-rcu)*p/omega_el}
+   J= {p*taumech*MN/omega_el}
+   taumech=6.23 ; parameter for inertia J={p*taumech*MN/omega_el}
* magnetic voltage  UE0, IE0
* NOTE: Measurement of g: set g=1 see the voltage output of generator
* make now g smaller until the nominal voltage of the generator is present
Rf1 f1 0 1e12
Rm1  m  0 1e12
Rn1  n  0 1e12
Eun un 0 VALUE={Un} tripdv={tdv} tripdt={tdt}
Ein in 0 VALUE={In} tripdv={tdv} tripdt={tdt}
Esn sn 0 VALUE={3*Un*In} tripdv={tdv} tripdt={tdt}
Epn pn 0 VALUE={pel} tripdv={tdv} tripdt={tdt}
Ecosphin cosphi 0 VALUE={pel/(3*Un*In)} tripdv={tdv} tripdt={tdt}
Ezn zn 0 VALUE={Zn} tripdv={tdv} tripdt={tdt}
Ers rs 0 VALUE={Rs} tripdv={tdv} tripdt={tdt}
* New
Epcu pcu 0 VALUE={3*v(i)*v(i)*Rs} tripdv={tdv} tripdt={tdt}
* Pcu1 same as Pcu
*Epcu1 pcu1 0 VALUE={1.5*Rs*(v(isx)*v(isx)+v(isy)*v(isy))} tripdv={tdv} tripdt={tdt}
Epcu2 pcu2 0 VALUE={v(idx)*v(idx)*RDx+v(idy)*v(idy)*RDy} tripdv={tdv} tripdt={tdt}
* This loss is fed by the external exciter !!!! Pcu_exciter=UE*IE
Epcu3 pcu3 0 VALUE={v(ie)*v(ie)*g*g*Re*RE_factor} tripdv={tdv} tripdt={tdt}
Epcusum pcusum 0 VALUE={v(pcu)+v(pcu2)+v(pcu3)} tripdv={tdv} tripdt={tdt}
* Null-System
Gi0    0    i0    VALUE=
+ {((v(U1,U2)+v(V1,V2)+v(W1,W2))/3-R0*v(i0))/L0} tripdv={tdv} tripdt={tdt}
Ci0    i0    0    1    IC=0
Ri0    i0    0    1E6
*    Stator voltages in the d-q system
Guxs    0    usxs    VALUE={2/3*v(U1,U2)-v(V1,V2)/3-v(W1,W2)/3} tripdv={tdv} tripdt={tdt}; statorfix
Guys    0    usys    VALUE={(v(V1,V2)-v(W1,W2))/sqrt(3)} tripdv={tdv} tripdt={tdt}; statorfix
Ruxs    usxs    0    1
Ruys    usys    0    1
Guxr    0    usx    VALUE={v(usxs)*v(cosa)+v(usys)*v(sina)} tripdv={tdv} tripdt={tdt}; rotorfix
Guyr    0    usy    VALUE={v(usys)*v(cosa)-v(usxs)*v(sina)} tripdv={tdv} tripdt={tdt}; rotorfix
Ruxr    usx    0    1
Ruyr    usy    0    1
*    Magnetic fluxes in the d-q system
Gpsx    0    psisx    VALUE={v(usx)-Rs*v(isx)+p*(pi/30)*v(n)*v(psisy)} tripdv={tdv} tripdt={tdt}
Gpe     0    psie    VALUE={v(F1)*g*RE_factor   -RE*RE_factor*g*g*v(iE) } tripdv={tdv} tripdt={tdt} ;<--------- MATLAB compatible 
Gpdx    0    psidx    VALUE={0     -RDx*v(idx)              } tripdv={tdv} tripdt={tdt}
Rpsx    psisx        0        1MEG
Rpe     psie         0        1MEG
Rpdx    psidx        0        1MEG
Cpsx    psisx        0        1    IC={err0*psiN}
Cpe     psie         0        1    IC={err0*psiN*(1+Streuung)}
Cpdx    psidx        0        1    IC={err0*psiN}
Gpsy    0    psisy    VALUE={v(usy)-Rs*v(isy)-p*(pi/30)*v(n)*v(psisx)} tripdv={tdv} tripdt={tdt}
Gpdy    0    psidy    VALUE={0     -RDy*v(idy)              } tripdv={tdv} tripdt={tdt}
Rpsy    psisy        0        1MEG
Rpdy    psidy        0        1MEG
Cpsy    psisy        0        1    IC=0
Cpdy    psidy        0        1    IC=0
*    Currents
Gisx    0    isx        VALUE={Lsd*v(isx)+v(Lhd3)*(v(isx)+v(ie)+v(idx))-v(psisx)} tripdv={tdv} tripdt={tdt}
Gie        0    ie        VALUE={LE *v(ie)+v(Lhd3)*(v(isx)+v(ie)+v(idx))-v(psie)} tripdv={tdv} tripdt={tdt}
Gidx    0    idx       VALUE={LDx*v(idx)+v(Lhd3)*(v(isx)+v(ie)+v(idx))-v(psidx)} tripdv={tdv} tripdt={tdt}
Risx    isx        0        1MEG
Rie     ie         0        1MEG
Ridx    idx       0        1MEG
Gisy    0    isy       VALUE={Lsq*v(isy)+v(Lhq3)*(v(isy)+v(idy))-v(psisy)} tripdv={tdv} tripdt={tdt}
Gidy    0    idy       VALUE={LDy*v(idy)+v(Lhq3)*(v(isy)+v(idy))-v(psidy)} tripdv={tdv} tripdt={tdt}
Risy    isy    0    1MEG
Ridy    idy    0    1MEG
* nonlinear magnetics
Elhd3 Lhd3 0 VALUE={Lhd3*(1/(a1+(1-a1)*PWRS(LIMIT(abs(v(psihx)+1p)/PsiN,-10,10),m1-1)))} tripdv={tdv} tripdt={tdt}
Elhq3 Lhq3 0 VALUE={Lhq3*(1/(a2+(1-a2)*PWRS(LIMIT(abs(v(psihy)+1p)/PsiN,-10,10),m2-1)))} tripdv={tdv} tripdt={tdt}
*    inner torque and friction
*Gm1     0    mi      VALUE={ v(Lhd3)*(v(isx)+v(ie)+v(idx))*v(isy)} tripdv={tdv} tripdt={tdt}
*Gm2     0    mi      VALUE={-v(Lhq3)*(v(isy)+v(idy))*v(isx)} tripdv={tdv} tripdt={tdt}
*Rm      mi    0      {1.5*p}
Emi		Mi	0	VALUE={1.5*p*(v(psihx)*v(isy)-v(psihy)*v(isx))} tripdv={tdv} tripdt={tdt}
*    Speed n
En    n        0     VALUE={n0+60/(2*pi)/J*V(n1)} tripdv={tdv} tripdt={tdt}
Gn    0       n1     VALUE={(v(mi)+v(M)*Mvz-v(rbg))} tripdv={tdv} tripdt={tdt}
Cn    n1       0      1    IC=0                    
Rn    n1       0      1MEG
*    Friction
GRbg  0	   Rbg1	   TABLE {v(n)} (-1,-1) (1,1)
RRbg  Rbg1	0	   1
ERbg  Rbg   0      VALUE={v(Rbg1)*MN*rbg} tripdv={tdv} tripdt={tdt}
*    angle alpha
Gal   0       alpha  VALUE={p/60*(2*pi)*v(n)} tripdv={tdv} tripdt={tdt}
Cal   alpha   0      1    IC={alpha_0*pi/180}
Ral   alpha   0      1E10
Gcos  0       cosa   VALUE={cos(v(alpha))} tripdv={tdv} tripdt={tdt}
Gsin  0       sina   VALUE={sin(v(alpha))} tripdv={tdv} tripdt={tdt}
Rcos  cosa    0      1
Rsin  sina    0      1
*    stator currents u,v,w system double translation
* isxs=isx*cosa-isy*sina  isys=isy*cosa+isx*sina
*G1 U1 U2 VALUE={v(isxS)+v(i_Null)}
*G2 V1 V2 VALUE={(-v(isxS)+v(isyS)*sqrt(3))/2+v(i_Null)}
*G3 W1 W2 VALUE={(-v(isxS)-v(isyS)*sqrt(3))/2+v(i_Null)}
Gi1    U1    U2     VALUE={v(isx)*v(cosa)-v(isy)*v(sina)+v(i0)} tripdv={tdv} tripdt={tdt}
Gi2a   V1    V2     VALUE={ ((sqrt(3)/2)*v(isy)-v(isx)/2)*v(cosa)} tripdv={tdv} tripdt={tdt}
Gi2b   V1    V2     VALUE={ (v(isy)/2+(sqrt(3)/2)*v(isx))*v(sina) +v(i0)} tripdv={tdv} tripdt={tdt}
Gi3a   W1    W2     VALUE={-((sqrt(3)/2)*v(isy)+v(isx)/2)*v(cosa)} tripdv={tdv} tripdt={tdt}
Gi3b   W1    W2     VALUE={ (v(isy)/2-(sqrt(3)/2)*v(isx))*v(sina) +v(i0)} tripdv={tdv} tripdt={tdt}
GiE2	F1	0	VALUE={v(ie)*g} tripdv={tdv} tripdt={tdt}
*    Starpoint
R2     v2    GND1   1u
R12    u2    GND1   1u
R23    w2    GND1   1u
RGND1  GND1  0  1e6
*    Some measurements (active power, reactive power, load angle)
Etheta theta 0 VALUE={180/pi*atan2(v(usx),v(usy))} tripdv={tdv} tripdt={tdt}
Eimx imx 0 VALUE={v(isx)+v(idx)+v(ie)} tripdv={tdv} tripdt={tdt};magnetizing current
Eimy imy 0 VALUE={v(isy)+v(idy)}       tripdv={tdv} tripdt={tdt};magnetizing current
*
Ev Us 0 VALUE={sqrt(v(usx)*v(usx)+v(usy)*v(usy))} tripdv={tdv} tripdt={tdt}
* Xd=Xq for cylindrical pole machine Xd,Xq different for salient pole
Exd xd 0 VALUE={(v(Lhd3)+Lsd)*2*pi*fn} tripdv={tdv} tripdt={tdt} ;better measured from sliptest
Exq xq 0 VALUE={(v(Lhq3)+Lsq)*2*pi*fn} tripdv={tdv} tripdt={tdt} ;better measured from sliptest
* New added
Epsihx psihx 0 VALUE={v(psisx)-Lsd*v(isx)} tripdv={tdv} tripdt={tdt}
Epsihy psihy 0 VALUE={v(psisy)-Lsq*v(isy)} tripdv={tdv} tripdt={tdt}
Epsihx1 psihx1 0 VALUE={v(psidx)-Ldx*v(iDx)} tripdv={tdv} tripdt={tdt};same as pshihx
Epsihy1 psihy1 0 VALUE={v(psidy)-Ldy*v(iDy)} tripdv={tdv} tripdt={tdt};same as pshihy
Epsihx2 psihx2 0 VALUE={v(psie)-Le*v(ie)}    tripdv={tdv} tripdt={tdt};same as pshihx
Eg  g 0 VALUE={g} tripdv={tdv} tripdt={tdt}
EU  u 0 VALUE={v(us)*sqrt(3)/sqrt(2)} tripdv={tdv} tripdt={tdt}
Ei  i 0 VALUE={0.7071*sqrt(v(isx)*v(isx)+v(isy)*v(isy))} tripdv={tdv} tripdt={tdt}
Eap p 0 VALUE={3*(v(usx)*v(isx)/2+v(usy)*v(isy)/2)}  tripdv={tdv} tripdt={tdt}
Eaq q 0 VALUE={3*(v(usy)*v(isx)/2-v(usx)*v(isy)/2)} tripdv={tdv} tripdt={tdt}
Es  s 0 VALUE={sqrt(v(p)*v(p)+v(q)*v(q))} tripdv={tdv} tripdt={tdt}
* Other formulas for active and reactive power
* Other formulas for active and reactive power
Ephiu phius 0 VALUE={180/pi*atan2(v(usy),v(usx))}  tripdv={tdv} tripdt={tdt} 
Ephii phiis 0 VALUE={180/pi*atan2(v(isy),v(isx))}  tripdv={tdv} tripdt={tdt}
Ephi phi 0 VALUE={(v(phius)-v(phiis))}   tripdv={tdv} tripdt={tdt}
* Other formula for up
*Eup2 up2 0 VALUE={sqrt((v(u)-v(i)*v(xd)*sin(pi/180*v(phi)))*(v(u)-v(i)*v(xd)*sin(pi/180*v(phi)))+(v(i)*v(xd)*cos(pi/180*v(phi)))*(v(i)*v(xd)*cos(pi/180*v(phi))))}  
Eup up 0 VALUE={(v(usy)-v(isx)*v(xd))/sqrt(2)} tripdv={tdv} tripdt={tdt}
*
Ews wmagnstator 0 VALUE={1.5*0.5*(v(psisx)*v(isx)+v(psisy)*v(isy))} tripdv={tdv} tripdt={tdt}
Ewe wmagnexciter 0 VALUE={1.5*0.5*v(psie)*v(ie)} tripdv={tdv} tripdt={tdt}
Ewd wmagndamper 0 VALUE={1.5*0.5*(v(psidx)*v(idx)+v(psidy)*v(idy))}  tripdv={tdv} tripdt={tdt}
Ewsumm wmagnsum 0 VALUE={v(wmagnstator)+v(wmagndamper)+v(wmagnexciter)} tripdv={tdv} tripdt={tdt}
*
* Psum2=Psum3 P from Wmagn ( P=dWmagn/dt )
Etest Psum2 0 VALUE={v(Pstator)+v(Pexciter)+v(Pdamper)} tripdv={tdv} tripdt={tdt} 
Etest2 Psum3 0 VALUE={DDT(v(wmagnstator))+DDT(v(wmagnexciter))+DDT(v(wmagndamper))} tripdv={tdv} tripdt={tdt} 
*
EPstator Pstator  0 VALUE={1.5*(v(isx)*DDT(v(psisx)))+1.5*(v(isy)*DDT(v(psisy)))} tripdv={tdv} tripdt={tdt} 
* Exciter is fed by external unit
EPexiter Pexciter 0 VALUE={1.5*(v(ie)*DDT(v(psie)))} tripdv={tdv} tripdt={tdt}
EPdamper Pdamper 0 VALUE={1.5*(v(idx)*DDT(v(psidx))+v(idy)*DDT(v(psidy)))} tripdv={tdv} tripdt={tdt}
EPsum1 Psum1 0 VALUE={v(Pstator)+v(Pdamper)+v(Pexciter)} tripdv={tdv} tripdt={tdt}
EPsum Psum 0 VALUE={v(Psum1)+V(Pcusum)-v(Pcu3)-v(Pexciter)-V(P)+V(rbg)*omega_el/p} tripdv={tdv} tripdt={tdt}
EPM   Pmech 0 VALUE={-v(M)*omega_el/p} tripdv={tdv} tripdt={tdt}
* other formulas for theta theta2 for non salient machine and theta3 for salient machine
*Etheta2 theta2 0 VALUE={-180/pi*atan2(v(i)*v(xd)*cos(pi/180*v(phi)),(v(u)-v(i)*v(xd)*sin(pi/180*v(phi))))}  ;for round pole
*Etheta3 theta3 0 VALUE={-180/pi*atan2(v(i)*v(xq)*cos(pi/180*v(phi)),(v(u)-v(i)*v(xq)*sin(pi/180*v(phi))))}  ;for salient pole
*
* Qtsum = Qtstator + Qtdamper = -Qtexciter
EQtransf1 Qtstator 0 VALUE={1.5*(v(isx)*DDT(v(psisy))-v(isy)*DDT(v(psisx)))} tripdv={tdv} tripdt={tdt}
EQtransf2 Qtexciter 0 VALUE={1.5*(v(isx)*DDT(v(psihx)))} tripdv={tdv} tripdt={tdt}
EQtransf3 Qtdamper 0 VALUE={1.5*(v(isx)*DDT(v(psihx))+v(isy)*DDT(v(psihy)))} tripdv={tdv} tripdt={tdt}
EQtranssum Qtsum 0 VALUE={v(Qtstator)+v(Qtdamper)} tripdv={tdv} tripdt={tdt}
EQmagn1 Qrotstator 0 VALUE={1.5*omega_el*(v(isx)*v(isx)*(v(Lhd3)+Lsd)+v(isy)*v(isy)*(v(Lhq3)+Lsq))} tripdv={tdv} tripdt={tdt}
EQmagn2 Qrotexciter 0 VALUE={1.5*omega_el*(v(ie)*v(isx)*v(Lhd3))} tripdv={tdv} tripdt={tdt}
EQmagn3 Qrotdamper 0 VALUE={1.5*omega_el*(v(isx)*v(idx)*v(Lhd3)+v(idy)*v(isy)*v(Lhq3))} tripdv={tdv} tripdt={tdt}
EQexciter Qexciter 0 VALUE={v(Qrotexciter)+v(Qtexciter)}  tripdv={tdv} tripdt={tdt}
EQstator Qstator 0 VALUE={v(Qrotstator)+v(Qtstator)}  tripdv={tdv} tripdt={tdt}
EQdamper Qdamper 0 VALUE={v(Qrotdamper)+v(Qtdamper)} tripdv={tdv} tripdt={tdt}
* Qsum = Qstator + Qdamper - Qext = -Qexciter 
EQsum Qsum 0 VALUE={v(Qstator)+v(Qdamper)-V(Q)} tripdv={tdv} tripdt={tdt}
.ends

* without measurement nodes
.SUBCKT Sgen_70MW U1 V1 W1  F1  M  n GND1
+	PARAMS:
+	UN_verkettet=10300
+	IN=5.125k
+	Pel=70e6  ;UN_verkettet*IN*sqrt(3)*cosphi of 0.8
+	fn={fn1}
+	Kc=0.5
+	UE0=600V ; Power of exciter = 0.25-5% * SN machine (smaller values for higher SN) (UEminmax=0.3-2*UE0) UE=100-600V(old) RE~0.1-1 (typical 0.2-0.5)
+	IE0=500A
+	p=2
+	Streuung=0.05 ;
+	rcu=0.01
+	rbg=0.001
+	Schenkelpolfaktor=1 ;(1=cylindrical pole 0.5=Salient pole)
+	Daempferfaktor=1
+	err0=0 RE_factor=0.6666 ;Matlab compatible with RE_factor=2/3=0.6666
+   n0=1500 ;starts with 1500U/min
+   alpha_0=0
+   taumech=6.23 ; parameter for inertia J={p*taumech*MN/omega_el}
+   a=0.9 ; Parameter for nonlinear noload line (should be about 0.6-0.9)
+   m=7
+   Mvz=1
.PARAM
+   a1={a};  Saturation parameter d-axis
+   m1={m};  Saturation parameter d-axis
+   a2={a1}; Saturation parameter q-axis ( default: same as d-axis -> may be overwritten if different from d-axis )
+   m2={m1}; Saturation parameter q-axis ( default: same as d-axis -> may be overwritten if different from d-axis )
+	UN={UN_verkettet/sqrt(3)}
+	ZN={UN/IN}
+	Rs={ZN*rcu}
+	omega_el={(2*pi)*fN}
+	Ls={Streuung*ZN/Kc/omega_el}
+	PsiN={sqrt(2)*UN/omega_el}
+	RE={UE0/IE0}
+	RD={Rs/Daempferfaktor}
+   RDx={RD} ; can be overwritten by setting this parameters directly here to a numerical value
+   RDy={RD} ; can be overwritten by setting this parameters directly here to a numerical value
+   LDx={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+   LDy={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+   LE={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+   R0={Rs} ; can be overwritten by setting this parameters directly here to a numerical value
+   L0={Ls} ; can be overwritten by setting this parameters directly here to a numerical value(X0 is 0.03-0.1 p.u)
+   Lsd={Ls} 
+   Lsq={Ls}
+   XD={UN/IN/Kc}
+   XQ={XD*Schenkelpolfaktor}
+   g={UE0/(UN*sqrt(2)*RE/(XD-omega_el*Lsd))} ; updated formula for g parameter
+   g1={UE0/(UN*sqrt(2)*RE/(XQ-omega_el*Lsq))} ; updated formula for salient pole machine
+	ImNx={IE0/g} ; d-axis magnetizing current
+	ImNy={IE0/g1} ;q-axis magnetizing current
+	MN={Pel*(1-rbg-rcu)*p/omega_el}
+   J= {p*taumech*MN/omega_el}
+  Lhd3={XD/(2*pi*fn)-Lsd}
+  Lhq3={XQ/(2*pi*fn)-Lsq}
*	Wicklungsstroeme
*	Wicklungsstroeme
Rf1 f1 0 1e12
Rm  m  0 1e12
Rn2  n  0 1e12
*	currents of windings
G1	U1	U2	VALUE={v(isxS)+v(i_Null)} tripdv={tdv} tripdt={tdt}
G2	V1	V2	VALUE={(-v(isxS)+v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
G3	W1	W2	VALUE={(-v(isxS)-v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
GiE	F1	0	VALUE={v(ie)*g} tripdv={tdv} tripdt={tdt}
*	voltage components
EuxS	usxS	0	VALUE={(2*v(u1,u2)-v(v1,v2)-v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
EuyS	usyS	0	VALUE={(v(v1,v2)-v(w1,w2))/sqrt(3)} tripdv={tdv} tripdt={tdt}
Eux	usx	0	VALUE={ v(usxS)*cos(v(alpha))+v(usyS)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
Euy	usy	0	VALUE={-v(usxS)*sin(v(alpha))+v(usyS)*cos(v(alpha))} tripdv={tdv} tripdt={tdt}
*    Starpoint
R2     v2    GND1   1u
R12    u2    GND1   1u
R23    w2    GND1   1u
RGND1  GND1  0  1e6
ErefL1 Uref_L1 0 VALUE={-sqrt(2)*UN*sin(2*pi*(fN*(TIME)))} tripdv={tdv} tripdt={tdt}
*	Nullsystem
Eu0	u_Null 0	VALUE={(v(u1,u2)+v(v1,v2)+v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
Ei0	i_Null 0	VALUE={v(idt1)/L0} tripdv={tdv} tripdt={tdt}
Gi0 0 idt1  VALUE={v(u_Null)-R0*v(i_null)} tripdv={tdv} tripdt={tdt}
Ci0 idt1 0 1 IC=0
Ri0 idt1 0 1e10
*	current components
EisxS		isxS	0 VALUE={v(isx)*cos(v(alpha))-v(isy)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
EisyS		isyS	0 VALUE={v(isy)*cos(v(alpha))+v(isx)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of direct axis with saturation
Gpsix		0	isx	VALUE={v(psisx)} tripdv={tdv} tripdt={tdt}
Rsx		isx	0	{1/Lsd}
Gpsidx	isx	iDx1	VALUE={v(psiDx)} tripdv={tdv} tripdt={tdt} ; *********
Rsdx		iDx1	isx	{1/LDx}
GpsiEx	iDx1	imx1	VALUE={v(psiE)} tripdv={tdv} tripdt={tdt} ; ie oder if ist iDx,imx !!!!
RsEx		imx1	iDx1	{1/LE}
vphx		imx1	imxa1	0
Eimx1		imxa1	0	VALUE={ImNx*(a1*i(vphx)/PsiN+(1-a1)*PWRS(i(vphx)/PsiN,m1))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of quadrature axis with saturation
Gpsiy		0	isy	VALUE={v(psisy)} tripdv={tdv} tripdt={tdt}
Rsy		isy	0	{1/Lsq}
Gpsidy	isy	imy1	VALUE={v(psiDy)} tripdv={tdv} tripdt={tdt}
Rsdy		imy1	isy	{1/LDy}
vphy		imy1	imya1	0
Eimy1		imya1	0	VALUE={ImNy*(a2*i(vphy)/PsiN+(1-a2)*PWRS(i(vphy)/PsiN,m2))} tripdv={tdv} tripdt={tdt}
*
Eidx  idx 0 VALUE={v(idx1)-v(isx)} tripdv={tdv} tripdt={tdt}
Eidy  idy 0 VALUE={v(imy1)-v(isy)} tripdv={tdv} tripdt={tdt}
Eie ie 0 VALUE={v(imx1)-v(idx1)} tripdv={tdv} tripdt={tdt}
Eimx imx 0 VALUE={v(isx)+v(idx)+v(ie)} tripdv={tdv} tripdt={tdt};magnetizing current d-axes
Eimy imy 0 VALUE={v(isy)+v(idy)}       tripdv={tdv} tripdt={tdt};magnetizing current q-axes
*	Flux components
Epsi_sx	psisx	0 VALUE={err0*PsiN+v(idt2)} tripdv={tdv} tripdt={tdt}
Gpsi_sx 0 idt2  VALUE={v(usx)-Rs*v(isx)+p*(2*pi)/60*v(n)*v(psisy)} tripdv={tdv} tripdt={tdt}
Cpsi_sx idt2 0 1 IC=0
Rpsi_sx idt2 0 1e10
*
Epsi_sy	psisy	0 VALUE={v(idt3)} tripdv={tdv} tripdt={tdt}
Gpsi_sy 0 idt3  VALUE={v(usy)-Rs*v(isy)-p*(2*pi)/60*v(n)*v(psisx)} tripdv={tdv} tripdt={tdt}
Cpsi_sy idt3 0 1 IC=0
Rpsi_sy idt3 0 1e10
*
Epsi_Dx	psiDx	0 VALUE={err0*psiN+v(idt4)} tripdv={tdv} tripdt={tdt}
Gpsi_Dx 0 idt4  VALUE={-RDx*v(idx)} tripdv={tdv} tripdt={tdt}
Cpsi_Dx idt4 0 1 IC=0
Rpsi_Dx idt4 0 1e10
*

Epsi_Dy	psiDy	0 VALUE={v(idt5)} tripdv={tdv} tripdt={tdt}
Gpsi_Dy 0 idt5  VALUE={-RDy*v(idy)} tripdv={tdv} tripdt={tdt}
Cpsi_Dy idt5 0 1 IC=0
Rpsi_Dy idt5 0 1e10
*
Epsi_E	psiE	0 VALUE={err0*psiN*(1+Streuung)+v(idt6)} tripdv={tdv} tripdt={tdt}
Gpsi_E 0 idt6  VALUE={v(F1,0)*g*RE_factor-RE*RE_factor*g*g*v(ie)} tripdv={tdv} tripdt={tdt} ;<--------- MATLAB compatible 
Cpsi_E idt6 0 1 IC=0
Rpsi_E idt6 0 1e10
*
*
Emi		Mi	0	VALUE={1.5*p*(i(Vphx)*v(isy)-i(Vphy)*v(isx))} tripdv={tdv} tripdt={tdt}
*Emi		Mi	0	VALUE={1.5*p*(v(psihx)*v(isy)-v(psihy)*v(isx))} tripdv={tdv} tripdt={tdt}
*Emi		Mi	0	VALUE={1.5*p*(v(psihx)*v(isy)-v(psihy)*v(isx))} tripdv={tdv} tripdt={tdt}
*EMoment	M 0	VALUE={-v(Mi)+v(Rbg)} tripdv={tdv} tripdt={tdt}
*En    n  0  Value={N1} tripdv={tdv} tripdt={tdt}
* Berechner n
* Compute n
En		n	0  VALUE={n0+60/(2*pi)/J*v(idt8)} tripdv={tdv} tripdt={tdt}
Gn 0 idt8  VALUE={v(M)*Mvz+v(Mi)-v(Rbg)} tripdv={tdv} tripdt={tdt}
Cn idt8 0 1 IC=0
Rn idt8 0 1e10
* friction
GRbg		0	Rbg	TABLE {v(n)} (-1,-1) (1,1)
RRbg		Rbg	0	{MN*rbg}
* Compute alpha
Ealpha	alpha	0	VALUE={alpha_0*pi/180+v(idt7)*p/60*(2*pi)} tripdv={tdv} tripdt={tdt}
Galpha 0 idt7  VALUE={v(n)} tripdv={tdv} tripdt={tdt}
Calpha idt7 0 1 IC=0
Ralpha idt7 0 1e10
*
Gtheta 0 theta VALUE={180/pi*atan2(v(usx),v(usy))} tripdv={tdv} tripdt={tdt}   ;Lastwinkel!!!!
Rtheta theta 0 1
Ctheta theta 0 10u
.ENDS

* without measurement nodes
.SUBCKT Sgen_70MW_constant_speed U1 V1 W1  F1  M  n GND1
+	PARAMS:
+	UN_verkettet=10300
+	IN={70e6/UN_verkettet/sqrt(3)/0.8} 
+	Pel=70e6  ;UN_verkettet*IN*sqrt(3)*cosphi of 0.8
+	fn={fn1}
+	Kc=0.5
+	UE0=600V ; Power of exciter = 0.25-5% * SN machine (smaller values for higher SN) (UEminmax=0.3-2*UE0) UE=100-600V(old) RE~0.1-1 (typical 0.2-0.5)
+	IE0=500A
+	p=2
+	Streuung=0.05 ;
+	rcu=0.01
+	rbg=0.001
+	Schenkelpolfaktor=1 ;(1=cylindrical pole 0.5=Salient pole)
+	Daempferfaktor=1
+	err0=0 RE_factor=0.6666 ;Matlab compatible with RE_factor=2/3=0.6666
+   n0=1500 ;starts with 1500U/min
+   n1={n0} ;starts with 1500U/min
+   alpha_0=0
+   a=0.9 ; Parameter for nonlinear noload line (should be about 0.6-0.9)
+   m=7
.PARAM
+   a1={a};  Saturation parameter d-axis
+   m1={m};  Saturation parameter d-axis
+   a2={a1}; Saturation parameter q-axis
+   m2={m1}; Saturation parameter q-axis
+	UN={UN_verkettet/sqrt(3)}
+	ZN={UN/IN}
+	Rs={ZN*rcu}
+	omega_el={(2*pi)*fN}
+	Ls={Streuung*ZN/Kc/omega_el}
+	PsiN={sqrt(2)*UN/omega_el}
+	RE={UE0/IE0}
+	RD={Rs/Daempferfaktor}
+   RDx={RD} ; can be overwritten by setting this parameters on modelline
+   RDy={RD} ; can be overwritten by setting this parameters on modelline
+   LDx={Ls} ; can be overwritten by setting this parameters on modelline
+   LDy={Ls} ; can be overwritten by setting this parameters on modelline
+   LE={Ls} ; can be overwritten by setting this parameters on modelline
+   R0={Rs} ; can be overwritten by setting this parameters on modelline
+   L0={Ls} ; can be overwritten by setting this parameters on modelline (X0 is 0.03-0.1 p.u)
+  Lsd={Ls}
+  Lsq={Ls}
+   XD={UN/IN/Kc}
+   XQ={XD*Schenkelpolfaktor}
+   g={UE0/(UN*sqrt(2)*RE/(XD-omega_el*Lsd))} ; updated formula for g parameter
+   g1={UE0/(UN*sqrt(2)*RE/(XQ-omega_el*Lsq))} ;updated formula for salient pole machine
+	ImNx={IE0/g} ; d-axis magnetizing current
+	ImNy={IE0/g1} ;q-axis magnetizing current
+	MN={Pel*(1-rbg-rcu)*p/omega_el}
+  Lhd3={XD/(2*pi*fn)-Lsd}
+  Lhq3={XQ/(2*pi*fn)-Lsq}
Rf1 f1 0 1e12
Rm  m  0 1e12
Rn2  n  0 1e12
*	currents of windings
G1	U1	U2	VALUE={v(isxS)+v(i_Null)} tripdv={tdv} tripdt={tdt}
G2	V1	V2	VALUE={(-v(isxS)+v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
G3	W1	W2	VALUE={(-v(isxS)-v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
GiE	F1	0	VALUE={v(ie)*g} tripdv={tdv} tripdt={tdt}
*	voltage components
EuxS	usxS	0	VALUE={(2*v(u1,u2)-v(v1,v2)-v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
EuyS	usyS	0	VALUE={(v(v1,v2)-v(w1,w2))/sqrt(3)} tripdv={tdv} tripdt={tdt}
Eux	usx	0	VALUE={ v(usxS)*cos(v(alpha))+v(usyS)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
Euy	usy	0	VALUE={-v(usxS)*sin(v(alpha))+v(usyS)*cos(v(alpha))} tripdv={tdv} tripdt={tdt}
*    Starpoint
R2     v2    GND1   1u
R12    u2    GND1   1u
R23    w2    GND1   1u
RGND1  GND1  0  1e6
ErefL1 Uref_L1 0 VALUE={-sqrt(2)*UN*sin(2*pi*(fN*(TIME)))} tripdv={tdv} tripdt={tdt}
*	Nullsystem
Eu0	u_Null 0	VALUE={(v(u1,u2)+v(v1,v2)+v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
Ei0	i_Null 0	VALUE={v(idt1)/L0} tripdv={tdv} tripdt={tdt}
Gi0 0 idt1  VALUE={v(u_Null)-R0*v(i_null)} tripdv={tdv} tripdt={tdt}
Ci0 idt1 0 1 IC=0
Ri0 idt1 0 1e10
*	current components
EisxS		isxS	0 VALUE={v(isx)*cos(v(alpha))-v(isy)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
EisyS		isyS	0 VALUE={v(isy)*cos(v(alpha))+v(isx)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of direct axis with saturation
Gpsix		0	isx	VALUE={v(psisx)} tripdv={tdv} tripdt={tdt}
Rsx		isx	0	{1/Lsd}
Gpsidx	isx	iDx1	VALUE={v(psiDx)} tripdv={tdv} tripdt={tdt} ; *********
Rsdx		iDx1	isx	{1/LDx}
GpsiEx	iDx1	imx1	VALUE={v(psiE)} tripdv={tdv} tripdt={tdt} ; ie oder if ist iDx,imx !!!!
RsEx		imx1	iDx1	{1/LE}
vphx		imx1	imxa1	0
Eimx1		imxa1	0	VALUE={ImNx*(a1*i(vphx)/PsiN+(1-a1)*PWRS(i(vphx)/PsiN,m1))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of quadrature axis with saturation
Gpsiy		0	isy	VALUE={v(psisy)} tripdv={tdv} tripdt={tdt}
Rsy		isy	0	{1/Lsq}
Gpsidy	isy	imy1	VALUE={v(psiDy)} tripdv={tdv} tripdt={tdt}
Rsdy		imy1	isy	{1/LDy}
vphy		imy1	imya1	0
Eimy1		imya1	0	VALUE={ImNy*(a2*i(vphy)/PsiN+(1-a2)*PWRS(i(vphy)/PsiN,m2))} tripdv={tdv} tripdt={tdt}
*
Eidx  idx 0 VALUE={v(idx1)-v(isx)} tripdv={tdv} tripdt={tdt}
Eidy  idy 0 VALUE={v(imy1)-v(isy)} tripdv={tdv} tripdt={tdt}
Eie ie 0 VALUE={v(imx1)-v(idx1)} tripdv={tdv} tripdt={tdt}
Eimx imx 0 VALUE={v(isx)+v(idx)+v(ie)} tripdv={tdv} tripdt={tdt};magnetizing current d-axes
Eimy imy 0 VALUE={v(isy)+v(idy)}       tripdv={tdv} tripdt={tdt};magnetizing current q-axes
*	Flux components
Epsi_sx	psisx	0 VALUE={err0*PsiN+v(idt2)} tripdv={tdv} tripdt={tdt}
Gpsi_sx 0 idt2  VALUE={v(usx)-Rs*v(isx)+p*(2*pi)/60*v(n)*v(psisy)} tripdv={tdv} tripdt={tdt}
Cpsi_sx idt2 0 1 IC=0
Rpsi_sx idt2 0 1e10
*
Epsi_sy	psisy	0 VALUE={v(idt3)} tripdv={tdv} tripdt={tdt}
Gpsi_sy 0 idt3  VALUE={v(usy)-Rs*v(isy)-p*(2*pi)/60*v(n)*v(psisx)} tripdv={tdv} tripdt={tdt}
Cpsi_sy idt3 0 1 IC=0
Rpsi_sy idt3 0 1e10
*
Epsi_Dx	psiDx	0 VALUE={err0*psiN+v(idt4)} tripdv={tdv} tripdt={tdt}
Gpsi_Dx 0 idt4  VALUE={-RDx*v(idx)} tripdv={tdv} tripdt={tdt}
Cpsi_Dx idt4 0 1 IC=0
Rpsi_Dx idt4 0 1e10
*

Epsi_Dy	psiDy	0 VALUE={v(idt5)} tripdv={tdv} tripdt={tdt}
Gpsi_Dy 0 idt5  VALUE={-RDy*v(idy)} tripdv={tdv} tripdt={tdt}
Cpsi_Dy idt5 0 1 IC=0
Rpsi_Dy idt5 0 1e10
*
Epsi_E	psiE	0 VALUE={err0*psiN*(1+Streuung)+v(idt6)} tripdv={tdv} tripdt={tdt}
Gpsi_E 0 idt6  VALUE={v(F1,0)*g*RE_factor-RE*RE_factor*g*g*v(ie)} tripdv={tdv} tripdt={tdt} ;<--------- MATLAB compatible 
Cpsi_E idt6 0 1 IC=0
Rpsi_E idt6 0 1e10
*
Gtheta 0 theta VALUE={180/pi*atan2(v(usx),v(usy))} tripdv={tdv} tripdt={tdt}   ;Lastwinkel!!!!
Rtheta theta 0 1
Ctheta theta 0 10u
*
Emi		Mi	0	VALUE={1.5*p*(i(vphx)*v(isy)-i(vphy)*v(isx))} tripdv={tdv} tripdt={tdt}
EMoment	M 0	VALUE={-v(Mi)+v(Rbg)} tripdv={tdv} tripdt={tdt}
Rn1 n 0 1k
Vn n 0 {n1}
* friction
GRbg		0	Rbg	TABLE {v(n)} (-1,-1) (1,1)
RRbg		Rbg	0	{MN*rbg}
* Compute alpha
Gal   0       alpha  VALUE={alpha_0*pi/180+p/60*(2*pi)*n1*TIME} tripdv={tdv} tripdt={tdt}
Ral   alpha   0      1
.ENDS

.SUBCKT Sgen_70MW_type1 U1 V1 W1  F1  M  n GND1
+	PARAMS:
+	UN_verkettet=10300
+	IN=5.125k
+	Pel=70e6  ;UN_verkettet*IN*sqrt(3)*cosphi of 0.8
+	fn={fn1}
+	Kc=0.5
+	UE0=600V ; Power of exciter = 0.25-5% * SN machine (smaller values for higher SN) (UEminmax=0.3-2*UE0) UE=100-600V(old) RE~0.1-1 (typical 0.2-0.5)
+	IE0=500A
+	p=2
+	Streuung=0.05 ;
+	rcu=0.01
+	rbg=0.001
+	Schenkelpolfaktor=1 ;(1=cylindrical pole 0.5=Salient pole)
+	Daempferfaktor=1
+	err0=0 RE_factor=0.6666 ;Matlab compatible with RE_factor=2/3=0.6666
+   n0=1500 ;starts with 1500U/min
+   alpha_0=0
+   taumech=6.23 ; parameter for inertia J={p*taumech*MN/omega_el}
+   a=0.9 ; Parameter for nonlinear noload line (should be about 0.6-0.9)
+   m=7
+   Mvz=1
.PARAM
+   a1={a};  Saturation parameter d-axis
+   m1={m};  Saturation parameter d-axis
+   a2={a1}; Saturation parameter q-axis ( default: same as d-axis -> may be overwritten if different from d-axis )
+   m2={m1}; Saturation parameter q-axis ( default: same as d-axis -> may be overwritten if different from d-axis )
+	UN={UN_verkettet/sqrt(3)}
+	ZN={UN/IN}
+	Rs={ZN*rcu}
+	omega_el={(2*pi)*fN}
+	Ls={Streuung*ZN/Kc/omega_el}
+	PsiN={sqrt(2)*UN/omega_el}
+	RE={UE0/IE0}
+	RD={Rs/Daempferfaktor}
+   RDx={RD} ; can be overwritten by setting this parameters directly here to a numerical value
+   RDy={RD} ; can be overwritten by setting this parameters directly here to a numerical value
+   LDx={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+   LDy={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+   LE={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+   R0={Rs} ; can be overwritten by setting this parameters directly here to a numerical value
+   L0={Ls} ; can be overwritten by setting this parameters directly here to a numerical value(X0 is 0.03-0.1 p.u)
+   Lsd={Ls} 
+   Lsq={Ls}
+   XD={UN/IN/Kc}
+   XQ={XD*Schenkelpolfaktor}
+   g={UE0/(UN*sqrt(2)*RE/(XD-omega_el*Lsd))} ; updated formula for g parameter
+   g1={UE0/(UN*sqrt(2)*RE/(XQ-omega_el*Lsq))} ; updated formula for salient pole machine
+	ImNx={IE0/g} ; d-axis magnetizing current
+	ImNy={IE0/g1} ;q-axis magnetizing current
+	MN={Pel*(1-rbg-rcu)*p/omega_el}
+   J= {p*taumech*MN/omega_el}
+  Lhd3={XD/(2*pi*fn)-Lsd}
+  Lhq3={XQ/(2*pi*fn)-Lsq}
*	Wicklungsstroeme
*	Wicklungsstroeme
Rf1 f1 0 1e12
Rm  m  0 1e12
Rn2  n  0 1e12
EJ J 0 VALUE={J} tripdv={tdv} tripdt={tdt}
Eun un 0 VALUE={Un} tripdv={tdv} tripdt={tdt}
Ein in 0 VALUE={In} tripdv={tdv} tripdt={tdt}
Esn sn 0 VALUE={3*Un*In} tripdv={tdv} tripdt={tdt}
Epn pn 0 VALUE={pel} tripdv={tdv} tripdt={tdt}
Ecosphin cosphi 0 VALUE={pel/(3*Un*In)} tripdv={tdv} tripdt={tdt}
Ezn zn 0 VALUE={Zn} tripdv={tdv} tripdt={tdt}
Ers rs 0 VALUE={Rs} tripdv={tdv} tripdt={tdt}
* New
Epcu pcu 0 VALUE={3*v(i)*v(i)*Rs} tripdv={tdv} tripdt={tdt}
* Pcu1 same as Pcu
*Epcu1 pcu1 0 VALUE={1.5*Rs*(v(isx)*v(isx)+v(isy)*v(isy))} tripdv={tdv} tripdt={tdt}
Epcu2 pcu2 0 VALUE={v(idx)*v(idx)*RDx+v(idy)*v(idy)*RDy} tripdv={tdv} tripdt={tdt}
* This loss is fed by the external exciter !!!! Pcu_exciter=UE*IE
Epcu3 pcu3 0 VALUE={v(ie)*v(ie)*g*g*Re*RE_factor} tripdv={tdv} tripdt={tdt}
Epcusum pcusum 0 VALUE={v(pcu)+v(pcu2)+v(pcu3)} tripdv={tdv} tripdt={tdt}
*	currents of windings
G1	U1	U2	VALUE={v(isxS)+v(i_Null)} tripdv={tdv} tripdt={tdt}
G2	V1	V2	VALUE={(-v(isxS)+v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
G3	W1	W2	VALUE={(-v(isxS)-v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
GiE	F1	0	VALUE={v(ie)*g} tripdv={tdv} tripdt={tdt}
*	voltage components
EuxS	usxS	0	VALUE={(2*v(u1,u2)-v(v1,v2)-v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
EuyS	usyS	0	VALUE={(v(v1,v2)-v(w1,w2))/sqrt(3)} tripdv={tdv} tripdt={tdt}
Eux	usx	0	VALUE={ v(usxS)*cos(v(alpha))+v(usyS)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
Euy	usy	0	VALUE={-v(usxS)*sin(v(alpha))+v(usyS)*cos(v(alpha))} tripdv={tdv} tripdt={tdt}
*    Starpoint
R2     v2    GND1   1u
R12    u2    GND1   1u
R23    w2    GND1   1u
RGND1  GND1  0  1e6
ErefL1 Uref_L1 0 VALUE={-sqrt(2)*UN*sin(2*pi*(fN*(TIME)))} tripdv={tdv} tripdt={tdt}
*	Nullsystem
Eu0	u_Null 0	VALUE={(v(u1,u2)+v(v1,v2)+v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
Ei0	i_Null 0	VALUE={v(idt1)/L0} tripdv={tdv} tripdt={tdt}
Gi0 0 idt1  VALUE={v(u_Null)-R0*v(i_null)} tripdv={tdv} tripdt={tdt}
Ci0 idt1 0 1 IC=0
Ri0 idt1 0 1e10
*
*	current components
EisxS		isxS	0 VALUE={v(isx)*cos(v(alpha))-v(isy)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
EisyS		isyS	0 VALUE={v(isy)*cos(v(alpha))+v(isx)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of direct axis with saturation
Gpsix		0	isx	VALUE={v(psisx)} tripdv={tdv} tripdt={tdt}
Rsx		isx	0	{1/Lsd}
Gpsidx	isx	iDx1	VALUE={v(psiDx)} tripdv={tdv} tripdt={tdt} ; *********
Rsdx		iDx1	isx	{1/LDx}
GpsiEx	iDx1	imx1	VALUE={v(psiE)} tripdv={tdv} tripdt={tdt} ; ie oder if ist iDx,imx !!!!
RsEx		imx1	iDx1	{1/LE}
vphx		imx1	imxa1	0
Eimx1		imxa1	0	VALUE={ImNx*(a1*i(vphx)/PsiN+(1-a1)*PWRS(i(vphx)/PsiN,m1))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of quadrature axis with saturation
Gpsiy		0	isy	VALUE={v(psisy)} tripdv={tdv} tripdt={tdt}
Rsy		isy	0	{1/Lsq}
Gpsidy	isy	imy1	VALUE={v(psiDy)} tripdv={tdv} tripdt={tdt}
Rsdy		imy1	isy	{1/LDy}
vphy		imy1	imya1	0
Eimy1		imya1	0	VALUE={ImNy*(a2*i(vphy)/PsiN+(1-a2)*PWRS(i(vphy)/PsiN,m2))} tripdv={tdv} tripdt={tdt}
*
Eidx  idx 0 VALUE={v(idx1)-v(isx)} tripdv={tdv} tripdt={tdt}
Eidy  idy 0 VALUE={v(imy1)-v(isy)} tripdv={tdv} tripdt={tdt}
Eie ie 0 VALUE={v(imx1)-v(idx1)} tripdv={tdv} tripdt={tdt}
Eimx imx 0 VALUE={v(isx)+v(idx)+v(ie)} tripdv={tdv} tripdt={tdt};magnetizing current d-axes
Eimy imy 0 VALUE={v(isy)+v(idy)}       tripdv={tdv} tripdt={tdt};magnetizing current q-axes
* nonlinear magnetics
Elhd3 Lhd3 0 VALUE={Lhd3*(1/(a1+(1-a1)*PWRS(LIMIT(abs(v(psihx)+1p)/PsiN,-10,10),m1-1)))} tripdv={tdv} tripdt={tdt}
Elhq3 Lhq3 0 VALUE={Lhq3*(1/(a2+(1-a2)*PWRS(LIMIT(abs(v(psihy)+1p)/PsiN,-10,10),m2-1)))} tripdv={tdv} tripdt={tdt}

*	Flux components
Epsi_sx	psisx	0 VALUE={err0*PsiN+v(idt2)} tripdv={tdv} tripdt={tdt}
Gpsi_sx 0 idt2  VALUE={v(usx)-Rs*v(isx)+p*(2*pi)/60*v(n)*v(psisy)} tripdv={tdv} tripdt={tdt}
Cpsi_sx idt2 0 1 IC=0
Rpsi_sx idt2 0 1e10
*
Epsi_sy	psisy	0 VALUE={v(idt3)} tripdv={tdv} tripdt={tdt}
Gpsi_sy 0 idt3  VALUE={v(usy)-Rs*v(isy)-p*(2*pi)/60*v(n)*v(psisx)} tripdv={tdv} tripdt={tdt}
Cpsi_sy idt3 0 1 IC=0
Rpsi_sy idt3 0 1e10
*
Epsi_Dx	psiDx	0 VALUE={err0*psiN+v(idt4)} tripdv={tdv} tripdt={tdt}
Gpsi_Dx 0 idt4  VALUE={-RDx*v(idx)} tripdv={tdv} tripdt={tdt}
Cpsi_Dx idt4 0 1 IC=0
Rpsi_Dx idt4 0 1e10
*

Epsi_Dy	psiDy	0 VALUE={v(idt5)} tripdv={tdv} tripdt={tdt}
Gpsi_Dy 0 idt5  VALUE={-RDy*v(idy)} tripdv={tdv} tripdt={tdt}
Cpsi_Dy idt5 0 1 IC=0
Rpsi_Dy idt5 0 1e10
*
Epsi_E	psiE	0 VALUE={err0*psiN*(1+Streuung)+v(idt6)} tripdv={tdv} tripdt={tdt}
Gpsi_E 0 idt6  VALUE={v(F1,0)*g*RE_factor-RE*RE_factor*g*g*v(ie)} tripdv={tdv} tripdt={tdt} ;<--------- MATLAB compatible 
Cpsi_E idt6 0 1 IC=0
Rpsi_E idt6 0 1e10
*
*
*Emi		Mi	0	VALUE={1.5*p*(i(Vphx)*v(isy)-i(Vphy)*v(isx))} tripdv={tdv} tripdt={tdt}
Emi		Mi	0	VALUE={1.5*p*(v(psihx)*v(isy)-v(psihy)*v(isx))} tripdv={tdv} tripdt={tdt}
*Emi		Mi	0	VALUE={1.5*p*(v(psihx)*v(isy)-v(psihy)*v(isx))} tripdv={tdv} tripdt={tdt}
*EMoment	M 0	VALUE={-v(Mi)+v(Rbg)} tripdv={tdv} tripdt={tdt}
*En    n  0  Value={N1} tripdv={tdv} tripdt={tdt}
* Berechner n
* Compute n
En		n	0  VALUE={n0+60/(2*pi)/J*v(idt8)} tripdv={tdv} tripdt={tdt}
Gn 0 idt8  VALUE={v(M)*Mvz+v(Mi)-v(Rbg)} tripdv={tdv} tripdt={tdt}
Cn idt8 0 1 IC=0
Rn idt8 0 1e10
* friction
GRbg		0	Rbg	TABLE {v(n)} (-1,-1) (1,1)
RRbg		Rbg	0	{MN*rbg}
* Compute alpha
Ealpha	alpha	0	VALUE={alpha_0*pi/180+v(idt7)*p/60*(2*pi)} tripdv={tdv} tripdt={tdt}
Galpha 0 idt7  VALUE={v(n)} tripdv={tdv} tripdt={tdt}
Calpha idt7 0 1 IC=0
Ralpha idt7 0 1e10
*
Gtheta 0 theta VALUE={180/pi*atan2(v(usx),v(usy))} tripdv={tdv} tripdt={tdt}   ;Lastwinkel!!!!
Rtheta theta 0 1
Ctheta theta 0 10u
* Compute n
*En		n	0  VALUE={n0+60/(2*pi)/J*v(idt8)} tripdv={tdv} tripdt={tdt}
*Gn 0 idt8  VALUE={v(M)*Mvz+v(Mi)-v(Rbg)} tripdv={tdv} tripdt={tdt}
*Cn idt8 0 1 IC=0
*Rn idt8 0 1e10
* Compute f
Ef      f   0  VALUE={v(n)*p/60} tripdv={tdv} tripdt={tdt}
* voltage RMS of generator
Ev Us 0 VALUE={sqrt(v(usx)*v(usx)+v(usy)*v(usy))} tripdv={tdv} tripdt={tdt}
* Xd=Xq for cylindrical pole machine Xd,Xq different for salient pole
Exd xd 0 VALUE={(v(Lhd3)+Lsd)*2*pi*fn} tripdv={tdv} tripdt={tdt} ;better measured from sliptest
Exq xq 0 VALUE={(v(Lhq3)+Lsq)*2*pi*fn} tripdv={tdv} tripdt={tdt} ;better measured from sliptest
* New added
Epsihx psihx 0 VALUE={v(psisx)-Lsd*v(isx)} tripdv={tdv} tripdt={tdt}
Epsihy psihy 0 VALUE={v(psisy)-Lsq*v(isy)} tripdv={tdv} tripdt={tdt}
Epsihx1 psihx1 0 VALUE={v(psidx)-Ldx*v(iDx)} tripdv={tdv} tripdt={tdt} ;same as pshihx
Epsihy1 psihy1 0 VALUE={v(psidy)-Ldy*v(iDy)} tripdv={tdv} tripdt={tdt} ;same as pshihy
Epsihx2 psihx2 0 VALUE={v(psie)-Le*v(ie)}  tripdv={tdv} tripdt={tdt}  ;same as pshihx
Eg  g 0 VALUE={g} tripdv={tdv} tripdt={tdt}
EU  u 0 VALUE={v(us)*sqrt(3)/sqrt(2)} tripdv={tdv} tripdt={tdt}
Ei  i 0 VALUE={0.7071*sqrt(v(isx)*v(isx)+v(isy)*v(isy))} tripdv={tdv} tripdt={tdt} 
Eap p 0 VALUE={3*(v(usx)*v(isx)/2+v(usy)*v(isy)/2)}  tripdv={tdv} tripdt={tdt}
Eaq q 0 VALUE={3*(v(usy)*v(isx)/2-v(usx)*v(isy)/2)} tripdv={tdv} tripdt={tdt}
Es  s 0 VALUE={sqrt(v(p)*v(p)+v(q)*v(q))} tripdv={tdv} tripdt={tdt}
* Other formulas for active and reactive power
Ephiu phius 0 VALUE={180/pi*atan2(v(usy),v(usx))}  tripdv={tdv} tripdt={tdt} 
Ephii phiis 0 VALUE={180/pi*atan2(v(isy),v(isx))}  tripdv={tdv} tripdt={tdt}
Ephi phi 0 VALUE={(v(phius)-v(phiis))}   tripdv={tdv} tripdt={tdt}
* Other formula for up
*Eup2 up2 0 VALUE={sqrt((v(u)-v(i)*v(xd)*sin(pi/180*v(phi)))*(v(u)-v(i)*v(xd)*sin(pi/180*v(phi)))+(v(i)*v(xd)*cos(pi/180*v(phi)))*(v(i)*v(xd)*cos(pi/180*v(phi))))}  
Eup up 0 VALUE={(v(usy)-v(isx)*v(xd))/sqrt(2)} tripdv={tdv} tripdt={tdt}
*
Ews wmagnstator 0 VALUE={1.5*0.5*(v(psisx)*v(isx)+v(psisy)*v(isy))} tripdv={tdv} tripdt={tdt}
Ewe wmagnexciter 0 VALUE={1.5*0.5*v(psie)*v(ie)} tripdv={tdv} tripdt={tdt}
Ewd wmagndamper 0 VALUE={1.5*0.5*(v(psidx)*v(idx)+v(psidy)*v(idy))}  tripdv={tdv} tripdt={tdt}
Ewsumm wmagnsum 0 VALUE={v(wmagnstator)+v(wmagndamper)+v(wmagnexciter)} tripdv={tdv} tripdt={tdt}
*
* Psum2=Psum3 P from Wmagn ( P=dWmagn/dt )
Etest Psum2 0 VALUE={v(Pstator)+v(Pexciter)+v(Pdamper)} tripdv={tdv} tripdt={tdt} 
Etest2 Psum3 0 VALUE={DDT(v(wmagnstator))+DDT(v(wmagnexciter))+DDT(v(wmagndamper))} tripdv={tdv} tripdt={tdt} 
*
EPstator Pstator  0 VALUE={1.5*(v(isx)*DDT(v(psisx)))+1.5*(v(isy)*DDT(v(psisy)))} tripdv={tdv} tripdt={tdt} 
* Exciter is fed by external unit
EPexiter Pexciter 0 VALUE={1.5*(v(ie)*DDT(v(psie)))} tripdv={tdv} tripdt={tdt}
EPdamper Pdamper 0 VALUE={1.5*(v(idx)*DDT(v(psidx))+v(idy)*DDT(v(psidy)))} tripdv={tdv} tripdt={tdt}
EPsum1 Psum1 0 VALUE={v(Pstator)+v(Pdamper)+v(Pexciter)} tripdv={tdv} tripdt={tdt}
EPsum Psum 0 VALUE={v(Psum1)+V(Pcusum)-v(Pcu3)-v(Pexciter)-V(P)+V(rbg)*omega_el/p} tripdv={tdv} tripdt={tdt}
EPM   Pmech 0 VALUE={-v(M)*omega_el/p} tripdv={tdv} tripdt={tdt}
* other formulas for theta theta2 for non salient machine and theta3 for salient machine
*Etheta2 theta2 0 VALUE={-180/pi*atan2(v(i)*v(xd)*cos(pi/180*v(phi)),(v(u)-v(i)*v(xd)*sin(pi/180*v(phi))))}  ;for round pole
*Etheta3 theta3 0 VALUE={-180/pi*atan2(v(i)*v(xq)*cos(pi/180*v(phi)),(v(u)-v(i)*v(xq)*sin(pi/180*v(phi))))}  ;for salient pole
*
* Qtsum = Qtstator + Qtdamper = -Qtexciter
EQtransf1 Qtstator 0 VALUE={1.5*(v(isx)*DDT(v(psisy))-v(isy)*DDT(v(psisx)))} tripdv={tdv} tripdt={tdt}
EQtransf2 Qtexciter 0 VALUE={1.5*(v(isx)*DDT(v(psihx)))} tripdv={tdv} tripdt={tdt}
EQtransf3 Qtdamper 0 VALUE={1.5*(v(isx)*DDT(v(psihx))+v(isy)*DDT(v(psihy)))} tripdv={tdv} tripdt={tdt}
EQtranssum Qtsum 0 VALUE={v(Qtstator)+v(Qtdamper)} tripdv={tdv} tripdt={tdt}
EQmagn1 Qrotstator 0 VALUE={1.5*omega_el*(v(isx)*v(isx)*(v(Lhd3)+Lsd)+v(isy)*v(isy)*(v(Lhq3)+Lsq))} tripdv={tdv} tripdt={tdt}
EQmagn2 Qrotexciter 0 VALUE={1.5*omega_el*(v(ie)*v(isx)*v(Lhd3))} tripdv={tdv} tripdt={tdt}
EQmagn3 Qrotdamper 0 VALUE={1.5*omega_el*(v(isx)*v(idx)*v(Lhd3)+v(idy)*v(isy)*v(Lhq3))} tripdv={tdv} tripdt={tdt}
EQexciter Qexciter 0 VALUE={v(Qrotexciter)+v(Qtexciter)}  tripdv={tdv} tripdt={tdt}
EQstator Qstator 0 VALUE={v(Qrotstator)+v(Qtstator)}  tripdv={tdv} tripdt={tdt}
EQdamper Qdamper 0 VALUE={v(Qrotdamper)+v(Qtdamper)} tripdv={tdv} tripdt={tdt}
* Qsum = Qstator + Qdamper - Qext = -Qexciter 
EQsum Qsum 0 VALUE={v(Qstator)+v(Qdamper)-V(Q)} tripdv={tdv} tripdt={tdt}
.ENDS

.subckt sgen_70MW_type2 U1 V1 W1 F1 M n GND1 params:
+	UN_verkettet=10300
+	IN=5.125k
+	Pel=70e6  ;UN_verkettet*IN*sqrt(3)*cosphi of 0.8
+	fn={fn1}
+	Kc=0.5
+	UE0=600V ; Power of exciter = 0.25-5% * SN machine (smaller values for higher SN) (UEminmax=0.3-2*UE0) UE=100-600V(old) RE~0.1-1 (typical 0.2-0.5)
+	IE0=500A
+	p=2
+	Streuung=0.05 ;
+	rcu=0.01
+	rbg=0.001
+	Schenkelpolfaktor=1 ;(1=cylindrical pole 0.5=Salient pole)
+	Daempferfaktor=1
+	err0=0 RE_factor=0.6666 ;Matlab compatible with RE_factor=2/3=0.6666
+   n0=1500 ;starts with 1500U/min
+   alpha_0=0
+   taumech=6.23 ; parameter for inertia J={p*taumech*MN/omega_el}
+   a=0.9 ; Parameter for nonlinear noload line (should be about 0.6-0.9)
+   m=7
+   Mvz=1
.PARAM
+	UN={UN_verkettet/sqrt(3)}
+	ZN={UN/IN}
+   XD={UN/IN/Kc}
+   XQ={XD*Schenkelpolfaktor}
+	Rs={ZN*rcu}
+	omega_el={(2*pi)*fN}
;+	 g={IE0/((1+Streuung)*Kc*IN*sqrt(2))}
+	Ls={Streuung*ZN/Kc/omega_el}
+	PsiN={sqrt(2)*UN/omega_el}
+	RE={UE0/IE0}
+	RD={Rs/Daempferfaktor}
+  RDx={RD} ; can be overwritten by setting this parameters directly here to a numerical value
+  RDy={RD} ; can be overwritten by setting this parameters directly here to a numerical value
+  LDx={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+  LDy={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+  LE={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+  R0={Rs} ; can be overwritten by setting this parameters directly here to a numerical value
+  L0={Ls} ; can be overwritten by setting this parameters directly here to a numerical value(X0 is 0.03-0.1 p.u)
+  Lsd={Ls}
+  Lsq={Ls}
+  Lhd3={XD/(2*pi*fn)-Lsd}
+  Lhq3={XQ/(2*pi*fn)-Lsq}
+   g={UE0/(UN*sqrt(2)*RE/(XD-omega_el*Lsd))}
+	MN={Pel*(1-rbg-rcu)*p/omega_el}
+   J= {p*taumech*MN/omega_el}
* magnetic voltage  UE0, IE0
* NOTE: Measurement of g: set g=1 see the voltage output of generator
* make now g smaller until the nominal voltage of the generator is present
Rf1 f1 0 1e12
Rm1  m  0 1e12
Rn1  n  0 1e12
Eun un 0 VALUE={Un} tripdv={tdv} tripdt={tdt}
Ein in 0 VALUE={In} tripdv={tdv} tripdt={tdt}
Esn sn 0 VALUE={3*Un*In} tripdv={tdv} tripdt={tdt}
Epn pn 0 VALUE={pel} tripdv={tdv} tripdt={tdt}
Ecosphin cosphi 0 VALUE={pel/(3*Un*In)} tripdv={tdv} tripdt={tdt}
Ezn zn 0 VALUE={Zn} tripdv={tdv} tripdt={tdt}
Ers rs 0 VALUE={Rs} tripdv={tdv} tripdt={tdt}
* New
Epcu pcu 0 VALUE={3*v(i)*v(i)*Rs} tripdv={tdv} tripdt={tdt}
* Pcu1 same as Pcu
*Epcu1 pcu1 0 VALUE={1.5*Rs*(v(isx)*v(isx)+v(isy)*v(isy))} tripdv={tdv} tripdt={tdt}
Epcu2 pcu2 0 VALUE={v(idx)*v(idx)*RDx+v(idy)*v(idy)*RDy} tripdv={tdv} tripdt={tdt}
* This loss is fed by the external exciter !!!! Pcu_exciter=UE*IE
Epcu3 pcu3 0 VALUE={v(ie)*v(ie)*g*g*Re*RE_factor} tripdv={tdv} tripdt={tdt}
Epcusum pcusum 0 VALUE={v(pcu)+v(pcu2)+v(pcu3)} tripdv={tdv} tripdt={tdt}
* Null-System
Gi0    0    i0    VALUE=
+ {((v(U1,U2)+v(V1,V2)+v(W1,W2))/3-R0*v(i0))/L0} tripdv={tdv} tripdt={tdt}
Ci0    i0    0    1    IC=0
Ri0    i0    0    1E6
*    Stator voltages in the d-q system
Guxs    0    usxs    VALUE={2/3*v(U1,U2)-v(V1,V2)/3-v(W1,W2)/3} tripdv={tdv} tripdt={tdt}; statorfix
Guys    0    usys    VALUE={(v(V1,V2)-v(W1,W2))/sqrt(3)} tripdv={tdv} tripdt={tdt}; statorfix
Ruxs    usxs    0    1
Ruys    usys    0    1
Guxr    0    usx    VALUE={v(usxs)*v(cosa)+v(usys)*v(sina)} tripdv={tdv} tripdt={tdt}; rotorfix
Guyr    0    usy    VALUE={v(usys)*v(cosa)-v(usxs)*v(sina)} tripdv={tdv} tripdt={tdt}; rotorfix
Ruxr    usx    0    1
Ruyr    usy    0    1
*    Magnetic fluxes in the d-q system
Gpsx    0    psisx    VALUE={v(usx)-Rs*v(isx)+p*(2*pi)/60*v(n)*v(psisy)} tripdv={tdv} tripdt={tdt}
Gpe     0    psie    VALUE={v(F1)*g*RE_factor   -RE*RE_factor*g*g*v(iE) } tripdv={tdv} tripdt={tdt} ;<--------- MATLAB compatible 
Gpdx    0    psidx    VALUE={0     -RDx*v(idx)              } tripdv={tdv} tripdt={tdt}
Rpsx    psisx        0        1MEG
Rpe     psie         0        1MEG
Rpdx    psidx        0        1MEG
Cpsx    psisx        0        1    IC={err0*psiN}
Cpe     psie         0        1    IC={err0*psiN*(1+Streuung)}
Cpdx    psidx        0        1    IC={err0*psiN}
Gpsy    0    psisy    VALUE={v(usy)-Rs*v(isy)-p*(2*pi)/60*v(n)*v(psisx)} tripdv={tdv} tripdt={tdt}
Gpdy    0    psidy    VALUE={0     -RDy*v(idy)              } tripdv={tdv} tripdt={tdt}
Rpsy    psisy        0        1MEG
Rpdy    psidy        0        1MEG
Cpsy    psisy        0        1    IC=0
Cpdy    psidy        0        1    IC=0
*    Currents in the d-q system
Gisx    0    isx    VALUE={Lsd*v(isx)+Lhd3*(v(isx)+v(ie)+v(idx))-v(psisx)} tripdv={tdv} tripdt={tdt}
Gie     0    ie     VALUE={LE *v(ie)+Lhd3*(v(isx)+v(ie)+v(idx))-v(psie)} tripdv={tdv} tripdt={tdt}
Gidx    0    idx    VALUE={LDx*v(idx)+Lhd3*(v(isx)+v(ie)+v(idx))-v(psidx)} tripdv={tdv} tripdt={tdt}
Risx    isx        0        1MEG
Rie     ie         0        1MEG
Ridx    idx        0        1MEG
Gisy    0    isy     VALUE={Lsq*v(isy)+Lhq3*(v(isy)+v(idy))-v(psisy)} tripdv={tdv} tripdt={tdt}
Gidy    0    idy     VALUE={LDy*v(idy)+Lhq3*(v(isy)+v(idy))-v(psidy)} tripdv={tdv} tripdt={tdt}
Risy    isy        0        1MEG
Ridy    idy        0        1MEG
*    inner torque
Gm1     0    mi      VALUE={ Lhd3*(v(isx)+v(ie)+v(idx))*v(isy)} tripdv={tdv} tripdt={tdt}
Gm2     0    mi      VALUE={-Lhq3*(v(isy)+v(idy))      *v(isx)} tripdv={tdv} tripdt={tdt}
Rm      mi         0 {1.5*p}
*Emi		Mi	0	VALUE={1.5*p*(v(psihx)*v(isy)-v(psihy)*v(isx))} tripdv={tdv} tripdt={tdt}
*    Speed n
En    n        0     VALUE={n0+60/(2*pi)/J*V(n1)} tripdv={tdv} tripdt={tdt}
Gn    0       n1     VALUE={v(mi)+v(M)*Mvz-v(rbg)} tripdv={tdv} tripdt={tdt}
Cn    n1       0      1    IC=0                    
Rn    n1       0      1MEG
*    Friction
GRbg  0	   Rbg1	   TABLE {v(n)} (-1,-1) (1,1)
RRbg  Rbg1	0	   1
ERbg  Rbg   0      VALUE={v(Rbg1)*MN*rbg} tripdv={tdv} tripdt={tdt}
*    angle alpha
Gal   0       alpha  VALUE={p/60*(2*pi)*v(n)} tripdv={tdv} tripdt={tdt}
Cal   alpha   0      1    IC={alpha_0*pi/180}
Ral   alpha   0      1E10
Gcos  0       cosa   VALUE={cos(v(alpha))} tripdv={tdv} tripdt={tdt}
Gsin  0       sina   VALUE={sin(v(alpha))} tripdv={tdv} tripdt={tdt}
Rcos  cosa    0      1
Rsin  sina    0      1
*    stator currents u,v,w system double translation
* isxs=isx*cosa-isy*sina  isys=isy*cosa+isx*sina
*G1 U1 U2 VALUE={v(isxS)+v(i_Null)}
*G2 V1 V2 VALUE={(-v(isxS)+v(isyS)*sqrt(3))/2+v(i_Null)}
*G3 W1 W2 VALUE={(-v(isxS)-v(isyS)*sqrt(3))/2+v(i_Null)}
Gi1    U1    U2     VALUE={v(isx)*v(cosa)-v(isy)*v(sina)+v(i0)} tripdv={tdv} tripdt={tdt}
Gi2a   V1    V2     VALUE={ ((sqrt(3)/2)*v(isy)-v(isx)/2)*v(cosa)} tripdv={tdv} tripdt={tdt}
Gi2b   V1    V2     VALUE={ (v(isy)/2+(sqrt(3)/2)*v(isx))*v(sina) +v(i0)} tripdv={tdv} tripdt={tdt}
Gi3a   W1    W2     VALUE={-((sqrt(3)/2)*v(isy)+v(isx)/2)*v(cosa)} tripdv={tdv} tripdt={tdt}
Gi3b   W1    W2     VALUE={ (v(isy)/2-(sqrt(3)/2)*v(isx))*v(sina) +v(i0)} tripdv={tdv} tripdt={tdt}
GiE2	F1	0	VALUE={v(ie)*g} tripdv={tdv} tripdt={tdt}
*    Starpoint
R2     v2    GND1   1u
R12    u2    GND1   1u
R23    w2    GND1   1u
RGND1  GND1  0  1e6
*    Some measurements (active power, reactive power, load angle)
Etheta theta 0 VALUE={180/pi*atan2(v(usx),v(usy))} tripdv={tdv} tripdt={tdt}
Eimx imx 0 VALUE={v(isx)+v(idx)+v(ie)} tripdv={tdv} tripdt={tdt};magnetizing current
Eimy imy 0 VALUE={v(isy)+v(idy)}       tripdv={tdv} tripdt={tdt};magnetizing current
*
Ev Us 0 VALUE={sqrt(v(usx)*v(usx)+v(usy)*v(usy))} tripdv={tdv} tripdt={tdt}
* Xd=Xq for cylindrical pole machine Xd,Xq different for salient pole
Elhd3 Lhd3 0 VALUE={Lhd3} tripdv={tdv} tripdt={tdt}
Elhq3 Lhq3 0 VALUE={Lhq3} tripdv={tdv} tripdt={tdt}
Exd xd 0 VALUE={Xd} tripdv={tdv} tripdt={tdt} ;better measured from sliptest
Exq xq 0 VALUE={Xq}   tripdv={tdv} tripdt={tdt} ;better measured from sliptest
* New added
Epsihx psihx 0 VALUE={v(psisx)-Lsd*v(isx)} tripdv={tdv} tripdt={tdt}
Epsihy psihy 0 VALUE={v(psisy)-Lsq*v(isy)} tripdv={tdv} tripdt={tdt}
Epsihx1 psihx1 0 VALUE={v(psidx)-Ldx*v(iDx)} tripdv={tdv} tripdt={tdt};same as pshihx
Epsihy1 psihy1 0 VALUE={v(psidy)-Ldy*v(iDy)} tripdv={tdv} tripdt={tdt};same as pshihy
Epsihx2 psihx2 0 VALUE={v(psie)-Le*v(ie)}    tripdv={tdv} tripdt={tdt};same as pshihx
Eg  g 0 VALUE={g} tripdv={tdv} tripdt={tdt}
EU  u 0 VALUE={v(us)*sqrt(3)/sqrt(2)} tripdv={tdv} tripdt={tdt}
Ei  i 0 VALUE={0.7071*sqrt(v(isx)*v(isx)+v(isy)*v(isy))} tripdv={tdv} tripdt={tdt}
Eap p 0 VALUE={3*(v(usx)*v(isx)/2+v(usy)*v(isy)/2)}  tripdv={tdv} tripdt={tdt}
Eaq q 0 VALUE={3*(v(usy)*v(isx)/2-v(usx)*v(isy)/2)} tripdv={tdv} tripdt={tdt}
Es  s 0 VALUE={sqrt(v(p)*v(p)+v(q)*v(q))} tripdv={tdv} tripdt={tdt}
* Compute f
Ef      f   0  VALUE={v(n)*p/60} tripdv={tdv} tripdt={tdt}
* Other formulas for active and reactive power
* Some qz work for salient qy for nonsalient machines
*Eaq2 qx 0 VALUE={3*v(u)*v(i)*sin(pi/180*v(phi))} tripdv={tdv} tripdt={tdt}
*Eaq3 qy 0 VALUE={-3*v(up)*v(u)/v(xd)*cos(v(theta2)*pi/180)+3*v(u)*v(u)/v(xd)} tripdv={tdv} tripdt={tdt}; for round pole
*Eaq4 qz 0 VALUE={-3*v(up)*v(u)/v(xd)*cos(v(theta3)*pi/180)+3*v(u)*v(u)/2*(1/v(xq)+1/v(xd))-3*v(u)*v(u)/2*(1/v(xq)-1/v(xd))*cos(2*v(theta3)*pi/180)} tripdv={tdv} tripdt={tdt}; for salient pole
*Eap2 px 0 VALUE={3*v(u)*v(i)*cos(pi/180*v(phi))} tripdv={tdv} tripdt={tdt}
*Eap3 py 0 VALUE={-3*v(up)*v(u)/v(xd)*sin(v(theta2)*pi/180)} tripdv={tdv} tripdt={tdt}; for round pole
*Eap4 pz 0 VALUE={-3*v(up)*v(u)/v(xd)*sin(v(theta3)*pi/180)-3*v(u)*v(u)/2*(1/v(xq)-1/v(xd))*sin(2*v(theta3)*pi/180)} tripdv={tdv} tripdt={tdt}; for salient pole
Ephiu phius 0 VALUE={180/pi*atan2(v(usy),v(usx))}  tripdv={tdv} tripdt={tdt}
Ephii phiis 0 VALUE={180/pi*atan2(v(isy),v(isx))}  tripdv={tdv} tripdt={tdt}
Ephi phi 0 VALUE={(v(phius)-v(phiis))}   tripdv={tdv} tripdt={tdt}
* Other formula for up
*Eup2 up2 0 VALUE={sqrt((v(u)-v(i)*v(xd)*sin(pi/180*v(phi)))*(v(u)-v(i)*v(xd)*sin(pi/180*v(phi)))+(v(i)*v(xd)*cos(pi/180*v(phi)))*(v(i)*v(xd)*cos(pi/180*v(phi))))}  tripdv={tdv} tripdt={tdt}
Eup up 0 VALUE={(v(usy)-v(isx)*v(xd))/sqrt(2)} tripdv={tdv} tripdt={tdt}
*
Ews wmagnstator 0 VALUE={1.5*0.5*(v(psisx)*v(isx)+v(psisy)*v(isy))} tripdv={tdv} tripdt={tdt}
Ewe wmagnexciter 0 VALUE={1.5*0.5*v(psie)*v(ie)} tripdv={tdv} tripdt={tdt}
Ewd wmagndamper 0 VALUE={1.5*0.5*(v(psidx)*v(idx)+v(psidy)*v(idy))}  tripdv={tdv} tripdt={tdt}
Ewsumm wmagnsum 0 VALUE={v(wmagnstator)+v(wmagndamper)+v(wmagnexciter)} tripdv={tdv} tripdt={tdt}
*
* Psum2=Psum3 P from Wmagn ( P=dWmagn/dt )
Etest Psum2 0 VALUE={v(Pstator)+v(Pexciter)+v(Pdamper)} tripdv={tdv} tripdt={tdt} 
Etest2 Psum3 0 VALUE={DDT(v(wmagnstator))+DDT(v(wmagnexciter))+DDT(v(wmagndamper))} tripdv={tdv} tripdt={tdt} 
*
EPstator Pstator  0 VALUE={1.5*(v(isx)*DDT(v(psisx)))+1.5*(v(isy)*DDT(v(psisy)))} tripdv={tdv} tripdt={tdt} 
* Exciter is fed by external unit
EPexiter Pexciter 0 VALUE={1.5*(v(ie)*DDT(v(psie)))} tripdv={tdv} tripdt={tdt}
EPdamper Pdamper 0 VALUE={1.5*(v(idx)*DDT(v(psidx))+v(idy)*DDT(v(psidy)))} tripdv={tdv} tripdt={tdt}
EPsum1 Psum1 0 VALUE={v(Pstator)+v(Pdamper)+v(Pexciter)} tripdv={tdv} tripdt={tdt}
EPsum Psum 0 VALUE={v(Psum1)+V(Pcusum)-v(Pcu3)-v(Pexciter)-V(P)+V(rbg)*omega_el/p} tripdv={tdv} tripdt={tdt}
EPM   Pmech 0 VALUE={-v(M)*omega_el/p} tripdv={tdv} tripdt={tdt}
* other formulas for theta theta2 for non salient machine and theta3 for salient machine
*Etheta2 theta2 0 VALUE={-180/pi*atan2(v(i)*v(xd)*cos(pi/180*v(phi)),(v(u)-v(i)*v(xd)*sin(pi/180*v(phi))))}  ;for round pole
*Etheta3 theta3 0 VALUE={-180/pi*atan2(v(i)*v(xq)*cos(pi/180*v(phi)),(v(u)-v(i)*v(xq)*sin(pi/180*v(phi))))}  ;for salient pole
*
* Qtsum = Qtstator + Qtdamper = -Qtexciter
EQtransf1 Qtstator 0 VALUE={1.5*(v(isx)*DDT(v(psisy))-v(isy)*DDT(v(psisx)))} tripdv={tdv} tripdt={tdt}
EQtransf2 Qtexciter 0 VALUE={1.5*(v(isx)*DDT(v(psihx)))} tripdv={tdv} tripdt={tdt}
EQtransf3 Qtdamper 0 VALUE={1.5*(v(isx)*DDT(v(psihx))+v(isy)*DDT(v(psihy)))} tripdv={tdv} tripdt={tdt}
EQtranssum Qtsum 0 VALUE={v(Qtstator)+v(Qtdamper)} tripdv={tdv} tripdt={tdt}
EQmagn1 Qrotstator 0 VALUE={1.5*omega_el*(v(isx)*v(isx)*(v(Lhd3)+Lsd)+v(isy)*v(isy)*(v(Lhq3)+Lsq))} tripdv={tdv} tripdt={tdt}
EQmagn2 Qrotexciter 0 VALUE={1.5*omega_el*(v(ie)*v(isx)*v(Lhd3))} tripdv={tdv} tripdt={tdt}
EQmagn3 Qrotdamper 0 VALUE={1.5*omega_el*(v(isx)*v(idx)*v(Lhd3)+v(idy)*v(isy)*v(Lhq3))} tripdv={tdv} tripdt={tdt}
EQexciter Qexciter 0 VALUE={v(Qrotexciter)+v(Qtexciter)}  tripdv={tdv} tripdt={tdt}
EQstator Qstator 0 VALUE={v(Qrotstator)+v(Qtstator)}  tripdv={tdv} tripdt={tdt}
EQdamper Qdamper 0 VALUE={v(Qrotdamper)+v(Qtdamper)} tripdv={tdv} tripdt={tdt}
* Qsum = Qstator + Qdamper - Qext = -Qexciter 
EQsum Qsum 0 VALUE={v(Qstator)+v(Qdamper)-V(Q)} tripdv={tdv} tripdt={tdt}
.ends

.subckt sgen_70MW_type3 U1 V1 W1 F1 M n GND1 params:
+	UN_verkettet=10300
+	IN=5.125k
+	Pel=70e6  ;UN_verkettet*IN*sqrt(3)*cosphi of 0.8
+	fn={fn1}
+	Kc=0.5
+	UE0=600V ; Power of exciter = 0.25-5% * SN machine (smaller values for higher SN) (UEminmax=0.3-2*UE0) UE=100-600V(old) RE~0.1-1 (typical 0.2-0.5)
+	IE0=500A
+	p=2
+	Streuung=0.05 ;
+	rcu=0.01
+	rbg=0.001
+	Schenkelpolfaktor=1 ;(1=cylindrical pole 0.5=Salient pole)
+	Daempferfaktor=1
+	err0=0 RE_factor=0.6666 ;Matlab compatible with RE_factor=2/3=0.6666
+   n0=1500 ;starts with 1500U/min
+   alpha_0=0
+   taumech=6.23 ; parameter for inertia J={p*taumech*MN/omega_el}
+   a=0.9 ; Parameter for nonlinear noload line (should be about 0.6-0.9)
+   m=7
+   Mvz=1
.PARAM
+  a1={a}
+  m1={m}
+  a2={a}
+  m2={m}
+	UN={UN_verkettet/sqrt(3)}
+	ZN={UN/IN}
+   XD={UN/IN/Kc}
+   XQ={XD*Schenkelpolfaktor}
+	Rs={ZN*rcu}
+	omega_el={(2*pi)*fN}
;+	 g={IE0/((1+Streuung)*Kc*IN*sqrt(2))}
+	Ls={Streuung*ZN/Kc/omega_el}
+	PsiN={sqrt(2)*UN/omega_el}
+	RE={UE0/IE0}
+	RD={Rs/Daempferfaktor}
+  RDx={RD} ; can be overwritten by setting this parameters directly here to a numerical value
+  RDy={RD} ; can be overwritten by setting this parameters directly here to a numerical value
+  LDx={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+  LDy={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+  LE={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+  R0={Rs} ; can be overwritten by setting this parameters directly here to a numerical value
+  L0={Ls} ; can be overwritten by setting this parameters directly here to a numerical value(X0 is 0.03-0.1 p.u)
+  Lsd={Ls}
+  Lsq={Ls}
+  Lhd3={XD/(2*pi*fn)-Lsd}
+  Lhq3={XQ/(2*pi*fn)-Lsq}
;+	g={IE0/((1+Streuung)*Kc*IN*sqrt(2))} 
+   g={UE0/(UN*sqrt(2)*RE/(XD-omega_el*Lsd))}
+	MN={Pel*(1-rbg-rcu)*p/omega_el}
+   J= {p*taumech*MN/omega_el}
+   taumech=6.23 ; parameter for inertia J={p*taumech*MN/omega_el}
* magnetic voltage  UE0, IE0
* NOTE: Measurement of g: set g=1 see the voltage output of generator
* make now g smaller until the nominal voltage of the generator is present
Rf1 f1 0 1e12
Rm1  m  0 1e12
Rn1  n  0 1e12
Eun un 0 VALUE={Un} tripdv={tdv} tripdt={tdt}
Ein in 0 VALUE={In} tripdv={tdv} tripdt={tdt}
Esn sn 0 VALUE={3*Un*In} tripdv={tdv} tripdt={tdt}
Epn pn 0 VALUE={pel} tripdv={tdv} tripdt={tdt}
Ecosphin cosphi 0 VALUE={pel/(3*Un*In)} tripdv={tdv} tripdt={tdt}
Ezn zn 0 VALUE={Zn} tripdv={tdv} tripdt={tdt}
Ers rs 0 VALUE={Rs} tripdv={tdv} tripdt={tdt}
* New
Epcu pcu 0 VALUE={3*v(i)*v(i)*Rs} tripdv={tdv} tripdt={tdt}
* Pcu1 same as Pcu
*Epcu1 pcu1 0 VALUE={1.5*Rs*(v(isx)*v(isx)+v(isy)*v(isy))} tripdv={tdv} tripdt={tdt}
Epcu2 pcu2 0 VALUE={v(idx)*v(idx)*RDx+v(idy)*v(idy)*RDy} tripdv={tdv} tripdt={tdt}
* This loss is fed by the external exciter !!!! Pcu_exciter=UE*IE
Epcu3 pcu3 0 VALUE={v(ie)*v(ie)*g*g*Re*RE_factor} tripdv={tdv} tripdt={tdt}
Epcusum pcusum 0 VALUE={v(pcu)+v(pcu2)+v(pcu3)} tripdv={tdv} tripdt={tdt}
* Null-System
Gi0    0    i0    VALUE=
+ {((v(U1,U2)+v(V1,V2)+v(W1,W2))/3-R0*v(i0))/L0} tripdv={tdv} tripdt={tdt}
Ci0    i0    0    1    IC=0
Ri0    i0    0    1E6
*    Stator voltages in the d-q system
Guxs    0    usxs    VALUE={2/3*v(U1,U2)-v(V1,V2)/3-v(W1,W2)/3} tripdv={tdv} tripdt={tdt}; statorfix
Guys    0    usys    VALUE={(v(V1,V2)-v(W1,W2))/sqrt(3)} tripdv={tdv} tripdt={tdt}; statorfix
Ruxs    usxs    0    1
Ruys    usys    0    1
Guxr    0    usx    VALUE={v(usxs)*v(cosa)+v(usys)*v(sina)} tripdv={tdv} tripdt={tdt}; rotorfix
Guyr    0    usy    VALUE={v(usys)*v(cosa)-v(usxs)*v(sina)} tripdv={tdv} tripdt={tdt}; rotorfix
Ruxr    usx    0    1
Ruyr    usy    0    1
*    Magnetic fluxes in the d-q system
Gpsx    0    psisx    VALUE={v(usx)-Rs*v(isx)+p*(pi/30)*v(n)*v(psisy)} tripdv={tdv} tripdt={tdt}
Gpe     0    psie    VALUE={v(F1)*g*RE_factor   -RE*RE_factor*g*g*v(iE) } tripdv={tdv} tripdt={tdt} ;<--------- MATLAB compatible 
Gpdx    0    psidx    VALUE={0     -RDx*v(idx)              } tripdv={tdv} tripdt={tdt}
Rpsx    psisx        0        1MEG
Rpe     psie         0        1MEG
Rpdx    psidx        0        1MEG
Cpsx    psisx        0        1    IC={err0*psiN}
Cpe     psie         0        1    IC={err0*psiN*(1+Streuung)}
Cpdx    psidx        0        1    IC={err0*psiN}
Gpsy    0    psisy    VALUE={v(usy)-Rs*v(isy)-p*(pi/30)*v(n)*v(psisx)} tripdv={tdv} tripdt={tdt}
Gpdy    0    psidy    VALUE={0     -RDy*v(idy)              } tripdv={tdv} tripdt={tdt}
Rpsy    psisy        0        1MEG
Rpdy    psidy        0        1MEG
Cpsy    psisy        0        1    IC=0
Cpdy    psidy        0        1    IC=0
*    Currents
Gisx    0    isx        VALUE={Lsd*v(isx)+v(Lhd3)*(v(isx)+v(ie)+v(idx))-v(psisx)} tripdv={tdv} tripdt={tdt}
Gie        0    ie        VALUE={LE *v(ie)+v(Lhd3)*(v(isx)+v(ie)+v(idx))-v(psie)} tripdv={tdv} tripdt={tdt}
Gidx    0    idx       VALUE={LDx*v(idx)+v(Lhd3)*(v(isx)+v(ie)+v(idx))-v(psidx)} tripdv={tdv} tripdt={tdt}
Risx    isx        0        1MEG
Rie     ie         0        1MEG
Ridx    idx       0        1MEG
Gisy    0    isy       VALUE={Lsq*v(isy)+v(Lhq3)*(v(isy)+v(idy))-v(psisy)} tripdv={tdv} tripdt={tdt}
Gidy    0    idy       VALUE={LDy*v(idy)+v(Lhq3)*(v(isy)+v(idy))-v(psidy)} tripdv={tdv} tripdt={tdt}
Risy    isy    0    1MEG
Ridy    idy    0    1MEG
* nonlinear magnetics
Elhd3 Lhd3 0 VALUE={Lhd3*(1/(a1+(1-a1)*PWRS(LIMIT(abs(v(psihx)+1p)/PsiN,-10,10),m1-1)))} tripdv={tdv} tripdt={tdt}
Elhq3 Lhq3 0 VALUE={Lhq3*(1/(a2+(1-a2)*PWRS(LIMIT(abs(v(psihy)+1p)/PsiN,-10,10),m2-1)))} tripdv={tdv} tripdt={tdt}
*    inner torque and friction
*Gm1     0    mi      VALUE={ v(Lhd3)*(v(isx)+v(ie)+v(idx))*v(isy)} tripdv={tdv} tripdt={tdt}
*Gm2     0    mi      VALUE={-v(Lhq3)*(v(isy)+v(idy))*v(isx)} tripdv={tdv} tripdt={tdt}
*Rm      mi    0      {1.5*p}
Emi		Mi	0	VALUE={1.5*p*(v(psihx)*v(isy)-v(psihy)*v(isx))} tripdv={tdv} tripdt={tdt}
*    Speed n
En    n        0     VALUE={n0+60/(2*pi)/J*V(n1)} tripdv={tdv} tripdt={tdt}
Gn    0       n1     VALUE={(v(mi)+v(M)*Mvz-v(rbg))} tripdv={tdv} tripdt={tdt}
Cn    n1       0      1    IC=0                    
Rn    n1       0      1MEG
*    Friction
GRbg  0	   Rbg1	   TABLE {v(n)} (-1,-1) (1,1)
RRbg  Rbg1	0	   1
ERbg  Rbg   0      VALUE={v(Rbg1)*MN*rbg} tripdv={tdv} tripdt={tdt}
*    angle alpha
Gal   0       alpha  VALUE={p/60*(2*pi)*v(n)} tripdv={tdv} tripdt={tdt}
Cal   alpha   0      1    IC={alpha_0*pi/180}
Ral   alpha   0      1E10
Gcos  0       cosa   VALUE={cos(v(alpha))} tripdv={tdv} tripdt={tdt}
Gsin  0       sina   VALUE={sin(v(alpha))} tripdv={tdv} tripdt={tdt}
Rcos  cosa    0      1
Rsin  sina    0      1
*    stator currents u,v,w system double translation
* isxs=isx*cosa-isy*sina  isys=isy*cosa+isx*sina
*G1 U1 U2 VALUE={v(isxS)+v(i_Null)}
*G2 V1 V2 VALUE={(-v(isxS)+v(isyS)*sqrt(3))/2+v(i_Null)}
*G3 W1 W2 VALUE={(-v(isxS)-v(isyS)*sqrt(3))/2+v(i_Null)}
Gi1    U1    U2     VALUE={v(isx)*v(cosa)-v(isy)*v(sina)+v(i0)} tripdv={tdv} tripdt={tdt}
Gi2a   V1    V2     VALUE={ ((sqrt(3)/2)*v(isy)-v(isx)/2)*v(cosa)} tripdv={tdv} tripdt={tdt}
Gi2b   V1    V2     VALUE={ (v(isy)/2+(sqrt(3)/2)*v(isx))*v(sina) +v(i0)} tripdv={tdv} tripdt={tdt}
Gi3a   W1    W2     VALUE={-((sqrt(3)/2)*v(isy)+v(isx)/2)*v(cosa)} tripdv={tdv} tripdt={tdt}
Gi3b   W1    W2     VALUE={ (v(isy)/2-(sqrt(3)/2)*v(isx))*v(sina) +v(i0)} tripdv={tdv} tripdt={tdt}
GiE2	F1	0	VALUE={v(ie)*g} tripdv={tdv} tripdt={tdt}
*    Starpoint
R2     v2    GND1   1u
R12    u2    GND1   1u
R23    w2    GND1   1u
RGND1  GND1  0  1e6
*    Some measurements (active power, reactive power, load angle)
Etheta theta 0 VALUE={180/pi*atan2(v(usx),v(usy))} tripdv={tdv} tripdt={tdt}
Eimx imx 0 VALUE={v(isx)+v(idx)+v(ie)} tripdv={tdv} tripdt={tdt};magnetizing current
Eimy imy 0 VALUE={v(isy)+v(idy)}       tripdv={tdv} tripdt={tdt};magnetizing current
*
Ev Us 0 VALUE={sqrt(v(usx)*v(usx)+v(usy)*v(usy))} tripdv={tdv} tripdt={tdt}
* Xd=Xq for cylindrical pole machine Xd,Xq different for salient pole
Exd xd 0 VALUE={(v(Lhd3)+Lsd)*2*pi*fn} tripdv={tdv} tripdt={tdt} ;better measured from sliptest
Exq xq 0 VALUE={(v(Lhq3)+Lsq)*2*pi*fn} tripdv={tdv} tripdt={tdt} ;better measured from sliptest
* New added
Epsihx psihx 0 VALUE={v(psisx)-Lsd*v(isx)} tripdv={tdv} tripdt={tdt}
Epsihy psihy 0 VALUE={v(psisy)-Lsq*v(isy)} tripdv={tdv} tripdt={tdt}
Epsihx1 psihx1 0 VALUE={v(psidx)-Ldx*v(iDx)} tripdv={tdv} tripdt={tdt};same as pshihx
Epsihy1 psihy1 0 VALUE={v(psidy)-Ldy*v(iDy)} tripdv={tdv} tripdt={tdt};same as pshihy
Epsihx2 psihx2 0 VALUE={v(psie)-Le*v(ie)}    tripdv={tdv} tripdt={tdt};same as pshihx
Eg  g 0 VALUE={g} tripdv={tdv} tripdt={tdt}
EU  u 0 VALUE={v(us)*sqrt(3)/sqrt(2)} tripdv={tdv} tripdt={tdt}
Ei  i 0 VALUE={0.7071*sqrt(v(isx)*v(isx)+v(isy)*v(isy))} tripdv={tdv} tripdt={tdt}
Eap p 0 VALUE={3*(v(usx)*v(isx)/2+v(usy)*v(isy)/2)}  tripdv={tdv} tripdt={tdt}
Eaq q 0 VALUE={3*(v(usy)*v(isx)/2-v(usx)*v(isy)/2)} tripdv={tdv} tripdt={tdt}
Es  s 0 VALUE={sqrt(v(p)*v(p)+v(q)*v(q))} tripdv={tdv} tripdt={tdt}
* Other formulas for active and reactive power
* Other formulas for active and reactive power
Ephiu phius 0 VALUE={180/pi*atan2(v(usy),v(usx))}  tripdv={tdv} tripdt={tdt} 
Ephii phiis 0 VALUE={180/pi*atan2(v(isy),v(isx))}  tripdv={tdv} tripdt={tdt}
Ephi phi 0 VALUE={(v(phius)-v(phiis))}   tripdv={tdv} tripdt={tdt}
* Other formula for up
*Eup2 up2 0 VALUE={sqrt((v(u)-v(i)*v(xd)*sin(pi/180*v(phi)))*(v(u)-v(i)*v(xd)*sin(pi/180*v(phi)))+(v(i)*v(xd)*cos(pi/180*v(phi)))*(v(i)*v(xd)*cos(pi/180*v(phi))))}  
Eup up 0 VALUE={(v(usy)-v(isx)*v(xd))/sqrt(2)} tripdv={tdv} tripdt={tdt}
*
Ews wmagnstator 0 VALUE={1.5*0.5*(v(psisx)*v(isx)+v(psisy)*v(isy))} tripdv={tdv} tripdt={tdt}
Ewe wmagnexciter 0 VALUE={1.5*0.5*v(psie)*v(ie)} tripdv={tdv} tripdt={tdt}
Ewd wmagndamper 0 VALUE={1.5*0.5*(v(psidx)*v(idx)+v(psidy)*v(idy))}  tripdv={tdv} tripdt={tdt}
Ewsumm wmagnsum 0 VALUE={v(wmagnstator)+v(wmagndamper)+v(wmagnexciter)} tripdv={tdv} tripdt={tdt}
*
* Psum2=Psum3 P from Wmagn ( P=dWmagn/dt )
Etest Psum2 0 VALUE={v(Pstator)+v(Pexciter)+v(Pdamper)} tripdv={tdv} tripdt={tdt} 
Etest2 Psum3 0 VALUE={DDT(v(wmagnstator))+DDT(v(wmagnexciter))+DDT(v(wmagndamper))} tripdv={tdv} tripdt={tdt} 
*
EPstator Pstator  0 VALUE={1.5*(v(isx)*DDT(v(psisx)))+1.5*(v(isy)*DDT(v(psisy)))} tripdv={tdv} tripdt={tdt} 
* Exciter is fed by external unit
EPexiter Pexciter 0 VALUE={1.5*(v(ie)*DDT(v(psie)))} tripdv={tdv} tripdt={tdt}
EPdamper Pdamper 0 VALUE={1.5*(v(idx)*DDT(v(psidx))+v(idy)*DDT(v(psidy)))} tripdv={tdv} tripdt={tdt}
EPsum1 Psum1 0 VALUE={v(Pstator)+v(Pdamper)+v(Pexciter)} tripdv={tdv} tripdt={tdt}
EPsum Psum 0 VALUE={v(Psum1)+V(Pcusum)-v(Pcu3)-v(Pexciter)-V(P)+V(rbg)*omega_el/p} tripdv={tdv} tripdt={tdt}
EPM   Pmech 0 VALUE={-v(M)*omega_el/p} tripdv={tdv} tripdt={tdt}
* other formulas for theta theta2 for non salient machine and theta3 for salient machine
*Etheta2 theta2 0 VALUE={-180/pi*atan2(v(i)*v(xd)*cos(pi/180*v(phi)),(v(u)-v(i)*v(xd)*sin(pi/180*v(phi))))}  ;for round pole
*Etheta3 theta3 0 VALUE={-180/pi*atan2(v(i)*v(xq)*cos(pi/180*v(phi)),(v(u)-v(i)*v(xq)*sin(pi/180*v(phi))))}  ;for salient pole
*
* Qtsum = Qtstator + Qtdamper = -Qtexciter
EQtransf1 Qtstator 0 VALUE={1.5*(v(isx)*DDT(v(psisy))-v(isy)*DDT(v(psisx)))} tripdv={tdv} tripdt={tdt}
EQtransf2 Qtexciter 0 VALUE={1.5*(v(isx)*DDT(v(psihx)))} tripdv={tdv} tripdt={tdt}
EQtransf3 Qtdamper 0 VALUE={1.5*(v(isx)*DDT(v(psihx))+v(isy)*DDT(v(psihy)))} tripdv={tdv} tripdt={tdt}
EQtranssum Qtsum 0 VALUE={v(Qtstator)+v(Qtdamper)} tripdv={tdv} tripdt={tdt}
EQmagn1 Qrotstator 0 VALUE={1.5*omega_el*(v(isx)*v(isx)*(v(Lhd3)+Lsd)+v(isy)*v(isy)*(v(Lhq3)+Lsq))} tripdv={tdv} tripdt={tdt}
EQmagn2 Qrotexciter 0 VALUE={1.5*omega_el*(v(ie)*v(isx)*v(Lhd3))} tripdv={tdv} tripdt={tdt}
EQmagn3 Qrotdamper 0 VALUE={1.5*omega_el*(v(isx)*v(idx)*v(Lhd3)+v(idy)*v(isy)*v(Lhq3))} tripdv={tdv} tripdt={tdt}
EQexciter Qexciter 0 VALUE={v(Qrotexciter)+v(Qtexciter)}  tripdv={tdv} tripdt={tdt}
EQstator Qstator 0 VALUE={v(Qrotstator)+v(Qtstator)}  tripdv={tdv} tripdt={tdt}
EQdamper Qdamper 0 VALUE={v(Qrotdamper)+v(Qtdamper)} tripdv={tdv} tripdt={tdt}
* Qsum = Qstator + Qdamper - Qext = -Qexciter 
EQsum Qsum 0 VALUE={v(Qstator)+v(Qdamper)-V(Q)} tripdv={tdv} tripdt={tdt}
.ends

.SUBCKT Sgen_70MW_constant_speed_type1 U1 V1 W1  F1  M  n GND1
+	PARAMS:
+	UN_verkettet=10300
+	IN={70e6/UN_verkettet/sqrt(3)/0.8} 
+	Pel=70e6  ;UN_verkettet*IN*sqrt(3)*cosphi of 0.8
+	fn={fn1}
+	Kc=0.5
+	UE0=600V ; Power of exciter = 0.25-5% * SN machine (smaller values for higher SN) (UEminmax=0.3-2*UE0) UE=100-600V(old) RE~0.1-1 (typical 0.2-0.5)
+	IE0=500A
+	p=2
+	Streuung=0.05 ;
+	rcu=0.01
+	rbg=0.001
+	Schenkelpolfaktor=1 ;(1=cylindrical pole 0.5=Salient pole)
+	Daempferfaktor=1
+	err0=0 RE_factor=0.6666 ;Matlab compatible with RE_factor=2/3=0.6666
+   n0=1500 ;starts with 1500U/min
+   n1={n0} ;starts with 1500U/min
+   alpha_0=0
+   a=0.9 ; Parameter for nonlinear noload line (should be about 0.6-0.9)
+   m=7
.PARAM
+   a1={a};  Saturation parameter d-axis
+   m1={m};  Saturation parameter d-axis
+   a2={a1}; Saturation parameter q-axis
+   m2={m1}; Saturation parameter q-axis
+	UN={UN_verkettet/sqrt(3)}
+	ZN={UN/IN}
+	Rs={ZN*rcu}
+	omega_el={(2*pi)*fN}
+	Ls={Streuung*ZN/Kc/omega_el}
+	PsiN={sqrt(2)*UN/omega_el}
+	RE={UE0/IE0}
+	RD={Rs/Daempferfaktor}
+   RDx={RD} ; can be overwritten by setting this parameters on modelline
+   RDy={RD} ; can be overwritten by setting this parameters on modelline
+   LDx={Ls} ; can be overwritten by setting this parameters on modelline
+   LDy={Ls} ; can be overwritten by setting this parameters on modelline
+   LE={Ls} ; can be overwritten by setting this parameters on modelline
+   R0={Rs} ; can be overwritten by setting this parameters on modelline
+   L0={Ls} ; can be overwritten by setting this parameters on modelline (X0 is 0.03-0.1 p.u)
+   Lsd={Ls} 
+   Lsq={Ls}
+   XD={UN/IN/Kc}
+   XQ={XD*Schenkelpolfaktor}
+   g={UE0/(UN*sqrt(2)*RE/(XD-omega_el*Lsd))} ; updated formula for g parameter
+   g1={UE0/(UN*sqrt(2)*RE/(XQ-omega_el*Lsq))} ; updated formula for salient pole machine
+	ImNx={IE0/g} ; d-axis magnetizing current
+	ImNy={IE0/g1} ;q-axis magnetizing current
+	MN={Pel*(1-rbg-rcu)*p/omega_el}
+  Lhd3={XD/(2*pi*fn)-Lsd}
+  Lhq3={XQ/(2*pi*fn)-Lsq}
Rf1 f1 0 1e12
Rm  m  0 1e12
Rn2  n  0 1e12
Eun un 0 VALUE={Un} tripdv={tdv} tripdt={tdt}
Ein in 0 VALUE={In} tripdv={tdv} tripdt={tdt}
Esn sn 0 VALUE={3*Un*In} tripdv={tdv} tripdt={tdt}
Epn pn 0 VALUE={pel} tripdv={tdv} tripdt={tdt}
Ecosphin cosphi 0 VALUE={pel/(3*Un*In)} tripdv={tdv} tripdt={tdt}
Ezn zn 0 VALUE={Zn} tripdv={tdv} tripdt={tdt}
Ers rs 0 VALUE={Rs} tripdv={tdv} tripdt={tdt}
* New
Epcu pcu 0 VALUE={3*v(i)*v(i)*Rs} tripdv={tdv} tripdt={tdt}
* Pcu1 same as Pcu
*Epcu1 pcu1 0 VALUE={1.5*Rs*(v(isx)*v(isx)+v(isy)*v(isy))} tripdv={tdv} tripdt={tdt}
Epcu2 pcu2 0 VALUE={v(idx)*v(idx)*RDx+v(idy)*v(idy)*RDy} tripdv={tdv} tripdt={tdt}
* This loss is fed by the external exciter !!!! Pcu_exciter=UE*IE
Epcu3 pcu3 0 VALUE={v(ie)*v(ie)*g*g*Re*RE_factor} tripdv={tdv} tripdt={tdt}
Epcusum pcusum 0 VALUE={v(pcu)+v(pcu2)+v(pcu3)} tripdv={tdv} tripdt={tdt}
*	currents of windings
G1	U1	U2	VALUE={v(isxS)+v(i_Null)} tripdv={tdv} tripdt={tdt}
G2	V1	V2	VALUE={(-v(isxS)+v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
G3	W1	W2	VALUE={(-v(isxS)-v(isyS)*sqrt(3))/2+v(i_Null)} tripdv={tdv} tripdt={tdt}
GiE	F1	0	VALUE={v(ie)*g} tripdv={tdv} tripdt={tdt}
*	voltage components
EuxS	usxS	0	VALUE={(2*v(u1,u2)-v(v1,v2)-v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
EuyS	usyS	0	VALUE={(v(v1,v2)-v(w1,w2))/sqrt(3)} tripdv={tdv} tripdt={tdt}
Eux	usx	0	VALUE={ v(usxS)*cos(v(alpha))+v(usyS)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
Euy	usy	0	VALUE={-v(usxS)*sin(v(alpha))+v(usyS)*cos(v(alpha))} tripdv={tdv} tripdt={tdt}
*    Starpoint
R2     v2    GND1   1u
R12    u2    GND1   1u
R23    w2    GND1   1u
RGND1  GND1  0  1e6
ErefL1 Uref_L1 0 VALUE={-sqrt(2)*UN*sin(2*pi*(fN*(TIME)))} tripdv={tdv} tripdt={tdt}
*	Nullsystem
Eu0	u_Null 0	VALUE={(v(u1,u2)+v(v1,v2)+v(w1,w2))/3} tripdv={tdv} tripdt={tdt}
Ei0	i_Null 0	VALUE={v(idt1)/L0} tripdv={tdv} tripdt={tdt}
Gi0 0 idt1  VALUE={v(u_Null)-R0*v(i_null)} tripdv={tdv} tripdt={tdt}
Ci0 idt1 0 1 IC=0
Ri0 idt1 0 1e10
*
*	current components
EisxS		isxS	0 VALUE={v(isx)*cos(v(alpha))-v(isy)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
EisyS		isyS	0 VALUE={v(isy)*cos(v(alpha))+v(isx)*sin(v(alpha))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of direct axis with saturation
Gpsix		0	isx	VALUE={v(psisx)} tripdv={tdv} tripdt={tdt}
Rsx		isx	0	{1/Lsd}
Gpsidx	isx	iDx1	VALUE={v(psiDx)} tripdv={tdv} tripdt={tdt} ; *********
Rsdx		iDx1	isx	{1/LDx}
GpsiEx	iDx1	imx1	VALUE={v(psiE)} tripdv={tdv} tripdt={tdt} ; ie oder if ist iDx,imx !!!!
RsEx		imx1	iDx1	{1/LE}
vphx		imx1	imxa1	0
Eimx1		imxa1	0	VALUE={ImNx*(a1*i(vphx)/PsiN+(1-a1)*PWRS(i(vphx)/PsiN,m1))} tripdv={tdv} tripdt={tdt}
*	magnetic coupling of quadrature axis with saturation
Gpsiy		0	isy	VALUE={v(psisy)} tripdv={tdv} tripdt={tdt}
Rsy		isy	0	{1/Lsq}
Gpsidy	isy	imy1	VALUE={v(psiDy)} tripdv={tdv} tripdt={tdt}
Rsdy		imy1	isy	{1/LDy}
vphy		imy1	imya1	0
Eimy1		imya1	0	VALUE={ImNy*(a2*i(vphy)/PsiN+(1-a2)*PWRS(i(vphy)/PsiN,m2))} tripdv={tdv} tripdt={tdt}
*
Eidx  idx 0 VALUE={v(idx1)-v(isx)} tripdv={tdv} tripdt={tdt}
Eidy  idy 0 VALUE={v(imy1)-v(isy)} tripdv={tdv} tripdt={tdt}
Eie ie 0 VALUE={v(imx1)-v(idx1)} tripdv={tdv} tripdt={tdt}
Eimx imx 0 VALUE={v(isx)+v(idx)+v(ie)} tripdv={tdv} tripdt={tdt};magnetizing current d-axes
Eimy imy 0 VALUE={v(isy)+v(idy)}       tripdv={tdv} tripdt={tdt};magnetizing current q-axes

* nonlinear magnetics
Elhd3 Lhd3 0 VALUE={Lhd3*(1/(a1+(1-a1)*PWRS(LIMIT(abs(v(psihx)+1p)/PsiN,-10,10),m1-1)))} tripdv={tdv} tripdt={tdt}
Elhq3 Lhq3 0 VALUE={Lhq3*(1/(a2+(1-a2)*PWRS(LIMIT(abs(v(psihy)+1p)/PsiN,-10,10),m2-1)))} tripdv={tdv} tripdt={tdt}

*	Flux components
Epsi_sx	psisx	0 VALUE={err0*PsiN+v(idt2)} tripdv={tdv} tripdt={tdt}
Gpsi_sx 0 idt2  VALUE={v(usx)-Rs*v(isx)+p*(2*pi)/60*v(n)*v(psisy)} tripdv={tdv} tripdt={tdt}
Cpsi_sx idt2 0 1 IC=0
Rpsi_sx idt2 0 1e10
*
Epsi_sy	psisy	0 VALUE={v(idt3)} tripdv={tdv} tripdt={tdt}
Gpsi_sy 0 idt3  VALUE={v(usy)-Rs*v(isy)-p*(2*pi)/60*v(n)*v(psisx)} tripdv={tdv} tripdt={tdt}
Cpsi_sy idt3 0 1 IC=0
Rpsi_sy idt3 0 1e10
*
Epsi_Dx	psiDx	0 VALUE={err0*psiN+v(idt4)} tripdv={tdv} tripdt={tdt}
Gpsi_Dx 0 idt4  VALUE={-RDx*v(idx)} tripdv={tdv} tripdt={tdt}
Cpsi_Dx idt4 0 1 IC=0
Rpsi_Dx idt4 0 1e10
*

Epsi_Dy	psiDy	0 VALUE={v(idt5)} tripdv={tdv} tripdt={tdt}
Gpsi_Dy 0 idt5  VALUE={-RDy*v(idy)} tripdv={tdv} tripdt={tdt}
Cpsi_Dy idt5 0 1 IC=0
Rpsi_Dy idt5 0 1e10
*
Epsi_E	psiE	0 VALUE={err0*psiN*(1+Streuung)+v(idt6)} tripdv={tdv} tripdt={tdt}
Gpsi_E 0 idt6  VALUE={v(F1,0)*g*RE_factor-RE*RE_factor*g*g*v(ie)} tripdv={tdv} tripdt={tdt} ;<--------- MATLAB compatible 
Cpsi_E idt6 0 1 IC=0
Rpsi_E idt6 0 1e10
*
Gtheta 0 theta VALUE={180/pi*atan2(v(usx),v(usy))} tripdv={tdv} tripdt={tdt}   ;Lastwinkel!!!!
Rtheta theta 0 1
Ctheta theta 0 10u
*
Emi		Mi	0	VALUE={1.5*p*(i(vphx)*v(isy)-i(vphy)*v(isx))} tripdv={tdv} tripdt={tdt}
EMoment	M 0	VALUE={-v(Mi)+v(Rbg)} tripdv={tdv} tripdt={tdt}
Rn1 n 0 1k
Vn n 0 {n1}
* friction
GRbg		0	Rbg	TABLE {v(n)} (-1,-1) (1,1)
RRbg		Rbg	0	{MN*rbg}
* Compute alpha
Gal   0       alpha  VALUE={alpha_0*pi/180+p/60*(2*pi)*n1*TIME} tripdv={tdv} tripdt={tdt}
Ral   alpha   0      1
* Compute n
*En		n	0  VALUE={n0+60/(2*pi)/J*v(idt8)} tripdv={tdv} tripdt={tdt}
*Gn 0 idt8  VALUE={v(M)*Mvz+v(Mi)-v(Rbg)} tripdv={tdv} tripdt={tdt}
*Cn idt8 0 1 IC=0
*Rn idt8 0 1e10
* Compute f
Ef      f   0  VALUE={v(n)*p/60} tripdv={tdv} tripdt={tdt}
* voltage RMS of generator
Ev Us 0 VALUE={sqrt(v(usx)*v(usx)+v(usy)*v(usy))} tripdv={tdv} tripdt={tdt}
* Xd=Xq for cylindrical pole machine Xd,Xq different for salient pole
Exd xd 0 VALUE={(v(Lhd3)+Lsd)*2*pi*fn} tripdv={tdv} tripdt={tdt} ;better measured from sliptest
Exq xq 0 VALUE={(v(Lhq3)+Lsq)*2*pi*fn} tripdv={tdv} tripdt={tdt} ;better measured from sliptest
* New added
Epsihx psihx 0 VALUE={v(psisx)-Lsd*v(isx)} tripdv={tdv} tripdt={tdt}
Epsihy psihy 0 VALUE={v(psisy)-Lsq*v(isy)} tripdv={tdv} tripdt={tdt}
Epsihx1 psihx1 0 VALUE={v(psidx)-Ldx*v(iDx)} tripdv={tdv} tripdt={tdt} ;same as pshihx
Epsihy1 psihy1 0 VALUE={v(psidy)-Ldy*v(iDy)} tripdv={tdv} tripdt={tdt} ;same as pshihy
Epsihx2 psihx2 0 VALUE={v(psie)-Le*v(ie)}  tripdv={tdv} tripdt={tdt}  ;same as pshihx
Eg  g 0 VALUE={g} tripdv={tdv} tripdt={tdt}
EU  u 0 VALUE={v(us)*sqrt(3)/sqrt(2)} tripdv={tdv} tripdt={tdt}
Ei  i 0 VALUE={0.7071*sqrt(v(isx)*v(isx)+v(isy)*v(isy))} tripdv={tdv} tripdt={tdt} 
Eap p 0 VALUE={3*(v(usx)*v(isx)/2+v(usy)*v(isy)/2)}  tripdv={tdv} tripdt={tdt}
Eaq q 0 VALUE={3*(v(usy)*v(isx)/2-v(usx)*v(isy)/2)} tripdv={tdv} tripdt={tdt}
Es  s 0 VALUE={sqrt(v(p)*v(p)+v(q)*v(q))} tripdv={tdv} tripdt={tdt}
* Other formulas for active and reactive power
Ephiu phius 0 VALUE={180/pi*atan2(v(usy),v(usx))}  tripdv={tdv} tripdt={tdt} 
Ephii phiis 0 VALUE={180/pi*atan2(v(isy),v(isx))}  tripdv={tdv} tripdt={tdt}
Ephi phi 0 VALUE={(v(phius)-v(phiis))}   tripdv={tdv} tripdt={tdt}
* Other formula for up
*Eup2 up2 0 VALUE={sqrt((v(u)-v(i)*v(xd)*sin(pi/180*v(phi)))*(v(u)-v(i)*v(xd)*sin(pi/180*v(phi)))+(v(i)*v(xd)*cos(pi/180*v(phi)))*(v(i)*v(xd)*cos(pi/180*v(phi))))}  
Eup up 0 VALUE={(v(usy)-v(isx)*v(xd))/sqrt(2)} tripdv={tdv} tripdt={tdt}
*
Ews wmagnstator 0 VALUE={1.5*0.5*(v(psisx)*v(isx)+v(psisy)*v(isy))} tripdv={tdv} tripdt={tdt}
Ewe wmagnexciter 0 VALUE={1.5*0.5*v(psie)*v(ie)} tripdv={tdv} tripdt={tdt}
Ewd wmagndamper 0 VALUE={1.5*0.5*(v(psidx)*v(idx)+v(psidy)*v(idy))}  tripdv={tdv} tripdt={tdt}
Ewsumm wmagnsum 0 VALUE={v(wmagnstator)+v(wmagndamper)+v(wmagnexciter)} tripdv={tdv} tripdt={tdt}
*
* Psum2=Psum3 P from Wmagn ( P=dWmagn/dt )
Etest Psum2 0 VALUE={v(Pstator)+v(Pexciter)+v(Pdamper)} tripdv={tdv} tripdt={tdt} 
Etest2 Psum3 0 VALUE={DDT(v(wmagnstator))+DDT(v(wmagnexciter))+DDT(v(wmagndamper))} tripdv={tdv} tripdt={tdt} 
*
EPstator Pstator  0 VALUE={1.5*(v(isx)*DDT(v(psisx)))+1.5*(v(isy)*DDT(v(psisy)))} tripdv={tdv} tripdt={tdt} 
* Exciter is fed by external unit
EPexiter Pexciter 0 VALUE={1.5*(v(ie)*DDT(v(psie)))} tripdv={tdv} tripdt={tdt}
EPdamper Pdamper 0 VALUE={1.5*(v(idx)*DDT(v(psidx))+v(idy)*DDT(v(psidy)))} tripdv={tdv} tripdt={tdt}
EPsum1 Psum1 0 VALUE={v(Pstator)+v(Pdamper)+v(Pexciter)} tripdv={tdv} tripdt={tdt}
EPsum Psum 0 VALUE={v(Psum1)+V(Pcusum)-v(Pcu3)-v(Pexciter)-V(P)+V(rbg)*omega_el/p} tripdv={tdv} tripdt={tdt}
EPM   Pmech 0 VALUE={-v(M)*omega_el/p} tripdv={tdv} tripdt={tdt}
* other formulas for theta theta2 for non salient machine and theta3 for salient machine
*Etheta2 theta2 0 VALUE={-180/pi*atan2(v(i)*v(xd)*cos(pi/180*v(phi)),(v(u)-v(i)*v(xd)*sin(pi/180*v(phi))))}  ;for round pole
*Etheta3 theta3 0 VALUE={-180/pi*atan2(v(i)*v(xq)*cos(pi/180*v(phi)),(v(u)-v(i)*v(xq)*sin(pi/180*v(phi))))}  ;for salient pole
*
* Qtsum = Qtstator + Qtdamper = -Qtexciter
EQtransf1 Qtstator 0 VALUE={1.5*(v(isx)*DDT(v(psisy))-v(isy)*DDT(v(psisx)))} tripdv={tdv} tripdt={tdt}
EQtransf2 Qtexciter 0 VALUE={1.5*(v(isx)*DDT(v(psihx)))} tripdv={tdv} tripdt={tdt}
EQtransf3 Qtdamper 0 VALUE={1.5*(v(isx)*DDT(v(psihx))+v(isy)*DDT(v(psihy)))} tripdv={tdv} tripdt={tdt}
EQtranssum Qtsum 0 VALUE={v(Qtstator)+v(Qtdamper)} tripdv={tdv} tripdt={tdt}
EQmagn1 Qrotstator 0 VALUE={1.5*omega_el*(v(isx)*v(isx)*(v(Lhd3)+Lsd)+v(isy)*v(isy)*(v(Lhq3)+Lsq))} tripdv={tdv} tripdt={tdt}
EQmagn2 Qrotexciter 0 VALUE={1.5*omega_el*(v(ie)*v(isx)*v(Lhd3))} tripdv={tdv} tripdt={tdt}
EQmagn3 Qrotdamper 0 VALUE={1.5*omega_el*(v(isx)*v(idx)*v(Lhd3)+v(idy)*v(isy)*v(Lhq3))} tripdv={tdv} tripdt={tdt}
EQexciter Qexciter 0 VALUE={v(Qrotexciter)+v(Qtexciter)}  tripdv={tdv} tripdt={tdt}
EQstator Qstator 0 VALUE={v(Qrotstator)+v(Qtstator)}  tripdv={tdv} tripdt={tdt}
EQdamper Qdamper 0 VALUE={v(Qrotdamper)+v(Qtdamper)} tripdv={tdv} tripdt={tdt}
* Qsum = Qstator + Qdamper - Qext = -Qexciter 
EQsum Qsum 0 VALUE={v(Qstator)+v(Qdamper)-V(Q)} tripdv={tdv} tripdt={tdt}
.ENDS


* Matlab example compatible Sgen 
.subckt Sgen_70MW_constant_speed_type2 U1 V1 W1 F1 M n GND1 params:
+	UN_verkettet=10300
+	IN={70e6/UN_verkettet/sqrt(3)/0.8}
+	Pel=70e6  ;UN_verkettet*IN*sqrt(3)*cosphi of 0.8
+	fn={fn1}
+	Kc=0.5
+	UE0=600V ; Power of exciter = 0.25-5% * SN machine (smaller values for higher SN) (UEminmax=0.3-2*UE0) UE=100-600V(old) RE~0.1-1 (typical 0.2-0.5)
+	IE0=500A
+	p=2
+	Streuung=0.05 ;
+	rcu=0.01
+	rbg=0.001
+	Schenkelpolfaktor=1 ;(1=cylindrical pole 0.5=Salient pole)
+	Daempferfaktor=1
+	err0=0 RE_factor=0.6666 ;Matlab compatible with RE_factor=2/3=0.6666
+   n0=1500 ;starts with 1500U/min
+   n1={n0} ;starts with 1500U/min
+   alpha_0=0
*+  psi_hx0=0; {Lhd3*U_E/RE}
*+  psi_E0=0 ;{(Lhd3+LE)*U_E/RE}
*+  psi_hy0=0   I0_0=0
.PARAM
+	UN={UN_verkettet/sqrt(3)}
+	ZN={UN/IN}
+  XD={UN/IN/Kc}
+   XQ={XD*Schenkelpolfaktor}
+	Rs={ZN*rcu}
+	omega_el={(2*pi)*fN}
+	Ls={Streuung*ZN/Kc/omega_el}
+	PsiN={sqrt(2)*UN/omega_el}
+	RE={UE0/IE0}
+	RD={Rs/Daempferfaktor}
+  RDx={RD} ; can be overwritten by setting this parameters directly here to a numerical value
+  RDy={RD} ; can be overwritten by setting this parameters directly here to a numerical value
+  LDx={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+  LDy={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+  LE={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+  R0={Rs} ; can be overwritten by setting this parameters directly here to a numerical value
+  L0={Ls} ; can be overwritten by setting this parameters directly here to a numerical value(X0 is 0.03-0.1 p.u)
+  Lsd={Ls}
+  Lsq={Ls}
+  Lhd3={XD/(2*pi*fn)-Lsd}
+  Lhq3={XQ/(2*pi*fn)-Lsq}
+   g={UE0/(UN*sqrt(2)*RE/(XD-omega_el*Lsd))}
+	MN={Pel*(1-rbg-rcu)*p/omega_el}
* magnetic voltage  UE0, IE0
* NOTE: Measurement of g: set g=1 see the voltage output of generator
* make now g smaller until the nominal voltage of the generator is present
Rf1 f1 0 1e12
Rm1  m  0 1e12
Rn1  n  0 1e12
Eun un 0 VALUE={Un} tripdv={tdv} tripdt={tdt}
Ein in 0 VALUE={In} tripdv={tdv} tripdt={tdt}
Esn sn 0 VALUE={3*Un*In} tripdv={tdv} tripdt={tdt}
Epn pn 0 VALUE={pel} tripdv={tdv} tripdt={tdt}
Ecosphin cosphi 0 VALUE={pel/(3*Un*In)} tripdv={tdv} tripdt={tdt}
Ezn zn 0 VALUE={Zn} tripdv={tdv} tripdt={tdt}
Ers rs 0 VALUE={Rs} tripdv={tdv} tripdt={tdt}
* New
Epcu pcu 0 VALUE={3*v(i)*v(i)*Rs} tripdv={tdv} tripdt={tdt}
* Pcu1 same as Pcu
*Epcu1 pcu1 0 VALUE={1.5*Rs*(v(isx)*v(isx)+v(isy)*v(isy))} tripdv={tdv} tripdt={tdt}
Epcu2 pcu2 0 VALUE={v(idx)*v(idx)*RDx+v(idy)*v(idy)*RDy} tripdv={tdv} tripdt={tdt}
* This loss is fed by the external exciter !!!! Pcu_exciter=UE*IE
Epcu3 pcu3 0 VALUE={v(ie)*v(ie)*g*g*Re*RE_factor} tripdv={tdv} tripdt={tdt}
Epcusum pcusum 0 VALUE={v(pcu)+v(pcu2)+v(pcu3)} tripdv={tdv} tripdt={tdt}
*
*    Null-System
Gi0    0    i0    VALUE=
+ {((v(U1,U2)+v(V1,V2)+v(W1,W2))/3-R0*v(i0))/L0} tripdv={tdv} tripdt={tdt}
Ci0    i0    0    1    IC=0
Ri0    i0    0    1E6
*    stator voltages rotor/stator system
Guxs    0    usxs    VALUE={2/3*v(U1,U2)-v(V1,V2)/3-v(W1,W2)/3} tripdv={tdv} tripdt={tdt}
Guys    0    usys    VALUE={(v(V1,V2)-v(W1,W2))/sqrt(3)} tripdv={tdv} tripdt={tdt}
Ruxs    usxs    0    1
Ruys    usys    0    1
Guxr    0    usx    VALUE={v(usxs)*v(cosa)+v(usys)*v(sina)} tripdv={tdv} tripdt={tdt}
Guyr    0    usy    VALUE={v(usys)*v(cosa)-v(usxs)*v(sina)} tripdv={tdv} tripdt={tdt}
Ruxr    usx    0    1
Ruyr    usy    0    1
*    fluxes
Gpsx    0    psisx    VALUE={v(usx)-Rs*v(isx)+p*(pi/30)*n1*v(psisy)} tripdv={tdv} tripdt={tdt}
Gpe     0    psie    VALUE={v(F1)*g*RE_factor   -RE*RE_factor*g*g*v(iE) } tripdv={tdv} tripdt={tdt} ;<--------- MATLAB compatible 
Gpdx    0    psidx    VALUE={0     -RDx*v(idx)              } tripdv={tdv} tripdt={tdt}
Rpsx    psisx        0        1MEG
Rpe     psie         0        1MEG
Rpdx    psidx        0        1MEG
Cpsx    psisx        0        1    IC={err0*psiN}
Cpe     psie         0        1    IC={err0*psiN*(1+Streuung)}
Cpdx    psidx        0        1    IC={err0*psiN}
Gpsy    0    psisy    VALUE={v(usy)-Rs*v(isy)-p*(pi/30)*n1*v(psisx)} tripdv={tdv} tripdt={tdt}
Gpdy    0    psidy    VALUE={0     -RDy*v(idy)}   tripdv={tdv} tripdt={tdt}         
Rpsy    psisy        0        1MEG
Rpdy    psidy        0        1MEG
Cpsy    psisy        0        1    IC=0
Cpdy    psidy        0        1    IC=0
*    Currents
Gisx    0    isx        VALUE={Lsd*v(isx)+Lhd3*(v(isx)+v(ie)+v(idx))-v(psisx)} tripdv={tdv} tripdt={tdt}
Gie        0    ie        VALUE={LE *v(ie)+Lhd3*(v(isx)+v(ie)+v(idx))-v(psie)} tripdv={tdv} tripdt={tdt}
Gidx    0    idx       VALUE={LDx*v(idx)+Lhd3*(v(isx)+v(ie)+v(idx))-v(psidx)} tripdv={tdv} tripdt={tdt}
Risx    isx        0        1MEG
Rie     ie         0        1MEG
Ridx    idx       0        1MEG
Gisy    0    isy       VALUE={Lsq*v(isy)+Lhq3*(v(isy)+v(idy))-v(psisy)} tripdv={tdv} tripdt={tdt}
Gidy    0    idy       VALUE={LDy*v(idy)+Lhq3*(v(isy)+v(idy))-v(psidy)} tripdv={tdv} tripdt={tdt}
Risy    isy    0    1MEG
Ridy    idy    0    1MEG
*    inner torque and friction
Gm1     0    mi      VALUE={ Lhd3*(v(isx)+v(ie)+v(idx))*v(isy)} tripdv={tdv} tripdt={tdt}
Gm2     0    mi      VALUE={-Lhq3*(v(isy)+v(idy))*v(isx)} tripdv={tdv} tripdt={tdt}
Rm      mi    0      {1.5*p}
EMoment	M 0	VALUE={-v(Mi)+v(Rbg)} tripdv={tdv} tripdt={tdt}
*    Friction
GRbg  0	   Rbg1	   TABLE {v(n)} (-1,-1) (1,1)
RRbg  Rbg1	0	   1
ERbg  Rbg   0      VALUE={v(Rbg1)*MN*rbg} tripdv={tdv} tripdt={tdt}
En    n  0  Value={N1} tripdv={tdv} tripdt={tdt}
*    angle alpha
Gal   0       alpha  VALUE={alpha_0*pi/180+p/60*(2*pi)*n1*TIME} tripdv={tdv} tripdt={tdt}
Ral   alpha   0      1
Gcos  0       cosa   VALUE={cos(v(alpha))} tripdv={tdv} tripdt={tdt}
Gsin  0       sina   VALUE={sin(v(alpha))} tripdv={tdv} tripdt={tdt}
Rcos  cosa    0      1
Rsin  sina    0      1
*   Stator currents
*    stator currents u,v,w system double translation
* isxs=isx*cosa-isy*sina  isys=isy*cosa+isx*sina
*G1 U1 U2 VALUE={v(isxS)+v(i_Null)}
*G2 V1 V2 VALUE={(-v(isxS)+v(isyS)*sqrt(3))/2+v(i_Null)}
*G3 W1 W2 VALUE={(-v(isxS)-v(isyS)*sqrt(3))/2+v(i_Null)}
Gi1    U1    U2    VALUE={v(isx)*v(cosa)-v(isy)*v(sina)+v(i0)} tripdv={tdv} tripdt={tdt}
Gi2a   V1    V2    VALUE={ ((sqrt(3)/2)*v(isy)-v(isx)/2)*v(cosa)} tripdv={tdv} tripdt={tdt}
Gi2b   V1    V2    VALUE={ (v(isy)/2+(sqrt(3)/2)*v(isx))*v(sina) +v(i0)} tripdv={tdv} tripdt={tdt}
Gi3a   W1    W2    VALUE={-((sqrt(3)/2)*v(isy)+v(isx)/2)*v(cosa)} tripdv={tdv} tripdt={tdt}
Gi3b   W1    W2    VALUE={ (v(isy)/2-(sqrt(3)/2)*v(isx))*v(sina) +v(i0)} tripdv={tdv} tripdt={tdt}
GiEa	F1	0	VALUE={v(ie)*g} tripdv={tdv} tripdt={tdt}
*    Starpoint
R2     v2    GND1   1u
R12    u2    GND1   1u
R23    w2    GND1   1u
RGND1  GND1  0  1e6
*    Some measurements (active power, reactive power, load angle)
Etheta theta 0 VALUE={180/pi*atan2(v(usx),v(usy))} tripdv={tdv} tripdt={tdt}
Eimx imx 0 VALUE={v(isx)+v(idx)+v(ie)} tripdv={tdv} tripdt={tdt};magnetizing current d-axes
Eimy imy 0 VALUE={v(isy)+v(idy)}       tripdv={tdv} tripdt={tdt};magnetizing current q-axes
*
Ef      f   0  VALUE={v(n)*p/60} tripdv={tdv} tripdt={tdt}
*
Ev Us 0 VALUE={sqrt(v(usx)*v(usx)+v(usy)*v(usy))} tripdv={tdv} tripdt={tdt}
Elhd3 Lhd3 0 VALUE={Lhd3} tripdv={tdv} tripdt={tdt}
Elhq3 Lhq3 0 VALUE={Lhq3} tripdv={tdv} tripdt={tdt}
* Xd=Xq for cylindrical pole machine Xd,Xq different for salient pole
Exd xd 0 VALUE={Xd} tripdv={tdv} tripdt={tdt} ;better measured from sliptest
Exq xq 0 VALUE={Xq}   tripdv={tdv} tripdt={tdt} ;better measured from sliptest
* New added
* New added
Epsihx psihx 0 VALUE={v(psisx)-Lsd*v(isx)} tripdv={tdv} tripdt={tdt}
Epsihy psihy 0 VALUE={v(psisy)-Lsq*v(isy)} tripdv={tdv} tripdt={tdt}
Epsihx1 psihx1 0 VALUE={v(psidx)-Ldx*v(iDx)} tripdv={tdv} tripdt={tdt} ;same as pshihx
Epsihy1 psihy1 0 VALUE={v(psidy)-Ldy*v(iDy)} tripdv={tdv} tripdt={tdt} ;same as pshihy
Epsihx2 psihx2 0 VALUE={v(psie)-Le*v(ie)}  tripdv={tdv} tripdt={tdt}  ;same as pshihx
Eg  g 0 VALUE={g} tripdv={tdv} tripdt={tdt}
EU  u 0 VALUE={v(us)*sqrt(3)/sqrt(2)} tripdv={tdv} tripdt={tdt}
Ei  i 0 VALUE={0.7071*sqrt(v(isx)*v(isx)+v(isy)*v(isy))} tripdv={tdv} tripdt={tdt} 
Eap p 0 VALUE={3*(v(usx)*v(isx)/2+v(usy)*v(isy)/2)}  tripdv={tdv} tripdt={tdt}
Eaq q 0 VALUE={3*(v(usy)*v(isx)/2-v(usx)*v(isy)/2)} tripdv={tdv} tripdt={tdt}
Es  s 0 VALUE={sqrt(v(p)*v(p)+v(q)*v(q))} tripdv={tdv} tripdt={tdt}
* Other formulas for active and reactive power
Ephiu phius 0 VALUE={180/pi*atan2(v(usy),v(usx))}  tripdv={tdv} tripdt={tdt} 
Ephii phiis 0 VALUE={180/pi*atan2(v(isy),v(isx))}  tripdv={tdv} tripdt={tdt}
Ephi phi 0 VALUE={(v(phius)-v(phiis))}   tripdv={tdv} tripdt={tdt}
* Other formula for up
*Eup2 up2 0 VALUE={sqrt((v(u)-v(i)*v(xd)*sin(pi/180*v(phi)))*(v(u)-v(i)*v(xd)*sin(pi/180*v(phi)))+(v(i)*v(xd)*cos(pi/180*v(phi)))*(v(i)*v(xd)*cos(pi/180*v(phi))))}  
Eup up 0 VALUE={(v(usy)-v(isx)*v(xd))/sqrt(2)} tripdv={tdv} tripdt={tdt}
*
Ews wmagnstator 0 VALUE={1.5*0.5*(v(psisx)*v(isx)+v(psisy)*v(isy))} tripdv={tdv} tripdt={tdt}
Ewe wmagnexciter 0 VALUE={1.5*0.5*v(psie)*v(ie)} tripdv={tdv} tripdt={tdt}
Ewd wmagndamper 0 VALUE={1.5*0.5*(v(psidx)*v(idx)+v(psidy)*v(idy))}  tripdv={tdv} tripdt={tdt}
Ewsumm wmagnsum 0 VALUE={v(wmagnstator)+v(wmagndamper)+v(wmagnexciter)} tripdv={tdv} tripdt={tdt}
*
* Psum2=Psum3 P from Wmagn ( P=dWmagn/dt )
Etest Psum2 0 VALUE={v(Pstator)+v(Pexciter)+v(Pdamper)} tripdv={tdv} tripdt={tdt} 
Etest2 Psum3 0 VALUE={DDT(v(wmagnstator))+DDT(v(wmagnexciter))+DDT(v(wmagndamper))} tripdv={tdv} tripdt={tdt} 
*
EPstator Pstator  0 VALUE={1.5*(v(isx)*DDT(v(psisx)))+1.5*(v(isy)*DDT(v(psisy)))} tripdv={tdv} tripdt={tdt} 
* Exciter is fed by external unit
EPexiter Pexciter 0 VALUE={1.5*(v(ie)*DDT(v(psie)))} tripdv={tdv} tripdt={tdt}
EPdamper Pdamper 0 VALUE={1.5*(v(idx)*DDT(v(psidx))+v(idy)*DDT(v(psidy)))} tripdv={tdv} tripdt={tdt}
EPsum1 Psum1 0 VALUE={v(Pstator)+v(Pdamper)+v(Pexciter)} tripdv={tdv} tripdt={tdt}
EPsum Psum 0 VALUE={v(Psum1)+V(Pcusum)-v(Pcu3)-v(Pexciter)-V(P)+V(rbg)*omega_el/p} tripdv={tdv} tripdt={tdt}
EPM   Pmech 0 VALUE={-v(M)*omega_el/p} tripdv={tdv} tripdt={tdt}
* other formulas for theta theta2 for non salient machine and theta3 for salient machine
*Etheta2 theta2 0 VALUE={-180/pi*atan2(v(i)*v(xd)*cos(pi/180*v(phi)),(v(u)-v(i)*v(xd)*sin(pi/180*v(phi))))}  ;for round pole
*Etheta3 theta3 0 VALUE={-180/pi*atan2(v(i)*v(xq)*cos(pi/180*v(phi)),(v(u)-v(i)*v(xq)*sin(pi/180*v(phi))))}  ;for salient pole
*
* Qtsum = Qtstator + Qtdamper = -Qtexciter
EQtransf1 Qtstator 0 VALUE={1.5*(v(isx)*DDT(v(psisy))-v(isy)*DDT(v(psisx)))} tripdv={tdv} tripdt={tdt}
EQtransf2 Qtexciter 0 VALUE={1.5*(v(isx)*DDT(v(psihx)))} tripdv={tdv} tripdt={tdt}
EQtransf3 Qtdamper 0 VALUE={1.5*(v(isx)*DDT(v(psihx))+v(isy)*DDT(v(psihy)))} tripdv={tdv} tripdt={tdt}
EQtranssum Qtsum 0 VALUE={v(Qtstator)+v(Qtdamper)} tripdv={tdv} tripdt={tdt}
EQmagn1 Qrotstator 0 VALUE={1.5*omega_el*(v(isx)*v(isx)*(v(Lhd3)+Lsd)+v(isy)*v(isy)*(v(Lhq3)+Lsq))} tripdv={tdv} tripdt={tdt}
EQmagn2 Qrotexciter 0 VALUE={1.5*omega_el*(v(ie)*v(isx)*v(Lhd3))} tripdv={tdv} tripdt={tdt}
EQmagn3 Qrotdamper 0 VALUE={1.5*omega_el*(v(isx)*v(idx)*v(Lhd3)+v(idy)*v(isy)*v(Lhq3))} tripdv={tdv} tripdt={tdt}
EQexciter Qexciter 0 VALUE={v(Qrotexciter)+v(Qtexciter)}  tripdv={tdv} tripdt={tdt}
EQstator Qstator 0 VALUE={v(Qrotstator)+v(Qtstator)}  tripdv={tdv} tripdt={tdt}
EQdamper Qdamper 0 VALUE={v(Qrotdamper)+v(Qtdamper)} tripdv={tdv} tripdt={tdt}
* Qsum = Qstator + Qdamper - Qext = -Qexciter 
EQsum Qsum 0 VALUE={v(Qstator)+v(Qdamper)-V(Q)} tripdv={tdv} tripdt={tdt}
.ends

.subckt Sgen_70MW_constant_speed_type3 U1 V1 W1 F1 M n GND1 params:
+	UN_verkettet=10300
+	IN={70e6/UN_verkettet/sqrt(3)/0.8} 
+	Pel=70e6  ;UN_verkettet*IN*sqrt(3)*cosphi of 0.8
+	fn={fn1}
+	Kc=0.5
+	UE0=600V ; Power of exciter = 0.25-5% * SN machine (smaller values for higher SN) (UEminmax=0.3-2*UE0) UE=100-600V(old) RE~0.1-1 (typical 0.2-0.5)
+	IE0=500A
+	p=2
+	Streuung=0.05 ;
+	rcu=0.01
+	rbg=0.001
+	Schenkelpolfaktor=1 ;(1=cylindrical pole 0.5=Salient pole)
+	Daempferfaktor=1
+	err0=0 RE_factor=0.6666 ;Matlab compatible with RE_factor=2/3=0.6666
+   n0=1500 ;starts with 1500U/min
+   n1={n0} ;starts with 1500U/min
+   alpha_0=0
+   a=0.9 ; Parameter for nonlinear noload line (should be about 0.6-0.9)
+   m=7
.PARAM
+  a1={a}
+  m1={m}
+  a2={a}
+  m2={m}
+	UN={UN_verkettet/sqrt(3)}
+	ZN={UN/IN}
+  XD={UN/IN/Kc}
+   XQ={XD*Schenkelpolfaktor}
+	Rs={ZN*rcu}
+	omega_el={(2*pi)*fN}
+	Ls={Streuung*ZN/Kc/omega_el}
+	PsiN={sqrt(2)*UN/omega_el}
+	RE={UE0/IE0}
+	RD={Rs/Daempferfaktor}
+  RDx={RD} ; can be overwritten by setting this parameters directly here to a numerical value
+  RDy={RD} ; can be overwritten by setting this parameters directly here to a numerical value
+  LDx={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+  LDy={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+  LE={Ls} ; can be overwritten by setting this parameters directly here to a numerical value
+  R0={Rs} ; can be overwritten by setting this parameters directly here to a numerical value
+  L0={Ls} ; can be overwritten by setting this parameters directly here to a numerical value(X0 is 0.03-0.1 p.u)
+  Lsd={Ls}
+  Lsq={Ls}
+  Lhd3={XD/(2*pi*fn)-Lsd}
+  Lhq3={XQ/(2*pi*fn)-Lsq}
+   g={UE0/(UN*sqrt(2)*RE/(XD-omega_el*Lsd))}
;+   g={IE0/((1+Streuung)*Kc*IN*sqrt(2))}
+	MN={Pel*(1-rbg-rcu)*p/omega_el}
* magnetic voltage  UE0, IE0
* NOTE: Measurement of g: set g=1 see the voltage output of generator
* make now g smaller until the nominal voltage of the generator is present
Rf1 f1 0 1e12
Rm1  m  0 1e12
Rn1  n  0 1e12
Eun un 0 VALUE={Un} tripdv={tdv} tripdt={tdt}
Ein in 0 VALUE={In} tripdv={tdv} tripdt={tdt}
Esn sn 0 VALUE={3*Un*In} tripdv={tdv} tripdt={tdt}
Epn pn 0 VALUE={pel} tripdv={tdv} tripdt={tdt}
Ecosphin cosphi 0 VALUE={pel/(3*Un*In)} tripdv={tdv} tripdt={tdt}
Ezn zn 0 VALUE={Zn} tripdv={tdv} tripdt={tdt}
Ers rs 0 VALUE={Rs} tripdv={tdv} tripdt={tdt}
* New
Epcu pcu 0 VALUE={3*v(i)*v(i)*Rs} tripdv={tdv} tripdt={tdt}
* Pcu1 same as Pcu
*Epcu1 pcu1 0 VALUE={1.5*Rs*(v(isx)*v(isx)+v(isy)*v(isy))} tripdv={tdv} tripdt={tdt}
Epcu2 pcu2 0 VALUE={v(idx)*v(idx)*RDx+v(idy)*v(idy)*RDy} tripdv={tdv} tripdt={tdt}
* This loss is fed by the external exciter !!!! Pcu_exciter=UE*IE
Epcu3 pcu3 0 VALUE={v(ie)*v(ie)*g*g*Re*RE_factor} tripdv={tdv} tripdt={tdt}
Epcusum pcusum 0 VALUE={v(pcu)+v(pcu2)+v(pcu3)} tripdv={tdv} tripdt={tdt}
*    Null-System
Gi0    0    i0    VALUE=
+ {((v(U1,U2)+v(V1,V2)+v(W1,W2))/3-R0*v(i0))/L0} tripdv={tdv} tripdt={tdt}
Ci0    i0    0    1    IC=0
Ri0    i0    0    1E6
*    stator voltages rotor/stator system
Guxs    0    usxs    VALUE={2/3*v(U1,U2)-v(V1,V2)/3-v(W1,W2)/3} tripdv={tdv} tripdt={tdt}
Guys    0    usys    VALUE={(v(V1,V2)-v(W1,W2))/sqrt(3)} tripdv={tdv} tripdt={tdt}
Ruxs    usxs    0    1
Ruys    usys    0    1
Guxr    0    usx    VALUE={v(usxs)*v(cosa)+v(usys)*v(sina)} tripdv={tdv} tripdt={tdt}
Guyr    0    usy    VALUE={v(usys)*v(cosa)-v(usxs)*v(sina)} tripdv={tdv} tripdt={tdt}
Ruxr    usx    0    1
Ruyr    usy    0    1
*    fluxes
Gpsx    0    psisx    VALUE={v(usx)-Rs*v(isx)+p*(pi/30)*n1*v(psisy)} tripdv={tdv} tripdt={tdt}
Gpe     0    psie    VALUE={v(F1)*g*RE_factor   -RE*RE_factor*g*g*v(iE) } tripdv={tdv} tripdt={tdt} ;<--------- MATLAB compatible 
Gpdx    0    psidx    VALUE={0     -RDx*v(idx)              } tripdv={tdv} tripdt={tdt}
Rpsx    psisx        0        1MEG
Rpe     psie         0        1MEG
Rpdx    psidx        0        1MEG
Cpsx    psisx        0        1    IC={err0*psiN}
Cpe     psie         0        1    IC={err0*psiN*(1+Streuung)}
Cpdx    psidx        0        1    IC={err0*psiN}
Gpsy    0    psisy    VALUE={v(usy)-Rs*v(isy)-p*(pi/30)*n1*v(psisx)} tripdv={tdv} tripdt={tdt}
Gpdy    0    psidy    VALUE={0     -RDy*v(idy)}   tripdv={tdv} tripdt={tdt}         
Rpsy    psisy        0        1MEG
Rpdy    psidy        0        1MEG
Cpsy    psisy        0        1    IC=0
Cpdy    psidy        0        1    IC=0
*    Currents
Gisx    0    isx        VALUE={Lsd*v(isx)+v(Lhd3)*(v(isx)+v(ie)+v(idx))-v(psisx)} tripdv={tdv} tripdt={tdt}
Gie        0    ie        VALUE={LE *v(ie)+v(Lhd3)*(v(isx)+v(ie)+v(idx))-v(psie)} tripdv={tdv} tripdt={tdt}
Gidx    0    idx       VALUE={LDx*v(idx)+v(Lhd3)*(v(isx)+v(ie)+v(idx))-v(psidx)} tripdv={tdv} tripdt={tdt}
Risx    isx        0        1MEG
Rie     ie         0        1MEG
Ridx    idx       0        1MEG
Gisy    0    isy       VALUE={Lsq*v(isy)+v(Lhq3)*(v(isy)+v(idy))-v(psisy)} tripdv={tdv} tripdt={tdt}
Gidy    0    idy       VALUE={LDy*v(idy)+v(Lhq3)*(v(isy)+v(idy))-v(psidy)} tripdv={tdv} tripdt={tdt}
Risy    isy    0    1MEG
Ridy    idy    0    1MEG
* nonlinear magnetics
Elhd3 Lhd3 0 VALUE={Lhd3*(1/(a1+(1-a1)*PWRS(LIMIT(abs(v(psihx)+1p)/PsiN,-10,10),m1-1)))} tripdv={tdv} tripdt={tdt}
Elhq3 Lhq3 0 VALUE={Lhq3*(1/(a2+(1-a2)*PWRS(LIMIT(abs(v(psihy)+1p)/PsiN,-10,10),m2-1)))} tripdv={tdv} tripdt={tdt}
*    inner torque and friction
*Gm1     0    mi      VALUE={ v(Lhd3)*(v(isx)+v(ie)+v(idx))*v(isy)} tripdv={tdv} tripdt={tdt}
*Gm2     0    mi      VALUE={-v(Lhq3)*(v(isy)+v(idy))*v(isx)} tripdv={tdv} tripdt={tdt}
*Rm      mi    0      {1.5*p}
Emi		Mi	0	VALUE={1.5*p*(v(psihx)*v(isy)-v(psihy)*v(isx))} tripdv={tdv} tripdt={tdt}
EMoment	M 0	VALUE={-v(Mi)+v(Rbg)} tripdv={tdv} tripdt={tdt}
*    Friction
GRbg  0	   Rbg1	   TABLE {v(n)} (-1,-1) (1,1)
RRbg  Rbg1	0	   1
ERbg  Rbg   0      VALUE={v(Rbg1)*MN*rbg} tripdv={tdv} tripdt={tdt}
En    n  0  Value={N1} tripdv={tdv} tripdt={tdt}
*    angle alpha
Gal   0       alpha  VALUE={alpha_0*pi/180+p/60*(2*pi)*n1*TIME} tripdv={tdv} tripdt={tdt}
Ral   alpha   0      1
Gcos  0       cosa   VALUE={cos(v(alpha))} tripdv={tdv} tripdt={tdt}
Gsin  0       sina   VALUE={sin(v(alpha))} tripdv={tdv} tripdt={tdt}
Rcos  cosa    0      1
Rsin  sina    0      1
*   Stator currents
*    stator currents u,v,w system double translation
* isxs=isx*cosa-isy*sina  isys=isy*cosa+isx*sina
*G1 U1 U2 VALUE={v(isxS)+v(i_Null)}
*G2 V1 V2 VALUE={(-v(isxS)+v(isyS)*sqrt(3))/2+v(i_Null)}
*G3 W1 W2 VALUE={(-v(isxS)-v(isyS)*sqrt(3))/2+v(i_Null)}
Gi1    U1    U2    VALUE={v(isx)*v(cosa)-v(isy)*v(sina)+v(i0)} tripdv={tdv} tripdt={tdt}
Gi2a   V1    V2    VALUE={ ((sqrt(3)/2)*v(isy)-v(isx)/2)*v(cosa)} tripdv={tdv} tripdt={tdt}
Gi2b   V1    V2    VALUE={ (v(isy)/2+(sqrt(3)/2)*v(isx))*v(sina) +v(i0)} tripdv={tdv} tripdt={tdt}
Gi3a   W1    W2    VALUE={-((sqrt(3)/2)*v(isy)+v(isx)/2)*v(cosa)} tripdv={tdv} tripdt={tdt}
Gi3b   W1    W2    VALUE={ (v(isy)/2-(sqrt(3)/2)*v(isx))*v(sina) +v(i0)} tripdv={tdv} tripdt={tdt}
GiEa	F1	0	VALUE={v(ie)*g} tripdv={tdv} tripdt={tdt}
*    Starpoint
R2     v2    GND1   1u
R12    u2    GND1   1u
R23    w2    GND1   1u
RGND1  GND1  0  1e6
*    Some measurements (active power, reactive power, load angle)
Etheta theta 0 VALUE={180/pi*atan2(v(usx),v(usy))} tripdv={tdv} tripdt={tdt}
Eimx imx 0 VALUE={v(isx)+v(idx)+v(ie)} tripdv={tdv} tripdt={tdt};magnetizing current d-axes
Eimy imy 0 VALUE={v(isy)+v(idy)}       tripdv={tdv} tripdt={tdt};magnetizing current q-axes
* Compute f
Ef      f   0  VALUE={v(n)*p/60} tripdv={tdv} tripdt={tdt}
*
Ev Us 0 VALUE={sqrt(v(usx)*v(usx)+v(usy)*v(usy))} tripdv={tdv} tripdt={tdt}
* Xd=Xq for cylindrical pole machine Xd,Xq different for salient pole
Exd xd 0 VALUE={(v(Lhd3)+Lsd)*2*pi*fn} tripdv={tdv} tripdt={tdt} ;better measured from sliptest
Exq xq 0 VALUE={(v(Lhq3)+Lsq)*2*pi*fn} tripdv={tdv} tripdt={tdt} ;better measured from sliptest
* New added
Epsihx psihx 0 VALUE={v(psisx)-Lsd*v(isx)} tripdv={tdv} tripdt={tdt}
Epsihy psihy 0 VALUE={v(psisy)-Lsq*v(isy)} tripdv={tdv} tripdt={tdt}
Epsihx1 psihx1 0 VALUE={v(psidx)-Ldx*v(iDx)} tripdv={tdv} tripdt={tdt};same as pshihx
Epsihy1 psihy1 0 VALUE={v(psidy)-Ldy*v(iDy)} tripdv={tdv} tripdt={tdt};same as pshihy
Epsihx2 psihx2 0 VALUE={v(psie)-Le*v(ie)}    tripdv={tdv} tripdt={tdt};same as pshihx
Eg  g 0 VALUE={g} tripdv={tdv} tripdt={tdt}
EU  u 0 VALUE={v(us)*sqrt(3)/sqrt(2)} tripdv={tdv} tripdt={tdt}
Ei  i 0 VALUE={0.7071*sqrt(v(isx)*v(isx)+v(isy)*v(isy))} tripdv={tdv} tripdt={tdt}
Eap p 0 VALUE={3*(v(usx)*v(isx)/2+v(usy)*v(isy)/2)}  tripdv={tdv} tripdt={tdt}
Eaq q 0 VALUE={3*(v(usy)*v(isx)/2-v(usx)*v(isy)/2)} tripdv={tdv} tripdt={tdt}
Es  s 0 VALUE={sqrt(v(p)*v(p)+v(q)*v(q))} tripdv={tdv} tripdt={tdt}
* Other formulas for active and reactive power
* Other formulas for active and reactive power
Ephiu phius 0 VALUE={180/pi*atan2(v(usy),v(usx))}  tripdv={tdv} tripdt={tdt} 
Ephii phiis 0 VALUE={180/pi*atan2(v(isy),v(isx))}  tripdv={tdv} tripdt={tdt}
Ephi phi 0 VALUE={(v(phius)-v(phiis))}   tripdv={tdv} tripdt={tdt}
* Other formula for up
*Eup2 up2 0 VALUE={sqrt((v(u)-v(i)*v(xd)*sin(pi/180*v(phi)))*(v(u)-v(i)*v(xd)*sin(pi/180*v(phi)))+(v(i)*v(xd)*cos(pi/180*v(phi)))*(v(i)*v(xd)*cos(pi/180*v(phi))))}  
Eup up 0 VALUE={(v(usy)-v(isx)*v(xd))/sqrt(2)} tripdv={tdv} tripdt={tdt}
*
Ews wmagnstator 0 VALUE={1.5*0.5*(v(psisx)*v(isx)+v(psisy)*v(isy))} tripdv={tdv} tripdt={tdt}
Ewe wmagnexciter 0 VALUE={1.5*0.5*v(psie)*v(ie)} tripdv={tdv} tripdt={tdt}
Ewd wmagndamper 0 VALUE={1.5*0.5*(v(psidx)*v(idx)+v(psidy)*v(idy))}  tripdv={tdv} tripdt={tdt}
Ewsumm wmagnsum 0 VALUE={v(wmagnstator)+v(wmagndamper)+v(wmagnexciter)} tripdv={tdv} tripdt={tdt}
*
* Psum2=Psum3 P from Wmagn ( P=dWmagn/dt )
Etest Psum2 0 VALUE={v(Pstator)+v(Pexciter)+v(Pdamper)} tripdv={tdv} tripdt={tdt} 
Etest2 Psum3 0 VALUE={DDT(v(wmagnstator))+DDT(v(wmagnexciter))+DDT(v(wmagndamper))} tripdv={tdv} tripdt={tdt} 
*
EPstator Pstator  0 VALUE={1.5*(v(isx)*DDT(v(psisx)))+1.5*(v(isy)*DDT(v(psisy)))} tripdv={tdv} tripdt={tdt} 
* Exciter is fed by external unit
EPexiter Pexciter 0 VALUE={1.5*(v(ie)*DDT(v(psie)))} tripdv={tdv} tripdt={tdt}
EPdamper Pdamper 0 VALUE={1.5*(v(idx)*DDT(v(psidx))+v(idy)*DDT(v(psidy)))} tripdv={tdv} tripdt={tdt}
EPsum1 Psum1 0 VALUE={v(Pstator)+v(Pdamper)+v(Pexciter)} tripdv={tdv} tripdt={tdt}
EPsum Psum 0 VALUE={v(Psum1)+V(Pcusum)-v(Pcu3)-v(Pexciter)-V(P)+V(rbg)*omega_el/p} tripdv={tdv} tripdt={tdt}
EPM   Pmech 0 VALUE={-v(M)*omega_el/p} tripdv={tdv} tripdt={tdt}
* other formulas for theta theta2 for non salient machine and theta3 for salient machine
*Etheta2 theta2 0 VALUE={-180/pi*atan2(v(i)*v(xd)*cos(pi/180*v(phi)),(v(u)-v(i)*v(xd)*sin(pi/180*v(phi))))}  ;for round pole
*Etheta3 theta3 0 VALUE={-180/pi*atan2(v(i)*v(xq)*cos(pi/180*v(phi)),(v(u)-v(i)*v(xq)*sin(pi/180*v(phi))))}  ;for salient pole
*
* Qtsum = Qtstator + Qtdamper = -Qtexciter
EQtransf1 Qtstator 0 VALUE={1.5*(v(isx)*DDT(v(psisy))-v(isy)*DDT(v(psisx)))} tripdv={tdv} tripdt={tdt}
EQtransf2 Qtexciter 0 VALUE={1.5*(v(isx)*DDT(v(psihx)))} tripdv={tdv} tripdt={tdt}
EQtransf3 Qtdamper 0 VALUE={1.5*(v(isx)*DDT(v(psihx))+v(isy)*DDT(v(psihy)))} tripdv={tdv} tripdt={tdt}
EQtranssum Qtsum 0 VALUE={v(Qtstator)+v(Qtdamper)} tripdv={tdv} tripdt={tdt}
EQmagn1 Qrotstator 0 VALUE={1.5*omega_el*(v(isx)*v(isx)*(v(Lhd3)+Lsd)+v(isy)*v(isy)*(v(Lhq3)+Lsq))} tripdv={tdv} tripdt={tdt}
EQmagn2 Qrotexciter 0 VALUE={1.5*omega_el*(v(ie)*v(isx)*v(Lhd3))} tripdv={tdv} tripdt={tdt}
EQmagn3 Qrotdamper 0 VALUE={1.5*omega_el*(v(isx)*v(idx)*v(Lhd3)+v(idy)*v(isy)*v(Lhq3))} tripdv={tdv} tripdt={tdt}
EQexciter Qexciter 0 VALUE={v(Qrotexciter)+v(Qtexciter)}  tripdv={tdv} tripdt={tdt}
EQstator Qstator 0 VALUE={v(Qrotstator)+v(Qtstator)}  tripdv={tdv} tripdt={tdt}
EQdamper Qdamper 0 VALUE={v(Qrotdamper)+v(Qtdamper)} tripdv={tdv} tripdt={tdt}
* Qsum = Qstator + Qdamper - Qext = -Qexciter 
EQsum Qsum 0 VALUE={v(Qstator)+v(Qdamper)-V(Q)} tripdv={tdv} tripdt={tdt}
.ends

* fixed magn. field on, avr off
* speedcontroller on / fixm off
*
.SUBCKT GEN_70MW_10kV_110kV_mit_Trafo 1U2 1V2 1W2 Verr1 M1 n GND1
+ PARAMS: Schenkelpolfaktor=1 Daempferfaktor=1 Streuung=0.05 rcu=0.01 rbg=0.001 n0=1500 p=2 a=0.9 m=11 kc=0.5 err0=0 RE_factor=1
+ nsoll=1500 vsoll=10300 n_kp=200000 n_Tn=0.05 f1_kp=0.01 f1_Tn=0.1
+ t_start_avr=5.5s t_stop_avr=1e6 t_start_fixerr=1e6 t_stop_fixerr=5.6s t_stop_nreg=1250ms t_start_nreg=1e6 t_start_fixm=1200m t_stop_fixm=1e6
+ t_sync=1200ms t_sync_off=1e6 t_enable_avr=5.5s  t_enablev_avr=5s t_start_gnd2=10e6 t_stop_gnd2=1e6
.param cosphi=0.8
.param J=100000 UN_verkettet=10300 IN={4.1k/cosphi} UE0=600V IE0=500A Pel=70e6
*************
* Generator *
*************
RM1  M1  0  1e12
XU1 u2 v2 w2 verr M n GND1 Block1 J={J} UN_verkettet={UN_verkettet} IN={IN} Kc={Kc} UE0={UE0} IE0={IE0} Pel={Pel} Schenkelpolfaktor={Schenkelpolfaktor} Daempferfaktor={Daempferfaktor} Streuung={Streuung} rcu={rcu} rbg={rbg} n0={n0} a={a} m={m} err0={err0} RE_factor={RE_factor}; <--------- MATLAB compatible 
XU3 GND1 0 SW_1Phase_off_1a t_Stop={t_stop_gnd2} t_Start={t_start_gnd2} tsw=100u ron=0.01 roff=1e9
***************
* Transformer (geänderte Parameter,SN,U1Nenn,U20)
***************
XU8 1u1 1v1 1w1 NC_01 u2 v2 w2 NC_02 RUYy6_110k_20k_400MVA_1a SN=90e6 U1Nenn=110k U20=10.3k l_=0 stproz=1 middle=0 psi_0=0 tpsi0=1000 tpsid=0.1m ron=0.00001
***************
* Sync-Schalter
***************
XU10 1u1 1v1 1w1 1u2 1v2 1w2 SW_3Phase_1a t_Start={t_sync} t_Stop={t_sync_off} tsw=100u ron=0.01 roff=1e9
********************
* Drehzahlregler PI
********************
XU2 n nsoll M2 en2 PI_1a Kp={n_kp} Tn={n_Tn} Min=0 Max=0.6e6 init=2k
ven2 en2 0 pwl 0s 1 {t_stop_nreg} 1 {t_stop_nreg+100m} 0 {t_Start_nreg} 0 {t_Start_nreg+100m} 1
vpwl  nsoll 0 pwl 0s {nsoll} 3s {nsoll}
venV enV 0 pwl 0s 0v {t_enablev_avr} 0v {t_enablev_avr+100m} 1
vsoll vsoll 0 pwl 0s {vsoll}
XU20 verr verr2 SW_1Phase_1a t_Start={t_start_avr} t_Stop={t_stop_avr} tsw=100u ron=0.01m roff=1e9
* fixe Erregung von aussen (Schalter und pwl-source)
XU21 verr verr1 SW_1Phase_off_1a t_Stop={t_stop_fixerr} t_Start={t_start_fixerr} tsw=100u ron=0.01m roff=1e9
* Zu Drehzahlregler
XU12 M M2 SW_1Phase_off_1a t_Stop={t_stop_nreg} t_Start={t_start_nreg} tsw=100u ron=0.01 roff=1e9
* Fixes Drehmoment von aussen (Schalter und pwl-Source)
XU6 M M1 SW_1Phase_1a t_Start={t_start_fixm} t_Stop={t_stop_fixm} tsw=100u ron=0.01 roff=1e9
*******
* AVR
*******
XU19 u2 v2 w2 vsoll verr2 en1 enV avr_1a Kp={f1_kp} Tn={f1_Tn} Min=200 Max=1500 U1Nenn={UN_verkettet} tripdt2=100n verr0=600v vfactor=sqrt(3)
ven1 en1 0 pwl 0s 0v {t_enable_avr} 0v {t_enable_avr+100m} 1
venV enV 0 pwl 0s 0v {t_enablev_avr} 0v {t_enablev_avr+100m} 1
vsoll vsoll 0 pwl 0s {vsoll}
XU20 verr verr2 SW_1Phase_1a t_Start={t_start_avr} t_Stop={t_stop_avr} tsw=100u ron=0.01m roff=1e9
* fixe Erregung von aussen (Schalter und pwl-source)
XU21 verr verr1 SW_1Phase_off_1a t_Stop={t_stop_fixerr} t_Start={t_start_fixerr} tsw=100u ron=0.01m roff=1e9
.ENDS

