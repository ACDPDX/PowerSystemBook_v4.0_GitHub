.SUBCKT Trafo3Yy0_ideal_ctrl  1U  1V  1W  1N  2U  2V  2W  2N ctrl
+	PARAMS:
+	U1Nenn=400V
+	U20=400V
+   k=1
.param N1={N1} N2={N1*U20/U1Nenn}
Rctrl ctrl 0 1e12
* YY0
Xu 1U 1N 2U 2N ctrl N1N2_ctrl_YY2 params: N1={N1} N2={N2} k={k}
Xv 1V 1N 2V 2N ctrl N1N2_ctrl_YY2 params: N1={N1} N2={N2} k={k}
Xw 1W 1N 2W 2N ctrl N1N2_ctrl_YY2 params: N1={N1} N2={N2} k={k}
* YY6
*Xu 1U 1N 2N 2U ctrl N1N2_ctrl_YY2 params: N1={N1} N2={N2} k={k}
*Xv 1V 1N 2N 2V ctrl N1N2_ctrl_YY2 params: N1={N1} N2={N2} k={k}
*Xw 1W 1N 2N 2W ctrl N1N2_ctrl_YY2 params: N1={N1} N2={N2} k={k}
RGND1U 1U 0 1e12
RGND1V 1V 0 1e12
RGND1W 1W 0 1e12
RGND2U 2U 0 1e12
RGND2V 2V 0 1e12
RGND2W 2W 0 1e12
RGND1N 1N 0 1e12
RGND2N 2N 0 1e12
.ENDS

