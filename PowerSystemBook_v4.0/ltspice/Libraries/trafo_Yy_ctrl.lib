* My special thank to Emer. Prof. Dr. Otto Justus who
* allowed me to use his models of transformer and synchronous generator

.SUBCKT Trafo3Yy0_ctrl  1U  1V  1W  1N  2U  2V  2W  2N ctrl
+	PARAMS:
+	SN=10kVA
+	U1Nenn=400V
+	U20=400V
+	fn={fn1}
+	N1=1000
+	uR=0.04
+	uX=0.08
+	i0=0.05
+	p0=0.005
+   a=0.75
+   m=9
+   psi_0=0 ;
+   psir=1
+   psis=-0.5
+   psit=-0.5
+   tpsi0=1000s
+   tpsid=0.1ms
+   ron=0.00001
+   bf=0    ;
+   rkessel=6e5  ;magn. resistance of the kettle filled with oil / reduce it for an effect (e.g. 1e6)
Rctrl ctrl 0 1e12
Xu	1U	1N	2U	2N	magn1	magn2 ctrl	Trafoschenkel2_ctrl_Yy2
+ PARAMS:
+ SN={SN/3}
+ U1N={U1Nenn/sqrt(3)}
+ U20={U20/sqrt(3)}
+ fN={fN}
+ N1={N1}
+ uR={uR}
+ uX={uX}
+ i0={i0*IF(bf==0,1,1.2)}
+ p0={p0*IF(bf==0,1,1.2)}
+ a={a}
+ m={m}
+ psi_0={psir*psi_0}
+ tpsi0={tpsi0}
+ tpsid={tpsid}
+ ron={ron}
Xv	1V	1N	2V	2N	magn1	magn2 ctrl	Trafoschenkel2_ctrl_Yy2
+ PARAMS:
+ SN={SN/3}
+ U1N={U1Nenn/sqrt(3)}
+ U20={U20/sqrt(3)}
+ fN={fN}
+ N1={N1}
+ uR={uR}
+ uX={uX}
+ i0={i0*IF(bf==0,1,0.6)}
+ p0={p0*IF(bf==0,1,0.6)}
+ a={a}
+ m={m}
+ psi_0={psis*psi_0}
+ tpsi0={tpsi0}
+ tpsid={tpsid}
+ ron={ron}
Xw	1W	1N	2W	2N	magn1	magn2	ctrl Trafoschenkel2_ctrl_Yy2
+ PARAMS:
+ SN={SN/3}
+ U1N={U1Nenn/sqrt(3)}
+ U20={U20/sqrt(3)}
+ fN={fN}
+ N1={N1}
+ uR={uR}
+ uX={uX}
+ i0={i0*IF(bf<=0,1,1.2)}
+ p0={p0*IF(bf<=0,1,1.2)}
+ a={a}
+ m={m}
+ psi_0={psit*psi_0}
+ tpsi0={tpsi0}
+ tpsid={tpsid}
+ ron={ron}
*Rm	magn1	0	1MEG
Rkessel magn1 magn2 {rkessel}
RGND1U 1U 0 1e12
RGND1V 1V 0 1e12
RGND1W 1W 0 1e12
RGND2U 2U 0 1e12
RGND2V 2V 0 1e12
RGND2W 2W 0 1e12
RGND1N 1N 0 1e12
RGND2N 2N 0 1e12
.ENDS

