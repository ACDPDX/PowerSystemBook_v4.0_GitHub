Xv	1V	1N	2N	2V  ctrl Trafo_N1N2_simple_ctrl_YY2
+ PARAMS:
+ SN={SN/3}
+ U1N={U1Nenn/sqrt(3)}
+ U20={U20/sqrt(3)}
+ fN={fN}
+ N1={N1}
+ uR={uR}
+ uX={uX}
+ i0={i0*IF(bf==0,1,0.6)}
+ p0={p0*IF(bf==0,1,0.6)}
Xw	1W	1N	2N	2W  ctrl Trafo_N1N2_simple_ctrl_YY2
+ PARAMS:
+ SN={SN/3}
+ U1N={U1Nenn/sqrt(3)}
+ U20={U20/sqrt(3)}
+ fN={fN}
+ N1={N1}
+ uR={uR}
+ uX={uX}
+ i0={i0*IF(bf<=0,1,1.2)}
+ p0={p0*IF(bf<=0,1,1.2)}
RGND1U 1U 0 1e12
RGND1V 1V 0 1e12
RGND1W 1W 0 1e12
RGND2U 2U 0 1e12
RGND2V 2V 0 1e12
RGND2W 2W 0 1e12
RGND1N 1N 0 1e12
RGND2N 2N 0 1e12
.ends

.SUBCKT   Trafoschenkel2_ctrl_Yy2  1_1 1_2  2_1 2_2  magnP1 magnP2 ctrl
+	PARAMS:
+	SN=10kVA
+	U1N=400V
+	U20=400V
+	fn={fn1}
+	N1=1000
+	uR=0.04
+	uX=0.08
+	i0=0.05
+	p0=0.005
+   a={0.3} ; FS
+   m={7} ; FS
+   psi_0=0 ; Remanent parameter between 0,1,-1
+   tpsi0=1000s ; Remanenzzeitpunkt
+   tpsid=0.1ms  ; Dauer des Schalter ein für Remanenz
+   ron=0.00001 ; ron - Parameter des Schalters für Remanenz (siehe sub WICKLUNG_YY2)
.PARAM
+	I1N={SN/U1N}
+	Z1N={U1N/I1N}
+	omegaN={(2*pi)*fN}
+	R1={Z1N*uR/2}
+	L1s={Z1N*uX/2/omegaN}
+	RFe={U1N*U1N/(p0*SN)}
+	N2={N1*U20/U1N}
+	R2={R1*N2/N1*N2/N1}
+   Xh={(U1N*U1N)/(SN*sqrt(i0*i0-p0*p0))} ;FS
+   iu={U1N/Xh} ;FS
+   ImyN={sqrt(2)*iu} ;FS
+	phiN={sqrt(2)*U1N/omegaN/N1}
+   a={a} ; FS
+   m={m} ; FS
* 	Wicklungsstroeme
Gi1	1_1	1_2	VALUE={v(a,magnP1)/(N1*v(ctrl))} tripdv={tdv} tripdt={tdt}
Rpi1	1_1	1_2	1000MEG
Gi2	2_1	2_2	VALUE={v(b,a)/(N2)} tripdv={tdv} tripdt={tdt}
Rpi2	2_1	2_2	1000MEG
*	Wicklungen
X_W1	magnP1	a	1_1	1_2	ctrl WICKLUNG_ctrl_YY2
+PARAMS:  R={R1}  N={N1}  Rphis={N1*N1/L1s} psi_0={psi_0*phiN} tpsi0={tpsi0} tpsid={tpsid} ron={ron}
X_W2	a   b    2_1	2_2	 WICKLUNG_YY2
+PARAMS:  R={R2}  N={N2}  Rphis={N1*N1/L1s} psi_0={psi_0*phiN} tpsi0={tpsi0} tpsid={tpsid} ron={ron}
*	EisenSchenkel
X_SCH	b	magnP2 ctrl SCHENKEL_Yy2   PARAMS:
+	N={N1}  RFe={RFe}  ImyN={ImyN}
+	phiN={phiN}	a={a}   m={m}
.ENDS



.SUBCKT SCHENKEL_Yy2x  m1  m2  ctrl
+PARAMS:   N=1  RFe=1  ImyN=1  a=1  phiN=1 m=9
LRFe	m1	mh	{N*N/RFe} Rser={0.001m*N*N/RFe}  ; Rser=parasitic Value zur besseren Konvergenz
* Rfe bringt ein bischen was aber auch leichte phasenverschiebung !!!
vphi	mh	mh1	0
rphi    mh  0 1e12 
Eimy	mh1	m2
+VALUE={N*imyN*(a*i(vphi)/phiN+(1-a)*PWRS(i(vphi)/phiN,m))} tripdv={tdv} tripdt={tdt}
.ENDS;  SCHENKEL_Yy2
*$


* NEW: changes at Rphis !!!
.SUBCKT WICKLUNG_ctrl_YY2  ma  mb  ea  eb ctrl
+PARAMS:   R=1   N=1    Rphis=1 psi_0=0 tpsi0=20ms tpsid=0.1ms ron=0.00001
Gphi	ma	mb	VALUE={v(phi)} tripdv={tdv} tripdt={tdt}
Gphis	ma	mb	VALUE={v(ma,mb)/(Rphis*v(ctrl)*v(ctrl))} tripdv={tdv} tripdt={tdt}
Gp	0	phi	VALUE={(v(ea,eb)-R*v(ctrl)*v(mb,ma)/(N*v(ctrl)))/(N*v(ctrl))} tripdv={tdv} tripdt={tdt}
Cp phi 0 1 IC=0
Vctrl sctrl 0 pwl 0s 0v {tpsi0+1p} 0v {tpsi0+tpsid+2p} 1V {tpsi0+2*tpsid+3p} 1v {tpsi0+3*tpsid+4p} 0v
S1 phi phix sctrl 0 MS1
.model MS1 SW(Ron={Ron} Roff=1e9 Vt=0.9 Vh=0.0 Lser=0 Vser=0)
E1 phix 0 value={psi_0} tripdv={tdv} tripdt={tdt} ;
Rp	phi	0	1000MEG
.ENDS ;  WICKLUNG_YY2

* NEW: SCHENKEL_Yy with ctrl pin !!!!!
.SUBCKT SCHENKEL_Yy2  m1  m2 ctrl 
+PARAMS:   N=1  RFe=1  ImyN=1  a=1  phiN=1 m=9
LRFe	m1	mh	flux={x*((N*N*v(ctrl)*v(ctrl))/RFe)} Rser={0.001m*N*N/RFe}  ; Rser=parasitic value for better convergence  
* Rfe
vphi	mh	mh1	0
rphi    mh  0 1e12 
Eimy	mh1	m2
+VALUE={N*imyN*(a*i(vphi)/phiN+(1-a)*PWRS(i(vphi)/phiN,m))} tripdv={tdv} tripdt={tdt}
.ENDS;  SCHENKEL_Yy2


.SUBCKT WICKLUNG_YY2  ma  mb  ea  eb
+PARAMS:   R=1   N=1    Rphis=1 psi_0=0 tpsi0=1000s tpsid=0.1ms ron=0.00001 ;passt für 1ms Schaltzeit bei C mit 1Coulomb
Gphi	ma	mb	VALUE={v(phi)} tripdv={tdv} tripdt={tdt}
Rphis	ma	mb	{Rphis}
Gp	0	phi	VALUE={(v(ea,eb)-R*v(mb,ma)/(N))/(N)} tripdv={tdv} tripdt={tdt}
Cp phi 0 1 IC=0
Vctrl ctrl 0 pwl 0s 0v {tpsi0+1p} 0v {tpsi0+tpsid+2p} 1V {tpsi0+2*tpsid+3p} 1v {tpsi0+3*tpsid+4p} 0v
S1 phi phix ctrl 0 MS1
.model MS1 SW(Ron={Ron} Roff=1e9 Vt=0.9 Vh=0.0 Lser=0 Vser=0)
E1 phix 0 value={psi_0} tripdv={tdv} tripdt={tdt} ; das ist die Spannungsquelle mit psi_0 der den Kondensator Cp auflädt !!!
Rp	phi	0	1000MEG
.ENDS ;  WICKLUNG_YY2

.subckt Trafo_N1N2_simple_ctrl_YY2 p1  p2  s3  s4  ctrl
+	PARAMS:
+	SN=1kVA
+	U1N=230V
+	U20=230V
+	fn={fn1}
+	N1=1000
+	uR=0.04
+	uX=0.08
+	i0=0.05
+	p0=0.005
.PARAM
+	I1N={SN/U1N}
+	Z1N={U1N/I1N}
+	omegaN={(2*pi)*fN}
+	R1={Z1N*uR/2}
+	L1s={Z1N*uX/2/omegaN}
+	RFe={U1N*U1N/(p0*SN)}
+	N2={N1*U20/U1N}
+	R2={R1*N2/N1*N2/N1}
+   Xh={(U1N*U1N)/(SN*sqrt(i0*i0-p0*p0))} ;FS
+   iu={U1N/Xh} ;FS
+   ImyN={sqrt(2)*iu} ;FS
+	phiN={sqrt(2)*U1N/omegaN/N1}
Rcup  p1 x1 {R1}
L1p    x1 p11 {L1s} rser=0
Rfe1   p11 p2 {RFe}
*LXh    p11 p2 {Xh/omegaN} rser=0
*LXh p11 p2 flux={Xh/omegaN*x*sqrt(v(ctrl))} rser=0
LXh p11 p2 flux={Xh/omegaN*x*v(ctrl)*v(ctrl)} rser=0
Rcus   s33  x2 {R2}
L1s   x2 s3 {L1s*N2/N1*N2/N1} rser=0
X_w1	p11 p2  s33  s4  ctrl  N1N2_ctrl_YY2 params: N1={N1} N2={N2}
.ends


* ctrl node in verhältniseinheit
* UE/UEN=1+stproz/100 (0.9 .. 1 .. 1.2)
.subckt N1N2_ctrl_YY2 in1 in2 out1 out2 ctrl
+params: k=1 N1=1 N2=1
.param ue={N1/N2}
G1 0 M in1 in2 1
G2 0 M VALUE={-k*((v(out1)-v(out2))*ue*v(ctrl))} tripdv={tdv} tripdt={tdt}
G3 in1 in2 M 0 1
G4 out1 out2 VALUE={-k*((v(m))*ue*v(ctrl))} tripdv={tdv} tripdt={tdt}
Rl l 0 1e12
R2 M 0 1e10
Rin1 in1 0 1e12
Rin2 in2 0 1e12
Rout1 out1 0 1e12
Rout2 out2 0 1e12
.ends


