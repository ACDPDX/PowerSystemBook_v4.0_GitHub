ven2 en2 0 pwl 0s 1 {t_stop_nreg} 1 {t_stop_nreg+100m} 0 {t_Start_nreg} 0 {t_Start_nreg+100m} 1
vpwl  nsoll 0 pwl 0s {nsoll} 3s {nsoll}
* Zu Drehzahlregler
XU12 M M2 SW_1Phase_off_3a t_Stop={t_stop_nreg} t_Start={t_start_nreg} tsw=100u ron=0.01 roff=1e9
* Fixes Drehmoment von aussen (Schalter und pwl-Source)
XU6 M M1 SW_1Phase_3a t_Start={t_start_fixm} t_Stop={t_stop_fixm} tsw=100u ron=0.01 roff=1e9
*******
* AVR
*******
XU19 u2 v2 w2 vsoll verr2 en1 enV AVR2_3a Kp={f1_kp} Tn={f1_Tn} Min=200 Max=1500 U1Nenn={UN_verkettet} tripdt2=100n  verr0={UE0} vfactor=1.73205
ven1 en1 0 pwl 0s 0v {t_enable_avr} 0v {t_enable_avr+100m} 1  
venV enV 0 pwl 0s 0v {t_enablev_avr} 0v {t_enablev_avr+100m} 1
vsoll vsoll 0 pwl 0s {vsoll}
XU20 verr verr2 SW_1Phase_off_3a t_Start={t_start_avr} t_Stop={t_stop_avr} tsw=100u ron=0.01m roff=1e9
* fixe Erregung von aussen (Schalter und pwl-source)
XU21 verr verr1 SW_1Phase_3a t_Stop={t_stop_fixerr} t_Start={t_start_fixerr} tsw=100u ron=0.01m roff=1e9
.ENDS


* avr on
* speed controller on
*


.SUBCKT GEN_150MW_10kV_110kV_mit_Trafo_auto 1U2 1V2 1W2 Verr1 M1 n GND1
+ PARAMS: Schenkelpolfaktor=1 Daempferfaktor=1 Streuung=0.05 rcu=0.01 rbg=0.001 n0=1500 err0=0  p=2 a=0.9 m=11 kc=0.5
+ nsoll=1500 vsoll=10300 n_kp=200000 n_Tn=0.05 f1_kp=0.01 f1_Tn=0.1 
+ t_start_avr=1e6 t_stop_avr=1e5 t_start_fixerr=1e5 t_stop_fixerr=1e6 t_stop_nreg=1e5 t_start_nreg=1e6 t_start_fixm=1e5 t_stop_fixm=1e6
+ t_sync=2000ms t_sync_off=1e6 t_enable_avr=2.5s  t_enablev_avr=2s t_start_gnd2=10e6 t_stop_gnd2=1e6
.param cosphi=0.8
.param J=100000 UN_verkettet=10300 IN={8.7k/cosphi} UE0=600V IE0=1000A Pel=150e6 
*************
* Generator *
*************
RM1  M1  0  1e10
XU1 u2 v2 w2 verr M n GND1 Block1 J={J} UN_verkettet={UN_verkettet} IN={IN} Kc={Kc} UE0={UE0} IE0={IE0} Pel={Pel} Schenkelpolfaktor={Schenkelpolfaktor} Daempferfaktor={Daempferfaktor} Streuung={Streuung} rcu={rcu} rbg={rbg} n0={n0} err0={err0} a={a} m={m}
XU3 GND1 0 SW_1Phase_off_3a t_Stop={t_stop_gnd2} t_Start={t_start_gnd2} tsw=100u ron=0.01 roff=1e9
***************
* Transformer (geänderte Parameter,SN,U1Nenn,U20)
***************
XU8 1u1 1v1 1w1 NC_01 u2 v2 w2 NC_02 RUYy6_110k_20k_400MVA_3a SN=190e6 U1Nenn=110k U20=10.3k l_=0 stproz=1 middle=0 psi_0=0 tpsi0=1000 tpsid=0.1m ron=0.00001
***************
* Sync-Schalter
***************
XU10 1u1 1v1 1w1 1u2 1v2 1w2 SW_3Phase_3a t_Start={t_sync} t_Stop={t_sync_off} tsw=100u ron=0.01 roff=1e9
********************
* Drehzahlregler PI
********************
XU2 n nsoll M2 en2 PI_3a Kp={n_kp} Tn={n_Tn} Min=0 Max=1.2e6 init=2k
ven2 en2 0 pwl 0s 1 {t_stop_nreg} 1 {t_stop_nreg+100m} 0 {t_Start_nreg} 0 {t_Start_nreg+100m} 1
vpwl  nsoll 0 pwl 0s {nsoll} 3s {nsoll}
* Zu Drehzahlregler
XU12 M M2 SW_1Phase_off_3a t_Stop={t_stop_nreg} t_Start={t_start_nreg} tsw=100u ron=0.01 roff=1e9
* Fixes Drehmoment von aussen (Schalter und pwl-Source)
XU6 M M1 SW_1Phase_3a t_Start={t_start_fixm} t_Stop={t_stop_fixm} tsw=100u ron=0.01 roff=1e9
*******
* AVR
*******
XU19 u2 v2 w2 vsoll verr2 en1 enV AVR2_3a Kp={f1_kp} Tn={f1_Tn} Min=200 Max=1500 U1Nenn={UN_verkettet} tripdt2=100n  verr0={UE0} vfactor=1.73205
ven1 en1 0 pwl 0s 0v {t_enable_avr} 0v {t_enable_avr+100m} 1  
venV enV 0 pwl 0s 0v {t_enablev_avr} 0v {t_enablev_avr+100m} 1
vsoll vsoll 0 pwl 0s {vsoll}
XU20 verr verr2 SW_1Phase_off_3a t_Start={t_start_avr} t_Stop={t_stop_avr} tsw=100u ron=0.01m roff=1e9
* fixe Erregung von aussen (Schalter und pwl-source)
XU21 verr verr1 SW_1Phase_3a t_Stop={t_stop_fixerr} t_Start={t_start_fixerr} tsw=100u ron=0.01m roff=1e9
.ENDS



