XU3 GND1 0 SW_1Phase_off_3a t_Stop={t_stop_gnd2} t_Start={t_start_gnd2} tsw=100u ron=0.01 roff=1e9
***************
* Transformer
***************
XU8 1u1 1v1 1w1 NC_01 u2 v2 w2 NC_02 RUYy6_110k_20k_400MVA_3a SN=500e6 l_=0 stproz=1 middle=0 psi_0=0 tpsi0=1000 tpsid=0.1m ron=0.00001
***************
