xbreakerC in3 out3 breaker_1ph_1150kV_off params: Rs={rs} cs={cs} vin={vin} exp={exp} td1={td1} ioff={ioff} ioff0={ioff0} cbrk={cbrk}
+ ron={ron} roff={roff} t_Start={t_Start} t_Stop={t_Stop} tsw={tsw} toff={toff}  
.ends

.subckt breaker_3ph_1150kV_ctrl in1 in2 in3 out1 out2 out3 gate params: Rs=20k vin=1150kV cs=50p exp=9 
+ td1=1n ioff=5 ioff0=100 cbrk=0.1n toff=1n
+ ron=0.01
+ roff=1e9
xbreakerA in1 out1 gate breaker_1ph_1150kV_ctrl params: Rs={rs} cs={cs} vin={vin} exp={exp} td1={td1} ioff={ioff} ioff0={ioff0} cbrk={cbrk}
+ ron={ron} roff={roff}   
xbreakerB in2 out2 gate breaker_1ph_1150kV_ctrl params: Rs={rs} cs={cs} vin={vin} exp={exp} td1={td1} ioff={ioff} ioff0={ioff0} cbrk={cbrk}
+ ron={ron} roff={roff}  
xbreakerC in3 out3 gate breaker_1ph_1150kV_ctrl params: Rs={rs} cs={cs} vin={vin} exp={exp} td1={td1} ioff={ioff} ioff0={ioff0} cbrk={cbrk}
+ ron={ron} roff={roff}   
.ends

.subckt sw gate1 ctrl in out params: td1=0 ioff0=20 ioff=500m ron=0.01 roff=1e9 toff=1n
V1 in in2 0
xsw1 in2 out gate Sw_1Phase_ctrl params: ron={ron} roff={roff} toff={toff}
A1 gate1 0 0 0 0 N002 N001 0 BUF
A2 N002 N002 N002 tst1 tst1 gate 0 0 AND
A3 gate2 gate2 gate2 N004 N004 ctrl N003 0 AND
A4 gate 0 0 0 0 0 gate2 0 BUF td={td1}
A5 gate1 0 0 0 0 N005 0 0 BUF
A6 tst2 tst2 N005 N005 N005 0 N004 0 AND
Etst1 tst1 0 value={IF(abs(I(v1))<IOFF,1,0)} tripdv=1 tripdt=1
Etst2 tst2 0 value={IF(abs(I(v1))<IOFF0,1,0)} tripdv=1 tripdt=1
.ends

* ctrl=0V -> go   ctrl=1V -> stop
.subckt brkp_ctrl ctrl params: C1=0.1n trise=1n tfall=1n Td=1n ic=0
A1 N001 0 0 0 0 N002 0 0 BUF Vhigh=1V Vlow=0V trise={trise} tfall={tfall} Td={td}
A2 N002 0 0 0 0 N003 0 0 BUF Vhigh=1V Vlow=0V trise={trise} tfall={tfall} Td={td} 
C1 N003 N004 {C1} IC={ic}
R1 N002 N004 100k
R2 N001 N004 10k
X§U2 N004 0 ctrl SW_1Phase_ctrl ron=0.01 roff=1e9 tsw=1n toff=1n
.ends

* mov ciruitry to prevent voltage spike 
.subckt mov0 1 2 ; base generic
+PARAMS: VBO=10 Vr=0.71 exp=9
.param Vratio={VBO/Vr} 
B1 1 2 I=if(V(1, 2)-0.5, (V(1, 2) / Vratio) ** exp, (1 / Vratio) ** exp) tripdv={tdv} tripdt={tdt}
B2 2 1 I=if(V(2, 1)-0.5, (V(2, 1) / Vratio) ** exp, (1 / Vratio) ** exp) tripdv={tdv} tripdt={tdt}
.ends

.SUBCKT Thyri_Lite_1ph_Switcher in out PARAMS:tsw=100u t_start=0.1s t_stop=10s ron=1e-3 roff=1e9 von=1 voff=0.1 rs=20k cs=500p
Vpwl1 a out pwl 0s 0 {t_start} 0 {t_start+tsw} 1 {t_stop} 1 {t_stop+tsw} 0 
Vpwl2 a1 in pwl 0s 0 {t_start} 0 {t_start+tsw} 1 {t_stop} 1 {t_stop+tsw} 0 
Xsw1 in a out Thyri_Lite2a PARAMS: tsw={tsw} Ron={Ron} Roff={Roff} Von={Von} Voff={Voff}
Xsw2 out a1 in Thyri_Lite2a PARAMS: tsw={tsw} Ron={Ron} Roff={Roff} Von={Von} Voff={Voff}
Rs in x {Rs}
Cs x out {Cs} 
.ENDS

.SUBCKT Thyri_Lite_3ph_Switcher in1 in2 in3 out1 out2 out3 PARAMS:tsw=100u t_start=0.1s t_stop=10s ron=1e-3 roff=1e9 von=1 voff=0.1 rs=20k cs=500p
Xsw1 in1 out1 Thyri_Lite_1ph_Switcher tsw={tsw} t_start={t_start} t_stop={t_stop} ron={ron} roff={roff} von={von} voff={voff} rs={rs} cs={cs}
Xsw2 in2 out2 Thyri_Lite_1ph_Switcher tsw={tsw} t_start={t_start} t_stop={t_stop} ron={ron} roff={roff} von={von} voff={voff} rs={rs} cs={cs}
Xsw3 in3 out3 Thyri_Lite_1ph_Switcher tsw={tsw} t_start={t_start} t_stop={t_stop} ron={ron} roff={roff} von={von} voff={voff} rs={rs} cs={cs}
.ENDS

.SUBCKT Thyri_Lite_1ph_Switcher_off in out PARAMS:tsw=100u t_start=0.1s t_stop=10s ron=1e-3 roff=1e9 von=1 voff=0.1 rs=20k cs=500p
Vpwl1 a out pwl 0s 1 {t_stop} 1 {t_stop+tsw} 0 {t_start} 0 {t_start+tsw} 1 
Vpwl2 a1 in pwl 0s 1 {t_stop} 1 {t_stop+tsw} 0 {t_start} 0 {t_start+tsw} 1 
Xsw1 in a out Thyri_Lite2a PARAMS: tsw={tsw} Ron={Ron} Roff={Roff} Von={Von} Voff={Voff}
Xsw2 out a1 in Thyri_Lite2a PARAMS: tsw={tsw} Ron={Ron} Roff={Roff} Von={Von} Voff={Voff}
Rs in x {Rs}
Cs x out {Cs} 
.ENDS

.SUBCKT Thyri_Lite_3ph_Switcher_off in1 in2 in3 out1 out2 out3 PARAMS:tsw=100u t_start=1s t_stop=0.1s ron=1e-3 roff=1e9 von=1 voff=0.1 rs=20k cs=500p
Xsw1 in1 out1 Thyri_Lite_1ph_Switcher_off tsw={tsw} t_start={t_start} t_stop={t_stop} ron={ron} roff={roff} von={von} voff={voff} rs={rs} cs={cs}
Xsw2 in2 out2 Thyri_Lite_1ph_Switcher_off tsw={tsw} t_start={t_start} t_stop={t_stop} ron={ron} roff={roff} von={von} voff={voff} rs={rs} cs={cs}
Xsw3 in3 out3 Thyri_Lite_1ph_Switcher_off tsw={tsw} t_start={t_start} t_stop={t_stop} ron={ron} roff={roff} von={von} voff={voff} rs={rs} cs={cs}
.ENDS

.SUBCKT Thyri_Lite_3ph_Switcher_ctrl in1 in2 in3 out1 out2 out3 ctrl PARAMS:tsw=100u ron=1e-3 roff=1e9 von=1 voff=0.1 rs=20k cs=500p
Xsw1 in1 out1 ctrl Thyri_Lite_1ph_Switcher_ctrl tsw={tsw} ron={ron} roff={roff} von={von} voff={voff} rs={rs} cs={cs} 
Xsw2 in2 out2 ctrl Thyri_Lite_1ph_Switcher_ctrl tsw={tsw} ron={ron} roff={roff} von={von} voff={voff} rs={rs} cs={cs}
Xsw3 in3 out3 ctrl Thyri_Lite_1ph_Switcher_ctrl tsw={tsw} ron={ron} roff={roff} von={von} voff={voff} rs={rs} cs={cs}
.ENDS

.SUBCKT Thyri_Lite_1ph_Switcher_ctrl in out ctrl PARAMS:tsw=100u ron=1e-3 roff=1e9 von=1 voff=0.1 rs=20k cs=500p
Ectrl1 a out VALUE=V(ctrl) tripdv={tdv} tripdt={tdt}
Ectrl2 a2 in VALUE=V(ctrl) tripdv={tdv} tripdt={tdt}
Xsw1 in a out Thyri_Lite2a PARAMS: tsw={tsw} Ron={Ron} Roff={Roff} Von={Von} Voff={Voff}
Xsw2 out a2 in Thyri_Lite2a PARAMS: tsw={tsw} Ron={Ron} Roff={Roff} Von={Von} Voff={Voff}
Rs in x {Rs}
Cs x out {Cs}
.ENDS

.SUBCKT Thyri_Lite2a Anode Gate Kathode PARAMS: tsw=100u ron=1e-1 roff=1e6 von=1 voff=0.1
.MODEL Schliesser	VSWITCH Ron={Ron} Roff={Roff} Von={Von} Voff={Voff}
Sch	Anode	GA	St	0	Schliesser
Rgate	Gate	Kathode	1
ViK	GA	Kathode	0V
Csch	Anode	Kathode	50p	
Gst	0	st	TABLE {(i(ViK)+v(Gate,Kathode)/20)} = (0,0) (0.05,1)
Rst	st	0	1
Cst	st	0	{tsw/5}	IC=0
.ENDS
