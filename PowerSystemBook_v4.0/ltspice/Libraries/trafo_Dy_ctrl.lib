+   tpsid=0.1ms  ; Dauer des Schalter ein für Remanenz
+   ron=0.00001 ; ron - Parameter des Schalters für Remanenz (siehe sub WICKLUNG_Dy)
+   bf=0
+   rkessel=6e5
Rctrl ctrl 0 1e12
Xu	1U	1V	2U	2N	magn1	magn2 ctrl Trafoschenkel2_ctrl_Dy
+ PARAMS:
+ SN={SN/3}
+ U1N={U1Nenn}
+ U20={U20/sqrt(3)}
+ fN={fN}
+ N1={N1}
+ uR={uR}
+ uX={uX}
+ i0={i0*IF(bf==0,1,1.2)}
+ p0={p0*IF(bf==0,1,1.2)}
+ a={a}
+ m={m}
+ psi_0={psir*psi_0}
+ tpsi0={tpsi0}
+ tpsid={tpsid}
+ ron={ron}
Xv	1V	1W	2V	2N	magn1	magn2 ctrl Trafoschenkel2_ctrl_Dy
+ PARAMS:
+ SN={SN/3}
+ U1N={U1Nenn}
+ U20={U20/sqrt(3)}
+ fN={fN}
+ N1={N1}
+ uR={uR}
+ uX={uX}
+ i0={i0*IF(bf==0,1,0.6)}
+ p0={p0*IF(bf==0,1,0.6)}
+ a={a}
+ m={m}
+ psi_0={psis*psi_0}
+ tpsi0={tpsi0}
+ tpsid={tpsid}
+ ron={ron}
Xw	1W	1U	2W	2N	magn1	magn2 ctrl Trafoschenkel2_ctrl_Dy
+ PARAMS:
+ SN={SN/3}
+ U1N={U1Nenn}
+ U20={U20/sqrt(3)}
+ fN={fN}
+ N1={N1}
+ uR={uR}
+ uX={uX}
+ i0={i0*IF(bf<=0,1,1.2)}
+ p0={p0*IF(bf<=0,1,1.2)}
+ a={a}
+ m={m}
+ psi_0={psit*psi_0}
+ tpsi0={tpsi0}
+ tpsid={tpsid}
+ ron={ron}
*Rm	magn1	0	1MEG
Rkessel magn1 magn2 {rkessel}
RGND1U 1U 0 1e12
RGND1V 1V 0 1e12
RGND1W 1W 0 1e12
RGND2U 2U 0 1e12
RGND2V 2V 0 1e12
RGND2W 2W 0 1e12
RGND2N 2N 0 1e12
.ENDS

