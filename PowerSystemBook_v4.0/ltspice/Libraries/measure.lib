*********************************************************
* Some meatering code is obtained from ©Vlad
* http://ltspicegoodies.ltwiki.org/index.html
* other RMS-measuring code from Prof. Robert Heinemann www.spicelab.de
* Book: PSPICE: Einführung in die Elektroniksimulation
*********************************************************




*NOTE: The accuracy of the meters is about 0.5%
*For smoother measurement set fc=0.5

* bus element with measures of rms of voltages (one per phase)
.SUBCKT bus_Veff vin1 vin2 vin3 v1 v2 v3
+ params: fc=3 tenable=1us tdv=1 tdt=1 rgnd=1e12 vfactor=sqrt(3)
*
Rg1 VIN1 0 {Rgnd}
Rg2 VIN2 0 {Rgnd}
Rg3 VIN3 0 {Rgnd}
*
Xv1 vin1 v1 vmeter_RMS1a
+params: fc={fc} tdv={tdv} tenable={tenable} tdt={tdt} vfactor={vfactor}
Xv2 vin2 v2 vmeter_RMS1a
+params: fc={fc} tdv={tdv} tenable={tenable} tdt={tdt} vfactor={vfactor}
Xv3 vin3 v3 vmeter_RMS1a
+params: fc={fc} tdv={tdv} tenable={tenable} tdt={tdt} vfactor={vfactor}
.ENDS

.SUBCKT bus_V0_AC vin1 vin2 vin3 v1 v2 v3
+ params: tdv=1 tdt=1 rgnd=1e12 vfactor=1
Rg1 VIN1 0 {Rgnd}
Rg2 VIN2 0 {Rgnd}
Rg3 VIN3 0 {Rgnd}
Rvm1 v1 0 {Rgnd}
Rvm2 v2 0 {Rgnd}
Rvm3 v3 0 {Rgnd}
bv1 V1 0 v=vfactor*v(VIN1) tripdv={tdv} tripdt={tdt}
bv2 V2 0 v=vfactor*v(VIN2) tripdv={tdv} tripdt={tdt}
bv3 V3 0 v=vfactor*v(VIN3) tripdv={tdv} tripdt={tdt}
* Measurements
bVL1 L1 0 v=v(v1) tripdv={tdv} tripdt={tdt}
bVL2 L2 0 v=v(v2) tripdv={tdv} tripdt={tdt}
bVL3 L3 0 v=v(v3) tripdv={tdv} tripdt={tdt}
.ENDS

* bus element with measures of rms of voltages (one per phase)
.SUBCKT bus_1phase_Veff vin1 v1
+ params: fc=3 tdv=1 tdt=1 vfactor=sqrt(3)
Rser vin1 vin2 1u
Xv1 vin2 0 v1 vmeter_RMS_d
+ params: fc={fc} tenable=1us tdv={tdv} tdt={tdt} vfactor={vfactor}
.ENDS

* Meas of RMS value (mean value of all three phases VRMS*1.73205)
.SUBCKT bus_Veff_1 L1 L2 L3 out
+PARAMS: tripdv={tdv} tripdt={tdt} rgnd=1e12 factor=1 tenable=1u
* Measurement with MINMAX
E1 L1a 0 Value={IF(time>tenable,v(L1),0)} tripdv={tdv} tripdt={tdt}
E2 L2a 0 Value={IF(time>tenable,v(L2),0)} tripdv={tdv} tripdt={tdt}
E3 L3a 0 Value={IF(time>tenable,v(L3),0)} tripdv={tdv} tripdt={tdt}
RL1 L1 0 1e12
RL2 L2 0 1e12
RL3 L3 0 1e12
Rout out 0 {Rgnd}
Ep out_p1 0 VALUE={MAX(V(L1a),MAX(V(L2a),V(L3a)))} tripdv={tdv} tripdt={tdt}
En out_n 0 VALUE={MIN(V(L1a),MIN(V(L2a),V(L3a)))} tripdv={tdv} tripdt={tdt}
R1 out_p1 out_p 10
C1 out_p out_n 4700µ
R2 out_p out_n 28.55
Eout out 0 VALUE={factor*v(out_p,out_n)} tripdv={tdv} tripdt={tdt}
.ENDS

* bus elements with measures of rms of voltges u-v v-w w-u
.SUBCKT bus_Veff_uv_vw_wu vin1 vin2 vin3 v1 v2 v3
+ params: fc=3 tdv=1 tdt=1 vfactor=1 rgnd=1e12
*
Rg1 VIN1 0 {Rgnd}
Rg2 VIN2 0 {Rgnd}
Rg3 VIN3 0 {Rgnd}
*
Buv 0 uv i=v(vin1,vin2) tripdv={tdv} tripdt={tdv} rpar=1
Bvw 0 vw i=v(vin2,vin3) tripdv={tdv} tripdt={tdv} rpar=1
Bwu 0 wu i=v(vin3,vin1) tripdv={tdv} tripdt={tdv} rpar=1
*
Xv1 uv v1 vmeter_RMS1
+params:  fc={fc} tdv={tdv} tdt={tdt} vfactor={vfactor}
Xv2 vw v2 vmeter_RMS1
+params:  fc={fc} tdv={tdv} tdt={tdt} vfactor={vfactor}
Xv3 wu v3 vmeter_RMS1
+params:  fc={fc} tdv={tdv} tdt={tdt} vfactor={vfactor}
.ENDS

* bus elements with measures of rms of voltages ph-ph, ph-0, phaseangle all of phase1
.SUBCKT bus_Veff_phase vin1 vin2 vin3 v1 v2 ph
+ params: fc=3 fn=50 tenable=1us tdv=1 tdt=1 vfactor=sqrt(3) rgnd=1e12
*
Rg1 VIN1 0 {Rgnd}
Rg2 VIN2 0 {Rgnd}
Rg3 VIN3 0 {Rgnd}
*
Xv1 vin1 v1 vmeter_RMS1a
+params: fc={fc} tenable={tenable} vfactor={vfactor} tdv={tdv} tdt={tdt}
Xv2 vin1 v2 vmeter_RMS1a
+params: fc={fc} tenable={tenable} vfactor=1 tdv={tdv} tdt={tdt}
Xph vin1 ph PhaseDet
+params: fn={fn} deg=1 Rpar=1G tdv={tdv} tdt={tdt}
.ENDS

* 1 phase RMS voltage meter
.subckt vmeter_RMS1 vin V
+ params: fc=3 vfactor=1.73205 tdv=1 tdt=1 rgnd=1e12
XU4 vin V1 RMS fc={fc} b0=1 b1=3
Eout V 0 VALUE={vfactor*v(v1)} tripdv={tdv} tripdt={tdt}
Rgnd V 0 {rgnd}
.ends

* 1 phase RMS voltage meter
* tenable because sometimes the first timesteps
* in the simulation makes large spikes
* e.g. set err0=1 in the generator models
* default=1us
.subckt vmeter_RMS1a vin V
+ params: fc=3 vfactor=1.73205 tdv=1 tdt=1 tenable=1u rgnd=1e12
Eenable vin2 0 VALUE={IF(time>tenable,v(vin),0)} tripdv={tdv} tripdt={tdt}
XU4 vin2 V1 RMS fc={fc} b0=1 b1=3
Eout V 0 VALUE={vfactor*v(v1)} tripdv={tdv} tripdt={tdt}
Rv v 0 {Rgnd}
.ends

* bus elements with measures of phaseangle for all three phases
.SUBCKT bus_phase_all vin1 vin2 vin3 ph1 ph2 ph3
+ params: fn=50 rgnd=1e12 tdv=1 tdt=1
*
Rg1 VIN1 0 {Rgnd}
Rg2 VIN2 0 {Rgnd}
Rg3 VIN3 0 {Rgnd}
*
Xph1 vin1 ph1 PhaseDet
+params: fn={fn} deg=1 Rpar=1G tdv={tdv} tdt={tdt}
Xph2 vin2 ph2 PhaseDet
+params: fn={fn} deg=1 Rpar=1G tdv={tdv} tdt={tdt}
Xph3 vin3 ph3 PhaseDet
+params: fn={fn} deg=1 Rpar=1G tdv={tdv} tdt={tdt}
.ENDS


* bus element with measurement of instantaneous value with multiplicator
*
.SUBCKT bus_V IN1 IN2 IN3 Vm1 Vm2 Vm3
+params: rgnd=1e12 vfactor={1.732/sqrt(2)} tdv=1 tdt=1
Rg1 IN1 0 {Rgnd}
Rg2 IN2 0 {Rgnd}
Rg3 IN3 0 {Rgnd}
Rvm1 vm1 0 {Rgnd}
Rvm2 vm2 0 {Rgnd}
Rvm3 vm3 0 {Rgnd}
bv1 Vm1 0 v=vfactor*v(IN1) tripdv={tdv} tripdt={tdt}
bv2 Vm2 0 v=vfactor*v(IN2) tripdv={tdv} tripdt={tdt}
bv3 Vm3 0 v=vfactor*v(IN3) tripdv={tdv} tripdt={tdt}
.ENDS

.SUBCKT bus_V_AC IN1 IN2 IN3 Vm1 Vm2 Vm3
+params: rgnd=1e12 vfactor={1.732} tdv=1 tdt=1
Rg1 IN1 0 {Rgnd}
Rg2 IN2 0 {Rgnd}
Rg3 IN3 0 {Rgnd}
Rvm1 vm1 0 {Rgnd}
Rvm2 vm2 0 {Rgnd}
Rvm3 vm3 0 {Rgnd}
bv1 Vm1 0 v=vfactor*v(IN1) tripdv={tdv} tripdt={tdt}
bv2 Vm2 0 v=vfactor*v(IN2) tripdv={tdv} tripdt={tdt}
bv3 Vm3 0 v=vfactor*v(IN3) tripdv={tdv} tripdt={tdt}
* Measurements
bVL1 L1 0 v=v(vm1) tripdv={tdv} tripdt={tdt}
bVL2 L2 0 v=v(vm2) tripdv={tdv} tripdt={tdt}
bVL3 L3 0 v=v(vm3) tripdv={tdv} tripdt={tdt}
.ENDS


* measure of instantaneous value of current with multiplier

.SUBCKT ameter_raw IN OUT M_I
+ params: factor={1/sqrt(2)} tdv=1 tdt=1 rgnd=1e12
vm IN OUT 0
ev M_I 0 VALUE={factor*i(vm)} tripdv={tdv} tripdt={tdt}
Rmi M_I 0 {Rgnd}
.ENDS

* measure of instantaneous value of voltage with multiplier
*
.SUBCKT vmeter_raw IN OUT M_I
+ params: factor={sqrt(3)/sqrt(2)} tdv=1 tdt=1 rgnd=1e12
vm IN OUT 0
ev M_I 0 VALUE={factor*v(IN)} tripdv={tdv} tripdt={tdt}
Rmi M_I 0 {Rgnd}
.ENDS

* measurement of instantaneous apparent power value with multiplier

.SUBCKT smeter_raw  IN1 OUT1 M_S1
+params: sfactor=1 tdv=1 tdt=1 factor={1/2} rgnd=1e12 ; sqrt(2)*sqrt(2)
VU IN1 OUT1 0
*************************** Voltage Veff ************************
Ev1 m_s1 0 VALUE={sfactor*factor*V(IN1)*I(VU)} tripdv={tdv} tripdt={tdt}
Rms1 m_s1 0 {Rgnd}
.ENDS


* 3 phase measurement of instantaneous apparent power value with multiplier
.SUBCKT smeter_uvw_raw  IN1 IN2 IN3 OUT1 OUT2 OUT3 M_S1 M_S2 M_S3
+params: sfactor=3 tdv=1 tdt=1 factor={1/2} rgnd=1e12 ; sqrt(2)*sqrt(2)
VU IN1 OUT1 0
VV IN2 OUT2 0
VW IN3 OUT3 0
*************************** Voltage Veff ************************
Ev1 m_s1 0 VALUE={sfactor*factor*V(IN1)*I(VU)} tripdv={tdv} tripdt={tdt}
Ev2 m_s2 0 VALUE={sfactor*factor*V(IN2)*I(VV)} tripdv={tdv} tripdt={tdt}
Ev3 m_s3 0 VALUE={sfactor*factor*V(IN3)*I(VW)} tripdv={tdv} tripdt={tdt}
Rms1 m_s1 0 {Rgnd}
Rms2 m_s2 0 {Rgnd}
Rms3 m_s3 0 {Rgnd}
.ENDS




* 3 phase measure of rms of effective power with RMS device from @Vlad

.SUBCKT pmeter_uvw vin1 vin2 vin3 vout1 vout2 vout3 P1 P2 P3
+params: fn=50 fc=3 sfactor=1 tdv=1 tdt=1
Xpm1 vin1 vout1 p1 pmeter_RMS
+params: fn={fn} fc={fc} sfactor={sfactor} tdv={tdv} tdt={tdt}
Xpm2 vin2 vout2 p2 pmeter_RMS
+params: fn={fn} fc={fc} sfactor={sfactor} tdv={tdv} tdt={tdt}
Xpm3 vin3 vout3 p3 pmeter_RMS
+params: fn={fn} fc={fc} sfactor={sfactor} tdv={tdv} tdt={tdt}
.ENDS

* 3 phase measure of rms of reacitve power with with RMS device from @Vlad

.SUBCKT qmeter_uvw  vin1 vin2 vin3 vout1 vout2 vout3  Q1 Q2 Q3
+params: fn=50 fc=3 sfactor=1 tdv=1 tdt=1
Xpm1 vin1 vout1 q1 qmeter_RMS
+params: fn={fn} fc={fc} sfactor={sfactor} tdv={tdv} tdt={tdt}
Xpm2 vin2 vout2 q2 qmeter_RMS
+params: fn={fn} fc={fc} sfactor={sfactor} tdv={tdv} tdt={tdt}
Xpm3 vin3 vout3 q3 qmeter_RMS
+params: fn={fn} fc={fc} sfactor={sfactor} tdv={tdv} tdt={tdt}
.ENDS

* 3 phase measure of rms of reacitve power with with RMS device from @Vlad

.SUBCKT qmeter_uvw_sgn  vin1 vin2 vin3 vout1 vout2 vout3  Q1 Q2 Q3
+params: fn=50 fc=3 sfactor=1 tdv=1 tdt=1
Xpm1 vin1 vout1 q1 qmeter_RMS
+params: fn={fn} fc={fc} sfactor={sfactor} tdv={tdv} tdt={tdt}
Xpm2 vin2 vout2 q2 qmeter_RMS
+params: fn={fn} fc={fc} sfactor={sfactor} tdv={tdv} tdt={tdt}
Xpm3 vin3 vout3 q3 qmeter_RMS
+params: fn={fn} fc={fc} sfactor={sfactor} tdv={tdv} tdt={tdt}
.ENDS

* 3 phase measure of rms of apparent power with with RMS device from @Vlad
*
.SUBCKT smeter_uvw vin1 vin2 vin3 vout1 vout2 vout3 s1 s2 s3
+params:fn=50 fc=3 sfactor=1 tdv=1 tdt=1
Xpm1 vin1 vout1 s1 smeter_RMS
+params:fn={fn} fc={fc} sfactor={sfactor} tdv={tdv} tdt={tdt}
Xpm2 vin2 vout2 s2 smeter_RMS
+params:fn={fn} fc={fc} sfactor={sfactor} tdv={tdv} tdt={tdt}
Xpm3 vin3 vout3 s3 smeter_RMS
+params:fn={fn} fc={fc} sfactor={sfactor} tdv={tdv} tdt={tdt}
.ENDS

.SUBCKT smeter_1_uvw L1_1 L2_1 L3_1 L1_2 L2_2 L3_2 s
+params: tdv=1 tdt=1 rgnd=1e12
Xam L1_1 L2_1 L3_1 L1_2a L2_2a L3_2a m_i ameter_1_uvw
Xvm L1_2a L2_2a L3_2a L1_2 L2_2 L3_2 m_v vmeter_1_uvw
Es s 0 VALUE={v(m_v)*v(m_i)*sqrt(3)} tripdv={tdv} tripdt={tdt}
Rs s 0 {Rgnd}
.ENDS


.SUBCKT pqsmeter_1_uvw L1_1 L2_1 L3_1 L1_2 L2_2 L3_2 m_p m_q m_s
+params: fn=50 tdv=1 tdt=1 rgnd=1e12
Xsm L1_1 L2_1 L3_1 L1_2a L2_2 L3_2 m_s smeter_1_uvw
Xpmc L1_2a L1_2b phii phasemeter_current params:fn={fn}
Xpmv L1_2b L1_2 phiv phasemeter params:fn={fn}
Edphi dphi 0 VALUE={v(phii)-v(phiv)} tripdv={tdv} tripdt={tdt}
Ephi phi 0 VALUE={IF(v(dphi)>90,v(dphi)-180,IF(v(dphi)<-90,v(dphi)+180,v(dphi)))} tripdv={tdv} tripdt={tdt}
Ep_m m_p 0 VALUE={IF(v(dphi)<90 & v(dphi)>-90,v(m_s)*cos(V(phi)*pi/180),-v(m_s)*cos(V(phi)*pi/180))}  tripdv={tdv} tripdt={tdt}
Eq_m m_q 0 VALUE={IF(v(dphi)<90 & v(dphi)>-90,-v(m_s)*sin(V(phi)*pi/180),v(m_s)*sin(V(phi)*pi/180))}  tripdv={tdv} tripdt={tdt}
Rmp m_p 0 {Rgnd}
Rmq m_q 0 {Rgnd}
Rms m_s 0 {Rgnd}
.ENDS


* 1 phase measure of rms of acitve power with integral
* DEPRECATED  use instead new xxx_RMS devices

.SUBCKT pmeter  vin vout P
+params: att=1000 fn=50  tripdt=1u  tripdv=100  off=1v  tripdt2=10n sfactor=1
Vamper vin vout 0
Gvolt 0 filt vin 0 {1/att}
Cf filt 0 {1/4/pi/fn} Lser=0 Rpar=0 Cpar=0 RLshunt=0 ic=0 Rpar=1
Bper 0 per i=idt( 0, idt( 1,0,v(res) ), v(clk) ) tripdt={tripdt} tripdv={tripdv} rpar=1
B_per 0 _per i=idt( 0, idt( 1,0,v(_res) ), v(_clk) ) tripdt={tripdt} tripdv={tripdv} rpar=1
Bclk 0 clk i=u( ddt( sgn(v(filt)) ) ) tripdt={tripdt2} tripdv=0.4 rpar=2
B_clk 0 _clk i=u( ddt( sgn(-v(filt)) ) ) tripdt={tripdt2} tripdv=0.4 rpar=2
Bres 0 res i=u( ddt( sgn(v(filt)-off) ) ) tripdt={tripdt2} tripdv=0.4 rpar=2
B_res 0 _res i=u( ddt( sgn(-v(filt)-off) ) ) tripdt={tripdt2} tripdv=0.4 rpar=2
*
BV 0 V i=idt( 0, idt( i(Gvolt)**2,0,v(res) ) / v(per), v(clk) )**0.5 + idt( 0, idt( i(Gvolt)**2,0,v(_res) ) / v(_per), v(_clk) )**0.5 tripdt={tripdt} tripdv={tripdv} rpar={att/2}
BI 0 I i=idt( 0, idt( i(Vamper)**2/att**2,0,v(res) ) / v(per), v(clk) )**0.5 + idt( 0, idt( i(Vamper)**2/att**2,0,v(_res) ) / v(_per), v(_clk) )**0.5 tripdt={tripdt} tripdv={tripdv} rpar={att/2}
BS 0 S i=V(V)*V(I)/att**2 tripdt={tripdt} tripdv={tripdv} rpar={att**2}
BP 0 P i=sfactor*idt( 0, idt( I(Gvolt)*I(Vamper)/att,0,v(res) ) / v(per), v(clk) ) + sfactor*idt( 0, idt( I(Gvolt)*I(Vamper)/att,0,v(_res) ) / v(_per), v(_clk) ) tripdt={tripdt} tripdv={tripdv} rpar={att**2/2}
BQ 0 Q i=sqrt(V(S)**2-V(P)**2)/att tripdt={tripdt} tripdv={tripdv} rpar={att}
.ENDS


* 1 phase measure of rms of reacitve power with integral
*DEPRECATED  use instead new _RMS devices

.SUBCKT qmeter  vin vout Q
+params: att=1000 fn=50  tripdt=1u  tripdv=100  off=1v  tripdt2=10n sfactor=1
Vamper vin vout 0
Gvolt 0 filt vin 0 {1/att}
Cf filt 0 {1/4/pi/fn} Lser=0 Rpar=0 Cpar=0 RLshunt=0 ic=0 Rpar=1
Bper 0 per i=idt( 0, idt( 1,0,v(res) ), v(clk) ) tripdt={tripdt} tripdv={tripdv} rpar=1
B_per 0 _per i=idt( 0, idt( 1,0,v(_res) ), v(_clk) ) tripdt={tripdt} tripdv={tripdv} rpar=1
Bclk 0 clk i=u( ddt( sgn(v(filt)) ) ) tripdt={tripdt2} tripdv=0.4 rpar=2
B_clk 0 _clk i=u( ddt( sgn(-v(filt)) ) ) tripdt={tripdt2} tripdv=0.4 rpar=2
Bres 0 res i=u( ddt( sgn(v(filt)-off) ) ) tripdt={tripdt2} tripdv=0.4 rpar=2
B_res 0 _res i=u( ddt( sgn(-v(filt)-off) ) ) tripdt={tripdt2} tripdv=0.4 rpar=2
*
BV 0 V i=idt( 0, idt( i(Gvolt)**2,0,v(res) ) / v(per), v(clk) )**0.5 + idt( 0, idt( i(Gvolt)**2,0,v(_res) ) / v(_per), v(_clk) )**0.5 tripdt={tripdt} tripdv={tripdv} rpar={att/2}
BI 0 I i=idt( 0, idt( i(Vamper)**2/att**2,0,v(res) ) / v(per), v(clk) )**0.5 + idt( 0, idt( i(Vamper)**2/att**2,0,v(_res) ) / v(_per), v(_clk) )**0.5 tripdt={tripdt} tripdv={tripdv} rpar={att/2}
BS 0 S i=V(V)*V(I)/att**2 tripdt={tripdt} tripdv={tripdv} rpar={att**2}
BP 0 P i=idt( 0, idt( I(Gvolt)*I(Vamper)/att,0,v(res) ) / v(per), v(clk) ) + idt( 0, idt( I(Gvolt)*I(Vamper)/att,0,v(_res) ) / v(_per), v(_clk) ) tripdt={tripdt} tripdv={tripdv} rpar={att**2/2}
BQ 0 Q i=sfactor*sqrt(V(S)**2-V(P)**2)/att tripdt={tripdt} tripdv={tripdv} rpar={att}
.ENDS

* DEPRECATED  use instead new _RMS devices
.SUBCKT qmeter_sgn  vin vout Qsgn
+params: att=1000 fn=50  tripdt=1u  tripdv=100  off=1v  tripdt2=10n sfactor=1
Vamper vin vout 0
Gvolt 0 filt vin 0 {1/att}
Cf filt 0 {1/4/pi/fn} Lser=0 Rpar=0 Cpar=0 RLshunt=0 ic=0 Rpar=1
Bper 0 per i=idt( 0, idt( 1,0,v(res) ), v(clk) ) tripdt={tripdt} tripdv={tripdv} rpar=1
B_per 0 _per i=idt( 0, idt( 1,0,v(_res) ), v(_clk) ) tripdt={tripdt} tripdv={tripdv} rpar=1
Bclk 0 clk i=u( ddt( sgn(v(filt)) ) ) tripdt={tripdt2} tripdv=0.4 rpar=2
B_clk 0 _clk i=u( ddt( sgn(-v(filt)) ) ) tripdt={tripdt2} tripdv=0.4 rpar=2
Bres 0 res i=u( ddt( sgn(v(filt)-off) ) ) tripdt={tripdt2} tripdv=0.4 rpar=2
B_res 0 _res i=u( ddt( sgn(-v(filt)-off) ) ) tripdt={tripdt2} tripdv=0.4 rpar=2
*
BV 0 V i=idt( 0, idt( i(Gvolt)**2,0,v(res) ) / v(per), v(clk) )**0.5 + idt( 0, idt( i(Gvolt)**2,0,v(_res) ) / v(_per), v(_clk) )**0.5 tripdt={tripdt} tripdv={tripdv} rpar={att/2}
BI 0 I i=idt( 0, idt( i(Vamper)**2/att**2,0,v(res) ) / v(per), v(clk) )**0.5 + idt( 0, idt( i(Vamper)**2/att**2,0,v(_res) ) / v(_per), v(_clk) )**0.5 tripdt={tripdt} tripdv={tripdv} rpar={att/2}
BS 0 S i=V(V)*V(I)/att**2 tripdt={tripdt} tripdv={tripdv} rpar={att**2}
BP 0 P i=idt( 0, idt( I(Gvolt)*I(Vamper)/att,0,v(res) ) / v(per), v(clk) ) + idt( 0, idt( I(Gvolt)*I(Vamper)/att,0,v(_res) ) / v(_per), v(_clk) ) tripdt={tripdt} tripdv={tripdv} rpar={att**2/2}
BQ 0 Q i=sfactor*sqrt(V(S)**2-V(P)**2)/att tripdt={tripdt} tripdv={tripdv} rpar={att}
xphv vin phiv PhaseDet params: fn={fn} deg=1 Rpar=1G
xphii iin phii PhaseDet params: fn={fn} deg=1 Rpar=1G
bphi 0 iin i=i(Vamper) rpar=1 tripdv={tdv} tripdt={tdt}
bsgn Qsgn 0 v=if(abs(v(phiv)-v(phii))>180,-v(Q)*sgn(v(phiv)-v(phii)),v(Q)*sgn(v(phiv)-v(phii))) tripdv={tdv} tripdt={tdt}
.ENDS


* 1 phase measure of rms apparent power with integral
* DEPRECATED  use instead new _RMS devices
*
.SUBCKT smeter  vin vout S
+params: att=1000 fn=50  tripdt=1u  tripdv=100  off=1v  tripdt2=10n sfactor=1
Vamper vin vout 0
Gvolt 0 filt vin 0 {1/att}
Cf filt 0 {1/4/pi/fn} Lser=0 Rpar=0 Cpar=0 RLshunt=0 ic=0 Rpar=1
Bper 0 per i=idt( 0, idt( 1,0,v(res) ), v(clk) ) tripdt={tripdt} tripdv={tripdv} rpar=1
B_per 0 _per i=idt( 0, idt( 1,0,v(_res) ), v(_clk) ) tripdt={tripdt} tripdv={tripdv} rpar=1
Bclk 0 clk i=u( ddt( sgn(v(filt)) ) ) tripdt={tripdt2} tripdv=0.4 rpar=2
B_clk 0 _clk i=u( ddt( sgn(-v(filt)) ) ) tripdt={tripdt2} tripdv=0.4 rpar=2
Bres 0 res i=u( ddt( sgn(v(filt)-off) ) ) tripdt={tripdt2} tripdv=0.4 rpar=2
B_res 0 _res i=u( ddt( sgn(-v(filt)-off) ) ) tripdt={tripdt2} tripdv=0.4 rpar=2
*
BV 0 V i=idt( 0, idt( i(Gvolt)**2,0,v(res) ) / v(per), v(clk) )**0.5 + idt( 0, idt( i(Gvolt)**2,0,v(_res) ) / v(_per), v(_clk) )**0.5 tripdt={tripdt} tripdv={tripdv} rpar={att/2}
BI 0 I i=idt( 0, idt( i(Vamper)**2/att**2,0,v(res) ) / v(per), v(clk) )**0.5 + idt( 0, idt( i(Vamper)**2/att**2,0,v(_res) ) / v(_per), v(_clk) )**0.5 tripdt={tripdt} tripdv={tripdv} rpar={att/2}
BS 0 S i=sfactor*V(V)*V(I)/att**2 tripdt={tripdt} tripdv={tripdv} rpar={att**2}
BP 0 P i=idt( 0, idt( I(Gvolt)*I(Vamper)/att,0,v(res) ) / v(per), v(clk) ) + idt( 0, idt( I(Gvolt)*I(Vamper)/att,0,v(_res) ) / v(_per), v(_clk) ) tripdt={tripdt} tripdv={tripdv} rpar={att**2/2}
BQ 0 Q i=sqrt(V(S)**2-V(P)**2)/att tripdt={tripdt} tripdv={tripdv} rpar={att}
.ENDS

* 1 phase RMS voltage meter
