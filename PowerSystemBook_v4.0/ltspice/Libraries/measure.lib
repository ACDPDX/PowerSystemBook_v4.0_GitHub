* 3 phase balanced vRMS meter for 50Hz
.subckt vmeter_3ph_RMS_50 u1 v1 w1 u2 v2 w2 V
+ params: fn1=50 vfactor=sqrt(3)
Vu1 u1 u2 0v
Vv1 v1 v2 0v
Vw1 w1 w2 0v
EuxS   usxS  0  VALUE={(2*v(u1,0)-v(v1,0)-v(w1,0))/3} tripdv={tdv} tripdt={tdt} 
EuyS   usyS  0  VALUE={(v(v1,0)-v(w1,0))/1.732} tripdv={tdv} tripdt={tdt} 
Eux    usx   0  VALUE={ v(usxS)*cos(v(alpha))+v(usyS)*sin(v(alpha))} tripdv={tdv} tripdt={tdt} 
Euy    usy   0  VALUE={-v(usxS)*sin(v(alpha))+v(usyS)*cos(v(alpha))} tripdv={tdv} tripdt={tdt} 
Eus    V     0  VALUE={sqrt(v(usx)*v(usx)+v(usy)*v(usy))/sqrt(2)*vfactor} tripdv={tdv} tripdt={tdt}
Ealpha alpha 0  VALUE={v(idt1)} tripdv={tdv} tripdt={tdt}
G1x 0 idt1 VALUE={2*pi*fn1} tripdv={tdv} tripdt={tdt}
C1x idt1 0 1
R1x idt1 0 1e10
.ends

