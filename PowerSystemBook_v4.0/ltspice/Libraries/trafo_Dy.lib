.SUBCKT Trafo3Dy11_ideal  1U  1V  1W  2U  2V  2W  2N
+	PARAMS:
+	U1Nenn=400V
+	U20=400V
+   k=1
+   N1=1000
+   l_=0
+   stproz=1
+   ueN={U1Nenn*sqrt(3)/U20}
+   ue={ueN+ueN*l_*stproz/100}
.param N1={N1} N2={N1/ue} 
* Dy5
*Xu  1U	1V	2N	2U  N1N2_Dy params: N1={N1} N2={N2} k={k}
*Xv  1V	1W	2N	2V  N1N2_Dy params: N1={N1} N2={N2} k={k}
*Xw  1W	1U	2N	2W  N1N2_Dy params: N1={N1} N2={N2} k={k}
* Dy11
Xu	1U	1V	2U	2N N1N2_Dy params: N1={N1} N2={N2} k={k}
Xv	1V	1W	2V	2N N1N2_Dy params: N1={N1} N2={N2} k={k}
Xw	1W	1U	2W	2N N1N2_Dy params: N1={N1} N2={N2} k={k}
RGND1U 1U 0 1e12
RGND1V 1V 0 1e12
RGND1W 1W 0 1e12
RGND2U 2U 0 1e12
RGND2V 2V 0 1e12
RGND2W 2W 0 1e12
RGND2N 2N 0 1e12
.ENDS


