.SUBCKT Trafo3Dd6  1U  1V  1W   2U  2V  2W  2N
+	PARAMS:
+	SN=10kVA
+	U1Nenn=400V
+	U20=400V
+	fn={fn1}
+	N1=1000
+	uR=0.04
+	uX=0.08
+	i0=0.05
+	p0=0.005
+   a=0.75
+   m=9
+   psi_0=0
+   psir=1
+   psis=-0.5
+   psit=-0.5
+   tpsi0=1000s
+   tpsid=0.1ms
+   ron=0.00001
+   bf=0
+   rkessel=6e5 ;magn. resistance of the kettle filled with oil / reduce it for an effect (e.g. 1e6)
+   l_=0
+   middle=0
+   stproz=1.0
+   ctrl={1+(l_-middle)*stproz/100}

