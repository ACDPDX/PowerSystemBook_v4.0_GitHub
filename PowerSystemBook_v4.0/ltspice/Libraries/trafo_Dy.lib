+	p0=0.005
+   bf=0
+   l_=0
+   middle=0
+   stproz=1.0
+   ctrl={1+(l_-middle)*stproz/100}
Xu	1U	1V	2N	2U	 Trafo_N1N2_simple_ctrl_Dy
+ PARAMS:
+ SN={SN/3}
+ U1N={U1Nenn}
+ U20={U20/sqrt(3)}
+ fN={fN}
+ N1={N1}
+ uR={uR}
+ uX={uX}
+ i0={i0*IF(bf==0,1,1.2)}
+ p0={p0*IF(bf==0,1,1.2)}
