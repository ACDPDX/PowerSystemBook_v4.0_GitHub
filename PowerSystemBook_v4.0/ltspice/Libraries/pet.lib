****************
*  Pet with controlling pin
****************

* 110kV

* Value at the ctrl pin is in A !!
* IN determines the value of R = Z/100
* IN should be only positiv and not zero


.SUBCKT   Pet_var_110kV  N  ctrl
+	PARAMS:
+   VN=110k;
+   fn={fn1}
+   IN=250
+  r_x=0.01
.PARAM
+   ZN={VN/sqrt(3)/IN}
+   R ={ZN*r_x}
Rctrl ctrl 0 1e12
VPet N y 0
RPet y x {R}
L1 x 0 Flux=v(L)*x
EL   L 0 VALUE={v(ZN)/(2*pi*fn)} tripdv={tdv} tripdt={tdt}
EZN ZN 0 VALUE={VN/sqrt(3)/(v(ctrl)+1e-8)} tripdv={tdv} tripdt={tdt}
.ENDS

* 10kV

* Value at the ctrl pin is in A !!
* IN determines the value of R = Z/100
* IN should be only positiv and not zero
.SUBCKT  Pet_var_10kV N ctrl
+	PARAMS:
+   VN=10k;
+   fn={fn1}
+   IN=250
+   r_x=0.01
.PARAM
+   ZN={VN/sqrt(3)/IN}
+   R ={ZN*r_x}
Rctrl ctrl 0 1e12
VPet N y 0
RPet y x {R}
L1 x 0 Flux=v(L)*x
EL   L 0 VALUE={v(ZN)/(2*pi*fn)} tripdv={tdv} tripdt={tdt}
EZN ZN 0 VALUE={VN/sqrt(3)/(v(ctrl)+1e-8)} tripdv={tdv} tripdt={tdt}
.ENDS

