********************************************
* Petersen generic
********************************************


.SUBCKT   Pet  N
+	PARAMS:
+   VN=110k;
+   fn={fn1}
+   IN=250
+   r_x=0.01
.PARAM
+   omega={2*pi*fn}
+   ZN={VN/sqrt(3)/IN}
+	  L ={ZN/omega}
+   R= {r_x*ZN}
LPet N 0 {L} rser={R}
.ENDS


