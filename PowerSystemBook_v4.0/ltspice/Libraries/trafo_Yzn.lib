* My special thank to Emer. Prof. Dr. Otto Justus who
* allowed me to use his models of transformer and synchronous generator

* Trafo3YNzn5

*      W1      W2      W3
*     o  u    o  u    o  u 
* Xu 1U	1N	2WU	2N	2UV	2U
* Xv 1V	1N	2UV	2N	2VW	2V
* Xw 1W	1N	2VW	2N	2WU	2W

* Trafo3YNzn11 (two secondary sides exchanged)
*      W1      W2      W3
*     o  u    o  u    o  u
* Xu 1U	1N	2N	2WU	2U	2UV
* Xv 1V	1N	2N	2UV	2V	2VW
* Xw 1W	1N	2N	2VW	2W 2WU

* OR simpler: (only primary side exchanged)
*      W1      W2      W3
*     o  u    o  u    o  u
* Xu 1N	1U	2WU	2N	2UV	2U
* Xv 1N	1V	2UV	2N	2VW	2V
* Xw 1N	1W	2VW	2N	2WU	2W

.SUBCKT Trafo3YNzn5  1U  1V  1W  1N  2U  2V  2W 2N
+	PARAMS:
+	SN=10kVA
+	U1Nenn=400V
+	U20=400V
+	fn={fn1}
+	N1=1000
+	uR=0.04
+	uX=0.08
+	i0=0.05
+	p0=0.005
+   a={0.3}
+   m={7}
+   psi_0=0
+   psir=1
+   psis=-0.5
+   psit=-0.5
+   tpsi0=1000s
+   tpsid=0.1ms
+   ron=0.00001
+   rkessel=6e5 ;magn. resistance of the kettle filled with oil / reduce it for an effect (e.g. 1e6)
+   l_=0
+   middle=0
+   stproz=1.0
+   ctrl={1+(l_-middle)*stproz/100}
Xu	1U	1N	2WU	2N	2UV	2U	magn1	magn2	Trafoschenkel3_Yzn
+ PARAMS:
+ SN={SN/3}
+ U1N={U1Nenn/sqrt(3)}
+ U20={U20/3}
+ U30={U20/3}
+ fN={fN}
+ N1={N1}
+ uR={uR*1.2}
+ uX={uX*1.2} 
+ i0={i0}
+ p0={p0}
+ a={a} ; FS
+ m={m} ; FS
+ psi_0={psir*psi_0}
+ tpsi0={tpsi0}
+ tpsid={tpsid}
+ ron={ron}
+ ctrl={ctrl}
Xv	1V	1N	2UV	2N	2VW	2V	magn1	magn2	Trafoschenkel3_Yzn
+ PARAMS:
+ SN={SN/3}
+ U1N={U1Nenn/sqrt(3)}
+ U20={U20/3}
+ U30={U20/3}
+ fN={fN}
+ N1={N1}
+ uR={uR*1.2}
+ uX={uX*1.2}
+ i0={i0}
+ p0={p0}
+ a={a} ; FS
+ m={m} ; FS
+ psi_0={psis*psi_0}
+ tpsi0={tpsi0}
+ tpsid={tpsid}
+ ron={ron}
+ ctrl={ctrl}
Xw	1W	1N	2VW	2N	2WU	2W	magn1	magn2	Trafoschenkel3_Yzn
+ PARAMS:
+ SN={SN/3}
+ U1N={U1Nenn/sqrt(3)}
+ U20={U20/3}
+ U30={U20/3}
+ fN={fN}
+ N1={N1}
+ uR={uR*1.2}
+ uX={uX*1.2}
+ i0={i0}
+ p0={p0}
+ a={a} ; FS
+ m={m} ; FS
+ psi_0={psit*psi_0}
+ tpsi0={tpsi0}
+ tpsid={tpsid}
+ ron={ron}
+ ctrl={ctrl}
*Rm	magn1	0	1MEG
Rkessel magn1 magn2 {rkessel}
RGND1U 1U 0 1e10
RGND1V 1V 0 1e10
RGND1W 1W 0 1e10
RGND2U 2U 0 1e10
RGND2V 2V 0 1e10
RGND2W 2W 0 1e10
RGND1N 1N 0 1e12
RGND2N 2N 0 1e12
.ENDS

.SUBCKT Trafo3YNzn5_HB  1U  1V  1W  1N  2U  2V  2W 2N
+	PARAMS:
+	SN=10kVA
+	U1Nenn=400V
+	U20=400V
+	fn={fn1}
+	N1=1000
+	uR=0.04
+	uX=0.08
+	i0=0.05
+	p0=0.005
+   a={0.3}
+   m={7}
+   psi_0=0
+   psir=1
+   psis=-0.5
+   psit=-0.5
+   tpsi0=1000s
+   tpsid=0.1ms
+   ron=0.00001
+   rkessel=6e5 ;magn. resistance of the kettle filled with oil / reduce it for an effect (e.g. 1e6)
*
.param omega={2*pi*fN}
*
.param S1N={SN/3}
.param U1N={U1Nenn/sqrt(3)}
.param U20N={U20/3}
.param U30N={U20/3}
.param I1N={S1N/U1N}
.param Z1N={U1N/I1N}
.param Rfe={(U1N*U1N)/(p0*S1N)}
.param R1={Z1N*ur*1.2/2}
.param L1s={Z1N*ux*1.2/2/omega}
.param N2={N1*U20N/U1N}
.param N3={N1*U30N/U1N}
.param Xh={(U1N*U1N)/(S1N*sqrt(i0*i0-p0*p0))} 
.param imy={U1N/Xh} imyN={sqrt(2)*imy}
.param R2={R1*N2/N1*N2/N1}
.param R3={R1*N3/N1*N3/N1}
.param PsiN={U1N/omega}
.param a=0.75 m=9  phiN={sqrt(2)*PsiN/N1}  
.param rkessel=1e10 lkessel={1/rkessel}
* 
.param psi_0r={psir*psi_0*phiN}
.param psi_0s={psis*psi_0*phiN}
.param psi_0t={psit*psi_0*phiN}
*
* Template from file: Hosemann_Boeck_Yzn5.asc
*
XU5 u11 1n ux vr2 N1N2_Yzn N1={N1} N2=1
XU6 uy1 vr2 N001 2n N1N2_Yzn N1=1 N2={N2}
XU7 ux vr L4 length=1 L={L1s/N1/N1} rser={0.001m*L1s/N1/N1} IC=0
XU8 vr uy1 L4 length=1 L={L1s/N1/N1} rser={0.001m*L1s/N1/N1} IC=0
XU11 v11 1n vx vs2 N1N2_Yzn N1={N1} N2=1
XU13 vx vs L4 length=1 L={L1s/N1/N1} rser={0.001m*L1s/N1/N1} IC=0
XU14 vs vy1 L4 length=1 L={L1s/N1/N1} rser={0.001m*L1s/N1/N1} IC=0
XU17 w11 1n wx vt2 N1N2_Yzn N1={N1} N2=1
XU19 wx vt L4 length=1 L={L1s/N1/N1} rser={0.001m*L1s/N1/N1} IC=0
XU20 vt wy1 L4 length=1 L={L1s/N1/N1} rser={0.001m*L1s/N1/N1} IC=0
XU23 vt2 rk L4 length=1 L={Lkessel} rser={0.001m*Lkessel} IC=0
G1 0 phir VALUE={v(vr,vr2)} tripdv={tdv} tripdt={tdt}
G2 0 phis VALUE={v(vs,vs2)} tripdv={tdv} tripdt={tdt}
G3 0 phit VALUE={v(vt,vt2)} tripdv={tdv} tripdt={tdt}
XU31 phir 0 C4 length=1 C=1
XU32 phis 0 C4 length=1 C=1
XU33 phit 0 C4 length=1 C=1
XU34 phir 0 r4 length=1 R=1e9
XU35 phis 0 r4 length=1 R=1e9
XU36 phit 0 r4 length=1 R=1e9
G4 vr vr2 VALUE={imyN*N1*(a*v(phir)/phiN+(1-a)*(v(phir)/phiN)**m)} tripdv={tdv} tripdt={tdt}
G5 vs vs2 VALUE={imyN*N1*(a*v(phis)/phiN+(1-a)*(v(phis)/phiN)**m)} tripdv={tdv} tripdt={tdt}
G6 vt vt2 VALUE={imyN*N1*(a*v(phit)/phiN+(1-a)*(v(phit)/phiN)**m)} tripdv={tdv} tripdt={tdt}
V1 vs vr2 0 
V2 vt vs2 0
V3 vr rk 0  
XU24 1u u11 r4 length=1 R={R1}
XU67 u11 1n r4 length=1 R={Rfe}
XU82 u2 2u r4 length=1 R={R2}
G14 0 phik VALUE={v(vt2,vr)} tripdv={tdv} tripdt={tdt}
XU62 phik 0 C4 length=1 C=1
XU91 phik 0 r4 length=1 R=1e9
XU9 1v v11 r4 length=1 R={R1}
XU25 1w w11 r4 length=1 R={R1}
XU30 v2 2v r4 length=1 R={R2}
XU39 w2 2w r4 length=1 R={R2}
XU40 v11 1n r4 length=1 R={Rfe}
XU42 w11 1n r4 length=1 R={Rfe}
XU12 uy2 vr2 N002 u2 N1N2_Yzn N1=1 N2={N3}
XU18 vr uy2 L4 length=1 L={L1s/N1/N1} rser={0.001m*L1s/N1/N1} IC=0
XU28 vy1 vs2 N002 2n N1N2_Yzn N1=1 N2={N2}
XU41 vy2 vs2 N003 v2 N1N2_Yzn N1=1 N2={N3}
XU43 vs vy2 L4 length=1 L={L1s/N1/N1} rser={0.001m*L1s/N1/N1} IC=0
XU46 wy1 vt2 N003 2n N1N2_Yzn N1=1 N2={N2}
XU47 wy2 vt2 N001 w2 N1N2_Yzn N1=1 N2={N3}
XU48 vt wy2 L4 length=1 L={L1s/N1/N1} rser={0.001m*L1s/N1/N1} IC=0
*
* Remanent flux model
*
Vctrlr ctrlr 0 pwl 0s 0v {tpsi0} 0v {tpsi0+tpsid} 1V {tpsi0+2*tpsid} 1v {tpsi0+3*tpsid} 0v
S1r phir phixr ctrlr 0 MS1
.model MS1 SW(Ron={Ron} Roff=1e9 Vt=0.9 Vh=0.0 Lser=0 Vser=0)
E1r phixr 0 value={psi_0r} tripdv={tdv} tripdt={tdt} ; das ist die Spannungsquelle mit psi_0 der den Kondensator Cp auflädt !!!
Vctrls ctrls 0 pwl 0s 0v {tpsi0} 0v {tpsi0+tpsid} 1V {tpsi0+2*tpsid} 1v {tpsi0+3*tpsid} 0v
S1s phis phixs ctrls 0 MS1
E1s phixs 0 value={psi_0s} tripdv={tdv} tripdt={tdt} ; das ist die Spannungsquelle mit psi_0 der den Kondensator Cp auflädt !!!
Vctrlt ctrlt 0 pwl 0s 0v {tpsi0} 0v {tpsi0+tpsid} 1V {tpsi0+2*tpsid} 1v {tpsi0+3*tpsid} 0v
S1t phit phixt ctrlt 0 MS1
E1t phixt 0 value={psi_0t} tripdv={tdv} tripdt={tdt} ; das ist die Spannungsquelle mit psi_0 der den Kondensator Cp auflädt !!!
*
RGND1U 1U 0 1e10
RGND1V 1V 0 1e10
RGND1W 1W 0 1e10
RGND2U 2U 0 1e10
RGND2V 2V 0 1e10
RGND2W 2W 0 1e10
RGND1N 1N 0 1e12
RGND2N 2N 0 1e12
.ENDS

.SUBCKT Trafo3YNzn5_simple  1U  1V  1W  1N  2U  2V  2W 2N
+	PARAMS:
+	SN=10kVA
+	U1Nenn=400V
+	U20=400V
+	fn={fn1}
+	N1=1000
+	uR=0.04
+	uX=0.08
+	i0=0.05
+	p0=0.005
+   l_=0
+   middle=0
+   stproz=1.0
+   ctrl={1+(l_-middle)*stproz/100}
Xu	1U	1N	2WU	2N	2UV	2U	 Trafo_N1N2_simple_ctrl_Yzn
+ PARAMS:
+ SN={SN/3}
+ U1N={U1Nenn/sqrt(3)}
+ U20={U20/3}
+ U30={U20/3}
+ fN={fN}
+ N1={N1}
+ uR={uR*1.2}
+ uX={uX*1.2}
+ i0={i0}
+ p0={p0}
+ ctrl={ctrl}
Xv	1V	1N	2UV	2N	2VW	2V	 Trafo_N1N2_simple_ctrl_Yzn
+ PARAMS:
+ SN={SN/3}
+ U1N={U1Nenn/sqrt(3)}
+ U20={U20/3}
+ U30={U20/3}
+ fN={fN}
+ N1={N1}
+ uR={uR*1.2}
+ uX={uX*1.2}
+ i0={i0}
+ p0={p0}
+ ctrl={ctrl}
Xw	1W	1N	2VW	2N	2WU	2W	 Trafo_N1N2_simple_ctrl_Yzn
+ PARAMS:
+ SN={SN/3}
+ U1N={U1Nenn/sqrt(3)}
+ U20={U20/3}
+ U30={U20/3}
+ fN={fN}
+ N1={N1}
+ uR={uR*1.2}
+ uX={uX*1.2}
+ i0={i0}
+ p0={p0}
+ ctrl={ctrl}
RGND1U 1U 0 1e12
RGND1V 1V 0 1e12
RGND1W 1W 0 1e12
RGND2U 2U 0 1e12
RGND2V 2V 0 1e12
RGND2W 2W 0 1e12
RGND1N 1N 0 1e12
RGND2N 2N 0 1e12
.ENDS

* other model with other transformer taping algorithm (uX quadratic dependent of tap position)
.SUBCKT Trafo3YNzn5_simple_2  1U  1V  1W  1N  2U  2V  2W 2N
+	PARAMS:
+	SN=10kVA
+	U1Nenn=400V
+	U20=400V
+	fn={fn1}
+	N1=1000
+	uR=0.04
+	uX=0.08
+	i0=0.05
+	p0=0.005
+   l_=0
+   middle=0
+   stproz=1.0
.PARAM
+ S1N={SN/3}
+ U1N={U1Nenn/sqrt(3)}
+ U20N={U20/3}
+ U30={U20/3}
+ I1N={S1N/U1N}
+ Z1N={U1N/I1N}
+ omegaN={(2*pi)*fN}
+ R1={Z1N*uR*1.2/2}
+ L1s={Z1N*uX*1.2/2/omegaN}
+ RFe={U1N*U1N/(p0*S1N)}
+ N2={N1*U20N/U1N}
+ N3={N1*U30/U1N}
+ R2={R1*N2/N1*N2/N1}
+ R3={R1*N3/N1*N3/N1}
+ Xh={(U1N*U1N)/(S1N*sqrt(i0*i0-p0*p0))} ;FS
+ L1={Xh/omegaN}
+ L2={L1*N2/N1*N2/N1}
+ L3={L1*N3/N1*N3/N1}
+ sigma1={L1s/L1}
+ sigma={2*sigma1-sigma1*sigma1}
+ k={sqrt(1-sigma)}
+ ctrl={1+(l_-middle)*stproz/100}
+ ctrl2={ctrl*ctrl}
*Xu	1U	1N	2WU	2N	2UV	2U
*Xv	1V	1N	2UV	2N	2VW	2V
*Xw	1W	1N	2VW	2N	2WU	2W
* U-Phase
R1U 1U Up  {R1*ctrl2}
RfeU Up 1N {RFe}
L1U Up 1N  {L1*ctrl2} rser=0
L2U Us1 2N  {L2} rser=0 
L3U Us2 2U  {L3} rser=0
K123U L1U L2U L3U {k}
R2U Us1 2WU  {R2}
R3U Us2 2UV  {R3}
* V-Phase
R1V 1V Vp  {R1*ctrl2}
RfeV Vp 1N {RFe}
L1V Vp 1N  {L1*ctrl2} rser=0
L2V Vs1 2N  {L2} rser=0
L3V Vs2 2V  {L3} rser=0
K123V L1V L2V L3V {k}
R2V Vs1 2UV  {R2}
R3V Vs2 2VW  {R3}
* W-Phase
R1W 1W Wp  {R1*ctrl}
RfeW Wp 1N {RFe}
L1W Wp 1N  {L1*ctrl2} rser=0
L2W Ws1 2N  {L2} rser=0
L3W Ws2 2W {L3} rser=0
K123W L1W L2W L3W {k}
R2W Ws1 2VW  {R2}
R3W Ws2 2WU  {R3}
*
RGND1U 1U 0 1e10
RGND1V 1V 0 1e10
RGND1W 1W 0 1e10
RGND2U 2U 0 1e10
RGND2V 2V 0 1e10
RGND2W 2W 0 1e10
RGND1N 1N 0 1e12
RGND2N 2N 0 1e12
.ENDS

.SUBCKT Trafo3YNzn5_ideal  1U  1V  1W  1N  2U  2V  2W  2N
+	PARAMS:
+	U1Nenn=400V
+	U20=400V
+   k=1
+   N1=1000
+   l_=0
+   stproz=1
+   ueN={U1Nenn/U20}
+   ue={ueN+ueN*l_*stproz/100}
.param N1={N1} N2={N1/ue} 
* YNzn5
Xu1 1U	1N	2WU	2N  N1N2_Yzn params: N1={N1*sqrt(3)} N2={N2} k={k}
Xu2 1U	1N	2UV	2U	N1N2_Yzn params: N1={N1*sqrt(3)} N2={N2} k={k}
Xv1 1V	1N	2UV	2N	N1N2_Yzn params: N1={N1*sqrt(3)} N2={N2} k={k}
Xv2 1V	1N	2VW	2V  N1N2_Yzn params: N1={N1*sqrt(3)} N2={N2} k={k}
Xw1 1W	1N	2VW	2N	N1N2_Yzn params: N1={N1*sqrt(3)} N2={N2} k={k}
Xw2 1W	1N	2WU	2W  N1N2_Yzn params: N1={N1*sqrt(3)} N2={N2} k={k}
* YNzn11
*Xu1 1U	1N	2N	2WU	N1N2_Yzn params: N1={N1*sqrt(3)} N2={N2} k={k}
*Xu2 1U	1N	2U  2UV N1N2_Yzn params: N1={N1*sqrt(3)} N2={N2} k={k}
*Xv1 1V	1N	2N	2UV	N1N2_Yzn params: N1={N1*sqrt(3)} N2={N2} k={k}
*Xv2 1V	1N	2V  2VW N1N2_Yzn params: N1={N1*sqrt(3)} N2={N2} k={k}
*Xw1 1W	1N	2N	2VW	N1N2_Yzn params: N1={N1*sqrt(3)} N2={N2} k={k}
*Xw2 1W	1N	2W  2WU N1N2_Yzn params: N1={N1*sqrt(3)} N2={N2} k={k}
RGND1U 1U 0 1e12
RGND1V 1V 0 1e12
RGND1W 1W 0 1e12
RGND2U 2U 0 1e12
RGND2V 2V 0 1e12
RGND2W 2W 0 1e12
RGND1N 1N 0 1e12
RGND2N 2N 0 1e12
.ENDS



