.SUBCKT RUYNzn5_10k_400_630kVA_simple  1U  1V  1W  1N  2U  2V  2W 2N
+	PARAMS:
+	SN=630e3
+	U1Nenn=10.6e3
+	U20=400
+	fn={fn1}
+	N1=1000
+	uR=0.01
+	uX=0.05
+	i0=0.02
+	p0=0.0025
+   l_=0
+   middle=0
+   stproz=1.0
+   ctrl={1+(l_-middle)*stproz/100}
