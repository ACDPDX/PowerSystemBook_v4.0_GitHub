* ***********************************************************************
* Wichtige Subcircuits die für alle Trafomodelle gebraucht werden !!!!
* ***********************************************************************
*

******   Trafoschenkel3_Yzn   **********

* SCHENKEL_Yzn eines Transformators mit 3 Wicklungen *

****** die AC-Analyse beruecksichtigt nur den linearen Anteil
******* der Magnetisierungskurve i=f(phi)

.SUBCKT   Trafoschenkel3_Yzn  1_1 1_2  2_1 2_2  3_1 3_2 magnP1 magnP2
+	PARAMS:
+	SN=100kVA
+	U1N=5773V
+	U20=133.3V
+	U30=133.3V
+	fn={fn1}
+	N1=1000
+	uR=0.02
+	uX=0.04
+	i0=0.025
+	p0=0.003
+   a={0.3} ; FS
+   m={7} ; FS
+   psi_0=0 ; Remanenzparameter zwischen 0,1,-1
+   tpsi0=40ms
+   tpsid=0.1ms
+   ron=0.00001
+   ctrl=1
.PARAM
+	I1N={SN/U1N}
+	Z1N={U1N/I1N}
+	omegaN={(2*pi)*fN}
+	R1={Z1N*uR/2}
+	L1s={Z1N*uX/2/omegaN}
+	RFe={U1N*U1N/(p0*SN)}
+	N2={N1*U20/U1N}
+	N3={N1*U30/U1N}
+	R2={R1*N2/N1*N2/N1}
+	R3={R1*N3/N1*N3/N1}
+   Xh={(U1N*U1N)/(SN*sqrt(i0*i0-p0*p0))} ;FS
+   iu={U1N/Xh} ;FS
+   ImyN={sqrt(2)*iu} ;FS
+	phiN={sqrt(2)*U1N/omegaN/N1}
*	Wicklungsstroeme
Gi1	1_1	1_2	VALUE={v(a,magnP1)/(N1*ctrl)} tripdv={tdv} tripdt={tdt}
Rpi1	1_1	1_2	1000MEG
Gi2	2_1	2_2	VALUE={v(b,a)/N2} tripdv={tdv} tripdt={tdt}
Rpi2	2_1	2_2	1000MEG
Gi3	3_1	3_2	VALUE={v(c,b)/N3} tripdv={tdv} tripdt={tdt}
Rpi3	3_1	3_2	1000MEG
*	Wicklungen
X_W1	magnP1	a	1_1	1_2	WICKLUNG_Yzn
+PARAMS:  R={R1}  N={N1}  Rphis={0.7*N1*N1/L1s} Psi_0={Psi_0*phiN} tpsi0={tpsi0} tpsid={tpsid} ron={ron} ctrl={ctrl}
X_W2	a   b    2_1	2_2	WICKLUNG_Yzn
+PARAMS:  R={R2}  N={N2}  Rphis={3*N1*N1/L1s} Psi_0={Psi_0*phiN} tpsi0={tpsi0} tpsid={tpsid} ron={ron} ctrl=1
X_W3	b   c    3_1	3_2	WICKLUNG_Yzn
+PARAMS:  R={R3}  N={N3}  Rphis={3*N1*N1/L1s} Psi_0={Psi_0*phiN} tpsi0={tpsi0} tpsid={tpsid} ron={ron} ctrl=1
*	EisenSchenkel
X_SCH	c	magnP2	SCHENKEL_Yzn   PARAMS:
+	N={N1}  RFe={RFe}  ImyN={ImyN} ctrl={ctrl}
+	phiN={phiN}	a={a}   m={m}
.ENDS
***	Ende des SUBCIRCUITS Trafoschenkel3_Yzn
*$


* 15a  WICKLUNG_Yzn

*
.SUBCKT WICKLUNG_Yzn  ma  mb  ea  eb
+PARAMS:   R=1   N=1    Rphis=1 Psi_0=0 tpsi0=1000s tpsid=0.1ms ron=0.00001 ctrl=1 ;passt für 1ms Schaltzeit bei C mit 1Coulomb
Gphi	ma	mb	VALUE={v(phi)} tripdv={tdv} tripdt={tdt}
Rphis	ma	mb	{Rphis*ctrl*ctrl}
Gp	0	phi	VALUE={(v(ea,eb)-R*ctrl*v(mb,ma)/(N*ctrl))/(N*ctrl)} tripdv={tdv} tripdt={tdt}
Cp phi 0 1 IC=0
Vctrl ctrl 0 pwl 0s 0v {tpsi0+1p} 0v {tpsi0+tpsid+2p} 1V {tpsi0+2*tpsid+3p} 1v {tpsi0+3*tpsid+4p} 0v
S1 phi phix ctrl 0 MS1
.model MS1 SW(Ron={Ron} Roff=1e9 Vt=0.9 Vh=0.0 Lser=0 Vser=0)
E1 phix 0 value={psi_0} tripdv={tdv} tripdt={tdt} ; das ist die Spannungsquelle mit psi_0 der den Kondensator Cp auflädt !!!
Rp	phi	0	1000MEG
.ENDS ;  WICKLUNG_Yzn
*$

* 15b  Eisenschenkel

*
.SUBCKT SCHENKEL_Yzn  m1  m2
+PARAMS:   N=1  RFe=1  ImyN=1  a=1  phiN=1 m=9 ctrl=1
LRFe	m1	mh	{N*ctrl*N*ctrl/RFe} Rser={0.001m*N*N/RFe}  ; Rser=parasitic Value zur besseren Konvergenz
vphi	mh	mh1	0
rphi    mh  0 1e12 
Eimy	mh1	m2
+VALUE={N*imyN*(a*i(vphi)/phiN+(1-a)*PWRS(i(vphi)/phiN,m))} tripdv={tdv} tripdt={tdt}
.ENDS


.subckt Trafo_N1N2_simple_ctrl_Yzn p1  p2  s3  s4  s5  s6 
+	PARAMS:
+	SN=1kVA
+	U1N=230V
+	U20=230V
+ U30=230V
+	fn={fn1}
+	N1=1000
+	uR=0.04
+	uX=0.08
+	i0=0.05
+	p0=0.005
+   ctrl=1
.PARAM
+	I1N={SN/U1N}
+	Z1N={U1N/I1N}
+	omegaN={(2*pi)*fN}
+	R1={Z1N*uR/2}
+	L1s={Z1N*uX/2/omegaN}
+	RFe={U1N*U1N/(p0*SN)}
+	N2={N1*U20/U1N}
+ N3={N1*U30/U1N}
+	R2={R1*N2/N1*N2/N1}
+ R3={R1*N3/N1*N3/N1}
+ Xh={(U1N*U1N)/(SN*sqrt(i0*i0-p0*p0))} ;FS
+ iu={U1N/Xh} ;FS
+ ImyN={sqrt(2)*iu} ;FS
+	phiN={sqrt(2)*U1N/omegaN/N1}
Rcup  p1 x12 {R1}
L1p    x12 p11 {L1s} rser=0
Rfe1   p11 p2 {RFe}
LXh p11 p2 flux={Xh/omegaN*x*ctrl*ctrl} rser=0
Rcus1   s33  s32 {R2}
L1s1   s32 s3 {L1s*N2/N1*N2/N1} rser=0
Rcus2  s55 s54 {R3}
L1s2   s54 s5 {L1s*N3/N1*N3/N1} rser=0
X_w1	p11 p2  s33  s4  N1N2_ctrl_Yzn params: N1={N1} N2={N2} ctrl={ctrl}
X_w2  p11 p2  s55  s6    N1N2_ctrl_Yzn params: N1={N1} N2={N3} ctrl={ctrl}
.ends


* ctrl node in verhältniseinheit
* UE/UEN=1+stproz/100 (0.9 .. 1 .. 1.2)
.subckt N1N2_ctrl_Yzn in1 in2 out1 out2 
+params: proz=1 k=1 N1=1 N2=1 ctrl=1
.param ue={N1/N2}
G1 0 M in1 in2 1
G2 0 M VALUE={-k*((v(out1)-v(out2))*ue*ctrl)} tripdv={tdv} tripdt={tdt}
G3 in1 in2 M 0 1
G4 out1 out2 VALUE={-k*((v(m))*ue*ctrl)} tripdv={tdv} tripdt={tdt}
R2 M 0 1e10
Rin1 in1 0 1e12
Rin2 in2 0 1e12
Rout1 out1 0 1e12
Rout2 out2 0 1e12
.ends

* ideal transformer 1 phase with coupling factor k
.subckt N1N2_Yzn in1 in2 out1 out2
+params: N1=1 N2=1 k=1
.param ue={N1/N2}
G1 0 M in1 in2 1
G2 0 M out1 out2 {-1/k*ue}
G3 in1 in2 M 0 1
G4 out1 out2 M 0 {-1/k*ue}
R2 M 0 1e10
Rin1 in1 0 1e10
Rin2 in2 0 1e10
Rout1 out1 0 1e10
Rout2 out2 0 1e10
.ends

.SUBCKT   R4  L1_1 L1_2
+	PARAMS:
+	R=0.5	;
+ length=1
+ g=1e12
RL1 L1_1 L1_2 {R*length}
Rgnd1 L1_1 0 {g}
Rgnd2 L1_2 0 {g}
.ENDS

.SUBCKT   L4  L1_1 L1_2
+	PARAMS:
+	L=1	;
+   fn={fn1}
+   xl=0
+ length=1
+ rser=0
+ IC=0
+ g=1e12
.PARAM
+   L1=IF(xl>0,xl/fn/2/pi,L)
LL1 L1_1 L1_2 {L1*length} rser={rser} IC={IC}
Rgnd1 L1_1 0 {g}
Rgnd2 L1_2 0 {g}
.ENDS

.SUBCKT   C4  L1_1 L1_2
+	PARAMS:
+	C=0.5	;
+   fn={fn1}
+   XC=0
+ length=1
+ IC=0
+ rser=0
+ g=1e12
.PARAM
+   C1=IF(xc>0,1/(xc+1p)/fn/2/pi,C)
CL1 L1_1 L1_2 {C1*length} rser={rser} IC={IC}
Rgnd1 L1_1 0 {g}
Rgnd2 L1_2 0 {g}
.ENDS